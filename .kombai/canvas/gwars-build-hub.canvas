ems-baseline gap-1.5\" data-kid=\"2-2-2-6-5-2-3-2-1\" data-name=\"Fortifications name level time row\">\n<span class=\"truncate text-[13px] font-medium\" data-kid=\"2-2-2-6-5-2-3-2-1-1\" data-name=\"Fortifications building name\">Fortifications</span>\n<span class=\"num text-[11.5px] text-[#8e8b82]\" data-kid=\"2-2-2-6-5-2-3-2-1-2\" data-name=\"Fortifications current level\">2</span>\n<span class=\"num ml-auto pl-1 text-[11px] text-[#8e8b82]\" data-kid=\"2-2-2-6-5-2-3-2-1-3\" data-name=\"Fortifications build time\">23m 40s</span>\n</span>\n<span class=\"mt-1 flex items-center gap-2 text-[12.5px] text-[#3d3d3a]\" data-kid=\"2-2-2-6-5-2-3-2-2\" data-name=\"Fortifications resource costs\">\n<span class=\"num flex items-center gap-1\" data-kid=\"2-2-2-6-5-2-3-2-2-1\" data-name=\"Fortifications food cost with dot\"><span class=\"dot\" data-kid=\"2-2-2-6-5-2-3-2-2-1-1\" data-name=\"Fortifications food cost color dot\" style=\"background:#5db872\"></span>79</span>\n<span class=\"num flex items-center gap-1\" data-kid=\"2-2-2-6-5-2-3-2-2-2\" data-name=\"Fortifications steel cost with dot\"><span class=\"dot\" data-kid=\"2-2-2-6-5-2-3-2-2-2-1\" data-name=\"Fortifications steel cost color dot\" style=\"background:#a09d96\"></span>159</span>\n<span class=\"num flex items-center gap-1\" data-kid=\"2-2-2-6-5-2-3-2-2-3\" data-name=\"Fortifications oil cost with dot\"><span class=\"dot\" data-kid=\"2-2-2-6-5-2-3-2-2-3-1\" data-name=\"Fortifications oil cost color dot\" style=\"background:#e8a55a\"></span>32</span>\n</span>\n</span>\n</button>\n<button class=\"-mx-2 flex items-center gap-2.5 rounded-[8px] px-2 py-[7px] text-left\" data-kid=\"2-2-2-6-5-2-4\" data-name=\"locked Factory building button\" type=\"button\">\n<svg aria-hidden=\"true\" class=\"h-10 w-10 shrink-0 opacity-55\" data-kid=\"2-2-2-6-5-2-4-1\" data-name=\"factory building icon (dimmed)\"><use href=\"#b-factory\"></use></svg>\n<span class=\"min-w-0 flex-1\" data-kid=\"2-2-2-6-5-2-4-2\" data-name=\"Factory building details\">\n<span class=\"flex items-center gap-1.5\" data-kid=\"2-2-2-6-5-2-4-2-1\" data-name=\"Factory name and lock row\">\n<span class=\"truncate text-[13px] text-[#6c6a64]\" data-kid=\"2-2-2-6-5-2-4-2-1-1\" data-name=\"Factory name (dimmed)\">Factory</span>\n<i class=\"icon-lock-keyhole text-[11px] text-[#a09d96]\" data-kid=\"2-2-2-6-5-2-4-2-1-2\" data-name=\"building lock icon\"></i>\n</span>\n<span class=\"mt-1 block truncate text-[12px] text-[#8e8b82]\" data-kid=\"2-2-2-6-5-2-4-2-2\" data-name=\"Factory requirement text\">Requires City Hall 10</span>\n</span>\n</button>\n<button class=\"-mx-2 flex items-center gap-2.5 rounded-[8px] px-2 py-[7px] text-left\" data-kid=\"2-2-2-6-5-2-5\" data-name=\"locked Airbase building button\" type=\"button\">\n<svg aria-hidden=\"true\" class=\"h-10 w-10 shrink-0 opacity-55\" data-kid=\"2-2-2-6-5-2-5-1\" data-name=\"airbase building icon (dimmed)\"><use href=\"#b-airbase\"></use></svg>\n<span class=\"min-w-0 flex-1\" data-kid=\"2-2-2-6-5-2-5-2\" data-name=\"Airbase building details\">\n<span class=\"flex items-center gap-1.5\" data-kid=\"2-2-2-6-5-2-5-2-1\" data-name=\"Airbase name and lock row\">\n<span class=\"truncate text-[13px] text-[#6c6a64]\" data-kid=\"2-2-2-6-5-2-5-2-1-1\" data-name=\"Airbase name (dimmed)\">Airbase</span>\n<i class=\"icon-lock-keyhole text-[11px] text-[#a09d96]\" data-kid=\"2-2-2-6-5-2-5-2-1-2\" data-name=\"building lock icon\"></i>\n</span>\n<span class=\"mt-1 block truncate text-[12px] text-[#8e8b82]\" data-kid=\"2-2-2-6-5-2-5-2-2\" data-name=\"Airbase requirement text\">Requires Research Center 10</span>\n</span>\n</button>\n<button class=\"-mx-2 flex items-center gap-2.5 rounded-[8px] px-2 py-[7px] text-left\" data-kid=\"2-2-2-6-5-2-6\" data-name=\"locked Port building button\" type=\"button\">\n<svg aria-hidden=\"true\" class=\"h-10 w-10 shrink-0 opacity-55\" data-kid=\"2-2-2-6-5-2-6-1\" data-name=\"port building icon (dimmed)\"><use href=\"#b-port\"></use></svg>\n<span class=\"min-w-0 flex-1\" data-kid=\"2-2-2-6-5-2-6-2\" data-name=\"Port building details\">\n<span class=\"flex items-center gap-1.5\" data-kid=\"2-2-2-6-5-2-6-2-1\" data-name=\"Port name and lock row\">\n<span class=\"truncate text-[13px] text-[#6c6a64]\" data-kid=\"2-2-2-6-5-2-6-2-1-1\" data-name=\"Port name (dimmed)\">Port</span>\n<i class=\"icon-lock-keyhole text-[11px] text-[#a09d96]\" data-kid=\"2-2-2-6-5-2-6-2-1-2\" data-name=\"building lock icon\"></i>\n</span>\n<span class=\"mt-1 block truncate text-[12px] text-[#8e8b82]\" data-kid=\"2-2-2-6-5-2-6-2-2\" data-name=\"Port requirement text\">Requires Warehouse 10</span>\n</span>\n</button>\n</div>\n</div>\n</section>\n<details class=\"mt-4 border-t border-[#e6dfd8] pt-2.5\" data-kid=\"2-2-2-7\" data-name=\"land multipliers expandable section\" open=\"\">\n<summary class=\"flex cursor-pointer list-none items-baseline justify-between text-[13px]\" data-kid=\"2-2-2-7-1\" data-name=\"land multipliers summary toggle\">\n<span data-kid=\"2-2-2-7-1-1\" data-name=\"land multipliers summary label\">Land multipliers</span>\n<span class=\"num text-[11.5px] text-[#8e8b82]\" data-kid=\"2-2-2-7-1-2\" data-name=\"rare earths multiplier value\">rare earths ×1.00</span>\n</summary>\n<div class=\"mt-2 grid grid-cols-3 gap-x-4\" data-kid=\"2-2-2-7-2\" data-name=\"land multipliers grid\">\n<div data-kid=\"2-2-2-7-2-1\" data-name=\"food land multiplier row\">\n<div class=\"flex items-baseline justify-between text-[12px] text-[#6c6a64]\" data-kid=\"2-2-2-7-2-1-1\" data-name=\"food multiplier label and value\"><span data-kid=\"2-2-2-7-2-1-1-1\" data-name=\"food multiplier label\">Food</span><span class=\"num text-[#3d3d3a]\" data-kid=\"2-2-2-7-2-1-1-2\" data-name=\"food multiplier value\">×1.42</span></div>\n<div class=\"mt-1 h-[3px] w-full overflow-hidden rounded-full bg-[#e6dfd8]\" data-kid=\"2-2-2-7-2-1-2\" data-name=\"food multiplier progress bar\"><div class=\"h-full w-[57%] rounded-full bg-[#5db872]\" data-kid=\"2-2-2-7-2-1-2-1\" data-name=\"food multiplier progress bar fill\"></div></div>\n</div>\n<div data-kid=\"2-2-2-7-2-2\" data-name=\"steel land multiplier row\">\n<div class=\"flex items-baseline justify-between text-[12px] text-[#6c6a64]\" data-kid=\"2-2-2-7-2-2-1\" data-name=\"steel multiplier label and value\"><span data-kid=\"2-2-2-7-2-2-1-1\" data-name=\"steel multiplier label\">Steel</span><span class=\"num text-[#3d3d3a]\" data-kid=\"2-2-2-7-2-2-1-2\" data-name=\"steel multiplier value\">×1.18</span></div>\n<div class=\"mt-1 h-[3px] w-full overflow-hidden rounded-full bg-[#e6dfd8]\" data-kid=\"2-2-2-7-2-2-2\" data-name=\"steel multiplier progress bar\"><div class=\"h-full w-[47%] rounded-full bg-[#a09d96]\" data-kid=\"2-2-2-7-2-2-2-1\" data-name=\"steel multiplier progress bar fill\"></div></div>\n</div>\n<div data-kid=\"2-2-2-7-2-3\" data-name=\"oil land multiplier row\">\n<div class=\"flex items-baseline justify-between text-[12px] text-[#6c6a64]\" data-kid=\"2-2-2-7-2-3-1\" data-name=\"oil multiplier label and value\"><span data-kid=\"2-2-2-7-2-3-1-1\" data-name=\"oil multiplier label\">Oil</span><span class=\"num text-[#3d3d3a]\" data-kid=\"2-2-2-7-2-3-1-2\" data-name=\"oil multiplier value\">×2.10</span></div>\n<div class=\"mt-1 h-[3px] w-full overflow-hidden rounded-full bg-[#e6dfd8]\" data-kid=\"2-2-2-7-2-3-2\" data-name=\"oil multiplier progress bar\"><div class=\"h-full w-[84%] rounded-full bg-[#e8a55a]\" data-kid=\"2-2-2-7-2-3-2-1\" data-name=\"oil multiplier progress bar fill\"></div></div>\n</div>\n</div>\n</details>\n</aside>\n</main>\n</div>\n<script>\n(function () {\n  var svg = document.getElementById('gw-map');\n  if (!svg) return;\n  var W = 760, H = 1320, R = 23;\n  var dxs = Math.sqrt(3) * R;\n  var dys = 1.5 * R;\n  var coastPts = [[760,296],[680,350],[628,468],[664,566],[604,652],[648,746],[688,834],[638,922],[684,1010],[742,1062]];\n  var seaPoly = coastPts.concat([[860,1400],[860,240]]);\n  function inPoly(x, y, poly) {\n    var c = false;\n    for (var i = 0, j = poly.length - 1; i < poly.length; j = i++) {\n      var xi = poly[i][0], yi = poly[i][1], xj = poly[j][0], yj = poly[j][1];\n      if (((yi > y) !== (yj > y)) && (x < ((xj - xi) * (y - yi)) / (yj - yi) + xi)) c = !c;\n    }\n    return c;\n  }\n  function hash(a, b) {\n    var h = (a * 73856093) ^ (b * 19349663);\n    h = (h ^ (h >>> 13)) * 1274126177;\n    return ((h ^ (h >>> 16)) >>> 0) / 4294967296;\n  }\n  var nations = [\n    { x: 404, y: 600, r: 140, fill: '#d8cbb4' },\n    { x: 206, y: 372, r: 168, fill: '#4d6f68' },\n    { x: 300, y: 916, r: 150, fill: '#6d5a3c' },\n    { x: 604, y: 238, r: 118, fill: '#47423a' },\n    { x: 126, y: 706, r: 118, fill: '#5b5346' },\n    { x: 232, y: 1150, r: 150, fill: '#565f57' },\n    { x: 560, y: 1180, r: 128, fill: '#4d6f68' }\n  ];\n  function hexPath(cx, cy) {\n    var p = [];\n    for (var i = 0; i < 6; i++) {\n      var a = (Math.PI / 180) * (60 * i + 30);\n      p.push((cx + R * Math.cos(a)).toFixed(2) + ',' + (cy + R * Math.sin(a)).toFixed(2));\n    }\n    return p.join(' ');\n  }\n  var land = '', marks = '', dacia = [];\n  var rows = Math.ceil(H / dys) + 1, cols = Math.ceil(W / dxs) + 1;\n  for (var r = 0; r < rows; r++) {\n    for (var c = 0; c < cols; c++) {\n      var cx = c * dxs + (r % 2 ? dxs / 2 : 0) + 6;\n      var cy = r * dys + 26;\n      if (cx < -30 || cx > W + 30) continue;\n      if (inPoly(cx, cy, seaPoly)) continue;\n      var jitter = hash(r, c);\n      var fill = jitter > 0.5 ? '#2c2822' : '#292519';\n      var owned = false, isDacia = false;\n      for (var n = 0; n < nations.length; n++) {\n        var d = Math.hypot(cx - nations[n].x, cy - nations[n].y);\n        if (d < nations[n].r * (0.7 + 0.44 * hash(r + 11, c + 5))) {\n          fill = nations[n].fill; owned = true; if (n === 0) isDacia = true; break;\n        }\n      }\n      if (isDacia) dacia.push([cx, cy]);\n      land += '<polygon points=\"' + hexPath(cx, cy) + '\" fill=\"' + fill + '\" stroke=\"#181715\" stroke-width=\"1\" stroke-opacity=\"' + (owned ? '0.55' : '0.8') + '\"/>';\n      if (owned && hash(c + 7, r + 3) > 0.74) {\n        marks += '<circle cx=\"' + cx + '\" cy=\"' + cy + '\" r=\"2.1\" fill=\"#181715\" fill-opacity=\"0.45\"/>';\n      }\n    }\n  }\n\n  var sel = null, best = 1e9;\n  for (var i = 0; i < dacia.length; i++) {\n    var dist = Math.hypot(dacia[i][0] - 404, dacia[i][1] - 604);\n    if (dist < best) { best = dist; sel = dacia[i]; }\n  }\n  if (!sel) sel = [404, 604];\n\n  var sea = 'M' + coastPts[0][0] + ',' + coastPts[0][1];\n  for (var k = 1; k < coastPts.length; k++) sea += ' L' + coastPts[k][0] + ',' + coastPts[k][1];\n  sea += ' L860,1400 L860,240 Z';\n  var coast = 'M' + coastPts[0][0] + ',' + coastPts[0][1];\n  for (var m = 1; m < coastPts.length; m++) coast += ' L' + coastPts[m][0] + ',' + coastPts[m][1];\n\n  function ridge(pts, step) {\n    var out = '';\n    for (var s = 0; s < pts.length - 1; s++) {\n      var ax = pts[s][0], ay = pts[s][1], bx = pts[s + 1][0], by = pts[s + 1][1];\n      var len = Math.hypot(bx - ax, by - ay);\n      var cnt = Math.max(1, Math.floor(len / step));\n      var nx = -(by - ay) / len, ny = (bx - ax) / len;\n      for (var t = 0; t < cnt; t++) {\n        var f = (t + 0.5) / cnt;\n        var px = ax + (bx - ax) * f, py = ay + (by - ay) * f;\n        var j = (hash(Math.round(px), Math.round(py)) - 0.5) * 9;\n        var x = px + nx * j, y = py + ny * j;\n        out += '<path d=\"M' + (x - 4).toFixed(1) + ',' + (y + 2.6).toFixed(1) + ' L' + x.toFixed(1) + ',' + (y - 3).toFixed(1) + ' L' + (x + 4).toFixed(1) + ',' + (y + 2.6).toFixed(1) + '\" fill=\"none\" stroke=\"#c9bda9\" stroke-opacity=\"0.17\" stroke-width=\"1.1\"/>';\n      }\n    }\n    return out;\n  }\n\n  var selPath = hexPath(sel[0], sel[1]);\n  var ring = (function () {\n    var p = [], rr = R * 1.24;\n    for (var q = 0; q < 6; q++) {\n      var a = (Math.PI / 180) * (60 * q + 30);\n      p.push((sel[0] + rr * Math.cos(a)).toFixed(2) + ',' + (sel[1] + rr * Math.sin(a)).toFixed(2));\n    }\n    return p.join(' ');\n  })();\n  var chipX = Math.min(W - 122, Math.max(10, sel[0] - 52));\n  var chipY = Math.max(12, sel[1] - 64);\n\n  var waveAt = [[702, 424], [674, 526], [710, 616], [666, 704], [704, 792], [662, 884], [698, 972], [676, 1058]];\n  var waves = '';\n  for (var wv = 0; wv < waveAt.length; wv++) {\n    waves += '<path d=\"M' + (waveAt[wv][0] - 8) + ',' + waveAt[wv][1] + ' q4,-3 8,0 t8,0\" fill=\"none\" stroke=\"#faf9f5\" stroke-opacity=\"0.15\" stroke-width=\"1.1\"/>';\n  }\n\n  svg.innerHTML =\n    '<path d=\"' + sea + '\" fill=\"#100f0d\"/>' +\n    waves +\n    land +\n    '<path d=\"' + coast + '\" fill=\"none\" stroke=\"#d8cbb4\" stroke-opacity=\"0.5\" stroke-width=\"1.7\"/>' +\n    '<path d=\"M120,120 q60,80 40,170 q-18,80 60,150 q70,66 46,150 q-22,80 40,160 q30,50 20,120\" fill=\"none\" stroke=\"#4e5a52\" stroke-opacity=\"0.5\" stroke-width=\"1.5\"/>' +\n    '<path d=\"M300,60 q30,90 96,120 q60,26 54,120 q-6,80 -70,110\" fill=\"none\" stroke=\"#4e5a52\" stroke-opacity=\"0.36\" stroke-width=\"1.4\"/>' +\n    marks +\n    '<polygon points=\"' + ring + '\" fill=\"none\" stroke=\"#faf9f5\" stroke-opacity=\"0.45\" stroke-width=\"1.4\"/>' +\n    '<polygon points=\"' + selPath + '\" fill=\"#faf9f5\" stroke=\"#faf9f5\" stroke-width=\"2\"/>' +\n    '<text x=\"96\" y=\"150\" fill=\"#faf9f5\" fill-opacity=\"0.24\" font-family=\"Inter, sans-serif\" font-size=\"11\" letter-spacing=\"3.4\">ROMANIA</text>' +\n    '<text x=\"716\" y=\"620\" fill=\"#faf9f5\" fill-opacity=\"0.2\" font-family=\"Inter, sans-serif\" font-size=\"10\" letter-spacing=\"3\" transform=\"rotate(-90 716 620)\">BLACK SEA</text>' +\n    '<text x=\"238\" y=\"470\" fill=\"#faf9f5\" fill-opacity=\"0.4\" font-family=\"Inter, sans-serif\" font-size=\"10.5\" letter-spacing=\"1.6\">SIBIU</text>' +\n    '<text x=\"516\" y=\"852\" fill=\"#faf9f5\" fill-opacity=\"0.4\" font-family=\"Inter, sans-serif\" font-size=\"10.5\" letter-spacing=\"1.6\">PLOIEȘTI</text>' +\n    '<text x=\"628\" y=\"972\" fill=\"#faf9f5\" fill-opacity=\"0.34\" font-family=\"Inter, sans-serif\" font-size=\"10\" letter-spacing=\"1.5\">CONSTANȚA</text>' +\n    '<path d=\"M' + (chipX + 52) + ',' + (chipY + 24) + ' L' + sel[0] + ',' + (sel[1] - 10) + '\" stroke=\"#faf9f5\" stroke-opacity=\"0.5\" stroke-width=\"1.2\"/>' +\n    '<rect x=\"' + chipX + '\" y=\"' + chipY + '\" width=\"104\" height=\"24\" rx=\"6\" fill=\"#181715\" stroke=\"#faf9f5\" stroke-opacity=\"0.35\"/>' +\n    '<text x=\"' + (chipX + 52) + '\" y=\"' + (chipY + 16) + '\" fill=\"#faf9f5\" font-family=\"Inter, sans-serif\" font-size=\"12\" text-anchor=\"middle\">East Brașov</text>';\n})();\n</script>",
