      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --canvas:#faf9f5; --ink:#141413; --body:#3d3d3a; --muted:#6c6a64; --muted-soft:#8e8b82;\n  --hairline:#e6dfd8; --soft:#f5f0e8; --card:#efe9de; --cream-strong:#e8e0d2;\n  --dark:#181715; --dark-elev:#252320; --dark-soft:#1f1e1b; --on-dark-soft:#a09d96;\n  --coral:#cc785c; --coral-active:#a9583e; --teal:#5db8a6; --amber:#e8a55a; --error:#c64545;\n}\nbody{ background:var(--canvas); color:var(--ink); }\n.serif{ font-family:'Cormorant Garamond','Tiempos Headline',Georgia,serif; font-weight:500; letter-spacing:-0.02em; }\n.mono{ font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,monospace; font-variant-numeric:tabular-nums; }\n</style>\n<svg aria-hidden=\"true\" data-kid=\"1\" data-name=\"hidden SVG sprite definitions (building icons)\" height=\"0\" style=\"position:absolute;width:0;height:0;overflow:hidden\" width=\"0\">\n<defs>\n<polygon id=\"hx\" points=\"38,0 19,32.9 -19,32.9 -38,0 -19,-32.9 19,-32.9\"></polygon>\n<path d=\"M-9 5 L-2 -3 L5 5\" fill=\"none\" id=\"mtn\" stroke=\"#faf9f5\" stroke-opacity=\".22\" stroke-width=\"1.8\"></path>\n<symbol id=\"b-cityhall\" viewbox=\"0 0 96 96\">\n<rect fill=\"#252320\" height=\"6\" width=\"80\" x=\"8\" y=\"78\"></rect>\n<rect fill=\"#141413\" height=\"6\" width=\"70\" x=\"13\" y=\"72\"></rect>\n<rect fill=\"#252320\" height=\"30\" width=\"60\" x=\"18\" y=\"42\"></rect>\n<rect fill=\"#faf9f5\" height=\"26\" width=\"48\" x=\"24\" y=\"46\"></rect>\n<g fill=\"#252320\"><rect height=\"30\" width=\"5\" x=\"27\" y=\"44\"></rect><rect height=\"30\" width=\"5\" x=\"40\" y=\"44\"></rect><rect height=\"30\" width=\"5\" x=\"53\" y=\"44\"></rect><rect height=\"30\" width=\"5\" x=\"66\" y=\"44\"></rect></g>\n<rect fill=\"#141413\" height=\"14\" width=\"