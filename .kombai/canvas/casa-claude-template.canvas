      },
      "html": "<link data-kid=\"1\" data-name=\"Google Fonts preconnect link\" href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" data-kid=\"2\" data-name=\"Google Fonts static assets preconnect link\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link data-kid=\"3\" data-name=\"web font stylesheet link\" href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&amp;family=Inter:wght@400;500;600&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap\" rel=\"stylesheet\"/>\n<link data-kid=\"4\" data-name=\"Tabler icon font stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\nbody { margin: 0; background: #faf9f5; color: #141413; font-family: 'Inter', sans-serif; font-size: 14px; line-height: 1.55; }\n\n.serif { font-family: 'Cormorant Garamond', 'Tiempos Headline', serif; font-weight: 500; }\n.mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }\n\n.page { min-height: 100vh; display: flex; flex-direction: column; animation: adminUp 0.5s cubic-bezier(0.2, 0, 0, 1) both; }\n@keyframes adminUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }\n\n.topbar { position: sticky; top: 0; z-index: 30; height: 56px; background: #faf9f5; border-bottom: 1px solid #e6dfd8; }\n.topbar-inner { max-width: 1040px; margin: 0 auto; height: 100%; padding: 0 30px; display: flex; align-items: center; justify-content: space-between; }\n.wordmark { display: flex; align-items: baseline; gap: 7px; }\n.wordmark strong { font-family: 'JetBrains Mono', monospace; font-weight: 500; font-size: 15px; letter-spacing: 0.14em; color: #141413; }\n.wordmark em { font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 500; font-size: 15px; color: #6c6a64; }\n.topnav { display: flex; align-items: center; gap: 24px; }\n.topnav a { text-decoration: none; font-size: 13px; }\n.topnav .link-coral { color: #cc785c; font-weight: 500; }\n.topnav .link-muted { color: #8e8b82; }\n\n.main { flex: 1; width: 100%; max-width: 1040px; margin: 0 auto; padding: 32px 30px 64px; box-sizing: border-box; }\n.page-title { margin: 0; font-size: 28px; line-height: 1.2; letter-spacing: -0.3px; color: #141413; }\n.page-sub { margin: 6px 0 0; font-size: 13px; color: #6c6a64; }\n\n.layout { margin-top: 28px; display: grid; grid-template-columns: 300px 1fr; gap: 24px; align-items: start; }\n\n/* ---- left: houses master list ---- */\n.master { background: #efe9de; border-radius: 12px; padding: 16px; box-sizing: border-box; }\n.master-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #8e8b82; padding: 0 12px; margin-bottom: 10px; }\n.house-list { display: flex; flex-direction: column; gap: 4px; }\n.house-row { height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 12px; border-radius: 8px; border: 1px solid transparent; background: transparent; cursor: pointer; text-align: left; width: 100%; box-sizing: border-box; font-family: 'Inter', sans-serif; transition: background-color 0.15s cubic-bezier(0.2, 0, 0, 1); }\n.house-row:hover { background: rgba(20, 20, 19, 0.035); }\n.house-row.selected { background: #faf9f5; border-color: #e6dfd8; }\n.house-row.selected:hover { background: #faf9f5; }\n.house-name { display: block; font-size: 14px; font-weight: 400; color: #3d3d3a; line-height: 1.25; }\n.house-row.selected .house-name { font-weight: 500; color: #141413; }\n.house-stats { display: block; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #8e8b82; line-height: 1.25; }\n.house-chevron { font-size: 16px; color: #cc785c; }\n\n/* ---- right: detail column ---- */\n.detail-col { display: flex; flex-direction: column; gap: 16px; }\n.notice { align-self: flex-start; display: flex; align-items: center; gap: 8px; background: rgba(93, 184, 114, 0.12); color: #5db872; font-size: 13px; border-radius: 8px; padding: 7px 12px; }\n.notice i { font-size: 14px; }\n\n.card { background: #faf9f5; border: 1px solid #e6dfd8; border-radius: 12px; padding: 24px; box-sizing: border-box; }\n.card-head { display: flex; align-items: center; justify-content: space-between; }\n.card-title { margin: 0; font-size: 24px; line-height: 1.2; letter-spacing: -0.3px; color: #141413; }\n.open-link { text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #cc785c; }\n.open-link i { font-size: 14px; }\n\n.pw-row { margin-top: 16px; display: flex; align-items: center; gap: 10px; }\n.pw-label { font-size: 13px; color: #6c6a64; }\n.pw-chip { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.14em; color: #141413; background: #f5f0e8; border: 1px solid #e6dfd8; border-radius: 6px; padding: 3px 10px; }\n.copy-chip { width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid #e6dfd8; border-radius: 6px; background: #faf9f5; color: #6c6a64; cursor: pointer; padding: 0; transition: color 0.15s cubic-bezier(0.2, 0, 0, 1), border-color 0.15s cubic-bezier(0.2, 0, 0, 1); }\n.copy-chip:hover { color: #cc785c; border-color: #cc785c; }\n.copy-chip i { font-size: 14px; }\n\n.rule { height: 1px; background: #ebe6df; margin: 24px 0 0; }\n\n.form-row { margin-top: 24px; display: flex; align-items: center; gap: 16px; }\n.form-row + .form-row { margin-top: 16px; }\n.form-label { flex: 0 0 140px; font-size: 14px; color: #252523; }\n.adm-input { height: 40px; width: 240px; box-sizing: border-box; padding: 0 14px; background: #faf9f5; border: 1px solid #e6dfd8; border-radius: 8px; color: #141413; font-family: 'Inter', sans-serif; font-size: 14px; transition: border-color 0.15s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.15s cubic-bezier(0.2, 0, 0, 1); }\n.adm-input::placeholder { color: #8e8b82; }\n.adm-input:focus { outline: none; border-color: #cc785c; box-shadow: 0 0 0 3px rgba(204, 120, 92, 0.15); }\n\n.btn { height: 40px; display: inline-flex; align-items: center; gap: 8px; padding: 0 20px; border-radius: 8px; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 500; line-height: 1; cursor: pointer; box-sizing: border-box; transition: background-color 0.15s cubic-bezier(0.2, 0, 0, 1), border-color 0.15s cubic-bezier(0.2, 0, 0, 1), color 0.15s cubic-bezier(0.2, 0, 0, 1); }\n.btn-primary { background: #cc785c; color: #ffffff; border: 1px solid #cc785c; }\n.btn-primary:hover { background: #a9583e; border-color: #a9583e; }\n.btn-secondary { background: #faf9f5; color: #141413; border: 1px solid #e6dfd8; }\n.btn-secondary:hover { border-color: #cc785c; }\n.btn-danger { background: transparent; color: #c64545; border: 1px solid #e6dfd8; }\n.btn-danger:hover { border-color: #c64545; background: rgba(198, 69, 69, 0.05); }\n.btn i { font-size: 15px; }\n\n.danger-row { margin-top: 24px; display: flex; align-items: center; gap: 16px; }\n.danger-note { font-size: 12px; color: #8e8b82; }\n\n.soft-band { background: #f5f0e8; border-radius: 12px; padding: 24px; box-sizing: border-box; }\n.soft-band h3 { margin: 0; font-size: 18px; line-height: 1.4; color: #141413; }\n.soft-form { margin-top: 16px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }\n\n/* ---- footer chrome ---- */\n.site-footer { background: #181715; }\n.site-footer-inner { max-width: 1040px; margin: 0 auto; padding: 20px 30px; display: flex; align-items: center; justify-content: flex-end; gap: 12px; box-sizing: border-box; }\n.footer-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #a09d96; }\n.theme-select { min-width: 150px; padding: 8px 12px; border: 1px solid rgba(250, 249, 245, 0.16); border-radius: 8px; background: #252320; color: #faf9f5; font-family: 'Inter', sans-serif; font-size: 13px; cursor: pointer; }\n.theme-select:focus { outline: none; border-color: #cc785c; }\n</style>\n<div class=\"page\" data-kid=\"5\" data-name=\"page layout container\">\n<header class=\"topbar\" data-kid=\"5-1\" data-name=\"sticky top bar\">\n<div class=\"topbar-inner\" data-kid=\"5-1-1\" data-name=\"top bar content container\">\n<div class=\"wordmark\" data-kid=\"5-1-1-1\" data-name=\"brand wordmark\"><strong data-kid=\"5-1-1-1-1\" data-name=\"wordmark primary label\">CASA</strong><em data-kid=\"5-1-1-1-2\" data-name=\"wordmark sub-label\">admin</em></div>\n<nav class=\"topnav\" data-kid=\"5-1-1-2\" data-name=\"top navigation links\">\n<a class=\"link-coral\" data-kid=\"5-1-1-2-1\" data-name=\"suppliers navigation link\" href=\"#\">Furnizori →</a>\n<a class=\"link-muted\" data-kid=\"5-1-1-2-2\" data-name=\"sign out link\" href=\"#\">Ieși din admin</a>\n</nav>\n</div>\n</header>\n<main class=\"main\" data-kid=\"5-2\" data-name=\"main content area\">\n<h1 class=\"page-title serif\" data-kid=\"5-2-1\" data-name=\"page title heading\">Administrare</h1>\n<p class=\"page-sub\" data-kid=\"5-2-2\" data-name=\"page subtitle text\">Click pe numele unei case ca să o deschizi.</p>\n<div class=\"layout\" data-kid=\"5-2-3\" data-name=\"two-column master-detail layout\">\n<aside class=\"master\" data-kid=\"5-2-3-1\" data-name=\"houses master list panel\">\n<div class=\"master-label\" data-kid=\"5-2-3-1-1\" data-name=\"panel section label\">Case</div>\n<div class=\"house-list\" data-kid=\"5-2-3-1-2\" data-name=\"house list container\">\n<button class=\"house-row selected\" data-kid=\"5-2-3-1-2-1\" data-name=\"selected house row button\" type=\"button\">\n<span data-kid=\"5-2-3-1-2-1-1\" data-name=\"house row text container\">\n<span class=\"house-name\" data-kid=\"5-2-3-1-2-1-1-1\" data-name=\"house name text\">Chicerea</span>\n<span class=\"house-stats\" data-kid=\"5-2-3-1-2-1-1-2\" data-name=\"house stats text\">12 camere · 84 itemi</span>\n</span>\n<i class=\"ti ti-chevron-right house-chevron\" data-kid=\"5-2-3-1-2-1-2\" data-name=\"chevron right icon\"></i>\n</button>\n<button class=\"house-row\" data-kid=\"5-2-3-1-2-2\" data-name=\"house row button\" type=\"button\">\n<span data-kid=\"5-2-3-1-2-2-1\" data-name=\"house row text container\">\n<span class=\"house-name\" data-kid=\"5-2-3-1-2-2-1-1\" data-name=\"house name text\">Casa din Vale</span>\n<span class=\"house-stats\" data-kid=\"5-2-3-1-2-2-1-2\" data-name=\"house stats text\">5 camere · 31 itemi</span>\n</span>\n</button>\n<button class=\"house-row\" data-kid=\"5-2-3-1-2-3\" data-name=\"house row button\" type=\"button\">\n<span data-kid=\"5-2-3-1-2-3-1\" data-name=\"house row text container\">\n<span class=\"house-name\" data-kid=\"5-2-3-1-2-3-1-1\" data-name=\"house name text\">Viitor</span>\n<span class=\"house-stats\" data-kid=\"5-2-3-1-2-3-1-2\" data-name=\"house stats text\">2 camere · 9 itemi</span>\n</span>\n</button>\n</div>\n</aside>\n<section class=\"detail-col\" data-kid=\"5-2-3-2\" data-name=\"detail column container\">\n<div class=\"notice\" data-kid=\"5-2-3-2-1\" data-name=\"success status notice\"><i class=\"ti ti-check\" data-kid=\"5-2-3-2-1-1\" data-name=\"checkmark icon\"></i>Nume salvat.</div>\n<div class=\"card\" data-kid=\"5-2-3-2-2\" data-name=\"house detail card\">\n<div class=\"card-head\" data-kid=\"5-2-3-2-2-1\" data-name=\"card header row\">\n<h2 class=\"card-title serif\" data-kid=\"5-2-3-2-2-1-1\" data-name=\"detail card house name heading\">Chicerea</h2>\n<a class=\"open-link\" data-kid=\"5-2-3-2-2-1-2\" data-name=\"open house link\" href=\"#\">Deschide <i class=\"ti ti-arrow-up-right\" data-kid=\"5-2-3-2-2-1-2-1\" data-name=\"arrow up right icon\"></i></a>\n</div>\n<div class=\"pw-row\" data-kid=\"5-2-3-2-2-2\" data-name=\"current password row\">\n<span class=\"pw-label\" data-kid=\"5-2-3-2-2-2-1\" data-name=\"password label text\">Parolă curentă:</span>\n<span class=\"pw-chip\" data-kid=\"5-2-3-2-2-2-2\" data-name=\"password value chip\">••••••</span>\n<button aria-label=\"Copiază parola\" class=\"copy-chip\" data-kid=\"5-2-3-2-2-2-3\" data-name=\"copy password button\" type=\"button\"><i class=\"ti ti-copy\" data-kid=\"5-2-3-2-2-2-3-1\" data-name=\"copy icon\"></i></button>\n</div>\n<div class=\"rule\" data-kid=\"5-2-3-2-2-3\" data-name=\"card divider rule\"></div>\n<form class=\"form-row\" data-kid=\"5-2-3-2-2-4\" data-name=\"rename house form row\" onsubmit=\"return false\">\n<label class=\"form-label\" data-kid=\"5-2-3-2-2-4-1\" data-name=\"rename form label\" for=\"adm-nume\">Schimbă numele</label>\n<input class=\"adm-input\" data-kid=\"5-2-3-2-2-4-2\" data-name=\"house name text input\" id=\"adm-nume\" type=\"text\" value=\"Chicerea\"/>\n<button class=\"btn btn-secondary\" data-kid=\"5-2-3-2-2-4-3\" data-name=\"save name secondary button\" type=\"submit\">Salvează</button>\n</form>\n<form class=\"form-row\" data-kid=\"5-2-3-2-2-5\" data-name=\"change password form row\" onsubmit=\"return false\">\n<label class=\"form-label\" data-kid=\"5-2-3-2-2-5-1\" data-name=\"change password form label\" for=\"adm-parola\">Schimbă parola</label>\n<input autocomplete=\"new-password\" class=\"adm-input\" data-kid=\"5-2-3-2-2-5-2\" data-name=\"new password input\" id=\"adm-parola\" placeholder=\"Parolă nouă\" type=\"password\"/>\n<button class=\"btn btn-secondary\" data-kid=\"5-2-3-2-2-5-3\" data-name=\"save password secondary button\" type=\"submit\">Salvează</button>\n</form>\n<div class=\"rule\" data-kid=\"5-2-3-2-2-6\" data-name=\"card divider rule\"></div>\n<div class=\"danger-row\" data-kid=\"5-2-3-2-2-7\" data-name=\"danger actions row\">\n<button class=\"btn btn-danger\" data-kid=\"5-2-3-2-2-7-1\" data-name=\"delete house danger button\" type=\"button\"><i class=\"ti ti-trash\" data-kid=\"5-2-3-2-2-7-1-1\" data-name=\"trash icon\"></i>Șterge</button>\n<span class=\"danger-note\" data-kid=\"5-2-3-2-2-7-2\" data-name=\"delete action note text\">Fotografiile se arhivează.</span>\n</div>\n</div>\n<div class=\"soft-band\" data-kid=\"5-2-3-2-3\" data-name=\"new house soft band\">\n<h3 class=\"serif\" data-kid=\"5-2-3-2-3-1\" data-name=\"new house section heading\">Casă nouă</h3>\n<form class=\"soft-form\" data-kid=\"5-2-3-2-3-2\" data-name=\"create new house form\" onsubmit=\"return false\">\n<input class=\"adm-input\" data-kid=\"5-2-3-2-3-2-1\" data-name=\"new house name input\" placeholder=\"Numele casei (ex: Chicerea)\" type=\"text\"/>\n<input class=\"adm-input\" data-kid=\"5-2-3-2-3-2-2\" data-name=\"new house password input\" placeholder=\"Parola casei\" type=\"text\"/>\n<button class=\"btn btn-primary\" data-kid=\"5-2-3-2-3-2-3\" data-name=\"create house primary button\" type=\"submit\">Creează</button>\n</form>\n</div>\n</section>\n</div>\n</main>\n<footer class=\"site-footer\" data-kid=\"5-3\" data-name=\"site footer bar\">\n<div class=\"site-footer-inner\" data-kid=\"5-3-1\" data-name=\"footer content container\">\n<span class=\"footer-label\" data-kid=\"5-3-1-1\" data-name=\"footer theme label\">Temă</span>\n<select aria-label=\"Temă\" class=\"theme-select\" data-kid=\"5-3-1-2\" data-name=\"theme select dropdown\">\n<option data-kid=\"5-3-1-2-1\" data-name=\"night theme option\" selected=\"\">🌙 Noapte</option>\n</select>\n</div>\n</footer>\n</div>",
