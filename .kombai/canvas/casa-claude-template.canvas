    "var_13b1527697d7": {
      "type": "variant",
      "label": "Design — camere, Poze & Checklist",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 7700,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n\n.app { background:#faf9f5; color:#141413; font-family:'Inter',sans-serif; font-size:14px; min-height:100vh; display:flex; flex-direction:column; }\n\n/* ---------- shared chrome: header ---------- */\n.hdr { position:sticky; top:0; z-index:40; height:56px; background:#faf9f5; border-bottom:1px solid #e6dfd8; }\n.hdr-in { height:56px; max-width:1200px; margin:0 auto; padding:0 24px; display:flex; align-items:center; gap:34px; }\n.wm { display:flex; align-items:baseline; gap:8px; flex-shrink:0; }\n.wm strong { font-weight:700; font-size:15px; letter-spacing:.14em; color:#141413; }\n.wm em { font-family:'Cormorant Garamond',serif; font-style:italic; font-weight:500; font-size:16px; color:#8e8b82; }\n.hnav { display:flex; align-items:center; gap:24px; height:56px; }\n.hnav a { position:relative; font-size:13px; color:#3d3d3a; text-decoration:none; height:56px; display:inline-flex; align-items:center; white-space:nowrap; }\n.hnav a:hover { color:#141413; }\n.hnav a.on { color:#141413; font-weight:500; }\n.hnav a.on::after { content:''; position:absolute; left:0; right:0; bottom:-1px; height:2px; background:#cc785c; }\n.stage-tag { margin-left:auto; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.04em; color:#8e8b82; white-space:nowrap; }\n\n/* ---------- layout ---------- */\n.wrap { max-width:1200px; margin:0 auto; padding:32px 24px 96px; width:100%; box-sizing:border-box; display:flex; align-items:flex-start; gap:32px; }\n.side { width:240px; flex-shrink:0; position:sticky; top:88px; }\n.main { flex:1; min-width:0; display:flex; flex-direction:column; gap:32px; }\n\n/* ---------- sidebar ---------- */\n.side-h { font-family:'Cormorant Garamond',serif; font-weight:500; font-size:18px; letter-spacing:-.01em; color:#141413; margin:0 0 10px; padding-left:12px; }\n.room-row { display:flex; align-items:center; gap:10px; height:40px; padding:0 12px; border-radius:8px; font-size:13px; color:#3d3d3a; text-decoration:none; }\n.room-row:hover { background:#f5f0e8; }\n.room-row.on { background:#efe9de; color:#141413; font-weight:500; }\n.frac { margin-left:auto; font-family:'JetBrains Mono',monospace; font-size:11px; color:#8e8b82; font-variant-numeric:tabular-nums; }\n.dot { width:8px; height:8px; border-radius:9999px; flex-shrink:0; }\n.dot-coral { background:#cc785c; }\n.dot-teal { background:#5db8a6; }\n.dot-good { background:#5db872; }\n.dot-ring { background:transparent; box-shadow:inset 0 0 0 1.5px #e6dfd8; }\n.dot-soft { background:#ddd6c9; }\n.ghost-btn { display:flex; align-items:center; justify-content:center; gap:6px; width:100%; height:40px; margin-top:12px; border:1px solid #e6dfd8; border-radius:8px; background:transparent; color:#6c6a64; font-family:'Inter',sans-serif; font-size:13px; cursor:pointer; }\n.ghost-btn:hover { border-color:#cc785c; color:#cc785c; }\n\n/* ---------- route head ---------- */\n.route-h { font-family:'Cormorant Garamond',serif; font-weight:500; font-size:28px; line-height:1.15; letter-spacing:-.02em; color:#141413; margin:0; }\n.route-sub { margin:6px 0 0; font-size:13px; color:#6c6a64; }\n\n/* ---------- room workspace shell ---------- */\n.ws { background:#efe9de; border-radius:12px; }\n.ws-head { display:flex; align-items:center; gap:16px; padding:24px 24px 0; }\n.ws-name { font-family:'Cormorant Garamond',serif; font-weight:500; font-size:24px; line-height:1.2; letter-spacing:-.015em; color:#141413; margin:0; }\n.ws-status { margin-left:auto; font-family:'JetBrains Mono',monospace; font-size:12px; color:#6c6a64; font-variant-numeric:tabular-nums; }\n.ws-acts { display:flex; align-items:center; gap:12px; color:#8e8b82; }\n.ws-acts i { font-size:18px; cursor:pointer; }\n.ws-acts i:hover { color:#3d3d3a; }\n.tabs { display:flex; align-items:center; gap:24px; padding:14px 24px 0; border-bottom:1px solid #e6dfd8; margin-top:14px; }\n.tab { position:relative; display:inline-flex; align-items:baseline; gap:6px; height:40px; font-size:13px; color:#6c6a64; cursor:pointer; white-space:nowrap; }\n.tab:hover { color:#3d3d3a; }\n.tab .tc { font-family:'JetBrains Mono',monospace; font-size:11px; color:#8e8b82; }\n.tab.on { color:#141413; font-weight:500; }\n.tab.on .tc { color:#6c6a64; }\n.tab.on::after { content:''; position:absolute; left:0; right:0; bottom:-1px; height:2px; background:#cc785c; }\n.ws-body { padding:24px; }\n\n/* ---------- photos tab ---------- */\n.pz-bar { display:flex; justify-content:flex-end; margin-bottom:16px; }\n.btn-sec { display:inline-flex; align-items:center; gap:6px; height:36px; padding:0 14px; border:1px solid #e6dfd8; border-radius:8px; background:#faf9f5; color:#141413; font-family:'Inter',sans-serif; font-size:13px; font-weight:500; cursor:pointer; }\n.btn-sec:hover { border-color:#cc785c; }\n.pz-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }\n.pz-cell { background:#faf9f5; border:1px solid #e6dfd8; border-radius:12px; overflow:hidden; }\n.pz-win { border:1.5px solid #cc785c; }\n.pz-img { aspect-ratio:4/3; width:100%; object-fit:cover; display:block; }\n.pz-meta { height:44px; display:flex; align-items:center; gap:10px; padding:0 12px; }\n.stars { display:inline-flex; align-items:center; gap:2px; font-size:14px; color:#e6dfd8; }\n.stars .ti-star.f { color:#e8a55a; }\n.stars .half { position:relative; width:1em; height:1.1em; display:inline-block; }\n.stars .half .ti-star { position:absolute; inset:0; color:#e6dfd8; }\n.stars .half .ti-star.f { position:absolute; inset:0; color:#e8a55a; clip-path:inset(0 50% 0 0); }\n.rate-pill { font-family:'JetBrains Mono',monospace; font-size:11px; color:#6c6a64; background:#f5f0e8; border-radius:9999px; padding:3px 8px; white-space:nowrap; font-variant-numeric:tabular-nums; }\n.pz-acts { margin-left:auto; display:flex; align-items:center; gap:10px; color:#8e8b82; font-size:16px; }\n.pz-acts .crown-on { color:#e8a55a; }\n.pz-acts i { cursor:pointer; }\n.pz-acts i:hover { color:#3d3d3a; }\n\n/* ---------- checklist tab ---------- */\n.cl-head { display:flex; align-items:center; justify-content:flex-end; gap:28px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.04em; color:#8e8b82; padding:0 0 14px; }\n.cl-blk { padding:20px 0; border-top:1px solid #ebe6df; }\n.cl-blk:first-of-type { border-top:0; padding-top:0; }\n.cl-top { display:flex; align-items:center; gap:10px; }\n.cl-name { font-size:14px; font-weight:500; color:#141413; }\n.badge-nm { font-family:'JetBrains Mono',monospace; font-size:11px; color:#3d3d3a; background:#e8e0d2; border-radius:9999px; padding:2px 8px; font-variant-numeric:tabular-nums; }\n.cl-costs { margin-left:auto; font-family:'JetBrains Mono',monospace; font-size:12px; color:#6c6a64; display:flex; gap:20px; font-variant-numeric:tabular-nums; white-space:nowrap; }\n.cl-costs b { font-weight:500; color:#8e8b82; }\n.cl-prog { height:4px; background:#e6dfd8; border-radius:2px; margin:10px 0 4px; overflow:hidden; }\n.cl-prog > div { height:100%; background:#3d3d3a; border-radius:2px; }\n.cl-item { display:flex; align-items:center; gap:16px; min-height:32px; font-size:13px; color:#3d3d3a; }\n.cl-item .nm { flex:1; min-width:0; }\n.ms { display:inline-flex; align-items:center; gap:4px; font-size:11px; color:#8e8b82; white-space:nowrap; }\n.ms i { font-size:14px; }\n.ms.ok { color:#3d3d3a; }\n.err { color:#c64545; font-size:14px; }\n.amt { font-family:'JetBrains Mono',monospace; font-size:12px; color:#6c6a64; width:104px; text-align:right; font-variant-numeric:tabular-nums; }\n.add-link { display:inline-flex; align-items:center; gap:5px; margin-top:10px; font-size:13px; font-weight:500; color:#cc785c; cursor:pointer; }\n.add-link:hover { color:#a9583e; }\n\n/* --