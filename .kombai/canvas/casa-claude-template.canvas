option data-kid=\"1-3-1-2-1-3\" data-name=\"theme option Șantier\">🧱 Șantier</option>\n<option data-kid=\"1-3-1-2-1-4\" data-name=\"theme option Plante\">🌿 Plante</option>\n</select>\n<i class=\"ti ti-chevron-down absolute text-[14px]\" data-kid=\"1-3-1-2-2\" data-name=\"dropdown chevron icon\" style=\"color:#a09d96;right:12px;top:50%;transform:translateY(-50%);pointer-events:none;\"></i>\n</div>\n</div>\n</footer>\n</div>",
