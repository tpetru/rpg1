xt-[15px] cursor-pointer hover:text-[#141413]\" data-kid=\"2-3-12-6-1\" data-name=\"refresh price action icon\"></i>\n<i class=\"ti ti-pencil text-[15px] ml-2.5 cursor-pointer hover:text-[#141413]\" data-kid=\"2-3-12-6-2\" data-name=\"edit product action icon\"></i>\n<i class=\"ti ti-x text-[15px] ml-2.5 cursor-pointer hover:text-[#c64545]\" data-kid=\"2-3-12-6-3\" data-name=\"delete item action icon\"></i>\n</div>\n</div>\n<div class=\"flex items-baseline justify-end gap-3 px-4 py-3\" data-kid=\"2-3-13\" data-name=\"table total summary row\">\n<div class=\"text-right\" data-kid=\"2-3-13-1\" data-name=\"tracked total summary block\">\n<div class=\"mono text-[13px] text-[#141413]\" data-dynamic=\"true\" data-kid=\"2-3-13-1-1\" data-name=\"tracked total amount in LEI\" data-reason=\"total amount recalculated by script from line items\">Total urmărit: 8.940,00 LEI</div>\n<div class=\"mono text-[11px] text-[#8e8b82] mt-0.5\" data-dynamic=\"true\" data-kid=\"2-3-13-1-2\" data-name=\"tracked total in EUR\" data-reason=\"EUR total conversion set by script\">≈ 1.702,86 EUR</div>\n</div>\n</div>\n</div>\n</main>\n<footer class=\"bg-[#181715]\" data-kid=\"3\" data-name=\"site footer\">\n<div class=\"max-w-[1200px] mx-auto px-2 py-8 flex flex-col items-center gap-3\" data-kid=\"3-1\" data-name=\"footer theme section\">\n<span class=\"mono text-[11px] tracking-[.08em] uppercase text-[#a09d96]\" data-kid=\"3-1-1\" data-name=\"theme label heading\">Temă</span>\n<select class=\"min-w-[170px] px-3.5 py-2 rounded-[10px] bg-[#252320] border border-[#e6dfd8]/15 text-[#faf9f5] text-[13px] font-medium cursor-pointer focus:outline-none focus:border-[#cc785c]\" data-kid=\"3-1-2\" data-name=\"theme selector dropdown\">\n<option data-kid=\"3-1-2-1\" data-name=\"theme option: night\">🌙 Noapte</option>\n<option data-kid=\"3-1-2-2\" data-name=\"theme option: crema\">🫖 Cremă</option>\n<option data-kid=\"3-1-2-3\" data-name=\"theme option: construction\">🧱 Șantier</option>\n<option data-kid=\"3-