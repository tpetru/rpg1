      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.font-serif-d { font-family: 'Cormorant Garamond', Georgia, serif; }\n.font-mono-d { font-family: 'JetBrains Mono', ui-monospace, monospace; }\n</style>\n<div class=\"min-h-screen bg-[#faf9f5] text-[#141413]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',system-ui,sans-serif;\">\n<!-- ===================== Header 56px ===================== -->\n<header class=\"sticky top-0 z-40 bg-[#faf9f5] border-b border-[#e6dfd8]\" data-kid=\"1-1\" data-name=\"sticky site header\" style=\"height:56px;\">\n<div class=\"mx-auto flex items-center justify-between h-full\" data-kid=\"1-1-1\" data-name=\"header inner bar\" style=\"max-width:1200px;padding:0 30px;\">\n<div class=\"flex items-baseline gap-8\" data-kid=\"1-1-1-1\" data-name=\"brand and navigation group\">\n<div class=\"flex items-baseline gap-2\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo lockup\">\n<strong class=\"font-mono-d text-[15px] font-medium\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand name CASA\" style=\"letter-spacing:.14em;\">CASA</strong>\n<span class=\"font-serif-d italic text-[15px] text-[#6c6a64]\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand project name Chicerea\">Chicerea</span>\n</div>\n<nav class=\"flex items-center gap-6 text-[13px]\" data-kid=\"1-1-1-1-2\" data-name=\"main navigation links\">\n<a class=\"text-[#141413] font-medium pb-[17px]\" data-kid=\"1-1-1-1-2-1\" data-name=\"active nav link Construcție\" href=\"#\" style=\"box-shadow:0 12px 0 -10px #cc785c;\">Construcție</a>\n<a class=\"text-[#6c6a64] hover:text-[#141413]\" data-kid=\"1-1-1-1-2-2\" data-name=\"nav link Design\" href=\"#\" style=\"transition:color .15s;\">Design</a>\n<a class=\"text-[#6c6a64] hover:text-[#