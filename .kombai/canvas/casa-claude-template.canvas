        "x": 4620,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.serif{font-family:'Cormorant Garamond',serif;font-weight:500;letter-spacing:-.02em}\n.mono{font-family:'JetBrains Mono',ui-monospace,monospace}\n.pill{height:40px;padding:0 16px;border-radius:9999px;border:1px solid #e6dfd8;background:#faf9f5;color:#6c6a64;font-size:13px;font-weight:500;display:inline-flex;align-items:center;gap:7px;white-space:nowrap}\n.pill .n{font-family:'JetBrains Mono',monospace;font-size:11px;color:#8e8b82}\n.pill-active{background:#e8e0d2;border-color:#e8e0d2;color:#141413}\n.pill-active .n{color:#5f584c}\n.thead{display:grid;grid-template-columns:44px minmax(0,1fr) 132px 132px 168px 84px;align-items:center;height:36px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#8e8b82;border-bottom:1px solid #e6dfd8}\n.thead > div{padding:0 8px}\n.thead .r{text-align:right}\n.prow{display:grid;grid-template-columns:44px minmax(0,1fr) 132px 132px 168px 84px;align-items:center;min-height:44px;border-bottom:1px solid #ebe6df}\n.prow > div{padding:6px 8px}\n.prow:hover{background:#f5f0e8}\n.grow{display:flex;align-items:baseline;gap:10px;height:40px;background:#f5f0e8;border-bottom:1px solid #e6dfd8;padding:0 8px}\n.chip{font-size:11px;line-height:1;padding:4px 8px;border-radius:9999px;background:#efe9de;color:#3d3d3a;white-space:nowrap}\n</style>\n<header class=\"h-[56px] bg-[#faf9f5] border-b border-[#e6dfd8] sticky top-0 z-40\" data-kid=\"1\" data-name=\"sticky site header bar\">\n<div class=\"h-full max-w-[1200px] mx-auto px-2 flex items-center gap-8\" data-kid=\"1-1\" data-name=\"header inner layout container\">\n<div class=\"flex items-baseline gap-2 shrink-0\" data-kid=\"1-1-1\" data-name=\"brand logo container\">\n<span class=\"text-[15px] font-bold tracking-[.14em] text-[#141413]\" data-kid=\"1-1-1-1\" data-name=\"brand logo main text\">CASA</span>\n<span class=\"serif text-[15px] text-[#6c6a64] italic\" data-kid=\"1-1-1-2\" data-name=\"brand logo secondary text\">Chicerea</span>\n</div>\n<nav class=\"flex items-center gap-6 text-[13px] text-[#6c6a64]\" data-kid=\"1-1-2\" data-name=\"main site navigation\">\n<a class=\"hover:text-[#141413]\" data-kid=\"1-1-2-1\" data-name=\"navigation link: construction\" href=\"#\">Construcție</a>\n<a class=\"hover:text-[#141413]\" data-kid=\"1-1-2-2\" data-name=\"navigation link: design\" href=\"#\">Design</a>\n<a class=\"hover:text-[#141413]\" data-kid=\"1-1-2-3\" data-name=\"navigation link: links\" href=\"#\">Link-uri</a>\n<a class=\"hover:text-[#141413]\" data-kid=\"1-1-2-4\" data-name=\"navigation link: journal\" href=\"#\">Jurnal</a>\n<a class=\"text-[#141413] font-medium pb-[18px] shadow-[0_12px_0_-10px_#cc785c]\" data-kid=\"1-1-2-5\" data-name=\"active navigation link: shopping list\" href=\"#\">Lista de cumpărături</a>\n</nav>\n<div class=\"ml-auto flex items-center gap-5 shrink-0\" data-kid=\"1-1-3\" data-name=\"header right-side utility area\">\n<span class=\"mono text-[11px] tracking-[.04em] text-[#8e8b82]\" data-kid=\"1-1-3-1\" data-name=\"current project stage label\">ETAPA 7 · TENCUIALĂ</span>\n<a class=\"text-[13px] text-[#8e8b82] hover:text-[#c64545]\" data-kid=\"1-1-3-2\" data-name=\"logout link\" href=\"#\">Ieși</a>\n</div>\n</div>\n</header>\n<main class=\"max-w-[1200px] mx-auto px-2 pt-8 pb-16\" data-kid=\"2\" data-name=\"main content area\">\n<div class=\"flex items-start justify-between gap-8 pb-5\" data-kid=\"2-1\" data-name=\"page header row with title and actions\">\n<h1 class=\"serif text-[28px] text-[#141413]\" data-kid=\"2-1-1\" data-name=\"page main title\">Lista de cumpărături</h1>\n<div class=\"flex flex-col items-end gap-1.5\" data-kid=\"2-1-2\" data-name=\"header action column\">\n<button class=\"h-10 px-5 rounded-lg bg-[#cc785c] hover:bg-[#a9583e] text-white text-sm font-medium inline-flex items-center gap-2 transition-colors duration-150\" data-kid=\"2-1-2-1\" data-name=\"refresh prices call-to-action button\">\n<i class=\"ti ti-refresh text-[15px]\" data-kid=\"2-1-2-1-1\" data-name=\"refresh icon in button\"></i>Verifică prețurile\n      </button>\n<div class=\"mono text-[11px] text-[#8e8b82]\" data-kid=\"2-1-2-2\" data-name=\"last run status text\">ultima rulare 27.10.2026 09:00 · 14/15 ok</div>\n</div>\n</div>\n<div class=\"flex items-center justify-between gap-4 pb-4\" data-kid=\"2-2\" data-name=\"filter and sort toolbar\">\n<div class=\"flex items-center gap-2\" data-kid=\"2-2-1\" data-name=\"status filter pill group\">\n<button class=\"pill pill-active\" data-kid=\"2-2-1-1\" data-name=\"active filter pill: all items\">Toate <span class=\"n\" data-kid=\"2-2-1-1-1\" data-name=\"filter count badge\">15</span></button>\n<button class=\"pill\" data-kid=\"2-2-1-2\" data-name=\"filter pill: price decreased\">A scăzut <span class=\"n\" data-kid=\"2-2-1-2-1\" data-name=\"filter count badge\">4</span></button>\n<button class=\"pill\" data-kid=\"2-2-1-3\" data-name=\"filter pill: price increased\">A crescut <span class=\"n\" data-kid=\"2-2-1-3-1\" data-name=\"filter count badge\">3</span></button>\n<button class=\"pill\" data-kid=\"2-2-1-4\" data-name=\"filter pill: error\">Eroare <span class=\"n\" data-kid=\"2-2-1-4-1\" data-name=\"filter count badge\">1</span></button>\n</div>\n<select class=\"h-10 px-3 rounded-lg border border-[#e6dfd8] bg-[#faf9f5] text-[#141413] text-[13px] font-medium cursor-pointer focus:outline-none focus:border-[#cc785c]\" data-kid=\"2-2-2\" data-name=\"sort dropdown select\">\n<option data-kid=\"2-2-2-1\" data-name=\"sort option: price ascending\">Sortare: Preț crescător</option>\n<option data-kid=\"2-2-2-2\" data-name=\"sort option: default\">Sortare: Implicit</option>\n<option data-kid=\"2-2-2-3\" data-name=\"sort option: manual\">Sortare: Manual</option>\n<option data-kid=\"2-2-2-4\" data-name=\"sort option: priority first\">Sortare: Prioritare primele</option>\n<option data-kid=\"2-2-2-5\" data-name=\"sort option: name A-Z\">Sortare: Nume (A–Z)</option>\n</select>\n</div>\n<div class=\"bg-[#faf9f5] border border-[#e6dfd8] rounded-xl overflow-hidden\" data-kid=\"2-3\" data-name=\"shopping list table container\">\n<div class=\"thead bg-[#faf9f5]\" data-kid=\"2-3-1\" data-name=\"table column header row\">\n<div data-kid=\"2-3-1-1\" data-name=\"unchecked empty table column header\"></div>\n<div data-kid=\"2-3-1-2\" data-name=\"table column header: product\">Produs</div>\n<div data-kid=\"2-3-1-3\" data-name=\"table column header: history\">Istoric</div>\n<div class=\"r\" data-kid=\"2-3-1-4\" data-name=\"table column header: price\">Preț</div>\n<div data-kid=\"2-3-1-5\" data-name=\"table column header: trend\">Trend</div>\n<div class=\"r\" data-kid=\"2-3-1-6\" data-name=\"table column header: actions\">Acțiuni</div>\n</div>\n<div class=\"grow\" data-kid=\"2-3-2\" data-name=\"product category group header: living\"><span class=\"serif text-[17px] text-[#141413]\" data-kid=\"2-3-2-1\" data-name=\"category name: living room\">Living</span><span class=\"mono text-[11px] text-[#8e8b82]\" data-dynamic=\"true\" data-kid=\"2-3-2-2\" data-name=\"category product count\" data-reason='\"item count likely recalculated by script from data\"'>5 produse</span></div>\n<div class=\"prow\" data-kid=\"2-3-3\" data-name=\"product row: floor parquet\">\n<div class=\"text-center text-[16px] leading-none\" data-dynamic=\"true\" data-kid=\"2-3-3-1\" data-name=\"favorite/pinned indicator cell\" data-reason=\"pinned state likely toggled by script\"><i class=\"ti ti-crown text-[#e8a55a]\" data-kid=\"2-3-3-1-1\" data-name=\"active crown icon\"></i></div>\n<div class=\"min-w-0\" data-kid=\"2-3-3-2\" data-name=\"product details cell\">\n<div class=\"text-[14px] font-medium text-[#141413]\" data-kid=\"2-3-3-2-1\" data-name=\"product name: floor parquet\">Parchet Triangulo stejar natural 3/220</div>\n<div class=\"mt-0.5 flex items-center gap-2 min-w-0\" data-kid=\"2-3-3-2-2\" data-name=\"product meta row\">\n<span class=\"text-[12px] text-[#8e8b82]\" data-kid=\"2-3-3-2-2-1\" data-name=\"product source store: eMAG\">eMAG</span>\n<span class=\"chip\" data-kid=\"2-3-3-2-2-2\" data-name=\"product attribute chip: parquet category\">parchet</span><span class=\"chip\" data-kid=\"2-3-3-2-2-3\" data-name=\"product attribute chip: area size\">3,2 mp</span>\n</div>\n</div>\n<div class=\"text-center\" data-kid=\"2-3-3-3\" data-name=\"price history sparkline cell\">\n<svg aria-hidden=\"true\" class=\"inline-block\" data-dynamic=\"true\" data-kid=\"2-3-3-3-1\" data-name=\"price history line chart sparkline\" data-reason=\"sparkline points set from data\" height=\"28\" viewbox=\"0 0 110 28\" width=\"110\">\n<polyline fill=\"none\" points=\"6,8 26,10 46,9 66,13 86,16 104,19\" stroke=\"#6c6a64\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"></polyline>\n<circle cx=\"104\" cy=\"19\" fill=\"#5db872\" r=\"2.5\"></circle>\n</svg>\n</div>\n<div class=\"text-right mono text-[14px] text-[#141413]\" data-kid=\"2-3-3-4\" data-name=\"current price display: parquet\">187,50 <span class=\"text-[11px] text-[#8e8b82]\" data-kid=\"2-3-3-4-1\" data-name=\"price unit label LEI/mp\">LEI/mp</span></div>\n<div class=\"mono text-[12px] text-[#5db872]\" data-kid=\"2-3-3-5\" data-name=\"price decrease change indicator\">▼ 4,20 față de 20.10</div>\n<div class=\"text-right whitespace-nowrap text-[#8e8b82]\" data-kid=\"2-3-3-6\" data-name=\"row action buttons cell\">\n<i class=\"ti ti-refresh text-[15px] cursor-pointer hover:text-[#141413]\" data-kid=\"2-3-3-6-1\" data-name=\"refresh price action icon\"></i>\n<i class=\"ti ti-pencil text-[15px] ml-2.5 cursor-pointer hover:text-[#141413]\" data-kid=\"2-3-3-6-2\" data-name=\"edit product action icon\"></i>\n<i class=\"ti ti-x text-[15px] ml-2.5 cursor-pointer hover:text-[#c64545]\" data-kid=\"2-3-3-6-3\" data-name=\"delete item action icon\"></i>\n</div>\n</div>\n<div class=\"border-b border-[#ebe6df] bg-[#faf9f5]\" data-kid=\"2-3-4\" data-name=\"product note/annotation row\">\n<div class=\"pl-[60px] pr-4 py-2.5 border-l-2 border-[#e6dfd8] ml-2\" data-kid=\"2-3-4-1\" data-name=\"product note content\">\n<div class=\"text-[12px] text-[#6c6a64]\" data-kid=\"2-3-4-1-1\" data-name=\"product note text with author and date\">adăugat de Ana · 12.09.2026 · „varianta cu capete rotunde\"</div>\n<div class=\"mono text-[11px] text-[#8e8b82] mt-1 leading-[1.6]\" data-kid=\"2-3-4-1-2\" data-name=\"product price history list\">20.10 — 191,70 LEI/mp<br data-kid=\"2-3-4-1-2-1\" data-name=\"line break in price history\"/>27.10 — 187,50 LEI/mp</div>\n</div>\n</div>\n<div class=\"prow\" data-kid=\"2-3-5\" data-name=\"product row: paint\">\n<div class=\"text-center text-[16px] leading-none\" data-kid=\"2-3-5-1\" data-name=\"pinned indicator cell (inactive)\"><i class=\"ti ti-crown text-[#e8a55a]/40\" data-kid=\"2-3-5-1-1\" data-name=\"dimmed crown icon\"></i></div>\n<div class=\"min-w-0\" data-kid=\"2-3-5-2\" data-name=\"product details cell\">\n<div class=\"text-[14px] font-medium text-[#141413]\" data-kid=\"2-3-5-2-1\" data-name=\"product name: washable paint\">Vopsea lavabilă Ceresit 10L albul 9</div>\n<div class=\"mt-0.5 flex items-center gap-2 min-w-0\" data-kid=\"2-3-5-2-2\" data-name=\"product meta row\">\n<span class=\"text-[12px] text-[#8e8b82]\" data-kid=\"2-3-5-2-2-1\" data-name=\"product source store: Dedeman\">Dedeman</span>\n<span class=\"chip\" data-kid=\"2-3-5-2-2-2\" data-name=\"product attribute chip: washable\">lavabilă</span>\n</div>\n</div>\n<div class=\"text-center\" data-kid=\"2-3-5-3\" data-name=\"price history sparkline cell\">\n<svg aria-hidden=\"true\" class=\"inline-block\" data-dynamic=\"true\" data-kid=\"2-3-5-3-1\" data-name=\"price history line chart sparkline (rising)\" data-reason=\"sparkline points driven by price data\" height=\"28\" viewbox=\"0 0 110 28\" width=\"110\">\n<polyline fill=\"none\" points=\"6,16 26,14 46,15 66,11 86,12 104,8\" stroke=\"#6c6a64\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"></polyline>\n<circle cx=\"104\" cy=\"8\" fill=\"#cc785c\" r=\"2.5\"></circle>\n</svg>\n</div>\n<div class=\"text-right mono text-[14px] text-[#141413]\" data-kid=\"2-3-5-4\" data-name=\"current price display: paint\">129,00 <span class=\"text-[11px] text-[#8e8b82]\" data-kid=\"2-3-5-4-1\" data-name=\"price unit label LEI\">LEI</span></div>\n<div class=\"mono text-[12px] text-[#c64545]\" data-kid=\"2-3-5-5\" data-name=\"price increase change indicator\">▲ 8,00 față de 21.10</div>\n<div class=\"text-right whitespace-nowrap text-[#8e8b82]\" data-kid=\"2-3-5-6\" data-name=\"row action buttons cell\">\n<i class=\"ti ti-refresh text-[15px] cursor-pointer hover:text-[#141413]\" data-kid=\"2-3-5-6-1\" data-name=\"refresh price action icon\"></i>\n<i class=\"ti ti-pencil text-[15px] ml-2.5 cursor-pointer hover:text-[#141413]\" data-kid=\"2-3-5-6-2\" data-name=\"edit product action icon\"></i>\n<i class=\"ti ti-x text-[15px] ml-2.5 cursor-pointer hover:text-[#c64545]\" data-kid=\"2-3-5-6-3\" data-name=\"delete item action icon\"></i>\n</div>\n</div>\n<div class=\"prow\" data-kid=\"2-3-6\" data-name=\"product row: TV cable\">\n<div class=\"text-center text-[16px] leading-none\" data-kid=\"2-3-6-1\" data-name=\"pinned indicator cell (inactive)\"><i class=\"ti ti-crown text-[#e8a55a]/40\" data-kid=\"2-3-6-1-1\" data-name=\"dimmed crown icon\"></i></div>\n<div class=\"min-w-0\" data-kid=\"2-3-6-2\" data-name=\"product details cell\">\n<div class=\"text-[14px] font-medium text-[#141413]\" data-kid=\"2-3-6-2-1\" data-name=\"product name: TV cable and clip\">Cablă TV + prindere</div>\n<div class=\"mt-0.5 flex items-center gap-2 min-w-0\" data-kid=\"2-3-6-2-2\" data-name=\"product meta row\">\n<span class=\"text-[12px] text-[#8e8b82]\" data-kid=\"2-3-6-2-