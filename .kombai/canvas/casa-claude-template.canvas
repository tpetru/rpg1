      "html": "<!-- @keep -->\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.serif { font-family: 'Cormorant Garamond', 'Tiempos Headline', serif; }\n.sans { font-family: 'Inter', system-ui, sans-serif; }\n.mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }\n</style>\n<div class=\"sans min-h-screen w-full flex flex-col lg:flex-row bg-[#faf9f5] text-[#141413]\" data-kid=\"1\" data-name=\"page two-column layout wrapper\">\n<!-- ============ LEFT — access column ============ -->\n<div class=\"w-full lg:w-[520px] lg:shrink-0 flex flex-col\" data-kid=\"1-1\" data-name=\"left access/login column\">\n<header class=\"h-[72px] shrink-0 px-8 lg:px-12 flex items-center justify-between border-b border-[#e6dfd8]\" data-kid=\"1-1-1\" data-name=\"site header bar\">\n<div class=\"flex items-baseline gap-2\" data-kid=\"1-1-1-1\" data-name=\"logo lockup container\">\n<span class=\"text-[15px] font-bold tracking-[0.16em] text-[#141413]\" data-kid=\"1-1-1-1-1\" data-name=\"logo word CASA\">CASA</span>\n<span class=\"serif italic text-[17px] text-[#8e8b82] leading-none\" data-kid=\"1-1-1-1-2\" data-name=\"logo italic tagline noastra\">noastră</span>\n</div>\n</header>\n<main class=\"flex-1 flex flex-col justify-center px-8 lg:px-12 py-10\" data-kid=\"1-1-2\" data-name=\"main access panel\">\n<h1 class=\"serif font-normal text-[32px] leading-[1.12] tracking-[-0.02em] text-[#141413]\" data-kid=\"1-1-2-1\" data-name=\"access prompt headline\">Introdu parola pentru acces</h1>\n<form class=\"mt-8\" data-kid=\"1-1-2-2\" data-name=\"password access form\" onsubmit=\"return false;\">\n<label class=\"block text-[13px] font-medium text-[#6c6a64] mb-2\" data-kid=\"1-1-2-2-1\" data-name=\"password field label\" for=\"casa-pass\">Parolă</label>\n<input autocomplete=\"current-password\" class=\"w-full h-10 bg-[#faf9f5] border border-[#cc785c] rounded-lg px-3.5 text-[14px] text-[#141413] tracking-[0.3em] shadow-[0_0_0_3px_rgba(204,120,92,0.15)] placeholder:text-[#8e8b82] placeholder:tracking-normal focus:outline-hidden focus:border-[#cc785c] focus:shadow-[0_0_0_3px_rgba(204,120,92,0.15)] transition-shadow duration-150\" data-kid=\"1-1-2-2-2\" data-name=\"password input field\" id=\"casa-pass\" type=\"password\" value=\"1998\"/>\n<button class=\"mt-4 w-full h-10 bg-[#cc785c] hover:bg-[#a9583e] active:bg-[#a9583e] text-white rounded-lg text-[14px] font-medium transition-colors duration-150\" data-kid=\"1-1-2-2-3\" data-name=\"submit enter button\" type=\"submit\">Intră</button>\n</form>\n<div class=\"mt-10\" data-kid=\"1-1-2-3\" data-name=\"theme control group\">\n<div class=\"mono text-[11px] uppercase tracking-[0.14em] text-[#8e8b82] mb-2\" data-kid=\"1-1-2-3-1\" data-name=\"theme label text\">Temă</div>\n<button class=\"flex items-center justify-between gap-3 min-w-[180px] h-10 px-3.5 bg-[#faf9f5] border border-[#e6dfd8] rounded-lg text-[14px] font-medium text-[#141413] transition-colors duration-150 hover:border-[#cc785c]\" data-kid=\"1-1-2-3-2\" data-name=\"theme toggle dropdown button\" type=\"button\">\n<span data-kid=\"1-1-2-3-2-1\" data-name=\"theme option label night\">🌙 Noapte</span>\n<i aria-hidden=\"true\" class=\"ti ti-chevron-down text-[15px] text-[#8e8b82]\" data-kid=\"1-1-2-3-2-2\" data-name=\"chevron down dropdown icon\"></i>\n</button>\n</div>\n</main>\n<footer class=\"shrink-0 px-8 lg:px-12 pb-8 pt-4 text-[13px] text-[#8e8b82]\" data-kid=\"1-1-3\" data-name=\"footer privacy note text\">Acces privat. Fiecare casă are parola ei.</footer>\n</div>\n<!-- ============ RIGHT — drawing column ============ -->\n<div class=\"hidden lg:flex flex-1 relative overflow-hidden bg-[#f5f0e8]\" data-kid=\"1-2\" data-name=\"right architectural drawing column\" style=\"background-image: linear-gradient(to right, rgba(20,20,19,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(20,20,19,0.04) 1px, transparent 1px); background-size: 32px 32px;\">\n<!-- coral line-art floor plan -->\n<svg aria-hidden=\"true\" class=\"absolute inset-0 w-full h-full\" data-kid=\"1-2-1\" data-name=\"decorative coral line-art floor plan\" fill=\"none\" viewbox=\"50 60 660 520\">\n<defs>\n<pattern height=\"14\" id=\"hatch45\" patterntransform=\"rotate(45)\" patternunits=\"userSpaceOnUse\" width=\"14\">\n<line opacity=\"0.30\" stroke=\"#cc785c\" stroke-width=\"1\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"14\"></line>\n</pattern>\n</defs>\n<!-- top dimension line -->\n<g opacity=\"0.55\" stroke=\"#cc785c\" stroke-width=\"1\">\n<line x1=\"120\" x2=\"120\" y1=\"146\" y2=\"88\"></line>\n<line x1=\"430\" x2=\"430\" y1=\"146\" y2=\"88\"></line>\n<line x1=\"560\" x2=\"560\" y1=\"146\" y2=\"88\"></line>\n<line x1=\"120\" x2=\"560\" y1=\"100\" y2=\"100\"></line>\n<line x1=\"113\" x2=\"127\" y1=\"107\" y2=\"93\"></line>\n<line x1=\"423\" x2=\"437\" y1=\"107\" y2=\"93\"></line>\n<line x1=\"553\" x2=\"567\" y1=\"107\" y2=\"93\"></line>\n</g>\n<text class=\"mono\" fill=\"#8e8b82\" font-size=\"11\" letter-spacing=\"0.06em\" text-anchor=\"middle\" x=\"275\" y=\"92\">8.60</text>\n<text class=\"mono\" fill=\"#8e8b82\" font-size=\"11\" letter-spacing=\"0.06em\" text-anchor=\"middle\" x=\"495\" y=\"92\">2.60</text>\n<!-- left dimension line -->\n<g opacity=\"0.55\" stroke=\"#cc785c\" stroke-width=\"1\">\n<line x1=\"66\" x2=\"118\" y1=\"150\" y2=\"150\"></line>\n<line x1=\"66\" x2=\"118\" y1=\"410\" y2=\"410\"></line>\n<line x1=\"66\" x2=\"118\" y1=\"550\" y2=\"550\"></line>\n<line x1=\"78\" x2=\"78\" y1=\"150\" y2=\"550\"></line>\n<line x1=\"71\" x2=\"85\" y1=\"157\" y2=\"143\"></line>\n<line x1=\"71\" x2=\"85\" y1=\"417\" y2=\"403\"></line>\n<line x1=\"71\" x2=\"85\" y1=\"557\" y2=\"543\"></line>\n</g>\n<text class=\"mono\" fill=\"#8e8b82\" font-size=\"11\" text-anchor=\"middle\" transform=\"rotate(-90 70 280)\" x=\"70\" y=\"284\">4.00</text>\n<text class=\"mono\" fill=\"#8e8b82\" font-size=\"11\" text-anchor=\"middle\" transform=\"rotate(-90 70 480)\" x=\"70\" y=\"484\">1.80</text>\n<!-- terrace hatch band -->\n<rect fill=\"url(#hatch45)\" height=\"400\" width=\"120\" x=\"560\" y=\"150\"></rect>\n<rect height=\"400\" stroke=\"#cc785c\" stroke-width=\"1.5\" width=\"120\" x=\"560\" y=\"150\"></rect>\n<rect fill=\"#f5f0e8\" height=\"110\" width=\"8\" x=\"676\" y=\"300\"></rect>\n<line stroke=\"#cc785c\" stroke-width=\"1.5\" x1=\"680\" x2=\"680\" y1=\"300\" y2=\"410\"></line>\n<!-- outer walls -->\n<rect height=\"400\" stroke=\"#cc785c\" stroke-width=\"2\" width=\"440\" x=\"120\" y=\"150\"></rect>\n<rect height=\"384\" stroke=\"#cc785c\" stroke-width=\"1\" width=\"424\" x=\"128\" y=\"158\"></rect>\n<!-- interior walls -->\n<line stroke=\"#cc785c\" stroke-width=\"1.5\" x1=\"430\" x2=\"430\" y1=\"158\" y2=\"340\"></line>\n<line stroke=\"#cc785c\" stroke-width=\"1.5\" x1=\"430\" x2=\"430\" y1=\"380\" y2=\"542\"></line>\n<line stroke=\"#cc785c\" stroke-width=\"1.5\" x1=\"430\" x2=\"552\" y1=\"410\" y2=\"410\"></line>\n<!-- windows (breaks in the wall) -->\n<rect fill=\"#f5f0e8\" height=\"8\" stroke=\"#cc785c\" stroke-width=\"1\" width=\"120\" x=\"190\" y=\"146\"></rect>\n<line stroke=\"#cc785c\" stroke-width=\"1\" x1=\"190\" x2=\"310\" y1=\"150\" y2=\"150\"></line>\n<rect fill=\"#f5f0e8\" height=\"8\" stroke=\"#cc785c\" stroke-width=\"1\" width=\"80\" x=\"460\" y=\"146\"></rect>\n<line stroke=\"#cc785c\" stroke-width=\"1\" x1=\"460\" x2=\"540\" y1=\"150\" y2=\"150\"></line>\n<rect fill=\"#f5f0e8\" height=\"90\" stroke=\"#cc785c\" stroke-width=\"1\" width=\"8\" x=\"116\" y=\"240\"></rect>\n<line stroke=\"#cc785c\" stroke-width=\"1\" x1=\"120\" x2=\"120\" y1=\"240\" y2=\"330\"></line>\n<!-- entrance door, left wall -->\n<rect fill=\"#f5f0e8\" height=\"60\" width=\"8\" x=\"116\" y=\"440\"></rect>\n<path d=\"M120 500 A 60 60 0 0 1 180 440\" opacity=\"0.7\" stroke=\"#cc785c\" stroke-width=\"1\"></path>\n<line stroke=\"#cc785c\" stroke-width=\"1.5\" x1=\"120\" x2=\"180\" y1=\"500\" y2=\"440\"></line>\n<!-- living / corridor door -->\n<rect fill=\"#f5f0e8\" height=\"48\" width=\"8\" x=\"426\" y=\"196\"></rect>\n<path d=\"M430 244 A 48 48 0 0 0 382 196\" opacity=\"0.7\" stroke=\"#cc785c\" stroke-width=\"1\"></path>\n<line stroke=\"#cc785c\" stroke-width=\"1.5\" x1=\"430\" x2=\"382\" y1=\"244\" y2=\"196\"></line>\n<!-- kitchen door -->\n<rect fill=\"#f5f0e8\" height=\"48\" width=\"8\" x=\"426\" y=\"286\"></rect>\n<path d=\"M430 286 A 48 48 0 0 1 478 334\" opacity=\"0.7\" stroke=\"#cc785c\" stroke-width=\"1\"></path>\n<line stroke=\"#cc785c\" stroke-width=\"1.5\" x1=\"430\" x2=\"478\" y1=\"286\" y2=\"334\"></line>\n<!-- bathroom door -->\n<rect fill=\"#f5f0e8\" height=\"44\" width=\"8\" x=\"426\" y=\"440\"></rect>\n<path d=\"M430 484 A 44 44 0 0 1 386 440\" opacity=\"0.7\" stroke=\"#cc785c\" stroke-width=\"1\"></path>\n<line stroke=\"#cc785c\" stroke-width=\"1.5\" x1=\"430\" x2=\"386\" y1=\"484\" y2=\"440\"></line>\n<!-- stair run in the corridor -->\n<g opacity=\"0.55\" stroke=\"#cc785c\" stroke-width=\"1\">\n<line x1=\"440\" x2=\"548\" y1=\"170\" y2=\"170\"></line>\n<line x1=\"440\" x2=\"548\" y1=\"186\" y2=\"186\"></line>\n<line x1=\"440\" x2=\"548\" y1=\"202\" y2=\"202\"></line>\n<line x1=\"440\" x2=\"548\" y1=\"218\" y2=\"218\"></line>\n<line x1=\"440\" x2=\"548\" y1=\"234\" y2=\"234\"></line>\n<line x1=\"440\" x2=\"548\" y1=\"250\" y2=\"250\"></line>\n<line x1=\"440\" x2=\"548\" y1=\"266\" y2=\"266\"></line>\n<line x1=\"440\" x2=\"440\" y1=\"170\" y2=\"266\"></line>\n<line x1=\"548\" x2=\"548\" y1=\"170\" y2=\"266\"></line>\n</g>\n<line opacity=\"0.7\" stroke=\"#cc785c\" stroke-width=\"1\" x1=\"494\" x2=\"494\" y1=\"262\" y2=\"176\"></line>\n<path d=\"M489 184 L494 174 L499 184\" opacity=\"0.7\" stroke=\"#cc785c\" stroke-width=\"1\"></path>\n<!-- room labels -->\n<text class=\"sans\" fill=\"#8e8b82\" font-size=\"12\" letter-spacing=\"0.22em\" text-anchor=\"middle\" x=\"272\" y=\"340\">LIVING</text>\n<text class=\"mono\" fill=\"#b9b2a6\" font-size=\"10\" text-anchor=\"middle\" x=\"272\" y=\"360\">28,4 m²</text>\n<text class=\"sans\" fill=\"#8e8b82\" font-size=\"11\" letter-spacing=\"0.18em\" text-anchor=\"middle\" x=\"490\" y=\"368\">BUCATĂRIE</text>\n<text class=\"sans\" fill=\"#8e8b82\" font-size=\"11\" letter-spacing=\"0.18em\" text-anchor=\"middle\" x=\"490\" y=\"486\">BAIE</text>\n<text class=\"sans\" fill=\"#8e8b82\" font-size=\"11\" letter-spacing=\"0.18em\" text-anchor=\"middle\" x=\"620\" y=\"196\">TERASĂ</text>\n</svg>\n<!-- dark artifact card overlapping the plan's bottom-left -->\n<div class=\"absolute bottom-10 left-8 w-[300px] bg-[#181715] rounded-xl p-5\" data-kid=\"1-2-2\" data-name=\"project progress artifact card\">\n<div class=\"mono text-[10px] tracking-[0.14em] text-[#a09d96] uppercase\" data-kid=\"1-2-2-1\" data-name=\"card project location label\">CASA · Chicerea</div>\n<div class=\"mt-4 flex items-center gap-[7px]\" data-kid=\"1-2-2-2\" data-name=\"progress dot row container\">\n<span class=\"w-[7px] h-[7px] rounded-full bg-[#cc785c]\" data-kid=\"1-2-2-2-1\" data-name=\"progress indicator dot\"></span>\n<span class=\"w-[7px] h-[7px] rounded-full bg-[#cc785c]\" data-kid=\"1-2-2-2-2\" data-name=\"progress indicator dot\"></span>\n<span class=\"w-[7px] h-[7px] rounded-full bg-[#cc785c]\" data-kid=\"1-2-2-2-3\" data-name=\"progress indicator dot\"></span>\n<span class=\"w-[7px] h-[7px] rounded-full bg-[#cc785c]\" data-kid=\"1-2-2-2-4\" data-name=\"progress indicator dot\"></span>\n<span class=\"w-[7px] h-[7px] rounded-full bg-[#cc785c]\" data-kid=\"1-2-2-2-5\" data-name=\"progress indicator dot\"></span>\n<span class=\"w-[7px] h-[7px] rounded-full bg-[#cc785c]\" data-kid=\"1-2-2-2-6\" data-name=\"progress indicator dot\"></span>\n<span class=\"w-[7px] h-[7px] rounded-full border border-[#cc785c]\" data-kid=\"1-2-2-2-7\" data-name=\"current progress hollow dot\"></span>\n<span class=\"w-[7px] h-[7px] rounded-full bg-[#3d3d3a]\" data-kid=\"1-2-2-2-8\" data-name=\"remaining progress muted dot\"></span>\n<span class=\"w-[7px] h-[7px] rounded-full bg-[#3d3d3a]\" data-kid=\"1-2-2-2-9\" data-name=\"remaining progress muted dot\"></span>\n<span class=\"w-[7px] h-[7px] rounded-full bg-[#3d3d3a]\" data-kid=\"1-2-2-2-10\" data-name=\"remaining progress muted dot\"></span>\n<span class=\"w-[7px] h-[7px] rounded-full bg-[#3d3d3a]\" data-kid=\"1-2-2-2-11\" data-name=\"remaining progress muted dot\"></span>\n</div>\n<div class=\"mt-3 flex items-baseline justify-between\" data-kid=\"1-2-2-3\" data-name=\"progress stage row\">\n<span class=\"text-[12px] text-[#faf9f5]\" data-kid=\"1-2-2-3-1\" data-name=\"stage name text\">Etapa 7 · Tencuială</span>\n<span class=\"mono text-[12px] text-[#5db8a6]\" data-kid=\"1-2-2-3-2\" data-name=\"progress percentage value\">64 %</span>\n</div>\n</div>\n</div>\n</div>\n<!-- @keep -->",
