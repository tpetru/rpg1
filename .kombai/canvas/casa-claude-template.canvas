r-radius:9999px;border:1px solid #e6dfd8;color:#8e8b82;\">9</span>\n<span data-kid=\"1-2-1-2-9-2\" data-name=\"stage label Finisaje interior\">Finisaje interior</span>\n</div>\n<div class=\"flex items-center gap-3 px-3 text-[13px] text-[#8e8b82]\" data-kid=\"1-2-1-2-10\" data-name=\"pending stage row Finisaje exterior\" style=\"height:36px;\">\n<span class=\"inline-flex items-center justify-center shrink-0 font-mono-d text-[10px]\" data-kid=\"1-2-1-2-10-1\" data-name=\"stage number badge ten\" style=\"width:19px;height:19px;border-radius:9999px;border:1px solid #e6dfd8;color:#8e8b82;\">10</span>\n<span data-kid=\"1-2-1-2-10-2\" data-name=\"stage label Finisaje exterior\">Finisaje exterior</span>\n</div>\n<div class=\"flex items-center gap-3 px-3 text-[13px] text-[#8e8b82]\" data-kid=\"1-2-1-2-11\" data-name=\"pending stage row Cheie\" style=\"height:36px;\">\n<span class=\"inline-flex items-center justify-center shrink-0 font-mono-d text-[10px]\" data-kid=\"1-2-1-2-11-1\" data-name=\"stage number badge eleven\" style=\"width:19px;height:19px;border-radius:9999px;border:1px solid #e6dfd8;color:#8e8b82;\">11</span>\n<span data-kid=\"1-2-1-2-11-2\" data-name=\"stage label Cheie\">Cheie</span>\n</div>\n</div>\n<p class=\"mt-4 text-[12px] leading-relaxed text-[#8e8b82]\" data-kid=\"1-2-1-3\" data-name=\"ledger caption note\">Calculat automat din lista „Progres general”.</p>\n</aside>\n<!-- ---------- RIGHT: detail pane ---------- -->\n<section class=\"flex-1 min-w-0\" data-kid=\"1-2-2\" data-name=\"detail pane section\">\n<h1 class=\"font-serif-d text-[28px] font-normal text-[#141413]\" data-kid=\"1-2-2-1\" data-name=\"detail pane headline\" style=\"letter-spacing:-0.02em;\">Construcție</h1>\n<!-- Compact metrics band -->\n<div class=\"mt-5 flex items-stretch\" data-kid=\"1-2-2-2\" data-name=\"metrics band container\" style=\"background:#efe9de;border-radius:12px;padding:24px;\">\n<div class=\"pr-8 flex flex-col justify-center\" data-kid=\"1-2-2-2-1\" data-name=\"overall progress metric block\" style=\"min-width:220px;\">\n<span class=\"text-[12px] text-[#6c6a64] mb-1\" data-kid=\"1-2-2-2-1-1\" data-name=\"progress metric label\">Progres general</span>\n<div class=\"flex items-baseline gap-3\" data-kid=\"1-2-2-2-1-2\" data-name=\"progress value row\">\n<span class=\"font-serif-d text-[28px] font-normal text-[#141413]\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"progress percentage value\" style=\"letter-spacing:-0.02em;\">64<span class=\"text-[20px]\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"percent sign\">%</span></span>\n</div>\n<div class=\"mt-2 w-full\" data-kid=\"1-2-2-2-1-3\" data-name=\"progress bar track\" style=\"height:6px;border-radius:9999px;background:rgba(20,20,19,.08);\">\n<div data-kid=\"1-2-2-2-1-3-1\" data-name=\"progress bar fill\" style=\"width:64%;height:6px;border-radius:9999px;background:#3d3d3a;\"></div>\n</div>\n</div>\n<div class=\"pl-8 pr-8 flex flex-col justify-center\" data-kid=\"1-2-2-2-2\" data-name=\"estimated total cost metric block\" style=\"border-left:1px solid #e6dfd8;min-width:230px;\">\n<span class=\"text-[12px] text-[#6c6a64] mb-1\" data-kid=\"1-2-2-2-2-1\" data-name=\"estimated cost label\">Cost total estimat</span>\n<span class=\"font-mono-d text-[16px] text-[#141413]\" data-kid=\"1-2-2-2-2-2\" data-name=\"estimated cost value\" style=\"font-variant-numeric:tabular-nums;\">412,500.00 LEI</span>\n<span class=\"font-mono-d text-[11px] text-[#8e8b82] mt-1\" data-kid=\"1-2-2-2-2-3\" data-name=\"estimated cost EUR equivalent\">≈ 78,571.43 EUR</span>\n</div>\n<div class=\"pl-8 flex flex-col justify-center\" data-kid=\"1-2-2-2-3\" data-name=\"real cost so far metric block\" style=\"border-left:1px solid #e6dfd8;min-width:230px;\">\n<span class=\"text-[12px] text-[#6c6a64] mb-1\" data-kid=\"1-2-2-2-3-1\" data-name=\"real cost label\">Cost real până acum</span>\n<span class=\"font-mono-d text-[16px] text-[#141413]\" data-kid=\"1-2-2-2-3-2\" data-name=\"real cost value\" style=\"font-variant-numeric:tabular-nums;\">268,940.00 LEI</span>\n<span class=\"font-mono-d text-[11px] text-[#8e8b82] mt-1\" data-kid=\"1-2-2-2-3-3\" data-name=\"real cost EUR equivalent\">≈ 51,226.67 EUR</span>\n</div>\n</div>\n<!-- Stage photo panel -->\n<div class=\"relative mt-6 overflow-hidden\" data-kid=\"1-2-2-3\" data-name=\"stage photo panel\" style=\"border-radius:12px;\">\n<img alt=\"Tencuială perete — photo by Tima Miroshnichenko on Pexels\" class=\"w-full block\" data-kid=\"1-2-2-3-1\" data-name=\"stage photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/6473982/pexels-photo-6473982.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1200&amp;q=80\" style=\"height:280px;object-fit:cover;\"/>\n<span class=\"absolute font-mono-d text-[12px]\" data-kid=\"1-2-2-3-2\" data-name=\"photo date caption badge\" style=\"left:16px;bottom:16px;background:rgba(24,23,21,.85);color:#faf9f5;padding:6px 12px;border-radius:8px;letter-spacing:.02em;\">Etapa 7 · Oct 2026</span>\n</div>\n<!-- Items table -->\n<table class=\"w-full mt-8 border-collapse text-[13px]\" data-kid=\"1-2-2-4\" data-name=\"construction items table\">\n<thead data-kid=\"1-2-2-4-1\" data-name=\"table header row container\">\n<tr class=\"font-mono-d text-[11px]\" data-kid=\"1-2-2-4-1-1\" data-name=\"table header row\" style=\"color:#8e8b82;border-bottom:1px solid #e6dfd8;text-transform:uppercase;letter-spacing:.06em;\">\n<th class=\"text-left font-normal py-2 pr-2\" data-kid=\"1-2-2-4-1-1-1\" data-name=\"column header Ordine\" style=\"width:56px;\">Ordine</th>\n<th class=\"text-left font-normal py-2 pr-4\" data-kid=\"1-2-2-4-1-1-2\" data-name=\"column header Material false\">Material / lucrare</th>\n<th class=\"text-right font-normal py-2 pr-4\" data-kid=\"1-2-2-4-1-1-3\" data-name=\"column header Estimare\">Estimare (LEI)</th>\n<th class=\"text-right font-normal py-2 pr-4\" data-kid=\"1-2-2-4-1-1-4\" data-name=\"column header Preț real\">Preț real (LEI)</th>\n<th class=\"text-left font-normal py-2 pr-4\" d