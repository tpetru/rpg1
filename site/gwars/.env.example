# Copy to .env and fill in. The geowars database and user are created by db/setup.sql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=geowars
DB_PASSWORD=
DB_NAME=geowars

PORT=3000
# Set to true behind HTTPS in production
COOKIE_SECURE=false

# Password of /admin. Leave empty to switch the admin page off. Do not commit the real value.
ADMIN_PASSWORD=
