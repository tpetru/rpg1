    }
    printf("[Load] Locatii: %d", g_LocationCount);
    Locations_ApplyToCommands();
    Tuning_LoadPoints();
    Church_LoadLabels();
    return 1;
}

// Suprascrie coordonatele comenzilor din DB (locations_admin) daca randul exista.
// Fiecare grup: daca gaseste locatia dupa nume, actualizeaza globalele corespunzatoare.
Locations_ApplyToCommands()
{
    new idx;
    idx = Locations_FindByID(16);                  if(idx != -1) { ITP_LOC_X = LocationData[idx][locX]; ITP_LOC_Y = LocationData[idx][locY]; ITP_LOC_Z = LocationData[idx][locZ]; }     // Vehicle ITP (/vitp)
    idx = Locations_FindByID(56);                  if(idx != -1) { MARKET_SELL_X = LocationData[idx][locX]; MARKET_SELL_Y = LocationData[idx][locY]; MARKET_SELL_Z = LocationData[idx][locZ]; } // Market - punctul de predare (/v sell)
    idx = Locations_FindByID(111);                 if(idx != -1) { FISH_LOC1_X = LocationData[idx][locX]; FISH_LOC1_Y = LocationData[idx][locY]; FISH_LOC1_Z = LocationData[idx][locZ]; } // Job Fish 1 (/fish)
    idx = Locations_FindByID(147);                 if(idx != -1) { FISH_LOC2_X = LocationData[idx][locX]; FISH_LOC2_Y = LocationData[idx][locY]; FISH_LOC2_Z = LocationData[idx][locZ]; } // Job Fish 2 (/fish)
    idx = Locations_FindByID(146);                 if(idx != -1) { FISH_LOC3_X = LocationData[idx][locX]; FISH_LOC3_Y = LocationData[idx][locY]; FISH_LOC3_Z = LocationData[idx][locZ]; } // Job Fish 3 (/fish)
    idx = Locations_FindByID(60);                  if(idx != -1) { g_TrainStationX[0] = LocationData[idx][locX]; g_TrainStationY[0] = LocationData[idx][locY]; g_TrainStationZ[0] = LocationData[idx][locZ]; } // W LosSantos Station (/train)
    idx = Locations_FindByID(61);                  if(idx != -1) { g_TrainStationX[1] = LocationData[idx][locX]; g_TrainStationY[1] = LocationData[idx][locY]; g_TrainStationZ[1] = LocationData[idx][locZ]; } // S LosSantos Station (/train)
    idx = Locations_FindByID(62);                  if(idx != -1) { g_TrainStationX[2] = LocationData[idx][locX]; g_TrainStationY[2] = LocationData[idx][locY]; g_TrainStationZ[2] = LocationData[idx][locZ]; } // E LosSantos Station (/train)
    idx = Locations_FindByID(15);                  if(idx != -1) { PLATE_LOC_X = LocationData[idx][locX]; PLATE_LOC_Y = LocationData[idx][locY]; PLATE_LOC_Z = LocationData[idx][locZ]; } // Vehicle Plate (/vplate)
    idx = Locations_FindByID(101);                 if(idx != -1) { g_JobTeleport[0][0] = LocationData[idx][locX]; g_JobTeleport[0][1] = LocationData[idx][locY]; g_JobTeleport[0][2] = LocationData[idx][locZ]; } // Job 1 - Glovo Delivery (/joblist)
    idx = Locations_FindByID(102);                 if(idx != -1) { g_JobTeleport[1][0] = LocationData[idx][locX]; g_JobTeleport[1][1] = LocationData[idx][locY]; g_JobTeleport[1][2] = LocationData[idx][locZ]; } // Job 2 - Cement Truck Driver (/joblist)
    idx = Locations_FindByID(103);                 if(idx != -1) { g_JobTeleport[2][0] = LocationData[idx][locX]; g_JobTeleport[2][1] = LocationData[idx][locY]; g_JobTeleport[2][2] = LocationData[idx][locZ]; } // Job 3 - Gun Delivery (/joblist)
    idx = Locations_FindByID(104);                 if(idx != -1) { g_JobTeleport[3][0] = LocationData[idx][locX]; g_JobTeleport[3][1] = LocationData[idx][locY]; g_JobTeleport[3][2] = LocationData[idx][locZ]; } // Job 4 - Car Transportator (/joblist)
    idx = Locations_FindByID(106);                 if(idx != -1) { g_JobTeleport[5][0] = LocationData[idx][locX]; g_JobTeleport[5][1] = LocationData[idx][locY]; g_JobTeleport[5][2] = LocationData[idx][locZ]; } // Job 6 - Cargo Logistics Driver (/joblist)
    idx = Locations_FindByID(107);                 if(idx != -1) { g_JobTeleport[6][0] = LocationData[idx][locX]; g_JobTeleport[6][1] = LocationData[idx][locY]; g_JobTeleport[6][2] = LocationData[idx][locZ]; } // Job 7 - Bus Driver (/joblist)
    idx = Locations_FindByID(108);                 if(idx != -1) { g_JobTeleport[7][0] = LocationData[idx][locX]; g_JobTeleport[7][1] = LocationData[idx][locY]; g_JobTeleport[7][2] = LocationData[idx][locZ]; } // Job 8 - Electrician (/joblist)
    idx = Locations_FindByID(109);                 if(idx != -1) { g_JobTeleport[8][0] = LocationData[idx][locX]; g_JobTeleport[8][1] = LocationData[idx][locY]; g_JobTeleport[8][2] = LocationData[idx][locZ]; } // Job 9 - Crop Duster Pilot (/joblist)
    idx = Locations_FindByID(110);                 if(idx != -1) { g_JobTeleport[9][0] = LocationData[idx][locX]; g_JobTeleport[9][1] = LocationData[idx][locY]; g_JobTeleport[9][2] = LocationData[idx][locZ]; } // Job 10 - Water Hauler (/joblist)
    idx = Locations_FindByID(111);                 if(idx != -1) { g_JobTeleport[10][0] = LocationData[idx][locX]; g_JobTeleport[10][1] = LocationData[idx][locY]; g_JobTeleport[10][2] = LocationData[idx][locZ]; } // Job 11 - Fisherman (/joblist)
    idx = Locations_FindByID(113);                 if(idx != -1) { g_JobTeleport[12][0] = LocationData[idx][locX]; g_JobTeleport[12][1] = LocationData[idx][locY]; g_JobTeleport[12][2] = LocationData[idx][locZ]; } // Job 13 - Fuel Carrier (/joblist)
    idx = Locations_FindByID(114);                 if(idx != -1) { g_JobTeleport[13][0] = LocationData[idx][locX]; g_JobTeleport[13][1] = LocationData[idx][locY]; g_JobTeleport[13][2] = LocationData[idx][locZ]; } // Job 14 - Truck Driver (/joblist)
    idx = Locations_FindByID(115);                 if(idx != -1) { g_JobTeleport[14][0] = LocationData[idx][locX]; g_JobTeleport[14][1] = LocationData[idx][locY]; g_JobTeleport[14][2] = LocationData[idx][locZ]; } // Job 15 - Currency Transporter (/joblist)
    idx = Locations_FindByID(116);                 if(idx != -1) { g_JobTeleport[15][0] = LocationData[idx][locX]; g_JobTeleport[15][1] = LocationData[idx][locY]; g_JobTeleport[15][2] = LocationData[idx][locZ]; } // Job 16 - Beach Groomer (/joblist)
    idx = Locations_FindByID(25);                  if(idx != -1) { UPDOWN_TICKET_LOC_X = LocationData[idx][locX]; UPDOWN_TICKET_LOC_Y = LocationData[idx][locY]; UPDOWN_TICKET_LOC_Z = LocationData[idx][locZ]; } // Gondola - ghiseul de bilete (/buyticket)
    idx = Locations_FindByID(70);                  if(idx != -1) { g_CarWash[0][0] = LocationData[idx][locX]; g_CarWash[0][1] = LocationData[idx][locY]; g_CarWash[0][2] = LocationData[idx][locZ]; } // CarWash West Santos
    idx = Locations_FindByID(71);                  if(idx != -1) { g_CarWash[1][0] = LocationData[idx][locX]; g_CarWash[1][1] = LocationData[idx][locY]; g_CarWash[1][2] = LocationData[idx][locZ]; } // CarWash East Santos
    idx = Locations_FindByID(72);                  if(idx != -1) { g_CarWash[2][0] = LocationData[idx][locX]; g_CarWash[2][1] = LocationData[idx][locY]; g_CarWash[2][2] = LocationData[idx][locZ]; } // CarWash North Santos
    idx = Locations_FindByID(73);                  if(idx != -1) { g_CarWash[3][0] = LocationData[idx][locX]; g_CarWash[3][1] = LocationData[idx][locY]; g_CarWash[3][2] = LocationData[idx][locZ]; } // CarWash South Santos
    for(new t = 0; t < TAXI_LOC_COUNT; t++) // punctele de /taxi (locID 148/149/150)
    {
        idx = Locations_FindByID(g_TaxiLocID[t]);
        if(idx != -1) { g_TaxiLocX[t] = LocationData[idx][locX]; g_TaxiLocY[t] = LocationData[idx][locY]; g_TaxiLocZ[t] = LocationData[idx][locZ]; }
    }
    idx = Locations_FindByName("police_garage_to_int"); if(idx != -1) { POLICE_GARAGE_X = LocationData[idx][locX];   POLICE_GARAGE_Y = LocationData[idx][locY];   POLICE_GARAGE_Z = LocationData[idx][locZ];   POLICE_GARAGE_INT = LocationData[idx][locInterior]; }   // point 20
    idx = Locations_FindByName("police_int_to_garage"); if(idx != -1) { POLICE_ENTRANCE_X = LocationData[idx][locX]; POLICE_ENTRANCE_Y = LocationData[idx][locY]; POLICE_ENTRANCE_Z = LocationData[idx][locZ]; POLICE_ENTRANCE_INT = LocationData[idx][locInterior]; } // point 19
    idx = Locations_FindByName("police_int_to_ext");    if(idx != -1) { POLICE_EXIT_X = LocationData[idx][locX];     POLICE_EXIT_Y = LocationData[idx][locY];     POLICE_EXIT_Z = LocationData[idx][locZ]; }     // point 18
    idx = Locations_FindByName("Cityhall");         if(idx != -1) { CITYHALL_EXT_X = LocationData[idx][locX]; CITYHALL_EXT_Y = LocationData[idx][locY]; CITYHALL_EXT_Z = LocationData[idx][locZ]; } // exterior City Hall (rand DB redenumit "Cityhall")
    idx = Locations_FindByName("cityhall_int");    if(idx != -1) { CITYHALL_INT_X = LocationData[idx][locX]; CITYHALL_INT_Y = LocationData[idx][locY]; CITYHALL_INT_Z = LocationData[idx][locZ]; }
    idx = Locations_FindByName("getjob");          if(idx != -1) { GETJOB_X = LocationData[idx][locX]; GETJOB_Y = LocationData[idx][locY]; GETJOB_Z = LocationData[idx][locZ]; }
    idx = Locations_FindByName("quitjob");         if(idx != -1) { QUITJOB_X = LocationData[idx][locX]; QUITJOB_Y = LocationData[idx][locY]; QUITJOB_Z = LocationData[idx][locZ]; }
    // Spitale (/curedisease): id 22 (Hospital) si 23 (Hospital2)
    g_HospitalCount = 0;
    new const hospIDs[] = {22, 23};
    for(new hi = 0; hi < sizeof(hospIDs); hi++)
    {
        new hidx = Locations_FindByID(hospIDs[hi]);
        if(hidx != -1 && g_HospitalCount < MAX_HOSPITALS)
        {
            g_HospitalLoc[g_HospitalCount][0] = LocationData[hidx][locX];
            g_HospitalLoc[g_HospitalCount][1] = LocationData[hidx][locY];
            g_HospitalLoc[g_HospitalCount][2] = LocationData[hidx][locZ];
            g_HospitalCount++;
        }
    }
    idx = Locations_FindByName("examA");           if(idx != -1) { EXAMA_LOC_X = LocationData[idx][locX]; EXAMA_LOC_Y = LocationData[idx][locY]; EXAMA_LOC_Z = LocationData[idx][locZ]; }
    idx = Locations_FindByName("examB");           if(idx != -1) { EXAMB_LOC_X = LocationData[idx][locX]; EXAMB_LOC_Y = LocationData[idx][locY]; EXAMB_LOC_Z = LocationData[idx][locZ]; }
    idx = Locations_FindByName("examC");           if(idx != -1) { EXAMC_LOC_X = LocationData[idx][locX]; EXAMC_LOC_Y = LocationData[idx][locY]; EXAMC_LOC_Z = LocationData[idx][locZ]; }
    idx = Locations_FindByName("examD");           if(idx != -1) { EXAMD_LOC_X = LocationData[idx][locX]; EXAMD_LOC_Y = LocationData[idx][locY]; EXAMD_LOC_Z = LocationData[idx][locZ]; }
    idx = Locations_FindByID(5);                   if(idx != -1) { EXAMP_LOC_X = LocationData[idx][locX]; EXAMP_LOC_Y = LocationData[idx][locY]; EXAMP_LOC_Z = LocationData[idx][locZ]; } // examP (avion)
    idx = Locations_FindByID(6);                   if(idx != -1) { EXAMH_LOC_X = LocationData[idx][locX]; EXAMH_LOC_Y = LocationData[idx][locY]; EXAMH_LOC_Z = LocationData[idx][locZ]; } // examH (elicopter)
    idx = Locations_FindByID(40);                  if(idx != -1) { EXAMW_LOC_X = LocationData[idx][locX]; EXAMW_LOC_Y = LocationData[idx][locY]; EXAMW_LOC_Z = LocationData[idx][locZ]; } // examW (arme)
    idx = Locations_FindByName("lspd_barrier");    if(idx != -1) { LSPD_BARRIER_X = LocationData[idx][locX]; LSPD_BARRIER_Y = LocationData[idx][locY]; LSPD_BARRIER_Z = LocationData[idx][locZ]; }

    // Punctele de /ad (cate unul per zona) - suprascrise din locations_admin, dupa locID (50=W LS, 51=S LS, 52=E LS)
    for(new adz = 0; adz < AD_ZONE_COUNT; adz++)
    {
        idx = Locations_FindByID(AdZoneLocID[adz]);
        if(idx != -1) { g_AdZoneX[adz] = LocationData[idx][locX]; g_AdZoneY[adz] = LocationData[idx][locY]; g_AdZoneZ[adz] = LocationData[idx][locZ]; }
    }

    // Hunting (locID 24): coordonate + pickup sniper (map icon-ul e local, vezi Factions_SetPlayerIcons)
    idx = Locations_FindByID(24);                  if(idx != -1) { g_HuntStartX = LocationData[idx][locX]; g_HuntStartY = LocationData[idx][locY]; g_HuntStartZ = LocationData[idx][locZ]; }
    CreatePickup(HUNT_PICKUP_MODEL, 1, g_HuntStartX, g_HuntStartY, g_HuntStartZ, -1);
    Create3DTextLabel("[ Hunting ]\nUse /hunt", COLOR_WHITE, g_HuntStartX, g_HuntStartY, g_HuntStartZ - 0.5, 20.0, 0, 0);

    // SGR Unload (locID 31): coordonate + pickup + eticheta 3D
    idx = Locations_FindByID(31);
    if(idx != -1)
    {
        g_SGRUnloadX = LocationData[idx][locX];
        g_SGRUnloadY = LocationData[idx][locY];
        g_SGRUnloadZ = LocationData[idx][locZ];
        CreatePickup(SGR_UNLOAD_PICKUP_MODEL, 1, g_SGRUnloadX, g_SGRUnloadY, g_SGRUnloadZ, -1);
        Create3DTextLabel("[ SGR Unload ]\n[ Type /SGRunload ]\n[ Receive: 50$ per SGR ]\n[ Type /sellsgr to sell ]", COLOR_WHITE,
            g_SGRUnloadX, g_SGRUnloadY, g_SGRUnloadZ - 0.5, 20.0, 0, 0);
    }

    // Trash Unload (locID 32): coordonate + pickup + eticheta 3D
    idx = Locations_FindByID(32);
    if(idx != -1)
    {
        g_TrashUnloadX = LocationData[idx][locX];
        g_TrashUnloadY = LocationData[idx][locY];
        g_TrashUnloadZ = LocationData[idx][locZ];
        CreatePickup(TRASH_UNLOAD_PICKUP_MODEL, 1, g_TrashUnloadX, g_TrashUnloadY, g_TrashUnloadZ, -1);
        Create3DTextLabel("[ Trash Unload ]\n[ Type /trashunload ]\n[ Receive: 30$ per Trash ]", COLOR_WHITE,
            g_TrashUnloadX, g_TrashUnloadY, g_TrashUnloadZ - 0.5, 20.0, 0, 0);
    }

    // ANAF (locID 33): coordonate + pickup + eticheta 3D - vezi /biz getdocs si /biz givedocs
    idx = Locations_FindByID(33);
    if(idx != -1)
    {
        g_AnafX = LocationData[idx][locX];
        g_AnafY = LocationData[idx][locY];
        g_AnafZ = LocationData[idx][locZ];
        CreatePickup(ANAF_PICKUP_MODEL, 1, g_AnafX, g_AnafY, g_AnafZ, -1);
        Create3DTextLabel("[ ANAF ]\n[ Type /biz givedocs ]", COLOR_WHITE,
            g_AnafX, g_AnafY, g_AnafZ - 0.5, 20.0, 0, 0);
    }

    // Manageri aeroport / trenuri / SGR: pickup + eticheta 3D (numele se completeaza din server_setup)
    for(new mgI = 0; mgI < MANAGER_COUNT; mgI++)
        Manager_CreateWorld(mgI);

    // Politie: /duty si cele 2 zone de /arrest (interior + exterior) - celulele de inchisoare sunt fixe (JAIL_CELL_*)
    idx = Locations_FindByName("PR/duty");         if(idx != -1) { DUTY_LOC_X = LocationData[idx][locX]; DUTY_LOC_Y = LocationData[idx][locY]; DUTY_LOC_Z = LocationData[idx][locZ]; DUTY_LOC_INT = LocationData[idx][locInterior]; DUTY_LOC_VW = LocationData[idx][locVW]; }
    idx = Locations_FindByName("Arrest Me");       if(idx != -1) { ARRESTME_X = LocationData[idx][locX]; ARRESTME_Y = LocationData[idx][locY]; ARRESTME_Z = LocationData[idx][locZ]; ARRESTME_INTERIOR = LocationData[idx][locInterior]; ARRESTME_VW = LocationData[idx][locVW]; }
    idx = Locations_FindByName("PR/arrest-int");   if(idx != -1) { ARREST_ZONE_X = LocationData[idx][locX]; ARREST_ZONE_Y = LocationData[idx][locY]; ARREST_ZONE_Z = LocationData[idx][locZ]; }
    idx = Locations_FindByName("PR/arrest-ext");   if(idx != -1) { ARREST_ZONE2_X = LocationData[idx][locX]; ARREST_ZONE2_Y = LocationData[idx][locY]; ARREST_ZONE2_Z = LocationData[idx][locZ]; }
    idx = Locations_FindByName("jail");            if(idx != -1) { JAIL_X = LocationData[idx][locX]; JAIL_Y = LocationData[idx][locY]; JAIL_Z = LocationData[idx][locZ]; JAIL_INTERIOR = LocationData[idx][locInterior]; JAIL_VW = LocationData[idx][locVW]; }

    Cmd_CreateMarkers(); // creeaza pickup-urile/etichetele DUPA ce coordonatele sunt sincronizate din DB
}

// Creeaza pickup-urile si etichetele 3D pentru locatiile de comanda, folosind coordonatele
// (deja suprascrise din locations_admin). Rulat o singura data, din OnLocationsLoaded.
Cmd_CreateMarkers()
{
    Cityhall_Create();
    JobCenter_Create();
    Taxi_CreateStation(); // punctele de /taxi (locID 110/111 din locations_admin)
    Market_CreateSellPoint(); // punctul de predare a masinilor la Market (/v sell)
    UpDown_Create(); // Gondola (/up si /down)
    TeleGondola_Create(); // cabina mobila intre cele 4 statii
    CarWash_Create();      // spalatoriile auto (pickup + eticheta 3D) - DUPA sincronizarea din locations_admin

    CreatePickup(1239, 1, ITP_LOC_X, ITP_LOC_Y, ITP_LOC_Z, -1);
    Create3DTextLabel("[ Vehicle Inspection Service ]\n[ Use /v ITP ]\n[ Price: 750$ ]", COLOR_WHITE,
        ITP_LOC_X, ITP_LOC_Y, ITP_LOC_Z - 0.5, 30.0, 0, 0);
    CreatePickup(1239, 1, PLATE_LOC_X, PLATE_LOC_Y, PLATE_LOC_Z, -1);
    Create3DTextLabel("[ Vehicle Inspection Service ]\n[ Use /v plate ]\n[ Price: 250$ ]", COLOR_WHITE,
        PLATE_LOC_X, PLATE_LOC_Y, PLATE_LOC_Z - 0.5, 30.0, 0, 0);

    new examLabel[96];
    CreatePickup(1210, 1, EXAMA_LOC_X, EXAMA_LOC_Y, EXAMA_LOC_Z, -1);
    format(examLabel, sizeof(examLabel), "[ Category A Exam ]\n[ /examA ]\n[ Price: $%s ]", MoneyStr(g_ExamAPrice));
    Create3DTextLabel(examLabel, COLOR_WHITE, EXAMA_LOC_X, EXAMA_LOC_Y, EXAMA_LOC_Z - 0.5, 25.0, 0, 0);

    CreatePickup(1210, 1, EXAMB_LOC_X, EXAMB_LOC_Y, EXAMB_LOC_Z, -1);
    format(examLabel, sizeof(examLabel), "[ Category B Exam ]\n[ /examB ]\n[ Price: $%s ]", MoneyStr(g_ExamBPrice));
    Create3DTextLabel(examLabel, COLOR_WHITE, EXAMB_LOC_X, EXAMB_LOC_Y, EXAMB_LOC_Z - 0.5, 25.0, 0, 0);

    CreatePickup(1210, 1, EXAMC_LOC_X, EXAMC_LOC_Y, EXAMC_LOC_Z, -1);
    format(examLabel, sizeof(examLabel), "[ Category C Exam ]\n[ /examC ]\n[ Price: $%s ]", MoneyStr(g_ExamCPrice));
    Create3DTextLabel(examLabel, COLOR_WHITE, EXAMC_LOC_X, EXAMC_LOC_Y, EXAMC_LOC_Z - 0.5, 25.0, 0, 0);

    CreatePickup(1210, 1, EXAMD_LOC_X, EXAMD_LOC_Y, EXAMD_LOC_Z, -1);
    format(examLabel, sizeof(examLabel), "[ Category D Exam ]\n[ /examD ]\n[ Price: $%s ]", MoneyStr(g_ExamDPrice));
    Create3DTextLabel(examLabel, COLOR_WHITE, EXAMD_LOC_X, EXAMD_LOC_Y, EXAMD_LOC_Z - 0.5, 25.0, 0, 0);

    CreatePickup(1210, 1, EXAMW_LOC_X, EXAMW_LOC_Y, EXAMW_LOC_Z, -1);
    format(examLabel, sizeof(examLabel), "[ Weapons Exam ]\n[ /examW ]\n[ Price: $%s ]", MoneyStr(EXAMW_PRICE));
    Create3DTextLabel(examLabel, COLOR_WHITE, EXAMW_LOC_X, EXAMW_LOC_Y, EXAMW_LOC_Z - 0.5, 25.0, 0, 0);

    // Punctele de /ad (pickup + eticheta 3D, la fiecare din cele 3 zone)
    for(new adz = 0; adz < AD_ZONE_COUNT; adz++)
    {
        CreatePickup(1239, 1, g_AdZoneX[adz], g_AdZoneY[adz], g_AdZoneZ[adz], -1);
        format(examLabel, sizeof(examLabel), "[ AD: %s ]\n[ Type /ad [text] ]\n[ Price: %d$/character ]", AdZoneData[adz][adZoneName], AD_PRICE_PER_CHAR);
        Create3DTextLabel(examLabel, COLOR_WHITE, g_AdZoneX[adz], g_AdZoneY[adz], g_AdZoneZ[adz] - 0.5, 25.0, 0, 0);
    }

    // Tintele /examW (1238/1238/1512/1512/1512/19825) nu mai sunt create global aici -
    // sunt create per-player, doar pentru durata examenului (vezi ExamW_CreateTargets).
    CreateDynamicObject(19121, 1917.39551, -1324.59167, 13.18454,   0.00000, 0.00000, 0.00000);
    CreateDynamicObject(19121, 1917.49048, -1313.43347, 13.18454,   0.00000, 0.00000, 0.00000);
    CreateDynamicObject(2035, 1918.93030, -1313.94202, 15.30000,   0.00000, 0.00000, 0.00000);
    CreateDynamicObject(2035, 1919.12012, -1317.59680, 15.30000,   0.00000, 0.00000, 20.00000);
    CreateDynamicObject(355, 1918.92261, -1323.79553, 15.34420,   90.00000, 0.00000, 70.00000);
    CreateDynamicObject(355, 1918.03723, -1314.99841, 15.32400,   92.00000, 0.00000, -70.00000);
    CreateDynamicObject(346, 1918.02966, -1321.26611, 15.26420,   90.00000, 0.00000, 0.00000);
    CreateDynamicObject(346, 1919.09961, -1317.33472, 15.26420,   90.00000, 0.00000, 90.00000);
    CreateDynamicObject(346, 1918.79150, -1320.37463, 15.26420,   90.00000, 0.00000, 160.00000);
    CreateDynamicObject(3014, 1920.44238, -1323.71838, 15.15070,   0.00000, 0.00000, 0.00000);
    CreateDynamicObject(3014, 1920.44312, -1323.12439, 15.15070,   0.00000, 0.00000, 0.00000);
    CreateDynamicObject(3014, 1920.39270, -1322.50586, 15.15070,   0.00000, 0.00000, 0.00000);
    CreateDynamicObject(3014, 1920.52258, -1324.30835, 15.15070,   0.00000, 0.00000, 0.00000);

    // Examene de zbor (examH elicopter, examP avion)
    CreatePickup(1239, 1, EXAMH_LOC_X, EXAMH_LOC_Y, EXAMH_LOC_Z, -1);
    Create3DTextLabel("[ Helicopter Exam ]\n[ /examH ]\n[ Price: $1.000 ]", COLOR_WHITE,
        EXAMH_LOC_X, EXAMH_LOC_Y, EXAMH_LOC_Z - 0.5, 15.0, 0, 0);
    CreatePickup(1239, 1, EXAMP_LOC_X, EXAMP_LOC_Y, EXAMP_LOC_Z, -1);
    Create3DTextLabel("[ Airplane Exam ]\n[ /examP ]\n[ Price: $1.000 ]", COLOR_WHITE,
        EXAMP_LOC_X, EXAMP_LOC_Y, EXAMP_LOC_Z - 0.5, 15.0, 0, 0);

    // Garaj (point 20) -> interior. Interior/VW din globalele suprascrise din DB.
    CreateDynamic3DTextLabel("[ Police Garage ]\n[ Press ENTER (F) to go inside ]", COLOR_WHITE,
        POLICE_GARAGE_X, POLICE_GARAGE_Y, POLICE_GARAGE_Z - 0.5, 10.0,
        INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, POLICE_GARAGE_INT);
    // Interior (point 19) -> garaj
    CreateDynamic3DTextLabel("[ To Garage ]\n[ Press ENTER (F) ]", COLOR_WHITE,
        POLICE_ENTRANCE_X, POLICE_ENTRANCE_Y, POLICE_ENTRANCE_Z - 0.5, 10.0,
        INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, POLICE_ENTRANCE_INT);
    // Punctul 18 (interior -> strada) NU are eticheta proprie: exista deja "[ Press ENTER to exit ]" din logica de factiune.

    // Punctul de /arrestme ("Arrest Me", locID 55): pickup star + eticheta
    CreateDynamicPickup(1239, 1, ARRESTME_X, ARRESTME_Y, ARRESTME_Z, ARRESTME_VW, ARRESTME_INTERIOR);
    CreateDynamic3DTextLabel("[ Jail ]\n[ Use /arrestme ]", COLOR_WHITE,
        ARRESTME_X, ARRESTME_Y, ARRESTME_Z - 0.5, 20.0,
        INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, ARRESTME_VW, ARRESTME_INTERIOR);

    for(new hi = 0; hi < g_HospitalCount; hi++)
    {
        CreatePickup(1241, 1, g_HospitalLoc[hi][0], g_HospitalLoc[hi][1], g_HospitalLoc[hi][2], -1);
        Create3DTextLabel("[ Hospitalization ]\n[ Use /curedisease ]", COLOR_WHITE,
            g_HospitalLoc[hi][0], g_HospitalLoc[hi][1], g_HospitalLoc[hi][2] - 0.5, 10.0, 0, 0);
    }

    // Locatiile de /arrest (interior LSPD + exterior garaj): pickup + eticheta 3D, in interiorul/VW-ul corect din DB.
    // Cautate dupa nume (nu dupa locID) ca sa ramana corecte indiferent de renumerotarea randurilor.
    new arIdx;
    arIdx = Locations_FindByID(13);
    if(arIdx != -1)
    {
        CreateDynamicPickup(1247, 1, LocationData[arIdx][locX], LocationData[arIdx][locY], LocationData[arIdx][locZ], LocationData[arIdx][locVW], LocationData[arIdx][locInterior]);
        CreateDynamic3DTextLabel("[ Police Department ]\n[ /arrest ]", COLOR_WHITE,
            LocationData[arIdx][locX], LocationData[arIdx][locY], LocationData[arIdx][locZ] - 0.5, 3.0,
            INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, LocationData[arIdx][locVW], LocationData[arIdx][locInterior]);
    }
    arIdx = Locations_FindByID(14);
    if(arIdx != -1)
    {
        CreateDynamicPickup(1247, 1, LocationData[arIdx][locX], LocationData[arIdx][locY], LocationData[arIdx][locZ], LocationData[arIdx][locVW], LocationData[arIdx][locInterior]);
        CreateDynamic3DTextLabel("[ Police Department ]\n[ /arrest ]", COLOR_WHITE,
            LocationData[arIdx][locX], LocationData[arIdx][locY], LocationData[arIdx][locZ] - 0.5, 10.0,
            INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, LocationData[arIdx][locVW], LocationData[arIdx][locInterior]);
    }

    Train_CreateStations(); // dupa ce g_TrainStationX/Y/Z sunt suprascrise din locations_admin (id 60/61/62)
}

// Porneste un examen de zbor (cat = FLIGHT_CAT_P / FLIGHT_CAT_H). Trimite mesajele si returneaza 1.
// Definita aici (dupa BusinessData) fiindca acceseaza banca business-ului.
stock FlightExam_Begin(playerid, cat)
{
    new Float:lx, Float:ly, Float:lz, Float:rng, price;
    new bool:ready;
    new craft[16];
    if(cat == FLIGHT_CAT_H)
    {
        lx = EXAMH_LOC_X; ly = EXAMH_LOC_Y; lz = EXAMH_LOC_Z; rng = EXAMH_RANGE; price = g_ExamHPrice;
        ready = (g_ExamHCar[0] != -1);
        format(craft, sizeof(craft), "helicopter");
    }
    else
    {
        lx = EXAMP_LOC_X; ly = EXAMP_LOC_Y; lz = EXAMP_LOC_Z; rng = EXAMP_RANGE; price = g_ExamPPrice;
        ready = (g_ExamPCar[0] != -1);
        format(craft, sizeof(craft), "airplane");
    }

    if(!ready)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This exam is not available yet."), 1;
    if(!IsPlayerInRangeOfPoint(playerid, rng, lx, ly, lz))
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the exam location."), 1;
    if(g_FlightState[playerid] != FLIGHT_STATE_NONE)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already have a flight exam in progress."), 1;
    if(PlayerData[playerid][pMoney] < price)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money."), 1;

    PlayerData[playerid][pMoney] -= price;
    GivePlayerMoney(playerid, -price);
    UpdatePlayer(playerid, pMoney);

    new cut = price * FLIGHT_EXAM_BIZ_CUT / 100;
    new bidx = Businesses_FindByID(FLIGHT_EXAM_BIZ_ID);
    if(bidx != -1 && cut > 0 && !BusinessData[bidx][bANAF])
    {
        BusinessData[bidx][bBank] += cut;
        new q[128];
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `businesses` SET `bank`=%d WHERE `id`=%d", BusinessData[bidx][bBank], BusinessData[bidx][bID]);
        mysql_tquery(g_SQL, q, "", "", 0);
    }

    g_FlightState[playerid]      = FLIGHT_STATE_WAITING;
    g_FlightCat[playerid]        = cat;
    g_FlightCheckpoint[playerid] = 0;
    g_FlightVehicle[playerid]    = -1;
    FlightExam_KillTimer(playerid);
    g_FlightTimer[playerid] = SetTimerEx("FlightExam_Timeout", FLIGHT_STEP_TIME, false, "i", playerid);

    new m[144];
    format(m, sizeof(m), T(playerid, C_INFO"Info: "C_WHITE"Get into the exam "C_INFO"%s"C_WHITE" within "C_INFO"60 seconds"C_WHITE" to start the exam."), craft);
    SCM(playerid, COLOR_INFO, m);
    return 1;
}

public OnBusinessCreated(playerid, idx)
{
    if(!IsPlayerConnected(playerid)) return 0;
    BusinessData[idx][bID] = cache_insert_id();
    Businesses_RecreatePickup(idx);
    new msg[128];
    format(msg, sizeof(msg), T(playerid, C_SUCCESS"Success: "C_WHITE"Business created (ID: "C_INFO"%d"C_WHITE", Price: "C_INFO"$%s"C_WHITE")."),
        BusinessData[idx][bID], MoneyStr(BusinessData[idx][bPrice]));
    SCM(playerid, COLOR_SUCCESS, msg);
    return 1;
}

