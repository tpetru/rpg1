stock HUD_Destroy(playerid)
{
    for(new i = 0; i < 3; i++)
    {
        if(Text_HUD[playerid][i] != PlayerText:INVALID_TEXT_DRAW)
        {
            PlayerTextDrawDestroy(playerid, Text_HUD[playerid][i]);
            Text_HUD[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
        }
    }
    g_HUD_LastHP[playerid]    = -1;
    g_HUD_LastTired[playerid] = -1;
    g_HUD_LastSick[playerid]  = -1;
}

// Verifica HP/Tired/Sick si actualizeaza doar textdraw-urile a caror valoare s-a schimbat de la ultimul tick
stock HUD_Tick(playerid)
{
    new Float:hpFloat;
    GetPlayerHealth(playerid, hpFloat);
    new hp = floatround(hpFloat, floatround_floor);
    if(hp < 0) hp = 0;
    if(hp != g_HUD_LastHP[playerid])
    {
        g_HUD_LastHP[playerid] = hp;
        new hpText[16];
        format(hpText, sizeof(hpText), "H: %d", hp);
        PlayerTextDrawSetString(playerid, Text_HUD[playerid][0], hpText);
    }

    new tired = PlayerData[playerid][pTired];
    if(tired != g_HUD_LastTired[playerid])
    {
        g_HUD_LastTired[playerid] = tired;
        new tiredText[16];
        format(tiredText, sizeof(tiredText), "T: %d", tired);
        PlayerTextDrawSetString(playerid, Text_HUD[playerid][1], tiredText);
    }

    new sick = PlayerData[playerid][pDiseased] ? 1 : 0;
    if(sick != g_HUD_LastSick[playerid])
    {
        g_HUD_LastSick[playerid] = sick;
        PlayerTextDrawSetString(playerid, Text_HUD[playerid][2], sick ? "S: YES" : "S: NO");
    }
}

// Forteaza un refresh imediat si afiseaza cele 3 textdraw-uri (apelat dupa spawn, la login/register)
stock HUD_Show(playerid)
{
    g_HUD_LastHP[playerid]    = -1;
    g_HUD_LastTired[playerid] = -1;
    g_HUD_LastSick[playerid]  = -1;
    HUD_Tick(playerid);
    PlayerTextDrawShow(playerid, Text_HUD[playerid][0]);
    PlayerTextDrawShow(playerid, Text_HUD[playerid][1]);
    PlayerTextDrawShow(playerid, Text_HUD[playerid][2]);
}

public Speedometer_Tick()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;

        HUD_Tick(i);

        new vehid = GetPlayerVehicleID(i);
        if(vehid == 0)
        {
            if(g_SpeedometerShown[i])
            {
                PlayerTextDrawHide(i, Speedometer_Text[i][0]);
                PlayerTextDrawHide(i, Speedometer_Text[i][1]);
                PlayerTextDrawHide(i, Speedometer_Text[i][2]);
                PlayerTextDrawHide(i, Speedometer_Text[i][3]);
                PlayerTextDrawHide(i, Speedometer_Text[i][4]);
                PlayerTextDrawHide(i, Speedometer_Text[i][5]);
                PlayerTextDrawHide(i, Speedometer_Text[i][6]);
                g_SpeedometerShown[i] = false;
                g_SpeedometerLockShown[i] = false;
                g_SpeedometerDirtyShown[i] = false;
                g_SpeedometerKmShown[i] = false;
            }
            continue;
        }

        new Float:speed = GetPlayerVehicleSpeed(i);
        new Float:health;
        GetVehicleHealth(vehid, health);
        if(health > 1000.0) health = 1000.0;

        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);

        new bool:isPersonal = (g_VehicleToPVIndex[vehid] != -1);

        // --- Vehicul confiscat de DMV: motorul ramane oprit ---
        if(isPersonal && engine && PVehicleData[g_VehicleToPVIndex[vehid]][pvIsConfiscated])
        {
            SetVehicleParamsEx(vehid, 0, lights, alarm, doors, bonnet, boot, objective);
            engine = 0;
        }

        // --- Vehicul prea murdar (dirty > 90): motorul ramane oprit ---
        if(isPersonal && engine && PVehicleData[g_VehicleToPVIndex[vehid]][pvDirty] > VEHICLE_DIRTY_LOCK)
        {
            SetVehicleParamsEx(vehid, 0, lights, alarm, doors, bonnet, boot, objective);
            engine = 0;
        }

        // --- Consum motorina: doar soferul, doar cat masina chiar se misca (stationar cu motorul pornit = 0 consum) ---
        if(engine && GetPlayerState(i) == PLAYER_STATE_DRIVER && speed > 0.0)
        {
            new Float:drain = FUEL_MOVE_DRAIN * speed;
            g_VehicleFuel[vehid] -= drain;

            if(g_VehicleFuel[vehid] <= 0.0)
            {
                g_VehicleFuel[vehid] = 0.0;
                // ramas fara motorina -> opreste motorul
                SetVehicleParamsEx(vehid, 0, lights, alarm, doors, bonnet, boot, objective);
                engine = 0;
                Vehicle_SaveFuel(vehid);
                SCM(i, COLOR_ERROR, C_ERROR"[Fuel] "C_WHITE"You ran out of fuel. Refuel at a gas station ("C_INFO"/refuel"C_WHITE").");
            }
        }

        // --- KM parcursi: doar soferul (evita numaratul de N ori cu N pasageri), personale sau de factiune ---
        if(GetPlayerState(i) == PLAYER_STATE_DRIVER)
        {
            if(isPersonal)
                PVehicleData[g_VehicleToPVIndex[vehid]][pvKm] += speed / 18000.0; // km la fiecare tick de 200ms
            else
            {
                new vfKmIdx = VFaction_FindByVehicle(vehid);
                if(vfKmIdx != -1) VFactionData[vfKmIdx][vfKm] += speed / 18000.0;
            }
        }

        new text[16];
        format(text, sizeof(text), "%d km/h", floatround(speed));
        PlayerTextDrawSetString(i, Speedometer_Text[i][0], text);

        format(text, sizeof(text), "Fuel: %d%%", floatround(g_VehicleFuel[vehid]));
        PlayerTextDrawSetString(i, Speedometer_Text[i][1], text);

        format(text, sizeof(text), "%d hp", floatround(health));
        PlayerTextDrawSetString(i, Speedometer_Text[i][2], text);

        PlayerTextDrawSetString(i, Speedometer_Text[i][3], engine ? "engine ON" : "engine OFF");

        if(isPersonal)
        {
            PlayerTextDrawSetString(i, Speedometer_Text[i][4], doors ? "locked" : "unlocked");
            if(!g_SpeedometerLockShown[i])
            {
                PlayerTextDrawShow(i, Speedometer_Text[i][4]);
                g_SpeedometerLockShown[i] = true;
            }

            format(text, sizeof(text), "Dirty: %d%%", PVehicleData[g_VehicleToPVIndex[vehid]][pvDirty]);
            PlayerTextDrawSetString(i, Speedometer_Text[i][5], text);
            if(!g_SpeedometerDirtyShown[i])
            {
                PlayerTextDrawShow(i, Speedometer_Text[i][5]);
                g_SpeedometerDirtyShown[i] = true;
            }
        }
        else
        {
            if(g_SpeedometerLockShown[i])
            {
                PlayerTextDrawHide(i, Speedometer_Text[i][4]);
                g_SpeedometerLockShown[i] = false;
            }
            if(g_SpeedometerDirtyShown[i])
            {
                PlayerTextDrawHide(i, Speedometer_Text[i][5]);
                g_SpeedometerDirtyShown[i] = false;
            }
        }

        // --- Km: la vehicule personale SI de factiune ---
        new vfKmDispIdx = isPersonal ? -1 : VFaction_FindByVehicle(vehid);
        if(isPersonal || vfKmDispIdx != -1)
        {
            format(text, sizeof(text), "Km: %.1f", isPersonal ? PVehicleData[g_VehicleToPVIndex[vehid]][pvKm] : VFactionData[vfKmDispIdx][vfKm]);
            PlayerTextDrawSetString(i, Speedometer_Text[i][6], text);
            if(!g_SpeedometerKmShown[i])
            {
                PlayerTextDrawShow(i, Speedometer_Text[i][6]);
                g_SpeedometerKmShown[i] = true;
            }
        }
        else if(g_SpeedometerKmShown[i])
        {
            PlayerTextDrawHide(i, Speedometer_Text[i][6]);
            g_SpeedometerKmShown[i] = false;
        }

        if(!g_SpeedometerShown[i])
        {
            PlayerTextDrawShow(i, Speedometer_Text[i][0]);
            PlayerTextDrawShow(i, Speedometer_Text[i][1]);
            PlayerTextDrawShow(i, Speedometer_Text[i][2]);
            PlayerTextDrawShow(i, Speedometer_Text[i][3]);
            g_SpeedometerShown[i] = true;
        }
    }
    return 1;
}

// Returneaza indexul (in VFactionData) al vehiculului de factiune cu acest vehicleid, sau -1
stock VFaction_FindByVehicle(vehicleid)
{
    if(vehicleid <= 0) return -1;
    for(new i = 0; i < g_VFactionCount; i++)
        if(g_VFactionVehicle[i] == vehicleid) return i;
    return -1;
}

// Salveaza motorina in DB daca vehiculul e din DB (personal sau factiune); altfel nu face nimic
stock Vehicle_SaveFuel(vehicleid)
{
    if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES) return;

    new pvidx = g_VehicleToPVIndex[vehicleid];
    if(pvidx != -1)
    {
        PVehicleData[pvidx][pvFuel] = g_VehicleFuel[vehicleid];
        new q[96];
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `fuel`=%.2f WHERE `id`=%d",
            g_VehicleFuel[vehicleid], PVehicleData[pvidx][pvID]);
        mysql_tquery(g_SQL, q, "", "", 0);
        return;
    }

    new vfidx = VFaction_FindByVehicle(vehicleid);
    if(vfidx != -1)
    {
        VFactionData[vfidx][vfFuel] = g_VehicleFuel[vehicleid];
        new q[96];
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_faction` SET `fuel`=%.2f WHERE `id`=%d",
            g_VehicleFuel[vehicleid], VFactionData[vfidx][vfID]);
        mysql_tquery(g_SQL, q, "", "", 0);
    }
}

// Salveaza jantele puse prin /tune pe un vehicul de factiune, cu data de expirare
stock VFaction_SaveWheels(vfidx, wheels)
{
    VFactionData[vfidx][vfWheels]    = wheels;
    VFactionData[vfidx][vfWheelsExp] = Wheels_ExpiryFromNow(WHEELS_DAYS_FACTION);

    new dateStr[11];
    UnixToDateStr(VFactionData[vfidx][vfWheelsExp], dateStr, sizeof(dateStr));

    new q[160];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_faction` SET `wheels`=%d, `wheels_exp`='%s' WHERE `id`=%d",
        wheels, dateStr, VFactionData[vfidx][vfID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Reseteaza jantele unui vehicul de factiune la valoarea default (0, fara janta custom)
stock VFaction_ClearWheels(vfidx)
{
    VFactionData[vfidx][vfWheels]    = 0;
    VFactionData[vfidx][vfWheelsExp] = 0;

    new q[128];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_faction` SET `wheels`=0, `wheels_exp`=NULL WHERE `id`=%d",
        VFactionData[vfidx][vfID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// ---- Persistarea jantelor puse/scoase prin /tune ----
// Un singur punct de intrare pentru toate cele 3 cai din /tune (montare, scoatere, "Remove All
// Mods"), ca sa nu ramana vreuna nesalvata. Fara asta, jantele revin la urmatorul respawn,
// pentru ca OnVehicleSpawn le reaplica din DB.
stock Tuning_SaveWheels(vehicleid, component)
{
    if(vehicleid > 0 && vehicleid < MAX_VEHICLES)
    {
        new pvidx = g_VehicleToPVIndex[vehicleid];
        if(pvidx != -1) { PVehicle_SaveWheels(pvidx, component); return; }
    }

    new vfidx = VFaction_FindByVehicle(vehicleid);
    if(vfidx != -1) VFaction_SaveWheels(vfidx, component);
}

stock Tuning_ClearWheels(vehicleid)
{
    if(vehicleid > 0 && vehicleid < MAX_VEHICLES)
    {
        new pvidx = g_VehicleToPVIndex[vehicleid];
        if(pvidx != -1) { PVehicle_ClearWheels(pvidx); return; }
    }

    new vfidx = VFaction_FindByVehicle(vehicleid);
    if(vfidx != -1) VFaction_ClearWheels(vfidx);
}

// La ora 5:00 (PayDay_Check): reseteaza in DB jantele expirate (wheels_exp < azi), apoi distruge
// La ora 5:00 (PayDay_Check): reseteaza (in memorie + DB) jantele expirate (wheels_exp < azi) la
// valoarea default. NU atinge vehiculele fizice - jantele se aplica/scot abia cand vehiculul chiar
// respawneaza (vezi OnVehicleSpawn, care citeste live VFactionData[..][vfWheels]/[vfWheelsExp]).
stock VFaction_DailyRefresh()
{
    for(new v = 0; v < g_VFactionCount; v++)
    {
        if(VFactionData[v][vfWheels] == 0) continue;
        if(VehicleDoc_IsValid(VFactionData[v][vfWheelsExp])) continue; // inca valabile

        VFaction_ClearWheels(v);
    }

    // acelasi lucru pentru vehiculele personale (jantele lor expira in WHEELS_DAYS_PERSONAL zile)
    for(new v = 0; v < g_PVehicleCount; v++)
    {
        if(PVehicleData[v][pvWheels] == 0) continue;
        if(VehicleDoc_IsValid(PVehicleData[v][pvWheelsExp])) continue;

        PVehicle_ClearWheels(v);
    }
}

// Benzinarii sunt acum din baza de date (tabelul fuelStations)

stock bool:Fuel_PlayerAtStation(playerid)
{
    for(new i = 0; i < g_FuelStationCount; i++)
        if(IsPlayerInRangeOfPoint(playerid, FUEL_STATION_RANGE, FuelStationData[i][fsX], FuelStationData[i][fsY], FuelStationData[i][fsZ]))
            return true;
    return false;
}

// Returneaza indexul (in FuelStationData) al benzinariei in raza playerului, sau -1
stock Fuel_FindStation(playerid)
{
    for(new i = 0; i < g_FuelStationCount; i++)
        if(IsPlayerInRangeOfPoint(playerid, FUEL_STATION_RANGE, FuelStationData[i][fsX], FuelStationData[i][fsY], FuelStationData[i][fsZ]))
            return i;
    return -1;
}

// Scade fuelLevel_curr cu litrii folositi (fara sa coboare sub 0) si salveaza in DB
stock FuelStation_ConsumeFuel(idx, liters)
{
    if(idx == -1) return;

    FuelStationData[idx][fsLevelCurr] -= liters;
    if(FuelStationData[idx][fsLevelCurr] < 0) FuelStationData[idx][fsLevelCurr] = 0;

    new q[96];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `fuelStations` SET `fuelLevel_curr`=%d WHERE `id`=%d",
        FuelStationData[idx][fsLevelCurr], FuelStationData[idx][fsID]);
    mysql_tquery(g_SQL, q, "", "", 0);

    FuelStation_Create(idx); // reafiseaza eticheta cu noul nivel
}

// ============================================================
//  CEAS SERVER (ora curenta, afisata global)
// ============================================================
#define SERVER_CLOCK_TICK 1000 // 1 secunda, in ms

new Text:ServerClock_Text[2];

forward ServerClock_Tick();

// Creeaza cele 2 textdraw-uri globale (iconita + ora), o singura data la pornirea gamemode-ului
stock ServerClock_Create()
{
    ServerClock_Text[0] = TextDrawCreate(547.000, 25.000, "LD_GRAV:timer");
    TextDrawTextSize(ServerClock_Text[0], 15.000, 16.000);
    TextDrawAlignment(ServerClock_Text[0], 1);
    TextDrawColor(ServerClock_Text[0], -1);
    TextDrawSetShadow(ServerClock_Text[0], 0);
    TextDrawSetOutline(ServerClock_Text[0], 0);
    TextDrawBackgroundColor(ServerClock_Text[0], 255);
    TextDrawFont(ServerClock_Text[0], 4);
    TextDrawSetProportional(ServerClock_Text[0], 1);

    ServerClock_Text[1] = TextDrawCreate(577.000, 26.000, "23:59");
    TextDrawLetterSize(ServerClock_Text[1], 0.300, 1.500);
    TextDrawTextSize(ServerClock_Text[1], 7.000, 59.000);
    TextDrawAlignment(ServerClock_Text[1], 2);
    TextDrawColor(ServerClock_Text[1], 255);
    TextDrawUseBox(ServerClock_Text[1], 1);
    TextDrawBoxColor(ServerClock_Text[1], 1886483268);
    TextDrawSetShadow(ServerClock_Text[1], 0);
    TextDrawSetOutline(ServerClock_Text[1], 0);
    TextDrawBackgroundColor(ServerClock_Text[1], 255);
    TextDrawFont(ServerClock_Text[1], 1);
    TextDrawSetProportional(ServerClock_Text[1], 1);
}

// Arata ceasul unui singur player (folosit la conectare, pentru ca TextDrawShowForAll
// nu acopera playerii care se conecteaza dupa apel)
stock ServerClock_ShowToPlayer(playerid)
{
    TextDrawShowForPlayer(playerid, ServerClock_Text[0]);
    TextDrawShowForPlayer(playerid, ServerClock_Text[1]);
}

// Actualizeaza textul ceasului la fiecare secunda; jucatorii care il vad deja primesc update-ul live
public ServerClock_Tick()
{
    new hour, minute, second;
    gettime(hour, minute, second);

    new text[8];
    format(text, sizeof(text), "%02d:%02d", hour, minute);
    TextDrawSetString(ServerClock_Text[1], text);
    return 1;
}

