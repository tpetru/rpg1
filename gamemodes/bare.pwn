//  DATE JUCATOR
// ============================================================
enum E_PLAYER_DATA
{
    pID, pName[24], pPass[64], pEmail[64],
    pLevel, pMoney, pBank, pRP, pAdminLevel, pFaction, pFactionRank, pFactionJoin, pHouse, pHotel, pBusiness,
    pRentHouse, // ID casei/apartamentului inchiriat cu /renthouse sau /rentappartment (0 = nu inchiriaza)
    pRentHotel, // ID hotelului inchiriat cu /renthotel (0 = nu inchiriaza)
    pSpawn, Float:pSpawnX, Float:pSpawnY, Float:pSpawnZ, Float:pSpawnA, // pSpawnA: unghiul de fata, recalculat odata cu restul in Player_RecalcSpawn (0.0 = necunoscut/fara date)
    pKey1, pKey2, pKey3,
    pDrivingLicA_exp[11], pDrivingLicB_exp[11], pDrivingLicC_exp[11], pDrivingLicD_exp[11],
    pAirLicA_exp[11], pAirLicH_exp[11], // permis avion: A = avioane, H = elicoptere
    pWeaponLicW_exp[11], // permis arme (W), castigat la /examW
    bool:pLogged, bool:pRegistered, bool:pOnDuty,
    bool:pDiseased, pDiseasePaydays,
    pCaravanKey,
    pFarmKey, // id-ul fermei detinute (0 = niciuna)
    pForestKey, // id-ul padurii detinute (0 = niciuna); coloana `forest_key`, resincronizata la login din forests.ownerId
    pBBKey, // id-ul billboard-ului detinut (0 = niciunul); coloana `bb_key`, resincronizata la login din billboards.bbOwnerId
    bool:pIsPresident, bool:pVoted, bool:pWasPresident,
    pGovRole, // functie in guvern numita de presedinte: GOV_NONE / GOV_PM (Prim-ministru) / GOV_VPM (Vice-premier)
    pJob,
    pPhoneModel, pPhoneNumber, // telefon: index marca (0-4, -1 = fara telefon), numar (7 cifre, 0 = fara SIM)
    pMedkits, pExtinguishers,  // inventar: medical kit-uri / extinctoare cumparate din /shop, neaplicate inca
    bool:pFishingRod,          // detine o undita, cumparata din /shop (Tools Shop)
    bool:pHasGPS,              // detine un GPS, cumparat din /shop (Electronics Shop); necesar pentru /gps
    bool:pPhoneBook,           // detine un Phone Book, cumparat din /shop (24/7 Shop); necesar pentru /number
    pMuteExpire,               // timestamp unix pana cand jucatorul e mutat (0 = nu e mutat)
    pWanted,                   // nivel wanted (0-6), setat de politie; persistat in DB
    pJailSeconds,              // secunde ramase de stat in inchisoare; persistat in DB
    pRobPoints,                // puncte de jaf (0-10); +1 la payday, -10 la /rob; persistat in DB
    pSkin,                     // skin-ul (haina) curent al jucatorului; persistat in DB
    pGasCan,                   // canistra: -1 = nu are, 0 = are goala, 1 = are plina; persistat in DB
    pWatchModel,               // ceas: index marca (0-3, -1 = fara ceas); persistat in DB
    pPhoneExpire,              // timestamp unix cand se strica telefonul (0 = fara telefon / nesetat); persistat in DB
    pWatchExpire,              // timestamp unix cand se strica ceasul (0 = fara ceas / nesetat); persistat in DB
    pTired,                    // nivel de oboseala (0-100); +2/minut, resetat la 0 cu /sleep; persistat in DB
    pWarns,                    // numar de warn-uri primite de la admini (0-MAX_WARNS); persistat in DB
    bool:pVIP,                 // cont VIP (0/1), setat de admin cu /setvip; persistat in DB
    pGambleWagered,            // total pariat la cazino (slots/roulette/dice) in ciclul curent; plafon CASINO_WAGER_LIMIT_PER_LEVEL * pLevel; resetat la 0 la fiecare payday; persistat in DB
    pCoffee,                   // cate cafele a baut azi, 0-COFFEE_MAX_PER_DAY (vezi /drink categoria coffee si /getcoffee); persistat in DB (coloana `coffee`), resetat la 0 in fiecare zi la payday-ul de ora 5:00
    pLastPray,                 // timestamp unix (miezul noptii) al ultimei zile in care a folosit /pray (0 = niciodata); persistat in DB, coloana `lastPrayDate` (DATE)
    pReligion,                 // religia aleasa cu /setreligion: 0=Ateu, 1=The Ascendants, 2=The Holy Order, 3=The Divine Blessing; persistat in DB
    pLanguage[3]               // limba aleasa cu /en sau /ro ("en"/"ro"); persistat in DB
}

// ---- Canistra de benzina (gas can) ----
#define GASCAN_NONE      -1     // nu are canistra
#define GASCAN_EMPTY      0     // are canistra, goala
#define GASCAN_FULL       1     // are canistra, plina
#define GASCAN_LITERS     20    // capacitatea canistrei (L) pentru un player normal = +20 la rezervor (rezervorul e 0-100)
#define GASCAN_LITERS_VIP 50    // capacitatea canistrei (L) pentru un VIP
new PlayerData[MAX_PLAYERS][E_PLAYER_DATA];
new g_PlayerIP[MAX_PLAYERS][46]; // IP-ul retinut la conectare (folosit si la deconectare, pentru tabela `ips`)

// ---- /viphat: palarii atasabile pe cap, doar pentru VIP ----
#define VIPHAT_BLACK          18947
#define VIPHAT_RED            18944
#define VIPHAT_GREEN          18949
#define VIPHAT_FARMER         18951
#define VIPHAT_WITCH          19528
#define VIPHAT_ATTACH_INDEX   2  // diferit de BBALL_ATTACH_INDEX (0) si PARTY_ATTACH_INDEX (1)
#define VIPHAT_ATTACH_BONE    2  // 2 = Head (bone SA-MP)
new bool:g_VipHatOn[MAX_PLAYERS];
new g_VipHatModel[MAX_PLAYERS]; // modelul curent (pentru refresh la ajustarea offsetului), 0 = niciunul

// Offset-uri reglabile in-game (admin) cu /hatup /hatdown /hatleft /hatright, aplicate tuturor playerilor cu palarie
new Float:g_VipHatOffX = 0.16;
new Float:g_VipHatOffY = 0.0;
new Float:g_VipHatOffZ = 0.0;

// Reataseaza palaria (cu offset-urile curente) tuturor playerilor care o poarta acum
stock VipHat_RefreshAll()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && g_VipHatOn[i])
        {
            SetPlayerAttachedObject(i, VIPHAT_ATTACH_INDEX, g_VipHatModel[i], VIPHAT_ATTACH_BONE,
                g_VipHatOffX, g_VipHatOffY, g_VipHatOffZ, 0.0, 0.0, 0.0, 1.0, 1.0, 1.0);
        }
    }
}

// Capacitatea canistrei (in litri) pentru acest player: VIP = 50L, normal = 20L
stock GasCan_Liters(playerid)
{
    return PlayerData[playerid][pVIP] ? GASCAN_LITERS_VIP : GASCAN_LITERS;
}

// ============================================================
//  CASINO (Four Dragons, LV) - slots / roulette / dice
// ============================================================
// Banii pierduti DISPAR din economie (money sink); castigurile vin de la server.
#define CASINO_INTERIOR    10      // interiorul casino-ului
#define CASINO_VW          0
#define CASINO_MIN_BET     100
#define CASINO_MAX_BET     50000
#define CASINO_WAGER_LIMIT_PER_LEVEL 200000 // plafon total pariat per ciclu = acest numar * nivelul jucatorului; resetat la 0 la fiecare payday
// intrarea (exterior; exista si ca locID 30 in locations_admin)
#define CASINO_ENT_X       1022.5669
#define CASINO_ENT_Y       -1122.4207
#define CASINO_ENT_Z       23.8713
// interiorul (punctul de spawn la intrare / iesire)
#define CASINO_INT_X       2016.11
#define CASINO_INT_Y       1017.15
#define CASINO_INT_Z       996.87
#define CASINO_MAPICON_ID  44      // iconita de casino (zaruri)
#define CASINO_PICKUP_MODEL 1550   // pickup la intrare

// Raza de acces pentru fiecare joc (trebuie sa fii la locatia corecta din interior)
#define CASINO_SLOTS_RANGE    3.0
#define CASINO_ROULETTE_RANGE 5.0
#define CASINO_DICE_RANGE     15.0

// Locatiile aparatelor de /slots (interior 10)
new const Float:g_CasinoSlots[6][3] = {
    {1956.8998, 1047.3474, 992.4688},
    {1961.3009, 1042.9175, 992.4688},
    {1963.8322, 1037.0562, 992.4688},
    {1963.8634, 998.7031,  992.4688},
    {1961.3883, 992.6876,  992.4688},
    {1956.7804, 988.1338,  992.4688}
};
// Mesele de /roulette
new const Float:g_CasinoRoulette[2][3] = {
    {1961.6381, 1025.7039, 992.4688},
    {1961.3600, 1010.1753, 992.4688}
};
// Zona de /dice
new const Float:g_CasinoDice[3] = {1992.3740, 1017.3907, 994.8906};

// True daca jucatorul e in interiorul casino-ului
stock bool:Casino_IsInside(playerid)
{
    return (GetPlayerInterior(playerid) == CASINO_INTERIOR &&
            GetPlayerVirtualWorld(playerid) == CASINO_VW &&
            IsPlayerInRangeOfPoint(playerid, 150.0, CASINO_INT_X, CASINO_INT_Y, CASINO_INT_Z));
}

// True daca e langa un aparat de slots / o masa de ruleta / zona de zaruri
stock bool:Casino_AtSlots(playerid)
{
    for(new i = 0; i < sizeof(g_CasinoSlots); i++)
        if(IsPlayerInRangeOfPoint(playerid, CASINO_SLOTS_RANGE, g_CasinoSlots[i][0], g_CasinoSlots[i][1], g_CasinoSlots[i][2]))
            return true;
    return false;
}
stock bool:Casino_AtRoulette(playerid)
{
    for(new i = 0; i < sizeof(g_CasinoRoulette); i++)
        if(IsPlayerInRangeOfPoint(playerid, CASINO_ROULETTE_RANGE, g_CasinoRoulette[i][0], g_CasinoRoulette[i][1], g_CasinoRoulette[i][2]))
            return true;
    return false;
}
stock bool:Casino_AtDice(playerid)
{
    return IsPlayerInRangeOfPoint(playerid, CASINO_DICE_RANGE, g_CasinoDice[0], g_CasinoDice[1], g_CasinoDice[2]) ? true : false;
}

// Intra / iesi din casino (folosit de /leavecasino si tasta ENTER)
stock Casino_Enter(playerid)
{
    if(GetPlayerVehicleID(playerid) != 0)
        return SCM(playerid, COLOR_ERROR, C_ERROR"[Casino] "C_WHITE"You can't enter with a vehicle."), 1;
    AC_SetInterior(playerid, CASINO_INTERIOR);
    AC_SetVW(playerid, CASINO_VW);
    AC_SetPos(playerid, CASINO_INT_X, CASINO_INT_Y, CASINO_INT_Z);
    SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Casino] "C_WHITE"Welcome! Games: "C_INFO"/slots"C_WHITE", "C_INFO"/roulette"C_WHITE", "C_INFO"/dice"C_WHITE" - each at its table.");
    return 1;
}
stock Casino_Exit(playerid)
{
    AC_SetInterior(playerid, 0);
    AC_SetVW(playerid, 0);
    AC_SetPos(playerid, CASINO_ENT_X, CASINO_ENT_Y + 1.5, CASINO_ENT_Z);
    SCM(playerid, COLOR_INFO, C_INFO"[Casino] "C_WHITE"Come back soon!");
    return 1;
}

// Tasta ENTER: intra (langa usa, afara) / iesi (langa punctul de iesire, inauntru)
stock Casino_Toggle(playerid)
{
    if(GetPlayerInterior(playerid) == 0 &&
       IsPlayerInRangeOfPoint(playerid, 3.0, CASINO_ENT_X, CASINO_ENT_Y, CASINO_ENT_Z))
        return Casino_Enter(playerid);

    if(Casino_IsInside(playerid) &&
       IsPlayerInRangeOfPoint(playerid, 3.0, CASINO_INT_X, CASINO_INT_Y, CASINO_INT_Z))
        return Casino_Exit(playerid);
    return 0;
}

// Valideaza pariul comun tuturor jocurilor: locatie, suma, bani. Returneaza suma sau -1 (mesajul e deja trimis).
stock Casino_ParseBet(playerid, const amtStr[], const usage[])
{
    if(!PlayerData[playerid][pLogged])
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), -1;
    if(!Casino_IsInside(playerid))
        return SCM(playerid, COLOR_ERROR, C_ERROR"[Casino] "C_WHITE"You must be inside the casino. Enter it with "C_INFO"ENTER"C_WHITE" at the Four Dragons entrance."), -1;
    if(!strlen(amtStr))
        return SCM(playerid, COLOR_INFO, usage), -1;

    new bet = strval(amtStr);
    if(bet < CASINO_MIN_BET || bet > CASINO_MAX_BET)
    {
        new bm[128];
        format(bm, sizeof(bm), T(playerid, C_ERROR"[Casino] "C_WHITE"Bet must be between "C_INFO"$%s"C_WHITE" and "C_INFO"$%s"C_WHITE"."), MoneyStr(CASINO_MIN_BET), MoneyStr(CASINO_MAX_BET));
        return SCM(playerid, COLOR_ERROR, bm), -1;
    }
    if(PlayerData[playerid][pMoney] < bet)
        return SCM(playerid, COLOR_ERROR, C_ERROR"[Casino] "C_WHITE"You don't have that much money."), -1;

    new wagerLimit = CASINO_WAGER_LIMIT_PER_LEVEL * PlayerData[playerid][pLevel];
    if(PlayerData[playerid][pGambleWagered] + bet > wagerLimit)
    {
        new left = wagerLimit - PlayerData[playerid][pGambleWagered];
        if(left < 0) left = 0;
        new lm[160];
        format(lm, sizeof(lm), T(playerid, "[Casino] You've hit your gambling limit for this cycle ($%s left of $%s). It resets at the next PayDay."),
            MoneyStr(left), MoneyStr(wagerLimit));
        return SCM(playerid, COLOR_ERROR, lm), -1;
    }

    Pray_FlagSin(playerid, 3); // Viciul jocurilor de noroc
    return bet;
}

// True daca stringul contine doar cifre (pentru pariul pe numar exact la ruleta)
stock bool:IsNumeric(const str[])
{
    if(!strlen(str)) return false;
    for(new i = 0; str[i] != EOS; i++)
        if(str[i] < '0' || str[i] > '9') return false;
    return true;
}

// Numerele rosii de la ruleta (standard)
new const g_RouletteRed[18] = {1,3,5,7,9,12,14,16,18,19,21,23,25,27,30,32,34,36};
stock bool:Roulette_IsRed(n)
{
    for(new i = 0; i < 18; i++)
        if(g_RouletteRed[i] == n) return true;
    return false;
}

// Numele simbolurilor de la slots
new const g_SlotSymbol[5][8] = { "Cherry", "Lemon", "Bell", "Star", "Seven" };

// Creeaza intrarea/iesirea casino-ului + etichetele meselor de joc. Apelat din OnGameModeInit.
stock Casino_Create()
{
    // intrare (exterior; locatia exista si ca locID 30 in locations_admin)
    CreatePickup(CASINO_PICKUP_MODEL, 1, CASINO_ENT_X, CASINO_ENT_Y, CASINO_ENT_Z, -1);
    Create3DTextLabel("[ Casino ]\n[ Press ENTER ]", COLOR_WHITE,
        CASINO_ENT_X, CASINO_ENT_Y, CASINO_ENT_Z - 0.5, 25.0, 0, 0);

    // iesire (interior)
    CreatePickup(CASINO_PICKUP_MODEL, 1, CASINO_INT_X, CASINO_INT_Y, CASINO_INT_Z, -1);
    Create3DTextLabel("[ Casino ]\n[ Press ENTER or type /leavecasino ]", COLOR_WHITE,
        CASINO_INT_X, CASINO_INT_Y, CASINO_INT_Z - 0.5, 25.0, 0, 0);

    // etichete la mesele de joc (interior 0 = orice; vizibilitate: slots 7m, ruleta 13m, zaruri 15m)
    for(new i = 0; i < sizeof(g_CasinoSlots); i++)
        Create3DTextLabel("[ Casino ]\n[ Type /slots ]", COLOR_WHITE,
            g_CasinoSlots[i][0], g_CasinoSlots[i][1], g_CasinoSlots[i][2], 7.0, 0, 0);
    for(new i = 0; i < sizeof(g_CasinoRoulette); i++)
        Create3DTextLabel("[ Casino ]\n[ Type /roulette ]", COLOR_WHITE,
            g_CasinoRoulette[i][0], g_CasinoRoulette[i][1], g_CasinoRoulette[i][2], 13.0, 0, 0);
    Create3DTextLabel("[ Casino ]\n[ Type /dice ]", COLOR_WHITE,
        g_CasinoDice[0], g_CasinoDice[1], g_CasinoDice[2], 15.0, 0, 0);
}

