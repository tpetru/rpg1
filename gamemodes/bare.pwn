    new query[256];
    switch(field)
    {
        case pPass:
            mysql_format(g_SQL, query, sizeof(query),
                "UPDATE `players` SET `password`='%e' WHERE `id`=%d",
                PlayerData[playerid][pPass], PlayerData[playerid][pID]);

        case pLevel:
            mysql_format(g_SQL, query, sizeof(query),
                "UPDATE `players` SET `level`=%d WHERE `id`=%d",
