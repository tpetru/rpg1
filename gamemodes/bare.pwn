#define CS_TEAM_B            1       // a inceput ca CT

#define CS_WEAPON_T          WEAPON_AK47
#define CS_WEAPON_CT         WEAPON_M4
#define CS_WEAPON_AMMO       250
#define CS_PISTOL            WEAPON_DEAGLE
#define CS_PISTOL_AMMO       70

