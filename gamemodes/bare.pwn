new g_GPSDynCat[MAX_PLAYERS][32];           // pentru categoriile dinamice: numele locCategory selectat
new bool:g_GPSListAdminMode[MAX_PLAYERS];   // true cat timp categoria/locatia GPS e aleasa din /gpslist (admin) - teleport in loc de checkpoint
new bool:g_TaxiMode[MAX_PLAYERS];           // true cat timp categoria/locatia GPS e aleasa din /taxi - teleport (cu plata) in loc de checkpoint
new g_Anim2Lib[MAX_PLAYERS][32];            // libraria aleasa in /anim2 (pas 1), folosita cand se alege animatia (pas 2)
#define GPS_MAX_DYNCATS 16

// Lista GPS construita per-player la deschiderea unei categorii, sortata crescator dupa distanta.
// Stocam doar (tip, index) ca referinta in sursa, ca sa nu copiem nume/coordonate.
#define MAX_GPS_LISTITEMS 200
#define GPSITEM_FACTION  1
#define GPSITEM_BIZ      2
#define GPSITEM_ATM      3
#define GPSITEM_JOB      4
#define GPSITEM_SHOP     5
#define GPSITEM_FASTFOOD 6
#define GPSITEM_LOC      7
#define GPSITEM_FARM     8
#define GPSITEM_HOUSE    9
#define GPSITEM_HOTEL    10
#define GPSITEM_CLOTHSTORE 11
#define GPSITEM_FOREST   12
#define GPSITEM_GASSTATION 13
#define GPSITEM_BAR      14
new g_GPSItemType[MAX_PLAYERS][MAX_GPS_LISTITEMS];
new g_GPSItemRef[MAX_PLAYERS][MAX_GPS_LISTITEMS];
new Float:g_GPSItemDist[MAX_PLAYERS][MAX_GPS_LISTITEMS];
new g_GPSListCount[MAX_PLAYERS];

// ============================================================
//  EXAMENE DE ZBOR (P = avion -> Airplane A; H = elicopter -> Airplane H)
// ============================================================
#define FLIGHT_EXAM_BIZ_ID     6
#define FLIGHT_EXAM_BIZ_CUT    30      // % din pret catre business
#define FLIGHT_PASS_DURATION_P 1296000 // 15 zile (avion), in secunde
#define FLIGHT_PASS_DURATION_H 1382400 // 16 zile (elicopter), in secunde
#define FLIGHT_FAIL_DURATION   172800  // 2 zile, in secunde (permis scurt daca aeronava e avariata)
#define FLIGHT_PASS_HEALTH     800.0
#define FLIGHT_CP_SIZE         8.0
#define FLIGHT_STEP_TIME       60000   // 60 secunde per checkpoint

#define FLIGHT_STATE_NONE      0
#define FLIGHT_STATE_WAITING   1
#define FLIGHT_STATE_FLYING    2
#define FLIGHT_CAT_P           0       // avion  -> pAirLicA_exp
#define FLIGHT_CAT_H           1       // elicopter -> pAirLicH_exp

// examP (avion) - vehicul + checkpoint-uri se completeaza mai tarziu (momentan 0.0)
#define EXAMP_RANGE            5.0
new Float:EXAMP_LOC_X = 0.0;   // suprascris din locations_admin (id 5, "examP")
new Float:EXAMP_LOC_Y = 0.0;
new Float:EXAMP_LOC_Z = 0.0;
#define MAX_EXAMP_CARS         1
#define MAX_EXAMP_CHECKPOINTS  8
new g_ExamPCar[MAX_EXAMP_CARS] = {-1};
new Float:ExamPCheckpoints[MAX_EXAMP_CHECKPOINTS][3] = {
    {1444.3706, -2494.1445, 14.2678}, // cp1
    {1741.9435, -2496.1680, 32.6662}, // cp2
    {2003.4653, -2494.2500, 14.2505}, // cp3
    {2109.0967, -2543.3591, 14.2476}, // cp4
    {2050.7490, -2593.1965, 14.2580}, // cp5
    {1853.6288, -2590.7241, 30.0579}, // cp6
    {1486.2864, -2593.2788, 14.2542}, // cp7
    {1496.8160, -2412.1025, 14.2594}  // cp8 (aterizare, langa vehicul)
};

// examH (elicopter)
#define EXAMH_RANGE            5.0
new Float:EXAMH_LOC_X = 0.0;   // suprascris din locations_admin (id 6, "examH")
new Float:EXAMH_LOC_Y = 0.0;
new Float:EXAMH_LOC_Z = 0.0;
#define MAX_EXAMH_CARS         1
#define MAX_EXAMH_CHECKPOINTS  4
new g_ExamHCar[MAX_EXAMH_CARS] = {-1};
new Float:ExamHCheckpoints[MAX_EXAMH_CHECKPOINTS][3] = {
    {1606.0615, -2411.1555, 24.7277},
    {1769.8705, -2413.2139, 24.7256},
    {1766.5414, -2378.8860, 22.7122},
    {1635.0007, -2417.2942, 13.5662}
};

// Stare per-player (un singur examen de zbor odata)
new g_FlightState[MAX_PLAYERS];
new g_FlightCat[MAX_PLAYERS];
new g_FlightCheckpoint[MAX_PLAYERS];
new g_FlightVehicle[MAX_PLAYERS];
new g_FlightTimer[MAX_PLAYERS] = {-1, ...};

forward FlightExam_Timeout(playerid);

stock bool:IsExamPCarVehicle(vehid)
{
    for(new i = 0; i < MAX_EXAMP_CARS; i++)
        if(g_ExamPCar[i] == vehid) return true;
    return false;
}
stock bool:IsExamHCarVehicle(vehid)
{
    for(new i = 0; i < MAX_EXAMH_CARS; i++)
        if(g_ExamHCar[i] == vehid) return true;
    return false;
}

stock FlightExam_CPCount(playerid)
    return (g_FlightCat[playerid] == FLIGHT_CAT_H) ? MAX_EXAMH_CHECKPOINTS : MAX_EXAMP_CHECKPOINTS;

stock FlightExam_GetCarUser(vehid)
{
    for(new i = 0; i < MAX_PLAYERS; i++)
        if(g_FlightState[i] == FLIGHT_STATE_FLYING && g_FlightVehicle[i] == vehid) return i;
    return -1;
}

stock FlightExam_KillTimer(playerid)
{
    if(g_FlightTimer[playerid] != -1)
    {
        KillTimer(g_FlightTimer[playerid]);
        g_FlightTimer[playerid] = -1;
    }
}

stock FlightExam_GotoCheckpoint(playerid, cpIdx)
{
    new Float:cx, Float:cy, Float:cz;
    if(g_FlightCat[playerid] == FLIGHT_CAT_H) { cx = ExamHCheckpoints[cpIdx][0]; cy = ExamHCheckpoints[cpIdx][1]; cz = ExamHCheckpoints[cpIdx][2]; }
    else                                      { cx = ExamPCheckpoints[cpIdx][0]; cy = ExamPCheckpoints[cpIdx][1]; cz = ExamPCheckpoints[cpIdx][2]; }
    Track_SetPlayerCheckpoint(playerid, cx, cy, cz, FLIGHT_CP_SIZE);
    FlightExam_KillTimer(playerid);
    g_FlightTimer[playerid] = SetTimerEx("FlightExam_Timeout", FLIGHT_STEP_TIME, false, "i", playerid);
}

stock FlightExam_Fail(playerid, const reason[])
{
    new vehid = g_FlightVehicle[playerid];
    new bool:isH = (g_FlightCat[playerid] == FLIGHT_CAT_H);

    g_FlightState[playerid]      = FLIGHT_STATE_NONE;
    g_FlightVehicle[playerid]    = -1;
    g_FlightCheckpoint[playerid] = 0;
    DisablePlayerCheckpoint(playerid);
    FlightExam_KillTimer(playerid);

    if(vehid != -1) { Vehicle_SetLocked(vehid, false); SetVehicleToRespawn(vehid); }

    new msg[160];
    format(msg, sizeof(msg), T(playerid, C_ERROR"Error: "C_WHITE"You failed the Airplane %s exam. %s Try again."), isH ? ("H") : ("A"), reason);
    SCM(playerid, COLOR_ERROR, msg);
}

stock FlightExam_Finish(playerid)
{
    new vehid = g_FlightVehicle[playerid];
    new bool:isH = (g_FlightCat[playerid] == FLIGHT_CAT_H);

    DisablePlayerCheckpoint(playerid);
    FlightExam_KillTimer(playerid);
    g_FlightState[playerid]      = FLIGHT_STATE_NONE;
    g_FlightVehicle[playerid]    = -1;
    g_FlightCheckpoint[playerid] = 0;

    new Float:health = 0.0;
    if(vehid != -1) GetVehicleHealth(vehid, health);
    new bool:fullPass = (health >= FLIGHT_PASS_HEALTH);
    new passDur = isH ? FLIGHT_PASS_DURATION_H : FLIGHT_PASS_DURATION_P;
    new expTs = gettime() + (fullPass ? passDur : FLIGHT_FAIL_DURATION) + License_VipBonusSeconds(playerid);

    new dateStr[11];
    UnixToDateStr(expTs, dateStr, sizeof(dateStr));
    if(isH) { format(PlayerData[playerid][pAirLicH_exp], 11, "%s", dateStr); UpdatePlayer(playerid, pAirLicH_exp); }
    else    { format(PlayerData[playerid][pAirLicA_exp], 11, "%s", dateStr); UpdatePlayer(playerid, pAirLicA_exp); }

    if(vehid != -1) { Vehicle_SetLocked(vehid, false); SetVehicleToRespawn(vehid); }

    new msg[176];
    format(msg, sizeof(msg), T(playerid, C_SUCCESS"Congratulations, "C_WHITE"your Airplane %s license is valid until "C_INFO"%s"C_WHITE" (Aircraft HP: "C_INFO"%d"C_WHITE")."),
        isH ? ("H") : ("A"), dateStr, floatround(health));
    SCM(playerid, COLOR_SUCCESS, msg);
}

public FlightExam_Timeout(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(g_FlightState[playerid] == FLIGHT_STATE_NONE) return 0;
    g_FlightTimer[playerid] = -1;
    FlightExam_Fail(playerid, "Time's up.");
    return 1;
}

public OnPlayerEnterRaceCheckpoint(playerid)
{
    // Crop Duster Pilot: checkpoint-ul de la ferma e race checkpoint (mai vizibil de sus, la altitudine mare)
    if(g_CropDustState[playerid] == CROPDUST_STATE_FLYING)
    {
        CropDust_EnterFarm(playerid);
        return 1;
    }

    // Lumberjack: a ajuns cu forklift-ul la punctul de plantare din padure
    if(g_PlantState[playerid] == PLANT_STATE_DRIVING)
    {
        DisablePlayerRaceCheckpoint(playerid);
        g_PlantState[playerid] = PLANT_STATE_ARRIVED;
        SCM(playerid, COLOR_INFO, "[Lumberjack] Get out of the forklift, switch to your Shovel, and press FIRE to plant the sapling.");
        return 1;
    }

    // Race event: a atins un race checkpoint de cursa
    if(g_RaceState == RACE_STATE_RUNNING && g_RaceIn[playerid] && !g_RaceDone[playerid])
    {
        new lap     = g_RaceLap;
        new count   = g_RaceCPCount[lap];
        new reached = g_RaceCP[playerid]; // indexul CP-ului tocmai atins

        if(reached < count - 1)
        {
            // mai sunt checkpoint-uri -> arata urmatorul (cu sageata)
            g_RaceCP[playerid] = reached + 1;
            Race_SetCP(playerid, lap, reached + 1);
            return 1;
        }

        // ---- FINISH ----
        g_RaceDone[playerid] = true;
        DisablePlayerRaceCheckpoint(playerid);

        new Float:secs = float(GetTickCount() - g_RaceStartTick[playerid]) / 1000.0;
        if(secs < 0.0) secs = 0.0;

        g_RaceFinishOrder++;
        new pos = g_RaceFinishOrder;
        new totalSec = floatround(secs);
        new mm = totalSec / 60, ss = totalSec % 60;

        // Anunt global pentru primele 3 locuri
        if(pos <= 3)
        {
            new bm[144];
            format(bm, sizeof(bm), C_INFO"[Race Event] "C_WHITE"%s finished the race in position "C_SUCCESS"%d"C_WHITE", time "C_INFO"%d:%02d"C_WHITE".",
                PlayerData[playerid][pName], pos, mm, ss);
            SCMToAll(COLOR_INFO, bm);
        }

        // Mesaj privat cu locul obtinut
        new pm[128];
        format(pm, sizeof(pm), T(playerid, C_INFO"[Race Event] "C_WHITE"You finished in position "C_SUCCESS"%d/%d"C_WHITE" (time "C_INFO"%d:%02d"C_WHITE")."),
            pos, g_RaceTotal, mm, ss);
        SCM(playerid, COLOR_INFO, pm);

        // Verificare record (dupa lap + modelul folosit efectiv)
        new vi = Race_VehIndex(g_RaceVehUsed[playerid]);
        if(vi != -1 && secs < g_RaceRecordTime[lap][vi])
        {
            new oldHolder[24];
            format(oldHolder, sizeof(oldHolder), "%s", g_RaceRecordHolder[lap][vi]);
            new bool:hadHolder = (strlen(oldHolder) > 0);

            g_RaceRecordTime[lap][vi] = secs;
            format(g_RaceRecordHolder[lap][vi], 24, "%s", PlayerData[playerid][pName]);

            if(g_RaceRecordID[lap][vi] != -1)
            {
                new rq[160];
                mysql_format(g_SQL, rq, sizeof(rq),
                    "UPDATE `races` SET `rTimeRecord`=%.2f, `rPlayerName`='%e' WHERE `rID`=%d",
                    secs, PlayerData[playerid][pName], g_RaceRecordID[lap][vi]);
                mysql_tquery(g_SQL, rq, "", "", 0);
            }

            new rm[160];
            if(hadHolder)
                format(rm, sizeof(rm), C_SUCCESS"[Race Event] "C_WHITE"%s beat %s's record on %s (%s): %.2fs!",
                    PlayerData[playerid][pName], oldHolder, g_RaceLapName[lap], g_RaceVehNames[vi], secs);
            else
                format(rm, sizeof(rm), C_SUCCESS"[Race Event] "C_WHITE"%s set a new record on %s (%s): %.2fs!",
                    PlayerData[playerid][pName], g_RaceLapName[lap], g_RaceVehNames[vi], secs);
            SCMToAll(COLOR_SUCCESS, rm);
        }

        // Toti participantii au terminat? -> incheie evenimentul
        if(g_RaceFinishOrder >= g_RaceTotal)
            Race_End(false);

        return 1;
    }
    return 1;
}

// ---- /house upgrade: trebuie cumparat cu Benson-ul de la biz APPLIANCE_BIZ_ID (13), livrat cu checkpoint la casa ----
#define HOUSE_UPGRADE_CP_SIZE   6.0
#define HOUSE_UPGRADE_NONE      0
#define HOUSE_UPGRADE_FRIDGE    1
#define HOUSE_UPGRADE_BED       2
#define HOUSE_UPGRADE_TREE      3
#define HOUSE_UPGRADE_ANIMAL    4

new g_HouseUpgradeType[MAX_PLAYERS];
new g_HouseUpgradeHouseIdx[MAX_PLAYERS] = {-1, ...};
new g_HouseUpgradeAnimalIdx[MAX_PLAYERS] = {-1, ...};

// ---- Aparat de cafea pt. business: cumparat din Electronics Shop, livrat cu checkpoint la biz (acelasi Benson+APPLIANCE_BIZ_ID ca la /house upgrade) ----
#define BIZ_COFFEE_PRICE    6000
#define BIZ_COFFEE_CP_SIZE  6.0
new bool:g_BizCoffeeOrder[MAX_PLAYERS];
new g_BizCoffeeIdx[MAX_PLAYERS] = {-1, ...}; // indexul (in BusinessData) al biz-ului detinut, capturat la comanda

public OnPlayerEnterCheckpoint(playerid)
{
    if(JailWork_HandleCheckpoint(playerid)) return 1;
    if(Manage_HandleCheckpoint(playerid)) return 1;

    if(g_FlightState[playerid] == FLIGHT_STATE_FLYING)
    {
        g_FlightCheckpoint[playerid]++;
        if(g_FlightCheckpoint[playerid] >= FlightExam_CPCount(playerid))
            FlightExam_Finish(playerid);
        else
            FlightExam_GotoCheckpoint(playerid, g_FlightCheckpoint[playerid]);
        return 1;
    }

    // /house upgrade: Benson-ul cu livrarea a ajuns la casa - se salveaza upgrade-ul
    if(g_HouseUpgradeType[playerid] != HOUSE_UPGRADE_NONE)
    {
        HouseUpgrade_Complete(playerid);
        return 1;
    }

    // Aparat de cafea comandat pt. business: Benson-ul cu livrarea a ajuns la biz - se salveaza
    if(g_BizCoffeeOrder[playerid])
    {
        BizCoffee_Complete(playerid);
        return 1;
    }

    // Jaf: ajuns la un business de livrare (checkpoint). Progreseaza / plateste.
    if(Rob_HandleCheckpoint(playerid)) return 1;

    // Contrabanda: ajuns la punctul de incarcare / descarcare
    if(Smuggle_HandleCheckpoint(playerid)) return 1;

    // Farm: livrare recolta ajunsa la shop
    if(g_FarmDelivTruck[playerid] != 0 && GetPlayerVehicleID(playerid) == g_FarmDelivTruck[playerid])
    {
        new fdx = g_FarmDelivFarm[playerid];
        new pay = FarmData[fdx][fmRecolta] + 5000 + random(2500);
        FarmData[fdx][fmBank] += pay; // banii merg in contul fermei
        FarmData[fdx][fmRecolta] = 0;
        Farm_Save(fdx);
        Farm_DeliverCleanup(playerid);

        // livrarea foloseste intotdeauna truck+trailer proprii ale fermei -> consuma o utilizare din fiecare
        new dm[200];
        format(dm, sizeof(dm), T(playerid, C_SUCCESS"[Farm] "C_WHITE"Harvest delivered! "C_SUCCESS"+$%s"C_WHITE" to the farm bank (now "C_INFO"$%s"C_WHITE")."), MoneyStr(pay), MoneyStr(FarmData[fdx][fmBank]));
        if(Farm_ConsumeUse(fdx, FARM_TRUCK))   strcat(dm, T(playerid, " The truck just broke down!"));
        if(Farm_ConsumeUse(fdx, FARM_TRAILER)) strcat(dm, T(playerid, " The trailer just broke down!"));
        SCM(playerid, COLOR_SUCCESS, dm);
        return 1;
    }

    if(g_ExamAState[playerid] == EXAMA_STATE_DRIVING)
    {
        g_ExamACheckpoint[playerid]++;
        if(g_ExamACheckpoint[playerid] >= MAX_EXAMA_CHECKPOINTS)
        {
            ExamA_Finish(playerid);
        }
        else
        {
            ExamA_GotoCheckpoint(playerid, g_ExamACheckpoint[playerid]);
        }
        return 1;
    }

    if(g_ExamState[playerid] == EXAM_STATE_DRIVING)
    {
        g_ExamCheckpoint[playerid]++;
        if(g_ExamCheckpoint[playerid] >= MAX_EXAMB_CHECKPOINTS)
        {
            Exam_Finish(playerid);
        }
        else
        {
            Exam_GotoCheckpoint(playerid, g_ExamCheckpoint[playerid]);
        }
        return 1;
    }

    if(g_ExamCState[playerid] == EXAMC_STATE_DRIVING)
    {
        g_ExamCCheckpoint[playerid]++;
        if(g_ExamCCheckpoint[playerid] >= MAX_EXAMC_CHECKPOINTS)
        {
            ExamC_Finish(playerid);
        }
        else
        {
            ExamC_GotoCheckpoint(playerid, g_ExamCCheckpoint[playerid]);
        }
        return 1;
    }

    if(g_ExamDState[playerid] == EXAMD_STATE_DRIVING)
    {
        g_ExamDCheckpoint[playerid]++;
        if(g_ExamDCheckpoint[playerid] >= MAX_EXAMD_CHECKPOINTS)
        {
            ExamD_Finish(playerid);
        }
        else
        {
            ExamD_GotoCheckpoint(playerid, g_ExamDCheckpoint[playerid]);
        }
        return 1;
    }

    // Transport drugs (mafii): atingerea checkpoint-ului de preluare / HQ
    if(g_DrugStage[playerid] == DRUG_STAGE_TOPICKUP)
    {
        DisablePlayerCheckpoint(playerid);
        g_DrugStage[playerid] = DRUG_STAGE_LOADING;
        TogglePlayerControllable(playerid, 0);
        GTP(playerid, "~w~Loading weed...", DRUG_LOAD_FREEZE * 1000, 3);
        SetTimerEx("DrugTransport_Loaded", DRUG_LOAD_FREEZE * 1000, false, "i", playerid);
        return 1;
    }
    if(g_DrugStage[playerid] == DRUG_STAGE_TOHQ)
    {
        DisablePlayerCheckpoint(playerid);
        g_DrugStage[playerid] = DRUG_STAGE_UNLOADING;
        TogglePlayerControllable(playerid, 0);
        GTP(playerid, "~w~Unloading weed...", DRUG_LOAD_FREEZE * 1000, 3);
        SetTimerEx("DrugTransport_Unloaded", DRUG_LOAD_FREEZE * 1000, false, "i", playerid);
        return 1;
    }

    // Crop Duster Pilot: checkpoint-ul de load (checkpoint-ul de la ferma e race checkpoint, vezi OnPlayerEnterRaceCheckpoint)
    if(g_CropDustState[playerid] == CROPDUST_STATE_LOADING)
    {
        CropDust_EnterLoad(playerid);
        return 1;
    }

    // Funeral (Romero): checkpoint la casa (alege animalul din dialog) / la capela (descarca)
    if(g_FuneralState[playerid] == FUNERAL_STATE_TOHOUSE)
    {
        Funeral_EnterHouse(playerid);
        return 1;
    }
    if(g_FuneralState[playerid] == FUNERAL_STATE_TOCHURCH)
    {
        Funeral_EnterChurch(playerid);
        return 1;
    }

    // Water Hauler: checkpoint de incarcare apa / de udat plantele (propriul state machine)
    if(g_IsWorking[playerid] && g_WaterStage[playerid] != WATER_STAGE_NONE)
    {
        Water_OnCheckpoint(playerid);
        return 1;
    }

    // Beach Groomer: checkpoint aleatoriu de nivelat nisipul (un singur checkpoint continuu, fara etape)
    if(g_IsWorking[playerid] && PlayerData[playerid][pJob] == JOB_BEACH)
    {
        Beach_OnCheckpoint(playerid);
        return 1;
    }

    // Fuel Carrier: checkpoint de incarcare la depou / de livrare la benzinaria aleasa (propriul state machine)
    if(g_FuelCarrierStage[playerid] != FUELCARRIER_STAGE_NONE)
    {
        FuelCarrier_OnCheckpoint(playerid);
        return 1;
    }

    // Truck Driver: checkpoint de incarcare la punctul ales / de livrare la barul ales (propriul state machine)
    if(g_TruckDriverStage[playerid] != TRUCKDRIVER_STAGE_NONE)
    {
        TruckDriver_OnCheckpoint(playerid);
        return 1;
    }

    // Currency Transporter: checkpoint de ridicare / de livrare a banilor (propriul state machine)
    if(g_CurrencyStage[playerid] != CURRENCY_STAGE_NONE)
    {
        CurrencyTransport_OnCheckpoint(playerid);
        return 1;
    }

    // Fisherman: ajuns la fast-food-ul de livrare a pestelui
    if(g_FishState[playerid] == FISH_STATE_DELIVER)
    {
        DisablePlayerCheckpoint(playerid);

        new fPay = FISH_PAY_BASE + (g_FishWeight[playerid] / 2);
        PlayerData[playerid][pMoney] += fPay;
        GivePlayerMoney(playerid, fPay);
        UpdatePlayer(playerid, pMoney);

        new fdmsg[144];
        format(fdmsg, sizeof(fdmsg), T(playerid, C_SUCCESS"[Fisherman] "C_WHITE"You delivered the "C_INFO"%dg"C_WHITE" fish. Paid "C_INFO"$%d"C_WHITE"."), g_FishWeight[playerid], fPay);
        SCM(playerid, COLOR_SUCCESS, fdmsg);

        g_FishState[playerid]  = FISH_STATE_NONE;
        g_FishWeight[playerid] = 0;
        JobStatus_Hide(playerid);
        return 1;
    }

    // Lumberjack: ajuns la biz-ul de livrare a lemnului
    if(g_LumberState[playerid] == LUMBER_STATE_DELIVERING)
    {
        DisablePlayerCheckpoint(playerid);

        new lwPay = LUMBER_PAY_BASE + (g_LumberWoodCount[playerid] * LUMBER_PAY_PER_TREE);
        PlayerData[playerid][pMoney] += lwPay;
        GivePlayerMoney(playerid, lwPay);
        UpdatePlayer(playerid, pMoney);

        new lwdmsg[160];
        format(lwdmsg, sizeof(lwdmsg), T(playerid, C_SUCCESS"[Lumberjack] "C_WHITE"You delivered "C_INFO"%d"C_WHITE" trees worth of wood. Paid "C_INFO"$%d"C_WHITE"."), g_LumberWoodCount[playerid], lwPay);
        SCM(playerid, COLOR_SUCCESS, lwdmsg);

        g_LumberState[playerid]     = LUMBER_STATE_NONE;
        g_LumberWoodCount[playerid] = 0;
        JobStatus_Hide(playerid);
        return 1;
    }

    if(g_IsWorking[playerid] && g_JobStage[playerid] != JOB_STAGE_NONE)
    {
        // 2 secunde de freeze la atingerea checkpoint-ului, apoi unfreeze
        TogglePlayerControllable(playerid, 0);
        SetTimerEx("Job_Unfreeze", 2000, false, "i", playerid);

        if(g_JobStage[playerid] == JOB_STAGE_PICKUP)
        {
            Job_StartDest(playerid);
        }
        else if(g_JobStage[playerid] == JOB_STAGE_DELIVER)
        {
            Job_PayDelivery(playerid);
            g_JobUnloadsDone[playerid]++;
            if(g_JobUnloadsDone[playerid] < JOB_UNLOADS_PER_LOAD)
                Job_StartDest(playerid);   // mai are o descarcare (fara sa treaca pe la load)
            else
                Job_StartSource(playerid); // ambele descarcari facute -> inapoi la load
        }
        return 1;
    }

    // Uber: soferul a ajuns la pasagerul asignat (inainte ca acesta sa se urce)
    if(g_UberOnDuty[playerid] && g_UberPassenger[playerid] != INVALID_PLAYER_ID &&
       !g_UberRideActive[g_UberPassenger[playerid]])
    {
        DisablePlayerCheckpoint(playerid);
        SCM(playerid, COLOR_INFO, C_INFO"[Uber] "C_WHITE"You reached your passenger. Wait for them to get in.");
        return 1;
    }

    // Bus Driver: a atins o statie de pe ruta activa
    if(g_BusLine[playerid] > 0 && g_BusGraceTimer[playerid] == -1)
    {
        TogglePlayerControllable(playerid, 0);
        SetTimerEx("Job_Unfreeze", 1000, false, "i", playerid);

        new line  = g_BusLine[playerid] - 1;
        new cp    = g_BusCP[playerid];             // index 0-based al statiei tocmai atinse
        new total = g_BusRouteCount[line];

        new Float:cx = g_BusRoute[line][cp][0];
        new Float:cy = g_BusRoute[line][cp][1];
        new Float:dist = Job_Dist2D(g_BusLastX[playerid], g_BusLastY[playerid], cx, cy);
        new pay = JOB_BUS_CP_PAY + floatround(JOB_BUS_PAY_PER_M * dist);

        g_BusLastX[playerid] = cx;
        g_BusLastY[playerid] = cy;

        new bool:lastCp = (cp + 1 >= total);       // tocmai a atins ultima statie
        if(lastCp) pay += JOB_BUS_FINISH_BONUS;

        PlayerData[playerid][pMoney] += pay;
        GivePlayerMoney(playerid, pay);
        UpdatePlayer(playerid, pMoney);

        // Avanseaza; dupa ultima statie ruta reincepe de la statia 1
        g_BusCP[playerid] = lastCp ? 0 : (cp + 1);
        Bus_SetCheckpoint(playerid);

        new gt[256];
        if(lastCp)
            format(gt, sizeof(gt), T(playerid, "Route complete! +$%d. Next stop: 1/%d"), pay, total);
        else
            format(gt, sizeof(gt), T(playerid, "Stop %d/%d reached. +$%d. Next stop: %d/%d"),
                cp + 1, total, pay, g_BusCP[playerid] + 1, total);
        JobStatus_Update(playerid, gt);
        return 1;
    }

    if(g_GPSActive[playerid])
    {
        DisablePlayerCheckpoint(playerid);
        g_GPSActive[playerid] = false;
        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"You have arrived at your destination.");
        return 1;
    }

    return 1;
}

// Distruge si recreeaza eticheta 3D la HQ-ul factiunii
stock Factions_RecreateLabel(fid)
{
    if(g_FactionLabel[fid] != Text3D:INVALID_3DTEXT_ID)
    {
        Delete3DTextLabel(g_FactionLabel[fid]);
        g_FactionLabel[fid] = Text3D:INVALID_3DTEXT_ID;
    }
    if(g_FactionMapIcon[fid] != STREAMER_TAG_MAP_ICON:INVALID_STREAMER_ID)
    {
        DestroyDynamicMapIcon(g_FactionMapIcon[fid]);
        g_FactionMapIcon[fid] = STREAMER_TAG_MAP_ICON:INVALID_STREAMER_ID;
    }
    if(FactionData[fid][fHQX] == 0.0 && FactionData[fid][fHQY] == 0.0) return;

    new label[96], colorcode[9];
    GetFactionColorCode(fid, colorcode, sizeof(colorcode));
    // Daca interiorul e configurat, afiseaza si invitatia de a intra
    if(FactionData[fid][fInteriorX] != 0.0 || FactionData[fid][fInteriorY] != 0.0)
        format(label, sizeof(label), "%s[ %s ]\n"C_WHITE"[ Press ENTER to enter ]", colorcode, FactionData[fid][fName]);
    else
        format(label, sizeof(label), "%s[ %s ]", colorcode, FactionData[fid][fName]);
    g_FactionLabel[fid] = Create3DTextLabel(label, FactionColors[fid],
        FactionData[fid][fHQX], FactionData[fid][fHQY], FactionData[fid][fHQZ]-0.5,
        20.0, 0, 0);

    if(FactionData[fid][fMapIconID] > 0) // 0 = "None" in lista SA-MP, la fel ca -1 (fara icon)
        g_FactionMapIcon[fid] = CreateDynamicMapIcon(FactionData[fid][fHQX], FactionData[fid][fHQY], FactionData[fid][fHQZ],
            FactionData[fid][fMapIconID], FactionColors[fid]); // MAPICON_LOCAL implicit
}

// Distruge si recreeaza pickup-ul + eticheta din interiorul factiunii
stock Factions_RecreateInteriorPickup(fid)
{
    if(g_FactionInteriorPickup[fid] != -1)
    {
        DestroyPickup(g_FactionInteriorPickup[fid]);
        g_FactionInteriorPickup[fid] = -1;
    }
    if(g_FactionInteriorLabel[fid] != Text3D:INVALID_3DTEXT_ID)
    {
        Delete3DTextLabel(g_FactionInteriorLabel[fid]);
        g_FactionInteriorLabel[fid] = Text3D:INVALID_3DTEXT_ID;
    }
    if(FactionData[fid][fInteriorX] == 0.0 && FactionData[fid][fInteriorY] == 0.0) return;

    g_FactionInteriorPickup[fid] = CreatePickup(FACTION_INTERIOR_PICKUP_MODEL, 1,
        FactionData[fid][fInteriorX], FactionData[fid][fInteriorY], FactionData[fid][fInteriorZ],
        FactionData[fid][fvw]);

    g_FactionInteriorLabel[fid] = Create3DTextLabel(C_WHITE"[ Press ENTER to exit ]", FactionColors[fid],
        FactionData[fid][fInteriorX], FactionData[fid][fInteriorY], FactionData[fid][fInteriorZ]-0.5,
        10.0, FactionData[fid][fvw], 0);
}

// Distruge si recreeaza pickup-ul pentru o factiune
stock Factions_RecreatePickup(fid)
{
    if(g_FactionPickup[fid] != -1)
    {
        DestroyPickup(g_FactionPickup[fid]);
        g_FactionPickup[fid] = -1;
    }
    if(FactionData[fid][fPickupID] != -1 &&
       (FactionData[fid][fHQX] != 0.0 || FactionData[fid][fHQY] != 0.0))
    {
        g_FactionPickup[fid] = CreatePickup(FactionData[fid][fPickupID], 1,
            FactionData[fid][fHQX], FactionData[fid][fHQY], FactionData[fid][fHQZ], -1);
    }
}

// Intra/iesi din interiorul sediului factiunii fid (apasand KEY_SECONDARY_ATTACK langa pickup). Intoarce true daca a actionat.
stock bool:Factions_InteriorToggleFor(playerid, fid)
{
    if(fid < 1 || fid > MAX_FACTIONS) return false;

    new bool:hqSet  = (FactionData[fid][fHQX] != 0.0 || FactionData[fid][fHQY] != 0.0);
    new bool:intSet = (FactionData[fid][fInteriorX] != 0.0 || FactionData[fid][fInteriorY] != 0.0);
    if(!hqSet || !intSet) return false;

    // Langa HQ-ul exterior (vw 0) -> intra in interior
    if(GetPlayerVirtualWorld(playerid) == 0 &&
       IsPlayerInRangeOfPoint(playerid, 1.5, FactionData[fid][fHQX], FactionData[fid][fHQY], FactionData[fid][fHQZ]))
    {
        AC_SetInterior(playerid, FactionData[fid][fInterior]);
        AC_SetVW(playerid, FactionData[fid][fvw]);
        AC_SetPos(playerid, FactionData[fid][fInteriorX], FactionData[fid][fInteriorY], FactionData[fid][fInteriorZ]);
        SetPlayerFacingAngle(playerid, FactionData[fid][fInteriorA]);
        g_PlayerInFactionHQ[playerid] = fid;
        return true;
    }

    // Langa pickup-ul din interior (vw-ul factiunii) -> iesi afara
    if(GetPlayerVirtualWorld(playerid) == FactionData[fid][fvw] &&
       IsPlayerInRangeOfPoint(playerid, 1.5, FactionData[fid][fInteriorX], FactionData[fid][fInteriorY], FactionData[fid][fInteriorZ]))
    {
        AC_SetInterior(playerid, 0);
        AC_SetVW(playerid, 0);
        AC_SetPos(playerid, FactionData[fid][fHQX], FactionData[fid][fHQY], FactionData[fid][fHQZ]);
        g_PlayerInFactionHQ[playerid] = 0;
        return true;
    }
    return false;
}

// Intrare/iesire din sediul factiunii tale. Sediul Politiei e deschis oricui (civili si membri ai altor factiuni).
// (1 = FACTION_POLICE: la linia asta constanta nu e inca definita)
stock Factions_InteriorToggle(playerid)
{
    new own = PlayerData[playerid][pFaction];
    if(own >= 1 && own <= MAX_FACTIONS && Factions_InteriorToggleFor(playerid, own)) return;
    if(own != 1) Factions_InteriorToggleFor(playerid, 1);
}

// Returneaza fid-ul HQ-ului al carui interior il ocupa playerul, sau 0 (stiut direct, setat la intrare - vezi Factions_InteriorToggle)
stock Factions_PlayerInsideHQ(playerid)
{
    return g_PlayerInFactionHQ[playerid];
}

// Returneaza true daca playerul se afla in interiorul HQ-ului propriei factiuni
stock bool:Factions_IsInOwnInterior(playerid)
{
    new fid = PlayerData[playerid][pFaction];
    if(fid < 1 || fid > MAX_FACTIONS) return false;
    return g_PlayerInFactionHQ[playerid] == fid;
}

// ============================================================
//  CITYHALL (intrare/iesire)
// ============================================================
new Float:CITYHALL_EXT_X = 0.0;   // suprascris din locations_admin ("Cityhall")
new Float:CITYHALL_EXT_Y = 0.0;
new Float:CITYHALL_EXT_Z = 0.0;
new Float:CITYHALL_INT_X = 0.0;   // suprascris din locations_admin ("cityhall_int")
new Float:CITYHALL_INT_Y = 0.0;
new Float:CITYHALL_INT_Z = 0.0;
#define CITYHALL_INTERIOR     3
#define CITYHALL_PICKUP_MODEL 1276
#define CITYHALL_RANGE        2.5

// Creeaza pickup-urile, map icon-ul si etichetele 3D pentru Cityhall (exterior + interior)
stock Cityhall_Create()
{
    CreateDynamicPickup(CITYHALL_PICKUP_MODEL, 1, CITYHALL_EXT_X, CITYHALL_EXT_Y, CITYHALL_EXT_Z, 0, 0);
    CreateDynamicPickup(CITYHALL_PICKUP_MODEL, 1, CITYHALL_INT_X, CITYHALL_INT_Y, CITYHALL_INT_Z, 0, CITYHALL_INTERIOR);

    CreateDynamic3DTextLabel("[ Cityhall ]\n[ Press enter to enter ]", COLOR_WHITE,
        CITYHALL_EXT_X, CITYHALL_EXT_Y, CITYHALL_EXT_Z-0.5, 20.0,
        INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
    CreateDynamic3DTextLabel("[ Cityhall ]\n[ Press enter to exit ]", COLOR_WHITE,
        CITYHALL_INT_X, CITYHALL_INT_Y, CITYHALL_INT_Z-0.5, 20.0,
        INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, CITYHALL_INTERIOR);
}

// Intrare/iesire Cityhall (apasand KEY_SECONDARY_ATTACK langa pickup)
stock Cityhall_Toggle(playerid)
{
    // Exterior -> interior
    if(GetPlayerInterior(playerid) == 0 &&
       IsPlayerInRangeOfPoint(playerid, CITYHALL_RANGE, CITYHALL_EXT_X, CITYHALL_EXT_Y, CITYHALL_EXT_Z))
    {
        AC_SetPos(playerid, CITYHALL_INT_X, CITYHALL_INT_Y, CITYHALL_INT_Z);
        AC_SetInterior(playerid, CITYHALL_INTERIOR);
        return;
    }
    // Interior -> exterior
    if(GetPlayerInterior(playerid) == CITYHALL_INTERIOR &&
       IsPlayerInRangeOfPoint(playerid, CITYHALL_RANGE, CITYHALL_INT_X, CITYHALL_INT_Y, CITYHALL_INT_Z))
    {
        AC_SetPos(playerid, CITYHALL_EXT_X, CITYHALL_EXT_Y, CITYHALL_EXT_Z);
        AC_SetInterior(playerid, 0);
    }
}

// Seteaza map icon-urile locale (MAPICON_LOCAL) pentru un player
stock Factions_SetPlayerIcons(playerid)
{
    SetPlayerMapIcon(playerid, 0, 846.4172, -2059.0867, 12.8672, 35, 0, MAPICON_LOCAL); // SPAWN POINT
    SetPlayerMapIcon(playerid, 1, CASINO_ENT_X, CASINO_ENT_Y, CASINO_ENT_Z, CASINO_MAPICON_ID, 0, MAPICON_LOCAL); // CASINO
    SetPlayerMapIcon(playerid, 2, g_HuntStartX, g_HuntStartY, g_HuntStartZ, HUNT_MAPICON_ID, 0, MAPICON_LOCAL); // HUNTING
}

// Actualizeaza icon-urile pentru toti playerii logati
stock Factions_UpdatePlayersIcons()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && PlayerData[i][pLogged])
            Factions_SetPlayerIcons(i);
    }
}

new bool:g_Sleeping[MAX_PLAYERS];   // true cat timp playerul e in freeze-ul de /sleep
new g_SleepTargetTired[MAX_PLAYERS]; // valoarea oboselii dupa /sleep (0 acasa, HOTEL_SLEEP_TIRED la hotel)

// ============================================================
//  CASE
// ============================================================
enum E_HOUSE_DATA
{
    hID, hName[32], hOwnerName[24], hOwnerId, hOwned, hForSale, hPrice,
    hDefaultPrice, // pretul initial de vanzare, setat la /hcreate; folosit DOAR pentru calculul taxei de la PayDay (nu pentru buy/sell, acolo se foloseste hPrice)
    hType, hMaxPets, hPets,
    Float:hLocX, Float:hLocY, Float:hLocZ,
    hInterior, Float:hIntLocX, Float:hIntLocY, Float:hIntLocZ, // interiorul casei (legat via /hc interior, dintr-un gta_interiors); vw = hID cand esti inauntru
    hHasFridge, hFridge[5], // frigider: 0=lapte, 1=banane, 2=apa, 3=suc, 4=bere
    hFridgeExpire, // timestamp unix cand se strica frigiderul (0 = nesetat)
    hHasBed, // pat: necesar pentru /sleep (reseteaza oboseala)
    hBedExpire, // timestamp unix cand se strica patul (0 = nesetat); in DB e coloana `bed_Exp` de tip DATE (conversie via DateStrToUnix/BuildDateSqlValueFromUnix)
    hBank, // contul casei
    hSGR, // ambalaje SGR acumulate (apa/suc/bere), max 100; se livreaza cu /sgrload + /sgrunload
    hTrash, // gunoi acumulat (lapte/banane), max 100; se livreaza cu /trashload + /trashunload
    hTreeId, // treeId din tabela trees (0 = casa nu are inca un copac); vezi /houseupgrade tree si /tree
    hIssue, // 0 = fara probleme; 1-3 = problema activa la apartament (vezi HOUSE_ISSUE_COUNT); repara Electricianul cu /fixapartament
    hIsRentable, // 1 = poate fi inchiriata cu /renthouse sau /rentappartment (setat de admin cu /hc rentable)
    hRentPrice, // chiria luata de la chirias la fiecare PayDay (vezi /hc rentprice)
    hRenterId // pID-ul chiriasului curent (0 = nimeni nu inchiriaza casa asta)
}
new HouseData[MAX_HOUSES][E_HOUSE_DATA];

// ---- Frigider casa ----
#define FRIDGE_PRICE        10000
#define FRIDGE_ITEMS        5
// indici: 0=Milk(L), 1=Banana(pcs), 2=Water(L), 3=Juice(L), 4=Beer(L)
new const g_FridgeName[FRIDGE_ITEMS][16] = { "Milk", "Banana", "Water", "Juice", "Beer" };
new const g_FridgeUnit[FRIDGE_ITEMS][8]  = { "L", "pcs", "L", "L", "L" };
new const g_FridgeMax[FRIDGE_ITEMS]      = { 20, 30, 25, 20, 50 };
new const g_FridgePrice[FRIDGE_ITEMS]    = { 100, 50, 150, 200, 250 };
new const g_FridgeHeal[FRIDGE_ITEMS]     = { 20, 10, 25, 15, 10 };
#define FRIDGE_OPEN_START   15 // ora de deschidere pentru /frigde buy
#define FRIDGE_OPEN_END     20 // ora de inchidere (exclusiv)
#define FRIDGE_RANGE        20.0
#define FRIDGE_BIZ_ID       14 // business-ul care primeste o cota din cumparaturile de la frigider
#define FRIDGE_LIFESPAN_DAYS 32 // dupa cate zile se strica frigiderul

// ---- Pat casa (necesar pentru /sleep) ----
#define BED_PRICE           7500
#define BED_LIFESPAN_DAYS   29 // dupa cate zile se strica patul

// ---- Business-ul care primeste o cota din vanzarea de electrocasnice (frigider/pat) ----
#define APPLIANCE_BIZ_ID      13 // Home Furnitures
#define APPLIANCE_BIZ_CUT_PCT 1  // % din pretul frigiderului/patului care intra in banca business-ului

// ---- SGR (ambalaje returnabile: apa/suc/bere) ----
#define HOUSE_SGR_MAX       100  // capacitate maxima de stocare SGR per casa
#define HOUSE_SGR_WARN      80   // prag de la care proprietarul e avertizat la login
#define SGR_PRICE_PER_UNIT  50   // $ platiti per SGR livrat, in contul casei
#define SGR_LOAD_RANGE      20.0 // raza fata de casa pentru /sgrload (aceeasi ca FRIDGE_RANGE)
#define SGR_UNLOAD_RANGE    8.0  // raza fata de locatia de unload pentru /sgrunload
#define SGR_UNLOAD_PICKUP_MODEL 2060

new g_SGRCarrying[MAX_PLAYERS];  // cate SGR-uri carui casa transporta jucatorul (0 = niciunul)
new g_SGRHouseID[MAX_PLAYERS];   // hID-ul casei de la care provin SGR-urile transportate
new Float:g_SGRUnloadX, Float:g_SGRUnloadY, Float:g_SGRUnloadZ; // locatia de unload (locID 31)
#define MAX_SGR_VEHICLES 5
new g_SGRVehId[MAX_SGR_VEHICLES]; // vehiculele (dube) permise pentru /sgrload si /sgrunload

// ---- Trash (gunoi acumulat din lapte/banane) ----
#define HOUSE_TRASH_MAX       100  // capacitate maxima de stocare gunoi per casa
#define HOUSE_TRASH_WARN      80   // prag de la care proprietarul e avertizat la login
#define TRASH_PRICE_PER_UNIT  30   // $ platiti per gunoi livrat, in contul casei
#define TRASH_LOAD_RANGE      20.0 // raza fata de casa pentru /trashload (aceeasi ca FRIDGE_RANGE)
#define TRASH_UNLOAD_RANGE    8.0  // raza fata de locatia de unload pentru /trashunload
#define TRASH_UNLOAD_PICKUP_MODEL 2060

new g_TrashCarrying[MAX_PLAYERS]; // cat gunoi carui casa transporta jucatorul (0 = niciunul)
new g_TrashHouseID[MAX_PLAYERS];  // hID-ul casei de la care provine gunoiul transportat
new Float:g_TrashUnloadX, Float:g_TrashUnloadY, Float:g_TrashUnloadZ; // locatia de unload (locID 32)
#define MAX_TRASH_VEHICLES 4
new g_TrashVehId[MAX_TRASH_VEHICLES]; // vehiculele permise pentru /trashload si /trashunload

// True daca vehid e unul dintre vehiculele desemnate pentru gunoi
stock bool:IsTrashVehicle(vehid)
{
    for(new i = 0; i < MAX_TRASH_VEHICLES; i++)
        if(g_TrashVehId[i] == vehid) return true;
    return false;
}

// True daca vehid e una dintre dubele desemnate pentru SGR
stock bool:IsSGRVehicle(vehid)
{
    for(new i = 0; i < MAX_SGR_VEHICLES; i++)
        if(g_SGRVehId[i] == vehid) return true;
    return false;
}

#define FRIDGE_BIZ_CUT_PCT  10 // % din valoarea cumparata care intra in banca business-ului
new g_HousePickup[MAX_HOUSES];
new Text3D:g_HouseLabel[MAX_HOUSES] = {Text3D:INVALID_3DTEXT_ID, ...};
new STREAMER_TAG_3D_TEXT_LABEL:g_HouseIntLabel[MAX_HOUSES]; // eticheta din interiorul casei (daca are interior configurat)
new g_HouseCount = 0;
new g_PlayerInHouse[MAX_PLAYERS] = {-1, ...}; // indexul (in HouseData) al casei al carui interior il ocupa playerul, -1 = niciuna (setat/golit doar de Houses_InteriorToggle)

stock Houses_RecreatePickup(idx)
{
    if(g_HousePickup[idx] != -1)
    {
        DestroyPickup(g_HousePickup[idx]);
        g_HousePickup[idx] = -1;
    }
    g_HousePickup[idx] = CreatePickup(HouseData[idx][hOwned] ? 1272 : 1273, 1,
        HouseData[idx][hLocX], HouseData[idx][hLocY], HouseData[idx][hLocZ], -1);

    if(g_HouseLabel[idx] != Text3D:INVALID_3DTEXT_ID)
    {
        Delete3DTextLabel(g_HouseLabel[idx]);
        g_HouseLabel[idx] = Text3D:INVALID_3DTEXT_ID;
    }

    new bool:hasInterior = (HouseData[idx][hInterior] != 0 || HouseData[idx][hIntLocX] != 0.0 || HouseData[idx][hIntLocY] != 0.0);
    new enterHint[32];
    format(enterHint, sizeof(enterHint), "%s", hasInterior ? "\n[ Press ENTER to enter ]" : "");

    new label[288];
    if(HouseData[idx][hOwned])
    {
        if(HouseData[idx][hForSale])
            format(label, sizeof(label),
                "[ House #%d ]\nName: %s\nOwner: %s\n{5DA271}FOR SALE: $%s{E3E3E3}\n/buyhouse to buy it%s",
                HouseData[idx][hID], HouseData[idx][hName], HouseData[idx][hOwnerName], MoneyStr(HouseData[idx][hPrice]), enterHint);
        else
            format(label, sizeof(label),
                "[ House #%d ]\nName: %s\nOwner: %s%s",
                HouseData[idx][hID], HouseData[idx][hName], HouseData[idx][hOwnerName], enterHint);
    }
    else
    {
        format(label, sizeof(label),
            "[ House #%d ]\nName: %s\nOwned: No\nPrice: $%s\n\n/buyhouse to buy this house%s",
            HouseData[idx][hID], HouseData[idx][hName], MoneyStr(HouseData[idx][hPrice]), enterHint);
    }
    g_HouseLabel[idx] = Create3DTextLabel(label, COLOR_WHITE,
        HouseData[idx][hLocX], HouseData[idx][hLocY], HouseData[idx][hLocZ]-0.5, 15.0, 0, 0);

    Houses_RecreateInteriorLabel(idx);
}

// Eticheta din interiorul casei (doar daca are interior configurat); world = hID (unic per casa), interior = hInterior
stock Houses_RecreateInteriorLabel(idx)
{
    if(IsValidDynamic3DTextLabel(g_HouseIntLabel[idx]))
        DestroyDynamic3DTextLabel(g_HouseIntLabel[idx]);

    new bool:hasInterior = (HouseData[idx][hInterior] != 0 || HouseData[idx][hIntLocX] != 0.0 || HouseData[idx][hIntLocY] != 0.0);
    if(!hasInterior) return;

    g_HouseIntLabel[idx] = CreateDynamic3DTextLabel("[ Press ENTER to exit ]", COLOR_WHITE,
        HouseData[idx][hIntLocX], HouseData[idx][hIntLocY], HouseData[idx][hIntLocZ]-0.5, 15.0,
        INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,
        HouseData[idx][hID], HouseData[idx][hInterior]);
}

// Returneaza indexul (in HouseData) al casei cu hID == hid, sau -1
stock Houses_FindByID(hid)
{
    for(new i = 0; i < g_HouseCount; i++)
        if(HouseData[i][hID] == hid) return i;
    return -1;
}

// Intrare/iesire in interiorul unei case (apasand KEY_SECONDARY_ATTACK/ENTER langa ea). vw = hID cand esti inauntru.
stock Houses_InteriorToggle(playerid)
{
    if(GetPlayerVirtualWorld(playerid) == 0)
    {
        // Exterior -> interior: cauta o casa cu interior configurat, aproape de locatia ei exterioara
        for(new i = 0; i < g_HouseCount; i++)
        {
            new bool:hasInterior = (HouseData[i][hInterior] != 0 || HouseData[i][hIntLocX] != 0.0 || HouseData[i][hIntLocY] != 0.0);
            if(!hasInterior) continue;
            if(!IsPlayerInRangeOfPoint(playerid, 1.5, HouseData[i][hLocX], HouseData[i][hLocY], HouseData[i][hLocZ])) continue;

            // interior + virtual world INAINTE de pozitie
            AC_SetInterior(playerid, HouseData[i][hInterior]);
            AC_SetVW(playerid, HouseData[i][hID]);
            AC_SetPos(playerid, HouseData[i][hIntLocX], HouseData[i][hIntLocY], HouseData[i][hIntLocZ]);
            g_PlayerInHouse[playerid] = i;
            return;
        }
        return;
    }

    // Iesire: casa e cea al carei id e virtual world-ul curent (merge si daca ai aparut inauntru prin spawn /
    // teleport, cand g_PlayerInHouse nu e setat); g_PlayerInHouse ramane doar ca varianta de rezerva
    new hidx = -1, vw = GetPlayerVirtualWorld(playerid);
    for(new i = 0; i < g_HouseCount; i++)
        if(HouseData[i][hID] == vw) { hidx = i; break; }
    if(hidx == -1) hidx = g_PlayerInHouse[playerid];
    if(hidx == -1 || hidx >= g_HouseCount) return;
    if(!IsPlayerInRangeOfPoint(playerid, 2.5, HouseData[hidx][hIntLocX], HouseData[hidx][hIntLocY], HouseData[hidx][hIntLocZ])) return;

    AC_SetInterior(playerid, 0);
    AC_SetVW(playerid, 0);
    AC_SetPos(playerid, HouseData[hidx][hLocX], HouseData[hidx][hLocY], HouseData[hidx][hLocZ]);
    g_PlayerInHouse[playerid] = -1;
}

// Returneaza indexul (in HouseData) al casei al carui interior il ocupa playerul, sau -1
stock Houses_PlayerInside(playerid)
{
    if(GetPlayerVirtualWorld(playerid) == 0) return -1;
    return g_PlayerInHouse[playerid];
}

// Returneaza indexul primei case in raza playerului (oricare, indiferent de proprietar), sau -1 - pentru electrician
stock Houses_FindNearbyAny(playerid)
{
    for(new i = 0; i < g_HouseCount; i++)
        if(IsPlayerInRangeOfPoint(playerid, ELECTRICIAN_HOUSE_RANGE, HouseData[i][hLocX], HouseData[i][hLocY], HouseData[i][hLocZ]))
            return i;
    return -1;
}

// Returneaza indexul unui item de frigider dupa nume (EN sau RO), sau -1
stock Fridge_FindItem(const name[])
{
    if(strcmp(name, "milk", true) == 0   || strcmp(name, "lapte", true) == 0)  return 0;
    if(strcmp(name, "banana", true) == 0 || strcmp(name, "banane", true) == 0) return 1;
    if(strcmp(name, "water", true) == 0  || strcmp(name, "apa", true) == 0)    return 2;
    if(strcmp(name, "juice", true) == 0  || strcmp(name, "suc", true) == 0)    return 3;
    if(strcmp(name, "beer", true) == 0   || strcmp(name, "bere", true) == 0)   return 4;
    return -1;
}

// Returneaza indexul casei detinute de player daca e in raza ei, altfel -1
stock Player_FridgeHouse(playerid)
{
    if(PlayerData[playerid][pHouse] == 0) return -1;
    new hidx = Houses_FindByID(PlayerData[playerid][pHouse]);
    if(hidx == -1) return -1;
    if(!IsPlayerInRangeOfPoint(playerid, FRIDGE_RANGE, HouseData[hidx][hLocX], HouseData[hidx][hLocY], HouseData[hidx][hLocZ]))
        return -1;
    return hidx;
}

// Salveaza in DB frigiderul unei case
stock Houses_SaveFridge(hidx)
{
    new q[300];
    mysql_format(g_SQL, q, sizeof(q),
        "UPDATE `houses` SET `has_fridge`=%d, `fridge_milk`=%d, `fridge_banana`=%d, `fridge_water`=%d, `fridge_juice`=%d, `fridge_beer`=%d, `fridge_expire`=%d WHERE `id`=%d",
        HouseData[hidx][hHasFridge], HouseData[hidx][hFridge][0], HouseData[hidx][hFridge][1],
        HouseData[hidx][hFridge][2], HouseData[hidx][hFridge][3], HouseData[hidx][hFridge][4],
        HouseData[hidx][hFridgeExpire], HouseData[hidx][hID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// True daca frigiderul casei e stricat (expirat)
stock bool:Houses_FridgeBroken(hidx)
{
    return (HouseData[hidx][hFridgeExpire] > 0 && gettime() >= HouseData[hidx][hFridgeExpire]);
}

// True daca patul casei e stricat (expirat)
stock bool:Houses_BedBroken(hidx)
{
    return (HouseData[hidx][hBedExpire] > 0 && gettime() >= HouseData[hidx][hBedExpire]);
}

// Salveaza in DB patul unei case
stock Houses_SaveBed(hidx)
{
    new bedExpSql[14];
    BuildDateSqlValueFromUnix(HouseData[hidx][hBedExpire], bedExpSql, sizeof(bedExpSql));

    new q[160];
    mysql_format(g_SQL, q, sizeof(q),
        "UPDATE `houses` SET `has_bed`=%d, `bed_Exp`=%s WHERE `id`=%d",
        HouseData[hidx][hHasBed], bedExpSql, HouseData[hidx][hID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Se termina /sleep: reseteaza oboseala (la 0 acasa, la HOTEL_SLEEP_TIRED la hotel) si deblocheaza playerul
public Sleep_Finish(playerid)
{
    g_Sleeping[playerid] = false;
    if(!IsPlayerConnected(playerid)) return 1;

    TogglePlayerControllable(playerid, 1);
    PlayerData[playerid][pTired] = g_SleepTargetTired[playerid];
    UpdatePlayer(playerid, pTired);

    new smsg[100];
    format(smsg, sizeof(smsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You wake up feeling rested. Tiredness is now "C_INFO"%d"C_WHITE"."), PlayerData[playerid][pTired]);
    SCM(playerid, COLOR_SUCCESS, smsg);
    return 1;
}


// ============================================================
//  BARURI (create de admin, ca shop-urile/fastfood-ul - fara proprietar)
// ============================================================
#define MAX_BARS       30
#define BAR_RANGE      5.0
#define BAR_INT_EXIT_RANGE 15.0 // raza de iesire din interior - trebuie sa acopere toata camera, nu doar punctul de spawn (vezi eticheta "Press ENTER to exit")

// barType: 1 = Pub, 2 = Dance, 3 = Cafe
#define BAR_TYPE_CAFE 3
new const g_BarTypeName[4][12] = {"", "Pub", "Dance", "Cafe"};
#define BAR_PICKUP_MODEL 2714 // acelasi model de pickup exterior pentru toate barurile, indiferent de tip
#define BAR_TERRACE_RANGE 20.0 // raza "pe terasa" unei cafenele (doar daca are barTerrace), pentru pCoffee

enum E_BAR_DATA
{
    barID, barName[32], barType, barGTAIntID, barVW,
    Float:barLocX, Float:barLocY, Float:barLocZ,
    barStockMax, barStockCurr,
    bool:barTerrace // daca barul are terasa (0 = nu, implicit); momentan doar informativ/vizual, fara mecanica separata
}
new BarData[MAX_BARS][E_BAR_DATA];
new g_BarPickup[MAX_BARS];
new Text3D:g_BarLabel[MAX_BARS] = {Text3D:INVALID_3DTEXT_ID, ...};
new STREAMER_TAG_3D_TEXT_LABEL:g_BarIntLabel[MAX_BARS]; // eticheta "Press ENTER to exit", vizibila doar in interiorul/VW-ul barului
new g_BarCount = 0;
new g_PlayerInBar[MAX_PLAYERS] = {-1, ...}; // indexul (in BarData) al barului al carui interior il ocupa playerul, -1 = niciunul (setat/golit doar de Bar_InteriorToggle)

// Creeaza (sau recreeaza) pickup-ul + eticheta 3D a unui bar, la locatia lui exterioara (barLocX/Y/Z),
// plus eticheta de iesire din interior (daca barGTAIntID e configurat)
stock Bar_Create(idx)
{
    if(g_BarPickup[idx] != -1) { DestroyPickup(g_BarPickup[idx]); g_BarPickup[idx] = -1; }

    g_BarPickup[idx] = CreatePickup(BAR_PICKUP_MODEL, 1, BarData[idx][barLocX], BarData[idx][barLocY], BarData[idx][barLocZ], -1);

    if(g_BarLabel[idx] != Text3D:INVALID_3DTEXT_ID) { Delete3DTextLabel(g_BarLabel[idx]); g_BarLabel[idx] = Text3D:INVALID_3DTEXT_ID; }

    if(IsValidDynamic3DTextLabel(g_BarIntLabel[idx])) DestroyDynamic3DTextLabel(g_BarIntLabel[idx]);
    new intIdx = GTAInteriors_FindByID(BarData[idx][barGTAIntID]);
    if(BarData[idx][barGTAIntID] != 0 && intIdx != -1)
        g_BarIntLabel[idx] = CreateDynamic3DTextLabel(C_WHITE"[ Press ENTER to exit ]", COLOR_WHITE,
            GTAInteriorData[intIdx][gtaIntLocX], GTAInteriorData[intIdx][gtaIntLocY], GTAInteriorData[intIdx][gtaIntLocZ] - 0.5, 15.0,
            INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,
            BarData[idx][barVW], GTAInteriorData[intIdx][gtaIntInterior]);

    new label[160];
    format(label, sizeof(label), "[ Bar #%d ]\n[ %s ]\n[ %s ]%s\n[ Press ENTER to enter ]",
        BarData[idx][barID], BarData[idx][barName], g_BarTypeName[BarData[idx][barType]],
        BarData[idx][barTerrace] ? ("\n[ Terrace ]") : (""));
    g_BarLabel[idx] = Create3DTextLabel(label, COLOR_WHITE, BarData[idx][barLocX], BarData[idx][barLocY], BarData[idx][barLocZ] - 0.5, 20.0, 0, 0);
}

// Returneaza indexul (in BarData) al barului cu barID == id, sau -1
stock Bar_FindByID(id)
{
    for(new i = 0; i < g_BarCount; i++)
        if(BarData[i][barID] == id) return i;
    return -1;
}

// Returneaza indexul primului bar in raza playerului, sau -1
stock Bar_FindNearby(playerid)
{
    for(new i = 0; i < g_BarCount; i++)
        if(IsPlayerInRangeOfPoint(playerid, BAR_RANGE, BarData[i][barLocX], BarData[i][barLocY], BarData[i][barLocZ]))
            return i;
    return -1;
}

// Salveaza in DB stocul curent al unui bar
stock Bar_SaveStock(idx)
{
    new q[96];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `bars` SET `stock_curr`=%d WHERE `id`=%d", BarData[idx][barStockCurr], BarData[idx][barID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Intrare/iesire in interiorul unui bar (apasand KEY_SECONDARY_ATTACK/ENTER langa el). La intrare consuma 1 din stoc.
stock bool:Bar_InteriorToggle(playerid)
{
    if(GetPlayerVirtualWorld(playerid) == 0)
    {
        for(new i = 0; i < g_BarCount; i++)
        {
            if(BarData[i][barGTAIntID] == 0) continue; // fara interior configurat
            if(!IsPlayerInRangeOfPoint(playerid, BAR_RANGE, BarData[i][barLocX], BarData[i][barLocY], BarData[i][barLocZ])) continue;

            new intIdx = GTAInteriors_FindByID(BarData[i][barGTAIntID]);
            if(intIdx == -1) continue;

            // Interior/VW INAINTE de pozitie: altfel clientul poate randa noua pozitie cu texturile
            // interiorului vechi pentru o clipa (peretii/podeaua apar gri, desi coliziunea e ok).
            AC_SetInterior(playerid, GTAInteriorData[intIdx][gtaIntInterior]);
            AC_SetVW(playerid, BarData[i][barVW]);
            AC_SetPos(playerid, GTAInteriorData[intIdx][gtaIntLocX], GTAInteriorData[intIdx][gtaIntLocY], GTAInteriorData[intIdx][gtaIntLocZ]);

            if(BarData[i][barStockCurr] > 0)
            {
                BarData[i][barStockCurr]--;
                Bar_SaveStock(i);
                Bar_Create(i); // reafiseaza eticheta exterioara cu stocul actualizat
            }
            g_PlayerInBar[playerid] = i;
            return true;
        }
        return false;
    }

    // Iesire: stim exact in ce bar e playerul (setat la intrare), nu mai cautam prin toate
    new i = g_PlayerInBar[playerid];
    if(i == -1 || i >= g_BarCount || BarData[i][barGTAIntID] == 0) return false;
    if(BarData[i][barVW] != GetPlayerVirtualWorld(playerid)) return false;

    new intIdx = GTAInteriors_FindByID(BarData[i][barGTAIntID]);
    if(intIdx == -1) return false;
    if(GetPlayerInterior(playerid) != GTAInteriorData[intIdx][gtaIntInterior]) return false;
    if(!IsPlayerInRangeOfPoint(playerid, BAR_INT_EXIT_RANGE, GTAInteriorData[intIdx][gtaIntLocX], GTAInteriorData[intIdx][gtaIntLocY], GTAInteriorData[intIdx][gtaIntLocZ])) return false;

    AC_SetInterior(playerid, 0);
    AC_SetVW(playerid, 0);
    AC_SetPos(playerid, BarData[i][barLocX], BarData[i][barLocY], BarData[i][barLocZ]);
    g_PlayerInBar[playerid] = -1;
    return true;
}

// Returneaza indexul (in BarData) al barului al carui interior il ocupa playerul, sau -1
stock Bar_PlayerInside(playerid)
{
    if(GetPlayerVirtualWorld(playerid) == 0) return -1;
    return g_PlayerInBar[playerid];
}

// True daca playerul e in interiorul unei cafenele, sau pe terasa unei cafenele (in raza BAR_TERRACE_RANGE
// de barLocation, doar daca barul respectiv are terasa). Verificare "pe loc" (nu e cache-uita, nu se recalculeaza periodic) -
// folosita direct de /drink si de meniul de bauturi. Nu are legatura cu PlayerData[][pCoffee] (vezi /getcoffee).
stock bool:Bar_IsAtCafe(playerid)
{
    new inBarIdx = Bar_PlayerInside(playerid);
    if(inBarIdx != -1 && BarData[inBarIdx][barType] == BAR_TYPE_CAFE)
        return true;

    for(new i = 0; i < g_BarCount; i++)
    {
        if(BarData[i][barType] != BAR_TYPE_CAFE || !BarData[i][barTerrace]) continue;
        if(IsPlayerInRangeOfPoint(playerid, BAR_TERRACE_RANGE, BarData[i][barLocX], BarData[i][barLocY], BarData[i][barLocZ]))
            return true;
    }
    return false;
}

// ---- /drink in oras (necesita sa fii langa un bar) - meniu cu 9 bauturi, sticla/paharul atasat in mana pana la 3 click-uri (KEY_FIRE) ----
#define BARDRINK_ATTACH_INDEX  4     // diferit de BBALL (0), PARTY (1), VIPHAT (2), FISH_ROD (3)
#define BARDRINK_ATTACH_BONE   6     // 6 = Right Hand (bone SA-MP)
#define BARDRINK_MODEL         19570 // fallback (nu ar trebui folosit - fiecare categorie are propriul model, vezi BarDrink_ModelForCategory)
#define BARDRINK_DRUNK_AMOUNT  1000  // cat de "beat" te face o bautura (vezi SetPlayerDrunkLevel), la fel ca la party
#define BARDRINK_MAX_SIPS      3     // dupa al 3-lea KEY_FIRE, sticla/paharul e gol
#define DIALOG_BARDRINK        9059
#define DIALOG_TUNING_CATEGORY 9060
#define DIALOG_TUNING_PARTS    9061
#define DIALOG_PACATE_LIST     9062
#define DIALOG_SET_RELIGION    9063
#define DIALOG_WHAT_RELIGION   9064
#define DIALOG_CHURCHLIST      9065
#define DIALOG_QUEST_LIST      9066
#define DIALOG_HOLIDAY_HELP    9067

enum E_BAR_DRINK_DATA
{
    bdName[24], bdCategory[8], bdPrice, Float:bdHP, bool:bdIncDrunk
}
new const BarDrinkData[9][E_BAR_DRINK_DATA] = {
    {"Pepsi",         "juice",  20,  1.0, false},
    {"Corona",        "beer",   50,  2.0, true},
    {"Stella Artois", "beer",   40,  2.0, true},
    {"Heineken",      "beer",   45,  2.0, true},
    {"Purcari",       "wine",   100, 3.0, true},
    {"Capsunica",     "wine",   30, -1.0, true},
    {"Espresso",      "coffee", 10,  2.0, false},
    {"Caffe Latte",   "coffee", 15,  2.0, false},
    {"Irish Coffee",  "coffee", 20,  1.0, true}
};

new bool:g_BarHoldingDrink[MAX_PLAYERS];
new g_BarDrinkIndex[MAX_PLAYERS]; // indexul din BarDrinkData al bauturii tinute in mana, valid doar cat g_BarHoldingDrink e true
new g_BarDrinkSips[MAX_PLAYERS];  // cate KEY_FIRE (inghitituri) s-au facut din bautura curenta (0..BARDRINK_MAX_SIPS)

// Modelul obiectului atasat in mana, in functie de categoria bauturii
stock BarDrink_ModelForCategory(const category[])
{
    if(strcmp(category, "coffee", true) == 0) return 19835;
    if(strcmp(category, "wine", true) == 0)   return 1667;
    if(strcmp(category, "beer", true) == 0)   return 1486;
    if(strcmp(category, "juice", true) == 0)  return 2601;
    return BARDRINK_MODEL;
}

// Scoate obiectul din mana si reseteaza starea (fara mesaj) - folosit la respawn/deconectare
// Cafeaua: pana la COFFEE_MAX_PER_DAY pe zi (contorul pCoffee se reseteaza la 05:00). Efectul depinde de a cata cafea e:
//   1-2: oboseala -25 | 3: -20, 10% sansa sa te imbolnavesti | 4: -10, 80% sansa | 5: HP = 5 si esti bolnav sigur.
// Folosita de /getcoffee si de /drink (categoria coffee).
#define COFFEE_MAX_PER_DAY 5
stock bool:Coffee_LimitReached(playerid)
{
    if(PlayerData[playerid][pCoffee] < COFFEE_MAX_PER_DAY) return false;
    SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You've already had 5 coffees today - you can't drink any more.");
    return true;
}

stock Player_DrinkCoffee(playerid)
{
    if(PlayerData[playerid][pCoffee] >= COFFEE_MAX_PER_DAY) return;

    new n = ++PlayerData[playerid][pCoffee];
    UpdatePlayer(playerid, pCoffee);

    new cut = 0, sickChance = 0;
    if(n <= 2)       { cut = 25; }
    else if(n == 3) { cut = 20; sickChance = 10; }
    else if(n == 4) { cut = 10; sickChance = 80; }

    if(cut > 0)
    {
        if(PlayerData[playerid][pTired] < cut) cut = PlayerData[playerid][pTired];
        PlayerData[playerid][pTired] -= cut;
        UpdatePlayer(playerid, pTired);

        new cfmsg[112];
        format(cfmsg, sizeof(cfmsg), T(playerid, C_SUCCESS"[Coffee] "C_WHITE"Coffee "C_INFO"%d/5"C_WHITE": tiredness reduced by "C_INFO"%d"C_WHITE"."), n, cut);
        SCM(playerid, COLOR_SUCCESS, cfmsg);
    }

    if(n == 5)
    {
        // a cincea cafea: prea mult - HP la 5 si bolnav
        SetPlayerHealth(playerid, 5.0);
        SCM(playerid, COLOR_ERROR, C_ERROR"[Coffee] "C_WHITE"That was your 5th coffee - your heart is racing! Your health dropped to "C_INFO"5"C_WHITE".");
        if(!PlayerData[playerid][pDiseased]) Disease_Infect(playerid);
        return;
    }

    if(sickChance > 0 && random(100) < sickChance && !PlayerData[playerid][pDiseased])
    {
        SCM(playerid, COLOR_ERROR, C_ERROR"[Coffee] "C_WHITE"Too much coffee... you don't feel well.");
        Disease_Infect(playerid);
    }
}

stock BarDrink_ClearHeld(playerid)
{
    RemovePlayerAttachedObject(playerid, BARDRINK_ATTACH_INDEX);
    g_BarHoldingDrink[playerid] = false;
    g_BarDrinkSips[playerid]    = 0;
}

// O inghititura (apasare KEY_FIRE) din bautura tinuta in mana: aplica animatia + efectul (HP/betie).
// Dupa BARDRINK_MAX_SIPS inghitituri, sticla/paharul e gol - anunta playerul, scoate obiectul, opreste animatia.
stock BarDrink_Consume(playerid)
{
    if(!g_BarHoldingDrink[playerid]) return;

    g_BarDrinkSips[playerid]++;
    if(g_BarDrinkSips[playerid] >= BARDRINK_MAX_SIPS)
    {
        ClearAnimations(playerid, 1);
        BarDrink_ClearHeld(playerid);
        SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"You've already drunk that. There's nothing left.");
        return;
    }

    new idx = g_BarDrinkIndex[playerid];
    ApplyAnimation(playerid, "BAR", "BAR_DRINK1", 4.1, 0, 0, 0, 0, 0, 1);

    new Float:health;
    GetPlayerHealth(playerid, health);
    health += BarDrinkData[idx][bdHP];
    if(health > 100.0) health = 100.0;
    if(health < 1.0) health = 1.0; // o bautura nu trebuie sa poata omori playerul
    SetPlayerHealth(playerid, health);

    if(BarDrinkData[idx][bdIncDrunk])
    {
        new drunk = GetPlayerDrunkLevel(playerid);
        SetPlayerDrunkLevel(playerid, drunk + BARDRINK_DRUNK_AMOUNT);
        Pray_FlagSin(playerid, 10); // Bautura si viciul
    }

    if(strcmp(BarDrinkData[idx][bdCategory], "coffee", true) == 0)
        Player_DrinkCoffee(playerid);

    new bdmsg[96];
    format(bdmsg, sizeof(bdmsg), T(playerid, C_INFO"Info: "C_WHITE"You drink the %s. Cheers!"), BarDrinkData[idx][bdName]);
    SCM(playerid, COLOR_INFO, bdmsg);
}

// ============================================================
//  HOTELURI
// ============================================================
#define MAX_HOTELS          20
#define HOTEL_RANGE         5.0
#define HOTEL_SLEEP_PRICE   150
#define HOTEL_SLEEP_FREEZE  45  // secunde de freeze la /sleep intr-un hotel
#define HOTEL_SLEEP_TIRED   10  // oboseala ramasa dupa /sleep la hotel (nu 0, ca la patul propriu)

// ---- Chirie (rent): case/apartamente/hoteluri marcate hIsRentable/htlIsRentable de admin ----
#define RENT_SPAWN_TYPE    5     // valoarea pSpawn cand playerul alege sa se spawneze la proprietatea inchiriata
#define GOV_SPAWN_TYPE     6     // valoarea pSpawn pentru spawn-ul Guvernului (Presedinte / Prim-ministru / Vice-premier)
// Coordonate fixe, editate manual in cod (nu vin din DB).
new Float:GovSpawnLocation[4] = {1125.1689, -2036.8776, 69.8821, 97.8221};
#define RENT_FIND_RANGE    5.0   // raza pentru /renthouse, /rentappartment, /renthotel
#define HOUSE_RENT_BONUS   50    // $ suplimentari, la fiecare PayDay, in banca oricarei case inchiriate (pe langa chiria platita de chirias)
#define HOTEL_RENT_BONUS   100   // $ suplimentari, la fiecare PayDay, in banca oricarui hotel inchiriat (pe langa chiria platita de chirias)
#define HOTEL_DEFAULT_CAPACITY 5 // nr. implicit de chiriasi simultani, la un hotel nou creat

// ---- Iteme de hotel (produse de igiena personala): consumate la fiecare /sleep sau /renthotel, resupply de la un 24/7 shop ----
#define HOTEL_ITEMS_MAX            200  // capacitate maxima de stocare per hotel
#define HOTEL_ITEM_PRICE           100  // $ platiti per item cumparat la shop-ul 24/7
#define HOTEL_ITEMS_VEHICLE_MODEL  498  // Boxville - singurul vehicul cu care se pot transporta itemele
#define HOTEL_ITEMS_MAX_CARRY      100  // cate iteme poate transporta un vehicul intr-o singura cursa
#define HOTEL_ITEMS_UNLOAD_RANGE   HOTEL_RANGE

enum E_HOTEL_DATA
{
    htlID, htlName[32], htlOwnerName[24], htlOwnerId, htlOwned, htlForSale, htlPrice,
    Float:htlLocX, Float:htlLocY, Float:htlLocZ,
    htlBank,
    htlIsRentable, // 1 = poate fi inchiriat cu /renthotel (setat de admin cu /htlc rentable)
    htlRentPrice, // chiria luata de la chirias la fiecare PayDay (vezi /htlc rentprice)
    htlCapacity, // nr. maxim de chiriasi simultani (vezi /htlc capacity), default HOTEL_DEFAULT_CAPACITY
    htlRenterCount, // nr. curent de chiriasi (recalculat din `players`.`rent_hotel` la pornirea serverului)
    htlItems // iteme de igiena personala in stoc (0-HOTEL_ITEMS_MAX); scade cu 1 la fiecare /sleep sau /renthotel; la 0, hotelul nu mai incaseaza bani in seif
}
new HotelData[MAX_HOTELS][E_HOTEL_DATA];
new g_HotelPickup[MAX_HOTELS];
new Text3D:g_HotelLabel[MAX_HOTELS] = {Text3D:INVALID_3DTEXT_ID, ...};
new g_HotelCount = 0;

stock Hotels_RecreatePickup(idx)
{
    if(g_HotelPickup[idx] != -1)
    {
        DestroyPickup(g_HotelPickup[idx]);
        g_HotelPickup[idx] = -1;
    }
    g_HotelPickup[idx] = CreatePickup(HotelData[idx][htlOwned] ? 19522 : 19524, 1,
        HotelData[idx][htlLocX], HotelData[idx][htlLocY], HotelData[idx][htlLocZ], -1);

    if(g_HotelLabel[idx] != Text3D:INVALID_3DTEXT_ID)
    {
        Delete3DTextLabel(g_HotelLabel[idx]);
        g_HotelLabel[idx] = Text3D:INVALID_3DTEXT_ID;
    }

    new label[256];
    if(HotelData[idx][htlOwned])
    {
        if(HotelData[idx][htlForSale])
            format(label, sizeof(label),
                "[ Hotel #%d ]\nName: %s\nOwner: %s\n{5DA271}FOR SALE: $%s{E3E3E3}\n/buyhotel to buy it\n/sleep - $%d",
                HotelData[idx][htlID], HotelData[idx][htlName], HotelData[idx][htlOwnerName], MoneyStr(HotelData[idx][htlPrice]), HOTEL_SLEEP_PRICE);
        else
            format(label, sizeof(label),
                "[ Hotel #%d ]\nName: %s\nOwned: Yes\nOwner: %s\n/sleep - $%d",
                HotelData[idx][htlID], HotelData[idx][htlName], HotelData[idx][htlOwnerName], HOTEL_SLEEP_PRICE);
    }
    else
    {
        format(label, sizeof(label),
            "[ Hotel #%d ]\nName: %s\nOwned: No\nPrice: $%s\n/buyhotel to buy this hotel\n/sleep - $%d",
            HotelData[idx][htlID], HotelData[idx][htlName], MoneyStr(HotelData[idx][htlPrice]), HOTEL_SLEEP_PRICE);
    }
    g_HotelLabel[idx] = Create3DTextLabel(label, COLOR_WHITE,
        HotelData[idx][htlLocX], HotelData[idx][htlLocY], HotelData[idx][htlLocZ]-0.5, 20.0, 0, 0);
}

// True daca playerul e intr-o locatie unde /viphat e permis: interiorul unei case, langa un hotel, in HQ-ul propriei factiuni, sau intr-un clothing store
stock bool:VipHat_LocationAllowed(playerid)
{
    // Casa (a lui sau inchiriata): vw = un house ID valid, iar interiorul curent corespunde interiorului casei
    new hIdx = Houses_FindByID(GetPlayerVirtualWorld(playerid));
    if(hIdx != -1 && HouseData[hIdx][hInterior] != 0 && GetPlayerInterior(playerid) == HouseData[hIdx][hInterior])
        return true;

    // Hotel: langa pickup-ul oricarui hotel
    for(new h = 0; h < g_HotelCount; h++)
        if(IsPlayerInRangeOfPoint(playerid, 5.0, HotelData[h][htlLocX], HotelData[h][htlLocY], HotelData[h][htlLocZ]))
            return true;

    // HQ-ul propriei factiuni
    if(Factions_IsInOwnInterior(playerid))
        return true;

    // Clothing store: in interiorul configurat al oricarui magazin de haine
    for(new c = 0; c < g_ClothStoreDynCount; c++)
    {
        if(!ClothStore_HasInterior(c)) continue;
        if(GetPlayerVirtualWorld(playerid) != ClothStoreData[c][clstVwID]) continue;
        new csOwnIntIdx = GTAInteriors_FindByID(ClothStoreData[c][clstIntID]);
        if(GetPlayerInterior(playerid) == GTAInteriorData[csOwnIntIdx][gtaIntInterior])
            return true;
    }

    return false;
}

// Returneaza indexul (in HotelData) al hotelului cu htlID == hid, sau -1
stock Hotels_FindByID(hid)
{
    for(new i = 0; i < g_HotelCount; i++)
        if(HotelData[i][htlID] == hid) return i;
    return -1;
}

// Returneaza indexul primului hotel in raza playerului (oricare, indiferent de proprietar), sau -1
stock Hotels_FindNearby(playerid)
{
    for(new i = 0; i < g_HotelCount; i++)
        if(IsPlayerInRangeOfPoint(playerid, HOTEL_RANGE, HotelData[i][htlLocX], HotelData[i][htlLocY], HotelData[i][htlLocZ]))
            return i;
    return -1;
}

// Salveaza in DB banca unui hotel
stock Hotels_SaveBank(idx)
{
    new q[128];
    mysql_format(g_SQL, q, sizeof(q),
        "UPDATE `hotels` SET `bank`=%d WHERE `id`=%d",
        HotelData[idx][htlBank], HotelData[idx][htlID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Salveaza in DB stocul de iteme al unui hotel
stock Hotels_SaveItems(idx)
{
    new q[128];
    mysql_format(g_SQL, q, sizeof(q),
        "UPDATE `hotels` SET `items`=%d WHERE `id`=%d",
        HotelData[idx][htlItems], HotelData[idx][htlID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Consuma 1 item de igiena al hotelului (folosit la /sleep si /renthotel); nu scade sub 0
stock Hotels_ConsumeItem(idx)
{
    if(HotelData[idx][htlItems] <= 0) return;
    HotelData[idx][htlItems]--;
    Hotels_SaveItems(idx);
}

new g_HTLItemsCarrying[MAX_PLAYERS]; // cate iteme de hotel transporta jucatorul curent (0 = niciunul), cumparate cu /htlitems buy

// Returneaza playerid-ul conectat/logat cu pID == pid, sau INVALID_PLAYER_ID
stock Houses_FindPlayerByPID(pid)
{
    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pID] == pid)
            return i;
    return INVALID_PLAYER_ID;
}

// ============================================================
//  ANIMALE (pets la case de tip 1) - obiecte dinamice
// ============================================================
#define MAX_ANIMALS    200
#define ANIMAL_PRICE   5000   // pretul unui animal la /house upgrade animal (modificabil)

// Tipuri de casa (hType): 1=Vila, 2=Casa la oras, 3=Apartament, 4=Casa la tara.
// Doar "Casa la tara" (tip 4) poate cumpara animale.
#define HOUSE_TYPE_COUNTRYSIDE 4

// Scrie "Yes"/"No" in dest (evita ternarul cu literale de lungimi diferite)
stock YesNoText(cond, dest[], size = sizeof(dest))
{
    if(cond) format(dest, size, "Yes");
    else     format(dest, size, "No");
}

// Numele in engleza al tipului de casa (hType)
stock HouseTypeName(type, dest[], size = sizeof(dest))
{
    switch(type)
    {
        case 1: format(dest, size, "Villa");
        case 2: format(dest, size, "City House");
        case 3: format(dest, size, "Apartment");
        case 4: format(dest, size, "Countryside House");
        default: format(dest, size, "Unknown");
    }
}

// Catalog de animale: /house upgrade animal [nume] cauta dupa acName (case-insensitive).
// aType stocat in DB = modelul obiectului.
#define ANIMAL_COW_MODEL 19833
#define ANIMAL_COW_MILK_CHANCE_PCT 50 // sansa la payday sa primesti lapte de la vaca (daca ai una la casa)
#define ANIMAL_COW_MILK_MIN 2         // litri minimi primiti
#define ANIMAL_COW_MILK_MAX 5         // litri maximi primiti (inclusiv)
#define ANIMAL_PARROT_MODEL 19078     // singurul animal "portabil" - poate fi purtat pe umar cu /parrot get/down
enum E_ANIMAL_CATALOG { acModel, acName[32], acLifespan }
new const g_AnimalCatalog[][E_ANIMAL_CATALOG] = {
    { 1609,  "Turtle", 150 },
    { ANIMAL_COW_MODEL, "Cow", 50 },
    { 19315, "Deer", 100 },
    { ANIMAL_PARROT_MODEL, "Parrot", 80 }
};

// Returneaza indexul din g_AnimalCatalog al modelului dat, sau -1
stock AnimalCatalog_FindByModel(model)
{
    for(new c = 0; c < sizeof(g_AnimalCatalog); c++)
        if(g_AnimalCatalog[c][acModel] == model) return c;
    return -1;
}

enum E_ANIMAL_DATA
{
    aID, aType, aPlayerID, aHouseID, aName[32], aDefaultName[32],
    aAge, // numar de payday-uri "traite" (contorizat doar cand proprietarul casei e online la acel payday)
    bool:aDeceased, // 1 = a murit de batranete; ramane la casa (nu mai produce nimic, blocheaza rent-ul) pana e ridicat cu /funeral
    bool:aOnPlayer // 1 = purtat pe umarul proprietarului (doar Parrot, /parrot get/down) - NU se spawneaza la casa cat timp e 1
}
new AnimalData[MAX_ANIMALS][E_ANIMAL_DATA];
new STREAMER_TAG_OBJECT:g_AnimalObject[MAX_ANIMALS];
new g_AnimalCount = 0;

// Spawneaza obiectul (animalul) la casa lui, la coordonate usor randomizate
stock Animals_Spawn(idx)
{
    new hidx = Houses_FindByID(AnimalData[idx][aHouseID]);
    if(hidx == -1) { g_AnimalObject[idx] = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID; return; }

    new Float:x = HouseData[hidx][hLocX] + float(random(10));
    new Float:y = HouseData[hidx][hLocY] + float(random(10));
    new Float:z = HouseData[hidx][hLocZ] - 0.5;
    g_AnimalObject[idx] = CreateDynamicObject(AnimalData[idx][aType], x, y, z, 0.0, 0.0, float(random(360)));
}

// ---- Papagal de companie (Parrot): singurul animal purtabil pe umar, cu /parrot get / /parrot down ----
#define PARROT_ATTACH_INDEX 5  // diferit de BBALL(0), PARTY(1), VIPHAT(2), FISH_ROD(3), BARDRINK(4)
#define PARROT_ATTACH_BONE  16 // 16 = Right Clavicle (cel mai apropiat de umar)

new g_PlayerParrotID[MAX_PLAYERS]; // aID-ul (din houses_animals) al papagalului atasat pe umarul jucatorului, 0 = niciunul

// Offset/rotatie per-player pt. atasare (/p x/y/z/rx/ry/rz [value]) - fiecare player isi ajusteaza propriul papagal,
// nu e global ca la VIP hat (asa nu se calca playerii intre ei la reglaj)
new Float:g_ParrotOffX[MAX_PLAYERS] = {0.1,   ...};
new Float:g_ParrotOffY[MAX_PLAYERS] = {0.0,   ...};
new Float:g_ParrotOffZ[MAX_PLAYERS] = {-0.05, ...};
new Float:g_ParrotRotX[MAX_PLAYERS] = {-90.0, ...};
new Float:g_ParrotRotY[MAX_PLAYERS] = {-90.0, ...};
new Float:g_ParrotRotZ[MAX_PLAYERS] = {90.0,  ...};

// Reataseaza (SetPlayerAttachedObject) folosind offset-urile/rotatia curenta ale playerului - nu face nimic daca nu poarta papagal
stock Parrot_RefreshAttached(playerid)
{
    if(g_PlayerParrotID[playerid] == 0) return;
    new prIdx = Animals_FindByID(g_PlayerParrotID[playerid]);
    if(prIdx == -1) return;

    SetPlayerAttachedObject(playerid, PARROT_ATTACH_INDEX, AnimalData[prIdx][aType], PARROT_ATTACH_BONE,
        g_ParrotOffX[playerid], g_ParrotOffY[playerid], g_ParrotOffZ[playerid],
        g_ParrotRotX[playerid], g_ParrotRotY[playerid], g_ParrotRotZ[playerid],
        0.5, 0.5, 0.5);
}

// Ataseaza papagalul (index in AnimalData) pe umarul playerului; scoate obiectul din lume daca era spawnat la casa
stock Parrot_Attach(playerid, idx)
{
    if(IsValidDynamicObject(g_AnimalObject[idx]))
    {
        DestroyDynamicObject(g_AnimalObject[idx]);
        g_AnimalObject[idx] = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
    }
    g_PlayerParrotID[playerid] = AnimalData[idx][aID];
    Parrot_RefreshAttached(playerid);
}

// Scoate obiectul de pe umarul playerului (doar vizual - apelantul decide daca papagalul devine deceased/se respawneaza la casa)
stock Parrot_DetachObject(playerid)
{
    RemovePlayerAttachedObject(playerid, PARROT_ATTACH_INDEX);
    g_PlayerParrotID[playerid] = 0;
}

// Cauta papagalul purtat (aOnPlayer=1) al proprietarului ownerPID si il face sa reapara la casa (isOnPlayer=0, persistat in DB).
// Nu atinge obiectul atasat pe vreun player - apelantul (connect/disconnect) trebuie sa fi facut/sa faca asta separat.
// Folosit la login si la deconectare, ca papagalul sa fie mereu "la casa" cat playerul nu e efectiv conectat cu el pe umar.
stock Parrot_ForceOffByPID(ownerPID)
{
    for(new a = 0; a < g_AnimalCount; a++)
    {
        if(AnimalData[a][aPlayerID] != ownerPID) continue;
        if(AnimalData[a][aType] != ANIMAL_PARROT_MODEL) continue;
        if(!AnimalData[a][aOnPlayer]) continue;

        AnimalData[a][aOnPlayer] = false;
        if(!AnimalData[a][aDeceased]) Animals_Spawn(a);

        new pfq[96];
        mysql_format(g_SQL, pfq, sizeof(pfq), "UPDATE `houses_animals` SET `isOnPlayer`=0 WHERE `aID`=%d", AnimalData[a][aID]);
        mysql_tquery(g_SQL, pfq, "", "", 0);
        break; // un singur papagal poate fi purtat oricum
    }
}

// La fiecare payday: imbatraneste animalele VII al caror proprietar (casa) e online in acel moment.
// Daca ating durata de viata a speciei (acLifespan), mor: raman la casa (aDeceased=1), nu mai produc nimic
// si blocheaza rent-ul casei, pana sunt ridicate cu /funeral. Owner-ul (daca online) e anuntat.
// Trebuie apelat INAINTE de Animals_Load() (care oricum sterge/recreeaza toti actorii din DB la fiecare payday).
stock Animals_PayDayAge()
{
    for(new a = 0; a < g_AnimalCount; a++)
    {
        if(AnimalData[a][aDeceased]) continue; // deja mort - nu mai imbatraneste, asteapta /funeral

        new owner = Houses_FindPlayerByPID(AnimalData[a][aPlayerID]);
        if(owner == INVALID_PLAYER_ID) continue; // proprietarul nu e online -> nu conteaza acest payday

        new acIdx = AnimalCatalog_FindByModel(AnimalData[a][aType]);
        new lifespan = (acIdx != -1) ? g_AnimalCatalog[acIdx][acLifespan] : 999999;

        new newAge = AnimalData[a][aAge] + 1;
        if(newAge >= lifespan)
        {
            new q[128];
            mysql_format(g_SQL, q, sizeof(q), "UPDATE `houses_animals` SET `aAge`=%d, `aDeceased`=1 WHERE `aID`=%d", newAge, AnimalData[a][aID]);
            mysql_tquery(g_SQL, q, "", "", 0);

            new adm[144];
            format(adm, sizeof(adm), T(owner, C_ERROR"[House] "C_WHITE"Your animal "C_INFO"%s"C_WHITE" just died. RIP."), AnimalData[a][aName]);
            SCM(owner, COLOR_ERROR, adm);
        }
        else
        {
            new q[96];
            mysql_format(g_SQL, q, sizeof(q), "UPDATE `houses_animals` SET `aAge`=%d WHERE `aID`=%d", newAge, AnimalData[a][aID]);
            mysql_tquery(g_SQL, q, "", "", 0);
        }
    }
}

// True daca o casa (dupa houseId) are cel putin un animal decedat (astepta ridicare cu /funeral)
stock bool:House_HasDeceasedAnimal(houseId)
{
    for(new a = 0; a < g_AnimalCount; a++)
        if(AnimalData[a][aHouseID] == houseId && AnimalData[a][aDeceased]) return true;
    return false;
}

// ---- FUNERAL: pornire cursa (trebuie sa fii la volanul unui Romero, casa ta sa aiba un animal decedat) ----
stock Funeral_Start(playerid)
{
    if(g_FuneralState[playerid] != FUNERAL_STATE_NONE)
    {
        SCM(playerid, COLOR_ERROR, C_ERROR"[Funeral] "C_WHITE"You already have a funeral run in progress.");
        return;
    }

    new veh = GetPlayerVehicleID(playerid);
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || !Funeral_IsVehicle(veh))
    {
        SCM(playerid, COLOR_ERROR, C_ERROR"[Funeral] "C_WHITE"You must be driving a Romero (see the church).");
        return;
    }

    if(PlayerData[playerid][pHouse] == 0)
    {
        SCM(playerid, COLOR_ERROR, C_ERROR"[Funeral] "C_WHITE"You don't own a house.");
        return;
    }

    if(!House_HasDeceasedAnimal(PlayerData[playerid][pHouse]))
    {
        SCM(playerid, COLOR_ERROR, C_ERROR"[Funeral] "C_WHITE"You don't have a deceased animal to bury.");
        return;
    }

    if(PlayerData[playerid][pMoney] < FUNERAL_PRICE)
    {
        SCM(playerid, COLOR_ERROR, C_ERROR"[Funeral] "C_WHITE"You don't have enough money to rent the Romero.");
        return;
    }

    new hidx = Houses_FindByID(PlayerData[playerid][pHouse]);
    if(hidx == -1) return;

    PlayerData[playerid][pMoney] -= FUNERAL_PRICE;
    GivePlayerMoney(playerid, -FUNERAL_PRICE);
    UpdatePlayer(playerid, pMoney);

    g_FuneralState[playerid]   = FUNERAL_STATE_TOHOUSE;
    g_FuneralVehicle[playerid] = veh;
    g_FuneralAnimalId[playerid] = -1;
    Track_SetPlayerCheckpoint(playerid, HouseData[hidx][hLocX], HouseData[hidx][hLocY], HouseData[hidx][hLocZ], FUNERAL_CP_SIZE);

    SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Funeral] "C_WHITE"You rented the Romero. Drive to your house to load the deceased animal.");
}

// Opreste/anuleaza cursa curenta (fara mesaj - apelantul anunta), fara nicio rambursare
stock Funeral_Cancel(playerid)
{
    if(g_FuneralState[playerid] == FUNERAL_STATE_NONE) return;
    g_FuneralState[playerid]    = FUNERAL_STATE_NONE;
    g_FuneralAnimalId[playerid] = -1;
    g_FuneralVehicle[playerid]  = -1;
    DisablePlayerCheckpoint(playerid);
    if(g_FuneralReturnTimer[playerid] != -1)
    {
        KillTimer(g_FuneralReturnTimer[playerid]);
        g_FuneralReturnTimer[playerid] = -1;
    }
}

// Checkpoint-ul de la casa a fost atins: arata dialogul cu animalele casei (doar cel decedat poate fi ales)
stock Funeral_EnterHouse(playerid)
{
    DisablePlayerCheckpoint(playerid);

    new hid = PlayerData[playerid][pHouse];
    g_FuneralDialogCount[playerid] = 0;

    static list[1024];
    list[0] = EOS;
    strcat(list, T(playerid, ""C_INFO"Animal\t"C_INFO"Status\n"));
    for(new a = 0; a < g_AnimalCount && g_FuneralDialogCount[playerid] < MAX_FUNERAL_DIALOG_ROWS; a++)
    {
        if(AnimalData[a][aHouseID] != hid) continue;

        new row = g_FuneralDialogCount[playerid];
        g_FuneralDialogAnimal[playerid][row] = a;
        g_FuneralDialogCount[playerid]++;

        new fline[96];
        format(fline, sizeof(fline), ""C_WHITE"%s\t%s\n", AnimalData[a][aName],
            AnimalData[a][aDeceased] ? (""C_ERROR"Deceased") : (""C_SUCCESS"Alive"));
        strcat(list, fline);
    }

    SPD(playerid, DIALOG_FUNERAL_ANIMALS, DIALOG_STYLE_TABLIST_HEADERS, "Choose the animal to bury", list, "Select", "Cancel");
}

// Dupa alegerea corecta (animal decedat): freeze 3s, apoi checkpoint la capela
forward Funeral_Loaded(playerid);
public Funeral_Loaded(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(g_FuneralState[playerid] != FUNERAL_STATE_TOHOUSE) return 0;
    TogglePlayerControllable(playerid, 1);

    g_FuneralState[playerid] = FUNERAL_STATE_TOCHURCH;
    Track_SetPlayerCheckpoint(playerid, FUNERAL_CHURCH_X, FUNERAL_CHURCH_Y, FUNERAL_CHURCH_Z, FUNERAL_CP_SIZE);
    SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Funeral] "C_WHITE"Loaded. Drive to the church to bury it.");
    return 1;
}

// Checkpoint-ul de la capela a fost atins: freeze 3s, apoi sterge animalul, plateste rambursarea
stock Funeral_EnterChurch(playerid)
{
    DisablePlayerCheckpoint(playerid);
    TogglePlayerControllable(playerid, 0);
    GTP(playerid, "~w~Unloading...", FUNERAL_UNLOAD_FREEZE_MS, 3);
    SetTimerEx("Funeral_Unloaded", FUNERAL_UNLOAD_FREEZE_MS, false, "i", playerid);
}

forward Funeral_Unloaded(playerid);
public Funeral_Unloaded(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(g_FuneralState[playerid] != FUNERAL_STATE_TOCHURCH) return 0;
    TogglePlayerControllable(playerid, 1);

    new animIdx = g_FuneralAnimalId[playerid];
    if(animIdx != -1)
    {
        for(new a = 0; a < g_AnimalCount; a++)
        {
            if(AnimalData[a][aID] != animIdx) continue;
            if(IsValidDynamicObject(g_AnimalObject[a])) DestroyDynamicObject(g_AnimalObject[a]);
            break;
        }
        new q[64];
        mysql_format(g_SQL, q, sizeof(q), "DELETE FROM `houses_animals` WHERE `aID`=%d", animIdx);
        mysql_tquery(g_SQL, q, "", "", 0);
        Animals_Load(); // resincronizeaza lista/actorii dupa stergere
    }

    new veh = GetPlayerVehicleID(playerid);
    RemovePlayerFromVehicle(playerid);
    if(veh != 0) SetVehicleToRespawn(veh);

    PlayerData[playerid][pMoney] += FUNERAL_REFUND;
    GivePlayerMoney(playerid, FUNERAL_REFUND);
    UpdatePlayer(playerid, pMoney);

    new fmsg[144];
    format(fmsg, sizeof(fmsg), T(playerid, C_SUCCESS"[Funeral] "C_WHITE"Buried with dignity. You got "C_INFO"$%s"C_WHITE" back."), MoneyStr(FUNERAL_REFUND));
    SCM(playerid, COLOR_SUCCESS, fmsg);

    g_FuneralState[playerid]    = FUNERAL_STATE_NONE;
    g_FuneralAnimalId[playerid] = -1;
    g_FuneralVehicle[playerid]  = -1;
    return 1;
}

forward Funeral_ReturnTimeout(playerid);
public Funeral_ReturnTimeout(playerid)
{
    g_FuneralReturnTimer[playerid] = -1;
    if(g_FuneralState[playerid] == FUNERAL_STATE_NONE) return 1;

    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && GetPlayerVehicleID(playerid) == g_FuneralVehicle[playerid])
        return 1;

    Funeral_Cancel(playerid);
    SCM(playerid, COLOR_ERROR, C_ERROR"[Funeral] "C_WHITE"You didn't return to the Romero in time. The run was cancelled.");
    return 1;
}

// Apelat din OnPlayerStateChange cand starea/vehiculul playerului cu o cursa activa se schimba
stock Funeral_HandleStateChange(playerid)
{
    if(g_FuneralState[playerid] == FUNERAL_STATE_NONE) return;

    new bool:inFuneralVeh = (GetPlayerState(playerid) == PLAYER_STATE_DRIVER &&
                             GetPlayerVehicleID(playerid) == g_FuneralVehicle[playerid]);

    if(inFuneralVeh)
    {
        if(g_FuneralReturnTimer[playerid] != -1)
        {
            KillTimer(g_FuneralReturnTimer[playerid]);
            g_FuneralReturnTimer[playerid] = -1;
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Funeral] "C_WHITE"Welcome back. Keep going!");
        }
    }
    else
    {
        if(g_FuneralReturnTimer[playerid] == -1)
        {
            g_FuneralReturnTimer[playerid] = SetTimerEx("Funeral_ReturnTimeout", FUNERAL_RETURN_GRACE * 1000, false, "i", playerid);
            new wmsg[144];
            format(wmsg, sizeof(wmsg), T(playerid, C_ERROR"[Funeral] "C_WHITE"You left the Romero. Return within "C_INFO"%d seconds"C_WHITE" or the run is cancelled."), FUNERAL_RETURN_GRACE);
            SCM(playerid, COLOR_ERROR, wmsg);
        }
    }
}

// True daca o casa (dupa houseId) are cel putin o vaca VIE printre animalele ei
stock bool:House_HasCow(houseId)
{
    for(new a = 0; a < g_AnimalCount; a++)
        if(AnimalData[a][aHouseID] == houseId && AnimalData[a][aType] == ANIMAL_COW_MODEL && !AnimalData[a][aDeceased]) return true;
    return false;
}

// True daca acest tip de casa (houseType) poate avea un copac: City House (2) sau Countryside (4)
stock bool:House_CanHaveTree(houseType)
{
    return (houseType == 2 || houseType == HOUSE_TYPE_COUNTRYSIDE);
}

// True daca acest tip de casa (houseType) poate cumpara animalul de la indexul acIdx din g_AnimalCatalog:
// Cow - doar Countryside (4); Parrot - orice tip de casa; restul (Turtle, Deer) - doar Villa (1)
stock bool:House_CanHaveAnimal(houseType, acIdx)
{
    if(g_AnimalCatalog[acIdx][acModel] == ANIMAL_COW_MODEL) return houseType == HOUSE_TYPE_COUNTRYSIDE;
    if(g_AnimalCatalog[acIdx][acModel] == ANIMAL_PARROT_MODEL) return true;
    return houseType == 1;
}

// Insereaza efectiv animalul acIdx pentru casa hidx a playerului si reincarca lista de animale.
// NU scade banii (apelantul trebuie sa fi facut asta deja - la /house upgrade banii se iau la comanda, nu la livrare;
// la Pet Store se iau la momentul cumpararii) si nu valideaza nimic altceva (tip casa/limita). Folosit de amandoua.
stock Animal_Purchase(playerid, acIdx, hidx)
{
    new bool:acOnPlayer = (g_AnimalCatalog[acIdx][acModel] == ANIMAL_PARROT_MODEL); // papagalul incepe direct pe umar, nu la casa

    new aq[300];
    mysql_format(g_SQL, aq, sizeof(aq),
        "INSERT INTO `houses_animals` (`aType`,`aPlayerID`,`aHouseID`,`aName`,`aDefaultName`,`isOnPlayer`) VALUES (%d,%d,%d,'%e','%e',%d)",
        g_AnimalCatalog[acIdx][acModel], PlayerData[playerid][pID], HouseData[hidx][hID], g_AnimalCatalog[acIdx][acName], g_AnimalCatalog[acIdx][acName], _:acOnPlayer);
    mysql_tquery(g_SQL, aq, "", "", 0);

    // Reincarca toate animalele din DB (recreeaza si obiectele; papagalii aOnPlayer se reataseaza automat pe proprietarul online) - include si noul animal
    Animals_Load();

    new amsg[144];
    format(amsg, sizeof(amsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You bought a "C_INFO"%s"C_WHITE" for "C_INFO"$%s"C_WHITE". %s"),
        g_AnimalCatalog[acIdx][acName], MoneyStr(ANIMAL_PRICE), acOnPlayer ? ("It hops onto your shoulder.") : ("It will appear at your house."));
    SCM(playerid, COLOR_SUCCESS, amsg);
}

// Alege random un apartament (hType==3) detinut, fara o problema deja activa, si ii da una noua (hIssue 1-3)
// Apelat la fiecare payday, la ora HOUSE_ISSUE_HOUR. Proprietarul nu se mai poate respawna la acel apartament
// pana repara un Electrician cu /fixapartament.
stock House_PickIssue()
{
    new pool[MAX_HOUSES], poolCount = 0;
    for(new h = 0; h < g_HouseCount; h++)
        if(HouseData[h][hType] == 3 && HouseData[h][hOwned] && HouseData[h][hIssue] == 0)
            pool[poolCount++] = h;
    if(poolCount == 0) return;

    new hidx = pool[random(poolCount)];
    HouseData[hidx][hIssue] = 1 + random(HOUSE_ISSUE_COUNT);

    new q[128];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `houses` SET `issue`=%d WHERE `id`=%d", HouseData[hidx][hIssue], HouseData[hidx][hID]);
    mysql_tquery(g_SQL, q, "", "", 0);

    new ownerPid = Houses_FindPlayerByPID(HouseData[hidx][hOwnerId]);
    if(ownerPid != INVALID_PLAYER_ID)
    {
        new himsg[192];
        format(himsg, sizeof(himsg), T(ownerPid, "[Apartment] %s at %s. You can't spawn there until an Electrician fixes it (/fixapartament)."),
            g_HouseIssueName[HouseData[hidx][hIssue]], HouseData[hidx][hName]);
        SCM(ownerPid, COLOR_ERROR, himsg);
    }
}

// Distruge toate obiectele-animale din lume si reseteaza contorul (datele din DB raman intacte)
stock Animals_DestroyAll()
{
    for(new i = 0; i < g_AnimalCount; i++)
    {
        if(IsValidDynamicObject(g_AnimalObject[i]))
            DestroyDynamicObject(g_AnimalObject[i]);
        g_AnimalObject[i] = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
    }
    g_AnimalCount = 0;
}

// Cauta indexul (in AnimalData) al unui animal dupa aID, sau -1
stock Animals_FindByID(id)
{
    for(new i = 0; i < g_AnimalCount; i++)
        if(AnimalData[i][aID] == id) return i;
    return -1;
}

// ============================================================
//  COPACI FRUCTIFERI (/houseupgrade tree, /tree plant, /tree collect)
// ============================================================
#define MAX_TREES              MAX_HOUSES  // maxim un copac per casa
#define TREE_MODEL             738
#define TREE_PRICE             20000  // pretul la /houseupgrade tree
#define TREE_PLANT_TIME        5      // secunde de freeze la /tree plant (trebuie sa tii o lopata, WEAPON_SHOVEL)
#define TREE_GROWTH_MAX        30     // treeFruitStatus nu creste peste aceasta valoare
#define TREE_GROWTH_RIPE_MIN   12     // sub asta, fructele inca nu sunt coapte
#define TREE_GROWTH_RIPE_MAX   20     // 12-20: recolta random(8-11) banane
#define TREE_HARVEST_FULL_MIN  8      // banane primite intre TREE_GROWTH_RIPE_MIN si _MAX
#define TREE_HARVEST_FULL_MAX  11
#define TREE_HARVEST_SPOILED_MIN 1    // peste _MAX si sub _GROWTH_MAX: random(1-3) banane (restul stricate)
#define TREE_HARVEST_SPOILED_MAX 3

// ---- Unealta Shovel (/shop), necesara pentru /tree plant ----
new g_ShovelPrice = 2500; // default, suprascris din payday_setup.shovel_price
new g_FishingRodPrice = 300; // undita (/shop, Tools Shop) - item unic, nu se cumuleaza
new g_ChainsawPrice = 1500; // drujba (/shop, Tools Shop) - arma reala (WEAPON_CHAINSAW), ca la Shovel

// ---- Saci SGR (/bin, /sellsgr): doar level <=5. Sacul + continutul se pierd la moarte/respawn/deconectare. ----
#define SGR_BAG_LEVEL_MAX   5
#define BAG_TYPE_NONE       0
#define BAG_TYPE_SMALL      1
#define BAG_TYPE_MEDIUM     2
#define BAG_TYPE_LARGE      3
new const g_BagCapacity[4] = {0, 50, 100, 150};
new g_BagPrice[4]    = {0, 10, 30, 70}; // defaults, suprascrise din server_setup.bag_price_small/medium/large
new const g_BagName[4][16] = {"None", "Small Bag", "Medium Bag", "Large Bag"};

new g_PlayerBagType[MAX_PLAYERS]; // BAG_TYPE_NONE/SMALL/MEDIUM/LARGE
new g_PlayerBagSGR[MAX_PLAYERS];  // cate SGR-uri are strinse in sac chiar acum

#define BIN_SEARCH_RANGE    5.0
#define BIN_FIND_MIN        5   // minim SGR-uri gasite per /bin
#define BIN_FIND_MAX        15  // maxim SGR-uri gasite per /bin
#define BIN_PAYDAY_REFILL_MAX 20 // maxim SGR-uri adaugate random per tomberon, la fiecare payday (0-20)

enum E_TREE_DATA
{
    treeID, treeHouseId, treeType, treeName[32],
    treePlantedDate, // gettime() la /tree plant (0 = inca neplantat)
    treeFruitStatus, // 0-30, creste cu 1 la fiecare payday cat timp e plantat
    Float:treeLocX, Float:treeLocY, Float:treeLocZ
}
new TreeData[MAX_TREES][E_TREE_DATA];
new STREAMER_TAG_OBJECT:g_TreeObject[MAX_TREES];
new g_TreeCount = 0;
new bool:g_TreePlanting[MAX_PLAYERS]; // true cat timp jucatorul e in cele TREE_PLANT_TIME secunde de freeze la /tree plant
new g_TreePlantTreeIdx[MAX_PLAYERS];  // indexul (in TreeData) copacului care se planteaza

// Cauta un copac dupa treeID (dupa hTreeId din HouseData), returneaza indexul in TreeData sau -1
stock Trees_FindByID(id)
{
    for(new t = 0; t < g_TreeCount; t++)
        if(TreeData[t][treeID] == id) return t;
    return -1;
}

// Spawneaza obiectul unui copac deja plantat (treePlantedDate > 0)
stock Trees_Spawn(idx)
{
    if(TreeData[idx][treePlantedDate] == 0) { g_TreeObject[idx] = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID; return; }
    g_TreeObject[idx] = CreateDynamicObject(TREE_MODEL,
        TreeData[idx][treeLocX], TreeData[idx][treeLocY], TreeData[idx][treeLocZ], 0.0, 0.0, float(random(360)));
}

// Salveaza in DB plantarea unui copac (loc + data + status pornesc de la 0)
stock Trees_SavePlant(idx)
{
    new q[220];
    mysql_format(g_SQL, q, sizeof(q),
        "UPDATE `houses_tree` SET `treePlantedDate`=%d, `treeFruitStatus`=%d, `treeLocX`=%.4f, `treeLocY`=%.4f, `treeLocZ`=%.4f WHERE `treeId`=%d",
        TreeData[idx][treePlantedDate], TreeData[idx][treeFruitStatus],
        TreeData[idx][treeLocX], TreeData[idx][treeLocY], TreeData[idx][treeLocZ], TreeData[idx][treeID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Salveaza in DB doar treeFruitStatus (crestere la payday / reset dupa recolta stricata)
stock Trees_SaveStatus(idx)
{
    new q[128];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `houses_tree` SET `treeFruitStatus`=%d WHERE `treeId`=%d",
        TreeData[idx][treeFruitStatus], TreeData[idx][treeID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Distruge toate obiectele-copac din lume si reseteaza contorul (datele din DB raman intacte)
stock Trees_DestroyAll()
{
    for(new i = 0; i < g_TreeCount; i++)
    {
        if(IsValidDynamicObject(g_TreeObject[i]))
            DestroyDynamicObject(g_TreeObject[i]);
        g_TreeObject[i] = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
    }
    g_TreeCount = 0;
}

stock Trees_Load()
{
    mysql_tquery(g_SQL,
        "SELECT `treeId`,`treeHouseId`,`treeType`,`treeName`,`treePlantedDate`,`treeFruitStatus`,`treeLocX`,`treeLocY`,`treeLocZ` FROM `houses_tree` ORDER BY `treeId` ASC",
        "OnTreesLoaded");
}

public OnTreesLoaded()
{
    Trees_DestroyAll();

    new rows = cache_num_rows();
    for(new i = 0; i < rows && g_TreeCount < MAX_TREES; i++)
    {
        new idx = g_TreeCount;
        cache_get_value_name_int  (i, "treeId",          TreeData[idx][treeID]);
        cache_get_value_name_int  (i, "treeHouseId",     TreeData[idx][treeHouseId]);
        cache_get_value_name_int  (i, "treeType",        TreeData[idx][treeType]);
        cache_get_value_name      (i, "treeName",        TreeData[idx][treeName], 32);
        cache_get_value_name_int  (i, "treePlantedDate", TreeData[idx][treePlantedDate]);
        cache_get_value_name_int  (i, "treeFruitStatus", TreeData[idx][treeFruitStatus]);
        cache_get_value_name_float(i, "treeLocX", TreeData[idx][treeLocX]);
        cache_get_value_name_float(i, "treeLocY", TreeData[idx][treeLocY]);
        cache_get_value_name_float(i, "treeLocZ", TreeData[idx][treeLocZ]);
        g_TreeObject[idx] = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
        Trees_Spawn(idx);
        g_TreeCount++;
    }
    printf("[Load] Copaci: %d", g_TreeCount);
    return 1;
}

// Se ruleaza la fiecare PayDay: creste treeFruitStatus cu 1 (plafonat la TREE_GROWTH_MAX) pt. toti copacii plantati
stock Trees_PayDayGrow()
{
    for(new t = 0; t < g_TreeCount; t++)
    {
        if(TreeData[t][treePlantedDate] == 0) continue; // inca neplantat
        if(TreeData[t][treeFruitStatus] >= TREE_GROWTH_MAX) continue;
        TreeData[t][treeFruitStatus]++;
        Trees_SaveStatus(t);
    }
}

// Se termina cele TREE_PLANT_TIME secunde de freeze de la /tree plant: planteaza efectiv copacul
public Tree_PlantFinish(playerid)
{
    g_TreePlanting[playerid] = false;
    if(!IsPlayerConnected(playerid)) return 1;
    TogglePlayerControllable(playerid, 1);

    new tidx = g_TreePlantTreeIdx[playerid];
    if(tidx < 0 || tidx >= g_TreeCount) return 1;
    if(TreeData[tidx][treePlantedDate] != 0) return 1; // deja plantat intre timp (siguranta)

    new Float:tpx, Float:tpy, Float:tpz;
    GetPlayerPos(playerid, tpx, tpy, tpz);

    TreeData[tidx][treePlantedDate] = gettime();
    TreeData[tidx][treeFruitStatus] = 0;
    TreeData[tidx][treeLocX] = tpx;
    TreeData[tidx][treeLocY] = tpy;
    TreeData[tidx][treeLocZ] = tpz - 0.5;
    Trees_Spawn(tidx);
    Trees_SavePlant(tidx);

    SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"You planted your tree. It will start bearing fruit over time.");
    Pray_ClearSin(playerid, 4); // Anti-natura - a plantat un copac
    Quest_AddProgress(playerid, QUEST_ACTION_PLANT, 1);
    return 1;
}

// Callback dupa INSERT INTO trees (la /houseupgrade tree) - leaga noul copac de casa
public OnTreeUpgradeBought(playerid, hidx)
{
    if(g_TreeCount >= MAX_TREES) return 1; // limita atinsa intre timp (foarte improbabil)

    new idx = g_TreeCount;
    TreeData[idx][treeID]          = cache_insert_id();
    TreeData[idx][treeHouseId]     = HouseData[hidx][hID];
    TreeData[idx][treeType]        = TREE_MODEL;
    format(TreeData[idx][treeName], 32, "Tree");
    TreeData[idx][treePlantedDate] = 0;
    TreeData[idx][treeFruitStatus] = 0;
    TreeData[idx][treeLocX]        = 0.0;
    TreeData[idx][treeLocY]        = 0.0;
    TreeData[idx][treeLocZ]        = 0.0;
    g_TreeObject[idx] = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
    g_TreeCount++;

    HouseData[hidx][hTreeId] = TreeData[idx][treeID];
    new q[128];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `houses` SET `tree_id`=%d WHERE `id`=%d", TreeData[idx][treeID], HouseData[hidx][hID]);
    mysql_tquery(g_SQL, q, "", "", 0);

    if(IsPlayerConnected(playerid))
        SCM(playerid, COLOR_SUCCESS,
            "Success: This house can now have a tree. Use /tree plant while holding a Shovel to plant it (takes 5 seconds).");
    return 1;
}

// ============================================================
//  ATM-URI (bancomate)
// ============================================================
#define MAX_ATMS            100
#define ATM_RANGE           5.0
#define ATM_PICKUP_MODEL    1212
#define ATM_MAX_TRANSACTION 100000  // maxim per /deposit sau /withdraw
#define ATM_MIN_TRANSACTION 100     // minim per /deposit sau /withdraw
#define ATM_DEPOSIT_BASE    40      // taxa fixa la depunere
#define ATM_WITHDRAW_BASE   60      // taxa fixa la retragere
#define ATM_BANK_BIZ_A      19      // banca 1 (business)
#define ATM_BANK_BIZ_B      20      // banca 2 (business)

enum E_ATM_DATA
{
    atmID, atmType,
    Float:atmX, Float:atmY, Float:atmZ,
    atmBankOwner // id-ul business-ului-banca cel mai apropiat
}
new ATMData[MAX_ATMS][E_ATM_DATA];
new g_AtmPickup[MAX_ATMS];
new Text3D:g_AtmLabel[MAX_ATMS] = {Text3D:INVALID_3DTEXT_ID, ...};
new g_AtmCount = 0;

// ---- Benzinarii (tabelul fuelStations din DB) ----
#define MAX_FUEL_STATIONS 50
#define FUEL_PRICE_PER_PCT   5       // $ pentru fiecare 1% realimentat la /refuel (si per litru la /fillgascan)

enum E_FUELSTATION_DATA
{
    fsID,
    fsName[32],
    Float:fsX, Float:fsY, Float:fsZ,
    fsLevelCurr, fsLevelMax
}
new FuelStationData[MAX_FUEL_STATIONS][E_FUELSTATION_DATA];
new Text3D:g_FuelStationLabel[MAX_FUEL_STATIONS] = {Text3D:INVALID_3DTEXT_ID, ...};
new g_FuelStationPickup[MAX_FUEL_STATIONS];
new g_FuelStationCount = 0;

// Creeaza pickup-ul + eticheta 3D a unei benzinarii (eticheta vizibila la range 10.0)
stock FuelStation_Create(idx)
{
    if(g_FuelStationPickup[idx] != -1) { DestroyPickup(g_FuelStationPickup[idx]); g_FuelStationPickup[idx] = -1; }
    g_FuelStationPickup[idx] = CreatePickup(1239, 1, FuelStationData[idx][fsX], FuelStationData[idx][fsY], FuelStationData[idx][fsZ], -1);

    if(g_FuelStationLabel[idx] != Text3D:INVALID_3DTEXT_ID)
    {
        Delete3DTextLabel(g_FuelStationLabel[idx]);
        g_FuelStationLabel[idx] = Text3D:INVALID_3DTEXT_ID;
    }
    new label[150];
    format(label, sizeof(label), "[ Gas Station #%d ]\n[ %s ]\n[ Status: %d L / %d L ]\n[ Type /refuel or /fillgascan ]\n[ Price: %d$ / liter ]",
        FuelStationData[idx][fsID], FuelStationData[idx][fsName], FuelStationData[idx][fsLevelCurr], FuelStationData[idx][fsLevelMax], FUEL_PRICE_PER_PCT);
    g_FuelStationLabel[idx] = Create3DTextLabel(label, COLOR_WHITE,
        FuelStationData[idx][fsX], FuelStationData[idx][fsY], FuelStationData[idx][fsZ], 10.0, 0, 0);
}

// ---- BIN (tomberoane de gunoi public, colectate de sistemul SGR - vezi Bins_Load) ----
#define MAX_BINS 50
enum E_BIN_DATA
{
    binID, binType, binStatusCurrent, binStatusMax,
    Float:binX, Float:binY, Float:binZ
}
new BinData[MAX_BINS][E_BIN_DATA];
new Text3D:g_BinLabel[MAX_BINS] = {Text3D:INVALID_3DTEXT_ID, ...};
new g_BinCount = 0;

// Creeaza eticheta 3D pentru un tomberon
stock Bin_Create(idx)
{
    if(g_BinLabel[idx] != Text3D:INVALID_3DTEXT_ID)
    {
        Delete3DTextLabel(g_BinLabel[idx]);
        g_BinLabel[idx] = Text3D:INVALID_3DTEXT_ID;
    }
    new label[64];
    format(label, sizeof(label), "[ Bin #%d ]\n[ Type /bin ]", BinData[idx][binID]);
    g_BinLabel[idx] = Create3DTextLabel(label, COLOR_WHITE, BinData[idx][binX], BinData[idx][binY], BinData[idx][binZ] - 0.5, 15.0, 0, 0);
}

// Returneaza indexul tomberonului cu binID dat (sau -1)
stock Bin_FindByID(id)
{
    for(new i = 0; i < g_BinCount; i++)
        if(BinData[i][binID] == id)
            return i;
    return -1;
}

// ---- MARKET (locuri de parcare pentru vehiculele personale puse la vanzare - vezi Markets_Load) ----
#define MAX_MARKET_SLOTS 50
enum E_MARKET_DATA
{
    mktID, Float:mktX, Float:mktY, Float:mktZ, Float:mktRotation,
    mktStatus,    // 0 = liber, 1 = ocupat
    mktPID,       // players.id al celui care a pus vehiculul la vanzare (0 = niciunul / loc liber)
    mktVID,       // vehicles_personal.id al vehiculului pus la vanzare pe acest slot (0 = niciunul / loc liber)
    mktDate       // data (unix) cand vehiculul a fost pus la vanzare (0 = niciuna / loc liber); coloana DB `date` e de tip DATE
}
new MarketData[MAX_MARKET_SLOTS][E_MARKET_DATA];
new Text3D:g_MarketLabel[MAX_MARKET_SLOTS] = {Text3D:INVALID_3DTEXT_ID, ...};
new g_MarketCount = 0;

// Creeaza eticheta 3D pentru un loc de parcare Market - doar cand e liber ("Empty slot").
// Cand e ocupat nu afiseaza nimic (masina parcata isi are deja propria eticheta "FOR SALE" - PVehicles_RecreateLabel).
stock Market_Create(idx)
{
    if(g_MarketLabel[idx] != Text3D:INVALID_3DTEXT_ID)
    {
        Delete3DTextLabel(g_MarketLabel[idx]);
        g_MarketLabel[idx] = Text3D:INVALID_3DTEXT_ID;
    }
    if(MarketData[idx][mktStatus] == 1) return; // ocupat -> nicio eticheta

    new label[32];
    format(label, sizeof(label), "[ Market #%d ]\nEmpty slot", MarketData[idx][mktID]);
    g_MarketLabel[idx] = Create3DTextLabel(label, COLOR_WHITE, MarketData[idx][mktX], MarketData[idx][mktY], MarketData[idx][mktZ] + 0.5, 15.0, 0, 0);
}

// Returneaza indexul locului de parcare cu mktID dat (sau -1)
stock Market_FindByID(id)
{
    for(new i = 0; i < g_MarketCount; i++)
        if(MarketData[i][mktID] == id)
            return i;
    return -1;
}

// Returneaza indexul primului loc liber (mktStatus=0) din market (sau -1 daca toate sunt ocupate)
stock Market_FindFreeSlot()
{
    for(new i = 0; i < g_MarketCount; i++)
        if(MarketData[i][mktStatus] == 0)
            return i;
    return -1;
}

// ---- Punctul de predare (/v sell trebuie folosit aici, in vehicul, ca sa fie parcat automat in market) ----
new Float:MARKET_SELL_X = 0.0;   // suprascris din locations_admin (locID 56, "Market")
new Float:MARKET_SELL_Y = 0.0;
new Float:MARKET_SELL_Z = 0.0;
#define MARKET_SELL_RANGE      5.0
#define MARKET_SELL_PICKUP     2485
#define MARKET_SELL_MAX_DIRTY  50    // sub acest procent de murdarie
#define MARKET_SELL_MIN_FUEL   50.0  // peste acest nivel de motorina (%)

// Creeaza pickup-ul + eticheta 3D la punctul de predare a masinilor pentru Market
stock Market_CreateSellPoint()
{
    CreatePickup(MARKET_SELL_PICKUP, 1, MARKET_SELL_X, MARKET_SELL_Y, MARKET_SELL_Z, -1);
    Create3DTextLabel("[ Vehicle Market ]\n[ Use /v sell [price] in your vehicle ]", COLOR_WHITE,
        MARKET_SELL_X, MARKET_SELL_Y, MARKET_SELL_Z + 0.5, 15.0, 0, 0);
}

// Creeaza pickup-ul + eticheta 3D pentru un ATM
stock ATM_Create(idx)
{
    new Float:z = ATMData[idx][atmZ] - 0.3;

    if(g_AtmPickup[idx] != -1) { DestroyPickup(g_AtmPickup[idx]); g_AtmPickup[idx] = -1; }
    g_AtmPickup[idx] = CreatePickup(ATM_PICKUP_MODEL, 1, ATMData[idx][atmX], ATMData[idx][atmY], z, -1);

    if(g_AtmLabel[idx] != Text3D:INVALID_3DTEXT_ID)
    {
        Delete3DTextLabel(g_AtmLabel[idx]);
        g_AtmLabel[idx] = Text3D:INVALID_3DTEXT_ID;
    }
    new label[160];
    format(label, sizeof(label), "[ ATM #%d ]\n[ /deposit <suma> ]\n[ /withdraw <suma> ]", ATMData[idx][atmID]);
    g_AtmLabel[idx] = Create3DTextLabel(label, COLOR_WHITE, ATMData[idx][atmX], ATMData[idx][atmY], z-0.5, 25.0, 0, 0);
}

// Returneaza indexul celui mai apropiat ATM in raza ATM_RANGE (sau -1)
stock ATM_FindNearbyIndex(playerid)
{
    for(new i = 0; i < g_AtmCount; i++)
        if(IsPlayerInRangeOfPoint(playerid, ATM_RANGE, ATMData[i][atmX], ATMData[i][atmY], ATMData[i][atmZ]))
            return i;
    return -1;
}

// Returneaza indexul ATM-ului cu atmID dat (sau -1)
stock ATM_FindByID(id)
{
    for(new i = 0; i < g_AtmCount; i++)
        if(ATMData[i][atmID] == id) return i;
    return -1;
}
// ATM_NearestBank() e definit mai jos, dupa structurile de business (depinde de BusinessData)

// ============================================================
//  BUSINESS-URI PERSONALE
// ============================================================
#define MAX_BUSINESSES          50
#define BUSINESS_RANGE          5.0

enum E_BUSINESS_DATA
{
    bID, bName[32], bOwned, bOwnerName[24], bOwnerId, bForSale, bPrice, bBank,
    bDefaultPrice, // pretul initial, setat la /bcreate; folosit DOAR pentru calculul taxei de la PayDay (nu pentru buy/sell, acolo se foloseste bPrice)
    Float:bLocX, Float:bLocY, Float:bLocZ,
    bANAF,         // 1 = blocat de ANAF, nu mai intra bani in el (vezi Job_AddBizIncome)
    bANAFDocsSent, // 1 = proprietarul a dus actele la ANAF; se deblocheaza la urmatorul payday
    bCoffeMaker,     // 1 = business-ul are aparat de cafea, cumparat din Electronics Shop si livrat cu checkpoint (implicit 0)
    bCoffeMaker_Exp  // implicit 20; devine 50 la livrarea aparatului (vezi BizCoffee_Complete)
}
new BusinessData[MAX_BUSINESSES][E_BUSINESS_DATA];
new g_BusinessPickup[MAX_BUSINESSES];
new Text3D:g_BusinessLabel[MAX_BUSINESSES] = {Text3D:INVALID_3DTEXT_ID, ...};
new g_BusinessCount = 0;

// ---- ANAF (control fiscal): la fiecare payday de la ora 12:00, un business random e blocat ----
#define ANAF_PICKUP_MODEL       1272
#define ANAF_DOCS_VEHICLE_MODEL 428    // vehiculul cu care trebuie dus actele (/biz getdocs)
#define ANAF_RANGE              8.0    // raza fata de ANAF pentru /biz givedocs
new Float:g_AnafX, Float:g_AnafY, Float:g_AnafZ; // locatia ANAF (locID 33)
new g_BizDocsCarrying[MAX_PLAYERS]; // bID-ul business-ului ale carui acte sunt transportate (0 = niciunul)

// Blocheaza un business detinut, ales random, si il persista in DB. Apelat la payday, ora 12:00.
stock Business_ANAFPick()
{
    new pool[MAX_BUSINESSES], poolCount = 0;
    for(new b = 0; b < g_BusinessCount; b++)
        if(BusinessData[b][bOwned] && !BusinessData[b][bANAF]) pool[poolCount++] = b;
    if(poolCount == 0) return;

    new bidx = pool[random(poolCount)];
    BusinessData[bidx][bANAF] = 1;
    BusinessData[bidx][bANAFDocsSent] = 0;
    Business_SaveANAF(bidx);

    new ownerPid = Houses_FindPlayerByPID(BusinessData[bidx][bOwnerId]);
    if(ownerPid != INVALID_PLAYER_ID)
    {
        new abmsg[192];
        format(abmsg, sizeof(abmsg), T(ownerPid, C_ERROR"[ANAF] "C_WHITE"Your business "C_INFO"%s"C_WHITE" (ID #%d) has been flagged for a tax audit - no income until you clear it."),
            BusinessData[bidx][bName], BusinessData[bidx][bID]);
        SCM(ownerPid, COLOR_ERROR, abmsg);
    }
}

// Persista in DB starea ANAF a unui business (bidx = index in BusinessData)
stock Business_SaveANAF(bidx)
{
    new q[128];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `businesses` SET `anaf`=%d, `anaf_docs`=%d WHERE `id`=%d",
        BusinessData[bidx][bANAF], BusinessData[bidx][bANAFDocsSent], BusinessData[bidx][bID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Se ruleaza la fiecare payday: deblocheaza business-urile ale caror acte au fost duse la ANAF
stock Business_ANAFProcessDocs()
{
    for(new b = 0; b < g_BusinessCount; b++)
    {
        if(!BusinessData[b][bANAF] || !BusinessData[b][bANAFDocsSent]) continue;

        BusinessData[b][bANAF] = 0;
        BusinessData[b][bANAFDocsSent] = 0;
        Business_SaveANAF(b);

        new ownerPid = Houses_FindPlayerByPID(BusinessData[b][bOwnerId]);
        if(ownerPid != INVALID_PLAYER_ID)
        {
            new adbmsg[160];
            format(adbmsg, sizeof(adbmsg), T(ownerPid, C_SUCCESS"[ANAF] "C_WHITE"Your business "C_INFO"%s"C_WHITE" (ID #%d) has been cleared and can earn money again."),
                BusinessData[b][bName], BusinessData[b][bID]);
            SCM(ownerPid, COLOR_SUCCESS, adbmsg);
        }
    }
}

// ============================================================
//  JAF / ROBBERY - helpers (starea globala e declarata langa PlayerData)
// ============================================================
// Returneaza indexul business-ului cel mai apropiat in raza data, altfel -1
stock Biz_NearestIndex(playerid, Float:range)
{
    new best = -1;
    new Float:bestDist = range;
    for(new i = 0; i < g_BusinessCount; i++)
    {
        if(!IsPlayerInRangeOfPoint(playerid, range, BusinessData[i][bLocX], BusinessData[i][bLocY], BusinessData[i][bLocZ]))
            continue;
        new Float:d = GetPlayerDistanceFromPoint(playerid, BusinessData[i][bLocX], BusinessData[i][bLocY], BusinessData[i][bLocZ]);
        if(d < bestDist) { bestDist = d; best = i; }
    }
    return best;
}

// (Re)seteaza checkpoint-ul la business-ul de livrare curent pentru toata echipa conectata a unui jaf
stock Rob_SetCheckpointForCrew(leaderid)
{
    new bidx = g_RobHQ[leaderid][g_RobStage[leaderid]];
    for(new c = 0; c < g_RobCrewCount[leaderid]; c++)
    {
        new pid = g_RobCrew[leaderid][c];
        if(!IsPlayerConnected(pid)) continue;
        Track_SetPlayerCheckpoint(pid, BusinessData[bidx][bLocX], BusinessData[bidx][bLocY], BusinessData[bidx][bLocZ], ROB_CP_SIZE);
    }
}

// Verifica in OnPlayerEnterCheckpoint daca s-a ajuns la business-ul de livrare al jafului. Returneaza 1 daca a tratat evenimentul.
public Rob_HandleCheckpoint(playerid)
{
    new rl = g_RobLeaderOf[playerid];
    if(rl == INVALID_PLAYER_ID || rl < 0 || rl >= MAX_PLAYERS || !g_RobActive[rl]) return 0;

    new bidx = g_RobHQ[rl][g_RobStage[rl]];
    if(!IsPlayerInRangeOfPoint(playerid, ROB_CP_SIZE + 2.0, BusinessData[bidx][bLocX], BusinessData[bidx][bLocY], BusinessData[bidx][bLocZ]))
        return 0;

    if(g_RobStage[rl] < ROB_HQ_COUNT - 1)
    {
        g_RobStage[rl]++;
        Rob_SetCheckpointForCrew(rl); // urmatorul business
        new nm2[144];
        format(nm2, sizeof(nm2), C_INFO"[Rob] "C_WHITE"Drop-off %d/%d reached. Drive to the next business!", g_RobStage[rl], ROB_HQ_COUNT);
        for(new c = 0; c < g_RobCrewCount[rl]; c++)
            if(IsPlayerConnected(g_RobCrew[rl][c]))
                {
                    format(nm2, sizeof(nm2), T(g_RobCrew[rl][c], C_INFO"[Rob] "C_WHITE"Drop-off %d/%d reached. Drive to the next business!"), g_RobStage[rl], ROB_HQ_COUNT);
                    SCM(g_RobCrew[rl][c], COLOR_INFO, nm2);
                }
    }
    else
    {
        Rob_Payout(rl); // ultimul business -> plata
    }
    return 1;
}

// Curata starea unui jaf (fara plata) - la anulare / deconectare lider
stock Rob_Cancel(leaderid)
{
    for(new c = 0; c < g_RobCrewCount[leaderid]; c++)
    {
        new pid = g_RobCrew[leaderid][c];
        if(IsPlayerConnected(pid))
        {
            DisablePlayerCheckpoint(pid);
            if(g_RobLeaderOf[pid] == leaderid) g_RobLeaderOf[pid] = INVALID_PLAYER_ID;
        }
    }
    g_RobActive[leaderid]    = false;
    g_RobCrewCount[leaderid] = 0;
}

// Finalizeaza jaful: plateste doar membrii inca in viata SI conectati (cei ce au murit/plecat sunt scosi din mapare)
stock Rob_Payout(leaderid)
{
    new bizName[32];
    format(bizName, sizeof(bizName), "%s", g_RobTargetName[leaderid]);

    for(new c = 0; c < g_RobCrewCount[leaderid]; c++)
    {
        new pid = g_RobCrew[leaderid][c];
        if(!IsPlayerConnected(pid)) continue; // deconectat -> fara bani
        DisablePlayerCheckpoint(pid);

        // eligibil doar daca inca e mapat la acest jaf (a murit -> a fost scos) si e logat
        new bool:eligible = (g_RobLeaderOf[pid] == leaderid && PlayerData[pid][pLogged]);
        if(g_RobLeaderOf[pid] == leaderid) g_RobLeaderOf[pid] = INVALID_PLAYER_ID;
        if(!eligible) continue;

        // premiu / om: 12000 + 2000*nr participanti + random(5000)
        new pay = ROB_PAY_BASE + ROB_PAY_PERCREW * g_RobCrewCount[leaderid] + random(ROB_PAY_RAND);

        if(PlayerData[pid][pVIP])
        {
            new vipBonus = pay / 10; // VIP: +10% la /rob
            pay += vipBonus;

            new vbm[128];
            format(vbm, sizeof(vbm), T(pid, "{FFD700}[VIP] "C_WHITE"You received a "C_SUCCESS"+$%s"C_WHITE" bonus for being VIP."), MoneyStr(vipBonus));
            SCM(pid, COLOR_WHITE, vbm);
        }

        PlayerData[pid][pMoney] += pay;
        GivePlayerMoney(pid, pay);

        // dupa livrarea marfii, wanted-ul scade de la 6 la 5
        PlayerData[pid][pWanted] = 5;
        SetPlayerWantedLevel(pid, 5);
        UpdatePlayer(pid, pWanted);

        new fm[144];
        format(fm, sizeof(fm), T(pid, C_SUCCESS"[Rob] "C_WHITE"Robbery of "C_INFO"%s"C_WHITE" complete! You earned "C_SUCCESS"$%s"C_WHITE"."),
            bizName, MoneyStr(pay));
        SCM(pid, COLOR_SUCCESS, fm);
    }

    g_RobActive[leaderid]    = false;
    g_RobCrewCount[leaderid] = 0;

    // dupa ce hotii ridica banii, un incendiu izbucneste la ultimul business livrat (peste 5 minute)
    new lastBiz = g_RobHQ[leaderid][ROB_HQ_COUNT - 1];
    SetTimerEx("Rob_StartFire", ROB_FIRE_DELAY, false, "i", lastBiz);
}

// Pornit la 5 minute dupa un jaf: izbucneste un incendiu la business-ul unde s-au dus banii furati
public Rob_StartFire(bizidx)
{
    if(bizidx < 0 || bizidx >= g_BusinessCount) return 1;

    new fmsg[144];
    format(fmsg, sizeof(fmsg), "[SMURD] "C_WHITE"A fire has broken out at "C_INFO"%s"C_WHITE" - suspected arson linked to a recent robbery!",
        BusinessData[bizidx][bName]);
    Fires_Create(BusinessData[bizidx][bLocX], BusinessData[bizidx][bLocY], BusinessData[bizidx][bLocZ], fmsg);
    return 1;
}

stock Businesses_RecreatePickup(idx)
{
    if(g_BusinessPickup[idx] != -1)
    {
        DestroyPickup(g_BusinessPickup[idx]);
        g_BusinessPickup[idx] = -1;
    }
    g_BusinessPickup[idx] = CreatePickup(BusinessData[idx][bOwned] ? 19523 : 1274, 1,
        BusinessData[idx][bLocX], BusinessData[idx][bLocY], BusinessData[idx][bLocZ], -1);

    if(g_BusinessLabel[idx] != Text3D:INVALID_3DTEXT_ID)
    {
        Delete3DTextLabel(g_BusinessLabel[idx]);
        g_BusinessLabel[idx] = Text3D:INVALID_3DTEXT_ID;
    }

    new label[256];
    if(BusinessData[idx][bOwned])
    {
        if(BusinessData[idx][bForSale])
            format(label, sizeof(label),
                "[ Business #%d ]\nName: %s\nOwner: %s\n{5DA271}FOR SALE: $%s{E3E3E3}\n/buybiz to buy it",
                BusinessData[idx][bID], BusinessData[idx][bName], BusinessData[idx][bOwnerName], MoneyStr(BusinessData[idx][bPrice]));
        else
            format(label, sizeof(label),
                "[ Business #%d ]\nName: %s\nOwned: Yes\nOwner: %s\nPrice: $%s",
                BusinessData[idx][bID], BusinessData[idx][bName], BusinessData[idx][bOwnerName], MoneyStr(BusinessData[idx][bPrice]));
    }
    else
    {
        format(label, sizeof(label),
            "[ Business #%d ]\nName: %s\nOwned: No\nPrice: $%s\n\n/buybiz to buy this business",
            BusinessData[idx][bID], BusinessData[idx][bName], MoneyStr(BusinessData[idx][bPrice]));
    }
    g_BusinessLabel[idx] = Create3DTextLabel(label, COLOR_WHITE,
        BusinessData[idx][bLocX], BusinessData[idx][bLocY], BusinessData[idx][bLocZ]-0.5, 20.0, 0, 0);
}


// Returneaza indexul (in BusinessData) al business-ului cu bID == bid, sau -1
stock Businesses_FindByID(bid)
{
    for(new i = 0; i < g_BusinessCount; i++)
        if(BusinessData[i][bID] == bid) return i;
    return -1;
}

// ============================================================
//  TURFS (TERITORII FACTIUNI)
// ============================================================
#define MAX_TURFS 50

// Constante razboi de teritorii (folosite mai jos in functiile Turfs_* si War_*)
#define MAFIA_FID_MIN             4
#define MAFIA_FID_MAX             7
#define WAR_MIN_FACTION_ONLINE    0  // TEMPORAR: de readus la 2 (minim membri online per factiune pt /war)
#define WAR_PENDING_DURATION      120  // 2 minute, inainte sa inceapa lupta efectiva
#define WAR_ACTIVE_DURATION       900  // 15 minute de lupta
#define WAR_SURRENDER_MIN_TIME    300  // 5 minute de la inceputul fazei active, ca /warsurrender sa fie permis
#define WAR_OVERTIME_KILLS_TO_WIN 3    // la egalitate dupa cele 15 minute, prima factiune cu atatea kill-uri castiga
#define WAR_FLASH_COLOR           0xFF0000AA // culoarea cu care flashuieste gangzone-ul cat timp turful e in razboi

enum E_TURF_DATA
{
    tID, tFactionID, tName[32],
    Float:tX1, Float:tY1, Float:tX2, Float:tY2,
    bool:tAttackable, tColor[9],
    // stare razboi (0=niciunul, 1=pending/2min, 2=activ/15min, 3=sudden death) - tranzitorie, nu se salveaza in DB
    tWarState, tWarAttackerFaction, tWarDefenderFaction,
    tWarAttackerScore, tWarDefenderScore,
    tWarOvertimeAttackerKills, tWarOvertimeDefenderKills,
    tWarActiveStartTime, tWarPhaseEndTime
}
new TurfData[MAX_TURFS][E_TURF_DATA];
new g_TurfZone[MAX_TURFS] = {-1, ...};
new g_TurfCount = 0;

// Converteste un string hex (ex: "3366CC88") in valoarea sa intreaga (0x3366CC88)
stock HexStrToInt(const str[])
{
    new result = 0;
    for(new i = 0; str[i] != EOS; i++)
    {
        new c = str[i], digit;
        if(c >= '0' && c <= '9') digit = c - '0';
        else if(c >= 'A' && c <= 'F') digit = c - 'A' + 10;
        else if(c >= 'a' && c <= 'f') digit = c - 'a' + 10;
        else continue;
        result = (result << 4) | digit;
    }
    return result;
}

// Distruge si recreeaza gangzone-ul pentru un turf
stock Turfs_RecreateZone(idx)
{
    if(g_TurfZone[idx] != -1)
    {
        GangZoneDestroy(g_TurfZone[idx]);
        g_TurfZone[idx] = -1;
    }
    g_TurfZone[idx] = GangZoneCreate(TurfData[idx][tX1], TurfData[idx][tY1], TurfData[idx][tX2], TurfData[idx][tY2]);
    GangZoneShowForAll(g_TurfZone[idx], HexStrToInt(TurfData[idx][tColor]));
}

stock Turfs_FindByID(tid)
{
    for(new i = 0; i < g_TurfCount; i++)
        if(TurfData[i][tID] == tid) return i;
    return -1;
}

// Arata toate turf-urile incarcate unui singur player (folosit la conectare,
// pentru ca GangZoneShowForAll nu acopera playerii care se conecteaza dupa apel)
stock Turfs_ShowToPlayer(playerid)
{
    for(new i = 0; i < g_TurfCount; i++)
    {
        if(g_TurfZone[i] == -1) continue;
        GangZoneShowForPlayer(playerid, g_TurfZone[i], HexStrToInt(TurfData[i][tColor]));

        // resincronizeaza flash-ul de razboi pt playerii care se conecteaza in timp ce un turf e deja in razboi
        if(TurfData[i][tWarState] != 0)
            GangZoneFlashForPlayer(playerid, g_TurfZone[i], WAR_FLASH_COLOR);
    }
}

// ============================================================
//  RAZBOI DE TERITORII (intre mafii, factiunile 4-7)
// ============================================================
#define WAR_STATE_NONE     0
#define WAR_STATE_PENDING  1
#define WAR_STATE_ACTIVE   2
#define WAR_STATE_OVERTIME 3

stock bool:IsMafiaFaction(fid)
{
    return (fid >= MAFIA_FID_MIN && fid <= MAFIA_FID_MAX);
}

// Numara membrii online+logati ai unei factiuni
stock War_CountOnline(fid)
{
    new c = 0;
    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pFaction] == fid) c++;
    return c;
}

// Trimite un mesaj tuturor membrilor online ai unei factiuni
stock War_NotifyFaction(fid, color, const text[])
{
    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pFaction] == fid)
            SCM(i, color, text);
}

// O factiune poate avea un singur razboi activ (ca atacator sau aparator) in orice moment -
// verifica daca fid e deja implicata in vreun razboi nerezolvat (pending/activ/overtime), pe orice turf
stock bool:War_FactionHasActiveWar(fid)
{
    for(new i = 0; i < g_TurfCount; i++)
    {
        if(TurfData[i][tWarState] == WAR_STATE_NONE) continue;
        if(TurfData[i][tWarAttackerFaction] == fid || TurfData[i][tWarDefenderFaction] == fid) return true;
    }
    return false;
}

// Initializeaza starea de razboi (pending) pe turful tidx si anunta ambele factiuni - folosit de /war si /forcewar
stock War_Declare(tidx, atkFid, defFid)
{
    TurfData[tidx][tWarState]                 = WAR_STATE_PENDING;
    TurfData[tidx][tWarAttackerFaction]        = atkFid;
    TurfData[tidx][tWarDefenderFaction]        = defFid;
    TurfData[tidx][tWarAttackerScore]          = 0;
    TurfData[tidx][tWarDefenderScore]          = 0;
    TurfData[tidx][tWarOvertimeAttackerKills]  = 0;
    TurfData[tidx][tWarOvertimeDefenderKills]  = 0;
    TurfData[tidx][tWarActiveStartTime]        = 0;
    TurfData[tidx][tWarPhaseEndTime]           = gettime() + WAR_PENDING_DURATION;

    if(g_TurfZone[tidx] != -1)
        GangZoneFlashForAll(g_TurfZone[tidx], WAR_FLASH_COLOR);

    new warMsg[200];
    format(warMsg, sizeof(warMsg), C_ERROR"[War] "C_WHITE"%s"C_WHITE" is attacking territory "C_INFO"#%d"C_WHITE" (%s) of "C_WHITE"%s"C_WHITE"!",
        FactionData[atkFid][fName], TurfData[tidx][tID], TurfData[tidx][tName], FactionData[defFid][fName]);
    War_NotifyFaction(atkFid, COLOR_ERROR, warMsg);
    War_NotifyFaction(defFid, COLOR_ERROR, warMsg);

    format(warMsg, sizeof(warMsg), C_ERROR"[War] "C_WHITE"The war starts in "C_INFO"2 minutes"C_WHITE".");
    War_NotifyFaction(atkFid, COLOR_ERROR, warMsg);
    War_NotifyFaction(defFid, COLOR_ERROR, warMsg);

    SetTimerEx("War_StartActive", WAR_PENDING_DURATION * 1000, false, "i", tidx);
}

// Verifica daca punctul (x,y) e in interiorul dreptunghiului turfului (indiferent de ordinea colturilor in DB)
stock bool:War_PointInTurf(tidx, Float:x, Float:y)
{
    new Float:minX = (TurfData[tidx][tX1] < TurfData[tidx][tX2]) ? TurfData[tidx][tX1] : TurfData[tidx][tX2];
    new Float:maxX = (TurfData[tidx][tX1] < TurfData[tidx][tX2]) ? TurfData[tidx][tX2] : TurfData[tidx][tX1];
    new Float:minY = (TurfData[tidx][tY1] < TurfData[tidx][tY2]) ? TurfData[tidx][tY1] : TurfData[tidx][tY2];
    new Float:maxY = (TurfData[tidx][tY1] < TurfData[tidx][tY2]) ? TurfData[tidx][tY2] : TurfData[tidx][tY1];
    return (x >= minX && x <= maxX && y >= minY && y <= maxY);
}

// Gaseste turful in interiorul caruia se afla playerul acum (sau -1)
stock War_FindTurfPlayerStandsIn(playerid)
{
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    for(new i = 0; i < g_TurfCount; i++)
        if(War_PointInTurf(i, x, y)) return i;
    return -1;
}

// Gaseste turful cu razboi activ/overtime a carui zona contine (x,y) si in care factionId e implicata (atacator/aparator)
stock War_FindActiveWarForFactionAt(factionId, Float:x, Float:y)
{
    for(new i = 0; i < g_TurfCount; i++)
    {
        if(TurfData[i][tWarState] != WAR_STATE_ACTIVE && TurfData[i][tWarState] != WAR_STATE_OVERTIME) continue;
        if(TurfData[i][tWarAttackerFaction] != factionId && TurfData[i][tWarDefenderFaction] != factionId) continue;
        if(War_PointInTurf(i, x, y)) return i;
    }
    return -1;
}

// Construieste culoarea de gangzone (RRGGBB88) corespunzatoare unei factiuni, pe baza FactionColors
stock War_FactionTurfColor(fid, out[], len)
{
    format(out, len, "%06X88", (FactionColors[fid] >> 8) & 0xFFFFFF);
}

// Aplica delta la scorul factiunii date pe turful tidx; in overtime, verifica si pragul de victorie
stock War_AddScore(tidx, factionId, delta)
{
    new bool:isAttacker = (factionId == TurfData[tidx][tWarAttackerFaction]);
    if(isAttacker) TurfData[tidx][tWarAttackerScore] += delta;
    else TurfData[tidx][tWarDefenderScore] += delta;

    if(TurfData[tidx][tWarState] == WAR_STATE_OVERTIME && delta > 0)
    {
        if(isAttacker)
        {
            TurfData[tidx][tWarOvertimeAttackerKills]++;
            if(TurfData[tidx][tWarOvertimeAttackerKills] >= WAR_OVERTIME_KILLS_TO_WIN)
                War_EndWar(tidx, TurfData[tidx][tWarAttackerFaction], false);
        }
        else
        {
            TurfData[tidx][tWarOvertimeDefenderKills]++;
            if(TurfData[tidx][tWarOvertimeDefenderKills] >= WAR_OVERTIME_KILLS_TO_WIN)
                War_EndWar(tidx, TurfData[tidx][tWarDefenderFaction], false);
        }
    }
}

// Incheie razboiul: anunta ambele factiuni, transfera turful daca atacatorul a castigat, reseteaza starea
stock War_EndWar(tidx, winnerFid, bool:surrendered)
{
    if(g_TurfZone[tidx] != -1)
        GangZoneStopFlashForAll(g_TurfZone[tidx]);

    new atkFid = TurfData[tidx][tWarAttackerFaction];
    new defFid = TurfData[tidx][tWarDefenderFaction];
    new loserFid = (winnerFid == atkFid) ? defFid : atkFid;

    new wmsg[350];
    wmsg[0] = EOS;
    if(surrendered)
        format(wmsg, sizeof(wmsg), C_ERROR"[War] "C_WHITE"%s"C_WHITE" surrendered! ", FactionData[loserFid][fName]);

    new tail[200];
    if(winnerFid == atkFid)
        format(tail, sizeof(tail), C_SUCCESS"%s"C_WHITE" has conquered territory "C_INFO"#%d"C_WHITE" (%s) from "C_WHITE"%s"C_WHITE"!",
            FactionData[atkFid][fName], TurfData[tidx][tID], TurfData[tidx][tName], FactionData[defFid][fName]);
    else
        format(tail, sizeof(tail), C_SUCCESS"%s"C_WHITE" successfully defended territory "C_INFO"#%d"C_WHITE" (%s) against "C_WHITE"%s"C_WHITE"!",
            FactionData[defFid][fName], TurfData[tidx][tID], TurfData[tidx][tName], FactionData[atkFid][fName]);
    strcat(wmsg, tail);

    War_NotifyFaction(atkFid, COLOR_SUCCESS, wmsg);
    War_NotifyFaction(defFid, COLOR_SUCCESS, wmsg);

    if(winnerFid == atkFid)
    {
        TurfData[tidx][tFactionID] = winnerFid;
        War_FactionTurfColor(winnerFid, TurfData[tidx][tColor], 9);
        Turfs_RecreateZone(tidx);

        new tq[200];
        mysql_format(g_SQL, tq, sizeof(tq), "UPDATE `turfs` SET `faction_id`=%d, `color`='%s' WHERE `id`=%d",
            winnerFid, TurfData[tidx][tColor], TurfData[tidx][tID]);
        mysql_tquery(g_SQL, tq, "", "", 0);
    }

    TurfData[tidx][tWarState]                 = WAR_STATE_NONE;
    TurfData[tidx][tWarAttackerFaction]       = 0;
    TurfData[tidx][tWarDefenderFaction]       = 0;
    TurfData[tidx][tWarAttackerScore]         = 0;
    TurfData[tidx][tWarDefenderScore]         = 0;
    TurfData[tidx][tWarOvertimeAttackerKills] = 0;
    TurfData[tidx][tWarOvertimeDefenderKills] = 0;
    TurfData[tidx][tWarActiveStartTime]       = 0;
    TurfData[tidx][tWarPhaseEndTime]          = 0;
}

// La 2 minute dupa /war: incepe faza activa de 15 minute
public War_StartActive(tidx)
{
    if(TurfData[tidx][tWarState] != WAR_STATE_PENDING) return 1;

    TurfData[tidx][tWarState] = WAR_STATE_ACTIVE;
    TurfData[tidx][tWarActiveStartTime] = gettime();
    TurfData[tidx][tWarPhaseEndTime] = gettime() + WAR_ACTIVE_DURATION;

    new atkFid = TurfData[tidx][tWarAttackerFaction];
    new defFid = TurfData[tidx][tWarDefenderFaction];

    new wmsg[200];
    format(wmsg, sizeof(wmsg), C_ERROR"[War] "C_WHITE"The war for territory "C_INFO"#%d"C_WHITE" (%s) has begun! Fight for "C_INFO"15 minutes"C_WHITE".",
        TurfData[tidx][tID], TurfData[tidx][tName]);
    War_NotifyFaction(atkFid, COLOR_ERROR, wmsg);
    War_NotifyFaction(defFid, COLOR_ERROR, wmsg);

    SetTimerEx("War_CheckTimeUp", WAR_ACTIVE_DURATION * 1000, false, "i", tidx);
    return 1;
}

// La 15 minute dupa inceperea fazei active: declara castigatorul, sau intra in sudden death daca e egalitate
public War_CheckTimeUp(tidx)
{
    if(TurfData[tidx][tWarState] != WAR_STATE_ACTIVE) return 1;

    if(TurfData[tidx][tWarAttackerScore] != TurfData[tidx][tWarDefenderScore])
    {
        new winnerFid = (TurfData[tidx][tWarAttackerScore] > TurfData[tidx][tWarDefenderScore])
            ? TurfData[tidx][tWarAttackerFaction] : TurfData[tidx][tWarDefenderFaction];
        War_EndWar(tidx, winnerFid, false);
        return 1;
    }

    TurfData[tidx][tWarState] = WAR_STATE_OVERTIME;
    TurfData[tidx][tWarOvertimeAttackerKills] = 0;
    TurfData[tidx][tWarOvertimeDefenderKills] = 0;
    TurfData[tidx][tWarPhaseEndTime] = 0;

    new atkFid = TurfData[tidx][tWarAttackerFaction];
    new defFid = TurfData[tidx][tWarDefenderFaction];

    new wmsg[200];
    format(wmsg, sizeof(wmsg), "[War] ""The war for territory ""#%d"" is ""tied""! Sudden death - first faction to ""%d kills"" wins.",
        TurfData[tidx][tID], WAR_OVERTIME_KILLS_TO_WIN);
    War_NotifyFaction(atkFid, COLOR_ERROR, wmsg);
    War_NotifyFaction(defFid, COLOR_ERROR, wmsg);
    return 1;
}

// Aplica scorul corespunzator unei morti, daca victima (si, daca aplicabil, ucigasul) erau intr-un razboi activ relevant
stock War_HandleDeath(victimid, killerid)
{
    if(!PlayerData[victimid][pLogged]) return;

    new vFid = PlayerData[victimid][pFaction];
    if(!IsMafiaFaction(vFid)) return;

    new Float:vx, Float:vy, Float:vz;
    GetPlayerPos(victimid, vx, vy, vz);

    new tidx = War_FindActiveWarForFactionAt(vFid, vx, vy);
    if(tidx == -1) return;

    if(killerid == INVALID_PLAYER_ID || killerid == victimid)
    {
        War_AddScore(tidx, vFid, -1);
        return;
    }

    if(!IsPlayerConnected(killerid) || !PlayerData[killerid][pLogged]) return;

    new kFid = PlayerData[killerid][pFaction];
    new atkFid = TurfData[tidx][tWarAttackerFaction];
    new defFid = TurfData[tidx][tWarDefenderFaction];
    if(kFid != atkFid && kFid != defFid) return;

    new Float:kx, Float:ky, Float:kz;
    GetPlayerPos(killerid, kx, ky, kz);
    if(!War_PointInTurf(tidx, kx, ky)) return; // ucigasul nu era in zona turfului

    if(kFid == vFid)
        War_AddScore(tidx, kFid, -1); // friendly fire
    else
        War_AddScore(tidx, kFid, 1);  // kill pe inamic
}

// ============================================================
//  DRUGS (mafii) - functii
// ============================================================
// Trimite un mesaj tuturor membrilor online ai unei factiuni (reutilizeaza War_NotifyFaction)
// Reseteaza starea de transport a unui player
stock Drug_ResetTransport(playerid)
{
    g_DrugStage[playerid]   = DRUG_STAGE_NONE;
    g_DrugPartner[playerid] = INVALID_PLAYER_ID;
    DisablePlayerCheckpoint(playerid);
}

// La descarcare/craft: anunta factiunea + salveaza seiful
stock Drug_AnnounceSeif(fid, const text[])
{
    War_NotifyFaction(fid, COLOR_INFO, text);
}

// Timer: dupa 5s de incarcare iarba -> trimite playerul la HQ
public DrugTransport_Loaded(playerid)
{
    if(!IsPlayerConnected(playerid) || g_DrugStage[playerid] != DRUG_STAGE_LOADING) return 1;

    TogglePlayerControllable(playerid, 1);

    new fid = PlayerData[playerid][pFaction];
    if(fid < 1 || fid > MAX_FACTIONS) { Drug_ResetTransport(playerid); return 1; }

    g_DrugStage[playerid] = DRUG_STAGE_TOHQ;
    Track_SetPlayerCheckpoint(playerid, FactionData[fid][fHQX], FactionData[fid][fHQY], FactionData[fid][fHQZ], DRUG_CP_SIZE);
    SCM(playerid, COLOR_INFO, C_INFO"[Drugs] "C_WHITE"Transport the weed to your faction HQ. Watch out for the police and don't lose the goods.");
    return 1;
}

// Timer: dupa 5s de descarcare la HQ -> aduna iarba in seif si anunta factiunea
public DrugTransport_Unloaded(playerid)
{
    if(!IsPlayerConnected(playerid) || g_DrugStage[playerid] != DRUG_STAGE_UNLOADING) return 1;

    TogglePlayerControllable(playerid, 1);

    new fid = PlayerData[playerid][pFaction];
    if(fid < 1 || fid > MAX_FACTIONS) { Drug_ResetTransport(playerid); return 1; }

    new amount = 900 + random(100);
    new space  = SEIF_MAX_HERBS - FactionData[fid][fSeifHerbs];
    if(space < 0) space = 0;
    if(amount > space) amount = space; // nu depasi capacitatea

    FactionData[fid][fSeifHerbs] += amount;
    Faction_SaveSeif(fid);

    new partner = g_DrugPartner[playerid];
    new partnerName[24] = "?";
    if(partner != INVALID_PLAYER_ID && IsPlayerConnected(partner))
        format(partnerName, sizeof(partnerName), "%s", PlayerData[partner][pName]);

    new dmsg[160];
    format(dmsg, sizeof(dmsg),
        "[Faction] ""%s and %s successfully transported ""%d"" grams of weed. The vault now holds ""%d/%d"" grams of weed.",
        PlayerData[playerid][pName], partnerName, amount, FactionData[fid][fSeifHerbs], SEIF_MAX_HERBS);
    Drug_AnnounceSeif(fid, dmsg);

    // Mesaj personal catre toti ocupantii masinii de transport
    new pmsg[128];
    format(pmsg, sizeof(pmsg), C_SUCCESS"[Drugs] "C_WHITE"You deposited "C_INFO"%d"C_WHITE" grams of weed in the faction vault.", amount);
    new tveh = GetPlayerVehicleID(playerid);
    if(tveh != 0)
    {
        for(new i = 0; i < MAX_PLAYERS; i++)
            if(IsPlayerConnected(i) && PlayerData[i][pLogged] && GetPlayerVehicleID(i) == tveh)
                {
                    format(pmsg, sizeof(pmsg), T(i, C_SUCCESS"[Drugs] "C_WHITE"You deposited "C_INFO"%d"C_WHITE" grams of weed in the faction vault."), amount);
                    SCM(i, COLOR_SUCCESS, pmsg);
                }
    }
    else SCM(playerid, COLOR_SUCCESS, pmsg); // fallback: soferul nu mai e in vehicul

    Drug_ResetTransport(playerid);
    return 1;
}

// Timer: dupa 30s de craft -> produce drugs in seif si anunta factiunea
public DrugCraft_Finish(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    TogglePlayerControllable(playerid, 1);

    new fid = PlayerData[playerid][pFaction];
    if(fid < 1 || fid > MAX_FACTIONS) return 1;

    new produced = 5 + random(3);
    new space    = SEIF_MAX_DRUGS - FactionData[fid][fSeifDrugs];
    if(space < 0) space = 0;
    if(produced > space) produced = space;

    FactionData[fid][fSeifDrugs] += produced;
    Faction_SaveSeif(fid);

    new dmsg[160];
    format(dmsg, sizeof(dmsg),
        C_SUCCESS"[Faction] "C_WHITE"%s produced "C_INFO"%d"C_WHITE" grams of drugs. The vault now holds "C_INFO"%d/%d"C_WHITE" grams of drugs.",
        PlayerData[playerid][pName], produced, FactionData[fid][fSeifDrugs], SEIF_MAX_DRUGS);
    Drug_AnnounceSeif(fid, dmsg);
    return 1;
}

// Timer: scoate freeze-ul de 1s dupa /drugs use
public Drug_Unfreeze(playerid)
{
    if(IsPlayerConnected(playerid)) TogglePlayerControllable(playerid, 1);
    return 1;
}

// (Re)creeaza pickup-ul + eticheta seifului pentru o mafie, in interiorul si vw-ul ei (din DB)
stock Drugs_RecreateSeifMarker(fid)
{
    if(fid < MAFIA_FID_MIN || fid > MAFIA_FID_MAX) return;

    if(IsValidDynamicPickup(g_SeifPickup[fid]))       DestroyDynamicPickup(g_SeifPickup[fid]);
    if(IsValidDynamic3DTextLabel(g_SeifLabel[fid]))   DestroyDynamic3DTextLabel(g_SeifLabel[fid]);

    g_SeifPickup[fid] = CreateDynamicPickup(1279, 1, DRUG_SEIF_X, DRUG_SEIF_Y, DRUG_SEIF_Z,
        FactionData[fid][fvw], FactionData[fid][fInterior]);

    g_SeifLabel[fid] = CreateDynamic3DTextLabel("[ Seif ]\n[ /seif ]\n[ /drugs get ]", COLOR_WHITE,
        DRUG_SEIF_X, DRUG_SEIF_Y, DRUG_SEIF_Z - 0.5, 25.0,
        INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,
        FactionData[fid][fvw], FactionData[fid][fInterior]);

    if(IsValidDynamic3DTextLabel(g_CraftLabel[fid])) DestroyDynamic3DTextLabel(g_CraftLabel[fid]);
    g_CraftLabel[fid] = CreateDynamic3DTextLabel("[ Crafting machine ]\n[ /drugs craft ]", COLOR_WHITE,
        DRUG_CRAFT_X, DRUG_CRAFT_Y, DRUG_CRAFT_Z - 0.5, 25.0,
        INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,
        FactionData[fid][fvw], FactionData[fid][fInterior]);
}

// Eticheta punctului de echipare mafie (/equip), per factiune mafie, in interiorul/vw-ul factiunii
stock Factions_RecreateEquipLabel(fid)
{
    if(fid < MAFIA_FID_MIN || fid > MAFIA_FID_MAX) return;

    if(IsValidDynamic3DTextLabel(g_EquipLabel[fid])) DestroyDynamic3DTextLabel(g_EquipLabel[fid]);
    g_EquipLabel[fid] = CreateDynamic3DTextLabel("[ Armory ]\n[ /equip ]", COLOR_WHITE,
        EQUIP_X, EQUIP_Y, EQUIP_Z - 0.5, 15.0,
        INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,
        FactionData[fid][fvw], FactionData[fid][fInterior]);
}

// ============================================================
//  LOCATII IMPORTANTE
// ============================================================
#define MAX_LOCATIONS 100

enum E_LOCATION_DATA
{
    locID, locName[32], Float:locX, Float:locY, Float:locZ, locInterior, locVW, bool:locForGPS, locCategory[32], locDescr[64]
}
new LocationData[MAX_LOCATIONS][E_LOCATION_DATA];
new g_LocationCount = 0;

stock Locations_FindByName(const name[])
{
    for(new i = 0; i < g_LocationCount; i++)
        if(strcmp(LocationData[i][locName], name, true) == 0) return i;
    return -1;
}

// Cauta o locatie GPS-eligibila (locForGPS=1, din locations_admin) dupa nume
stock GPS_FindByName(const name[])
{
    for(new i = 0; i < g_LocationCount; i++)
        if(LocationData[i][locForGPS] && strcmp(LocationData[i][locName], name, true) == 0) return i;
    return -1;
}

// Cauta o locatie dupa locID (din locations_admin), returneaza indexul in LocationData sau -1
stock Locations_FindByID(id)
{
    for(new i = 0; i < g_LocationCount; i++)
        if(LocationData[i][locID] == id) return i;
    return -1;
}

// ============================================================
//  VEHICULE FACTIUNI
// ============================================================
#define MAX_VFACTION_VEHICLES   200

enum E_VFACTION_DATA
{
    vfID, vfFactionID, vfModelID,
    Float:vfLocX, Float:vfLocY, Float:vfLocZ, Float:vfRotation,
    vfColor1, vfColor2,
    Float:vfFuel,
    vfWheels,    // component ID al jantelor instalate prin /tune (0 = default), persistat in DB
    vfWheelsExp, // timestamp unix cand expira jantele (0 = nesetat); in DB e coloana `wheels_exp` de tip DATE
    Float:vfKm   // distanta totala parcursa (km); acumulata live din viteza (Speedometer_Tick), salvata cand soferul iese din masina
}
new VFactionData[MAX_VFACTION_VEHICLES][E_VFACTION_DATA];
new g_VFactionVehicle[MAX_VFACTION_VEHICLES];
new g_VFactionCount = 0;

// vehicleid (real, din CreateVehicle) -> ID factiune proprietara (0 = niciuna)
new g_VehicleFactionOwner[MAX_VEHICLES];

// Vehicul guvernamental: randurile din `vehicles_faction` cu `faction_id`=0.
// Nu apartin niciunei factiuni, dar pot fi conduse doar de Presedinte / Prim-ministru / Vice-premier.
new bool:g_VehicleIsGov[MAX_VEHICLES];

// Motorina live pentru ORICE vehicul (indexat dupa vehicleid, 0.0 - 100.0)
new Float:g_VehicleFuel[MAX_VEHICLES];

// Girofar atasat pe vehicul (obiect dinamic; 0 = niciunul). Indexat dupa vehicleid.
// Se pune automat la incarcare pe vehiculele de factiune cu vfID 94-97 (Infernus).
new STREAMER_TAG_OBJECT:g_VehicleGirofar[MAX_VEHICLES];
#define GIROFAR_OBJECT_MODEL  19419  // police_lights01 (bara de lumini)
#define GIROFAR_OFFSET_X      0.0
#define GIROFAR_OFFSET_Y      0.0
#define GIROFAR_OFFSET_Z      0.71   // inaltimea plafonului la Infernus (411)

// Girofar pe vehiculele Sultan (560) ale factiunii SMURD (id 3)
#define SULTAN_MODEL_ID           560
#define SULTAN_GIROFAR_MODEL      18646
new Float:g_SultanGirofarOffX = 0.0;
new Float:g_SultanGirofarOffY = 0.0;
new Float:g_SultanGirofarOffZ = 0.9;   // inaltimea plafonului la Sultan (560)

// Coordonate salvate temporar (per player) pentru /save si /gotosave
new Float:g_SavedPos[MAX_PLAYERS][4]; // x, y, z, angle
new g_SavedInt[MAX_PLAYERS], g_SavedVW[MAX_PLAYERS];
new bool:g_HasSavedPos[MAX_PLAYERS];

// Ultimele coordonate cu care s-a apelat SetPlayerCheckpoint pentru fiecare player (pentru /gotocp) - vezi Track_SetPlayerCheckpoint
new Float:g_LastCPX[MAX_PLAYERS], Float:g_LastCPY[MAX_PLAYERS], Float:g_LastCPZ[MAX_PLAYERS];
new bool:g_HasLastCP[MAX_PLAYERS];

// Wrapper peste SetPlayerCheckpoint care retine ultimele coordonate (folosit de /gotocp) - inlocuieste toate apelurile directe
stock Track_SetPlayerCheckpoint(playerid, Float:x, Float:y, Float:z, Float:size)
{
    g_LastCPX[playerid] = x;
    g_LastCPY[playerid] = y;
    g_LastCPZ[playerid] = z;
    g_HasLastCP[playerid] = true;
    SetPlayerCheckpoint(playerid, x, y, z, size);
}

// Numarul de inmatriculare fix pentru vehiculele de factiune, dupa fID
stock Factions_GetPlate(fid, plate[], len)
{
    switch(fid)
    {
        case 0: format(plate, len, "GOV"); // vehicule guvernamentale (presedinte / prim-ministru / vice-premier)
        case 1: format(plate, len, "MAI");
        case 2: format(plate, len, "DMV");
        case 3: format(plate, len, "SMURD");
        case 4: format(plate, len, "M. EUR");
        case 5: format(plate, len, "M. USA");
        case 6: format(plate, len, "M. AFR");
        case 7: format(plate, len, "M. ASIA");
        case 8: format(plate, len, "N.R.");
        default: format(plate, len, "N-RP");
    }
}

stock VehiclesFaction_Create(idx)
{
    if(g_VFactionVehicle[idx] != -1)
    {
        new oldveh = g_VFactionVehicle[idx];
        if(oldveh >= 0 && oldveh < MAX_VEHICLES && IsValidDynamicObject(g_VehicleGirofar[oldveh]))
        {
            DestroyDynamicObject(g_VehicleGirofar[oldveh]);
            g_VehicleGirofar[oldveh] = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
        }
        if(oldveh >= 0 && oldveh < MAX_VEHICLES) g_VehicleIsGov[oldveh] = false;
        DestroyVehicle(g_VFactionVehicle[idx]);
        g_VFactionVehicle[idx] = -1;
    }

    new vehid = CreateVehicle(VFactionData[idx][vfModelID],
        VFactionData[idx][vfLocX], VFactionData[idx][vfLocY], VFactionData[idx][vfLocZ]+0.2,
        VFactionData[idx][vfRotation], VFactionData[idx][vfColor1], VFactionData[idx][vfColor2], 900, false);

    new plate[8];
    Factions_GetPlate(VFactionData[idx][vfFactionID], plate, sizeof(plate));
    SetVehicleNumberPlate(vehid, plate);

    g_VFactionVehicle[idx] = vehid;
    if(vehid >= 0 && vehid < MAX_VEHICLES)
    {
        g_VehicleFactionOwner[vehid] = VFactionData[idx][vfFactionID];
        g_VehicleIsGov[vehid]        = (VFactionData[idx][vfFactionID] == 0);
        g_VehicleFuel[vehid] = VFactionData[idx][vfFuel];

        // Girofar pe vehiculele de factiune cu vfID 94-97 (Infernus)
        if(VFactionData[idx][vfID] >= 94 && VFactionData[idx][vfID] <= 97)
        {
            new Float:gx, Float:gy, Float:gz;
            GetVehiclePos(vehid, gx, gy, gz);
            g_VehicleGirofar[vehid] = CreateDynamicObject(GIROFAR_OBJECT_MODEL, gx, gy, gz + 1.0, 0.0, 0.0, 0.0);
            AttachDynamicObjectToVehicle(g_VehicleGirofar[vehid], vehid,
                GIROFAR_OFFSET_X, GIROFAR_OFFSET_Y, GIROFAR_OFFSET_Z, 0.0, 0.0, 0.0);
        }
        // Girofar pe Sultan-ii (560) factiunii SMURD (id 3)
        else if(VFactionData[idx][vfFactionID] == 3 && VFactionData[idx][vfModelID] == SULTAN_MODEL_ID)
        {
            new Float:sgx, Float:sgy, Float:sgz;
            GetVehiclePos(vehid, sgx, sgy, sgz);
            g_VehicleGirofar[vehid] = CreateDynamicObject(SULTAN_GIROFAR_MODEL, sgx, sgy, sgz + 1.0, 0.0, 0.0, 0.0);
            AttachDynamicObjectToVehicle(g_VehicleGirofar[vehid], vehid,
                g_SultanGirofarOffX, g_SultanGirofarOffY, g_SultanGirofarOffZ, 0.0, 0.0, 0.0);
        }
    }
}

// Reataseaza girofarul (cu offset-urile curente) pe toate Sultan-urile SMURD active acum
stock SultanGirofar_RefreshAll()
{
    for(new v = 0; v < g_VFactionCount; v++)
    {
        if(VFactionData[v][vfFactionID] != 3 || VFactionData[v][vfModelID] != SULTAN_MODEL_ID) continue;
        new vehid = g_VFactionVehicle[v];
        if(vehid == -1 || !IsValidDynamicObject(g_VehicleGirofar[vehid])) continue;

        AttachDynamicObjectToVehicle(g_VehicleGirofar[vehid], vehid,
            g_SultanGirofarOffX, g_SultanGirofarOffY, g_SultanGirofarOffZ, 0.0, 0.0, 0.0);
    }
}

// ============================================================
//  INCENDII (SMURD)
// ============================================================
#define MAX_FIRES               10
#define FIRETRUCK_MODEL         407
#define AMBULANCE_MODEL         416
#define HEAL_PRICE              50
#define FIRE_MAPICON_ID         20
#define FIRE_ICON_SLOT_BASE     60
#define FIRE_EXTINGUISH_RANGE   25.0
#define FACTION_SMURD           3

// ---- Boli (Diseases) ----
#define DISEASE_RADIUS       500.0
#define DISEASE_DECAY_AMOUNT 3.0
#define DISEASE_CURE_PAYDAYS 3
#define DISEASE_DRUNK_LEVEL  3000
#define HOSPITAL_RANGE       10.0
#define MAX_HOSPITALS        4

// ---- Oboseala (Tiredness) ----
#define TIRED_MAX             100
#define TIRED_WARN            80   // de la acest nivel viata incepe sa scada suplimentar
new g_TiredWarnTick[MAX_PLAYERS]; // GetTickCount() la ultima avertizare de oboseala de la spawn (evita dublarea mesajului)
#define TIRED_GAIN_PER_TICK   1    // +1 oboseala pe minut (acelasi tick ca HealthDecay_Tick) - redus de la 2, crestea prea repede spre 100
#define TIRED_HEALTH_PENALTY  2.0  // HP suplimentar pierdut pe minut cand oboseala >= TIRED_WARN
#define SLEEP_FREEZE_TIME     30   // secunde de freeze la /sleep
// Locatiile spitalelor (/curedisease) - incarcate din locations_admin (id 22, 23)
new Float:g_HospitalLoc[MAX_HOSPITALS][3];
new g_HospitalCount = 0;

// True daca playerul e in raza vreunui spital
stock bool:Player_NearHospital(playerid)
{
    for(new i = 0; i < g_HospitalCount; i++)
        if(IsPlayerInRangeOfPoint(playerid, HOSPITAL_RANGE, g_HospitalLoc[i][0], g_HospitalLoc[i][1], g_HospitalLoc[i][2]))
            return true;
    return false;
}
#define DISEASE_CURE_PRICE   200
#define DISEASE_FREEZE_TIME  10000 // 10 secunde, in ms

#define MAX_SHOPS             20
#define SHOP_PICKUP_MODEL     954
#define SHOP_RANGE            10.0

// shopType: 1 = 24/7 Shop, 2 = Electronics Shop, 3 = Tools Shop, 4 = Pet Store
enum E_SHOP_DATA
{
    shopID, shopName[32], shopType,
    Float:shopX, Float:shopY, Float:shopZ,
    shopStockMax, shopStockCurr // stoc pentru jobul Truck Driver; scade cu 1 la fiecare item cumparat din shop-ul asta
}
new ShopData[MAX_SHOPS][E_SHOP_DATA];
new g_ShopPickup[MAX_SHOPS];
new Text3D:g_ShopLabel[MAX_SHOPS] = {Text3D:INVALID_3DTEXT_ID, ...};
new g_ShopCount = 0;
new g_ShopDialogType[MAX_PLAYERS]; // tipul shop-ului deschis curent cu /shop (1/2/3/4), pentru interpretarea DIALOG_SHOP
new g_ShopDialogIdx[MAX_PLAYERS];  // indexul (in ShopData) al shop-ului deschis curent cu /shop, pentru Shop_ConsumeStock

// Maparea listitem -> index in ShopData pentru dialogul de livrare al Truck Driver (DIALOG_TRUCKDRIVER_SHOP),
// necesara pentru ca lista arata doar shop-urile de tipul cerut (nu toate), la fel ca g_ChurchListIdx
new g_TruckDriverShopListIdx[MAX_PLAYERS][MAX_SHOPS];
new g_TruckDriverShopListCount[MAX_PLAYERS];

// Creeaza (sau recreeaza) pickup-ul + eticheta 3D pentru un shop
new const g_ShopTypeName[5][20] = {"", "24/7 Shop", "Electronics Shop", "Tools Shop", "Pet Store"};

stock Shop_Create(idx)
{
    if(g_ShopPickup[idx] != -1) { DestroyPickup(g_ShopPickup[idx]); g_ShopPickup[idx] = -1; }
    new pickupModel = SHOP_PICKUP_MODEL;
    new Float:pickupZ = ShopData[idx][shopZ];
    switch(ShopData[idx][shopType])
    {
        case 1: { pickupModel = 1885; pickupZ -= 0.5; }  // 24/7 Shop
        case 2: pickupModel = 11743; // Electronics Shop
        case 3: pickupModel = 2480;  // Tools Shop
        case 4: pickupModel = 1599; // Pet Store
    }
    g_ShopPickup[idx] = CreatePickup(pickupModel, 1, ShopData[idx][shopX], ShopData[idx][shopY], pickupZ, -1);

    if(g_ShopLabel[idx] != Text3D:INVALID_3DTEXT_ID)
    {
        Delete3DTextLabel(g_ShopLabel[idx]);
        g_ShopLabel[idx] = Text3D:INVALID_3DTEXT_ID;
    }
    new stype = ShopData[idx][shopType];
    if(stype < 1 || stype > 3) stype = 1;
    new label[128];
    format(label, sizeof(label), "[ Shop #%d ]\n[ %s ]\n[ %s ]\n[ Use /shop ]", ShopData[idx][shopID], ShopData[idx][shopName], g_ShopTypeName[stype]);
    g_ShopLabel[idx] = Create3DTextLabel(label, COLOR_WHITE, ShopData[idx][shopX], ShopData[idx][shopY], ShopData[idx][shopZ] - 0.5, 40.0, 0, 0);
}

// Returneaza indexul shop-ului cu shopID dat (sau -1)
stock Shop_FindByID(id)
{
    for(new i = 0; i < g_ShopCount; i++)
        if(ShopData[i][shopID] == id) return i;
    return -1;
}


// Verifica daca playerid e in raza unuia dintre shop-uri
stock bool:Shop_PlayerInRange(playerid)
{
    for(new i = 0; i < g_ShopCount; i++)
        if(IsPlayerInRangeOfPoint(playerid, SHOP_RANGE, ShopData[i][shopX], ShopData[i][shopY], ShopData[i][shopZ]))
            return true;
    return false;
}

// La fel ca Shop_PlayerInRange, dar returneaza indexul shop-ului (sau -1) - necesar ca sa stim tipul lui
stock Shop_FindNearby(playerid)
{
    for(new i = 0; i < g_ShopCount; i++)
        if(IsPlayerInRangeOfPoint(playerid, SHOP_RANGE, ShopData[i][shopX], ShopData[i][shopY], ShopData[i][shopZ]))
            return i;
    return -1;
}

// Scade stocul shop-ului cu `amount` (clamp la 0) si salveaza in DB. Apelata la fiecare item cumparat din /shop.
stock Shop_ConsumeStock(idx, amount)
{
    if(idx < 0 || idx >= g_ShopCount) return;

    ShopData[idx][shopStockCurr] -= amount;
    if(ShopData[idx][shopStockCurr] < 0) ShopData[idx][shopStockCurr] = 0;

    new q[96];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `shops` SET `stock_curr`=%d WHERE `shopID`=%d",
        ShopData[idx][shopStockCurr], ShopData[idx][shopID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Eticheta calitativa a stocului (curr/max), folosita in dialogurile de livrare (bar/shop) in loc de numere brute
stock Stock_Label(curr, max, out[], outsize)
{
    if(curr <= 0 || max <= 0) { format(out, outsize, "NO"); return; }

    new Float:pct = float(curr) * 100.0 / float(max);
    if(pct <= 25.0)      format(out, outsize, "Poor");
    else if(pct <= 50.0) format(out, outsize, "Medium");
    else if(pct <= 75.0) format(out, outsize, "Good");
    else                 format(out, outsize, "Excellent");
}

// ============================================================
//  MANCARE (/pizza, /burger, /meal, /desert)
// ============================================================
#define MAX_FOOD_LOCATIONS   20
#define FOOD_RANGE            10.0

