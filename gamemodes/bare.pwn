// O harta e "gata" doar daca are coordonate setate (0,0,0 = inca neconstruita)
stock bool:Church_MapReady(m)
{
    if(m < 0 || m >= CHURCH_COUNT) return false;
    return !(g_ChurchIntPos[m][0] == 0.0 && g_ChurchIntPos[m][1] == 0.0 && g_ChurchIntPos[m][2] == 0.0);
}

// Biserica religiei date (index in g_ChurchLocID), sau -1 pentru Ateu / religie invalida
stock Religion_GetChurch(religion)
{
    if(religion < 0 || religion >= sizeof(g_ReligionChurch)) return -1;
    return g_ReligionChurch[religion];
}

// Religia careia ii apartine biserica data, sau -1
stock Church_GetReligion(church)
{
    if(church < 0 || church >= CHURCH_COUNT) return -1;
    return g_ChurchReligion[church];
}

// Apelat din OnGameModeInit
stock ChurchInteriors_Create()
{
    ChurchInterior1_Create();
    ChurchInterior2_Create();
    ChurchInterior3_Create();

    for(new m = 0; m < CHURCH_COUNT; m++)
    {
        if(!Church_MapReady(m)) continue; // harta nu e construita inca

        // punctul de rugaciune, vizibil doar in VW-ul hartii
        Create3DTextLabel("[ Use /pray ]", COLOR_WHITE,
            g_ChurchPrayPos[m][0], g_ChurchPrayPos[m][1], g_ChurchPrayPos[m][2] - 0.5,
            20.0, g_ChurchIntVW[m], 0);

        // punctul de iesire (acolo unde apari cand intri)
        Create3DTextLabel("[ Press ENTER to exit ]", COLOR_WHITE,
            g_ChurchIntPos[m][0], g_ChurchIntPos[m][1], g_ChurchIntPos[m][2] - 0.5,
            20.0, g_ChurchIntVW[m], 0);
    }
}

// ============================================================
//  BISERICI - intrare/iesire + punctul de rugaciune
// ============================================================
// Scoate jucatorul din biserica (folosit si la iesire, si la respawn/deconectare)
stock Church_Leave(playerid, bool:teleport)
{
    new c = g_PlayerChurch[playerid];
    g_PlayerChurch[playerid] = -1;
    if(c == -1 || !teleport) return;

    new idx = Locations_FindByID(g_ChurchLocID[c]);
    if(idx != -1)
        AC_SetPos(playerid, LocationData[idx][locX], LocationData[idx][locY], LocationData[idx][locZ]);

    AC_SetInterior(playerid, 0);
    AC_SetVW(playerid, 0);
}

// Intrare/iesire din biserica (apasand KEY_SECONDARY_ATTACK langa pickup / langa punctul de spawn din interior)
stock Church_Toggle(playerid)
{
    // Interior -> exterior
    if(g_PlayerChurch[playerid] != -1)
    {
        new m = g_ChurchMap[ g_PlayerChurch[playerid] ];
        if(!IsPlayerInRangeOfPoint(playerid, CHURCH_RANGE,
            g_ChurchIntPos[m][0], g_ChurchIntPos[m][1], g_ChurchIntPos[m][2])) return;

        Church_Leave(playerid, true);
        return;
    }

    // Exterior -> interior
    if(GetPlayerVirtualWorld(playerid) != 0) return;

    for(new c = 0; c < CHURCH_COUNT; c++)
    {
        new idx = Locations_FindByID(g_ChurchLocID[c]);
        if(idx == -1) continue;
        if(!IsPlayerInRangeOfPoint(playerid, CHURCH_RANGE,
            LocationData[idx][locX], LocationData[idx][locY], LocationData[idx][locZ])) continue;

        new m = g_ChurchMap[c];
        if(!Church_MapReady(m))
        {
            SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This church's interior isn't finished yet.");
            return;
        }

        AC_SetPos(playerid, g_ChurchIntPos[m][0], g_ChurchIntPos[m][1], g_ChurchIntPos[m][2]);
        AC_SetInterior(playerid, 0);
        AC_SetVW(playerid, g_ChurchIntVW[m]);

        g_PlayerChurch[playerid] = c;
        return;
    }
}

// True daca jucatorul e la punctul de rugaciune dintr-o biserica (necesar pentru /pray)
stock bool:Church_AtPrayPoint(playerid)
{
    new vw = GetPlayerVirtualWorld(playerid);
    for(new m = 0; m < CHURCH_COUNT; m++)
    {
        if(vw != g_ChurchIntVW[m] || !Church_MapReady(m)) continue;
        if(IsPlayerInRangeOfPoint(playerid, CHURCH_PRAY_RANGE,
            g_ChurchPrayPos[m][0], g_ChurchPrayPos[m][1], g_ChurchPrayPos[m][2])) return true;
    }
    return false;
}

// Returneaza true daca acum suntem in fereastra de vot (Duminica, 08:00 - 19:30)
stock bool:President_IsVoteWindowOpen()
{
    new year, month, day;
    getdate(year, month, day);
    if(DayOfWeek(year, month, day) != 0) return false; // doar Duminica

    new hour, minute, second;
    gettime(hour, minute, second);
    if(hour < VOTE_WINDOW_START_HOUR) return false;
    if(hour > VOTE_WINDOW_END_HOUR) return false;
    if(hour == VOTE_WINDOW_END_HOUR && minute >= VOTE_WINDOW_END_MINUTE) return false;
    return true;
}

// Fereastra pentru jobul Car Transportator: Vineri (5), Sambata (6), Duminica (0), intre 16:00 si 23:00
stock bool:Job_TransportWindowOpen()
{
    new year, month, day;
    getdate(year, month, day);
    new dow = DayOfWeek(year, month, day);
    if(dow != 0 && dow != 5 && dow != 6) return false;

    new hour, minute, second;
    gettime(hour, minute, second);
    if(hour < 16 || hour > 23) return false;
    return true;
}

// Cauta un player online & logat dupa nume exact (case-insensitive). Returneaza playerid sau -1.
stock Player_FindByName(const name[])
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
        if(strcmp(PlayerData[i][pName], name, true) == 0) return i;
    }
    return -1;
}

// Gaseste presedintele curent online (sau -1)
stock President_FindCurrentOnline()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pIsPresident]) return i;
    return -1;
}

// Trimite un mesaj tuturor jucatorilor logati
stock President_BroadcastAll(color, const text[])
{
    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged])
            SCM(i, color, text);
}

// ============================================================
//  GUVERN - Prim-ministru / Vice-premier (numiti de presedinte)
// ------------------------------------------------------------
//  Stocate in `players`.`gov_role` (0 = niciuna, 1 = PM, 2 = VPM).
//  Nu dau inca permisiuni suplimentare - sunt doar titluri.
//  Se sterg automat la fiecare alegere (mandat nou = guvern nou).
// ============================================================
new const g_GovRoleName[3][16] = { "None", "Prime Minister", "Deputy PM" };

// Sterge toate functiile din guvern (DB + jucatorii online). Apelata la fiecare alegere.
stock Gov_ClearAll()
{
    mysql_tquery(g_SQL, "UPDATE `players` SET `gov_role`=0 WHERE `gov_role`<>0", "", "", 0);

    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged])
            PlayerData[i][pGovRole] = GOV_NONE;
}

// Gaseste jucatorul online care detine functia data (sau -1)
stock Gov_FindOnlineByRole(role)
{
    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pGovRole] == role) return i;
    return -1;
}

// True daca jucatorul face parte din conducerea statului (presedinte, prim-ministru sau vice-premier).
// Folosit pentru accesul la vehiculele guvernamentale (`vehicles_faction` cu faction_id=0).
stock bool:Gov_IsOfficial(playerid)
{
    if(!IsPlayerConnected(playerid) || !PlayerData[playerid][pLogged]) return false;
    if(PlayerData[playerid][pIsPresident]) return true;
    return (PlayerData[playerid][pGovRole] != GOV_NONE);
}

// Traduce argumentul din comanda ("pm" / "vpm") in constanta de rol. GOV_NONE = argument invalid.
stock Gov_ParseRole(const arg[])
{
    if(strcmp(arg, "pm", true) == 0)  return GOV_PM;
    if(strcmp(arg, "vpm", true) == 0) return GOV_VPM;
    return GOV_NONE;
}

// Elibereaza o functie (DB + memorie), fara mesaje. Returneaza playerid-ul celui demis (sau -1 daca era offline/vacanta).
stock Gov_ClearRole(role)
{
    new q[96];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `players` SET `gov_role`=0 WHERE `gov_role`=%d", role);
    mysql_tquery(g_SQL, q, "", "", 0);

    new oldid = Gov_FindOnlineByRole(role);
    if(oldid != -1) PlayerData[oldid][pGovRole] = GOV_NONE;
    return oldid;
}

// Raspuns la /appoint dismiss - confirma intai ca functia chiar e ocupata (detinatorul poate fi offline)
forward OnGovDismiss(playerid, role);
public OnGovDismiss(playerid, role)
{
    if(!IsPlayerConnected(playerid) || !PlayerData[playerid][pLogged]) return 0;
    if(!PlayerData[playerid][pIsPresident]) return 0; // si-a pierdut mandatul intre query si callback

    if(cache_num_rows() == 0)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Nobody holds that office right now."), 1;

    new oldid = Gov_ClearRole(role);

    // anuntul se formateaza per jucator, ca sa fie tradus si numele functiei
    new dmsg[176];
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
        format(dmsg, sizeof(dmsg), T(i, C_INFO"[Government] "C_WHITE"The President dismissed the "C_INFO"%s"C_WHITE"."), T(i, g_GovRoleName[role]));
        SCM(i, COLOR_INFO, dmsg);
    }

    if(oldid != -1 && oldid != playerid)
    {
        format(dmsg, sizeof(dmsg), T(oldid, C_ERROR"[Government] "C_WHITE"You are no longer "C_INFO"%s"C_WHITE"."), T(oldid, g_GovRoleName[role]));
        SCM(oldid, COLOR_ERROR, dmsg);
    }
    return 1;
}

// Raspuns la /gov - presedintele + guvernul numit de el (query async, include si jucatorii offline)
forward OnGovInfo(playerid);
public OnGovInfo(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    new presName[24], pmName[24], vpmName[24];
    presName[0] = EOS; pmName[0] = EOS; vpmName[0] = EOS;

    new rows = cache_num_rows();
    for(new r = 0; r < rows; r++)
    {
        new uname[24], isPres, govRole;
        cache_get_value_name(r, "username", uname, sizeof(uname));
        cache_get_value_name_int(r, "is_president", isPres);
        cache_get_value_name_int(r, "gov_role",     govRole);

        if(isPres)                 format(presName, sizeof(presName), "%s", uname);
        else if(govRole == GOV_PM) format(pmName,   sizeof(pmName),   "%s", uname);
        else if(govRole == GOV_VPM)format(vpmName,  sizeof(vpmName),  "%s", uname);
    }

    new msg[160];
    SCM(playerid, COLOR_INFO, C_INFO"____________ Government ____________");

    if(strlen(presName)) format(msg, sizeof(msg), T(playerid, C_WHITE"President: "C_INFO"%s"), presName);
    else                 format(msg, sizeof(msg), T(playerid, C_WHITE"President: "C_ERROR"vacant"));
    SCM(playerid, COLOR_WHITE, msg);

    if(strlen(pmName)) format(msg, sizeof(msg), T(playerid, C_WHITE"Prime Minister: "C_INFO"%s"), pmName);
    else               format(msg, sizeof(msg), T(playerid, C_WHITE"Prime Minister: "C_ERROR"vacant"));
    SCM(playerid, COLOR_WHITE, msg);

    if(strlen(vpmName)) format(msg, sizeof(msg), T(playerid, C_WHITE"Deputy PM: "C_INFO"%s"), vpmName);
    else                format(msg, sizeof(msg), T(playerid, C_WHITE"Deputy PM: "C_ERROR"vacant"));
    SCM(playerid, COLOR_WHITE, msg);
    return 1;
}

// Duminica 06:00 - goleste tabela de voturi si reseteaza flag-ul `voted` pentru toti (DB + online)
stock President_ClearVotes()
{
    mysql_tquery(g_SQL, "DELETE FROM `president_votes`", "", "", 0);
    mysql_tquery(g_SQL, "UPDATE `players` SET `voted`=0", "", "", 0);

    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged])
            PlayerData[i][pVoted] = false;

    President_BroadcastAll(COLOR_INFO,
        C_INFO"[President] "C_WHITE"Voting is now open! Use "C_INFO"/vote [player name]"C_WHITE" until "C_INFO"19:30"C_WHITE" to elect this week's President.");
}

// Duminica 20:00 - declanseaza calculul castigatorului (interogare async)
stock President_ComputeWinner()
{
    // Numara voturile per candidat, excluzand candidatii care au fost presedinti runda trecuta (was_president=1).
    // Presedintele care tocmai isi incheie mandatul e marcat was_president=1 inainte sa rulam asta (vezi mai jos).
    mysql_tquery(g_SQL,
        "UPDATE `players` SET `was_president` = `is_president`",
        "", "", 0);

    mysql_tquery(g_SQL,
        "SELECT v.`vVotatPeId` AS pid, COUNT(*) AS cnt \
         FROM `president_votes` v \
         JOIN `players` p ON p.`id` = v.`vVotatPeId` \
         WHERE p.`was_president` = 0 \
         GROUP BY v.`vVotatPeId` \
         ORDER BY cnt DESC LIMIT 1",
        "OnPresidentWinnerComputed");
}

forward OnPresidentWinnerComputed();
public OnPresidentWinnerComputed()
{
    if(cache_num_rows() == 0)
    {
        // Niciun vot valid: nu se schimba presedintele, dar mandatul vechi s-a incheiat (deja marcat was_president).
        // Pastram presedintele actual? Spec spune ca se calculeaza un nou presedinte; fara voturi, ramane vacant.
        mysql_tquery(g_SQL, "UPDATE `players` SET `is_president`=0", "", "", 0);
        for(new i = 0; i < MAX_PLAYERS; i++)
            if(IsPlayerConnected(i) && PlayerData[i][pLogged])
            {
                PlayerData[i][pWasPresident] = PlayerData[i][pIsPresident];
                PlayerData[i][pIsPresident]  = false;
            }
        Gov_ClearAll(); // mandat incheiat -> guvernul numit de fostul presedinte se dizolva
        President_BroadcastAll(COLOR_INFO,
            C_INFO"[President] "C_WHITE"No valid votes this week - the presidency remains vacant.");
        return 1;
    }

    new winnerId, voteCount;
    cache_get_value_name_int(0, "pid", winnerId);
    cache_get_value_name_int(0, "cnt", voteCount);

    // DB: vechiul presedinte deja marcat was_president=1 (in President_ComputeWinner); acum setam noul presedinte.
    new q[160];
    mysql_tquery(g_SQL, "UPDATE `players` SET `is_president`=0", "", "", 0);
    mysql_format(g_SQL, q, sizeof(q),
        "UPDATE `players` SET `is_president`=1, `was_president`=0 WHERE `id`=%d", winnerId);
    mysql_tquery(g_SQL, q, "", "", 0);

    Gov_ClearAll(); // mandat nou -> guvernul vechi se dizolva, noul presedinte isi numeste oamenii cu /appoint

    // Sincronizeaza starea in memorie pentru jucatorii online
    new winnerName[24]; winnerName[0] = EOS;
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
        PlayerData[i][pWasPresident] = PlayerData[i][pIsPresident]; // cine era presedinte devine "fost presedinte"
        PlayerData[i][pIsPresident]  = (PlayerData[i][pID] == winnerId);
        if(PlayerData[i][pID] == winnerId)
        {
            PlayerData[i][pWasPresident] = false;
            format(winnerName, sizeof(winnerName), "%s", PlayerData[i][pName]);
        }
    }

    new msg[160];
    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged])
        {
            if(strlen(winnerName))
                format(msg, sizeof(msg), T(i, C_SUCCESS"[President] "C_WHITE"%s"C_WHITE" has been elected President for this week with "C_INFO"%d"C_WHITE" vote(s)!"),
                    winnerName, voteCount);
            else
                format(msg, sizeof(msg), T(i, C_SUCCESS"[President] "C_WHITE"A new President has been elected with "C_INFO"%d"C_WHITE" vote(s)! (currently offline)"),
                    voteCount);
            SCM(i, COLOR_SUCCESS, msg);
        }

    President_BroadcastAll(COLOR_INFO,
        C_INFO"[Government] "C_WHITE"The old cabinet has been dissolved. The new President can appoint theirs with "C_INFO"/appoint"C_WHITE".");
    return 1;
}

// Raspuns la /president - afiseaza presedintele curent + impozitul/CASS la zi
forward OnPresidentInfo(playerid);
public OnPresidentInfo(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    new presName[24];
    if(cache_num_rows() > 0)
        cache_get_value_name(0, "username", presName, sizeof(presName));

    new msg[160];
    if(strlen(presName))
        format(msg, sizeof(msg), T(playerid, C_INFO"[President] "C_WHITE"Current President: "C_INFO"%s"C_WHITE"."), presName);
    else
        format(msg, sizeof(msg), T(playerid, C_INFO"[President] "C_WHITE"There is no President elected at the moment."));
    SCM(playerid, COLOR_INFO, msg);

    format(msg, sizeof(msg), T(playerid, C_INFO"[President] "C_WHITE"Income tax: "C_INFO"%d%%"C_WHITE" | CASS: "C_INFO"%d%%"C_WHITE"."), g_PDTax, g_PDCASS);
    SCM(playerid, COLOR_INFO, msg);
    SCM(playerid, COLOR_INFO, C_INFO"[President] "C_WHITE"Use "C_INFO"/gov"C_WHITE" to see the Prime Minister and the Deputy PM.");
    return 1;
}

// Raspuns la /setpresident dismiss (sau /setpresident -1) - revoca presedintele curent, fara inlocuitor
forward OnSetPresidentDismiss(playerid);
public OnSetPresidentDismiss(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    if(cache_num_rows() == 0)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"There is no President right now."), 1;

    mysql_tquery(g_SQL, "UPDATE `players` SET `was_president` = `is_president`", "", "", 0);
    mysql_tquery(g_SQL, "UPDATE `players` SET `is_president`=0", "", "", 0);
    Gov_ClearAll(); // presedintele e revocat -> guvernul (Prim-ministru/Vice-premier) se dizolva

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
        PlayerData[i][pWasPresident] = PlayerData[i][pIsPresident];
        PlayerData[i][pIsPresident]  = false;
    }

    President_BroadcastAll(COLOR_INFO, C_INFO"[President] "C_WHITE"An admin dismissed the President. The presidency is now vacant.");
    SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"You dismissed the President.");
    return 1;
}

// Tick la fiecare minut (acelasi cadou ca PayDay_Check) - declanseaza momentele cheie de Duminica
forward President_Check();
public President_Check()
{
    new year, month, day;
    getdate(year, month, day);
    if(DayOfWeek(year, month, day) != 0) return; // doar Duminica

    new hour, minute, second;
    gettime(hour, minute, second);

    if(hour == 6 && minute == 0 && g_LastVoteClearDay != day)
    {
        g_LastVoteClearDay = day;
        President_ClearVotes();
    }

    if(hour == 20 && minute == 0 && g_LastVoteWinnerDay != day)
    {
        g_LastVoteWinnerDay = day;
        President_ComputeWinner();
    }
}

// ============================================================
//  SCADERE VIATA (1 HP / minut)
// ============================================================
#define HEALTH_DECAY_TICK   60000 // 1 minut, in ms
#define HEALTH_DECAY_AMOUNT 1.0

forward HealthDecay_Tick();
public HealthDecay_Tick()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;

        if(!g_Sleeping[i] && PlayerData[i][pTired] < TIRED_MAX)
        {
            PlayerData[i][pTired] += TIRED_GAIN_PER_TICK;
            if(PlayerData[i][pTired] > TIRED_MAX) PlayerData[i][pTired] = TIRED_MAX;
            if(PlayerData[i][pTired] == TIRED_WARN)
                SCM(i, COLOR_ERROR, C_ERROR"Warning: "C_WHITE"You are getting tired. Go home and use "C_INFO"/sleep"C_WHITE" to rest, or your health will start dropping.");
        }

        new Float:health;
        GetPlayerHealth(i, health);
        if(health <= 0.0) continue; // deja mort/in curs de respawn

        health -= (PlayerData[i][pDiseased] ? DISEASE_DECAY_AMOUNT : HEALTH_DECAY_AMOUNT);
        if(PlayerData[i][pTired] >= TIRED_WARN) health -= TIRED_HEALTH_PENALTY;
        if(health < 0.0) health = 0.0;

        SetPlayerHealth(i, health); // la 0.0, SA-MP omoara playerul automat -> OnPlayerRequestClass il respawneaza
    }
    return 1;
}

forward Appliance_ExpireTick();
public Appliance_ExpireTick()
{
    // Frigiderele stricate isi pierd itemele (patul nu are itemele proprii, doar blocheaza /sleep)
    for(new i = 0; i < g_HouseCount; i++)
    {
        if(!HouseData[i][hHasFridge] || !Houses_FridgeBroken(i)) continue;

        new bool:hadItems = false;
        for(new k = 0; k < FRIDGE_ITEMS; k++)
        {
            if(HouseData[i][hFridge][k] > 0) { HouseData[i][hFridge][k] = 0; hadItems = true; }
        }
        if(hadItems) Houses_SaveFridge(i);
    }
    return 1;
}

// ============================================================
//  TRACKING IP (tabela `ips`) - apelat la conectare, INAINTE de dialogul de register/login
// ============================================================
forward OnIPAlreadyOnlineChecked(playerid);

stock Player_LogIP(playerid)
{
    GetPlayerIp(playerid, g_PlayerIP[playerid], sizeof(g_PlayerIP[]));

    new query[160];
    mysql_format(g_SQL, query, sizeof(query),
        "SELECT `playerName` FROM `ips` WHERE `ip`='%e' AND `isOnline`=1 AND `playerName`!='%e'",
        g_PlayerIP[playerid], PlayerData[playerid][pName]);
    mysql_tquery(g_SQL, query, "OnIPAlreadyOnlineChecked", "i", playerid);

    new q2[200];
    mysql_format(g_SQL, q2, sizeof(q2),
        "INSERT INTO `ips` (`ip`,`isOnline`,`playerName`,`lastLogin`) VALUES ('%e',1,'%e',NOW()) \
         ON DUPLICATE KEY UPDATE `isOnline`=1, `lastLogin`=NOW()",
        g_PlayerIP[playerid], PlayerData[playerid][pName]);
    mysql_tquery(g_SQL, q2, "", "", 0);
}

// Daca gasim alt playerName deja isOnline=1 pe acelasi IP, anuntam adminii conectati (posibil multi-cont) si dam kick
public OnIPAlreadyOnlineChecked(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    new rows = cache_num_rows();
    if(rows == 0) return 1;

    for(new r = 0; r < rows; r++)
    {
        new otherName[24];
        cache_get_value_name(r, "playerName", otherName, sizeof(otherName));

        new amsg[160];
        format(amsg, sizeof(amsg), C_ERROR"[IP] "C_WHITE"%s just connected from the same IP as "C_INFO"%s"C_WHITE" (currently online) - kicked.",
            PlayerData[playerid][pName], otherName);

        for(new i = 0; i < MAX_PLAYERS; i++)
            if(IsPlayerConnected(i) && PlayerData[i][pAdminLevel] > 0)
                {
                    format(amsg, sizeof(amsg), T(i, C_ERROR"[IP] "C_WHITE"%s just connected from the same IP as "C_INFO"%s"C_WHITE" (currently online) - kicked."), PlayerData[playerid][pName], otherName);
                    SCM(i, COLOR_ERROR, amsg);
                }
    }

    SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Another account is already connected from your IP address.");
    Admin_KickDelayed(playerid);
    return 1;
}

// ============================================================
//  VERIFICARE / INCARCARE JUCATOR
// ============================================================
stock Player_CheckExists(playerid)
{
    new query[128];
    mysql_format(g_SQL, query, sizeof(query),
        "SELECT `id`,`password`,`level`,`money`,`bank`,`rp`,`admin_level` \
         FROM `players` WHERE `username`='%e' LIMIT 1",
        PlayerData[playerid][pName]);
    mysql_tquery(g_SQL, query, "OnPlayerCheckExists", "i", playerid);
}

// ---- Timeout de 10s pt. dialogul de login/register: daca playerul nu raspunde, e dat kick ----
#define AUTH_DIALOG_TIMEOUT 30000
#define LOGIN_MAX_ATTEMPTS   4
new g_AuthTimer[MAX_PLAYERS] = {-1, ...};
new g_LoginAttempts[MAX_PLAYERS];

stock Auth_StartTimeout(playerid)
{
    if(g_AuthTimer[playerid] != -1) KillTimer(g_AuthTimer[playerid]);
    g_AuthTimer[playerid] = SetTimerEx("Auth_TimeoutKick", AUTH_DIALOG_TIMEOUT, false, "i", playerid);
}

stock Auth_CancelTimeout(playerid)
{
    if(g_AuthTimer[playerid] != -1)
    {
        KillTimer(g_AuthTimer[playerid]);
        g_AuthTimer[playerid] = -1;
    }
}

public Auth_TimeoutKick(playerid)
{
    g_AuthTimer[playerid] = -1;
    if(!IsPlayerConnected(playerid)) return 1;

    SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You took too long to respond to the login/register dialog. Disconnecting.");
    Kick(playerid);
    return 1;
}

public OnPlayerCheckExists(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    if(cache_num_rows() > 0)
    {
        PlayerData[playerid][pRegistered] = true;

        cache_get_value_name_int(0, "id",          PlayerData[playerid][pID]);
        cache_get_value_name    (0, "password",    PlayerData[playerid][pPass], 64);
        cache_get_value_name_int(0, "level",       PlayerData[playerid][pLevel]);
        cache_get_value_name_int(0, "money",       PlayerData[playerid][pMoney]);
        cache_get_value_name_int(0, "bank",        PlayerData[playerid][pBank]);
        cache_get_value_name_int(0, "rp",          PlayerData[playerid][pRP]);
        cache_get_value_name_int(0, "admin_level", PlayerData[playerid][pAdminLevel]);

        SCM(playerid, COLOR_SUCCESS, "Welcome back! From here, leave your worries aside and enjoy some quality time.");
        SCM(playerid, COLOR_WHITE,
            C_WHITE"For more information about the activities on the server, you can use "C_SUCCESS"/howto"C_WHITE".");
        SCM(playerid, COLOR_WHITE,
            C_WHITE"If you have any other questions, the admins are here to help via the "C_SUCCESS"/report"C_WHITE" command.");

        new ldlg[200];
        format(ldlg, sizeof(ldlg), T(playerid, C_WHITE"Welcome back, "C_INFO"%s"C_WHITE"!\nThis account is registered.\n\nEnter your password to log in:\n\n"C_ERROR"You have 30 seconds to respond, or you will be kicked."), PlayerData[playerid][pName]);
        SPD(playerid, DIALOG_LOGIN, DIALOG_STYLE_PASSWORD, "Login", ldlg, "Login", "Quit");
        Auth_StartTimeout(playerid);
    }
    else
    {
        PlayerData[playerid][pRegistered] = false;
        SCM(playerid, COLOR_SUCCESS, "Welcome! From here, leave your worries aside and enjoy some quality time.");
        SCM(playerid, COLOR_WHITE,
            C_WHITE"For more information about the activities on the server, you can use "C_SUCCESS"/howto"C_WHITE".");
        SCM(playerid, COLOR_WHITE,
            C_WHITE"If you have any other questions, the admins are here to help via the "C_SUCCESS"/report"C_WHITE" command.");

        new rdlg[480];
        format(rdlg, sizeof(rdlg), T(playerid, C_WHITE"Welcome, "C_INFO"%s"C_WHITE"!\nThis account is not registered.\n\nEnter a password to create your account:\n\n"C_ERROR"Attention: "C_WHITE"Use a unique password that you do NOT use on any other site/application.\nRegistering confirms you agree to the Nostalgia: Los Santos Terms & Conditions. See T&C at "C_INFO"site/tc.html\n\n"C_ERROR"You have 30 seconds to respond, or you will be kicked."), PlayerData[playerid][pName]);
        SPD(playerid, DIALOG_REGISTER, DIALOG_STYLE_PASSWORD, "Register", rdlg, "Register", "Quit");
        Auth_StartTimeout(playerid);
    }
    return 1;
}

// ============================================================
//  INREGISTRARE
// ============================================================
stock Player_Register(playerid, const pass[])
{
    // Tine parola si in memorie: Player_SaveData scrie `password` din PlayerData[pPass], deci fara asta
    // primul salvat dupa inregistrare ar sterge parola din baza de date.
    format(PlayerData[playerid][pPass], 64, "%s", pass);

    new query[256];
    mysql_format(g_SQL, query, sizeof(query),
        "INSERT INTO `players` (`username`,`password`,`register_date`) VALUES ('%e','%e',NOW())",
        PlayerData[playerid][pName], pass);
    mysql_tquery(g_SQL, query, "OnPlayerRegister", "i", playerid);
}

public OnPlayerRegister(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    PlayerData[playerid][pID]         = cache_insert_id();
    PlayerData[playerid][pRegistered] = true;
    PlayerData[playerid][pLogged]     = true;
    PlayerData[playerid][pLevel]      = 1;
    PlayerData[playerid][pMoney]      = 0;
    PlayerData[playerid][pBank]       = 0;
    PlayerData[playerid][pRP]         = 0;
    PlayerData[playerid][pAdminLevel] = 0;
    PlayerData[playerid][pFaction]    = 0;
    PlayerData[playerid][pFactionRank]= 0;
    PlayerData[playerid][pFactionJoin]= 0;
    PlayerData[playerid][pLastPray]   = 0;
    PlayerData[playerid][pReligion]   = 0;
    format(PlayerData[playerid][pLanguage], 3, "en");
    Lang_Reset(playerid);
    PlayerData[playerid][pHouse]      = 0;
    PlayerData[playerid][pBusiness]   = 0;
    PlayerData[playerid][pRentHouse]  = 0;
    PlayerData[playerid][pRentHotel]  = 0;
    PlayerData[playerid][pSpawn]      = 1;
    PlayerData[playerid][pOnDuty]     = false;
    PlayerData[playerid][pKey1]       = 0;
    PlayerData[playerid][pKey2]       = 0;
    PlayerData[playerid][pKey3]       = 0;
    PlayerData[playerid][pDrivingLicA_exp][0] = EOS;
    PlayerData[playerid][pDrivingLicB_exp][0] = EOS;
    PlayerData[playerid][pDrivingLicC_exp][0] = EOS;
    PlayerData[playerid][pDrivingLicD_exp][0] = EOS;
    PlayerData[playerid][pAirLicA_exp][0] = EOS;
    PlayerData[playerid][pAirLicH_exp][0] = EOS;
    PlayerData[playerid][pWeaponLicW_exp][0] = EOS;
    PlayerData[playerid][pDiseased]       = false;
    PlayerData[playerid][pDiseasePaydays] = 0;
    PlayerData[playerid][pCaravanKey]      = 0;
    PlayerData[playerid][pFarmKey]         = 0;
    Player_RecalcSpawn(playerid);

    AC_SetVW(playerid, 0);
    SetPlayerMapIcon(playerid, 0, 846.4172, -2059.0867, 12.8672, 35, 0, MAPICON_LOCAL);
    SetPlayerColor(playerid, FactionColors[FACTION_NONE]);
    Factions_SetPlayerIcons(playerid);
    Pizza_SetPlayerIcons(playerid);
    Burger_SetPlayerIcons(playerid);
    BBall_SetPlayerIcon(playerid);

    LoginBG_Destroy(playerid);

    SCM(playerid, COLOR_SUCCESS,
        C_SUCCESS"Success: "C_WHITE"Registration successful! You are now logged in.");
    SCM(playerid, COLOR_INFO,
        "Info: You can choose a religion to belong to with /setreligion. See what each one believes with /whatreligion.");
    SpawnPlayer(playerid);
    HUD_Show(playerid);
    return 1;
}

// ============================================================
//  LOGIN
// ============================================================
stock Player_Login(playerid, const pass[])
{
    if(strcmp(pass, PlayerData[playerid][pPass], false) != 0)
    {
        SCM(playerid, COLOR_ERROR,
            C_ERROR"Error: "C_WHITE"Incorrect password!");
        return;
    }

    new query[960];
    mysql_format(g_SQL, query, sizeof(query),
        "SELECT `id`,`password`,`email`,`level`,`money`,`bank`,`rp`,`admin_level`,`faction`,`faction_rank`,`faction_join`,`house`,`hotel`,`business`,`rent_house`,`rent_hotel`,`spawn_type`,`key1`,`key2`,`key3`,\
         `driving_lic_a_exp`,`driving_lic_b_exp`,`driving_lic_c_exp`,`driving_lic_d_exp`,`airplane_lic_a_exp`,`airplane_lic_h_exp`,`weapon_lic_w_exp`,`diseased`,`disease_paydays`,\
         `caravan_key`,`is_president`,`voted`,`was_president`,`gov_role`,`job`,`phone_model`,`phone_number`,`medkits`,`extinguishers`,`mute_expire`,`wanted_level`,`jail_seconds`,`rob_points`,`skin`,`gas_can`,`watch_model`,`phone_expire`,`watch_expire`,`tired`,`warns`,`vip`,`gamble_wagered`,`fishing_rod`,`forest_key`,`bb_key`,`has_gps`,`phone_book`,`coffee`,`lastPrayDate`,`religion`,`language` \
         FROM `players` WHERE `id`=%d LIMIT 1",
        PlayerData[playerid][pID]);
    mysql_tquery(g_SQL, query, "OnPlayerLogin", "i", playerid);
}

public OnPlayerLogin(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    cache_get_value_name_int(0, "id",          PlayerData[playerid][pID]);
    cache_get_value_name    (0, "password",    PlayerData[playerid][pPass],  64);
    cache_get_value_name    (0, "email",       PlayerData[playerid][pEmail], 64);
    cache_get_value_name_int(0, "level",       PlayerData[playerid][pLevel]);
    cache_get_value_name_int(0, "money",       PlayerData[playerid][pMoney]);
    cache_get_value_name_int(0, "bank",        PlayerData[playerid][pBank]);
    cache_get_value_name_int(0, "rp",          PlayerData[playerid][pRP]);
    cache_get_value_name_int(0, "admin_level", PlayerData[playerid][pAdminLevel]);
    cache_get_value_name_int(0, "faction",      PlayerData[playerid][pFaction]);
    cache_get_value_name_int(0, "faction_rank", PlayerData[playerid][pFactionRank]);

    new factionJoinStr[11];
    cache_get_value_name(0, "faction_join", factionJoinStr, sizeof(factionJoinStr));
    PlayerData[playerid][pFactionJoin] = DateStrToUnix(factionJoinStr);

    cache_get_value_name_int(0, "house",       PlayerData[playerid][pHouse]);
    cache_get_value_name_int(0, "hotel",       PlayerData[playerid][pHotel]);
    cache_get_value_name_int(0, "business",    PlayerData[playerid][pBusiness]);
    cache_get_value_name_int(0, "rent_house",  PlayerData[playerid][pRentHouse]);
    cache_get_value_name_int(0, "rent_hotel",  PlayerData[playerid][pRentHotel]);
    cache_get_value_name_int(0, "spawn_type",  PlayerData[playerid][pSpawn]);
    cache_get_value_name_int(0, "key1",        PlayerData[playerid][pKey1]);
    cache_get_value_name_int(0, "key2",        PlayerData[playerid][pKey2]);
    cache_get_value_name_int(0, "key3",        PlayerData[playerid][pKey3]);
    cache_get_value_name(0, "driving_lic_a_exp", PlayerData[playerid][pDrivingLicA_exp], 11);
    cache_get_value_name(0, "driving_lic_b_exp", PlayerData[playerid][pDrivingLicB_exp], 11);
    cache_get_value_name(0, "driving_lic_c_exp", PlayerData[playerid][pDrivingLicC_exp], 11);
    cache_get_value_name(0, "driving_lic_d_exp", PlayerData[playerid][pDrivingLicD_exp], 11);
    cache_get_value_name(0, "airplane_lic_a_exp", PlayerData[playerid][pAirLicA_exp], 11);
    cache_get_value_name(0, "airplane_lic_h_exp", PlayerData[playerid][pAirLicH_exp], 11);
    cache_get_value_name(0, "weapon_lic_w_exp", PlayerData[playerid][pWeaponLicW_exp], 11);

    new diseasedInt;
    cache_get_value_name_int(0, "diseased",        diseasedInt);
    cache_get_value_name_int(0, "disease_paydays", PlayerData[playerid][pDiseasePaydays]);
    PlayerData[playerid][pDiseased] = bool:diseasedInt;

    cache_get_value_name_int(0, "caravan_key", PlayerData[playerid][pCaravanKey]);
    Caravan_ShowParked(playerid);

    Farm_SyncPlayerKey(playerid); // seteaza pFarmKey dupa numele proprietarului fermei
    Forest_SyncPlayerKey(playerid); // seteaza pForestKey dupa padurea detinuta
    BB_SyncPlayerKey(playerid); // seteaza pBBKey dupa billboard-ul detinut

    new presInt, votedInt, wasPresInt;
    cache_get_value_name_int(0, "is_president",  presInt);
    cache_get_value_name_int(0, "voted",         votedInt);
    cache_get_value_name_int(0, "was_president", wasPresInt);
    PlayerData[playerid][pIsPresident]  = bool:presInt;
    PlayerData[playerid][pVoted]        = bool:votedInt;
    PlayerData[playerid][pWasPresident] = bool:wasPresInt;
    cache_get_value_name_int(0, "gov_role", PlayerData[playerid][pGovRole]);

    cache_get_value_name_int(0, "job", PlayerData[playerid][pJob]);
    cache_get_value_name_int(0, "phone_model",  PlayerData[playerid][pPhoneModel]);
    cache_get_value_name_int(0, "phone_number", PlayerData[playerid][pPhoneNumber]);
    // Implicit dupa login jucatorul NU are medical kit / extinctor la el (nu se pastreaza intre sesiuni)
    PlayerData[playerid][pMedkits]       = 0;
    PlayerData[playerid][pExtinguishers] = 0;
    cache_get_value_name_int(0, "mute_expire",   PlayerData[playerid][pMuteExpire]);
    cache_get_value_name_int(0, "wanted_level",  PlayerData[playerid][pWanted]);
    if(PlayerData[playerid][pWanted] < 0) PlayerData[playerid][pWanted] = 0;
    if(PlayerData[playerid][pWanted] > 6) PlayerData[playerid][pWanted] = 6;
    SetPlayerWantedLevel(playerid, PlayerData[playerid][pWanted]);
    cache_get_value_name_int(0, "jail_seconds",  PlayerData[playerid][pJailSeconds]);
    if(PlayerData[playerid][pJailSeconds] < 0) PlayerData[playerid][pJailSeconds] = 0;
    cache_get_value_name_int(0, "rob_points",    PlayerData[playerid][pRobPoints]);
    if(PlayerData[playerid][pRobPoints] < 0) PlayerData[playerid][pRobPoints] = 0;
    if(PlayerData[playerid][pRobPoints] > ROB_POINTS_MAX) PlayerData[playerid][pRobPoints] = ROB_POINTS_MAX;
    cache_get_value_name_int(0, "skin", PlayerData[playerid][pSkin]);
    if(PlayerData[playerid][pSkin] < 0 || PlayerData[playerid][pSkin] > 311) PlayerData[playerid][pSkin] = SKIN_DEFAULT;
    // canistra se pastreaza intre sesiuni si peste moarte (spre deosebire de medkit/extinctor)
    cache_get_value_name_int(0, "gas_can", PlayerData[playerid][pGasCan]);
    if(PlayerData[playerid][pGasCan] < GASCAN_NONE || PlayerData[playerid][pGasCan] > GASCAN_FULL)
        PlayerData[playerid][pGasCan] = GASCAN_NONE;
    cache_get_value_name_int(0, "watch_model", PlayerData[playerid][pWatchModel]);
    if(PlayerData[playerid][pWatchModel] < -1 || PlayerData[playerid][pWatchModel] >= WATCH_MODEL_COUNT)
        PlayerData[playerid][pWatchModel] = -1;
    cache_get_value_name_int(0, "phone_expire", PlayerData[playerid][pPhoneExpire]);
    new watchExpBuf[11];
    cache_get_value_name(0, "watch_expire", watchExpBuf, sizeof(watchExpBuf));
    PlayerData[playerid][pWatchExpire] = DateStrToUnix(watchExpBuf);
    cache_get_value_name_int(0, "tired", PlayerData[playerid][pTired]);
    if(PlayerData[playerid][pTired] < 0) PlayerData[playerid][pTired] = 0;
    if(PlayerData[playerid][pTired] > TIRED_MAX) PlayerData[playerid][pTired] = TIRED_MAX;
    cache_get_value_name_int(0, "warns", PlayerData[playerid][pWarns]);
    if(PlayerData[playerid][pWarns] < 0) PlayerData[playerid][pWarns] = 0;
    new vipInt;
    cache_get_value_name_int(0, "vip", vipInt);
    PlayerData[playerid][pVIP] = bool:vipInt;
    cache_get_value_name_int(0, "gamble_wagered", PlayerData[playerid][pGambleWagered]);
    if(PlayerData[playerid][pGambleWagered] < 0) PlayerData[playerid][pGambleWagered] = 0;
    new fishRodInt;
    cache_get_value_name_int(0, "fishing_rod", fishRodInt);
    PlayerData[playerid][pFishingRod] = bool:fishRodInt;
    cache_get_value_name_int(0, "forest_key", PlayerData[playerid][pForestKey]);
    cache_get_value_name_int(0, "bb_key", PlayerData[playerid][pBBKey]);
    new gpsInt;
    cache_get_value_name_int(0, "has_gps", gpsInt);
    PlayerData[playerid][pHasGPS] = bool:gpsInt;
    new pbInt;
    cache_get_value_name_int(0, "phone_book", pbInt);
    PlayerData[playerid][pPhoneBook] = bool:pbInt;
    new coffeeInt;
    cache_get_value_name_int(0, "coffee", coffeeInt);
    PlayerData[playerid][pCoffee] = (coffeeInt < 0) ? 0 : coffeeInt; // nr. de cafele din ziua curenta (era 0/1 inainte de limita de 5)
    new lastPrayStr[11];
    cache_get_value_name(0, "lastPrayDate", lastPrayStr, sizeof(lastPrayStr));
    PlayerData[playerid][pLastPray] = DateStrToUnix(lastPrayStr);
    cache_get_value_name_int(0, "religion", PlayerData[playerid][pReligion]);
    cache_get_value_name(0, "language", PlayerData[playerid][pLanguage], 3);
    if(!strlen(PlayerData[playerid][pLanguage])) format(PlayerData[playerid][pLanguage], 3, "en");
    Lang_SetPlayer(playerid, PlayerData[playerid][pLanguage]);
    g_Sleeping[playerid] = false;
    g_FixReqType[playerid] = 0; // orice cerere de reparatie (Electrician) din sesiunea anterioara e invalidata

    // incarca skinurile detinute (owned) din player_skins
    new sq[96];
    mysql_format(g_SQL, sq, sizeof(sq), "SELECT `skin_id`,`qty` FROM `player_skins` WHERE `player_id`=%d", PlayerData[playerid][pID]);
    mysql_tquery(g_SQL, sq, "OnPlayerSkinsLoaded", "i", playerid);

    PlayerData[playerid][pLogged]  = true;
    PlayerData[playerid][pOnDuty]  = false;
    Player_RecalcSpawn(playerid);

    AC_SetVW(playerid, 0);
    SetPlayerColor(playerid, FactionColors[PlayerData[playerid][pFaction]]);
    Factions_SetPlayerIcons(playerid);
    Pizza_SetPlayerIcons(playerid);
    Burger_SetPlayerIcons(playerid);
    BBall_SetPlayerIcon(playerid);

    GivePlayerMoney(playerid, PlayerData[playerid][pMoney]);
    g_LastMoney[playerid] = PlayerData[playerid][pMoney];
    SetPlayerScore(playerid, PlayerData[playerid][pLevel]);

    if(PlayerData[playerid][pDiseased])
    {
        SetPlayerDrunkLevel(playerid, DISEASE_DRUNK_LEVEL);
        SCM(playerid, COLOR_ERROR,
            C_ERROR"Error: "C_WHITE"You are still sick. Go to the SMURD hospital and use "C_INFO"/curedisease"C_WHITE" to recover.");
    }

    // SGR: daca proprietarul are multe ambalaje acumulate, e avertizat sa le duca
    if(PlayerData[playerid][pHouse] != 0)
    {
        new sgrHidx = Houses_FindByID(PlayerData[playerid][pHouse]);
        if(sgrHidx != -1 && HouseData[sgrHidx][hSGR] >= HOUSE_SGR_WARN)
        {
            new sgrMsg[144];
            format(sgrMsg, sizeof(sgrMsg), T(playerid, C_ERROR"[SGR] "C_WHITE"Your house has "C_INFO"%d/100"C_WHITE" SGR containers piled up - deliver them soon ("C_INFO"/sgrload"C_WHITE")."), HouseData[sgrHidx][hSGR]);
            SCM(playerid, COLOR_ERROR, sgrMsg);
        }
    }

    // Trash: daca proprietarul are mult gunoi acumulat, e avertizat sa il duca
    if(PlayerData[playerid][pHouse] != 0)
    {
        new trashHidx = Houses_FindByID(PlayerData[playerid][pHouse]);
        if(trashHidx != -1 && HouseData[trashHidx][hTrash] >= HOUSE_TRASH_WARN)
        {
            new trashMsg[144];
            format(trashMsg, sizeof(trashMsg), T(playerid, C_ERROR"[Trash] "C_WHITE"Your house has "C_INFO"%d/100"C_WHITE" trash piled up - deliver it soon ("C_INFO"/trashload"C_WHITE")."), HouseData[trashHidx][hTrash]);
            SCM(playerid, COLOR_ERROR, trashMsg);
        }
    }

    LoginBG_Destroy(playerid);

    SCM(playerid, COLOR_SUCCESS,
        C_SUCCESS"Success: "C_WHITE"You have logged in successfully!");
    Reports_OnLogin(playerid);
    SpawnPlayer(playerid);
    HUD_Show(playerid);

    // Papagalul nu se reataseaza automat la login - ramane la casa pana la /parrot get (chiar daca DB avea isOnPlayer=1 dintr-o sesiune anterioara)
    Parrot_ForceOffByPID(PlayerData[playerid][pID]);
    return 1;
}

// ============================================================
//  SISTEM DE REPORTURI (/report, /reports, /reportreply) - persistat in DB
//  Max 2 reporturi deschise per jucator; adminii le vad in dialog (preview -> text complet);
//  la raspuns/rezolvare reportul e sters din DB (offline: pastrat pana la livrarea la login).
// ============================================================
#define MAX_OPEN_REPORTS_PER_PLAYER 2
#define REPORT_PREVIEW_LEN          40   // caractere din text afisate in lista dialog
#define MAX_REPORT_DIALOG           50   // reporturi maxime afisate in dialog
new g_ReportDialogIds[MAX_PLAYERS][MAX_REPORT_DIALOG]; // maparea listitem -> repID
new g_ReportDialogCount[MAX_PLAYERS];
new g_ReportViewId[MAX_PLAYERS];                       // reportul deschis in dialogul de vizualizare

forward OnReportSubmit(playerid, text[]);
forward OnReportsList(playerid);
forward OnReportView(playerid, repID);
forward OnReportReplyLookup(adminid, repID, text[]);
forward OnReportRepliesDeliver(playerid);
forward OnOpenReportsCount(playerid);

// La login: livreaza raspunsurile (apoi le sterge) + notifica adminii de reporturile deschise
stock Reports_OnLogin(playerid)
{
    new q[160];
    mysql_format(g_SQL, q, sizeof(q),
        "SELECT `adminName`,`reply` FROM `reports` WHERE `playerDbId`=%d AND `status`=1 ORDER BY `repID` ASC",
        PlayerData[playerid][pID]);
    mysql_tquery(g_SQL, q, "OnReportRepliesDeliver", "i", playerid);

    if(PlayerData[playerid][pAdminLevel] >= 1)
        mysql_tquery(g_SQL, "SELECT COUNT(*) AS c FROM `reports` WHERE `status`=0", "OnOpenReportsCount", "i", playerid);
}

// Trimite dialogul cu reporturile deschise (folosit de /reports si de butonul Back)
stock Reports_ShowList(playerid)
{
    mysql_tquery(g_SQL,
        "SELECT `repID`,`playerName`,`repText` FROM `reports` WHERE `status`=0 ORDER BY `repID` ASC",
        "OnReportsList", "i", playerid);
}

stock Report_Delete(repID)
{
    new q[96];
    mysql_format(g_SQL, q, sizeof(q), "DELETE FROM `reports` WHERE `repID`=%d", repID);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// /report -> verifica limita de reporturi deschise, apoi insereaza si difuzeaza
public OnReportSubmit(playerid, text[])
{
    if(!IsPlayerConnected(playerid) || !PlayerData[playerid][pLogged]) return 1;

    new c; cache_get_value_name_int(0, "c", c);
    if(c >= MAX_OPEN_REPORTS_PER_PLAYER)
    {
        new lmsg[160];
        format(lmsg, sizeof(lmsg), T(playerid, C_ERROR"Error: "C_WHITE"You already have "C_INFO"%d"C_WHITE" open reports. Wait for a reply before sending more."), c);
        return SCM(playerid, COLOR_ERROR, lmsg), 1;
    }

    new q[300];
    mysql_format(g_SQL, q, sizeof(q),
        "INSERT INTO `reports` (`playerName`,`playerDbId`,`repText`,`repDate`,`status`) VALUES ('%e',%d,'%e',%d,0)",
        PlayerData[playerid][pName], PlayerData[playerid][pID], text, gettime());
    mysql_tquery(g_SQL, q, "", "", 0);

    new rmsg[200];
    format(rmsg, sizeof(rmsg), "[REPORT] %s (ID %d): %s", PlayerData[playerid][pName], playerid, text);
    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pAdminLevel] >= 1)
            {
                format(rmsg, sizeof(rmsg), T(i, "[REPORT] %s (ID %d): %s"), PlayerData[playerid][pName], playerid, text);
                SCM(i, COLOR_YELLOW, rmsg);
            }

    SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"Your report has been sent to the admins.");
    return 1;
}

public OnReportRepliesDeliver(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    new rows = cache_num_rows();
    if(rows == 0) return 1;

    new aname[24], rtext[160], rline[200];
    for(new i = 0; i < rows; i++)
    {
        cache_get_value_name(i, "adminName", aname, sizeof(aname));
        cache_get_value_name(i, "reply", rtext, sizeof(rtext));
        format(rline, sizeof(rline), T(playerid, "[REPLY] %s: %s"), aname, rtext);
        SCM(playerid, COLOR_YELLOW, rline);
    }

    // raspunsurile au fost livrate -> sterge reporturile respective
    new q[96];
    mysql_format(g_SQL, q, sizeof(q), "DELETE FROM `reports` WHERE `playerDbId`=%d AND `status`=1", PlayerData[playerid][pID]);
    mysql_tquery(g_SQL, q, "", "", 0);
    return 1;
}

public OnOpenReportsCount(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    new c; cache_get_value_name_int(0, "c", c);
    if(c > 0)
    {
        new msg[128];
        format(msg, sizeof(msg), T(playerid, C_INFO"Info: "C_WHITE"There are "C_INFO"%d"C_WHITE" open report(s). Use "C_INFO"/reports"C_WHITE"."), c);
        SCM(playerid, COLOR_INFO, msg);
    }
    return 1;
}

// /reports -> dialog cu reporturile deschise (preview), maparea listitem -> repID per admin
public OnReportsList(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    new rows = cache_num_rows();
    if(rows == 0)
        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"There are no open reports."), 1;

    g_ReportDialogCount[playerid] = 0;
    static list[2048];
    new line[120], rid, rname[24], rtxt[160], preview[REPORT_PREVIEW_LEN + 4];
    list[0] = EOS;
    strcat(list, T(playerid, "ID\tPlayer\tReport\n"));
    for(new i = 0; i < rows && g_ReportDialogCount[playerid] < MAX_REPORT_DIALOG; i++)
    {
        cache_get_value_name_int(i, "repID", rid);
        cache_get_value_name(i, "playerName", rname, sizeof(rname));
        cache_get_value_name(i, "repText", rtxt, sizeof(rtxt));

        strmid(preview, rtxt, 0, REPORT_PREVIEW_LEN, sizeof(preview));
        if(strlen(rtxt) > REPORT_PREVIEW_LEN) strcat(preview, "...");

        format(line, sizeof(line), "%d\t%s\t%s\n", rid, rname, preview);
        strcat(list, line);

        g_ReportDialogIds[playerid][g_ReportDialogCount[playerid]] = rid;
        g_ReportDialogCount[playerid]++;
    }

    SPD(playerid, DIALOG_REPORTS_LIST, DIALOG_STYLE_TABLIST_HEADERS, "Open reports", list, "View", "Close");
    return 1;
}

// afiseaza textul complet al unui report (buton Resolve / Back)
public OnReportView(playerid, repID)
{
    if(!IsPlayerConnected(playerid)) return 1;
    if(cache_num_rows() == 0)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That report no longer exists."), 1;

    new rname[24], rtxt[160], rline[300];
    cache_get_value_name(0, "playerName", rname, sizeof(rname));
    cache_get_value_name(0, "repText", rtxt, sizeof(rtxt));

    g_ReportViewId[playerid] = repID;
    format(rline, sizeof(rline), T(playerid, "{FFFF00}Report #%d\n{E3E3E3}From: %s\n\n%s\n\n{D4A0A7}Reply: /reportreply %d [text]\nPress Resolve to close & delete this report."), repID, rname, rtxt, repID);
    SPD(playerid, DIALOG_REPORTS_VIEW, DIALOG_STYLE_MSGBOX, "Report", rline, "Resolve", "Back");
    return 1;
}

public OnReportReplyLookup(adminid, repID, text[])
{
    if(!IsPlayerConnected(adminid)) return 1;

    if(cache_num_rows() == 0)
        return SCM(adminid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid report ID."), 1;

    new status; cache_get_value_name_int(0, "status", status);
    if(status != 0)
        return SCM(adminid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That report is already answered."), 1;

    new pdbid; cache_get_value_name_int(0, "playerDbId", pdbid);
    new pname[24]; cache_get_value_name(0, "playerName", pname, sizeof(pname));

    // reporterul e online?
    new target = INVALID_PLAYER_ID;
    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pID] == pdbid) { target = i; break; }

    if(target != INVALID_PLAYER_ID)
    {
        // online -> livreaza acum si sterge reportul (rezolvat)
        new rmsg[200];
        format(rmsg, sizeof(rmsg), T(target, "[REPLY] %s: %s"), PlayerData[adminid][pName], text);
        SCM(target, COLOR_YELLOW, rmsg);
        Report_Delete(repID);

        new amsg[160];
        format(amsg, sizeof(amsg), T(adminid, C_SUCCESS"Success: "C_WHITE"Reply sent to "C_INFO"%s"C_WHITE" and report #%d resolved."), pname, repID);
        SCM(adminid, COLOR_SUCCESS, amsg);
    }
    else
    {
        // offline -> pastreaza raspunsul (status=1), se livreaza si se sterge la login-ul jucatorului
        new q[320];
        mysql_format(g_SQL, q, sizeof(q),
            "UPDATE `reports` SET `status`=1, `adminName`='%e', `reply`='%e' WHERE `repID`=%d",
            PlayerData[adminid][pName], text, repID);
        mysql_tquery(g_SQL, q, "", "", 0);

        new amsg[160];
        format(amsg, sizeof(amsg), T(adminid, C_SUCCESS"Success: "C_WHITE"Reply saved for "C_INFO"%s"C_WHITE" (report #%d); delivered on next login."), pname, repID);
        SCM(adminid, COLOR_SUCCESS, amsg);
    }
    return 1;
}

// ============================================================
//  SALVARE DATE JUCATOR
// ============================================================
stock FullUpdatePlayer(playerid)
{
    if(!PlayerData[playerid][pLogged]) return;

    new licA[14], licB[14], licC[14], licD[14], licAirA[14], licAirH[14], licW[14], facJoin[14], watchExp[14];
    BuildDateSqlValue(PlayerData[playerid][pDrivingLicA_exp], licA, sizeof(licA));
    BuildDateSqlValue(PlayerData[playerid][pDrivingLicB_exp], licB, sizeof(licB));
    BuildDateSqlValue(PlayerData[playerid][pDrivingLicC_exp], licC, sizeof(licC));
    BuildDateSqlValue(PlayerData[playerid][pDrivingLicD_exp], licD, sizeof(licD));
    BuildDateSqlValue(PlayerData[playerid][pAirLicA_exp], licAirA, sizeof(licAirA));
    BuildDateSqlValue(PlayerData[playerid][pAirLicH_exp], licAirH, sizeof(licAirH));
    BuildDateSqlValue(PlayerData[playerid][pWeaponLicW_exp], licW, sizeof(licW));
    BuildDateSqlValueFromUnix(PlayerData[playerid][pFactionJoin], facJoin, sizeof(facJoin));
    BuildDateSqlValueFromUnix(PlayerData[playerid][pWatchExpire], watchExp, sizeof(watchExp));

    new query[900];
    mysql_format(g_SQL, query, sizeof(query),
        "UPDATE `players` SET \
        `password`='%e', `level`=%d, `money`=%d, `bank`=%d, \
        `rp`=%d, `admin_level`=%d, `faction`=%d, `faction_rank`=%d, `faction_join`=%s, `house`=%d, `hotel`=%d, `business`=%d, `rent_house`=%d, `rent_hotel`=%d, `spawn_type`=%d, \
        `key1`=%d, `key2`=%d, `key3`=%d, \
        `driving_lic_a_exp`=%s, `driving_lic_b_exp`=%s, `driving_lic_c_exp`=%s, `driving_lic_d_exp`=%s, \
        `airplane_lic_a_exp`=%s, `airplane_lic_h_exp`=%s, `weapon_lic_w_exp`=%s, \
        `phone_model`=%d, `phone_number`=%d, `medkits`=%d, `extinguishers`=%d, `mute_expire`=%d, `wanted_level`=%d, `jail_seconds`=%d, `rob_points`=%d, `skin`=%d, `gas_can`=%d, `watch_model`=%d, `phone_expire`=%d, `watch_expire`=%s, `tired`=%d, `vip`=%d, `gamble_wagered`=%d \
        WHERE `id`=%d",
        PlayerData[playerid][pPass],
        PlayerData[playerid][pLevel],
        PlayerData[playerid][pMoney],
        PlayerData[playerid][pBank],
        PlayerData[playerid][pRP],
        PlayerData[playerid][pAdminLevel],
        PlayerData[playerid][pFaction],
        PlayerData[playerid][pFactionRank],
        facJoin,
        PlayerData[playerid][pHouse],
        PlayerData[playerid][pHotel],
        PlayerData[playerid][pBusiness],
        PlayerData[playerid][pRentHouse],
        PlayerData[playerid][pRentHotel],
        PlayerData[playerid][pSpawn],
        PlayerData[playerid][pKey1],
        PlayerData[playerid][pKey2],
        PlayerData[playerid][pKey3],
        licA, licB, licC, licD,
        licAirA, licAirH, licW,
        PlayerData[playerid][pPhoneModel],
        PlayerData[playerid][pPhoneNumber],
        PlayerData[playerid][pMedkits],
        PlayerData[playerid][pExtinguishers],
        PlayerData[playerid][pMuteExpire],
        PlayerData[playerid][pWanted],
        PlayerData[playerid][pJailSeconds],
        PlayerData[playerid][pRobPoints],
        PlayerData[playerid][pSkin],
        PlayerData[playerid][pGasCan],
        PlayerData[playerid][pWatchModel],
        PlayerData[playerid][pPhoneExpire],
        watchExp,
        PlayerData[playerid][pTired],
        PlayerData[playerid][pVIP],
        PlayerData[playerid][pGambleWagered],
        PlayerData[playerid][pID]);
    mysql_tquery(g_SQL, query, "", "", 0);
}

