    PlayerTextDrawSetOutline(playerid, Speedometer_Text[playerid][5], 0);
    PlayerTextDrawBackgroundColor(playerid, Speedometer_Text[playerid][5], 255);
    PlayerTextDrawFont(playerid, Speedometer_Text[playerid][5], 1);
    PlayerTextDrawSetProportional(playerid, Speedometer_Text[playerid][5], 1);

    Speedometer_Text[playerid][6] = CreatePlayerTextDraw(playerid, 600.000, 408.000, "Km: x%");
    PlayerTextDrawLetterSize(playerid, Speedometer_Text[playerid][6], 0.160, 1);
    PlayerTextDrawTextSize(playerid, Speedometer_Text[playerid][6], 50.000, 58.000);
    PlayerTextDrawAlignment(playerid, Speedometer_Text[playerid][6], 2);
    PlayerTextDrawColor(playerid, Speedometer_Text[playerid][6], 255);
    PlayerTextDrawUseBox(playerid, Speedometer_Text[playerid][6], 1);
    PlayerTextDrawBoxColor(playerid, Speedometer_Text[playerid][6], 1886483268);
    PlayerTextDrawSetShadow(playerid, Speedometer_Text[playerid][6], 0);
    PlayerTextDrawSetOutline(playerid, Speedometer_Text[playerid][6], 0);
    PlayerTextDrawBackgroundColor(playerid, Speedometer_Text[playerid][6], 255);
    PlayerTextDrawFont(playerid, Speedometer_Text[playerid][6], 1);
    PlayerTextDrawSetProportional(playerid, Speedometer_Text[playerid][6], 1);

    g_SpeedometerShown[playerid] = false;
    g_SpeedometerLockShown[playerid] = false;
    g_SpeedometerDirtyShown[playerid] = false;
    g_SpeedometerKmShown[playerid] = false;
}

stock Speedometer_Destroy(playerid)
{
    for(new i = 0; i < 7; i++)
    {
        if(Speedometer_Text[playerid][i] != PlayerText:INVALID_TEXT_DRAW)
        {
            PlayerTextDrawDestroy(playerid, Speedometer_Text[playerid][i]);
            Speedometer_Text[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
        }
    }
    g_SpeedometerShown[playerid] = false;
    g_SpeedometerLockShown[playerid] = false;
    g_SpeedometerDirtyShown[playerid] = false;
    g_SpeedometerKmShown[playerid] = false;
}

