    Turfs_Load();
    ATMs_Load();
    Bins_Load();
    FuelStations_Load();
    Billboards_Load();
    Shops_Load();
    ClothStores_Load(); // magazine de haine create in-game de admini (DB)
    Ammo_Load();         // magazine de arme create in-game de admini (DB)
    FastFood_Load();  // locatiile /pizza /burger din DB (dupa DB_Init, altfel g_SQL nu e gata)
    Locations_Load();
    BBallHoops_Load();
    BBallSpawns_Load();
    GovVehicles_Seed(); // seed la prima rulare, apoi apeleaza VehiclesFaction_Load()
    PVehicles_Load();
    Markets_Load();
    Caravans_Load();
    PayDay_Load(); // incarca setarile din server_setup, inclusiv treasury si charity (cause/fund)
    Races_Load();
    Forests_Load();
    Event_LoadConfig(); // evenimentul sezonier: nume, stare on/off + datele lui (daca ruleaza)
    Event_LoadFacts();  // curiozitatile despre sarbatori: date fixe, nu depind de starea evenimentului
    Farms_Load();     // ULTIMUL: OnFarmsLoaded afiseaza footer-ul "gamemode incarcat"

    SetTimer("PayDay_Check", 60000, true);
    SetTimer("AC_Tick", AC_TICK, true); // anticheat

    Hunt_Init();
    SetTimer("Hunt_Tick", 1000, true); // vanatoare: fuga/respawn caprioare
    SetTimer("RoadWork_Tick", 1000, true); // santier /roadworking: prinde playerii care intra in zona
    SetTimer("Event_Tick", 1000, true); // evenimente sezoniere: colectare obiecte + respawn
    SetTimer("President_Check", 60000, true);
    SetTimer("HealthDecay_Tick", HEALTH_DECAY_TICK, true);
    SetTimer("Appliance_ExpireTick", 300000, true); // sweep frigidere stricate: pierde itemele
    SetTimer("Fires_Tick", 1000, true);
    SetTimer("Jail_Tick", 1000, true);
    SetTimer("Radar_Tick", RADAR_TICK, true);
    SetTimer("Speedometer_Tick", SPEEDOMETER_TICK, true);
    SetTimer("ServerClock_Tick", SERVER_CLOCK_TICK, true);
    SetTimer("ServerTip_Tick", SERVERTIP_INTERVAL_MS, true); // mesaje informative periodice
    SetTimer("ExamC_TrailerTick", 2000, true);
    SetTimer("TeleGondola_CheckRiders", 2000, true); // detecteaza calatorii fara bilet pe telegondola

    ServerClock_Create();

    return 1;
}

public OnGameModeExit()
{
    mysql_close(g_SQL);
    return 1;
}

public OnPlayerConnect(playerid)
{
    AC_InitPlayer(playerid); // anticheat: initializeaza starea
    g_LoginAttempts[playerid] = 0;
    TeleGondola_ClearTicket(playerid); // biletul de gondola nu supravietuieste unei (de)conectari
    g_PlayerParrotID[playerid] = 0; // reatasat explicit la login, daca detine un papagal cu isOnPlayer=1
    g_HuntMeat[playerid] = 0;
    g_HasSniper[playerid] = false;
    g_BizDocsCarrying[playerid] = 0;

    // slotul e reutilizat de alt jucator: pornim de la zero cu obiectele de eveniment
    for(new eo = 0; eo < EVENT_MAX_OBJECTS; eo++)
    {
        g_EventPObj[playerid][eo]     = STREAMER_TAG_OBJECT:-1;
        g_EventPTaken[playerid][eo] = 0;
    }
    g_EventPickupState[playerid] = EVENT_PICKUPS_NONE; // ridicarile se recitesc din DB dupa logare
    Event_ResetNpcStateFor(playerid);                  // la fel si cu ce personaje a vorbit deja

    // Event CS: slotul e liber la conectare (nimic nu se pastreaza intre sesiuni)
    g_CSEvent[playerid]  = 0;
    g_CSSide[playerid]   = CS_SIDE_NONE;
    g_CSTeam[playerid]   = CS_TEAM_A;
    g_CSJoined[playerid] = false;
    g_CSAlive[playerid]  = false;
    g_CSBusy[playerid]   = false;

    // Event Hunt The Mayor: idem, nimic persistent
    g_HTMJoined[playerid]      = false;
    g_HTMParticipant[playerid] = false;
    g_HTMDamaged[playerid]     = false;
    g_HTMVehicle[playerid]     = -1;

    // Event Custom: idem, nimic persistent intre sesiuni
    g_CustomEventParticipant[playerid] = false;

    g_FarmWorking[playerid] = 0;
    g_FarmWorkVeh[playerid] = 0;
    g_FarmWorkTimer[playerid] = -1;
    g_FarmWorkSpawned[playerid] = false;
    g_FarmRentVeh[playerid] = 0;
    g_FarmDelivTruck[playerid] = 0;
    g_FarmDelivTrailer[playerid] = 0;

    // Acces blocat catre LS - sterge cladirile inlocuite de blocaj
    RemoveBuildingForPlayer(playerid, 8028, 1735.8594, 519.1563, 25.1563, 0.25);
    RemoveBuildingForPlayer(playerid, 8056, 1735.8594, 519.1563, 25.1563, 0.25);
    RemoveBuildingForPlayer(playerid, 8128, 1735.8750, 519.0078, 4.3594, 0.25);
    RemoveBuildingForPlayer(playerid, 8129, 1735.8750, 519.0078, 4.3594, 0.25);
    RemoveBuildingForPlayer(playerid, 1290, 1716.7813, 460.8906, 35.9688, 0.25);
    RemoveBuildingForPlayer(playerid, 1290, 1750.1094, 556.5469, 31.0391, 0.25);
    RemoveBuildingForPlayer(playerid, 3332, 445.4219, 565.4688, 24.5547, 0.25);
    RemoveBuildingForPlayer(playerid, 3333, 475.2344, 537.3203, 3.3203, 0.25);
    RemoveBuildingForPlayer(playerid, 3332, 491.3125, 499.9375, 24.5547, 0.25);
    RemoveBuildingForPlayer(playerid, 16431, 475.1250, 537.4375, 17.5859, 0.25);
    RemoveBuildingForPlayer(playerid, 3331, 445.4219, 565.4688, 24.5547, 0.25);
    RemoveBuildingForPlayer(playerid, 16357, 475.1250, 537.4375, 17.5859, 0.25);
    RemoveBuildingForPlayer(playerid, 3330, 475.2344, 537.3203, 3.3203, 0.25);
    RemoveBuildingForPlayer(playerid, 3331, 491.3125, 499.9375, 24.5547, 0.25);
    RemoveBuildingForPlayer(playerid, 792, 851.7969, -2066.3594, 12.1719, 0.25);
    RemoveBuildingForPlayer(playerid, 6005, 895.2578, -1256.9297, 31.2344, 0.25);
    RemoveBuildingForPlayer(playerid, 5838, 895.2578, -1256.9297, 31.2344, 0.25);
    RemoveBuildingForPlayer(playerid, 1312, 547.5703, -1251.2813, 19.8906, 0.25);
    RemoveBuildingForPlayer(playerid, 1211, 555.1563, -1251.9297, 16.6406, 0.25);

    // Zona SGR Unload: sterge cladirile inlocuite de decorul nou
    RemoveBuildingForPlayer(playerid, 3593, 2407.3125, -1418.3594, 23.6875, 0.25);
    RemoveBuildingForPlayer(playerid, 3593, 2413.3281, -1399.6094, 23.6875, 0.25);

    // Zona CarWash 1 / CarWash 3 (vwash): sterge cladirile inlocuite de decorul nou
    RemoveBuildingForPlayer(playerid, 1307, 787.6719, -1384.3828, 12.7813, 0.25);
