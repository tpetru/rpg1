#define JAIL_RELEASE_X  1810.2371
#define JAIL_RELEASE_Y  -1601.0844
#define JAIL_RELEASE_Z  13.5469
#define JAIL_RELEASE_A  321.1592

// durata (minute) si amenda ($) dupa wanted level; index 1-6 (0 nefolosit)
new const g_JailMinutes[7] = {0, 2, 4, 7, 11, 15, 20};
new const g_JailFine[7]    = {0, 1000, 2000, 3500, 5000, 7500, 10000};

// ============================================================
//  ROAD WORKING - santier temporar pe drum, /roadworking (admin 3+)
// ============================================================
#define ROADWORK_OBJECT_MODEL   4517
#define ROADWORK_Z_OFFSET       0.5    // inaltime suplimentara fata de pozitia adminului
#define ROADWORK_CATCH_RANGE    30.0   // raza in jurul centrului zonei care declanseaza prinderea
#define ROADWORK_CATCH_WANTED   4      // cate niveluri de wanted se adauga la intrarea in zona (plafonat la 6)
new bool:g_RoadWorkActive = false;
new STREAMER_TAG_OBJECT:g_RoadWorkObj1 = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
new STREAMER_TAG_OBJECT:g_RoadWorkObj2 = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
new g_RoadWorkName[32];
new g_RoadWorkPaydaysLeft = 0;
new Float:g_RoadWorkX, Float:g_RoadWorkY, Float:g_RoadWorkZ; // centrul zonei (pozitia adminului la creare)
new bool:g_RoadWorkInside[MAX_PLAYERS]; // true cat timp playerul e in raza zonei (edge-trigger la intrare)

// Trimite un mesaj tuturor jucatorilor logati (acelasi pattern ca President_BroadcastAll)
stock RoadWork_BroadcastAll(color, const text[])
{
    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged]) SCM(i, color, text);
}

// Distruge obiectele si reseteaza starea; daca announce=true, anunta ca zona a fost redeschisa
stock RoadWork_Clear(bool:announce = true)
{
    if(!g_RoadWorkActive) return;

    if(IsValidDynamicObject(g_RoadWorkObj1)) DestroyDynamicObject(g_RoadWorkObj1);
    if(IsValidDynamicObject(g_RoadWorkObj2)) DestroyDynamicObject(g_RoadWorkObj2);
    g_RoadWorkObj1 = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
    g_RoadWorkObj2 = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;

    if(announce)
    {
        new rwmsg[160];
        format(rwmsg, sizeof(rwmsg), C_SUCCESS"[Road Working] "C_WHITE"Zone \"%s\" has been successfully repaired, and traffic has been reopened to the public.", g_RoadWorkName);
        RoadWork_BroadcastAll(COLOR_SUCCESS, rwmsg);
    }

    g_RoadWorkActive       = false;
    g_RoadWorkPaydaysLeft  = 0;
    g_RoadWorkName[0]      = '\0';

    for(new i = 0; i < MAX_PLAYERS; i++) g_RoadWorkInside[i] = false;
}

// Apelat la fiecare PayDay: scade numarul de payday-uri ramase, si inchide zona cand ajunge la 0
stock RoadWork_PayDayTick()
{
    if(!g_RoadWorkActive) return;

    g_RoadWorkPaydaysLeft--;
    if(g_RoadWorkPaydaysLeft <= 0) RoadWork_Clear(true);
}

// La fiecare secunda: prinde playerii care tocmai au intrat in raza zonei (edge-trigger, doar o data per intrare)
forward RoadWork_Tick();
public RoadWork_Tick()
{
    if(!g_RoadWorkActive) return 1;

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged])
        {
            g_RoadWorkInside[i] = false;
            continue;
        }

        if(IsPlayerInRangeOfPoint(i, ROADWORK_CATCH_RANGE, g_RoadWorkX, g_RoadWorkY, g_RoadWorkZ))
        {
            if(!g_RoadWorkInside[i])
            {
                g_RoadWorkInside[i] = true;

                new oldWanted = PlayerData[i][pWanted];
                new newWanted = oldWanted + ROADWORK_CATCH_WANTED;
                if(newWanted > 6) newWanted = 6;

                PlayerData[i][pWanted] = newWanted;
                SetPlayerWantedLevel(i, newWanted);
                UpdatePlayer(i, pWanted);

                SCM(i, COLOR_ERROR, C_ERROR"[Road Working] "C_WHITE"You were caught in the road working zone, and your wanted level increased by "C_INFO"+4"C_WHITE".");

                if(!PlayerData[i][pDiseased])
                {
                    Disease_Infect(i);
                }
                else
                {
                    // deja bolnav: reseteaza progresul spre vindecarea naturala (DISEASE_CURE_PAYDAYS), prelungindu-i boala
                    PlayerData[i][pDiseasePaydays] = 0;
                    UpdatePlayer(i, pDiseasePaydays);
                    SCM(i, COLOR_ERROR, C_ERROR"[Road Working] "C_WHITE"Your illness got worse in the road working zone - your natural recovery has been reset.");
                }
            }
        }
        else
        {
            g_RoadWorkInside[i] = false;
        }
    }
    return 1;
}

forward Jail_Tick();

// ============================================================
//  MUNCA IN INCHISOARE (/workjail) - uda copacii sau cara lazi cu mere, in bucla, pana la /stopwork
// ============================================================
#define JAILWORK_NONE   0
#define JAILWORK_TREES  1
#define JAILWORK_CRATES 2

#define JAILWORK_STAGE_NONE   0
#define JAILWORK_STAGE_LEG1   1 // spre galeata cu apa / spre lada de mere
#define JAILWORK_STAGE_LEG2   2 // spre copac / spre punctul de livrare

#define JAILWORK_CP_SIZE      3.0
#define JAILWORK_REWARD_MONEY 5
#define JAILWORK_REWARD_HP    1.0

#define JAILWORK_TREE_COUNT 2
new Float:JAILWORK_FILL_X = 1754.3503, Float:JAILWORK_FILL_Y = -1535.9459, Float:JAILWORK_FILL_Z = 9.3969;
new Float:JAILWORK_TREE_X[JAILWORK_TREE_COUNT] = {1752.4871, 1799.1458};
new Float:JAILWORK_TREE_Y[JAILWORK_TREE_COUNT] = {-1564.5940, -1540.6816};
new Float:JAILWORK_TREE_Z[JAILWORK_TREE_COUNT] = {10.0426, 10.8343};

#define JAILWORK_TAKE_COUNT 2
new Float:JAILWORK_TAKE_X[JAILWORK_TAKE_COUNT] = {1822.3888, 1754.5188};
new Float:JAILWORK_TAKE_Y[JAILWORK_TAKE_COUNT] = {-1537.5940, -1589.3746};
new Float:JAILWORK_TAKE_Z[JAILWORK_TAKE_COUNT] = {13.5124, 13.4084};
new Float:JAILWORK_DELIVER_X = 1771.9949, Float:JAILWORK_DELIVER_Y = -1548.0421, Float:JAILWORK_DELIVER_Z = 9.9072;

// /eat si /drink din inchisoare (disponibile oricui e la inchisoare, indiferent daca lucreaza sau nu)
#define JAILFOOD_RANGE 2.0
#define JAILEAT_PRICE  11
#define JAILEAT_HP     20.0
#define JAILDRINK_PRICE 9
#define JAILDRINK_HP    15.0
new Float:JAILEAT_X = 1770.7762, Float:JAILEAT_Y = -1542.4515, Float:JAILEAT_Z = 9.4498;
new Float:JAILDRINK_X = 1767.6376, Float:JAILDRINK_Y = -1546.7706, Float:JAILDRINK_Z = 9.4266;

// /yard: iese din celula in curtea inchisorii (lume exterioara), sau se intoarce in celula daca e deja in curte
#define JAIL_YARD_RANGE 3.0
new Float:JAIL_YARD_X = 1772.2863, Float:JAIL_YARD_Y = -1547.7261, Float:JAIL_YARD_Z = 9.9075, Float:JAIL_YARD_A = 54.0626;

new g_JailWorkActivity[MAX_PLAYERS]; // JAILWORK_NONE/TREES/CRATES
new g_JailWorkStage[MAX_PLAYERS];    // JAILWORK_STAGE_NONE/LEG1/LEG2

// Porneste ruta "uda copacii": checkpoint la galeata cu apa
stock JailWork_StartTrees(playerid)
{
    g_JailWorkActivity[playerid] = JAILWORK_TREES;
    g_JailWorkStage[playerid]    = JAILWORK_STAGE_LEG1;
    Track_SetPlayerCheckpoint(playerid, JAILWORK_FILL_X, JAILWORK_FILL_Y, JAILWORK_FILL_Z, JAILWORK_CP_SIZE);
    SCM(playerid, COLOR_INFO, C_INFO"[Jail Work] "C_WHITE"Go fill your bucket with water.");
}

// Porneste ruta "cara lazile cu mere": checkpoint la o lada aleasa random
stock JailWork_StartCrates(playerid)
{
    g_JailWorkActivity[playerid] = JAILWORK_CRATES;
    g_JailWorkStage[playerid]    = JAILWORK_STAGE_LEG1;
    new t = random(JAILWORK_TAKE_COUNT);
    Track_SetPlayerCheckpoint(playerid, JAILWORK_TAKE_X[t], JAILWORK_TAKE_Y[t], JAILWORK_TAKE_Z[t], JAILWORK_CP_SIZE);
    SCM(playerid, COLOR_INFO, C_INFO"[Jail Work] "C_WHITE"Go pick up a crate of apples.");
}

// Recompenseaza un ciclu complet (ajuns la copac / livrat lada): -1hp, -1s pedeapsa, +5$
stock JailWork_GiveReward(playerid)
{
    new Float:hp;
    GetPlayerHealth(playerid, hp);
    SetPlayerHealth(playerid, hp - JAILWORK_REWARD_HP);

    if(PlayerData[playerid][pJailSeconds] > 0)
    {
        PlayerData[playerid][pJailSeconds]--;
        UpdatePlayer(playerid, pJailSeconds);
    }

    PlayerData[playerid][pMoney] += JAILWORK_REWARD_MONEY;
    GivePlayerMoney(playerid, JAILWORK_REWARD_MONEY);
    UpdatePlayer(playerid, pMoney);
}

// Opreste munca din inchisoare si sterge checkpoint-ul curent (/stopwork, moarte, sau eliberare)
stock JailWork_Stop(playerid)
{
    if(g_JailWorkActivity[playerid] == JAILWORK_NONE) return;
    g_JailWorkActivity[playerid] = JAILWORK_NONE;
    g_JailWorkStage[playerid]    = JAILWORK_STAGE_NONE;
    DisablePlayerCheckpoint(playerid);
}

// Apelat din OnPlayerEnterCheckpoint; returneaza 1 daca a gestionat checkpoint-ul curent
stock JailWork_HandleCheckpoint(playerid)
{
    if(g_JailWorkActivity[playerid] == JAILWORK_NONE) return 0;

    if(g_JailWorkActivity[playerid] == JAILWORK_TREES)
    {
        if(g_JailWorkStage[playerid] == JAILWORK_STAGE_LEG1)
        {
            // a umplut galeata -> checkpoint la un copac ales random
            g_JailWorkStage[playerid] = JAILWORK_STAGE_LEG2;
            new t = random(JAILWORK_TREE_COUNT);
            Track_SetPlayerCheckpoint(playerid, JAILWORK_TREE_X[t], JAILWORK_TREE_Y[t], JAILWORK_TREE_Z[t], JAILWORK_CP_SIZE);
            SCM(playerid, COLOR_INFO, C_INFO"[Jail Work] "C_WHITE"Go water the tree.");
        }
        else // LEG2: a ajuns la copac -> recompensa, apoi inapoi la galeata
        {
            JailWork_GiveReward(playerid);
            g_JailWorkStage[playerid] = JAILWORK_STAGE_LEG1;
            Track_SetPlayerCheckpoint(playerid, JAILWORK_FILL_X, JAILWORK_FILL_Y, JAILWORK_FILL_Z, JAILWORK_CP_SIZE);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Jail Work] "C_WHITE"You watered the tree. Go refill your bucket.");
        }
        return 1;
    }

    if(g_JailWorkActivity[playerid] == JAILWORK_CRATES)
    {
        if(g_JailWorkStage[playerid] == JAILWORK_STAGE_LEG1)
        {
            // a luat lada -> checkpoint la punctul de livrare
            g_JailWorkStage[playerid] = JAILWORK_STAGE_LEG2;
            Track_SetPlayerCheckpoint(playerid, JAILWORK_DELIVER_X, JAILWORK_DELIVER_Y, JAILWORK_DELIVER_Z, JAILWORK_CP_SIZE);
            SCM(playerid, COLOR_INFO, C_INFO"[Jail Work] "C_WHITE"Go deliver the crate.");
        }
        else // LEG2: a livrat lada -> recompensa, apoi checkpoint la o lada noua, aleasa random
        {
            JailWork_GiveReward(playerid);
            g_JailWorkStage[playerid] = JAILWORK_STAGE_LEG1;
            new t = random(JAILWORK_TAKE_COUNT);
            Track_SetPlayerCheckpoint(playerid, JAILWORK_TAKE_X[t], JAILWORK_TAKE_Y[t], JAILWORK_TAKE_Z[t], JAILWORK_CP_SIZE);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Jail Work] "C_WHITE"You delivered the crate. Go pick up another one.");
        }
        return 1;
    }

    return false;
}

// Teleporteaza inculpatul in celula (daca e configurata) si aplica uniforma de detinut
// ---- Catuse (/cuff): un politist incatuseaza un pasager din aceeasi masina de politie; cat e incatusat nu poate cobora ----
new bool:g_Cuffed[MAX_PLAYERS];
new g_CuffedBy[MAX_PLAYERS] = {INVALID_PLAYER_ID, ...}; // politistul care l-a incatusat

stock Cuff_Clear(playerid)
{
    if(!g_Cuffed[playerid]) return;
    g_Cuffed[playerid] = false;
    g_CuffedBy[playerid] = INVALID_PLAYER_ID;
    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
    TogglePlayerControllable(playerid, 1); // cat a fost incatusat in masina era blocat pe loc (nu putea cobora)
}

// Politistul a iesit din masina / s-a deconectat / a murit / a dat respawn: cei incatusati de el primesc uncuff automat
stock Cuff_ReleaseBy(copid)
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!g_Cuffed[i] || g_CuffedBy[i] != copid) continue;
        Cuff_Clear(i);
        if(IsPlayerConnected(i))
            SCM(i, COLOR_INFO, C_INFO"[P.R.] "C_WHITE"The officer is gone - your handcuffs were removed automatically. You can leave the vehicle now.");
    }
}

stock Jail_Send(playerid)
{
    Cuff_Clear(playerid); // intra in celula fara catuse
    if(JAIL_X != 0.0 || JAIL_Y != 0.0)
    {
        // Scoate din vehicul, apoi interior + virtual world INAINTE de pozitie (altfel apare cu interiorul vechi)
        if(IsPlayerInAnyVehicle(playerid)) RemovePlayerFromVehicle(playerid);
        AC_SetInterior(playerid, JAIL_INTERIOR);
        AC_SetVW(playerid, JAIL_VW);
        AC_SetPos(playerid, JAIL_X, JAIL_Y, JAIL_Z);
        SetCameraBehindPlayer(playerid);
    }
    SetPlayerSkin(playerid, JAIL_SKIN);
    SetPlayerHealth(playerid, 100.0);
}

// Elibereaza inculpatul: reseteaza timpul, il scoate din celula, ii reda skin-ul propriu
stock Jail_Release(playerid)
{
    Cuff_Clear(playerid);
    JailWork_Stop(playerid);
    PlayerData[playerid][pJailSeconds] = 0;
    UpdatePlayer(playerid, pJailSeconds);
    AC_SetInterior(playerid, 0);
    AC_SetVW(playerid, 0);
    AC_SetPos(playerid, JAIL_RELEASE_X + float(random(3) - 1), JAIL_RELEASE_Y + float(random(3) - 1), JAIL_RELEASE_Z);
    SetPlayerFacingAngle(playerid, JAIL_RELEASE_A);
    SetPlayerSkin(playerid, PlayerData[playerid][pSkin]);
    SetPlayerHealth(playerid, 100.0);
    SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[P.R.] "C_WHITE"You have served your sentence. You are free to go.");
}

// Ruleaza o data pe secunda: scade timpul de inchisoare si elibereaza la 0
public Jail_Tick()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
        if(PlayerData[i][pJailSeconds] <= 0) continue;
        PlayerData[i][pJailSeconds]--;
        if(PlayerData[i][pJailSeconds] <= 0)
        {
            PlayerData[i][pJailSeconds] = 0;
            Jail_Release(i);
        }
    }
    return 1;
}

#define FIRE_OBJECT_MODEL        18691 // obiect cu animatie de foc in bucla, spre deosebire de CreateExplosion poate fi distrus instant

enum E_FIRE_DATA
{
    bool:fireActive,
    Float:fireX, Float:fireY, Float:fireZ,
    fireRequired,
    fireProgress,
    fireObject
}
new FireData[MAX_FIRES][E_FIRE_DATA];

// Tine minte daca playerul era deja in raza incendiului tick-ul trecut (pentru gametext la intrare)
new bool:g_FireInRange[MAX_FIRES][MAX_PLAYERS];

// Cauta un slot liber in FireData, sau -1 daca limita e atinsa
stock Fires_FindFree()
{
    for(new i = 0; i < MAX_FIRES; i++)
        if(!FireData[i][fireActive]) return i;
    return -1;
}

// Stinge incendiul: distruge obiectul de foc pe loc, anunta SMURD-ul si sterge map icon-ul de la toti playerii
stock Fires_Extinguish(f, extinguisherId)
{
    FireData[f][fireActive] = false;

    if(FireData[f][fireObject] != 0)
    {
        DestroyObject(FireData[f][fireObject]);
        FireData[f][fireObject] = 0;
    }

    new colorcode[9];
    GetFactionColorCode(FACTION_SMURD, colorcode, sizeof(colorcode));

    new msg[160];
    format(msg, sizeof(msg), "[SMURD] "C_WHITE"Firefighter %s%s "C_WHITE"put out the fire.",
        colorcode, PlayerData[extinguisherId][pName]);

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i)) continue;
        RemovePlayerMapIcon(i, FIRE_ICON_SLOT_BASE + f);
        g_FireInRange[f][i] = false;
        if(PlayerData[i][pLogged])
            {
                format(msg, sizeof(msg), T(i, "[SMURD] "C_WHITE"Firefighter %s%s "C_WHITE"put out the fire."), colorcode, PlayerData[extinguisherId][pName]);
                SCM(i, FactionColors[FACTION_SMURD], msg);
            }
    }
}

// Creeaza un incendiu la coordonatele date (folosit de /createfire si de incendiul post-jaf). Returneaza -1 daca s-a atins limita.
// notifyMsg: mesajul trimis pompierilor de tura; "" foloseste mesajul implicit.
stock Fires_Create(Float:fx, Float:fy, Float:fz, const notifyMsg[] = "")
{
    new fidx = Fires_FindFree();
    if(fidx == -1) return -1;

    FireData[fidx][fireActive]   = true;
    FireData[fidx][fireX]        = fx;
    FireData[fidx][fireY]        = fy;
    FireData[fidx][fireZ]        = fz;
    FireData[fidx][fireRequired] = 5 + random(6); // 5-10 secunde
    FireData[fidx][fireProgress] = 0;
    for(new i = 0; i < MAX_PLAYERS; i++) g_FireInRange[fidx][i] = false;

    CreateExplosion(fx, fy, fz-1, 7, 0.0); // tip 7 = explozie mica
    FireData[fidx][fireObject] = CreateObject(FIRE_OBJECT_MODEL, fx, fy, fz - 1.0, 0.0, 0.0, 0.0);

    new fmsg[160];
    if(strlen(notifyMsg)) format(fmsg, sizeof(fmsg), "%s", notifyMsg);
    else format(fmsg, sizeof(fmsg), "[SMURD] "C_WHITE"A fire has broken out! Take the firetruck and put it out with water.");

    // incendiul (map icon) e vizibil tuturor; mesajul de chat doar pt. SMURD si News Reporters (orice tura)
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
        if(PlayerData[i][pFaction] == FACTION_SMURD || PlayerData[i][pFaction] == NEWS_FACTION_ID)
        {
            if(!strlen(notifyMsg))
                format(fmsg, sizeof(fmsg), T(i, "[SMURD] "C_WHITE"A fire has broken out! Take the firetruck and put it out with water."));
            SCM(i, COLOR_INFO, fmsg);
        }
        SetPlayerMapIcon(i, FIRE_ICON_SLOT_BASE + fidx, fx, fy, fz, FIRE_MAPICON_ID, 0, MAPICON_GLOBAL);
    }
    return fidx;
}

// Timer global (1s): verifica daca e stins de pompieri (animatia de foc ruleaza singura, in bucla, pe obiect)
public Fires_Tick()
{
    for(new f = 0; f < MAX_FIRES; f++)
    {
        if(!FireData[f][fireActive]) continue;

        new bool:beingExtinguished = false;
        new extinguisherId = INVALID_PLAYER_ID;
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
            if(PlayerData[i][pFaction] != FACTION_SMURD || !PlayerData[i][pOnDuty]) continue;

            new bool:inRange = bool:IsPlayerInRangeOfPoint(i, FIRE_EXTINGUISH_RANGE, FireData[f][fireX], FireData[f][fireY], FireData[f][fireZ]);
            if(inRange && !g_FireInRange[f][i])
                GTP(i, "Put out the fire", 3000, 3);
            g_FireInRange[f][i] = inRange;

            if(!inRange) continue;
            if(!IsPlayerInAnyVehicle(i)) continue;
            if(GetVehicleModel(GetPlayerVehicleID(i)) != FIRETRUCK_MODEL) continue;

            new keys, ud, lr;
            GetPlayerKeys(i, keys, ud, lr);
            if(!(keys & KEY_FIRE)) continue;

            beingExtinguished = true;
            extinguisherId = i;
        }

        if(beingExtinguished)
        {
            FireData[f][fireProgress]++;
            if(FireData[f][fireProgress] >= FireData[f][fireRequired])
                Fires_Extinguish(f, extinguisherId);
        }
        else
        {
            FireData[f][fireProgress] = 0;
        }
    }
    return 1;
}

// ============================================================
//  CAMERE RADAR (POLITIA)
// ============================================================
#define RADAR_RANGE       10.0
#define RADAR_TICK        1000 // 1 secunda, in ms

#define RADAR_OBJECT_MODEL 18654

new bool:g_RadarActive[MAX_PLAYERS];
new Float:g_RadarX[MAX_PLAYERS];
new Float:g_RadarY[MAX_PLAYERS];
new Float:g_RadarZ[MAX_PLAYERS];
new g_RadarSpeedLimit[MAX_PLAYERS];
new g_RadarFlaggedBy[MAX_PLAYERS] = {-1, ...}; // pentru fiecare player, ID-ul ofiterului al carui radar l-a avertizat deja (evita spam la fiecare tick)
new g_RadarObject[MAX_PLAYERS] = {-1, ...};
new Text3D:g_RadarLabel[MAX_PLAYERS] = {Text3D:INVALID_3DTEXT_ID, ...};

// Distruge obiectul si eticheta 3D ale radarului unui player, daca exista
stock Radar_DestroyProps(playerid)
{
    if(g_RadarObject[playerid] != -1)
    {
        DestroyObject(g_RadarObject[playerid]);
        g_RadarObject[playerid] = -1;
    }
    if(g_RadarLabel[playerid] != Text3D:INVALID_3DTEXT_ID)
    {
        Delete3DTextLabel(g_RadarLabel[playerid]);
        g_RadarLabel[playerid] = Text3D:INVALID_3DTEXT_ID;
    }
}

forward Radar_Tick();

// Returneaza viteza curenta a vehiculului in care se afla playerid, in km/h (aproximare standard SA-MP)
stock Float:GetPlayerVehicleSpeed(playerid)
{
    new vehid = GetPlayerVehicleID(playerid);
    if(vehid == 0) return 0.0;

    new Float:vx, Float:vy, Float:vz;
    GetVehicleVelocity(vehid, vx, vy, vz);
    return floatsqroot(vx * vx + vy * vy + vz * vz) * 180.0;
}

public Radar_Tick()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;

        if(GetPlayerVehicleID(i) == 0)
        {
            g_RadarFlaggedBy[i] = -1;
            continue;
        }

        // Daca e deja semnalat, verifica daca a iesit din raza radarului care l-a semnalat
        if(g_RadarFlaggedBy[i] != -1)
        {
            new j = g_RadarFlaggedBy[i];
            if(!g_RadarActive[j] || !IsPlayerInRangeOfPoint(i, RADAR_RANGE, g_RadarX[j], g_RadarY[j], g_RadarZ[j]))
                g_RadarFlaggedBy[i] = -1;
        }

        if(g_RadarFlaggedBy[i] != -1) continue;

        for(new j = 0; j < MAX_PLAYERS; j++)
        {
            if(i == j || !g_RadarActive[j]) continue;
            if(!IsPlayerInRangeOfPoint(i, RADAR_RANGE, g_RadarX[j], g_RadarY[j], g_RadarZ[j])) continue;

            new Float:speed = GetPlayerVehicleSpeed(i);
            new ispeed = floatround(speed);

            if(ispeed > g_RadarSpeedLimit[j])
            {
                g_RadarFlaggedBy[i] = j;

                new rmsg[256];
                format(rmsg, sizeof(rmsg), T(i, C_ERROR"[RADAR] "C_WHITE"You have exceeded the speed limit ("C_INFO"%d km/h"C_WHITE", limit "C_INFO"%d km/h"C_WHITE")! Pull over."),
                    ispeed, g_RadarSpeedLimit[j]);
                SCM(i, COLOR_ERROR, rmsg);
                Pray_FlagSin(i, 8); // Sfidarea vitezei

                format(rmsg, sizeof(rmsg), T(j, C_ERROR"[RADAR] "C_INFO"%s"C_WHITE" passed at "C_INFO"%d km/h"C_WHITE" (limit "C_INFO"%d km/h"C_WHITE", +"C_INFO"%d km/h"C_WHITE" over)."),
                    PlayerData[i][pName], ispeed, g_RadarSpeedLimit[j], ispeed - g_RadarSpeedLimit[j]);
                SCM(j, COLOR_ERROR, rmsg);
                break;
            }
        }
    }
    return 1;
}

// vehicleid (real) -> index in PVehicleData, sau -1 daca nu e vehicul personal
new g_VehicleToPVIndex[MAX_VEHICLES];

// Vehicule personale - declarate aici (inainte de Speedometer) ca PVehicleData sa fie
// accesibil in Speedometer_Tick (afisare + consum motorina). Definitiile aferente sunt in sectiunea "VEHICULE PERSONALE".
#define MAX_PERSONAL_VEHICLES   200
enum E_PVEHICLE_DATA
{
    pvID, pvOwnerId, pvModelID,
    pvColor1, pvColor2, pvPlate[24], pvPrice, // pvPlate: max 10 chars typed + optional VIP color code prefix ({FF2700} = 8 chars)
    Float:pvLocX, Float:pvLocY, Float:pvLocZ, Float:pvRotation,
    pvInsuranceExp, pvMedkitExp, pvExtinguisherExp, pvITPExp,
    bool:pvLocked,
    pvFirstReg,  // data primei inmatriculari (unix; 0 = neinmatriculata inca)
    pvFromBiz,   // business-ul de la care a fost cumparata
    Float:pvFuel, // nivelul de motorina (0.0 - 100.0)
    bool:pvIsConfiscated, // 1 = confiscat/tractat de DMV (motorul nu porneste pana la /redeemcar)
    pvForSale, // 1 = pus la vanzare de proprietar (alt player poate cumpara cu /vbuy)
    pvDirty, // nivel de murdarie (0-100); creste la fiecare respawn; >90 = motorul nu porneste (vezi /vwash)
    pvCountOwners, // numarul de proprietari pe care i-a avut vehiculul; +1 de fiecare data cand se schimba proprietarul
    bool:pvVip, // 1 = vehicul VIP: interval extins de culori (0-255 in loc de 0-127)
    bool:pvRetroVeh, // 1 = vehicul retro (marcaj informativ, afisat in /showUnusedVeh)
    pvWheels,    // component ID al jantelor instalate prin /tune (0 = default/niciuna)
    pvWheelsExp, // timestamp unix cand expira jantele (0 = nesetat); in DB e coloana `wheels_exp` de tip DATE
    pvLastStartEngine, // unix timestamp: ultima data cand s-a pornit motorul (/engine); folosit pentru vUnusedVeh
    bool:pvUnusedVeh, // 1 = motorul nu a mai fost pornit de peste 30 de zile (recalculat zilnic la 00:00); vezi /showUnusedVeh
    Float:pvKm // distanta totala parcursa (km); acumulata live din viteza (Speedometer_Tick), salvata cand soferul iese din masina
}
new PVehicleData[MAX_PERSONAL_VEHICLES][E_PVEHICLE_DATA];
new g_PVehicleVehicle[MAX_PERSONAL_VEHICLES];
new Text3D:g_PVehicleLabel[MAX_PERSONAL_VEHICLES] = {Text3D:INVALID_3DTEXT_ID, ...};
new g_PVehicleCount = 0;

// ============================================================
//  MURDARIE VEHICUL (dirty) + CARWASH
// ============================================================
#define VEHICLE_DIRTY_WARN    75   // de la acest nivel, jucatorul e avertizat sa spele masina
#define VEHICLE_DIRTY_LOCK    90   // peste acest nivel, motorul nu mai porneste
#define VEHICLE_DIRTY_MAX     100  // plafon
#define VEHICLE_UNUSED_DAYS   30   // zile de la ultima pornire a motorului dupa care vUnusedVeh devine 1
#define CARWASH_RANGE         5.0
#define CARWASH_PRICE         100

new Float:g_CarWash[4][3]; // suprascris din locations_admin (locID 70/71/72/73)

// Salveaza nivelul de murdarie in DB (doar vehicule personale - vehiculele de factiune nu se murdaresc)
stock Vehicle_SaveDirty(vehicleid)
{
    if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES) return;

    new pvidx = g_VehicleToPVIndex[vehicleid];
    if(pvidx == -1) return;

    new q[96];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `dirty`=%d WHERE `id`=%d",
        PVehicleData[pvidx][pvDirty], PVehicleData[pvidx][pvID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Salveaza in DB distanta totala parcursa (km) a unui vehicul (personal sau de factiune). Apelata cand
// soferul iese din masina (nu la fiecare tick - [pv/vf]Km e deja live, actualizat in Speedometer_Tick)
stock Vehicle_SaveKm(vehicleid)
{
    if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES) return;

    new pvidx = g_VehicleToPVIndex[vehicleid];
    if(pvidx != -1)
    {
        new q[96];
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `km`=%.2f WHERE `id`=%d",
            PVehicleData[pvidx][pvKm], PVehicleData[pvidx][pvID]);
        mysql_tquery(g_SQL, q, "", "", 0);
        return;
    }

    new vfidx = VFaction_FindByVehicle(vehicleid);
    if(vfidx != -1)
    {
        new q[96];
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_faction` SET `km`=%.2f WHERE `id`=%d",
            VFactionData[vfidx][vfKm], VFactionData[vfidx][vfID]);
        mysql_tquery(g_SQL, q, "", "", 0);
    }
}

// ---- Valabilitatea jantelor puse prin /tune ----
#define WHEELS_DAYS_PERSONAL  14  // zile, pe vehicule personale
#define WHEELS_DAYS_FACTION    7  // zile, pe vehicule de factiune

// "azi + N zile", normalizat la miezul noptii (coloanele `wheels_exp` sunt de tip DATE)
stock Wheels_ExpiryFromNow(days)
{
    new todayStart = gettime() - (gettime() % 86400);
    return todayStart + days * 86400;
}

// Salveaza in DB jantele puse prin /tune pe un vehicul personal, cu data de expirare
stock PVehicle_SaveWheels(pvidx, wheels)
{
    PVehicleData[pvidx][pvWheels]    = wheels;
    PVehicleData[pvidx][pvWheelsExp] = Wheels_ExpiryFromNow(WHEELS_DAYS_PERSONAL);

    new dateStr[11];
    UnixToDateStr(PVehicleData[pvidx][pvWheelsExp], dateStr, sizeof(dateStr));

    new q[160];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `wheels`=%d, `wheels_exp`='%s' WHERE `id`=%d",
        wheels, dateStr, PVehicleData[pvidx][pvID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Reseteaza jantele unui vehicul personal la valoarea default (0, fara janta custom)
stock PVehicle_ClearWheels(pvidx)
{
    PVehicleData[pvidx][pvWheels]    = 0;
    PVehicleData[pvidx][pvWheelsExp] = 0;

    new q[128];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `wheels`=0, `wheels_exp`=NULL WHERE `id`=%d",
        PVehicleData[pvidx][pvID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Salveaza in DB ultima pornire a motorului si reseteaza vUnusedVeh (masina tocmai a fost folosita)
stock Vehicle_SaveLastStartEngine(vehicleid)
{
    if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES) return;

    new pvidx = g_VehicleToPVIndex[vehicleid];
    if(pvidx == -1) return;

    new lseDate[16];
    UnixToDateStr(PVehicleData[pvidx][pvLastStartEngine], lseDate, sizeof(lseDate));

    new q[128];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `last_start_engine`='%s', `unused_veh`=0 WHERE `id`=%d",
        lseDate, PVehicleData[pvidx][pvID]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Ruleaza zilnic la 00:00 (vezi PayDay_Check): marcheaza vUnusedVeh=1 pentru vehiculele personale
// nepornite de peste VEHICLE_UNUSED_DAYS zile. Vehiculele niciodata pornite (pvLastStartEngine==0) sunt ignorate.
stock Vehicle_CheckUnusedDaily()
{
    new now = gettime();
    for(new i = 0; i < g_PVehicleCount; i++)
    {
        if(PVehicleData[i][pvLastStartEngine] <= 0) continue;
        if(PVehicleData[i][pvUnusedVeh]) continue;
        if(now - PVehicleData[i][pvLastStartEngine] <= VEHICLE_UNUSED_DAYS * 86400) continue;

        PVehicleData[i][pvUnusedVeh] = true;
        new q[96];
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `unused_veh`=1 WHERE `id`=%d", PVehicleData[i][pvID]);
        mysql_tquery(g_SQL, q, "", "", 0);
    }
}

// Creeaza pickup-urile + etichetele 3D ale spalatoriilor (pozitiile 0.0 sunt ignorate)
stock CarWash_Create()
{
    for(new i = 0; i < sizeof(g_CarWash); i++)
    {
        if(g_CarWash[i][0] == 0.0 && g_CarWash[i][1] == 0.0) continue;
        CreatePickup(19135, 1, g_CarWash[i][0], g_CarWash[i][1], g_CarWash[i][2], -1);
        new label[64];
        format(label, sizeof(label), "[ CarWash ]\n[ Type /v wash ]\n[ Price: %d$ ]", CARWASH_PRICE);
        Create3DTextLabel(label, COLOR_WHITE, g_CarWash[i][0], g_CarWash[i][1], g_CarWash[i][2] - 0.5, 20.0, 0, 0);
    }
}

stock bool:CarWash_PlayerAt(playerid)
{
    for(new i = 0; i < sizeof(g_CarWash); i++)
    {
        if(g_CarWash[i][0] == 0.0 && g_CarWash[i][1] == 0.0) continue;
        if(IsPlayerInRangeOfPoint(playerid, CARWASH_RANGE, g_CarWash[i][0], g_CarWash[i][1], g_CarWash[i][2]))
            return true;
    }
    return false;
}

