}

// ============================================================
//  MARKETPLACE - decontare vanzator la cumpararea unei proprietati
// ============================================================
// Deconteaza vanzatorul unei case/business/ferme: +price in banca, sterge pointerul (house/business/farm_key).
// Merge si daca vanzatorul e offline (scrie direct in DB). memField = campul PlayerData; col = coloana `players`.
stock Prop_SettleSeller(sellerId, price, const col[], E_PLAYER_DATA:memField, const propLabel[])
{
    if(sellerId <= 0) return;
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
        if(PlayerData[i][pID] != sellerId) continue;

        PlayerData[i][pBank]   += price;
        PlayerData[i][memField] = 0;

        new q[192];
        // col gol (ex. ferma) -> proprietatea nu e o coloana in `players`, doar banca
        if(strlen(col))
            mysql_format(g_SQL, q, sizeof(q), "UPDATE `players` SET `bank`=%d, `%s`=0 WHERE `id`=%d", PlayerData[i][pBank], col, PlayerData[i][pID]);
        else
            mysql_format(g_SQL, q, sizeof(q), "UPDATE `players` SET `bank`=%d WHERE `id`=%d", PlayerData[i][pBank], PlayerData[i][pID]);
        mysql_tquery(g_SQL, q, "", "", 0);

        new nm[144];
        format(nm, sizeof(nm), T(i, C_SUCCESS"[Sale] "C_WHITE"Your %s was bought for "C_INFO"$%s"C_WHITE" (deposited to your bank)."), propLabel, MoneyStr(price));
        SCM(i, COLOR_SUCCESS, nm);
        return;
    }
    // vanzator offline
    new q[192];
    if(strlen(col))
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `players` SET `bank`=`bank`+%d, `%s`=0 WHERE `id`=%d", price, col, sellerId);
    else
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `players` SET `bank`=`bank`+%d WHERE `id`=%d", price, sellerId);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Deconteaza vanzatorul unui vehicul personal: +price in banca, elibereaza slotul de cheie (key1/2/3).
stock Prop_SettleSellerVehicle(sellerId, price, vehDbId)
{
    if(sellerId <= 0) return;
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
        if(PlayerData[i][pID] != sellerId) continue;

        PlayerData[i][pBank] += price;
        PVehicles_ClearKeySlot(i, vehDbId); // elibereaza cheia + persista in DB

        new q[128];
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `players` SET `bank`=%d WHERE `id`=%d", PlayerData[i][pBank], PlayerData[i][pID]);
        mysql_tquery(g_SQL, q, "", "", 0);

        new nm[144];
        format(nm, sizeof(nm), T(i, C_SUCCESS"[Sale] "C_WHITE"Your vehicle was bought for "C_INFO"$%s"C_WHITE" (deposited to your bank)."), MoneyStr(price));
        SCM(i, COLOR_SUCCESS, nm);
        return;
    }
    // vanzator offline: +bank si golire slot cheie care contine vehDbId
    new q[224];
    mysql_format(g_SQL, q, sizeof(q),
        "UPDATE `players` SET `bank`=`bank`+%d, `key1`=IF(`key1`=%d,0,`key1`), `key2`=IF(`key2`=%d,0,`key2`), `key3`=IF(`key3`=%d,0,`key3`) WHERE `id`=%d",
        price, vehDbId, vehDbId, vehDbId, sellerId);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// ============================================================
//  LICITATII (auction system): /licitatie (admin), /bid (playeri)
//  Un singur admin poate scoate la licitatie o casa/business/ferma/hotel; jucatorii liciteaza cu /bid.
//  Banii se scad din BANCA la fiecare /bid (escrow) si se ramburseaza automat daca cineva liciteaza mai mult.
//  Proprietarul curent (daca exista) e evacuat DOAR daca licitatia se incheie cu un castigator (fara despagubire).
// ============================================================
#define AUCTION_NONE      0
#define AUCTION_HOUSE     1
#define AUCTION_BUSINESS  2
#define AUCTION_FARM      3
#define AUCTION_HOTEL     4
#define AUCTION_BID_SECONDS 90

new bool:g_AuctionActive = false;
new g_AuctionType = AUCTION_NONE;
new g_AuctionEntityID = 0;          // hID / bID / fmID / htlID
new g_AuctionStartPrice = 0;
new g_AuctionCurrentBid = 0;
new g_AuctionBidderPID = 0;         // pID persistent al ofertantului curent (0 = niciun ofertant inca)
new g_AuctionBidderName[24];
new g_AuctionPropName[32];
new g_AuctionSecondsLeft = 0;
new g_AuctionTimer = -1;

stock Auction_TypeName(type, dest[], destSize = sizeof(dest))
{
    if(type == AUCTION_HOUSE)         format(dest, destSize, "house");
    else if(type == AUCTION_BUSINESS) format(dest, destSize, "business");
    else if(type == AUCTION_FARM)     format(dest, destSize, "farm");
    else if(type == AUCTION_HOTEL)    format(dest, destSize, "hotel");
    else                              format(dest, destSize, "property");
}

// Trimite un mesaj tuturor playerilor logati
stock Auction_Announce(const msg[])
{
    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged])
            SCM(i, COLOR_INFO, msg);
}

// Ramburseaza in banca un ofertant depasit - functioneaza si daca s-a deconectat intre timp
stock Auction_RefundBidder(pid, amount)
{
    if(pid <= 0 || amount <= 0) return;
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
        if(PlayerData[i][pID] != pid) continue;

        PlayerData[i][pBank] += amount;
        UpdatePlayer(i, pBank);

        new nm[144];
        format(nm, sizeof(nm), T(i, C_INFO"[Auction] "C_WHITE"You were outbid - "C_INFO"$%s"C_WHITE" was refunded to your bank."), MoneyStr(amount));
        SCM(i, COLOR_INFO, nm);
        return;
    }
    // ofertant offline
    new q[128];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `players` SET `bank`=`bank`+%d WHERE `id`=%d", amount, pid);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Anunta statusul curent al licitatiei (folosit la marcajele de 60/30/5 secunde ramase)
stock Auction_AnnounceStatus(secondsLeft)
{
    new msg[220];
    if(g_AuctionBidderPID == 0)
    {
        format(msg, sizeof(msg), "[Auction] ""%d seconds left for ""'%s'""! No bids yet (starting price ""$%s""). Use ""/bid [amount]"".",
            secondsLeft, g_AuctionPropName, MoneyStr(g_AuctionStartPrice));
    }
    else
    {
        format(msg, sizeof(msg), C_INFO"[Auction] "C_WHITE"%d seconds left! "C_INFO"%s"C_WHITE" will win "C_INFO"'%s'"C_WHITE" for "C_INFO"$%s"C_WHITE"!",
            secondsLeft, g_AuctionBidderName, g_AuctionPropName, MoneyStr(g_AuctionCurrentBid));
    }
    Auction_Announce(msg);
}

stock Auction_Reset()
{
    g_AuctionActive       = false;
    g_AuctionType         = AUCTION_NONE;
    g_AuctionEntityID     = 0;
    g_AuctionStartPrice   = 0;
    g_AuctionCurrentBid   = 0;
    g_AuctionBidderPID    = 0;
    g_AuctionBidderName[0]= EOS;
    g_AuctionPropName[0]  = EOS;
    g_AuctionSecondsLeft  = 0;
}

// Incheie licitatia: atribuie proprietatea castigatorului (evacuand proprietarul curent, fara despagubire) sau anunta ca nu a fost nimeni.
stock Auction_Finish()
{
    if(g_AuctionTimer != -1) { KillTimer(g_AuctionTimer); g_AuctionTimer = -1; }

    if(g_AuctionBidderPID == 0)
    {
        new nmsg[160];
        format(nmsg, sizeof(nmsg), C_ERROR"[Auction] "C_WHITE"The auction for "C_INFO"'%s'"C_WHITE" ended with no bids. It remains unassigned.", g_AuctionPropName);
        Auction_Announce(nmsg);
        Auction_Reset();
        return;
    }

    new winnerOnline = -1;
    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pID] == g_AuctionBidderPID) { winnerOnline = i; break; }

    switch(g_AuctionType)
    {
        case AUCTION_HOUSE:
        {
            new hidx = Houses_FindByID(g_AuctionEntityID);
            if(hidx != -1)
            {
                if(HouseData[hidx][hOwned] && HouseData[hidx][hOwnerId] != g_AuctionBidderPID)
                    Auction_EvictOwner(HouseData[hidx][hOwnerId], pHouse, "house");

                HouseData[hidx][hOwned]   = 1;
                HouseData[hidx][hForSale] = 0;
                HouseData[hidx][hOwnerId] = g_AuctionBidderPID;
                format(HouseData[hidx][hOwnerName], 24, "%s", g_AuctionBidderName);
                Houses_RecreatePickup(hidx);

                new q[256];
                mysql_format(g_SQL, q, sizeof(q), "UPDATE `houses` SET `owner`='%e', `owner_id`=%d, `owned`=1, `is_for_sale`=0 WHERE `id`=%d",
                    HouseData[hidx][hOwnerName], HouseData[hidx][hOwnerId], HouseData[hidx][hID]);
                mysql_tquery(g_SQL, q, "", "", 0);

                if(winnerOnline != -1) { PlayerData[winnerOnline][pHouse] = HouseData[hidx][hID]; UpdatePlayer(winnerOnline, pHouse); }
                else
                {
                    new q2[96];
                    mysql_format(g_SQL, q2, sizeof(q2), "UPDATE `players` SET `house`=%d WHERE `id`=%d", HouseData[hidx][hID], g_AuctionBidderPID);
                    mysql_tquery(g_SQL, q2, "", "", 0);
                }
            }
        }
        case AUCTION_BUSINESS:
        {
            new bidx = Businesses_FindByID(g_AuctionEntityID);
            if(bidx != -1)
            {
                if(BusinessData[bidx][bOwned] && BusinessData[bidx][bOwnerId] != g_AuctionBidderPID)
                    Auction_EvictOwner(BusinessData[bidx][bOwnerId], pBusiness, "business");

                BusinessData[bidx][bOwned]   = 1;
                BusinessData[bidx][bForSale] = 0;
                BusinessData[bidx][bOwnerId] = g_AuctionBidderPID;
                format(BusinessData[bidx][bOwnerName], 24, "%s", g_AuctionBidderName);
                Businesses_RecreatePickup(bidx);

                new q[256];
                mysql_format(g_SQL, q, sizeof(q), "UPDATE `businesses` SET `owner`='%e', `owner_id`=%d, `owned`=1, `is_for_sale`=0 WHERE `id`=%d",
                    BusinessData[bidx][bOwnerName], BusinessData[bidx][bOwnerId], BusinessData[bidx][bID]);
                mysql_tquery(g_SQL, q, "", "", 0);

                if(winnerOnline != -1) { PlayerData[winnerOnline][pBusiness] = BusinessData[bidx][bID]; UpdatePlayer(winnerOnline, pBusiness); }
                else
                {
                    new q2[96];
                    mysql_format(g_SQL, q2, sizeof(q2), "UPDATE `players` SET `business`=%d WHERE `id`=%d", BusinessData[bidx][bID], g_AuctionBidderPID);
                    mysql_tquery(g_SQL, q2, "", "", 0);
                }
            }
        }
        case AUCTION_FARM:
        {
            new fidx = Farm_IndexByID(g_AuctionEntityID);
            if(fidx != -1)
            {
                if(FarmData[fidx][fmOwned] && FarmData[fidx][fmOwnerId] != g_AuctionBidderPID)
                    Auction_EvictOwner(FarmData[fidx][fmOwnerId], pFarmKey, ""); // ferma nu e coloana in `players`

                FarmData[fidx][fmOwned]   = 1;
                FarmData[fidx][fmForSale] = 0;
                FarmData[fidx][fmOwnerId] = g_AuctionBidderPID;
                format(FarmData[fidx][fmOwnerName], 24, "%s", g_AuctionBidderName);
                Farm_RecreatePickup(fidx);

                new q[256];
                mysql_format(g_SQL, q, sizeof(q), "UPDATE `farms` SET `owner`='%e', `owner_id`=%d, `isOwned`=1, `is_for_sale`=0 WHERE `id`=%d",
                    FarmData[fidx][fmOwnerName], FarmData[fidx][fmOwnerId], FarmData[fidx][fmID]);
                mysql_tquery(g_SQL, q, "", "", 0);

                // pFarmKey nu e coloana in `players` - se deriva la login din farms.owner_id (Farm_SyncPlayerKey)
                if(winnerOnline != -1) PlayerData[winnerOnline][pFarmKey] = FarmData[fidx][fmID];
            }
        }
        case AUCTION_HOTEL:
        {
            new htlidx = Hotels_FindByID(g_AuctionEntityID);
            if(htlidx != -1)
            {
                if(HotelData[htlidx][htlOwned] && HotelData[htlidx][htlOwnerId] != g_AuctionBidderPID)
                    Auction_EvictOwner(HotelData[htlidx][htlOwnerId], pHotel, "hotel");

                HotelData[htlidx][htlOwned]   = 1;
                HotelData[htlidx][htlForSale] = 0;
                HotelData[htlidx][htlOwnerId] = g_AuctionBidderPID;
                format(HotelData[htlidx][htlOwnerName], 24, "%s", g_AuctionBidderName);
                Hotels_RecreatePickup(htlidx);

                new q[256];
                mysql_format(g_SQL, q, sizeof(q), "UPDATE `hotels` SET `owner`='%e', `owner_id`=%d, `owned`=1, `is_for_sale`=0 WHERE `id`=%d",
                    HotelData[htlidx][htlOwnerName], HotelData[htlidx][htlOwnerId], HotelData[htlidx][htlID]);
                mysql_tquery(g_SQL, q, "", "", 0);

                if(winnerOnline != -1) { PlayerData[winnerOnline][pHotel] = HotelData[htlidx][htlID]; UpdatePlayer(winnerOnline, pHotel); }
                else
                {
                    new q2[96];
                    mysql_format(g_SQL, q2, sizeof(q2), "UPDATE `players` SET `hotel`=%d WHERE `id`=%d", HotelData[htlidx][htlID], g_AuctionBidderPID);
                    mysql_tquery(g_SQL, q2, "", "", 0);
                }
            }
        }
    }

    new wmsg[200];
    format(wmsg, sizeof(wmsg), C_SUCCESS"[Auction] "C_WHITE"Auction ended! "C_INFO"%s"C_WHITE" won "C_INFO"'%s'"C_WHITE" for "C_INFO"$%s"C_WHITE"!",
        g_AuctionBidderName, g_AuctionPropName, MoneyStr(g_AuctionCurrentBid));
    Auction_Announce(wmsg);

    Auction_Reset();
}

// Evacueaza proprietarul curent (fara despagubire) inainte de a atribui proprietatea castigatorului licitatiei.
// memField/col: campul din PlayerData si coloana din `players` (col gol = fara coloana, ex. ferma).
stock Auction_EvictOwner(evictedPID, E_PLAYER_DATA:memField, const col[])
{
    if(evictedPID <= 0) return;
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
        if(PlayerData[i][pID] != evictedPID) continue;

        PlayerData[i][memField] = 0;
        if(strlen(col)) UpdatePlayer(i, memField);
        SCM(i, COLOR_ERROR, C_ERROR"[Auction] "C_WHITE"Your property was reclaimed by an admin for an auction (no compensation).");
        return;
    }
    if(strlen(col))
    {
        new q[96];
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `players` SET `%s`=0 WHERE `id`=%d", col, evictedPID);
        mysql_tquery(g_SQL, q, "", "", 0);
    }
}

forward Auction_Tick();
public Auction_Tick()
{
    if(!g_AuctionActive) { g_AuctionTimer = -1; return 1; }

    g_AuctionSecondsLeft--;

    if(g_AuctionSecondsLeft == 60 || g_AuctionSecondsLeft == 30 || g_AuctionSecondsLeft == 5)
        Auction_AnnounceStatus(g_AuctionSecondsLeft);

    if(g_AuctionSecondsLeft <= 0)
        Auction_Finish();

    return 1;
}

// Trimite catre viewerid raportul complet de stats al lui targetid (folosit de /stats si /showstats)
stock Player_ShowStats(viewerid, targetid)
{
    new line[256];
    new email[80] = "not set";
    if(strlen(PlayerData[targetid][pEmail]))
        format(email, sizeof(email), "%s", PlayerData[targetid][pEmail]);

    new fid = PlayerData[targetid][pFaction];
    new colorcode[9], fname[45];
    if(fid > 0 && fid <= MAX_FACTIONS)
    {
        GetFactionColorCode(fid, colorcode, sizeof(colorcode));
        format(fname, sizeof(fname), "%s%s (%d)"C_WHITE, colorcode, FactionData[fid][fName], PlayerData[targetid][pFactionRank]);
    }
    else fname = "No faction";

    new jobName[32];
    if(PlayerData[targetid][pJob] >= 1 && PlayerData[targetid][pJob] <= MAX_JOBS)
        format(jobName, sizeof(jobName), "%s", g_JobNames[PlayerData[targetid][pJob] - 1]);
    else
        jobName = "Unemployed";

    SCM(viewerid, COLOR_INFO, "\n\n__ Stats _____________________________________________________");
    format(line, sizeof(line), T(viewerid, "[Account] Name: %s | Email: %s | Level: %d | RP: %d | Faction: %s | Job: %s"),
        PlayerData[targetid][pName],
        email,
        PlayerData[targetid][pLevel],
        PlayerData[targetid][pRP],
        fname,
        jobName
    );
    SCM(viewerid, COLOR_WHITE, line);

    format(line, sizeof(line), T(viewerid, "[Account] Next level (%d): %d RP (use /buylevel)"),
        PlayerData[targetid][pLevel] + 1, Level_UpgradeCost(PlayerData[targetid][pLevel]));
    SCM(viewerid, COLOR_WHITE, line);

    new houseText[12], bizText[12], caravanText[12], farmText[12], hotelText[12];
    if(PlayerData[targetid][pBusiness] != 0) format(bizText, sizeof(bizText), "%d", PlayerData[targetid][pBusiness]);
    else format(bizText, sizeof(bizText), "None");

    if(PlayerData[targetid][pHouse] != 0) format(houseText, sizeof(houseText), "%d", PlayerData[targetid][pHouse]);
    else format(houseText, sizeof(houseText), "None");

    if(PlayerData[targetid][pCaravanKey] != 0) format(caravanText, sizeof(caravanText), "%d", PlayerData[targetid][pCaravanKey]);
    else format(caravanText, sizeof(caravanText), "None");

    if(PlayerData[targetid][pFarmKey] != 0) format(farmText, sizeof(farmText), "%d", PlayerData[targetid][pFarmKey]);
    else format(farmText, sizeof(farmText), "None");

    if(PlayerData[targetid][pHotel] != 0) format(hotelText, sizeof(hotelText), "%d", PlayerData[targetid][pHotel]);
    else format(hotelText, sizeof(hotelText), "None");

    format(line, sizeof(line), T(viewerid, "Cash: $%s | Bank: $%s | Vehicles: %d, %d, %d | House: %s | Business: %s | Caravan: %s | Farm: %s | Hotel: %s"),
        MoneyStr(PlayerData[targetid][pMoney]),
        MoneyStr(PlayerData[targetid][pBank]),
        PlayerData[targetid][pKey1],
        PlayerData[targetid][pKey2],
        PlayerData[targetid][pKey3],
        houseText,
        bizText,
        caravanText,
        farmText,
        hotelText
        );
    SCM(viewerid, COLOR_WHITE, line);

    // Telefon: marca + numar (sau "None" daca nu are telefon / SIM)
    new phoneInfo[48];
    if(Phone_HasPhone(targetid))
    {
        new pbr[24];
        Phone_GetBrand(targetid, pbr, sizeof(pbr));
        if(Phone_IsBroken(targetid))
            format(phoneInfo, sizeof(phoneInfo), "%s (broken)", pbr);
        else if(PlayerData[targetid][pPhoneNumber] > 0)
            format(phoneInfo, sizeof(phoneInfo), "%s (%d)", pbr, PlayerData[targetid][pPhoneNumber]);
        else
            format(phoneInfo, sizeof(phoneInfo), "%s (no SIM)", pbr);
    }
    else phoneInfo = "None";

    // Business, boala, inchisoare, rulota, ferma, mut
    new disTxt[24], jailTxt[16], muteTxt[24], mkTxt[4], exTxt[4];

    if(PlayerData[targetid][pDiseased]) format(disTxt, sizeof(disTxt), "Yes (%d paydays)", PlayerData[targetid][pDiseasePaydays]);
    else format(disTxt, sizeof(disTxt), "No");

    if(PlayerData[targetid][pJailSeconds] > 0) format(jailTxt, sizeof(jailTxt), "%ds", PlayerData[targetid][pJailSeconds]);
    else format(jailTxt, sizeof(jailTxt), "No");

    new muteRemain = PlayerData[targetid][pMuteExpire] - gettime();
    if(muteRemain > 0) format(muteTxt, sizeof(muteTxt), "Yes (%d min)", (muteRemain + 59) / 60);
    else format(muteTxt, sizeof(muteTxt), "No");

    YesNoText(PlayerData[targetid][pMedkits] > 0, mkTxt);
    YesNoText(PlayerData[targetid][pExtinguishers] > 0, exTxt);

    format(line, sizeof(line), T(viewerid, "Phone: %s | Disease: %s | Wanted: %d | Jail: %s | Muted: %s | Medical kit: %s | Extinguisher: %s"),
        phoneInfo, disTxt, PlayerData[targetid][pWanted], jailTxt, muteTxt, mkTxt, exTxt);
    SCM(viewerid, COLOR_WHITE, line);


    new gasTxt[8], watchTxt[24];
    if(PlayerData[targetid][pGasCan] == GASCAN_FULL)       format(gasTxt, sizeof(gasTxt), "Full");
    else if(PlayerData[targetid][pGasCan] == GASCAN_EMPTY)  format(gasTxt, sizeof(gasTxt), "Empty");
    else                                                    format(gasTxt, sizeof(gasTxt), "None");

    if(Watch_HasWatch(targetid))
    {
        new wbr[24];
        Watch_GetBrand(targetid, wbr, sizeof(wbr));
        if(Watch_IsBroken(targetid)) format(watchTxt, sizeof(watchTxt), "%s (broken)", wbr);
        else format(watchTxt, sizeof(watchTxt), "%s", wbr);
    }
    else format(watchTxt, sizeof(watchTxt), "None");

    format(line, sizeof(line), T(viewerid, "Rob points: %d/%d |  Gas can: %s (%dL) | Watch: %s"),
        PlayerData[targetid][pRobPoints], ROB_POINTS_MAX, gasTxt, GasCan_Liters(targetid), watchTxt);
    SCM(viewerid, COLOR_WHITE, line);

    if(PlayerData[targetid][pAdminLevel] > 0)
    {
        format(line, sizeof(line), T(viewerid, "Admin level: %d"),
            PlayerData[targetid][pAdminLevel]);
        SCM(viewerid, COLOR_WHITE, line);
    }
}

// True daca playerul e intr-un Benson, la business-ul APPLIANCE_BIZ_ID (Home Furnitures) - necesar pentru /house upgrade
stock bool:HouseUpgrade_AtApplianceBiz(playerid)
{
    if(GetVehicleModel(GetPlayerVehicleID(playerid)) != BENSON_MODEL) return false;
    new bidx = Businesses_FindByID(APPLIANCE_BIZ_ID);
    if(bidx == -1) return false;
    return bool:IsPlayerInRangeOfPoint(playerid, BUSINESS_RANGE, BusinessData[bidx][bLocX], BusinessData[bidx][bLocY], BusinessData[bidx][bLocZ]);
}

#define YOSEMITE_MODEL 554

// True daca playerul e intr-un Yosemite, la un Pet Store (shopType 4) - necesar pentru /house upgrade animal
stock bool:HouseUpgrade_AtBizYosemite(playerid)
{
    if(GetVehicleModel(GetPlayerVehicleID(playerid)) != YOSEMITE_MODEL) return false;
    new shpIdx = Shop_FindNearby(playerid);
    if(shpIdx == -1 || ShopData[shpIdx][shopType] != 4) return false;
    return true;
}

// Finalizeaza livrarea unui /house upgrade cand playerul ajunge cu Benson-ul la checkpoint-ul casei sale
stock HouseUpgrade_Complete(playerid)
{
    DisablePlayerCheckpoint(playerid);

    new type  = g_HouseUpgradeType[playerid];
    new hidx  = g_HouseUpgradeHouseIdx[playerid];
    new acIdx = g_HouseUpgradeAnimalIdx[playerid];
    g_HouseUpgradeType[playerid]       = HOUSE_UPGRADE_NONE;
    g_HouseUpgradeHouseIdx[playerid]   = -1;
    g_HouseUpgradeAnimalIdx[playerid]  = -1;

    if(hidx == -1 || HouseData[hidx][hID] != PlayerData[playerid][pHouse])
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You no longer own this house - the delivery was cancelled."), 1;

    if(type == HOUSE_UPGRADE_FRIDGE)
    {
        if(HouseData[hidx][hHasFridge] && !Houses_FridgeBroken(hidx))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This house already has a fridge."), 1;

        new bool:frReplacing = HouseData[hidx][hHasFridge] && Houses_FridgeBroken(hidx);

        HouseData[hidx][hHasFridge] = 1;
        HouseData[hidx][hFridgeExpire] = gettime() + FRIDGE_LIFESPAN_DAYS * 86400;
        for(new k = 0; k < FRIDGE_ITEMS; k++) HouseData[hidx][hFridge][k] = 0; // frigiderul vechi era stricat/gol
        Houses_SaveFridge(hidx);

        SCM(playerid, COLOR_SUCCESS, frReplacing
            ? C_SUCCESS"Success: "C_WHITE"You replaced the broken "C_INFO"fridge"C_WHITE". Use "C_INFO"/frigde"C_WHITE"."
            : C_SUCCESS"Success: "C_WHITE"You bought a "C_INFO"fridge"C_WHITE" for your house. Use "C_INFO"/frigde"C_WHITE".");
        return 1;
    }

    if(type == HOUSE_UPGRADE_BED)
    {
        if(HouseData[hidx][hHasBed] && !Houses_BedBroken(hidx))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This house already has a bed."), 1;

        new bool:btReplacing = HouseData[hidx][hHasBed] && Houses_BedBroken(hidx);

        HouseData[hidx][hHasBed] = 1;
        HouseData[hidx][hBedExpire] = gettime() + BED_LIFESPAN_DAYS * 86400;
        Houses_SaveBed(hidx);

        SCM(playerid, COLOR_SUCCESS, btReplacing
            ? C_SUCCESS"Success: "C_WHITE"You replaced the broken "C_INFO"bed"C_WHITE". Use "C_INFO"/sleep"C_WHITE" to rest."
            : C_SUCCESS"Success: "C_WHITE"You bought a "C_INFO"bed"C_WHITE" for your house. Use "C_INFO"/sleep"C_WHITE" to rest.");
        return 1;
    }

    if(type == HOUSE_UPGRADE_TREE)
    {
        if(HouseData[hidx][hTreeId] != 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This house already has a tree."), 1;

        new tq[128];
        mysql_format(g_SQL, tq, sizeof(tq), "INSERT INTO `houses_tree` (`treeHouseId`) VALUES (%d)", HouseData[hidx][hID]);
        mysql_tquery(g_SQL, tq, "OnTreeUpgradeBought", "ii", playerid, hidx);
        return 1;
    }

    if(type == HOUSE_UPGRADE_ANIMAL)
    {
        if(acIdx == -1 || acIdx >= sizeof(g_AnimalCatalog))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid animal."), 1;
        if(!House_CanHaveAnimal(HouseData[hidx][hType], acIdx))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This house can no longer have that animal."), 1;
        if(g_AnimalCount >= MAX_ANIMALS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The animal limit on the server has been reached."), 1;

        Animal_Purchase(playerid, acIdx, hidx);
        return 1;
    }
    return 1;
}

// Finalizeaza livrarea aparatului de cafea cand playerul ajunge cu Benson-ul la checkpoint-ul biz-ului sau
stock BizCoffee_Complete(playerid)
{
    DisablePlayerCheckpoint(playerid);

    new bidx = g_BizCoffeeIdx[playerid];
    g_BizCoffeeOrder[playerid] = false;
    g_BizCoffeeIdx[playerid]   = -1;

    if(bidx == -1 || BusinessData[bidx][bID] != PlayerData[playerid][pBusiness])
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You no longer own this business - the delivery was cancelled."), 1;

    if(BusinessData[bidx][bCoffeMaker])
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This business already has a coffee maker."), 1;

    if(PlayerData[playerid][pMoney] < BIZ_COFFEE_PRICE)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money ("C_INFO"$6.000"C_WHITE")."), 1;

    PlayerData[playerid][pMoney] -= BIZ_COFFEE_PRICE;
    GivePlayerMoney(playerid, -BIZ_COFFEE_PRICE);
    UpdatePlayer(playerid, pMoney);

    new bcCut = BIZ_COFFEE_PRICE * APPLIANCE_BIZ_CUT_PCT / 100;
    if(bcCut > 0) Job_AddBizIncome(APPLIANCE_BIZ_ID, bcCut);

    BusinessData[bidx][bCoffeMaker]     = 1;
    BusinessData[bidx][bCoffeMaker_Exp] = 50;

    new q[128];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `businesses` SET `coffee_maker`=1, `coffee_maker_exp`=50 WHERE `id`=%d", BusinessData[bidx][bID]);
    mysql_tquery(g_SQL, q, "", "", 0);

    SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"You installed a "C_INFO"coffee maker"C_WHITE" at your business.");
    return 1;
}

// /event fara parametri (sau cu un tip necunoscut): arata tipurile de event si toate comenzile lor
stock MiniEvents_ShowHelp(playerid)
{
    new body[1536];
    format(body, sizeof(body), T(playerid,
        C_INFO"Event types:"C_WHITE"\n\n\
"C_SUCCESS"1. Race"C_WHITE" - drive a set route, first to finish wins\n\
  /event join - enter an open race\n\
  Admin: /event race [lap1/lap2/lap3/lap4] [bullet/infernus/elegy/stratum/nrg/sabre/dune/random], /event start, /event stop\n\n\
"C_SUCCESS"2. Counter Strike (cs)"C_WHITE" - team match, bomb plant/defuse\n\
  /event cs join [nr] - enter an open match\n\
  Admin: /event cs open, /event cs start [nr], /event cs stop [nr]\n\n\
"C_SUCCESS"3. Hunt The Mayor (htm)"C_WHITE" - one random Mayor against everyone else, 15 minutes\n\
  /event htm join - enter an open event\n\
  Admin: /event htm open, /event htm start, /event htm stop\n\n\
"C_SUCCESS"4. Custom event"C_WHITE" - an admin-run event with custom rules\n\
  /event custom join - enter while sign-ups are open\n\
  Admin: /event custom start, /event custom stop, /event custom heal [0-100], /event custom armour [0-100], /event custom freeze [0/1]\n\n\
"C_INFO"Tip: "C_WHITE"commands that open or run an event need admin level 2+; joining is open to everyone while sign-ups are open."));
    SPD(playerid, DIALOG_EVENT_HELP, DIALOG_STYLE_MSGBOX, "Events", body, "Close", "");
    return 1;
}

public OnPlayerCommandText(playerid, cmdtext[])
{
    new idx;
    new cmd[256];
    cmd = strtok(cmdtext, idx);

    // ---- /register [parola] ----
    if(strcmp(cmd, "/register", true) == 0)
    {
        if(PlayerData[playerid][pRegistered])
            return SCM(playerid, COLOR_ERROR,
                C_ERROR"Error: "C_WHITE"You are already registered."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new pass[64];
        strmid(pass, cmdtext, idx, strlen(cmdtext), 64);

        if(!strlen(pass))
            return SCM(playerid, COLOR_INFO,
                C_INFO"Info: "C_WHITE"Use "C_INFO"/register [password]"C_WHITE"."), 1;

        Player_Register(playerid, pass);
        return 1;
    }

    // ---- /login [parola] ----
    if(strcmp(cmd, "/login", true) == 0)
    {
        if(!PlayerData[playerid][pRegistered])
            return SCM(playerid, COLOR_ERROR,
                C_ERROR"Error: "C_WHITE"You are not registered. Use "C_INFO"/register [password]"C_WHITE"."), 1;

        if(PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR,
                C_ERROR"Error: "C_WHITE"You are already logged in."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new pass[64];
        strmid(pass, cmdtext, idx, strlen(cmdtext), 64);

        if(!strlen(pass))
            return SCM(playerid, COLOR_INFO,
                C_INFO"Info: "C_WHITE"Use "C_INFO"/login [password]"C_WHITE"."), 1;

        Player_Login(playerid, pass);
        return 1;
    }

    // ---- /stats ----
    if(strcmp(cmd, "/stats", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR,
                C_ERROR"Error: "C_WHITE"You must be logged in to view your stats."), 1;

        Player_ShowStats(playerid, playerid);
        return 1;
    }

    // ---- /showstats [playerid] (admin 2+: arata stats-ul complet al altui player) ----
    if(strcmp(cmd, "/showstats", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 2)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new ssp1[8];
        strmid(ssp1, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(ssp1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/showstats [playerid]"C_WHITE"."), 1;

        new sstarget = strval(ssp1);
        if(!IsPlayerConnected(sstarget) || !PlayerData[sstarget][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        Player_ShowStats(playerid, sstarget);
        return 1;
    }

    // ---- /report [text] (max 2 reporturi deschise; persistat in DB) ----
    if(strcmp(cmd, "/report", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new rtext[128];
        strmid(rtext, cmdtext, idx, strlen(cmdtext), 128);
        if(!strlen(rtext))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/report [text]"C_WHITE"."), 1;

        // verifica limita de reporturi deschise (async), apoi insereaza in OnReportSubmit
        new q[128];
        mysql_format(g_SQL, q, sizeof(q), "SELECT COUNT(*) AS c FROM `reports` WHERE `playerDbId`=%d AND `status`=0", PlayerData[playerid][pID]);
        mysql_tquery(g_SQL, q, "OnReportSubmit", "is", playerid, rtext);
        return 1;
    }

    // ---- /reports (admin 1+: dialog cu reporturile deschise) ----
    if(strcmp(cmd, "/reports", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        Reports_ShowList(playerid);
        return 1;
    }

    // ---- /reportreply [repID] [text] (admin 1+ raspunde; reportul e sters dupa livrare) ----
    if(strcmp(cmd, "/reportreply", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new rrp1[8];
        strmid(rrp1, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(rrp1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/reportreply [repID] [text]"C_WHITE"."), 1;

        new rrid = strval(rrp1);
        while(cmdtext[idx] > ' ') idx++;   // sari peste repID
        while(cmdtext[idx] == ' ') idx++;  // sari peste spatii
        new rrtext[128];
        strmid(rrtext, cmdtext, idx, strlen(cmdtext), 128);
        if(!strlen(rrtext))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/reportreply [repID] [text]"C_WHITE"."), 1;

        new q[160];
        mysql_format(g_SQL, q, sizeof(q), "SELECT `status`,`playerDbId`,`playerName` FROM `reports` WHERE `repID`=%d", rrid);
        mysql_tquery(g_SQL, q, "OnReportReplyLookup", "iis", playerid, rrid, rrtext);
        return 1;
    }

    // ---- /deposit <suma> (cash -> bank, la ATM) ----
    if(strcmp(cmd, "/deposit", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new atmIdx = ATM_FindNearbyIndex(playerid);
        if(atmIdx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be near an ATM."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new dStr[12];
        strmid(dStr, cmdtext, idx, strlen(cmdtext), 12);
        if(!strlen(dStr))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/deposit <amount>"C_WHITE" (max $100,000)."), 1;

        new amount = strval(dStr);
        if(amount < ATM_MIN_TRANSACTION)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Minimum "C_INFO"$100"C_WHITE" per transaction."), 1;
        if(amount > ATM_MAX_TRANSACTION)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Maximum "C_INFO"$100,000"C_WHITE" per transaction."), 1;
        if(PlayerData[playerid][pMoney] < amount)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have that much cash."), 1;

        new fee = ATM_DEPOSIT_BASE + amount / 1000; // 90$ + 0.001 * suma
        if(amount <= fee)
        {
            new fmsg[128];
            format(fmsg, sizeof(fmsg), T(playerid, C_ERROR"Error: "C_WHITE"Amount too small to cover the fee ("C_INFO"$%s"C_WHITE")."), MoneyStr(fee));
            return SCM(playerid, COLOR_ERROR, fmsg), 1;
        }

        new credited = amount - fee;
        PlayerData[playerid][pMoney] -= amount;
        GivePlayerMoney(playerid, -amount);
        PlayerData[playerid][pBank]  += credited;
        UpdatePlayer(playerid, pMoney);
        UpdatePlayer(playerid, pBank);

        // 10% din taxa merge in banca business-ului care detine ATM-ul
        new bankCut = floatround(fee * 10.0 / 100.0);
        if(bankCut > 0) Job_AddBizIncome(ATMData[atmIdx][atmBankOwner], bankCut);

        new dmsg[144];
        format(dmsg, sizeof(dmsg), T(playerid, C_SUCCESS"[Bank] "C_WHITE"Deposited "C_SUCCESS"$%s"C_WHITE" (fee "C_ERROR"$%s"C_WHITE"). New balance: "C_SUCCESS"$%s"),
            MoneyStr(credited), MoneyStr(fee), MoneyStr(PlayerData[playerid][pBank]));
        SCM(playerid, COLOR_SUCCESS, dmsg);
        return 1;
    }

    // ---- /withdraw <suma> (bank -> cash, la ATM) ----
    if(strcmp(cmd, "/withdraw", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new atmIdx = ATM_FindNearbyIndex(playerid);
        if(atmIdx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be near an ATM."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new wStr[12];
        strmid(wStr, cmdtext, idx, strlen(cmdtext), 12);
        if(!strlen(wStr))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/withdraw <amount>"C_WHITE" (max $100,000)."), 1;

        new amount = strval(wStr);
        if(amount < ATM_MIN_TRANSACTION)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Minimum "C_INFO"$100"C_WHITE" per transaction."), 1;
        if(amount > ATM_MAX_TRANSACTION)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Maximum "C_INFO"$100,000"C_WHITE" per transaction."), 1;
        if(PlayerData[playerid][pBank] < amount)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have that much in the bank."), 1;

        new fee = ATM_WITHDRAW_BASE + amount / 1000; // 110$ + 0.001 * suma
        if(amount <= fee)
        {
            new fmsg[128];
            format(fmsg, sizeof(fmsg), T(playerid, C_ERROR"Error: "C_WHITE"Amount too small to cover the fee ("C_INFO"$%s"C_WHITE")."), MoneyStr(fee));
            return SCM(playerid, COLOR_ERROR, fmsg), 1;
        }

        new given = amount - fee;
        PlayerData[playerid][pBank]  -= amount;
        PlayerData[playerid][pMoney] += given;
        GivePlayerMoney(playerid, given);
        UpdatePlayer(playerid, pMoney);
        UpdatePlayer(playerid, pBank);

        // 10% din taxa merge in banca business-ului care detine ATM-ul
        new bankCut = floatround(fee * 10.0 / 100.0);
        if(bankCut > 0) Job_AddBizIncome(ATMData[atmIdx][atmBankOwner], bankCut);

        new wmsg[144];
        format(wmsg, sizeof(wmsg), T(playerid, C_SUCCESS"[Bank] "C_WHITE"Withdrew "C_SUCCESS"$%s"C_WHITE" (fee "C_ERROR"$%s"C_WHITE"). New balance: "C_SUCCESS"$%s"),
            MoneyStr(given), MoneyStr(fee), MoneyStr(PlayerData[playerid][pBank]));
        SCM(playerid, COLOR_SUCCESS, wmsg);
        return 1;
    }

    // ---- /mybank [farm/house/hotel/biz/forest] [deposit/withdraw] [amount] (conturile proprietatilor, la banca/ATM) ----
    if(strcmp(cmd, "/mybank", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(!PlayerData[playerid][pVIP] && ATM_FindNearbyIndex(playerid) == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Bank] "C_WHITE"You must be near a bank or ATM."), 1;

        new mbl[128];
        while(cmdtext[idx] == ' ') idx++;
        new mbtype[10], mbt = 0;
        while(cmdtext[idx] > ' ' && mbt < 9) { mbtype[mbt++] = cmdtext[idx]; idx++; }
        mbtype[mbt] = EOS;

        // fara argument -> arata soldurile
        if(!strlen(mbtype))
        {
            SCM(playerid, COLOR_INFO, C_INFO"_____ Property Accounts ____________________");
            if(PlayerData[playerid][pFarmKey] != 0)
            {
                new fi = Farm_IndexByID(PlayerData[playerid][pFarmKey]);
                if(fi != -1) { format(mbl, sizeof(mbl), T(playerid, C_WHITE"Farm #%d: "C_INFO"$%s"), FarmData[fi][fmID], MoneyStr(FarmData[fi][fmBank])); SCM(playerid, COLOR_WHITE, mbl); }
            }
            if(PlayerData[playerid][pHouse] != 0)
            {
                new hi = Houses_FindByID(PlayerData[playerid][pHouse]);
                if(hi != -1) { format(mbl, sizeof(mbl), T(playerid, C_WHITE"House (%s): "C_INFO"$%s"), HouseData[hi][hName], MoneyStr(HouseData[hi][hBank])); SCM(playerid, COLOR_WHITE, mbl); }
            }
            if(PlayerData[playerid][pHotel] != 0)
            {
                new hti = Hotels_FindByID(PlayerData[playerid][pHotel]);
                if(hti != -1) { format(mbl, sizeof(mbl), T(playerid, C_WHITE"Hotel (%s): "C_INFO"$%s"), HotelData[hti][htlName], MoneyStr(HotelData[hti][htlBank])); SCM(playerid, COLOR_WHITE, mbl); }
            }
            if(PlayerData[playerid][pBusiness] != 0)
            {
                new bi = Businesses_FindByID(PlayerData[playerid][pBusiness]);
                if(bi != -1) { format(mbl, sizeof(mbl), T(playerid, C_WHITE"Business (%s): "C_INFO"$%s"), BusinessData[bi][bName], MoneyStr(BusinessData[bi][bBank])); SCM(playerid, COLOR_WHITE, mbl); }
            }
            if(PlayerData[playerid][pForestKey] != 0)
            {
                new fsti = Forest_IndexByID(PlayerData[playerid][pForestKey]);
                if(fsti != -1) { format(mbl, sizeof(mbl), T(playerid, C_WHITE"Forest #%d: "C_INFO"$%s"), ForestData[fsti][fstID], MoneyStr(ForestData[fsti][fstBank])); SCM(playerid, COLOR_WHITE, mbl); }
            }
            SCM(playerid, COLOR_INFO, C_INFO"Use "C_WHITE"/mybank [farm/house/hotel/biz/forest] [deposit/withdraw] [amount]");
            return 1;
        }

        // parseaza actiunea + suma
        while(cmdtext[idx] == ' ') idx++;
        new mbact[12], mba = 0;
        while(cmdtext[idx] > ' ' && mba < 11) { mbact[mba++] = cmdtext[idx]; idx++; }
        mbact[mba] = EOS;
        while(cmdtext[idx] == ' ') idx++;
        new mbamtS[16];
        strmid(mbamtS, cmdtext, idx, strlen(cmdtext), 16);
        new mbamt = strval(mbamtS);

        new bool:dep = (strcmp(mbact, "deposit", true) == 0);
        if(!dep && strcmp(mbact, "withdraw", true) != 0)
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/mybank [farm/house/hotel/biz/forest] [deposit/withdraw] [amount]"C_WHITE"."), 1;
        if(mbamt <= 0)
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/mybank [farm/house/hotel/biz/forest] [deposit/withdraw] [amount]"C_WHITE"."), 1;

        if(strcmp(mbtype, "farm", true) == 0)
        {
            if(PlayerData[playerid][pFarmKey] == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Bank] "C_WHITE"You don't own a farm."), 1;
            new fi = Farm_IndexByID(PlayerData[playerid][pFarmKey]);
            if(fi == -1) return SCM(playerid, COLOR_ERROR, C_ERROR"[Bank] "C_WHITE"Farm not found."), 1;
            if(!Prop_BankTransfer(playerid, FarmData[fi][fmBank], dep, mbamt)) return 1;
            Farm_Save(fi);
            format(mbl, sizeof(mbl), T(playerid, C_SUCCESS"[Bank] "C_WHITE"Farm bank now: "C_INFO"$%s"C_WHITE"."), MoneyStr(FarmData[fi][fmBank]));
            SCM(playerid, COLOR_SUCCESS, mbl);
            return 1;
        }
        else if(strcmp(mbtype, "house", true) == 0)
        {
            if(PlayerData[playerid][pHouse] == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Bank] "C_WHITE"You don't own a house."), 1;
            new hi = Houses_FindByID(PlayerData[playerid][pHouse]);
            if(hi == -1) return SCM(playerid, COLOR_ERROR, C_ERROR"[Bank] "C_WHITE"House not found."), 1;
            if(!Prop_BankTransfer(playerid, HouseData[hi][hBank], dep, mbamt)) return 1;
            new q[96];
            mysql_format(g_SQL, q, sizeof(q), "UPDATE `houses` SET `bank`=%d WHERE `id`=%d", HouseData[hi][hBank], HouseData[hi][hID]);
            mysql_tquery(g_SQL, q, "", "", 0);
            format(mbl, sizeof(mbl), T(playerid, C_SUCCESS"[Bank] "C_WHITE"House bank now: "C_INFO"$%s"C_WHITE"."), MoneyStr(HouseData[hi][hBank]));
            SCM(playerid, COLOR_SUCCESS, mbl);
            return 1;
        }
        else if(strcmp(mbtype, "hotel", true) == 0)
        {
            if(PlayerData[playerid][pHotel] == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Bank] "C_WHITE"You don't own a hotel."), 1;
            new hti = Hotels_FindByID(PlayerData[playerid][pHotel]);
            if(hti == -1) return SCM(playerid, COLOR_ERROR, C_ERROR"[Bank] "C_WHITE"Hotel not found."), 1;
            if(!Prop_BankTransfer(playerid, HotelData[hti][htlBank], dep, mbamt)) return 1;
            Hotels_SaveBank(hti);
            format(mbl, sizeof(mbl), T(playerid, C_SUCCESS"[Bank] "C_WHITE"Hotel bank now: "C_INFO"$%s"C_WHITE"."), MoneyStr(HotelData[hti][htlBank]));
            SCM(playerid, COLOR_SUCCESS, mbl);
            return 1;
        }
        else if(strcmp(mbtype, "biz", true) == 0 || strcmp(mbtype, "business", true) == 0)
        {
            if(PlayerData[playerid][pBusiness] == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Bank] "C_WHITE"You don't own a business."), 1;
            new bi = Businesses_FindByID(PlayerData[playerid][pBusiness]);
            if(bi == -1) return SCM(playerid, COLOR_ERROR, C_ERROR"[Bank] "C_WHITE"Business not found."), 1;
            if(!Prop_BankTransfer(playerid, BusinessData[bi][bBank], dep, mbamt)) return 1;
            new q[96];
            mysql_format(g_SQL, q, sizeof(q), "UPDATE `businesses` SET `bank`=%d WHERE `id`=%d", BusinessData[bi][bBank], BusinessData[bi][bID]);
            mysql_tquery(g_SQL, q, "", "", 0);
            format(mbl, sizeof(mbl), T(playerid, C_SUCCESS"[Bank] "C_WHITE"Business bank now: "C_INFO"$%s"C_WHITE"."), MoneyStr(BusinessData[bi][bBank]));
            SCM(playerid, COLOR_SUCCESS, mbl);
            return 1;
        }
        else if(strcmp(mbtype, "forest", true) == 0)
        {
            if(PlayerData[playerid][pForestKey] == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Bank] "C_WHITE"You don't own a forest."), 1;
            new fsti = Forest_IndexByID(PlayerData[playerid][pForestKey]);
            if(fsti == -1) return SCM(playerid, COLOR_ERROR, C_ERROR"[Bank] "C_WHITE"Forest not found."), 1;
            if(!Prop_BankTransfer(playerid, ForestData[fsti][fstBank], dep, mbamt)) return 1;
            new q[96];
            mysql_format(g_SQL, q, sizeof(q), "UPDATE `forests` SET `bank`=%d WHERE `id`=%d", ForestData[fsti][fstBank], ForestData[fsti][fstID]);
            mysql_tquery(g_SQL, q, "", "", 0);
            format(mbl, sizeof(mbl), T(playerid, C_SUCCESS"[Bank] "C_WHITE"Forest bank now: "C_INFO"$%s"C_WHITE"."), MoneyStr(ForestData[fsti][fstBank]));
            SCM(playerid, COLOR_SUCCESS, mbl);
            return 1;
        }
        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/mybank [farm/house/hotel/biz/forest] [deposit/withdraw] [amount]"C_WHITE"."), 1;
    }

    // ---- /shop (Medical Kit / Extinctor / Phone) ----
    if(strcmp(cmd, "/shop", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new shpNear = Shop_FindNearby(playerid);
        if(shpNear == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at a "C_INFO"Shop"C_WHITE" to do this."), 1;

        if(ShopData[shpNear][shopStockCurr] <= 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This shop is out of stock. Wait for a "C_INFO"Truck Driver"C_WHITE" to resupply it."), 1;

        g_ShopDialogType[playerid] = ShopData[shpNear][shopType];
        g_ShopDialogIdx[playerid]  = shpNear;

        // ---- Type 2: Electronics Shop (SIM + Phone models + Watch models) ----
        if(g_ShopDialogType[playerid] == 2)
        {
            new dlg[1024];
            dlg[0] = EOS;
            strcat(dlg, T(playerid, C_INFO"Item\t"C_INFO"Price\n"));

            new line[80];
            format(line, sizeof(line), C_WHITE"SIM (phone number)\t"C_SUCCESS"$%s\n", MoneyStr(g_PhoneSimPrice));
            strcat(dlg, line);
            for(new i = 0; i < PHONE_MODEL_COUNT; i++)
            {
                format(line, sizeof(line), C_WHITE"%s\t"C_SUCCESS"$%s\n", g_PhoneModels[i], MoneyStr(g_PhonePrices[i]));
                strcat(dlg, line);
            }
            for(new i = 0; i < WATCH_MODEL_COUNT; i++)
            {
                format(line, sizeof(line), C_WHITE"%s\t"C_SUCCESS"$%s\n", g_WatchModels[i], MoneyStr(g_WatchPrices[i]));
                strcat(dlg, line);
            }
            format(line, sizeof(line), C_WHITE"GPS\t"C_SUCCESS"$%s\n", MoneyStr(g_GPSPrice));
            strcat(dlg, line);
            format(line, sizeof(line), C_WHITE"Coffee Maker (for your business)\t"C_SUCCESS"$%s\n", MoneyStr(BIZ_COFFEE_PRICE));
            strcat(dlg, line);
            SPD(playerid, DIALOG_SHOP, DIALOG_STYLE_TABLIST_HEADERS, "Electronics Shop", dlg, "Select", "Close");
            return 1;
        }

        // ---- Type 3: Tools Shop (Shovel / Bags / Fishing Rod / Chainsaw) ----
        if(g_ShopDialogType[playerid] == 3)
        {
            new dlg[850];
            format(dlg, sizeof(dlg), T(playerid, ""C_INFO"Item\t"C_INFO"Price\n"C_WHITE"Shovel\t"C_SUCCESS"$%s\n"C_WHITE"Small Bag (%d SGR) [Lvl 1+]\t"C_SUCCESS"$%d\n"C_WHITE"Medium Bag (%d SGR) [Lvl 3+]\t"C_SUCCESS"$%d\n"C_WHITE"Large Bag (%d SGR) [Lvl 4+]\t"C_SUCCESS"$%d\n"C_WHITE"Fishing Rod\t"C_SUCCESS"$%s\n"C_WHITE"Chainsaw\t"C_SUCCESS"$%s\n"C_WHITE"Tree Sapling (per unit)\t"C_SUCCESS"$%d"),
                MoneyStr(g_ShovelPrice),
                g_BagCapacity[BAG_TYPE_SMALL], g_BagPrice[BAG_TYPE_SMALL],
                g_BagCapacity[BAG_TYPE_MEDIUM], g_BagPrice[BAG_TYPE_MEDIUM],
                g_BagCapacity[BAG_TYPE_LARGE], g_BagPrice[BAG_TYPE_LARGE],
                MoneyStr(g_FishingRodPrice), MoneyStr(g_ChainsawPrice), g_SaplingPrice);
            SPD(playerid, DIALOG_SHOP, DIALOG_STYLE_TABLIST_HEADERS, "Tools Shop", dlg, "Select", "Close");
            return 1;
        }

        // ---- Type 4: Pet Store (cumparare instant a animalelor din g_AnimalCatalog - fara Benson/livrare, spre deosebire de /house upgrade animal) ----
        if(g_ShopDialogType[playerid] == 4)
        {
            new dlg[400];
            dlg[0] = EOS;
            strcat(dlg, T(playerid, C_INFO"Animal\t"C_INFO"Price\n"));
            for(new c = 0; c < sizeof(g_AnimalCatalog); c++)
            {
                new pline[64];
                format(pline, sizeof(pline), C_WHITE"%s\t"C_SUCCESS"$%s\n", g_AnimalCatalog[c][acName], MoneyStr(ANIMAL_PRICE));
                strcat(dlg, pline);
            }
            SPD(playerid, DIALOG_SHOP, DIALOG_STYLE_TABLIST_HEADERS, "Pet Store", dlg, "Select", "Close");
            return 1;
        }

        // ---- Type 1 (implicit): 24/7 Shop (Medical Kit / Extinctor / Gas Can / Phone Book / Flowers) ----
        new dlg[520];
        format(dlg, sizeof(dlg), T(playerid, ""C_INFO"Item\t"C_INFO"Price\n"C_WHITE"Medical Kit\t"C_SUCCESS"$%s\n"C_WHITE"Extinctor\t"C_SUCCESS"$%s\n"C_WHITE"Gas Can (%dL, empty)\t"C_SUCCESS"$%s\n"C_WHITE"Phone Book\t"C_SUCCESS"$%s\n"C_WHITE"Flowers\t"C_SUCCESS"$%s"),
            MoneyStr(g_MedkitPrice), MoneyStr(g_ExtinguisherPrice), GasCan_Liters(playerid), MoneyStr(g_GasCanPrice), MoneyStr(g_PhoneBookPrice),
            MoneyStr(g_FlowersPrice));
        SPD(playerid, DIALOG_SHOP, DIALOG_STYLE_TABLIST_HEADERS, "24/7 Shop", dlg, "Select", "Close");
        return 1;
    }

    // ---- /getcoffee (trebuie sa fii langa un business (range 5) al carui bCoffeMaker_Exp > 0) ----
    if(strcmp(cmd, "/getcoffee", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new gcBidx = -1;
        for(new i = 0; i < g_BusinessCount; i++)
        {
            if(!IsPlayerInRangeOfPoint(playerid, BUSINESS_RANGE, BusinessData[i][bLocX], BusinessData[i][bLocY], BusinessData[i][bLocZ])) continue;
            gcBidx = i;
            break;
        }
        if(gcBidx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at a business to do this."), 1;

        if(BusinessData[gcBidx][bCoffeMaker_Exp] <= 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This business has no coffee available right now."), 1;

        if(Coffee_LimitReached(playerid)) return 1;

        Player_DrinkCoffee(playerid);

        BusinessData[gcBidx][bBank] += 2;
        new gcq[96];
        mysql_format(g_SQL, gcq, sizeof(gcq), "UPDATE `businesses` SET `bank`=%d WHERE `id`=%d", BusinessData[gcBidx][bBank], BusinessData[gcBidx][bID]);
        mysql_tquery(g_SQL, gcq, "", "", 0);

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"You got a coffee.");
        return 1;
    }

    // ---- /parrot [get/down] (papagalul de companie - vezi /house upgrade animal) ----
    if(strcmp(cmd, "/parrot", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new prSub[8];
        strmid(prSub, cmdtext, idx, strlen(cmdtext), 8);

        if(strcmp(prSub, "get", true) == 0)
        {
            if(g_PlayerParrotID[playerid] != 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Your parrot is already on your shoulder."), 1;

            new prIdx = -1;
            for(new a = 0; a < g_AnimalCount; a++)
            {
                if(AnimalData[a][aPlayerID] != PlayerData[playerid][pID]) continue;
                if(AnimalData[a][aType] != ANIMAL_PARROT_MODEL) continue;
                if(AnimalData[a][aDeceased]) continue;
                if(AnimalData[a][aOnPlayer]) continue;
                prIdx = a;
                break;
            }
            if(prIdx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a parrot available."), 1;

            AnimalData[prIdx][aOnPlayer] = true;
            Parrot_Attach(playerid, prIdx);

            new prq[96];
            mysql_format(g_SQL, prq, sizeof(prq), "UPDATE `houses_animals` SET `isOnPlayer`=1 WHERE `aID`=%d", AnimalData[prIdx][aID]);
            mysql_tquery(g_SQL, prq, "", "", 0);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"Your parrot hops onto your shoulder.");
            return 1;
        }

        if(strcmp(prSub, "down", true) == 0)
        {
            if(g_PlayerParrotID[playerid] == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a parrot on your shoulder."), 1;

            new prIdx = Animals_FindByID(g_PlayerParrotID[playerid]);
            Parrot_DetachObject(playerid);

            if(prIdx != -1)
            {
                AnimalData[prIdx][aOnPlayer] = false;
                Animals_Spawn(prIdx);

                new prq[96];
                mysql_format(g_SQL, prq, sizeof(prq), "UPDATE `houses_animals` SET `isOnPlayer`=0 WHERE `aID`=%d", AnimalData[prIdx][aID]);
                mysql_tquery(g_SQL, prq, "", "", 0);
            }

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"You set your parrot down. It flies back to your house.");
            return 1;
        }

        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/parrot [get/down]"C_WHITE"."), 1;
    }


    // ---- /v install [medicalkit/extinctor] (aplica un act din inventar pe vehiculul curent) ----
    if(strcmp(cmd, "/v", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new sub[256];
        sub = strtok(cmdtext, idx);
        if(!strlen(sub))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/v [install/ITP/insurance/plate/color1/color2/sell/sellto/selltostate/park/wash]"C_WHITE"."), 1;

        // ---- /v install [medicalkit/extinctor] ----
        if(strcmp(sub, "install", true) == 0)
        {
            new what[256];
            what = strtok(cmdtext, idx);
            new bool:isMed = (strcmp(what, "medicalkit", true) == 0);
            new bool:isExt = (strcmp(what, "extinctor", true) == 0);
            if(!isMed && !isExt)
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/v install [medicalkit/extinctor]"C_WHITE"."), 1;

            new vehid = GetPlayerVehicleID(playerid);
            if(vehid == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in a vehicle."), 1;
            new pvidx = g_VehicleToPVIndex[vehid];
            if(pvidx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This is not a personal vehicle."), 1;
            if(PVehicleData[pvidx][pvOwnerId] != PlayerData[playerid][pID])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't own this vehicle."), 1;

            if(isMed)
            {
                if(PlayerData[playerid][pMedkits] <= 0)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have any medical kit. Buy one with "C_INFO"/shop"C_WHITE"."), 1;
                if(VehicleDoc_IsValid(PVehicleData[pvidx][pvMedkitExp]))
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The medical kit is still valid."), 1;

                PlayerData[playerid][pMedkits]--;
                UpdatePlayer(playerid, pMedkits);

                PVehicleData[pvidx][pvMedkitExp] = gettime() + VEHICLE_MEDKIT_DURATION;
                new dateStr[11];
                UnixToDateStr(PVehicleData[pvidx][pvMedkitExp], dateStr, sizeof(dateStr));
                new q[128];
                mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `medkit_exp`='%s' WHERE `id`=%d", dateStr, PVehicleData[pvidx][pvID]);
                mysql_tquery(g_SQL, q, "", "", 0);

                new m[144];
                format(m, sizeof(m), T(playerid, C_SUCCESS"Success: "C_WHITE"You installed a medical kit ("C_INFO"7 days"C_WHITE"). You have "C_INFO"%d"C_WHITE" left."), PlayerData[playerid][pMedkits]);
                SCM(playerid, COLOR_SUCCESS, m);
            }
            else // isExt
            {
                if(PlayerData[playerid][pExtinguishers] <= 0)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have any extinguisher. Buy one with "C_INFO"/shop"C_WHITE"."), 1;
                if(VehicleDoc_IsValid(PVehicleData[pvidx][pvExtinguisherExp]))
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The extinguisher is still valid."), 1;

                PlayerData[playerid][pExtinguishers]--;
                UpdatePlayer(playerid, pExtinguishers);

                PVehicleData[pvidx][pvExtinguisherExp] = gettime() + VEHICLE_EXTINGUISHER_DURATION;
                new dateStr[11];
                UnixToDateStr(PVehicleData[pvidx][pvExtinguisherExp], dateStr, sizeof(dateStr));
                new q[128];
                mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `extinguisher_exp`='%s' WHERE `id`=%d", dateStr, PVehicleData[pvidx][pvID]);
                mysql_tquery(g_SQL, q, "", "", 0);

                new m[144];
                format(m, sizeof(m), T(playerid, C_SUCCESS"Success: "C_WHITE"You installed an extinguisher ("C_INFO"10 days"C_WHITE"). You have "C_INFO"%d"C_WHITE" left."), PlayerData[playerid][pExtinguishers]);
                SCM(playerid, COLOR_SUCCESS, m);
            }
            return 1;
        }

        // ---- /v ITP ----
        if(strcmp(sub, "ITP", true) == 0)
        {
            if(!IsPlayerInRangeOfPoint(playerid, ITP_RANGE, ITP_LOC_X, ITP_LOC_Y, ITP_LOC_Z))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the DMV headquarters."), 1;

            new vehid = GetPlayerVehicleID(playerid);
            if(vehid == 0 || GetPlayerVehicleSeat(playerid) != 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be the driver of a personal vehicle."), 1;

            new pvidx = g_VehicleToPVIndex[vehid];
            if(pvidx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This is not a personal vehicle."), 1;

            if(PVehicleData[pvidx][pvOwnerId] != PlayerData[playerid][pID])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't own this vehicle."), 1;

            new itpEngine, itpLights, itpAlarm, itpDoors, itpBonnet, itpBoot, itpObjective;
            GetVehicleParamsEx(vehid, itpEngine, itpLights, itpAlarm, itpDoors, itpBonnet, itpBoot, itpObjective);
            if(itpEngine)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The vehicle's engine must be off to do this."), 1;

            if(itpBonnet != 1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must open the bonnet (hood) first."), 1;

            if(itpLights != 1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must turn on the headlights first."), 1;

            if(itpBoot != 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must close the boot (trunk) first."), 1;

            if(VehicleDoc_IsValid(PVehicleData[pvidx][pvITPExp]))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The ITP is still valid."), 1;

            if(PlayerData[playerid][pMoney] < g_ITPPrice)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money."), 1;

            PlayerData[playerid][pMoney] -= g_ITPPrice;
            GivePlayerMoney(playerid, -g_ITPPrice);
            UpdatePlayer(playerid, pMoney);
            Faction_AddBank(FACTION_RAR, g_ITPPrice);

            GTP(playerid, "~w~Checking the car...", ITP_CHECK_TIME, 3);
            TogglePlayerControllable(playerid, 0);

            SetTimerEx("OnVehicleITPCheck", ITP_CHECK_TIME, false, "iii", playerid, pvidx, vehid);

            SCM(playerid, COLOR_INFO,
                C_INFO"Info: "C_WHITE"The ITP check has started. Wait "C_INFO"10 seconds"C_WHITE".");
            return 1;
        }

        // ---- /v insurance ----
        if(strcmp(sub, "insurance", true) == 0)
        {
            new vehid = GetPlayerVehicleID(playerid);
            if(vehid == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in a vehicle."), 1;

            new pvidx = g_VehicleToPVIndex[vehid];
            if(pvidx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This is not a personal vehicle."), 1;

            if(PVehicleData[pvidx][pvOwnerId] != PlayerData[playerid][pID])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't own this vehicle."), 1;

            if(VehicleDoc_IsValid(PVehicleData[pvidx][pvInsuranceExp]))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The insurance is still valid."), 1;

            if(PlayerData[playerid][pMoney] < g_InsurancePrice)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money."), 1;

            PlayerData[playerid][pMoney] -= g_InsurancePrice;
            GivePlayerMoney(playerid, -g_InsurancePrice);
            UpdatePlayer(playerid, pMoney);

            new inbidx = Businesses_FindByID(11);
            if(inbidx != -1 && !BusinessData[inbidx][bANAF])
            {
                BusinessData[inbidx][bBank] += g_InsurancePrice;

                new inbq[128];
                mysql_format(g_SQL, inbq, sizeof(inbq), "UPDATE `businesses` SET `bank`=%d WHERE `id`=%d",
                    BusinessData[inbidx][bBank], BusinessData[inbidx][bID]);
                mysql_tquery(g_SQL, inbq, "", "", 0);
            }

            PVehicleData[pvidx][pvInsuranceExp] = gettime() + VEHICLE_INSURANCE_DURATION;

            new dateStr[11];
            UnixToDateStr(PVehicleData[pvidx][pvInsuranceExp], dateStr, sizeof(dateStr));

            new q[128];
            mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `insurance_exp`='%s' WHERE `id`=%d",
                dateStr, PVehicleData[pvidx][pvID]);
            mysql_tquery(g_SQL, q, "", "", 0);

            new lmsg[128];
            format(lmsg, sizeof(lmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You bought insurance ("C_INFO"5 days"C_WHITE") for "C_INFO"$%s"C_WHITE"."), MoneyStr(g_InsurancePrice));
            SCM(playerid, COLOR_SUCCESS, lmsg);
            return 1;
        }

        // ---- /v plate [text] ----
        if(strcmp(sub, "plate", true) == 0)
        {
            new vehid = GetPlayerVehicleID(playerid);
            if(vehid == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in a vehicle."), 1;

            new pvidx = g_VehicleToPVIndex[vehid];
            if(pvidx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This is not a personal vehicle."), 1;

            if(PVehicleData[pvidx][pvOwnerId] != PlayerData[playerid][pID])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't own this vehicle."), 1;

            new vpEngine, vpLights, vpAlarm, vpDoors, vpBonnet, vpBoot, vpObjective;
            GetVehicleParamsEx(vehid, vpEngine, vpLights, vpAlarm, vpDoors, vpBonnet, vpBoot, vpObjective);
            if(vpEngine)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The vehicle's engine must be off to do this."), 1;

            if(!IsPlayerInRangeOfPoint(playerid, PLATE_RANGE, PLATE_LOC_X, PLATE_LOC_Y, PLATE_LOC_Z))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the DMV headquarters."), 1;

            if(PlayerData[playerid][pMoney] < g_PlatePrice)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money."), 1;

            while(cmdtext[idx] == ' ') idx++;
            new plate[11];
            strmid(plate, cmdtext, idx, strlen(cmdtext), 10);

            if(!strlen(plate))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/v plate [NUMBER] (Ex: LV 001 AAA)"C_WHITE" (max 10 characters)."), 1;

            // VIP: plate stored (and shown) in a distinct color ({FF2700})
            new finalPlate[24];
            if(PlayerData[playerid][pVIP]) format(finalPlate, sizeof(finalPlate), "{FF2700}%s", plate);
            else format(finalPlate, sizeof(finalPlate), "%s", plate);

            new q[160];
            mysql_format(g_SQL, q, sizeof(q),
                "SELECT `id` FROM `vehicles_personal` WHERE `plate`='%e' AND `id`!=%d LIMIT 1",
                finalPlate, PVehicleData[pvidx][pvID]);
            mysql_tquery(g_SQL, q, "OnVehiclePlateChecked", "iis", playerid, pvidx, finalPlate);
            return 1;
        }

        // ---- /v color1 [colorID] / /v color2 [colorID] ----
        if(strcmp(sub, "color1", true) == 0 || strcmp(sub, "color2", true) == 0)
        {
            new vehid = GetPlayerVehicleID(playerid);
            if(vehid == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in a vehicle."), 1;

            new pvidx = g_VehicleToPVIndex[vehid];
            if(pvidx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This is not a personal vehicle."), 1;

            if(PVehicleData[pvidx][pvOwnerId] != PlayerData[playerid][pID])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't own this vehicle."), 1;

            new slotNum = (strcmp(sub, "color1", true) == 0) ? 1 : 2;

            while(cmdtext[idx] == ' ') idx++;
            new p2[8];
            strmid(p2, cmdtext, idx, strlen(cmdtext), 8);
            if(!strlen(p2))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/v color1 [colorID]"C_WHITE" or "C_INFO"/v color2 [colorID]"C_WHITE"."), 1;

            new colorId = strval(p2);
            new colorMax = PVehicleData[pvidx][pvVip] ? VEHICLE_COLOR_MAX_VIP : VEHICLE_COLOR_MAX_NORMAL;
            if(colorId < 0 || colorId > colorMax)
            {
                new cErr[128];
                format(cErr, sizeof(cErr), T(playerid, C_ERROR"Error: "C_WHITE"Color must be between "C_INFO"0"C_WHITE" and "C_INFO"%d"C_WHITE"%s."),
                    colorMax, PVehicleData[pvidx][pvVip] ? "" : " (VIP vehicles can use up to 255)");
                return SCM(playerid, COLOR_ERROR, cErr), 1;
            }

            if(slotNum == 1) PVehicleData[pvidx][pvColor1] = colorId;
            else PVehicleData[pvidx][pvColor2] = colorId;

            ChangeVehicleColor(vehid, PVehicleData[pvidx][pvColor1], PVehicleData[pvidx][pvColor2]);

            new q[128];
            mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `color1`=%d, `color2`=%d WHERE `id`=%d",
                PVehicleData[pvidx][pvColor1], PVehicleData[pvidx][pvColor2], PVehicleData[pvidx][pvID]);
            mysql_tquery(g_SQL, q, "", "", 0);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"The vehicle's color has been changed.");
            return 1;
        }

        // ---- /v sell [price] ----
        if(strcmp(sub, "sell", true) == 0)
        {
            new vehid = GetPlayerVehicleID(playerid);
            if(vehid == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in a vehicle."), 1;

            new pvidx = g_VehicleToPVIndex[vehid];
            if(pvidx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This is not a personal vehicle."), 1;

            if(PVehicleData[pvidx][pvOwnerId] != PlayerData[playerid][pID])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't own this vehicle."), 1;

            while(cmdtext[idx] == ' ') idx++;
            new vpstr[16];
            strmid(vpstr, cmdtext, idx, strlen(cmdtext), 16);
            if(!strlen(vpstr))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/v sell [price]"C_WHITE" to list it, or "C_INFO"/v sell 0"C_WHITE" to cancel."), 1;

            new vsprice = strval(vpstr);
            new q[128];
            if(vsprice <= 0)
            {
                PVehicleData[pvidx][pvForSale] = 0;
                mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `is_for_sale`=0 WHERE `id`=%d", PVehicleData[pvidx][pvID]);
                mysql_tquery(g_SQL, q, "", "", 0);
                PVehicles_RecreateLabel(pvidx);
                Market_FreeSlotForVehicle(pvidx); // daca sta parcata in market, elibereaza locul
                return SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"Your vehicle is no longer for sale."), 1;
            }

            // ---- listare noua: trebuie predata la punctul de Market (curata, cu plin) ----
            if(!IsPlayerInRangeOfPoint(playerid, MARKET_SELL_RANGE, MARKET_SELL_X, MARKET_SELL_Y, MARKET_SELL_Z))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the Vehicle Market to put your car up for sale."), 1;

            if(PVehicleData[pvidx][pvDirty] >= MARKET_SELL_MAX_DIRTY)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Your vehicle is too dirty. Wash it first (below "C_INFO"50%"C_WHITE")."), 1;

            if(g_VehicleFuel[vehid] <= MARKET_SELL_MIN_FUEL)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Your vehicle needs more fuel first (above "C_INFO"50%"C_WHITE")."), 1;

            PVehicleData[pvidx][pvForSale] = 1;
            PVehicleData[pvidx][pvPrice]   = vsprice;

            if(!Market_ParkVehicle(playerid, pvidx, vehid))
            {
                PVehicleData[pvidx][pvForSale] = 0;
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The Market is full right now. Try again later."), 1;
            }

            mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `is_for_sale`=1, `price`=%d WHERE `id`=%d", vsprice, PVehicleData[pvidx][pvID]);
            mysql_tquery(g_SQL, q, "", "", 0);
            PVehicles_RecreateLabel(pvidx);

            // opreste motorul (nu poate fi repornit cat sta la vanzare in Market - vezi Vehicle_ToggleEngine)
            new vsEngine, vsLights, vsAlarm, vsDoors, vsBonnet, vsBoot, vsObjective;
            GetVehicleParamsEx(vehid, vsEngine, vsLights, vsAlarm, vsDoors, vsBonnet, vsBoot, vsObjective);
            SetVehicleParamsEx(vehid, 0, vsLights, vsAlarm, vsDoors, vsBonnet, vsBoot, vsObjective);

            new lmsg2[144];
            format(lmsg2, sizeof(lmsg2), T(playerid, "Success: Your vehicle is now for sale for $%s. Another player can buy it by entering it and using /vbuy."),
                MoneyStr(vsprice));
            SCM(playerid, COLOR_SUCCESS, lmsg2);
            return 1;
        }

        // ---- /v sellto [playerid] ----
        if(strcmp(sub, "sellto", true) == 0)
        {
            new vehid = GetPlayerVehicleID(playerid);
            if(vehid == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in a vehicle."), 1;

            new pvidx = g_VehicleToPVIndex[vehid];
            if(pvidx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This is not a personal vehicle."), 1;

            if(PVehicleData[pvidx][pvOwnerId] != PlayerData[playerid][pID])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't own this vehicle."), 1;

            while(cmdtext[idx] == ' ') idx++;
            new p1[8];
            strmid(p1, cmdtext, idx, strlen(cmdtext), 8);

            if(!strlen(p1))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/v sellto [playerid]"C_WHITE"."), 1;

            new targetid = strval(p1);
            if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

            if(targetid == playerid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't sell to yourself."), 1;

            new Float:px, Float:py, Float:pz;
            GetPlayerPos(playerid, px, py, pz);
            if(!IsPlayerInRangeOfPoint(targetid, VSELLTO_RANGE, px, py, pz))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player must be within 10m."), 1;

            new E_PLAYER_DATA:slot = PVehicles_FindFreeKeySlot(targetid);
            if(slot == E_PLAYER_DATA:-1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player already owns "C_INFO#MAX_PLAYER_VEHICLES C_WHITE" personal vehicles."), 1;

            PVehicles_ClearKeySlot(playerid, PVehicleData[pvidx][pvID]);

            PVehicleData[pvidx][pvOwnerId] = PlayerData[targetid][pID];
            PVehicleData[pvidx][pvCountOwners]++;
            PlayerData[targetid][slot] = PVehicleData[pvidx][pvID];
            UpdatePlayer(targetid, slot);

            new q[144];
            mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `owner_id`=%d, `count_owners`=%d WHERE `id`=%d",
                PVehicleData[pvidx][pvOwnerId], PVehicleData[pvidx][pvCountOwners], PVehicleData[pvidx][pvID]);
            mysql_tquery(g_SQL, q, "", "", 0);

            new lmsg[128];
            format(lmsg, sizeof(lmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You transferred the vehicle (ID: "C_INFO"%d"C_WHITE") to "C_INFO"%s"C_WHITE"."),
                PVehicleData[pvidx][pvID], PlayerData[targetid][pName]);
            SCM(playerid, COLOR_SUCCESS, lmsg);

            format(lmsg, sizeof(lmsg), T(targetid, C_INFO"Info: "C_WHITE"You received the vehicle (ID: "C_INFO"%d"C_WHITE") from "C_INFO"%s"C_WHITE"."),
                PVehicleData[pvidx][pvID], PlayerData[playerid][pName]);
            SCM(targetid, COLOR_INFO, lmsg);
            return 1;
        }

        // ---- /v selltostate ----
        if(strcmp(sub, "selltostate", true) == 0)
        {
            new vehid = GetPlayerVehicleID(playerid);
            if(vehid == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in a vehicle."), 1;

            new pvidx = g_VehicleToPVIndex[vehid];
            if(pvidx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This is not a personal vehicle."), 1;

            if(PVehicleData[pvidx][pvOwnerId] != PlayerData[playerid][pID])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't own this vehicle."), 1;

            new refund = PVehicleData[pvidx][pvPrice] * 60 / 100;
            PlayerData[playerid][pMoney] += refund;
            GivePlayerMoney(playerid, refund);
            UpdatePlayer(playerid, pMoney);

            PVehicles_ClearKeySlot(playerid, PVehicleData[pvidx][pvID]);
            PVehicleData[pvidx][pvOwnerId] = 0;
            PVehicleData[pvidx][pvForSale] = 1; // inapoi la stat = cumparabil din nou
            PVehicles_RecreateLabel(pvidx);

            new engine, lights, alarm, doors, bonnet, boot, objective;
            GetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);
            SetVehicleParamsEx(vehid, 0, lights, alarm, doors, bonnet, boot, objective);

            new q[128];
            mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `owner_id`=0, `is_for_sale`=1 WHERE `id`=%d", PVehicleData[pvidx][pvID]);
            mysql_tquery(g_SQL, q, "", "", 0);

            new lmsg[128];
            format(lmsg, sizeof(lmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You sold the vehicle (ID: "C_INFO"%d"C_WHITE") for "C_INFO"$%s"C_WHITE"."),
                PVehicleData[pvidx][pvID], MoneyStr(refund));
            SCM(playerid, COLOR_SUCCESS, lmsg);
            return 1;
        }

        // ---- /v park ----
        if(strcmp(sub, "park", true) == 0)
        {
            new vehid = GetPlayerVehicleID(playerid);
            if(vehid == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in a vehicle."), 1;

            new pvidx = g_VehicleToPVIndex[vehid];
            if(pvidx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This is not a personal vehicle."), 1;

            if(PVehicleData[pvidx][pvOwnerId] != PlayerData[playerid][pID])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't own this vehicle."), 1;

            new Float:vpHealth;
            GetVehicleHealth(vehid, vpHealth);
            if(vpHealth <= 400.0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The vehicle's health must be above 400 to park it."), 1;

            new vpEngine, vpLights, vpAlarm, vpDoors, vpBonnet, vpBoot, vpObjective;
            GetVehicleParamsEx(vehid, vpEngine, vpLights, vpAlarm, vpDoors, vpBonnet, vpBoot, vpObjective);
            if(vpEngine)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must turn off the engine before parking ("C_INFO"/engine"C_WHITE")."), 1;

            GetVehiclePos(vehid, PVehicleData[pvidx][pvLocX], PVehicleData[pvidx][pvLocY], PVehicleData[pvidx][pvLocZ]);
            // Folosim GetVehicleZAngle (nu GetVehicleRotation) pentru ca la respawn OnVehicleSpawn
            // foloseste SetVehicleZAngle - trebuie sa fie perechea nativa corecta, altfel unghiul iese gresit (180 grade)
            GetVehicleZAngle(vehid, PVehicleData[pvidx][pvRotation]);

            new q[256];
            mysql_format(g_SQL, q, sizeof(q),
                "UPDATE `vehicles_personal` SET `loc_x`=%.4f, `loc_y`=%.4f, `loc_z`=%.4f, `rotation`=%.4f WHERE `id`=%d",
                PVehicleData[pvidx][pvLocX], PVehicleData[pvidx][pvLocY], PVehicleData[pvidx][pvLocZ], PVehicleData[pvidx][pvRotation],
                PVehicleData[pvidx][pvID]);
            mysql_tquery(g_SQL, q, "", "", 0);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"The vehicle has been parked (position saved).");
            return 1;
        }

        // ---- /v wash (spala vehiculul personal la o spalatorie) ----
        if(strcmp(sub, "wash", true) == 0)
        {
            new vwVehid = GetPlayerVehicleID(playerid);
            if(vwVehid == 0 || GetPlayerVehicleSeat(playerid) != 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be driving a vehicle."), 1;

            new vwPvidx = g_VehicleToPVIndex[vwVehid];
            if(vwPvidx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This is not a personal vehicle."), 1;

            if(!CarWash_PlayerAt(playerid))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at a "C_INFO"CarWash"C_WHITE" to do this."), 1;

            if(PVehicleData[vwPvidx][pvDirty] <= 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This vehicle is already clean."), 1;

            if(PlayerData[playerid][pMoney] < CARWASH_PRICE)
            {
                new vwErr[96];
                format(vwErr, sizeof(vwErr), T(playerid, C_ERROR"Error: "C_WHITE"You need "C_INFO"$%d"C_WHITE" to wash this vehicle."), CARWASH_PRICE);
                return SCM(playerid, COLOR_ERROR, vwErr), 1;
            }

            PlayerData[playerid][pMoney] -= CARWASH_PRICE;
            GivePlayerMoney(playerid, -CARWASH_PRICE);
            UpdatePlayer(playerid, pMoney);

            PVehicleData[vwPvidx][pvDirty] = random(6); // 0-5
            Vehicle_SaveDirty(vwVehid);

            new vwMsg[144];
            format(vwMsg, sizeof(vwMsg), T(playerid, C_SUCCESS"[CarWash] "C_WHITE"Your vehicle is now clean! Paid "C_INFO"$%d"C_WHITE"."), CARWASH_PRICE);
            SCM(playerid, COLOR_SUCCESS, vwMsg);
            return 1;
        }

        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/v [install/ITP/insurance/plate/color1/color2/sell/sellto/selltostate/park/wash]"C_WHITE"."), 1;
    }

    // ---- /buysim (primeste un numar de telefon aleatoriu, unic) ----
    if(strcmp(cmd, "/buysim", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(!Phone_HasPhone(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need a phone. Use "C_INFO"/shop"C_WHITE" (Phone)."), 1;
        if(Phone_IsBroken(playerid))
        {
            new bsBrand[24], bsMsg[144];
            Phone_GetBrand(playerid, bsBrand, sizeof(bsBrand));
            format(bsMsg, sizeof(bsMsg), T(playerid, C_ERROR"Error: "C_WHITE"Your "C_INFO"%s"C_WHITE" is broken and can no longer be used. Buy a new one at "C_INFO"/shop"C_WHITE"."), bsBrand);
            return SCM(playerid, COLOR_ERROR, bsMsg), 1;
        }
        if(PlayerData[playerid][pMoney] < g_PhoneSimPrice)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money for a SIM ("C_INFO"$250"C_WHITE")."), 1;

        Phone_RequestSim(playerid);
        SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Searching for an available phone number...");
        return 1;
    }

    // ---- /call [numar] (suna un jucator online dupa numarul lui de telefon) ----
    // ---- /number [playerid] (necesita Phone Book din /shop) ----
    if(strcmp(cmd, "/number", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(!PlayerData[playerid][pPhoneBook])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need a phone book. Use "C_INFO"/shop"C_WHITE" (24/7)."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new nbp1[8];
        strmid(nbp1, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(nbp1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/number [playerid]"C_WHITE"."), 1;

        new nbTarget = strval(nbp1);
        if(!IsPlayerConnected(nbTarget) || !PlayerData[nbTarget][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        if(!Phone_HasSim(nbTarget))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That player doesn't have a phone number."), 1;

        new nbMsg[128];
        format(nbMsg, sizeof(nbMsg), T(playerid, C_INFO"Info: "C_WHITE"%s's phone number: "C_INFO"%d"), PlayerData[nbTarget][pName], PlayerData[nbTarget][pPhoneNumber]);
        SCM(playerid, COLOR_INFO, nbMsg);
        return 1;
    }

    if(strcmp(cmd, "/call", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(!Phone_HasPhone(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need a phone. Use "C_INFO"/shop"C_WHITE" (Phone)."), 1;
        if(Phone_IsBroken(playerid))
        {
            new clBrand[24], clMsg[144];
            Phone_GetBrand(playerid, clBrand, sizeof(clBrand));
            format(clMsg, sizeof(clMsg), T(playerid, C_ERROR"Error: "C_WHITE"Your "C_INFO"%s"C_WHITE" is broken and can no longer be used. Buy a new one at "C_INFO"/shop"C_WHITE"."), clBrand);
            return SCM(playerid, COLOR_ERROR, clMsg), 1;
        }
        if(!Phone_HasSim(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need a SIM. Use "C_INFO"/buysim"C_WHITE"."), 1;
        if(g_PhoneCallPartner[playerid] != INVALID_PLAYER_ID)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are already in a call. Use "C_INFO"/hangup"C_WHITE"."), 1;

        new ns[256];
        ns = strtok(cmdtext, idx);
        if(!strlen(ns))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/call [number]"C_WHITE"."), 1;

        new number = strval(ns);
        new target = Phone_FindByNumber(number);
        if(target == INVALID_PLAYER_ID)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That number is unavailable or the player isn't online."), 1;
        // [TEMP-SELF] permite auto-apelul pentru testare (de scos)
        // if(target == playerid)
        //     return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't call yourself."), 1;
        if(g_PhoneCallPartner[target] != INVALID_PLAYER_ID)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The number is currently busy."), 1;

        g_PhoneCallPartner[playerid] = target;
        g_PhoneCallCaller[playerid]  = true;
        g_PhoneCallActive[playerid]  = false;
        g_PhoneCallPartner[target]   = playerid;
        g_PhoneCallCaller[target]    = false;
        g_PhoneCallActive[target]    = false;
        g_PhoneRingTimer[playerid]   = SetTimerEx("Phone_RingTimeout", PHONE_CALL_RING_TIMEOUT * 1000, false, "i", playerid);

        new sBrand[24], tBrand[24];
        Phone_GetBrand(playerid, sBrand, sizeof(sBrand));
        Phone_GetBrand(target,   tBrand, sizeof(tBrand));

        new m[260];
        format(m, sizeof(m), T(playerid, C_INFO"[%s]: "C_WHITE"You called "C_INFO"%s"C_WHITE"("C_INFO"%05d"C_WHITE"), wait for an answer."),
            sBrand, PlayerData[target][pName], PlayerData[target][pPhoneNumber]);
        SCM(playerid, COLOR_WHITE, m);

        format(m, sizeof(m), T(target, C_INFO"[%s]: "C_INFO"%s"C_WHITE"("C_INFO"%05d"C_WHITE") "C_WHITE"is calling you. To answer, use "C_INFO"/pickup"C_WHITE"."),
            tBrand, PlayerData[playerid][pName], PlayerData[playerid][pPhoneNumber]);
        SCM(target, COLOR_WHITE, m);
        return 1;
    }

    // ---- /pickup (raspunde la un apel primit) ----
    if(strcmp(cmd, "/pickup", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(g_PhoneCallPartner[playerid] == INVALID_PLAYER_ID)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You have no incoming call."), 1;
        if(g_PhoneCallActive[playerid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are already in a call."), 1;
        if(g_PhoneCallCaller[playerid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You started the call; wait for the other person to answer."), 1;

        new caller = g_PhoneCallPartner[playerid];
        g_PhoneCallActive[playerid] = true;
        g_PhoneCallActive[caller]   = true;
        if(g_PhoneRingTimer[caller] != -1) { KillTimer(g_PhoneRingTimer[caller]); g_PhoneRingTimer[caller] = -1; }
        // initiatorul (caller) plateste taxarea pe durata apelului
        g_PhoneCallTimer[caller] = SetTimerEx("Phone_CallCharge", PHONE_CALL_CHARGE_INTERVAL * 1000, true, "i", caller);

        new sBrand[24], cBrand[24];
        Phone_GetBrand(playerid, sBrand, sizeof(sBrand));
        Phone_GetBrand(caller,   cBrand, sizeof(cBrand));

        new m[160];
        format(m, sizeof(m), T(playerid, C_INFO"[%s]: "C_WHITE"Call started with "C_INFO"%s"C_WHITE"("C_INFO"%05d"C_WHITE"). Use "C_INFO"/hangup"C_WHITE" to end it."),
            sBrand, PlayerData[caller][pName], PlayerData[caller][pPhoneNumber]);
        SCM(playerid, COLOR_WHITE, m);

        format(m, sizeof(m), T(caller, C_INFO"[%s]: "C_WHITE"Call started with "C_INFO"%s"C_WHITE"("C_INFO"%05d"C_WHITE"). Use "C_INFO"/hangup"C_WHITE" to end it."),
            cBrand, PlayerData[playerid][pName], PlayerData[playerid][pPhoneNumber]);
        SCM(caller, COLOR_WHITE, m);
        return 1;
    }

    // ---- /hangup (inchide apelul curent, fie ca suna sau e activ) ----
    if(strcmp(cmd, "/hangup", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(g_PhoneCallPartner[playerid] == INVALID_PLAYER_ID)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not in a call."), 1;

        new partner = g_PhoneCallPartner[playerid];
        new sBrand[24], pBrand[24];
        Phone_GetBrand(playerid, sBrand, sizeof(sBrand));
        if(partner != INVALID_PLAYER_ID) Phone_GetBrand(partner, pBrand, sizeof(pBrand)); else format(pBrand, sizeof(pBrand), "Phone");

        new selfMsg[144], partnerMsg[144];
        format(selfMsg,    sizeof(selfMsg),    C_INFO"[%s]: "C_WHITE"You ended the call.", sBrand);
        format(partnerMsg, sizeof(partnerMsg), C_INFO"[%s]: "C_WHITE"The other party ended the call.", pBrand);
        Phone_EndCall(playerid, selfMsg, partnerMsg);
        return 1;
    }

    // ---- /sms [numar] [mesaj] ----
    // ---- /service [tow/medic] ----
    if(strcmp(cmd, "/service", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new svSub[256];
        svSub = strtok(cmdtext, idx);
        if(!strlen(svSub))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/service [tow/medic/uber]"C_WHITE"."), 1;

        new bool:isTow = (strcmp(svSub, "tow", true) == 0);
        new bool:isMedic = (strcmp(svSub, "medic", true) == 0);

        if(isTow || isMedic)
        {
            new svFid = isTow ? FACTION_RAR : FACTION_SMURD;
            new svColor[9];
            GetFactionColorCode(svFid, svColor, sizeof(svColor));
            new svMsg[180];
            format(svMsg, sizeof(svMsg), "%s[SERVICE] "C_WHITE"Player %s needs a %s. Let them know you're on your way with /sms [%d].",
                svColor, PlayerData[playerid][pName], isTow ? ("tow") : ("medic"), playerid);

            for(new i = 0; i < MAX_PLAYERS; i++)
                if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pFaction] == svFid)
                    {
                        format(svMsg, sizeof(svMsg), T(i, "%s[SERVICE] "C_WHITE"Player %s needs a %s. Let them know you're on your way with /sms [%d]."), svColor, PlayerData[playerid][pName], isTow ? ("tow") : ("medic"), playerid);
                        SCM(i, COLOR_ERROR, svMsg);
                    }

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"Service request sent.");
            return 1;
        }

        if(strcmp(svSub, "uber", true) == 0)
        {
            if(g_UberDriver[playerid] != INVALID_PLAYER_ID)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already have an Uber on the way."), 1;

            // numara soferii uber online
            new uberCount = 0;
            for(new i = 0; i < MAX_PLAYERS; i++)
                if(IsPlayerConnected(i) && PlayerData[i][pLogged] && g_UberOnDuty[i] && g_UberPassenger[i] == INVALID_PLAYER_ID)
                    uberCount++;

            if(uberCount == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"There are no Uber drivers available right now."), 1;

            g_UberWantsRide[playerid] = true;
            g_UberDriver[playerid]    = INVALID_PLAYER_ID;

            new rmsg[144];
            format(rmsg, sizeof(rmsg), C_INFO"[Uber] "C_WHITE"%s"C_WHITE" needs an Uber! Use "C_INFO"/accept uber"C_WHITE" to take the ride.", PlayerData[playerid][pName]);
            for(new i = 0; i < MAX_PLAYERS; i++)
                if(IsPlayerConnected(i) && PlayerData[i][pLogged] && g_UberOnDuty[i] && g_UberPassenger[i] == INVALID_PLAYER_ID)
                    {
                        format(rmsg, sizeof(rmsg), T(i, C_INFO"[Uber] "C_WHITE"%s"C_WHITE" needs an Uber! Use "C_INFO"/accept uber"C_WHITE" to take the ride."), PlayerData[playerid][pName]);
                        SCM(i, COLOR_INFO, rmsg);
                    }

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Uber] "C_WHITE"An Uber has been requested. Please wait for a driver.");
            return 1;
        }

        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/service [tow/medic/uber]"C_WHITE"."), 1;
    }

    if(strcmp(cmd, "/sms", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(!Phone_HasPhone(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need a phone. Use "C_INFO"/shop"C_WHITE" (Phone)."), 1;
        if(Phone_IsBroken(playerid))
        {
            new smBrand[24], smMsg[144];
            Phone_GetBrand(playerid, smBrand, sizeof(smBrand));
            format(smMsg, sizeof(smMsg), T(playerid, C_ERROR"Error: "C_WHITE"Your "C_INFO"%s"C_WHITE" is broken and can no longer be used. Buy a new one at "C_INFO"/shop"C_WHITE"."), smBrand);
            return SCM(playerid, COLOR_ERROR, smMsg), 1;
        }
        if(!Phone_HasSim(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need a SIM. Use "C_INFO"/buysim"C_WHITE"."), 1;

        new ns[256];
        ns = strtok(cmdtext, idx);
        while(cmdtext[idx] == ' ') idx++;
        new text[128];
        strmid(text, cmdtext, idx, strlen(cmdtext), 128);

        if(!strlen(ns) || !strlen(text))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/sms [number] [message]"C_WHITE"."), 1;

        new number = strval(ns);
        new target = Phone_FindByNumber(number);
        if(target == INVALID_PLAYER_ID)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That number is unavailable or the player isn't online."), 1;
        // [TEMP-SELF] permite auto-SMS pentru testare (de scos)
        // if(target == playerid)
        //     return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't text yourself."), 1;
        if(PlayerData[playerid][pMoney] < PHONE_SMS_PRICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money ("C_INFO"$5"C_WHITE")."), 1;

        PlayerData[playerid][pMoney] -= PHONE_SMS_PRICE;
        GivePlayerMoney(playerid, -PHONE_SMS_PRICE);
        UpdatePlayer(playerid, pMoney);

        new cut = Phone_CarrierCut(PHONE_SMS_PRICE);
        if(cut > 0) Job_AddBizIncome(PHONE_CARRIER_BIZ_ID, cut);

        new sBrand[24], tBrand[24];
        Phone_GetBrand(playerid, sBrand, sizeof(sBrand));
        Phone_GetBrand(target,   tBrand, sizeof(tBrand));

        new m[356];
        format(m, sizeof(m), T(playerid, C_INFO"[%s]: "C_WHITE"SMS to "C_INFO"%s"C_WHITE"("C_INFO"%05d"C_WHITE"): %s"),
            sBrand, PlayerData[target][pName], PlayerData[target][pPhoneNumber], text);
        SCM(playerid, COLOR_WHITE, m);

        format(m, sizeof(m), T(target, C_INFO"[%s]: ""{FFFF00}""SMS from "C_WHITE"%s("C_INFO"%05d"C_WHITE"): "C_WHITE"%s"),
            tBrand, PlayerData[playerid][pName], PlayerData[playerid][pPhoneNumber], text);
        SCM(target, COLOR_WHITE, m);
        return 1;
    }

    // ---- /time [country] (cere un ceas; ora + data curenta, sau ora intr-o alta tara dupa GMT) ----
    if(strcmp(cmd, "/time", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(!Watch_HasWatch(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need a watch. Use "C_INFO"/shop"C_WHITE" (Watch)."), 1;
        if(Watch_IsBroken(playerid))
        {
            new twBrand[24], twMsg[144];
            Watch_GetBrand(playerid, twBrand, sizeof(twBrand));
            format(twMsg, sizeof(twMsg), T(playerid, C_ERROR"Error: "C_WHITE"Your "C_INFO"%s"C_WHITE" is broken and can no longer be used. Buy a new one at "C_INFO"/shop"C_WHITE"."), twBrand);
            return SCM(playerid, COLOR_ERROR, twMsg), 1;
        }

        while(cmdtext[idx] == ' ') idx++;
        new tCountryArg[24];
        strmid(tCountryArg, cmdtext, idx, strlen(cmdtext), 24);
        Watch_ShowTime(playerid, tCountryArg);
        return 1;
    }

    // ---- /watch time|health|temp|status (necesita ceas functional) ----
    if(strcmp(cmd, "/watch", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(!Watch_HasWatch(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need a watch. Use "C_INFO"/shop"C_WHITE" (Watch)."), 1;
        if(Watch_IsBroken(playerid))
        {
            new wBrand[24], wErr[144];
            Watch_GetBrand(playerid, wBrand, sizeof(wBrand));
            format(wErr, sizeof(wErr), T(playerid, C_ERROR"Error: "C_WHITE"Your "C_INFO"%s"C_WHITE" is broken and can no longer be used. Buy a new one at "C_INFO"/shop"C_WHITE"."), wBrand);
            return SCM(playerid, COLOR_ERROR, wErr), 1;
        }

        new wSub[256];
        wSub = strtok(cmdtext, idx);
        if(!strlen(wSub))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/watch [time/health/temp/status]"C_WHITE"."), 1;

        if(strcmp(wSub, "time", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new wCountryArg[24];
            strmid(wCountryArg, cmdtext, idx, strlen(cmdtext), 24);
            Watch_ShowTime(playerid, wCountryArg);
            return 1;
        }
        if(strcmp(wSub, "health", true) == 0)
        {
            Watch_ShowHealth(playerid);
            return 1;
        }
        if(strcmp(wSub, "temp", true) == 0)
        {
            Watch_ShowTemp(playerid);
            return 1;
        }
        if(strcmp(wSub, "status", true) == 0)
        {
            Watch_ShowStatus(playerid);
            return 1;
        }
        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/watch [time/health/temp/status]"C_WHITE"."), 1;
    }

    // ---- /jobs (lista joburilor disponibile) ----
    if(strcmp(cmd, "/jobs", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        SCM(playerid, COLOR_INFO, C_INFO"===== Available Jobs =====");
        for(new i = 0; i < MAX_JOBS; i++)
        {
            new line[96];
            format(line, sizeof(line), C_INFO"#%d"C_WHITE". %s", i + 1, g_JobNames[i]);
            if(i + 1 == JOB_TRANSPORT) strcat(line, C_INFO" (WE: 16:00-23:00)");
            SCM(playerid, COLOR_WHITE, line);
        }
        SCM(playerid, COLOR_INFO, C_WHITE"Use "C_INFO"/getjob [id or name]"C_WHITE" to take one.");
        SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"To get a job or resign, visit the "C_INFO"City Hall"C_WHITE".");
        return 1;
    }

    // ---- /getjob [id or name] ----
    if(strcmp(cmd, "/getjob", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(!Job_AtGetJob(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the Job Center inside the City Hall to do this."), 1;

        if(PlayerData[playerid][pJob] != 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already have a job. Use "C_INFO"/quitjob"C_WHITE" first."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new jobStr[32];
        strmid(jobStr, cmdtext, idx, strlen(cmdtext), 32);
        if(!strlen(jobStr))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/getjob [id or name]"C_WHITE". See "C_INFO"/jobs"C_WHITE" for the list."), 1;

        new jobId;
        if(jobStr[0] >= '0' && jobStr[0] <= '9')
        {
            jobId = strval(jobStr);
        }
        else
        {
            jobId = Job_FindByName(jobStr);
            if(jobId == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Unknown job. See "C_INFO"/jobs"C_WHITE" for the list."), 1;
        }

        if(jobId < 1 || jobId > MAX_JOBS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid job. Choose between 1 and "#MAX_JOBS"."), 1;

        PlayerData[playerid][pJob] = jobId;
        UpdatePlayer(playerid, pJob);

        new jmsg[96];
        format(jmsg, sizeof(jmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You took job "C_INFO"#%d"C_WHITE"."), jobId);
        SCM(playerid, COLOR_SUCCESS, jmsg);
        return 1;
    }

    // ---- /quitjob ----
    if(strcmp(cmd, "/quitjob", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(!Job_AtQuitJob(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the Job Center inside the City Hall to do this."), 1;

        if(PlayerData[playerid][pJob] == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a job."), 1;

        if(g_IsWorking[playerid]) Job_StopWork(playerid);  // daca lucra, opreste si munca
        if(g_UberOnDuty[playerid]) Uber_GoOffDuty(playerid); // daca era uber, scoate-l din serviciu

        PlayerData[playerid][pJob] = 0;
        UpdatePlayer(playerid, pJob);

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"You quit your job.");
        return 1;
    }

    // ---- /setjob [playerid] [jobid] (admin: seteaza jobul unui player, 0 = niciun job) ----
    if(strcmp(cmd, "/setjob", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new sjp[8], sja = 0;
        while(cmdtext[idx] > ' ' && sja < 7) { sjp[sja++] = cmdtext[idx]; idx++; }
        sjp[sja] = EOS;
        while(cmdtext[idx] == ' ') idx++;
        new sjj[8];
        strmid(sjj, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(sjp) || !strlen(sjj))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/setjob [playerid] [jobid]"C_WHITE" (0-"#MAX_JOBS")."), 1;

        new targetid = strval(sjp), jobid = strval(sjj);
        if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;
        if(jobid < 0 || jobid > MAX_JOBS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid job. Choose between 0 and "#MAX_JOBS"."), 1;

        if(g_IsWorking[targetid])  Job_StopWork(targetid);   // opreste munca in curs
        if(g_UberOnDuty[targetid]) Uber_GoOffDuty(targetid); // scoate-l din serviciul uber

        PlayerData[targetid][pJob] = jobid;
        UpdatePlayer(targetid, pJob);

        new sjJobName[32];
        if(jobid >= 1 && jobid <= MAX_JOBS) format(sjJobName, sizeof(sjJobName), "%s", g_JobNames[jobid - 1]);
        else format(sjJobName, sizeof(sjJobName), "none");

        new sjmsg[144];
        format(sjmsg, sizeof(sjmsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Set "C_INFO"%s"C_WHITE"'s job to "C_INFO"#%d - %s"C_WHITE"."),
            PlayerData[targetid][pName], jobid, sjJobName);
        SCM(playerid, COLOR_SUCCESS, sjmsg);

        if(targetid != playerid)
        {
            format(sjmsg, sizeof(sjmsg), T(targetid, C_INFO"[Job] "C_WHITE"An admin set your job to "C_INFO"#%d - %s"C_WHITE"."), jobid, sjJobName);
            SCM(targetid, COLOR_WHITE, sjmsg);
        }
        return 1;
    }

    // ---- /stopwork (opreste munca curenta) ----
    // ---- /workjail (doar la inchisoare: alege intre a uda copacii sau a carat lazi cu mere, in bucla) ----
    if(strcmp(cmd, "/workjail", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pJailSeconds] <= 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in jail to do this."), 1;

        if(g_JailWorkActivity[playerid] != JAILWORK_NONE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are already working. Use "C_INFO"/stopwork"C_WHITE" first."), 1;

        SPD(playerid, DIALOG_JAILWORK, DIALOG_STYLE_LIST, "Jail Work", "Water the trees\nCarry the apple crates", "Select", "Cancel");
        return 1;
    }

    // ---- /eat (doar la inchisoare: +20hp, $11) ----
    if(strcmp(cmd, "/eat", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pJailSeconds] <= 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in jail to do this."), 1;

        if(!IsPlayerInRangeOfPoint(playerid, JAILFOOD_RANGE, JAILEAT_X, JAILEAT_Y, JAILEAT_Z))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the "C_INFO"[ Jail ]"C_WHITE" food point to do this."), 1;

        if(PlayerData[playerid][pMoney] < JAILEAT_PRICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money."), 1;

        PlayerData[playerid][pMoney] -= JAILEAT_PRICE;
        GivePlayerMoney(playerid, -JAILEAT_PRICE);
        UpdatePlayer(playerid, pMoney);

        new Float:jeHp;
        GetPlayerHealth(playerid, jeHp);
        jeHp += JAILEAT_HP;
        if(jeHp > 100.0) jeHp = 100.0;
        SetPlayerHealth(playerid, jeHp);

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Jail] "C_WHITE"You ate a meal ("C_INFO"-$11"C_WHITE", "C_INFO"+20hp"C_WHITE").");
        return 1;
    }

    // ---- /drink (la inchisoare: +15hp fix, $9; in oras: trebuie sa fii la un bar, meniu cu 6 bauturi) ----
    if(strcmp(cmd, "/drink", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pJailSeconds] > 0)
        {
            if(!IsPlayerInRangeOfPoint(playerid, JAILFOOD_RANGE, JAILDRINK_X, JAILDRINK_Y, JAILDRINK_Z))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the "C_INFO"[ Jail ]"C_WHITE" drink point to do this."), 1;

            if(PlayerData[playerid][pMoney] < JAILDRINK_PRICE)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money."), 1;

            PlayerData[playerid][pMoney] -= JAILDRINK_PRICE;
            GivePlayerMoney(playerid, -JAILDRINK_PRICE);
            UpdatePlayer(playerid, pMoney);

            new Float:jdHp;
            GetPlayerHealth(playerid, jdHp);
            jdHp += JAILDRINK_HP;
            if(jdHp > 100.0) jdHp = 100.0;
            SetPlayerHealth(playerid, jdHp);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Jail] "C_WHITE"You had a drink ("C_INFO"-$9"C_WHITE", "C_INFO"+15hp"C_WHITE").");
            return 1;
        }

        if(Bar_PlayerInside(playerid) == -1 && !Bar_IsAtCafe(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be inside a bar, or at a cafe terrace, to do this."), 1;

        if(g_BarHoldingDrink[playerid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You're already holding a drink. Click (fire) to drink it."), 1;

        static bdlist[600];
        bdlist[0] = EOS;
        strcat(bdlist, T(playerid, ""C_INFO"Drink\t"C_INFO"Type\t"C_INFO"Price\n"));
        for(new bdi = 0; bdi < sizeof(BarDrinkData); bdi++)
        {
            new bdline[80];
            format(bdline, sizeof(bdline), ""C_WHITE"%s\t"C_WHITE"%s\t"C_WHITE"$%d\n",
                BarDrinkData[bdi][bdName], BarDrinkData[bdi][bdCategory], BarDrinkData[bdi][bdPrice]);
            strcat(bdlist, bdline);
        }

        SPD(playerid, DIALOG_BARDRINK, DIALOG_STYLE_TABLIST_HEADERS, "Bar - Drinks", bdlist, "Buy", "Close");
        return 1;
    }

    // ---- /yard (doar la inchisoare: iese in curte, sau se intoarce in celula daca e deja in curte) ----
    if(strcmp(cmd, "/yard", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pJailSeconds] <= 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in jail to do this."), 1;

        if(GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0 &&
           IsPlayerInRangeOfPoint(playerid, JAIL_YARD_RANGE, JAIL_YARD_X, JAIL_YARD_Y, JAIL_YARD_Z))
        {
            AC_SetInterior(playerid, JAIL_INTERIOR);
            AC_SetVW(playerid, JAIL_VW);
            AC_SetPos(playerid, JAIL_X, JAIL_Y, JAIL_Z);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Jail] "C_WHITE"You went back inside.");
            return 1;
        }

        AC_SetInterior(playerid, 0);
        AC_SetVW(playerid, 0);
        AC_SetPos(playerid, JAIL_YARD_X, JAIL_YARD_Y, JAIL_YARD_Z);
        SetPlayerFacingAngle(playerid, JAIL_YARD_A);
        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Jail] "C_WHITE"You went outside to the yard.");
        return 1;
    }

    if(strcmp(cmd, "/stopwork", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(g_JailWorkActivity[playerid] != JAILWORK_NONE)
        {
            JailWork_Stop(playerid);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Jail Work] "C_WHITE"You stopped working.");
            return 1;
        }

        if(g_UberOnDuty[playerid])
        {
            Uber_GoOffDuty(playerid);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Uber] "C_WHITE"You went off duty.");
            return 1;
        }

        if(g_MgrState[playerid] != MGR_STATE_NONE)
        {
            Manage_Stop(playerid);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Manager] "C_WHITE"You cancelled the mission.");
            return 1;
        }

        if(g_BusLine[playerid] > 0)
        {
            Bus_End(playerid);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Bus] "C_WHITE"You cancelled your bus route.");
            return 1;
        }

        if(g_CropDustState[playerid] != CROPDUST_STATE_NONE)
        {
            CropDust_Stop(playerid);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[CropDuster] "C_WHITE"You stopped working.");
            return 1;
        }

        if(g_WaterStage[playerid] != WATER_STAGE_NONE)
        {
            Water_Stop(playerid);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Water Hauler] "C_WHITE"You stopped working.");
            return 1;
        }

        if(g_FuelCarrierStage[playerid] != FUELCARRIER_STAGE_NONE)
        {
            FuelCarrier_Stop(playerid);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Fuel Carrier] "C_WHITE"You stopped working.");
            return 1;
        }

        if(g_TruckDriverStage[playerid] != TRUCKDRIVER_STAGE_NONE)
        {
            TruckDriver_Stop(playerid);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Truck Driver] "C_WHITE"You stopped working.");
            return 1;
        }

        if(g_CurrencyStage[playerid] != CURRENCY_STAGE_NONE)
        {
            CurrencyTransport_Stop(playerid);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Currency Transporter] "C_WHITE"You stopped working.");
            return 1;
        }

        if(!g_IsWorking[playerid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not working."), 1;

        Job_StopWork(playerid);
        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"You stopped working.");
        return 1;
    }

    // ---- /bus [nr-linie] (Bus Driver: porneste o ruta cu checkpoint-uri) ----
    if(strcmp(cmd, "/bus", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pJob] != JOB_BUS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need the Bus Driver job. Get it with "C_INFO"/getjob bus driver"C_WHITE"."), 1;

        new busVeh = GetPlayerVehicleID(playerid);
        if(busVeh == 0 || GetPlayerState(playerid) != PLAYER_STATE_DRIVER || !Bus_IsBusVehicle(busVeh))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be driving a bus from the depot."), 1;

        if(g_BusLine[playerid] > 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are already on a route. Use "C_INFO"/stopwork"C_WHITE" to cancel it."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new bl[8];
        strmid(bl, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(bl))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bus [1-"#MAX_BUS_LINES"]"C_WHITE"."), 1;

        new line = strval(bl);
        if(line < 1 || line > MAX_BUS_LINES)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid line. Use "C_INFO"/bus [1-"#MAX_BUS_LINES"]"C_WHITE"."), 1;
        if(g_BusRouteCount[line - 1] == 0)
        {
            new nm[96];
            format(nm, sizeof(nm), T(playerid, C_ERROR"Error: "C_WHITE"Bus line "C_INFO"%d"C_WHITE" is not set up yet."), line);
            return SCM(playerid, COLOR_ERROR, nm), 1;
        }

        g_BusLine[playerid] = line;
        g_BusCP[playerid]   = 0;

        new Float:px, Float:py, Float:pz;
        GetPlayerPos(playerid, px, py, pz);
        g_BusLastX[playerid] = px;
        g_BusLastY[playerid] = py;

        Bus_SetCheckpoint(playerid);

        new gtStart[24];
        format(gtStart, sizeof(gtStart), T(playerid, "Next stop: 1/%d"), g_BusRouteCount[line - 1]);
        JobStatus_Update(playerid, gtStart);

        new sm[200];
        format(sm, sizeof(sm), T(playerid, "[Bus] Line %d started (%d stops). Follow the checkpoints; the route loops back to stop 1 at the end."),
            line, g_BusRouteCount[line - 1]);
        SCM(playerid, COLOR_SUCCESS, sm);
        return 1;
    }

    // ---- /fare [amount] (Uber: intri in serviciu cu masina personala) ----
    if(strcmp(cmd, "/fare", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pJob] != JOB_UBER)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need the Uber job. Get it with "C_INFO"/getjob uber"C_WHITE"."), 1;

        new fareVeh = GetPlayerVehicleID(playerid);
        if(fareVeh == 0 || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be driving your personal vehicle."), 1;

        new farePv = g_VehicleToPVIndex[fareVeh];
        if(farePv == -1 || PVehicleData[farePv][pvOwnerId] != PlayerData[playerid][pID])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in your own personal vehicle."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new fareStr[12];
        strmid(fareStr, cmdtext, idx, strlen(cmdtext), 12);
        if(!strlen(fareStr))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/fare [amount]"C_WHITE" (price charged every "#UBER_CHARGE_INTERVAL"s)."), 1;

        new fareAmount = strval(fareStr);
        if(fareAmount <= 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid fare amount."), 1;

        g_UberOnDuty[playerid]  = true;
        g_UberFare[playerid]    = fareAmount;
        g_UberVehicle[playerid] = fareVeh;

        new fmsg[256];
        format(fmsg, sizeof(fmsg),
            C_INFO"[Uber] "C_WHITE"%s"C_WHITE" is on duty as an Uber driver, accepting rides for "C_INFO"$%s"C_WHITE"/"#UBER_CHARGE_INTERVAL"s. Use "C_INFO"/service uber"C_WHITE".",
            PlayerData[playerid][pName], MoneyStr(fareAmount));
        SCMToAll(COLOR_INFO, fmsg);
        return 1;
    }

    // ---- /service [uber] (ceri un serviciu) ----
    // ---- /work (incepi munca la jobul tau curent) ----
    if(strcmp(cmd, "/work", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pJob] == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a job. Use "C_INFO"/getjob [1-"#MAX_JOBS"]"C_WHITE" first."), 1;

        switch(PlayerData[playerid][pJob])
        {
            case JOB_GLOVO:     Job_StartWork(playerid);
            case JOB_CEMENT:    Job_StartWork(playerid);
            case JOB_GUN:       Job_StartWork(playerid);
            case JOB_TRANSPORT:
            {
                // [TEMP-TRANSPORTHOURS] jobul se poate face doar Vineri/Sambata/Duminica, 16:00-23:00. Dezactivat temporar (vezi roadmap).
                // if(!Job_TransportWindowOpen())
                //     return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Car transport is only available Fri-Sun, 16:00-23:00."), 1;
                Job_StartWork(playerid);
            }
            case JOB_UBER:      SCM(playerid, COLOR_INFO, C_INFO"[Uber] "C_WHITE"As an Uber driver, use "C_INFO"/fare [amount]"C_WHITE" in your personal vehicle to go on duty.");
            case JOB_EMERGENCY: Job_StartWork(playerid);
            case JOB_BUS:       SCM(playerid, COLOR_INFO, C_INFO"[Bus] "C_WHITE"As a Bus Driver, get in a depot bus and use "C_INFO"/bus [1-"#MAX_BUS_LINES"]"C_WHITE" to start a route.");
            case 8:  { /* TODO: implementeaza job 8 */  SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Job 8 is not available yet."); }
            case JOB_CROPDUST: CropDust_Start(playerid);
            case JOB_WATER: Water_StartWork(playerid);
            case JOB_FISHERMAN: SCM(playerid, COLOR_INFO, C_INFO"[Fisherman] "C_WHITE"Go to a fishing spot and use "C_INFO"/fish"C_WHITE" to start.");
            case JOB_LUMBERJACK: SCM(playerid, COLOR_INFO, C_INFO"[Lumberjack] "C_WHITE"Get a chainsaw and use "C_INFO"/chopwood"C_WHITE" at a forest to start.");
            case JOB_FUELCARRIER: FuelCarrier_StartWork(playerid);
            case JOB_TRUCKDRIVER: TruckDriver_StartWork(playerid);
            case JOB_CURRENCY: CurrencyTransport_StartWork(playerid);
            case JOB_BEACH: Beach_StartWork(playerid);
            default: SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"This job is not available yet.");
        }
        return 1;
    }

    // ---- /fish (Fisherman: prinde peste la un punct dedicat, apoi livreaza-l la un fast-food) ----
    if(strcmp(cmd, "/fish", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pJob] != JOB_FISHERMAN)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have the Fisherman job. Use "C_INFO"/getjob"C_WHITE" first."), 1;

        if(!PlayerData[playerid][pFishingRod])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need a fishing rod. Buy one at a "C_INFO"Tools Shop"C_WHITE" ("C_INFO"/shop"C_WHITE")."), 1;

        if(g_FishState[playerid] != FISH_STATE_NONE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are already fishing or delivering."), 1;

        new bool:fAtSpot = false;
        if(FISH_LOC1_X != 0.0 && IsPlayerInRangeOfPoint(playerid, FISH_RANGE, FISH_LOC1_X, FISH_LOC1_Y, FISH_LOC1_Z)) fAtSpot = true;
        else if(FISH_LOC2_X != 0.0 && IsPlayerInRangeOfPoint(playerid, FISH_RANGE, FISH_LOC2_X, FISH_LOC2_Y, FISH_LOC2_Z)) fAtSpot = true;
        else if(FISH_LOC3_X != 0.0 && IsPlayerInRangeOfPoint(playerid, FISH_RANGE, FISH_LOC3_X, FISH_LOC3_Y, FISH_LOC3_Z)) fAtSpot = true;

        if(!fAtSpot)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at a fishing spot."), 1;

        g_FishState[playerid] = FISH_STATE_FISHING;
        TogglePlayerControllable(playerid, 0);
        ApplyAnimation(playerid, "SWORD", "sword_block", 4.1, 1, 0, 0, 0, 0, 1);
        SetPlayerAttachedObject(playerid, FISH_ROD_ATTACH_INDEX, FISH_ROD_MODEL, FISH_ROD_ATTACH_BONE,
            g_FishRodOffX, g_FishRodOffY, g_FishRodOffZ, g_FishRodRotX, g_FishRodRotY, g_FishRodRotZ, 1.0, 1.0, 1.0);
        GTP(playerid, "Fishing...", FISH_ANIM_TIME_MS, 3);
        SetTimerEx("Fish_Finish", FISH_ANIM_TIME_MS, false, "i", playerid);

        JobStatus_Update(playerid, "Fishing...");
        SCM(playerid, COLOR_INFO, C_INFO"[Fisherman] "C_WHITE"You cast your line...");
        return 1;
    }

    // ---- /chopwood (Lumberjack: taie copaci dintr-o padure, o singura data per payday) ----
    if(strcmp(cmd, "/chopwood", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pJob] != JOB_LUMBERJACK)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have the Lumberjack job. Use "C_INFO"/getjob"C_WHITE" first."), 1;

        if(g_LumberState[playerid] != LUMBER_STATE_NONE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are already carrying or delivering wood."), 1;

        if(g_ChopUsedThisPayday[playerid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can only chop wood once per payday."), 1;

        if(GetPlayerWeapon(playerid) != WEAPON_CHAINSAW)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need a "C_INFO"Chainsaw"C_WHITE" in hand. Buy one at a "C_INFO"Tools Shop"C_WHITE" ("C_INFO"/shop"C_WHITE")."), 1;

        new lwfidx = Forest_PlayerIn(playerid);
        if(lwfidx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at a forest."), 1;

        if(ForestData[lwfidx][fstCurrentTree] <= 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This forest has no trees left. Wait for it to regrow."), 1;

        new lwCut = LUMBER_CUT_MIN + random(LUMBER_CUT_RAND);
        if(lwCut > ForestData[lwfidx][fstCurrentTree]) lwCut = ForestData[lwfidx][fstCurrentTree];

        ForestData[lwfidx][fstCurrentTree] -= lwCut;
        new lwq[128];
        mysql_format(g_SQL, lwq, sizeof(lwq), "UPDATE `forests` SET `currentTree`=%d WHERE `id`=%d", ForestData[lwfidx][fstCurrentTree], ForestData[lwfidx][fstID]);
        mysql_tquery(g_SQL, lwq, "", "", 0);

        g_ChopUsedThisPayday[playerid] = true;
        g_LumberWoodCount[playerid]    = lwCut;
        g_LumberState[playerid]        = LUMBER_STATE_CARRYING;

        if(g_LumberCarryTimer[playerid] != -1) KillTimer(g_LumberCarryTimer[playerid]);
        g_LumberCarryTimer[playerid] = SetTimerEx("Lumber_CarryTimeout", LUMBER_CARRY_TIME_MS, false, "i", playerid);

        JobStatus_Update(playerid, "Get into a truck within 45 seconds or you'll lose the wood.");

        new lwmsg[256];
        format(lwmsg, sizeof(lwmsg), T(playerid, C_SUCCESS"[Lumberjack] "C_WHITE"You cut "C_INFO"%d"C_WHITE" trees!"), lwCut);
        SCM(playerid, COLOR_SUCCESS, lwmsg);
        return 1;
    }

    // ---- /funeral (Romero: transporta un animal decedat de la casa la capela) ----
    if(strcmp(cmd, "/funeral", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        Funeral_Start(playerid);
        return 1;
    }

    // ---- /train (calatoreste intre statii, $150 biletul) ----
    if(strcmp(cmd, "/train", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pWanted] > 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't use the train while wanted."), 1;

        if(Train_FindNearbyIndex(playerid) == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at a train station to do this."), 1;

        if(g_StatTrainRides >= TRAIN_MAX_RIDES)
            return Train_ShowBroken(playerid), 1;

        new dlg[256];
        format(dlg, sizeof(dlg), T(playerid, ""C_INFO"Station\t"C_INFO"Price\n"C_WHITE"%s\t"C_SUCCESS"$%d\n"C_WHITE"%s\t"C_SUCCESS"$%d\n"C_WHITE"%s\t"C_SUCCESS"$%d"),
            g_TrainStationName[0], TRAIN_PRICE, g_TrainStationName[1], TRAIN_PRICE, g_TrainStationName[2], TRAIN_PRICE);
        SPD(playerid, DIALOG_TRAIN, DIALOG_STYLE_TABLIST_HEADERS, "Train Stations", dlg, "Select", "Close");
        return 1;
    }

    // ---- /taxi (teleport la orice locatie din GPS, $200, o data per payday) ----
    if(strcmp(cmd, "/taxi", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pWanted] > 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't use the taxi while wanted."), 1;

        if(!Taxi_IsPlayerAtStation(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the taxi service to do this."), 1;

        if(g_TaxiUsedThisPayday[playerid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can only use the taxi once per payday."), 1;

        if(PlayerData[playerid][pMoney] < TAXI_PRICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money for a taxi ride."), 1;

        g_TaxiMode[playerid] = true;
        GPS_ShowCategoryDialog(playerid);
        return 1;
    }

    // ---- /up (Gondola: baza -> varf, $10) ----
    if(strcmp(cmd, "/up", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(GetPlayerVehicleID(playerid) != 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't use the gondola while in a vehicle."), 1;

        new upPair = UpDown_FindPair(playerid, 0);
        if(upPair == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the gondola to use this."), 1;

        if(PlayerData[playerid][pMoney] < UPDOWN_PRICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money."), 1;

        PlayerData[playerid][pMoney] -= UPDOWN_PRICE;
        GivePlayerMoney(playerid, -UPDOWN_PRICE);
        UpdatePlayer(playerid, pMoney);

        AC_SetPos(playerid, g_UpDownDown[upPair][0], g_UpDownDown[upPair][1], g_UpDownDown[upPair][2]);

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Gondola] "C_WHITE"You went up.");
        return 1;
    }

    // ---- /down (Gondola: varf -> baza, $10) ----
    if(strcmp(cmd, "/down", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(GetPlayerVehicleID(playerid) != 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't use the gondola while in a vehicle."), 1;

        new downPair = UpDown_FindPair(playerid, 1);
        if(downPair == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the gondola to use this."), 1;

        if(PlayerData[playerid][pMoney] < UPDOWN_PRICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money."), 1;

        PlayerData[playerid][pMoney] -= UPDOWN_PRICE;
        GivePlayerMoney(playerid, -UPDOWN_PRICE);
        UpdatePlayer(playerid, pMoney);

        AC_SetPos(playerid, g_UpDownUp[downPair][0], g_UpDownUp[downPair][1], g_UpDownUp[downPair][2]);

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Gondola] "C_WHITE"You went down.");
        return 1;
    }

    // ---- /buyticket (Gondola: bilet valid, cumparat la orice statie /up sau /down, $2) ----
    if(strcmp(cmd, "/buyticket", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(!IsPlayerInRangeOfPoint(playerid, UPDOWN_RANGE, UPDOWN_TICKET_LOC_X, UPDOWN_TICKET_LOC_Y, UPDOWN_TICKET_LOC_Z))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the ticket booth to use this."), 1;

        if(g_HasGondolaTicket[playerid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already have a valid ticket."), 1;

        if(PlayerData[playerid][pMoney] < UPDOWN_TICKET_PRICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money."), 1;

        PlayerData[playerid][pMoney] -= UPDOWN_TICKET_PRICE;
        GivePlayerMoney(playerid, -UPDOWN_TICKET_PRICE);
        UpdatePlayer(playerid, pMoney);

        g_HasGondolaTicket[playerid] = true;
        g_GondolaTicketPaydaysLeft[playerid] = UPDOWN_TICKET_PAYDAYS;

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Gondola] "C_WHITE"You bought a ticket. It's lost if you die, respawn, disconnect, or after 2 paydays.");
        return 1;
    }

    // ---- /gotogondola (admin 2+: teleporteaza la pozitia curenta a cabinei telegondolei, Z+2) ----
    if(strcmp(cmd, "/gotogondola", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 2)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

        if(g_TeleGondolaObj == STREAMER_TAG_OBJECT:INVALID_STREAMER_ID)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The gondola cabin doesn't exist."), 1;

        new Float:ggx, Float:ggy, Float:ggz;
        GetDynamicObjectPos(g_TeleGondolaObj, ggx, ggy, ggz);

        new ggVeh = GetPlayerVehicleID(playerid);
        if(ggVeh != 0 && GetPlayerVehicleSeat(playerid) == 0)
            SetVehiclePos(ggVeh, ggx, ggy, ggz + 2.0);
        else
            AC_SetPos(playerid, ggx, ggy, ggz + 2.0);

        new ggmsg[144];
        format(ggmsg, sizeof(ggmsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Teleported to the gondola cabin ("C_INFO"%.2f, %.2f, %.2f"C_WHITE")."), ggx, ggy, ggz);
        SCM(playerid, COLOR_SUCCESS, ggmsg);
        return 1;
    }

    // ---- /anim [library] [animation_name] (aplica direct o animatie GTA SA) ----
    if(strcmp(cmd, "/anim", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new animLib[32], alPos = 0;
        while(cmdtext[idx] > ' ' && alPos < 31) { animLib[alPos++] = cmdtext[idx]; idx++; }
        animLib[alPos] = EOS;

        while(cmdtext[idx] == ' ') idx++;
        new animName[32], anPos = 0;
        while(cmdtext[idx] > ' ' && anPos < 31) { animName[anPos++] = cmdtext[idx]; idx++; }
        animName[anPos] = EOS;

        if(!strlen(animLib) || !strlen(animName))
            return SCM(playerid, COLOR_INFO, "Info: Use /anim [library] [animation_name]. See /animlibs and /animlist [library]."), 1;

        ApplyAnimation(playerid, animLib, animName, 4.1, 1, 0, 0, 0, 0, 1);

        new amsg[256];
        format(amsg, sizeof(amsg), T(playerid, C_SUCCESS"Success: "C_WHITE"Playing "C_INFO"%s"C_WHITE"/"C_INFO"%s"C_WHITE". Use "C_INFO"/animstop"C_WHITE" to stop."), animLib, animName);
        SCM(playerid, COLOR_SUCCESS, amsg);
        return 1;
    }

    // ---- /animstop (opreste fortat animatia curenta) ----
    if(strcmp(cmd, "/animstop", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        ClearAnimations(playerid, 1);
        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"Animation stopped.");
        return 1;
    }

    // ---- /animlibs (lista cu toate librariile de animatii cunoscute) ----
    if(strcmp(cmd, "/animlibs", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        AnimLib_SendChunked(playerid, COLOR_INFO, C_INFO"[Anim] "C_WHITE"Libraries (use /animlist [library] to see its animations):", g_AnimAllLibs);
        return 1;
    }

    // ---- /animlist [library] (lista cu toate animatiile dintr-o librarie) ----
    if(strcmp(cmd, "/animlist", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new alLib[32], allPos = 0;
        while(cmdtext[idx] > ' ' && allPos < 31) { alLib[allPos++] = cmdtext[idx]; idx++; }
        alLib[allPos] = EOS;

        if(!strlen(alLib))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/animlist [library]"C_WHITE". See "C_INFO"/animlibs"C_WHITE" for the library names."), 1;

        new alAnims[768];
        if(!AnimLib_GetAnims(alLib, alAnims, sizeof(alAnims)))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Unknown library. Use "C_INFO"/animlibs"C_WHITE" to see the list."), 1;

        new alHeader[256];
        format(alHeader, sizeof(alHeader), C_INFO"[Anim] "C_WHITE"Animations in "C_INFO"%s"C_WHITE":", alLib);
        AnimLib_SendChunked(playerid, COLOR_INFO, alHeader, alAnims);
        return 1;
    }

    // ---- /anim2 (dialog: alege libraria, apoi animatia, se aplica automat) ----
    if(strcmp(cmd, "/anim2", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new a2list[512];
        AnimLib_CommaToLines(g_AnimAllLibs, a2list, sizeof(a2list));
        SPD(playerid, DIALOG_ANIM2_LIB, DIALOG_STYLE_LIST, "Anim - Libraries", a2list, "Select", "Cancel");
        return 1;
    }

    // ---- /veh [nume] ----
    if(strcmp(cmd, "/veh", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 3)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 3."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new vehname[64];
        strmid(vehname, cmdtext, idx, strlen(cmdtext), 32);

        if(!strlen(vehname))
            return SCM(playerid, COLOR_INFO,
                C_INFO"Info: "C_WHITE"Use "C_INFO"/veh [name or model id]"C_WHITE". Ex: "C_INFO"/veh Infernus"C_WHITE" sau "C_INFO"/veh 411"C_WHITE"."), 1;

        new model;
        if(vehname[0] >= '0' && vehname[0] <= '9')
        {
            // argument numeric -> model id direct
            model = strval(vehname);
            if(model < 400 || model > 611)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid vehicle model (400-611)."), 1;
        }
        else
        {
            model = GetVehicleModelByName(vehname);
            if(model == -1)
            {
                new errmsg[128];
                format(errmsg, sizeof(errmsg), T(playerid, C_ERROR"Error: "C_WHITE"Vehicle \""C_INFO"%s"C_WHITE"\" not found."), vehname);
                return SCM(playerid, COLOR_ERROR, errmsg), 1;
            }
        }

        new Float:x, Float:y, Float:z, Float:angle;
        GetPlayerPos(playerid, x, y, z);
        GetPlayerFacingAngle(playerid, angle);

        new vehid = CreateVehicle(model, x + 3.0, y, z, angle, -1, -1, -1);
        PutPlayerInVehicle(playerid, vehid, 0);

        new realName[24];
        GetVehicleModelName(model, realName, sizeof(realName));

        new msg[144];
        format(msg, sizeof(msg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"You spawned a "C_INFO"%s"C_WHITE" (model %d, vehicle ID %d)."), realName, model, vehid);
        SCM(playerid, COLOR_SUCCESS, msg);
        return 1;
    }

    // ---- /rac (respawn all cars) ----
    if(strcmp(cmd, "/rac", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 3)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 3."), 1;

        for(new i = 1; i < MAX_VEHICLES; i++)
        {
            if(GetVehicleModel(i) == 0) continue;

            new bool:racOccupied = false;
            for(new p = 0; p < MAX_PLAYERS; p++)
            {
                if(!IsPlayerConnected(p)) continue;
                if(GetPlayerVehicleID(p) == i) { racOccupied = true; break; }
            }
            if(racOccupied) continue;

            SetVehicleToRespawn(i);
        }

        SCM(playerid, COLOR_SUCCESS,
            C_SUCCESS"[ADM] Success: "C_WHITE"All unoccupied vehicles have been respawned.");
        return 1;
    }

    // ---- /event race/join/start/stop (evenimente race BestLap) ----
    if(strcmp(cmd, "/event", true) == 0)
    {
        new sub[256];
        sub = strtok(cmdtext, idx);
        if(!strlen(sub))
            return MiniEvents_ShowHelp(playerid), 1;

        // ---- /event cs [open/join/start/stop] [nr] (Counter Strike) ----
        if(strcmp(sub, "cs", true) == 0)
        {
            new csSub[256];
            csSub = strtok(cmdtext, idx);
            if(!strlen(csSub))
                return SCM(playerid, COLOR_INFO, "Info: Use /event cs open, /event cs join [nr], /event cs start [nr] or /event cs stop [nr]."), 1;

            // ---- /event cs open (admin 2+): deschide inscrierile pe primul slot liber ----
            if(strcmp(csSub, "open", true) == 0)
            {
                if(PlayerData[playerid][pAdminLevel] < CS_ADMIN_LEVEL)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

                if(CSLoc_CountType(CS_TYPE_SPAWN_T) == 0 || CSLoc_CountType(CS_TYPE_SPAWN_CT) == 0 || CSLoc_CountType(CS_TYPE_BOMBSITE) == 0)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need at least one SpawnT, one SpawnCT and one BombSite. Use "C_INFO"/cscreate"C_WHITE"."), 1;

                new slot = 0;
                for(new e = 1; e <= MAX_CS_EVENTS; e++)
                    if(CSEvent[e][csState] == CS_STATE_NONE) { slot = e; break; }
                if(slot == 0)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"All "C_INFO#MAX_CS_EVENTS C_WHITE" CS match slots are busy."), 1;

                CSEvent[slot][csState]  = CS_STATE_SIGNUP;
                CSEvent[slot][csRound]  = 0;
                CSEvent[slot][csScoreA] = 0;
                CSEvent[slot][csScoreB] = 0;
                CS_ClearBomb(slot);

                new om[176];
                format(om, sizeof(om), T(playerid, C_INFO"[CS #%d] "C_WHITE"A Counter Strike match is open! Type "C_INFO"/event cs join %d"C_WHITE" to enter ("C_INFO"%d"C_WHITE" slots)."),
                    slot, slot, CS_MAX_PLAYERS);
                SCMToAll(COLOR_INFO, om);

                format(om, sizeof(om), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"CS match "C_INFO"#%d"C_WHITE" opened for registration."), slot);
                SCM(playerid, COLOR_SUCCESS, om);
                return 1;
            }

            // ---- /event cs join [nr] (jucator) ----
            if(strcmp(csSub, "join", true) == 0)
            {
                if(!PlayerData[playerid][pLogged])
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
                if(g_CSEvent[playerid] != 0)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are already in a CS match."), 1;

                new nrStr[256];
                nrStr = strtok(cmdtext, idx);
                if(!strlen(nrStr))
                    return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/event cs join [nr]"C_WHITE"."), 1;

                new nr = strval(nrStr);
                if(nr < 1 || nr > MAX_CS_EVENTS)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid match number (1-"C_INFO#MAX_CS_EVENTS C_WHITE")."), 1;
                if(CSEvent[nr][csState] != CS_STATE_SIGNUP)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That match is not open for registration."), 1;

                new joined = CS_CountPlayers(nr);
                if(joined >= CS_MAX_PLAYERS)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That match is full."), 1;

                // Echipele se aloca alternativ, in ordinea inscrierii: A, B, A, B, ...
                g_CSEvent[playerid]  = nr;
                g_CSJoined[playerid] = true;
                g_CSTeam[playerid]   = (joined % 2 == 0) ? CS_TEAM_A : CS_TEAM_B;
                g_CSSide[playerid]   = (g_CSTeam[playerid] == CS_TEAM_A) ? CS_SIDE_T : CS_SIDE_CT;
                g_CSAlive[playerid]  = false;
                g_CSBusy[playerid]   = false;
                joined++;

                new jm[160];
                format(jm, sizeof(jm), T(playerid, C_SUCCESS"[CS #%d] "C_WHITE"%s joined as "C_INFO"%s"C_WHITE" ("C_INFO"%d/%d"C_WHITE")."),
                    nr, PlayerData[playerid][pName], (g_CSSide[playerid] == CS_SIDE_T) ? "T" : "CT", joined, CS_MAX_PLAYERS);
                CS_Announce(nr, jm);
                SCM(playerid, COLOR_SUCCESS, jm);

                // La 10 jucatori inscrierile se opresc automat si meciul porneste
                if(joined >= CS_MAX_PLAYERS)
                {
                    CSEvent[nr][csState] = CS_STATE_RUNNING;
                    format(jm, sizeof(jm), C_INFO"[CS #%d] "C_WHITE"Registration closed ("C_INFO"%d/%d"C_WHITE") - the match starts now!", nr, joined, CS_MAX_PLAYERS);
                    SCMToAll(COLOR_INFO, jm);
                    CS_StartRound(nr, 1);
                }
                return 1;
            }

            // ---- /event cs start [nr] (admin 2+): inchide inscrierile fortat ----
            if(strcmp(csSub, "start", true) == 0)
            {
                if(PlayerData[playerid][pAdminLevel] < CS_ADMIN_LEVEL)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

                new nrStr[256];
                nrStr = strtok(cmdtext, idx);
                if(!strlen(nrStr))
                    return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/event cs start [nr]"C_WHITE"."), 1;

                new nr = strval(nrStr);
                if(nr < 1 || nr > MAX_CS_EVENTS)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid match number (1-"C_INFO#MAX_CS_EVENTS C_WHITE")."), 1;
                if(CSEvent[nr][csState] != CS_STATE_SIGNUP)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That match is not waiting to start."), 1;

                new joined = CS_CountPlayers(nr);
                if(joined < 2)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"At least 2 players must join before starting."), 1;

                CSEvent[nr][csState] = CS_STATE_RUNNING;

                new sm[160];
                format(sm, sizeof(sm), C_INFO"[CS #%d] "C_WHITE"Registration closed by an admin ("C_INFO"%d"C_WHITE" players) - the match starts now!", nr, joined);
                SCMToAll(COLOR_INFO, sm);
                CS_StartRound(nr, 1);
                return 1;
            }

            // ---- /event cs stop [nr] (admin 2+) ----
            if(strcmp(csSub, "stop", true) == 0)
            {
                if(PlayerData[playerid][pAdminLevel] < CS_ADMIN_LEVEL)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

                new nrStr[256];
                nrStr = strtok(cmdtext, idx);
                if(!strlen(nrStr))
                    return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/event cs stop [nr]"C_WHITE"."), 1;

                new nr = strval(nrStr);
                if(nr < 1 || nr > MAX_CS_EVENTS)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid match number (1-"C_INFO#MAX_CS_EVENTS C_WHITE")."), 1;
                if(CSEvent[nr][csState] == CS_STATE_NONE)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That match is not active."), 1;

                CS_EndMatch(nr, true);
                return 1;
            }

            return SCM(playerid, COLOR_INFO, "Info: Use /event cs open, /event cs join [nr], /event cs start [nr] or /event cs stop [nr]."), 1;
        }

        // ---- /event htm [open/join/start/stop] (Hunt The Mayor) ----
        if(strcmp(sub, "htm", true) == 0)
        {
            new htmSub[256];
            htmSub = strtok(cmdtext, idx);
            if(!strlen(htmSub))
                return SCM(playerid, COLOR_INFO, "Info: Use /event htm open, /event htm join, /event htm start or /event htm stop."), 1;

            // ---- /event htm open (admin 2+) ----
            if(strcmp(htmSub, "open", true) == 0)
            {
                if(PlayerData[playerid][pAdminLevel] < HTM_ADMIN_LEVEL)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;
                if(g_HTMState != HTM_STATE_NONE)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"A Hunt The Mayor event is already open or running."), 1;

                g_HTMState = HTM_STATE_SIGNUP;
                for(new i = 0; i < MAX_PLAYERS; i++) g_HTMJoined[i] = false;

                SCMToAll(COLOR_INFO, "[Hunt The Mayor] Sign-ups are open! Type /event htm join to enter. One of you will be picked at random as the Mayor.");
                SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Hunt The Mayor sign-ups opened.");
                return 1;
            }

            // ---- /event htm join (jucator) ----
            if(strcmp(htmSub, "join", true) == 0)
            {
                if(!PlayerData[playerid][pLogged])
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
                if(g_HTMState != HTM_STATE_SIGNUP)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"There are no Hunt The Mayor sign-ups open right now."), 1;
                if(g_HTMJoined[playerid])
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already joined."), 1;

                g_HTMJoined[playerid] = true;
                SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Hunt The Mayor] "C_WHITE"You joined! Wait for an admin to start the hunt.");
                return 1;
            }

            // ---- /event htm start (admin 2+) ----
            if(strcmp(htmSub, "start", true) == 0)
            {
                if(PlayerData[playerid][pAdminLevel] < HTM_ADMIN_LEVEL)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;
                if(g_HTMState != HTM_STATE_SIGNUP)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"There is no Hunt The Mayor event waiting to start."), 1;

                new joinedList[MAX_PLAYERS], joinedCount = 0;
                for(new i = 0; i < MAX_PLAYERS; i++)
                    if(IsPlayerConnected(i) && g_HTMJoined[i]) joinedList[joinedCount++] = i;

                if(joinedCount < 2)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"At least 2 players (1 Mayor + 1 hunter) must join before starting."), 1;

                g_HTMState  = HTM_STATE_RUNNING;
                g_HTMMayor  = joinedList[random(joinedCount)];
                g_HTMSecondsLeft = HTM_DURATION_SEC;

                for(new c = 0; c < joinedCount; c++)
                {
                    new pid = joinedList[c];
                    g_HTMParticipant[pid] = true;
                    g_HTMDamaged[pid]     = false;
                    HTM_SpawnPlayer(pid);
                }

                new htmsg[176];
                format(htmsg, sizeof(htmsg), C_ERROR"[Hunt The Mayor] "C_WHITE"The hunt begins! "C_INFO"%s"C_WHITE" is the Mayor. You have "C_INFO"15 minutes"C_WHITE" to kill them!",
                    PlayerData[g_HTMMayor][pName]);
                SCMToAll(COLOR_ERROR, htmsg);

                if(g_HTMTimer != -1) KillTimer(g_HTMTimer);
                g_HTMTimer = SetTimer("HTM_Tick", 1000, true);

                SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Hunt The Mayor started.");
                return 1;
            }

            // ---- /event htm stop (admin 2+) ----
            if(strcmp(htmSub, "stop", true) == 0)
            {
                if(PlayerData[playerid][pAdminLevel] < HTM_ADMIN_LEVEL)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;
                if(g_HTMState == HTM_STATE_NONE)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"There is no active Hunt The Mayor event."), 1;

                SCMToAll(COLOR_ERROR, C_ERROR"[Hunt The Mayor] "C_WHITE"The event was stopped by an admin.");
                HTM_EndEvent();
                SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Hunt The Mayor stopped.");
                return 1;
            }

            return SCM(playerid, COLOR_INFO, "Info: Use /event htm open, /event htm join, /event htm start or /event htm stop."), 1;
        }

        // ---- /event custom [start/stop/join/heal/armour/freeze] ----
        if(strcmp(sub, "custom", true) == 0)
        {
            new cuSub[256];
            cuSub = strtok(cmdtext, idx);
            if(!strlen(cuSub))
                return SCM(playerid, COLOR_INFO, "Info: Use /event custom start, /event custom stop, /event custom join, /event custom heal [0-100], /event custom armour [0-100] or /event custom freeze [0/1]."), 1;

            // ---- /event custom join (jucator) ----
            if(strcmp(cuSub, "join", true) == 0)
            {
                if(!PlayerData[playerid][pLogged])
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
                if(!g_CustomEventSignup)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Event sign-ups are not open right now."), 1;
                if(g_CustomEventParticipant[playerid])
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already joined the event."), 1;

                g_CustomEventParticipant[playerid] = true;

                new Float:cuOffX = float(random(CUSTOM_EVENT_JOIN_RANDOFF * 2 + 1) - CUSTOM_EVENT_JOIN_RANDOFF);
                new Float:cuOffY = float(random(CUSTOM_EVENT_JOIN_RANDOFF * 2 + 1) - CUSTOM_EVENT_JOIN_RANDOFF);
                AC_SetInterior(playerid, g_CustomEventInterior);
                AC_SetVW(playerid, g_CustomEventVW);
                AC_SetPos(playerid, g_CustomEventX + cuOffX, g_CustomEventY + cuOffY, g_CustomEventZ);

                SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Event] "C_WHITE"You joined the event!");
                return 1;
            }

            // ---- restul subcomenzilor sunt doar pt admin ----
            if(PlayerData[playerid][pAdminLevel] < CUSTOM_EVENT_ADMIN_LEVEL)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level "#CUSTOM_EVENT_ADMIN_LEVEL"."), 1;

            // ---- /event custom start (admin) ----
            if(strcmp(cuSub, "start", true) == 0)
            {
                for(new i = 0; i < MAX_PLAYERS; i++) g_CustomEventParticipant[i] = false;

                GetPlayerPos(playerid, g_CustomEventX, g_CustomEventY, g_CustomEventZ);
                g_CustomEventInterior = GetPlayerInterior(playerid);
                g_CustomEventVW       = GetPlayerVirtualWorld(playerid);
                g_CustomEventSignup   = true;

                SCMToAll(COLOR_INFO, C_INFO"[Event] "C_WHITE"Sign-ups are now open! Use "C_INFO"/event custom join"C_WHITE" to participate.");
                return 1;
            }

            // ---- /event custom stop (admin) ----
            if(strcmp(cuSub, "stop", true) == 0)
            {
                if(!g_CustomEventSignup)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Sign-ups are not open."), 1;

                g_CustomEventSignup = false;
                SCMToAll(COLOR_INFO, C_INFO"[Event] "C_WHITE"Sign-ups are now closed.");
                return 1;
            }

            // ---- /event custom heal [0-100] (admin) ----
            if(strcmp(cuSub, "heal", true) == 0)
            {
                new cuHpStr[256];
                cuHpStr = strtok(cmdtext, idx);
                if(!strlen(cuHpStr))
                    return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/event custom heal [0-100]"C_WHITE"."), 1;

                new cuHp = strval(cuHpStr);
                if(cuHp < 0 || cuHp > 100)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Value must be 0-100."), 1;

                new cuCount = 0;
                for(new i = 0; i < MAX_PLAYERS; i++)
                {
                    if(!IsPlayerConnected(i) || !g_CustomEventParticipant[i]) continue;
                    SetPlayerHealth(i, float(cuHp));
                    cuCount++;
                }

                new cuMsg[112];
                format(cuMsg, sizeof(cuMsg),T(playerid, "[ADM] Success: Set health to %d for %d event participant(s)."), cuHp, cuCount);
                SCM(playerid, COLOR_SUCCESS, cuMsg);
                return 1;
            }

            // ---- /event custom armour [0-100] (admin) ----
            if(strcmp(cuSub, "armour", true) == 0)
            {
                new cuArStr[256];
                cuArStr = strtok(cmdtext, idx);
                if(!strlen(cuArStr))
                    return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/event custom armour [0-100]"C_WHITE"."), 1;

                new cuAr = strval(cuArStr);
                if(cuAr < 0 || cuAr > 100)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Value must be 0-100."), 1;

                new cuCount = 0;
                for(new i = 0; i < MAX_PLAYERS; i++)
                {
                    if(!IsPlayerConnected(i) || !g_CustomEventParticipant[i]) continue;
                    SetPlayerArmour(i, float(cuAr));
                    cuCount++;
                }

                new cuMsg[112];
                format(cuMsg, sizeof(cuMsg),T(playerid, "[ADM] Success: Set armour to %d for %d event participant(s)."), cuAr, cuCount);
                SCM(playerid, COLOR_SUCCESS, cuMsg);
                return 1;
            }

            // ---- /event custom freeze [0/1] (admin) ----
            if(strcmp(cuSub, "freeze", true) == 0)
            {
                new cuFrStr[256];
                cuFrStr = strtok(cmdtext, idx);
                if(!strlen(cuFrStr) || (strcmp(cuFrStr, "0", true) != 0 && strcmp(cuFrStr, "1", true) != 0))
                    return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/event custom freeze [0/1]"C_WHITE"."), 1;

                new cuFr = strval(cuFrStr);
                new cuCount = 0;
                for(new i = 0; i < MAX_PLAYERS; i++)
                {
                    if(!IsPlayerConnected(i) || !g_CustomEventParticipant[i]) continue;
                    TogglePlayerControllable(i, (cuFr == 0));
                    cuCount++;
                }

                new cuMsg[112];
                format(cuMsg, sizeof(cuMsg),T(playerid, "[ADM] Success: %s %d event participant(s)."), cuFr ? "Froze" : "Unfroze", cuCount);
                SCM(playerid, COLOR_SUCCESS, cuMsg);
                return 1;
            }

            return SCM(playerid, COLOR_INFO, "Info: Use /event custom start, /event custom stop, /event custom join, /event custom heal [0-100], /event custom armour [0-100] or /event custom freeze [0/1]."), 1;
        }

        // ---- /event race [lap] [vehicle] (admin 2+) ----
        if(strcmp(sub, "race", true) == 0)
        {
            if(PlayerData[playerid][pAdminLevel] < 2)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;
            if(g_RaceState != RACE_STATE_NONE)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"A race event is already active. Use "C_INFO"/event stop"C_WHITE" first."), 1;

            new lapStr[256], vehStr[256];
            lapStr = strtok(cmdtext, idx);
            vehStr = strtok(cmdtext, idx);
            if(!strlen(lapStr) || !strlen(vehStr))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/event race [lap1/lap2/lap3/lap4] [bullet/infernus/elegy/stratum/nrg/sabre/dune/random]"C_WHITE"."), 1;

            new lap = -1;
            for(new k = 0; k < MAX_RACE_LAPS; k++)
                if(strcmp(lapStr, g_RaceLapName[k], true) == 0) { lap = k; break; }
            if(lap == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid lap. Use "C_INFO"lap1/lap2/lap3/lap4"C_WHITE"."), 1;

            new model = -1;
            if(strcmp(vehStr, "random", true) != 0)
            {
                new vi = -1;
                for(new k = 0; k < RACE_VEH_COUNT; k++)
                    if(strcmp(vehStr, g_RaceVehKey[k], true) == 0) { vi = k; break; }
                if(vi == -1)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid vehicle. Use "C_INFO"bullet/infernus/elegy/stratum/nrg/sabre/dune/random"C_WHITE"."), 1;
                model = g_RaceVehModels[vi];
            }

            g_RaceState    = RACE_STATE_SIGNUP;
            g_RaceLap      = lap;
            g_RaceVehModel = model;
            g_RaceFinishOrder = 0;
            g_RaceTotal    = 0;
            for(new i = 0; i < MAX_PLAYERS; i++) { g_RaceIn[i] = false; g_RaceDone[i] = false; g_RaceCP[i] = 0; }

            new vlabel[12];
            if(model == -1) format(vlabel, sizeof(vlabel), "Random");
            else            format(vlabel, sizeof(vlabel), "%s", g_RaceVehNames[Race_VehIndex(model)]);

            new bm[256];
            format(bm, sizeof(bm), C_INFO"[Race Event] "C_WHITE"A "C_INFO"%s"C_WHITE" race was opened on "C_INFO"%s"C_WHITE"! Type "C_INFO"/event join"C_WHITE" to enter.",
                vlabel, g_RaceLapName[lap]);
            SCMToAll(COLOR_INFO, bm);
            return 1;
        }

        // ---- /event join (jucator) ----
        if(strcmp(sub, "join", true) == 0)
        {
            if(!PlayerData[playerid][pLogged])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
            if(g_RaceState != RACE_STATE_SIGNUP)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"There is no race event open to join right now."), 1;
            if(g_RaceIn[playerid])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already joined the race event."), 1;

            g_RaceIn[playerid]   = true;
            g_RaceDone[playerid] = false;
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Race Event] "C_WHITE"You joined the race. Wait for an admin to start it.");
            return 1;
        }

        // ---- /event start (admin 2+) ----
        if(strcmp(sub, "start", true) == 0)
        {
            if(PlayerData[playerid][pAdminLevel] < 2)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;
            if(g_RaceState != RACE_STATE_SIGNUP)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"There is no race event waiting to start."), 1;

            new count = 0;
            for(new i = 0; i < MAX_PLAYERS; i++)
                if(g_RaceIn[i] && IsPlayerConnected(i)) count++;
            if(count < 1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Nobody joined the event yet."), 1;

            g_RaceState       = RACE_STATE_RUNNING;
            g_RaceFinishOrder = 0;
            g_RaceTotal       = count;

            // Daca a fost "random", se alege UN singur model, comun tuturor participantilor
            new eventModel = (g_RaceVehModel != -1) ? g_RaceVehModel : g_RaceVehModels[random(RACE_VEH_COUNT)];

            new Float:sx = g_RaceRoute[g_RaceLap][0][0];
            new Float:sy = g_RaceRoute[g_RaceLap][0][1];
            new Float:sz = g_RaceRoute[g_RaceLap][0][2];
            new Float:sa = g_RaceStartA[g_RaceLap];

            for(new i = 0; i < MAX_PLAYERS; i++)
            {
                if(!g_RaceIn[i] || !IsPlayerConnected(i)) continue;

                g_RaceVehUsed[i] = eventModel;

                new veh = CreateVehicle(eventModel, sx, sy, sz, sa, random(256), random(256), -1);
                SetVehicleVirtualWorld(veh, RACE_VW_BASE + i);
                LinkVehicleToInterior(veh, 0);
                if(veh >= 0 && veh < MAX_VEHICLES) g_VehicleFuel[veh] = FUEL_MAX;
                g_RaceVehicle[i] = veh;

                // porneste motorul (params -1 nesetati -> engine ON)
                new e, l, al, d, b, bo, o;
                GetVehicleParamsEx(veh, e, l, al, d, b, bo, o);
                SetVehicleParamsEx(veh, 1, l, al, d, b, bo, o);

                AC_SetInterior(i, 0);
                AC_SetVW(i, RACE_VW_BASE + i);
                PutPlayerInVehicle(i, veh, 0);

                g_RaceDone[i] = false;
                g_RaceCP[i]   = 1; // spawn e la CP index 0; prima tinta e index 1
                Race_SetCP(i, g_RaceLap, 1);
                TogglePlayerControllable(i, 0); // freeze pana la GOGOGO
            }

            g_RaceCountdown = RACE_COUNTDOWN_SEC;
            Race_CountdownTick();

            if(g_RaceTimeoutTimer != -1) KillTimer(g_RaceTimeoutTimer);
            g_RaceTimeoutTimer = SetTimer("Race_Timeout", RACE_TIMEOUT_MS, false);

            new startMsg[128];
            format(startMsg, sizeof(startMsg), C_INFO"[Race Event] "C_WHITE"The race is starting on "C_INFO"%s"C_WHITE" with the "C_INFO"%s"C_WHITE"!",
                g_RaceLapName[g_RaceLap], g_RaceVehNames[Race_VehIndex(eventModel)]);
            SCMToAll(COLOR_INFO, startMsg);
            return 1;
        }

        // ---- /event stop (admin 2+) ----
        if(strcmp(sub, "stop", true) == 0)
        {
            if(PlayerData[playerid][pAdminLevel] < 2)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;
            if(g_RaceState == RACE_STATE_NONE)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"There is no active race event."), 1;
            Race_End(true);
            return 1;
        }

        return MiniEvents_ShowHelp(playerid), 1;
    }

    // ---- /plant (CS: T planteaza bomba la un bombsite; freeze 3s) ----
    if(strcmp(cmd, "/plant", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new eventid = g_CSEvent[playerid];
        if(eventid == 0 || CSEvent[eventid][csState] != CS_STATE_RUNNING)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not in an active CS match."), 1;
        if(!CSEvent[eventid][csRoundLive])
            return SCM(playerid, COLOR_ERROR, C_ERROR"[CS] "C_WHITE"The round is not running right now."), 1;
        if(g_CSSide[playerid] != CS_SIDE_T)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[CS] "C_WHITE"Only "C_INFO"T"C_WHITE" can plant the bomb."), 1;
        if(!g_CSAlive[playerid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"[CS] "C_WHITE"You are dead."), 1;
        if(g_CSBusy[playerid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"[CS] "C_WHITE"You are already busy."), 1;
        if(CSEvent[eventid][csBombDown])
            return SCM(playerid, COLOR_ERROR, C_ERROR"[CS] "C_WHITE"The bomb is already planted."), 1;

        new atSite = false;
        for(new i = 0; i < g_CSLocCount; i++)
        {
            if(CSLocData[i][csType] != CS_TYPE_BOMBSITE) continue;
            if(IsPlayerInRangeOfPoint(playerid, CS_SITE_RANGE, CSLocData[i][csLocX], CSLocData[i][csLocY], CSLocData[i][csLocZ])) { atSite = true; break; }
        }
        if(!atSite)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[CS] "C_WHITE"You must be at a bombsite (look for the "C_INFO"[ Bomb ]"C_WHITE" marker)."), 1;

        g_CSBusy[playerid] = true;
        TogglePlayerControllable(playerid, 0);
        GTP(playerid, "~r~Planting...", CS_ACTION_FREEZE * 1000, 3);
        SetTimerEx("CS_PlantFinish", CS_ACTION_FREEZE * 1000, false, "i", playerid);

        new pm[128];
        format(pm, sizeof(pm), C_ERROR"[CS #%d] "C_WHITE"%s is "C_ERROR"planting"C_WHITE" the bomb!", eventid, PlayerData[playerid][pName]);
        CS_Announce(eventid, pm);
        return 1;
    }

    // ---- /defuse (CS: CT dezamorseaza bomba plantata; freeze 3s) ----
    if(strcmp(cmd, "/defuse", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new eventid = g_CSEvent[playerid];
        if(eventid == 0 || CSEvent[eventid][csState] != CS_STATE_RUNNING)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not in an active CS match."), 1;
        if(!CSEvent[eventid][csRoundLive])
            return SCM(playerid, COLOR_ERROR, C_ERROR"[CS] "C_WHITE"The round is not running right now."), 1;
        if(g_CSSide[playerid] != CS_SIDE_CT)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[CS] "C_WHITE"Only "C_INFO"CT"C_WHITE" can defuse the bomb."), 1;
        if(!g_CSAlive[playerid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"[CS] "C_WHITE"You are dead."), 1;
        if(g_CSBusy[playerid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"[CS] "C_WHITE"You are already busy."), 1;
        if(!CSEvent[eventid][csBombDown])
            return SCM(playerid, COLOR_ERROR, C_ERROR"[CS] "C_WHITE"The bomb has not been planted."), 1;

        new site = CSEvent[eventid][csBombSite];
        if(site == -1 || !IsPlayerInRangeOfPoint(playerid, CS_SITE_RANGE, CSLocData[site][csLocX], CSLocData[site][csLocY], CSLocData[site][csLocZ]))
            return SCM(playerid, COLOR_ERROR, C_ERROR"[CS] "C_WHITE"You must be at the planted bomb."), 1;

        g_CSBusy[playerid] = true;
        TogglePlayerControllable(playerid, 0);
        GTP(playerid, "~b~Defusing...", CS_ACTION_FREEZE * 1000, 3);
        SetTimerEx("CS_DefuseFinish", CS_ACTION_FREEZE * 1000, false, "i", playerid);

        new dm[128];
        format(dm, sizeof(dm), C_INFO"[CS #%d] "C_WHITE"%s is "C_INFO"defusing"C_WHITE" the bomb!", eventid, PlayerData[playerid][pName]);
        CS_Announce(eventid, dm);
        return 1;
    }

    // ---- /hunt (ia sniperul de vanatoare, la spotul de hunting) ----
    if(strcmp(cmd, "/hunt", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(!IsPlayerInRangeOfPoint(playerid, HUNT_START_RANGE, g_HuntStartX, g_HuntStartY, g_HuntStartZ))
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Hunt] "C_WHITE"You must be at the hunting spot to start (see the map icon in the forest)."), 1;

        AC_GiveWeapon(playerid, HUNT_SNIPER, HUNT_SNIPER_AMMO);
        g_HasSniper[playerid] = true;
        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Hunt] "C_WHITE"You grabbed a hunting rifle. Snipe deer from a distance - get within 30m and they flee.");
        SCM(playerid, COLOR_INFO, "[Hunt] ""Carry max "#HUNT_MAX_MEAT " deer, then sell at any shop with ""/sellmeat"". Use ""/stophunt"" to put the rifle away.");
        return 1;
    }

    // ---- /stophunt (scoate sniperul de vanatoare) ----
    if(strcmp(cmd, "/stophunt", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(!g_HasSniper[playerid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Hunt] "C_WHITE"You are not hunting."), 1;

        g_ACWeaponAllowed[playerid][HUNT_SNIPER] = false;
        g_ACWeaponAmmo[playerid][HUNT_SNIPER] = 0;
        AC_RestoreWeapons(playerid); // scoate sniperul, pastreaza restul armelor legitime
        g_HasSniper[playerid] = false;
        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Hunt] "C_WHITE"You put the hunting rifle away.");
        return 1;
    }

    // ---- /sellmeat (vinde caprioarele la orice shop) ----
    if(strcmp(cmd, "/sellmeat", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(g_HuntMeat[playerid] <= 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Hunt] "C_WHITE"You have no deer to sell."), 1;

        new bool:nearShop = false;
        for(new i = 0; i < g_ShopCount; i++)
            if(IsPlayerInRangeOfPoint(playerid, HUNT_SELL_RANGE, ShopData[i][shopX], ShopData[i][shopY], ShopData[i][shopZ])) { nearShop = true; break; }
        if(!nearShop)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Hunt] "C_WHITE"You must be at a shop to sell your deer."), 1;

        new count = g_HuntMeat[playerid];
        new earn = count * HUNT_PAYOUT;
        PlayerData[playerid][pMoney] += earn;
        GivePlayerMoney(playerid, earn);
        UpdatePlayer(playerid, pMoney);
        g_HuntMeat[playerid] = 0;

        new sm[128];
        format(sm, sizeof(sm), T(playerid, C_SUCCESS"[Hunt] "C_WHITE"You sold "C_INFO"%d"C_WHITE" deer for "C_SUCCESS"$%s"C_WHITE"."), count, MoneyStr(earn));
        SCM(playerid, COLOR_SUCCESS, sm);
        return 1;
    }

    // ---- /farm [stats/plow/level/seed/fertilize/harvest/buy/sell] ----
    if(strcmp(cmd, "/farm", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new fAction[16], fap = 0;
        while(cmdtext[idx] > ' ' && fap < 15) { fAction[fap++] = cmdtext[idx]; idx++; }
        fAction[fap] = EOS;
        if(!strlen(fAction))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/farm [stats/plow/level/seed/fertilize/harvest/buy/sell]"C_WHITE"."), 1;

        // ---- /farm stats (merge de oriunde: pe teren -> terenul respectiv, altfel -> ferma detinuta) ----
        if(strcmp(fAction, "stats", true) == 0)
        {
            new sfidx = Farm_PlayerIn(playerid);
            if(sfidx == -1) sfidx = Farm_IndexByID(PlayerData[playerid][pFarmKey]); // nu esti pe teren -> ferma ta
            if(sfidx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"You are not on a field and you don't own a farm."), 1;

            new sTodayDay = gettime() / 86400;
            new sLastDay  = FarmData[sfidx][fmLastWork] / 86400;
            new bool:sWorkedToday = (FarmData[sfidx][fmLastWork] > 0 && sLastDay >= sTodayDay);

            new sline[144];
            format(sline, sizeof(sline), T(playerid, C_INFO"_____ Field #%d ____________________"), FarmData[sfidx][fmID]);
            SCM(playerid, COLOR_INFO, sline);
            if(FarmData[sfidx][fmOwned])
                format(sline, sizeof(sline), T(playerid, C_WHITE"Owner: "C_INFO"%s"), FarmData[sfidx][fmOwnerName]);
            else
                format(sline, sizeof(sline), T(playerid, C_WHITE"Owner: "C_SUCCESS"unowned"C_WHITE" (price "C_INFO"$%s"C_WHITE")"), MoneyStr(FarmData[sfidx][fmPrice]));
            SCM(playerid, COLOR_WHITE, sline);
            format(sline, sizeof(sline), T(playerid, C_WHITE"Next step: "C_INFO"%s"C_WHITE" (%s, %d min)"),
                g_FarmStepName[FarmData[sfidx][fmNextStep]], g_FarmStepVehName[FarmData[sfidx][fmNextStep]], g_FarmStepMin[FarmData[sfidx][fmNextStep]]);
            SCM(playerid, COLOR_WHITE, sline);
            if(sWorkedToday)
                SCM(playerid, COLOR_WHITE, C_WHITE"Ready to work: "C_ERROR"no"C_WHITE" (already worked today, come back tomorrow)");
            else
                SCM(playerid, COLOR_WHITE, C_WHITE"Ready to work: "C_SUCCESS"yes");
            format(sline, sizeof(sline), T(playerid, "Vehicles: %d Tractor, %d Dozer, %d Combine, %d Truck, %d Trailer."),
                Farm_OwnedCount(sfidx, FARM_TRACTOR), Farm_OwnedCount(sfidx, FARM_DOZER), Farm_OwnedCount(sfidx, FARM_COMBINE), Farm_OwnedCount(sfidx, FARM_TRUCK), Farm_OwnedCount(sfidx, FARM_TRAILER));
            SCM(playerid, COLOR_WHITE, sline);
            new sBroken = (Farm_OwnedCount(sfidx, FARM_TRACTOR) - Farm_UsableCount(sfidx, FARM_TRACTOR))
                        + (Farm_OwnedCount(sfidx, FARM_DOZER)   - Farm_UsableCount(sfidx, FARM_DOZER))
                        + (Farm_OwnedCount(sfidx, FARM_COMBINE) - Farm_UsableCount(sfidx, FARM_COMBINE))
                        + (Farm_OwnedCount(sfidx, FARM_TRUCK)   - Farm_UsableCount(sfidx, FARM_TRUCK))
                        + (Farm_OwnedCount(sfidx, FARM_TRAILER) - Farm_UsableCount(sfidx, FARM_TRAILER));
            if(sBroken > 0)
            {
                format(sline, sizeof(sline), T(playerid, C_ERROR"Broken down: "C_INFO"%d"C_WHITE" (sell with "C_INFO"/farm sell"C_WHITE" or they stay unusable)"), sBroken);
                SCM(playerid, COLOR_WHITE, sline);
            }
            return 1;
        }

        // celelalte actiuni necesita sa fii pe un teren
        new fidx = Farm_PlayerIn(playerid);
        if(fidx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"You are not on a field."), 1;

        new fTodayDay = gettime() / 86400;
        new fLastDay  = FarmData[fidx][fmLastWork] / 86400;
        new bool:fWorkedToday = (FarmData[fidx][fmLastWork] > 0 && fLastDay >= fTodayDay);

        // ---- /farm buy [tractor/dozer/combina/truck/trailer] (doar pe terenul personal) ----
        if(strcmp(fAction, "buy", true) == 0)
        {
            if(!Farm_IsOwner(playerid, fidx))
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"You can only buy vehicles on your own field."), 1;

            while(cmdtext[idx] == ' ') idx++;
            new typeArg[12], tap = 0;
            while(cmdtext[idx] > ' ' && tap < 11) { typeArg[tap++] = cmdtext[idx]; idx++; }
            typeArg[tap] = EOS;
            new model = Farm_ModelFromType(typeArg);
            if(model == -1)
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/farm buy [tractor/dozer/combina/truck/trailer]"C_WHITE"."), 1;

            new price = Farm_VehPrice(model);
            new vtn[12]; Farm_VehTypeName(model, vtn);
            if(FarmData[fidx][fmBank] < price)
            {
                new em[256];
                format(em, sizeof(em), T(playerid, C_ERROR"[Farm] "C_WHITE"The farm bank needs "C_INFO"$%s"C_WHITE" for a %s (use "C_INFO"/farm deposit"C_WHITE")."), MoneyStr(price), vtn);
                return SCM(playerid, COLOR_ERROR, em), 1;
            }

            FarmData[fidx][fmBank] -= price; // banii se iau din contul fermei
            Farm_AddEquipment(fidx, model); // utilaj nou, 0 utilizari
            Farm_Save(fidx);

            new bm[256];
            format(bm, sizeof(bm), T(playerid, C_SUCCESS"[Farm] "C_WHITE"Bought a %s for "C_INFO"$%s"C_WHITE". The farm now owns "C_INFO"%d"C_WHITE" (bank: "C_INFO"$%s"C_WHITE")."), vtn, MoneyStr(price), Farm_OwnedCount(fidx, model), MoneyStr(FarmData[fidx][fmBank]));
            SCM(playerid, COLOR_SUCCESS, bm);
            return 1;
        }

        // ---- /farm sell [tractor/dozer/combina/truck/trailer] (doar pe terenul personal) ----
        if(strcmp(fAction, "sell", true) == 0)
        {
            if(!Farm_IsOwner(playerid, fidx))
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"You can only sell vehicles on your own field."), 1;

            while(cmdtext[idx] == ' ') idx++;
            new typeArg[12], tap = 0;
            while(cmdtext[idx] > ' ' && tap < 11) { typeArg[tap++] = cmdtext[idx]; idx++; }
            typeArg[tap] = EOS;
            new model = Farm_ModelFromType(typeArg);
            if(model == -1)
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/farm sell [tractor/dozer/combina/truck/trailer]"C_WHITE"."), 1;

            new vtn[12]; Farm_VehTypeName(model, vtn);
            if(Farm_OwnedCount(fidx, model) <= 0)
            {
                new em[128];
                format(em, sizeof(em), T(playerid, C_ERROR"[Farm] "C_WHITE"This field doesn't own a %s."), vtn);
                return SCM(playerid, COLOR_ERROR, em), 1;
            }

            // vinde intotdeauna cea mai uzata unitate detinuta (refund 20%-60% in functie de utilizarile ramase)
            new sellIdx = Farm_FindMostWornEquipment(fidx, model);
            new sellUses = FarmEquipData[sellIdx][feUses];
            new sellMaxUses = Farm_MaxUses(model);
            new refundPct = Farm_SellRefundPct(model, sellUses);
            new refund = Farm_VehPrice(model) * refundPct / 100;
            FarmData[fidx][fmBank] += refund; // refund-ul intra in contul fermei
            Farm_RemoveEquipment(sellIdx);
            Farm_SyncCounts(fidx);
            Farm_Save(fidx);

            new sm2[256];
            format(sm2, sizeof(sm2), T(playerid, C_SUCCESS"[Farm] "C_WHITE"Sold a %s (used "C_INFO"%d/%d"C_WHITE") for "C_INFO"$%s"C_WHITE" (%d%%) into the farm bank (now "C_INFO"$%s"C_WHITE")."),
                vtn, sellUses, sellMaxUses, MoneyStr(refund), refundPct, MoneyStr(FarmData[fidx][fmBank]));
            SCM(playerid, COLOR_SUCCESS, sm2);
            return 1;
        }

        // ---- /farm deposit [amount] (owner: bani personali -> contul fermei) ----
        if(strcmp(fAction, "deposit", true) == 0)
        {
            if(!Farm_IsOwner(playerid, fidx))
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"This is not your field."), 1;
            while(cmdtext[idx] == ' ') idx++;
            new amtStr[16];
            strmid(amtStr, cmdtext, idx, strlen(cmdtext), 16);
            new amt = strval(amtStr);
            if(amt <= 0)
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/farm deposit [amount]"C_WHITE"."), 1;
            if(PlayerData[playerid][pMoney] < amt)
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"You don't have that much money."), 1;
            PlayerData[playerid][pMoney] -= amt;
            GivePlayerMoney(playerid, -amt);
            UpdatePlayer(playerid, pMoney);
            FarmData[fidx][fmBank] += amt;
            Farm_Save(fidx);
            new dm[128];
            format(dm, sizeof(dm), T(playerid, C_SUCCESS"[Farm] "C_WHITE"Deposited "C_INFO"$%s"C_WHITE". Farm bank: "C_INFO"$%s"C_WHITE"."), MoneyStr(amt), MoneyStr(FarmData[fidx][fmBank]));
            SCM(playerid, COLOR_SUCCESS, dm);
            return 1;
        }

        // ---- /farm withdraw [amount] (owner: contul fermei -> bani personali) ----
        if(strcmp(fAction, "withdraw", true) == 0)
        {
            if(!Farm_IsOwner(playerid, fidx))
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"This is not your field."), 1;
            while(cmdtext[idx] == ' ') idx++;
            new amtStr[16];
            strmid(amtStr, cmdtext, idx, strlen(cmdtext), 16);
            new amt = strval(amtStr);
            if(amt <= 0)
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/farm withdraw [amount]"C_WHITE"."), 1;
            if(FarmData[fidx][fmBank] < amt)
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"The farm bank doesn't have that much."), 1;
            FarmData[fidx][fmBank] -= amt;
            PlayerData[playerid][pMoney] += amt;
            GivePlayerMoney(playerid, amt);
            UpdatePlayer(playerid, pMoney);
            Farm_Save(fidx);
            new wm[128];
            format(wm, sizeof(wm), T(playerid, C_SUCCESS"[Farm] "C_WHITE"Withdrew "C_INFO"$%s"C_WHITE". Farm bank: "C_INFO"$%s"C_WHITE"."), MoneyStr(amt), MoneyStr(FarmData[fidx][fmBank]));
            SCM(playerid, COLOR_SUCCESS, wm);
            return 1;
        }

        // ---- /farm deliver (vinde recolta: cu truck+trailer la shop, sau instant la jumatate) ----
        if(strcmp(fAction, "deliver", true) == 0)
        {
            if(!Farm_IsOwner(playerid, fidx))
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"This is not your field."), 1;
            if(FarmData[fidx][fmRecolta] <= 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"No harvest to deliver. Complete a farming cycle first."), 1;
            if(g_FarmDelivTruck[playerid] != 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"You are already on a delivery."), 1;

            if(Farm_UsableCount(fidx, FARM_TRUCK) >= 1 && Farm_UsableCount(fidx, FARM_TRAILER) >= 1)
            {
                // gaseste cel mai apropiat shop
                new Float:px, Float:py, Float:pz, Float:pa;
                GetPlayerPos(playerid, px, py, pz);
                GetPlayerFacingAngle(playerid, pa);
                new shop = -1; new Float:best = 999999.0;
                for(new i = 0; i < g_ShopCount; i++)
                {
                    new Float:d = VectorSize(px - ShopData[i][shopX], py - ShopData[i][shopY], pz - ShopData[i][shopZ]);
                    if(d < best) { best = d; shop = i; }
                }
                if(shop == -1)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"No shop available for delivery."), 1;

                g_FarmDelivTruck[playerid]   = CreateVehicle(FARM_TRUCK, px, py, pz, pa, -1, -1, -1);
                g_FarmDelivTrailer[playerid] = CreateVehicle(FARM_TRAILER, px, py - 6.0, pz, pa, -1, -1, -1);
                g_FarmDelivFarm[playerid]    = fidx;
                PutPlayerInVehicle(playerid, g_FarmDelivTruck[playerid], 0);
                SetTimerEx("Farm_DeliverAttach", 1000, false, "i", playerid);
                Track_SetPlayerCheckpoint(playerid, ShopData[shop][shopX], ShopData[shop][shopY], ShopData[shop][shopZ], 6.0);

                SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Farm] "C_WHITE"Delivery started! Drive the truck to the shop checkpoint to sell the harvest.");
                return 1;
            }
            else
            {
                // fara truck+trailer -> vanzare instant la jumatate, in contul fermei
                new pay = FarmData[fidx][fmRecolta] / 2;
                FarmData[fidx][fmBank] += pay;
                FarmData[fidx][fmRecolta] = 0;
                Farm_Save(fidx);
                new im[144];
                format(im, sizeof(im), T(playerid, C_SUCCESS"[Farm] "C_WHITE"Sold the harvest for "C_INFO"$%s"C_WHITE" (half, no truck+trailer) to the farm bank."), MoneyStr(pay));
                SCM(playerid, COLOR_SUCCESS, im);
                return 1;
            }
        }

        // ---- /farm rent [tractor/dozer/combina] (25% din pret, din contul fermei) ----
        if(strcmp(fAction, "rent", true) == 0)
        {
            if(!Farm_IsOwner(playerid, fidx))
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"This is not your field."), 1;
            while(cmdtext[idx] == ' ') idx++;
            new typeArg[12], tap = 0;
            while(cmdtext[idx] > ' ' && tap < 11) { typeArg[tap++] = cmdtext[idx]; idx++; }
            typeArg[tap] = EOS;
            new model = Farm_ModelFromType(typeArg);
            if(model != FARM_TRACTOR && model != FARM_DOZER && model != FARM_COMBINE)
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"You can only rent "C_INFO"tractor / dozer / combina"C_WHITE"."), 1;
            if(g_FarmRentVeh[playerid] != 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"You already have a rented vehicle."), 1;

            new rentPrice = Farm_VehPrice(model) * 25 / 100;
            if(FarmData[fidx][fmBank] < rentPrice)
            {
                new em[128];
                format(em, sizeof(em), T(playerid, C_ERROR"[Farm] "C_WHITE"The farm bank needs "C_INFO"$%s"C_WHITE" to rent (25%%)."), MoneyStr(rentPrice));
                return SCM(playerid, COLOR_ERROR, em), 1;
            }
            FarmData[fidx][fmBank] -= rentPrice;
            Farm_Save(fidx);

            new Float:px, Float:py, Float:pz, Float:pa;
            GetPlayerPos(playerid, px, py, pz);
            GetPlayerFacingAngle(playerid, pa);
            g_FarmRentVeh[playerid] = CreateVehicle(model, px, py, pz, pa, -1, -1, -1);
            PutPlayerInVehicle(playerid, g_FarmRentVeh[playerid], 0);

            new vtn[12]; Farm_VehTypeName(model, vtn);
            new rm[144];
            format(rm, sizeof(rm), T(playerid, C_SUCCESS"[Farm] "C_WHITE"Rented a %s for "C_INFO"$%s"C_WHITE" (25%%). It disappears when you leave it."), vtn, MoneyStr(rentPrice));
            SCM(playerid, COLOR_SUCCESS, rm);
            return 1;
        }

        new step = Farm_ActionIndex(fAction);
        if(step == -1)
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/farm [stats / plow / level / seed/fertilize/harvest/buy/sell]"C_WHITE"."), 1;

        if(g_FarmWorking[playerid] != 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"You are already doing farm work."), 1;

        if(step != FarmData[fidx][fmNextStep])
        {
            new emsg[144];
            format(emsg, sizeof(emsg), T(playerid, C_ERROR"[Farm] "C_WHITE"The next step here is "C_INFO"%s"C_WHITE", not %s."), g_FarmStepName[FarmData[fidx][fmNextStep]], g_FarmStepName[step]);
            return SCM(playerid, COLOR_ERROR, emsg), 1;
        }

        if(fWorkedToday)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"This field was already worked today. Come back tomorrow."), 1;

        // utilajul necesar: fie cel in care esti deja (rentat/altul), fie unul spawnat temporar (daca ferma detine)
        new stepModel = g_FarmStepVeh[step];
        new curVeh = GetPlayerVehicleID(playerid);
        new veh;
        new bool:spawned = false;
        if(curVeh != 0 && GetVehicleModel(curVeh) == stepModel)
        {
            veh = curVeh; // esti deja in utilajul potrivit (ex. rentat)
        }
        else if(Farm_UsableCount(fidx, stepModel) >= 1)
        {
            // spawneaza temporar un utilaj detinut de ferma, inca functional (se distruge la final/coborare)
            new Float:wx, Float:wy, Float:wz, Float:wa;
            GetPlayerPos(playerid, wx, wy, wz);
            GetPlayerFacingAngle(playerid, wa);
            veh = CreateVehicle(stepModel, wx, wy, wz, wa, -1, -1, -1);
            spawned = true;
        }
        else
        {
            new vtn0[12]; Farm_VehTypeName(stepModel, vtn0);
            new emv[144];
            format(emv, sizeof(emv), T(playerid, C_ERROR"[Farm] "C_WHITE"This field has no %s. Buy or rent one ("C_INFO"/farm buy/rent"C_WHITE")."), vtn0);
            return SCM(playerid, COLOR_ERROR, emv), 1;
        }

        // incepe lucrarea: lastWorkingDate = azi (indiferent daca termina)
        FarmData[fidx][fmLastWork] = gettime();
        Farm_Save(fidx);

        // pune playerul in utilaj (grace AC pt teleport in vehicul)
        g_ACGrace[playerid] = GetTickCount() + AC_GRACE_MS;
        g_ACExpectTP[playerid] = true;
        PutPlayerInVehicle(playerid, veh, 0);

        g_FarmWorking[playerid]  = fidx + 1;
        g_FarmWorkStep[playerid] = step;
        g_FarmWorkVeh[playerid]  = veh;
        g_FarmWorkSpawned[playerid] = spawned;

        new mins = g_FarmStepMin[step];
        g_FarmWorkTimer[playerid] = SetTimerEx("Farm_Complete", mins * 60000, false, "i", playerid);

        new smsg[256];
        format(smsg, sizeof(smsg), T(playerid, C_SUCCESS"[Farm] "C_WHITE"Started "C_INFO"%s"C_WHITE". Drive the "C_INFO"%s"C_WHITE" for "C_INFO"%d min"C_WHITE" - don't leave it!"),
            g_FarmStepName[step], g_FarmStepVehName[step], mins);
        SCM(playerid, COLOR_SUCCESS, smsg);
        return 1;
    }

    // ---- /rob (jaf la un business, cu masina) ----
    if(strcmp(cmd, "/rob", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(g_RobActive[playerid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Rob] "C_WHITE"You already have a robbery in progress."), 1;

        // trebuie sa fii intr-o masina, ca sofer
        new vid = GetPlayerVehicleID(playerid);
        if(vid == 0 || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Rob] "C_WHITE"You must be the driver of a vehicle to start a robbery."), 1;

        // ai nevoie de 10/10 rob points
        if(PlayerData[playerid][pRobPoints] < ROB_POINTS_MAX)
        {
            new rm[144];
            format(rm, sizeof(rm), T(playerid, C_ERROR"[Rob] "C_WHITE"You need "C_INFO"%d/%d"C_WHITE" rob points (you have "C_INFO"%d"C_WHITE"). You gain 1 per payday."),
                ROB_POINTS_MAX, ROB_POINTS_MAX, PlayerData[playerid][pRobPoints]);
            return SCM(playerid, COLOR_ERROR, rm), 1;
        }

        // trebuie sa fii langa un shop sau un fastfood
        new targetName[32];
        if(!Rob_NearTarget(playerid, targetName, sizeof(targetName)))
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Rob] "C_WHITE"There is no shop or fast-food nearby to rob."), 1;

        // alege 2 business-uri distincte, aleatorii, pentru livrarea banilor
        new bd1, bd2;
        if(!Rob_PickTwoBusinesses(bd1, bd2))
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Rob] "C_WHITE"Robbery unavailable: there aren't 2 businesses to deliver to."), 1;

        // capteaza echipa: toti jucatorii logati din aceeasi masina
        new crewCount = 0;
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
            if(GetPlayerVehicleID(i) != vid) continue;
            if(crewCount >= ROB_MAX_CREW) break;
            g_RobCrew[playerid][crewCount++] = i;
        }
        g_RobCrewCount[playerid] = crewCount;
        format(g_RobTargetName[playerid], 32, "%s", targetName);
        g_RobHQ[playerid][0]     = bd1;
        g_RobHQ[playerid][1]     = bd2;
        g_RobStage[playerid]     = 0;
        g_RobActive[playerid]    = true;

        // scade 10 rob points tuturor din masina + wanted level (pentru politie) + mapare inversa
        for(new c = 0; c < crewCount; c++)
        {
            new pid = g_RobCrew[playerid][c];
            g_RobLeaderOf[pid] = playerid;

            PlayerData[pid][pRobPoints] -= ROB_COST;
            if(PlayerData[pid][pRobPoints] < 0) PlayerData[pid][pRobPoints] = 0;
            UpdatePlayer(pid, pRobPoints);

            PlayerData[pid][pWanted] = 6;
            SetPlayerWantedLevel(pid, 6);
            UpdatePlayer(pid, pWanted);

            Pray_FlagSin(pid, 2); // Lacomia dupa bani

            new nm[256];
            format(nm, sizeof(nm), T(pid, C_ERROR"[Rob] "C_WHITE"Robbery of "C_INFO"%s"C_WHITE" started! Deliver the money to the "C_INFO"2 businesses"C_WHITE" (checkpoints) to get paid."),
                targetName);
            SCM(pid, COLOR_ERROR, nm);
        }

        // anunta politia (factiunea 1) si presa (News Reporters) despre jaf
        new pmsg[160];
        format(pmsg, sizeof(pmsg), "[P.R.] A group of thieves led by %s robbed %s! Hurry and catch them before they deliver the stolen goods.",
            PlayerData[playerid][pName], targetName);
        for(new i = 0; i < MAX_PLAYERS; i++)
            if(IsPlayerConnected(i) && PlayerData[i][pLogged] && (PlayerData[i][pFaction] == 1 || PlayerData[i][pFaction] == NEWS_FACTION_ID))
                {
                    format(pmsg, sizeof(pmsg), T(i, "[P.R.] A group of thieves led by %s robbed %s! Hurry and catch them before they deliver the stolen goods."), PlayerData[playerid][pName], targetName);
                    SCM(i, COLOR_ERROR, pmsg);
                }

        Rob_SetCheckpointForCrew(playerid); // pune primul checkpoint la business-ul 1
        return 1;
    }

    // ---- /smuggle (contrabanda pe mare, mafii, cu barca desemnata) ----
    if(strcmp(cmd, "/smuggle", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(!IsMafiaFaction(PlayerData[playerid][pFaction]))
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Smuggle] "C_WHITE"Only mafia factions can run contraband."), 1;

        if(g_SmuggleActive[playerid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Smuggle] "C_WHITE"You already have a smuggling run in progress."), 1;
        if(g_SmuggleLeaderOf[playerid] != INVALID_PLAYER_ID)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Smuggle] "C_WHITE"You are already part of a smuggling run."), 1;

        // trebuie sa fii soferul unei barci desemnate
        new vid = GetPlayerVehicleID(playerid);
        if(vid == 0 || GetPlayerState(playerid) != PLAYER_STATE_DRIVER || !IsSmuggleBoat(vid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Smuggle] "C_WHITE"You must be the driver of a designated smuggling boat (plate SMG)."), 1;

        // trebuie sa existe cel putin un hotel pe server (destinatia finala de livrare)
        if(g_HotelCount == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Smuggle] "C_WHITE"No hotels are configured on the server yet - there's nowhere to deliver."), 1;

        // cooldown per mafie - o cursa reusita pe zi calendaristica
        new sfid = PlayerData[playerid][pFaction];
        if(FactionData[sfid][fSmuggleCooldownDay] == gettime() / 86400)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Smuggle] "C_WHITE"Your faction already ran a successful smuggling run today - try again tomorrow."), 1;

        // capteaza echipajul: toti logatii din aceeasi barca
        new crewCount = 0;
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
            if(GetPlayerVehicleID(i) != vid) continue;
            if(crewCount >= SMUGGLE_MAX_CREW) break;
            g_SmuggleCrew[playerid][crewCount++] = i;
        }
        g_SmuggleCrewCount[playerid] = crewCount;
        g_SmuggleStage[playerid]     = SMUGGLE_STAGE_LOAD;
        g_SmuggleBoat[playerid]      = vid;
        g_SmuggleBusy[playerid]      = false;
        g_SmuggleActive[playerid]    = true;

        // mapare inversa echipaj -> lider (fara wanted inca - se aplica la loadcp)
        for(new c = 0; c < crewCount; c++)
        {
            new pid = g_SmuggleCrew[playerid][c];
            g_SmuggleLeaderOf[pid] = playerid;

            SCM(pid, COLOR_INFO, C_INFO"[Smuggle] "C_WHITE"Smuggling run started! Get to the "C_INFO"loading"C_WHITE" checkpoint.");
        }

        Smuggle_SetCheckpointForCrew(playerid); // primul checkpoint = loadcp (fix)
        return 1;
    }

    // ---- /farmstats /fstats (informatii despre ferma detinuta) ----
    // ---- /foreststats (informatii despre padurea detinuta) ----
    if(strcmp(cmd, "/foreststats", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pForestKey] == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Forest] "C_WHITE"You don't own a forest."), 1;

        new fsi = Forest_IndexByID(PlayerData[playerid][pForestKey]);
        if(fsi == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Forest] "C_WHITE"Your forest could not be found."), 1;

        new fsl[144];
        format(fsl, sizeof(fsl), T(playerid, C_INFO"_____ Your Forest (#%d) ____________________"), ForestData[fsi][fstID]);
        SCM(playerid, COLOR_INFO, fsl);

        format(fsl, sizeof(fsl), T(playerid, C_WHITE"Size: "C_INFO"%.1f"C_WHITE" | Price: "C_INFO"$%s"C_WHITE" | For sale: "C_INFO"%s"),
            ForestData[fsi][fstSize], MoneyStr(ForestData[fsi][fstPrice]), ForestData[fsi][fstForSale] ? "yes" : "no");
        SCM(playerid, COLOR_WHITE, fsl);

        format(fsl, sizeof(fsl), T(playerid, C_WHITE"Trees: "C_INFO"%d/%d"C_WHITE" | Saplings in stock: "C_INFO"%d"C_WHITE" | Planted (pending PayDay): "C_INFO"%d"),
            ForestData[fsi][fstCurrentTree], ForestData[fsi][fstMaxTree], ForestData[fsi][fstSaplings], ForestData[fsi][fstPlantedSaplings]);
        SCM(playerid, COLOR_WHITE, fsl);

        format(fsl, sizeof(fsl), T(playerid, C_WHITE"Bank: "C_INFO"$%s"C_WHITE" (use "C_INFO"/mybank forest"C_WHITE" to deposit/withdraw)"), MoneyStr(ForestData[fsi][fstBank]));
        SCM(playerid, COLOR_WHITE, fsl);
        return 1;
    }

    // ---- /forest [saplings deposit <amount> / tree plant] ----
    if(strcmp(cmd, "/forest", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new fSub1[16], fSub1Pos = 0;
        while(cmdtext[idx] > ' ' && fSub1Pos < 15) { fSub1[fSub1Pos++] = cmdtext[idx]; idx++; }
        fSub1[fSub1Pos] = EOS;

        // ---- /forest saplings deposit <amount> ----
        if(strcmp(fSub1, "saplings", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new fSub2[16], fSub2Pos = 0;
            while(cmdtext[idx] > ' ' && fSub2Pos < 15) { fSub2[fSub2Pos++] = cmdtext[idx]; idx++; }
            fSub2[fSub2Pos] = EOS;

            if(strcmp(fSub2, "deposit", true) != 0)
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/forest saplings deposit [amount]"C_WHITE"."), 1;

            new fpidx = Forest_PlayerIn(playerid);
            if(fpidx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at a "C_INFO"Forest"C_WHITE" to do this."), 1;

            if(GetVehicleModel(GetPlayerVehicleID(playerid)) != BENSON_MODEL)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in a "C_INFO"Benson"C_WHITE" to deposit saplings."), 1;

            while(cmdtext[idx] == ' ') idx++;
            new fdStr[12];
            strmid(fdStr, cmdtext, idx, strlen(cmdtext), 12);
            new fdAmount = strval(fdStr);

            if(fdAmount <= 0)
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/forest saplings deposit [amount]"C_WHITE"."), 1;

            if(fdAmount > g_CarriedSaplings[playerid])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have that many saplings with you."), 1;

            new fdRoom = (2 * ForestData[fpidx][fstMaxTree]) - ForestData[fpidx][fstSaplings];
            if(fdRoom <= 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This forest's sapling storage is full."), 1;

            new fdActual = (fdAmount > fdRoom) ? fdRoom : fdAmount;
            ForestData[fpidx][fstSaplings] += fdActual;
            g_CarriedSaplings[playerid] -= fdActual;

            new fdq[128];
            mysql_format(g_SQL, fdq, sizeof(fdq), "UPDATE `forests` SET `saplings`=%d WHERE `id`=%d", ForestData[fpidx][fstSaplings], ForestData[fpidx][fstID]);
            mysql_tquery(g_SQL, fdq, "", "", 0);

            new fdm[160];
            if(fdActual < fdAmount)
                format(fdm, sizeof(fdm), T(playerid, C_SUCCESS"[Forest] "C_WHITE"Deposited "C_INFO"%d"C_WHITE" saplings (storage full, "C_INFO"%d"C_WHITE" left with you)."), fdActual, fdAmount - fdActual);
            else
                format(fdm, sizeof(fdm), T(playerid, C_SUCCESS"[Forest] "C_WHITE"Deposited "C_INFO"%d"C_WHITE" saplings. Forest now has "C_INFO"%d"C_WHITE" in stock."), fdActual, ForestData[fpidx][fstSaplings]);
            SCM(playerid, COLOR_SUCCESS, fdm);
            return 1;
        }

        // ---- /forest tree plant ----
        if(strcmp(fSub1, "tree", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new fSub2b[16], fSub2bPos = 0;
            while(cmdtext[idx] > ' ' && fSub2bPos < 15) { fSub2b[fSub2bPos++] = cmdtext[idx]; idx++; }
            fSub2b[fSub2bPos] = EOS;

            if(strcmp(fSub2b, "plant", true) != 0)
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/forest tree plant"C_WHITE"."), 1;

            if(PlayerData[playerid][pJob] != JOB_LUMBERJACK)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need the "C_INFO"Lumberjack"C_WHITE" job for this."), 1;

            if(g_PlantState[playerid] != PLANT_STATE_NONE)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are already planting a sapling."), 1;

            if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetVehicleModel(GetPlayerVehicleID(playerid)) != FORKLIFT_MODEL)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be driving a "C_INFO"Forklift"C_WHITE" to do this."), 1;

            new tpidx = Forest_PlayerIn(playerid);
            if(tpidx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at a "C_INFO"Forest"C_WHITE" to do this."), 1;

            if(ForestData[tpidx][fstSaplings] <= 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This forest has no saplings in stock. Ask the owner to deposit some."), 1;

            if(ForestData[tpidx][fstCurrentTree] + ForestData[tpidx][fstPlantedSaplings] >= ForestData[tpidx][fstMaxTree])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This forest already has enough trees planted."), 1;

            new Float:tpSize = ForestData[tpidx][fstSize];
            new Float:tpX = ForestData[tpidx][fstX] + (float(random(201) - 100) / 100.0) * tpSize;
            new Float:tpY = ForestData[tpidx][fstY] + (float(random(201) - 100) / 100.0) * tpSize;
            new Float:tpZ = ForestData[tpidx][fstZ];

            g_PlantState[playerid] = PLANT_STATE_DRIVING;
            g_PlantForestIdx[playerid] = tpidx;
            SetPlayerRaceCheckpoint(playerid, 1, tpX, tpY, tpZ, tpX, tpY, tpZ, SAPLING_PLANT_CP_SIZE);

            SCM(playerid, COLOR_INFO, C_INFO"[Lumberjack] "C_WHITE"Drive the forklift to the marked spot inside the forest.");
            return 1;
        }

        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/forest saplings deposit [amount]"C_WHITE" or "C_INFO"/forest tree plant"C_WHITE"."), 1;
    }

    // ---- /buyforest (cumpara padurea pe care stai, daca e libera) ----
    if(strcmp(cmd, "/buyforest", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pForestKey] != 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Forest] "C_WHITE"You already own a forest."), 1;

        new fsidx = Forest_PlayerIn(playerid);
        if(fsidx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Forest] "C_WHITE"You are not on a forest."), 1;

        if(!ForestData[fsidx][fstForSale] || ForestData[fsidx][fstOwnerId] == PlayerData[playerid][pID])
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Forest] "C_WHITE"This forest is not for sale."), 1;

        new fsprice = ForestData[fsidx][fstPrice];
        if(PlayerData[playerid][pMoney] < fsprice)
        {
            new fsem[128];
            format(fsem, sizeof(fsem), T(playerid, C_ERROR"[Forest] "C_WHITE"You need "C_INFO"$%s"C_WHITE" to buy this forest."), MoneyStr(fsprice));
            return SCM(playerid, COLOR_ERROR, fsem), 1;
        }

        new fsSellerId = ForestData[fsidx][fstOwnerId];

        PlayerData[playerid][pMoney] -= fsprice;
        GivePlayerMoney(playerid, -fsprice);
        UpdatePlayer(playerid, pMoney);

        if(fsSellerId != 0)
            Prop_SettleSeller(fsSellerId, fsprice, "forest_key", pForestKey, "forest");

        ForestData[fsidx][fstOwnerId] = PlayerData[playerid][pID];
        ForestData[fsidx][fstForSale] = 0;
        format(ForestData[fsidx][fstOwnerName], 24, "%s", PlayerData[playerid][pName]);
        PlayerData[playerid][pForestKey] = ForestData[fsidx][fstID];
        UpdatePlayer(playerid, pForestKey);

        new fsq[176];
        mysql_format(g_SQL, fsq, sizeof(fsq), "UPDATE `forests` SET `owner`='%e', `ownerId`=%d, `isForSale`=0 WHERE `id`=%d",
            PlayerData[playerid][pName], PlayerData[playerid][pID], ForestData[fsidx][fstID]);
        mysql_tquery(g_SQL, fsq, "", "", 0);
        Forest_RecreatePickup(fsidx);

        new fsbm[256];
        format(fsbm, sizeof(fsbm), T(playerid, C_SUCCESS"[Forest] "C_WHITE"You bought Forest "C_INFO"#%d"C_WHITE" for "C_INFO"$%s"C_WHITE"! Use "C_INFO"/foreststats"C_WHITE"."),
            ForestData[fsidx][fstID], MoneyStr(fsprice));
        SCM(playerid, COLOR_SUCCESS, fsbm);
        return 1;
    }

    // ---- /sellforest [price] (pune padura la vanzare pt alti playeri, 0 = anuleaza) ----
    if(strcmp(cmd, "/sellforest", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pForestKey] == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Forest] "C_WHITE"You don't own a forest."), 1;

        new sfidx = Forest_IndexByID(PlayerData[playerid][pForestKey]);
        if(sfidx == -1)
        {
            PlayerData[playerid][pForestKey] = 0;
            UpdatePlayer(playerid, pForestKey);
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Forest] "C_WHITE"Your forest could not be found."), 1;
        }

        while(cmdtext[idx] == ' ') idx++;
        new sfpstr[16];
        strmid(sfpstr, cmdtext, idx, strlen(cmdtext), 16);
        if(!strlen(sfpstr))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/sellforest [price]"C_WHITE" to list it for sale, or "C_INFO"/sellforest 0"C_WHITE" to cancel."), 1;

        new sfprice = strval(sfpstr);
        new sfq[160];
        if(sfprice <= 0)
        {
            ForestData[sfidx][fstForSale] = 0;
            mysql_format(g_SQL, sfq, sizeof(sfq), "UPDATE `forests` SET `isForSale`=0 WHERE `id`=%d", ForestData[sfidx][fstID]);
            mysql_tquery(g_SQL, sfq, "", "", 0);
            Forest_RecreatePickup(sfidx);
            return SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Forest] "C_WHITE"Your forest is no longer for sale."), 1;
        }

        ForestData[sfidx][fstForSale] = 1;
        ForestData[sfidx][fstPrice]   = sfprice;
        mysql_format(g_SQL, sfq, sizeof(sfq), "UPDATE `forests` SET `isForSale`=1, `price`=%d WHERE `id`=%d", sfprice, ForestData[sfidx][fstID]);
        mysql_tquery(g_SQL, sfq, "", "", 0);
        Forest_RecreatePickup(sfidx);

        new sfm[144];
        format(sfm, sizeof(sfm), T(playerid, "[Forest] ""Forest ""#%d"" is now for sale for ""$%s"". Another player can buy it with ""/buyforest""."),
            ForestData[sfidx][fstID], MoneyStr(sfprice));
        SCM(playerid, COLOR_SUCCESS, sfm);
        return 1;
    }

    // ---- /sellforestto [playerid] [amount] (oferta directa, cumparatorul confirma cu /accept forest [sellerid]) ----
    if(strcmp(cmd, "/sellforestto", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pForestKey] == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Forest] "C_WHITE"You don't own a forest."), 1;

        new stfidx = Forest_IndexByID(PlayerData[playerid][pForestKey]);
        if(stfidx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Forest] "C_WHITE"Your forest could not be found."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new stfPStr[8], stfpp = 0;
        while(cmdtext[idx] > ' ' && stfpp < 7) { stfPStr[stfpp++] = cmdtext[idx]; idx++; }
        stfPStr[stfpp] = EOS;
        while(cmdtext[idx] == ' ') idx++;
        new stfAStr[12];
        strmid(stfAStr, cmdtext, idx, strlen(cmdtext), 12);
        if(!strlen(stfPStr) || !strlen(stfAStr))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/sellforestto [playerid] [amount]"C_WHITE"."), 1;

        new stfTarget = strval(stfPStr), stfAmount = strval(stfAStr);
        if(!IsPlayerConnected(stfTarget) || !PlayerData[stfTarget][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid player."), 1;
        if(stfTarget == playerid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't sell to yourself."), 1;
        if(stfAmount <= 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid amount."), 1;

        g_ForestOfferSeller[stfTarget] = playerid;
        g_ForestOfferFid[stfTarget]    = ForestData[stfidx][fstID];
        g_ForestOfferAmount[stfTarget] = stfAmount;

        new stfmsg[160];
        format(stfmsg, sizeof(stfmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You offered your forest (ID: "C_INFO"%d"C_WHITE") to "C_INFO"%s"C_WHITE" for "C_INFO"$%s"C_WHITE"."),
            ForestData[stfidx][fstID], PlayerData[stfTarget][pName], MoneyStr(stfAmount));
        SCM(playerid, COLOR_SUCCESS, stfmsg);
        format(stfmsg, sizeof(stfmsg), T(stfTarget, "[Forest] %s wants to sell you their forest (ID: %d) for $%s. Use /accept forest %d to buy it."),
            PlayerData[playerid][pName], ForestData[stfidx][fstID], MoneyStr(stfAmount), playerid);
        SCM(stfTarget, COLOR_INFO, stfmsg);
        return 1;
    }

    // ---- /sellforesttostate (vinde padurea la stat, 60%) ----
    if(strcmp(cmd, "/sellforesttostate", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pForestKey] == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Forest] "C_WHITE"You don't own a forest."), 1;

        new sttfidx = Forest_IndexByID(PlayerData[playerid][pForestKey]);
        if(sttfidx == -1)
        {
            PlayerData[playerid][pForestKey] = 0;
            UpdatePlayer(playerid, pForestKey);
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Forest] "C_WHITE"Your forest could not be found."), 1;
        }

        new sttfRefund = ForestData[sttfidx][fstPrice] * 60 / 100; // vanzare la stat: 60% din valoare
        PlayerData[playerid][pMoney] += sttfRefund;
        GivePlayerMoney(playerid, sttfRefund);
        UpdatePlayer(playerid, pMoney);

        ForestData[sttfidx][fstOwnerId]      = 0;
        ForestData[sttfidx][fstForSale]      = 1; // inapoi la stat = cumparabila din nou
        ForestData[sttfidx][fstOwnerName][0] = EOS;
        PlayerData[playerid][pForestKey]     = 0;
        UpdatePlayer(playerid, pForestKey);

        new sttfq[160];
        mysql_format(g_SQL, sttfq, sizeof(sttfq), "UPDATE `forests` SET `owner`='', `ownerId`=0, `isForSale`=1 WHERE `id`=%d", ForestData[sttfidx][fstID]);
        mysql_tquery(g_SQL, sttfq, "", "", 0);
        Forest_RecreatePickup(sttfidx);

        new sttfm[144];
        format(sttfm, sizeof(sttfm), T(playerid, C_SUCCESS"[Forest] "C_WHITE"You sold Forest "C_INFO"#%d"C_WHITE" to the state for "C_INFO"$%s"C_WHITE"."),
            ForestData[sttfidx][fstID], MoneyStr(sttfRefund));
        SCM(playerid, COLOR_SUCCESS, sttfm);
        return 1;
    }

    if(strcmp(cmd, "/farmstats", true) == 0 || strcmp(cmd, "/fstats", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pFarmKey] == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"You don't own a farm."), 1;

        new fs = Farm_IndexByID(PlayerData[playerid][pFarmKey]);
        if(fs == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"Your farm could not be found."), 1;

        new fl[256];
        format(fl, sizeof(fl), T(playerid, C_INFO"_____ Your Farm (#%d) ____________________"), FarmData[fs][fmID]);
        SCM(playerid, COLOR_INFO, fl);

        format(fl, sizeof(fl), T(playerid, C_WHITE"Next step: "C_INFO"%s"C_WHITE" (%s, %d min)"),
            g_FarmStepName[FarmData[fs][fmNextStep]], g_FarmStepVehName[FarmData[fs][fmNextStep]], g_FarmStepMin[FarmData[fs][fmNextStep]]);
        SCM(playerid, COLOR_WHITE, fl);

        format(fl, sizeof(fl), T(playerid, C_WHITE"Progress: Plow[%s] Level[%s] Seed[%s] Fertilize[%s] Harvest[%s]"),
            (FarmData[fs][fmPlowed] ? "X" : "-"), (FarmData[fs][fmLeveled] ? "X" : "-"), (FarmData[fs][fmSeeded] ? "X" : "-"),
            (FarmData[fs][fmFertilized] ? "X" : "-"), (FarmData[fs][fmReady] ? "X" : "-"));
        SCM(playerid, COLOR_WHITE, fl);

        format(fl, sizeof(fl), T(playerid, C_WHITE"Vehicles: Tractors "C_INFO"%d"C_WHITE", Dozers "C_INFO"%d"C_WHITE", Combines "C_INFO"%d"C_WHITE" (+ truck/trailer if bought)"),
            FarmData[fs][fmTractors], FarmData[fs][fmDozers], FarmData[fs][fmCombines]);
        SCM(playerid, COLOR_WHITE, fl);

        format(fl, sizeof(fl), T(playerid, C_WHITE"Farm bank: "C_INFO"$%s"C_WHITE" | Harvest stock: "C_INFO"$%s"C_WHITE" (sell with /farm deliver)"),
            MoneyStr(FarmData[fs][fmBank]), MoneyStr(FarmData[fs][fmRecolta]));
        SCM(playerid, COLOR_WHITE, fl);

        new fToday = gettime() / 86400, fLast = FarmData[fs][fmLastWork] / 86400;
        if(FarmData[fs][fmLastWork] > 0)
        {
            new ds[11]; UnixToDateStr(FarmData[fs][fmLastWork], ds, sizeof(ds));
            if(fLast >= fToday)
                format(fl, sizeof(fl), T(playerid, C_WHITE"Last worked: "C_INFO"%s"C_WHITE" - "C_ERROR"come back tomorrow"), ds);
            else
                format(fl, sizeof(fl), T(playerid, C_WHITE"Last worked: "C_INFO"%s"C_WHITE" - ready: "C_SUCCESS"yes"), ds);
        }
        else
            format(fl, sizeof(fl), T(playerid, C_WHITE"Last worked: "C_INFO"never"C_WHITE" - ready: "C_SUCCESS"yes"));
        SCM(playerid, COLOR_WHITE, fl);
        return 1;
    }

    // ---- /buyfarm (cumpara terenul pe care stai, daca e liber) ----
    if(strcmp(cmd, "/buyfarm", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pFarmKey] != 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"You already own a farm. Use "C_INFO"/sellfarm"C_WHITE" first."), 1;

        new fidx = Farm_PlayerIn(playerid);
        if(fidx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"You are not on a farm."), 1;
        // cumperi DOAR daca e pusa la vanzare (is_for_sale=1), indiferent daca are sau nu proprietar
        if(!FarmData[fidx][fmForSale] || (FarmData[fidx][fmOwned] && FarmData[fidx][fmOwnerId] == PlayerData[playerid][pID]))
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"This farm is not for sale."), 1;

        new price = FarmData[fidx][fmPrice];
        if(PlayerData[playerid][pMoney] < price)
        {
            new em[128];
            format(em, sizeof(em), T(playerid, C_ERROR"[Farm] "C_WHITE"You need "C_INFO"$%s"C_WHITE" to buy this farm."), MoneyStr(price));
            return SCM(playerid, COLOR_ERROR, em), 1;
        }

        new sellerId = (FarmData[fidx][fmOwned]) ? FarmData[fidx][fmOwnerId] : 0;

        PlayerData[playerid][pMoney] -= price;
        GivePlayerMoney(playerid, -price);
        UpdatePlayer(playerid, pMoney);

        if(sellerId != 0)
            Prop_SettleSeller(sellerId, price, "", pFarmKey, "farm"); // ferma nu e coloana in `players`

        FarmData[fidx][fmOwned]   = 1;
        FarmData[fidx][fmForSale] = 0;
        FarmData[fidx][fmOwnerId] = PlayerData[playerid][pID];
        format(FarmData[fidx][fmOwnerName], 24, "%s", PlayerData[playerid][pName]);
        PlayerData[playerid][pFarmKey] = FarmData[fidx][fmID];

        new q[176];
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `farms` SET `owner`='%e', `owner_id`=%d, `isOwned`=1, `is_for_sale`=0 WHERE `id`=%d",
            PlayerData[playerid][pName], PlayerData[playerid][pID], FarmData[fidx][fmID]);
        mysql_tquery(g_SQL, q, "", "", 0);
        Farm_RecreatePickup(fidx);

        new bm[256];
        format(bm, sizeof(bm), T(playerid, C_SUCCESS"[Farm] "C_WHITE"You bought Farm "C_INFO"#%d"C_WHITE" for "C_INFO"$%s"C_WHITE"! Use "C_INFO"/farmstats"C_WHITE"."),
            FarmData[fidx][fmID], MoneyStr(price));
        SCM(playerid, COLOR_SUCCESS, bm);
        return 1;
    }

    // ---- /sellfarm (vinde ferma detinuta) ----
    if(strcmp(cmd, "/sellfarm", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pFarmKey] == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"You don't own a farm."), 1;

        new fidx = Farm_IndexByID(PlayerData[playerid][pFarmKey]);
        if(fidx == -1)
        {
            PlayerData[playerid][pFarmKey] = 0;
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"Your farm could not be found."), 1;
        }

        while(cmdtext[idx] == ' ') idx++;
        new fpstr[16];
        strmid(fpstr, cmdtext, idx, strlen(cmdtext), 16);
        if(!strlen(fpstr))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/sellfarm [price]"C_WHITE" to list it for sale, or "C_INFO"/sellfarm 0"C_WHITE" to cancel."), 1;

        new fsprice = strval(fpstr);
        new q[160];
        if(fsprice <= 0)
        {
            FarmData[fidx][fmForSale] = 0;
            mysql_format(g_SQL, q, sizeof(q), "UPDATE `farms` SET `is_for_sale`=0 WHERE `id`=%d", FarmData[fidx][fmID]);
            mysql_tquery(g_SQL, q, "", "", 0);
            Farm_RecreatePickup(fidx);
            return SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Farm] "C_WHITE"Your farm is no longer for sale."), 1;
        }

        FarmData[fidx][fmForSale] = 1;
        FarmData[fidx][fmPrice]   = fsprice;
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `farms` SET `is_for_sale`=1, `price`=%d WHERE `id`=%d", fsprice, FarmData[fidx][fmID]);
        mysql_tquery(g_SQL, q, "", "", 0);
        Farm_RecreatePickup(fidx);

        new sm[144];
        format(sm, sizeof(sm), T(playerid, "[Farm] ""Farm ""#%d"" is now for sale for ""$%s"". Another player can buy it with ""/buyfarm""."),
            FarmData[fidx][fmID], MoneyStr(fsprice));
        SCM(playerid, COLOR_SUCCESS, sm);
        return 1;
    }

    // ---- /sellfarmtostate (vinde ferma la stat, 75%) ----
    if(strcmp(cmd, "/sellfarmtostate", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pFarmKey] == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"You don't own a farm."), 1;

        new fidx = Farm_IndexByID(PlayerData[playerid][pFarmKey]);
        if(fidx == -1)
        {
            PlayerData[playerid][pFarmKey] = 0;
            return SCM(playerid, COLOR_ERROR, C_ERROR"[Farm] "C_WHITE"Your farm could not be found."), 1;
        }

        new refund = FarmData[fidx][fmPrice] * 60 / 100; // vanzare la stat: 60% din valoare
        PlayerData[playerid][pMoney] += refund;
        GivePlayerMoney(playerid, refund);
        UpdatePlayer(playerid, pMoney);

        FarmData[fidx][fmOwned]        = 0;
        FarmData[fidx][fmOwnerId]      = 0;
        FarmData[fidx][fmForSale]      = 1; // inapoi la stat = cumparabila din nou
        FarmData[fidx][fmOwnerName][0] = EOS;
        PlayerData[playerid][pFarmKey] = 0;

        new q[176];
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `farms` SET `owner`='', `owner_id`=0, `isOwned`=0, `is_for_sale`=1 WHERE `id`=%d", FarmData[fidx][fmID]);
        mysql_tquery(g_SQL, q, "", "", 0);
        Farm_RecreatePickup(fidx);

        new sm2[144];
        format(sm2, sizeof(sm2), T(playerid, C_SUCCESS"[Farm] "C_WHITE"You sold Farm "C_INFO"#%d"C_WHITE" to the state for "C_INFO"$%s"C_WHITE" (60%%)."), FarmData[fidx][fmID], MoneyStr(refund));
        SCM(playerid, COLOR_SUCCESS, sm2);
        return 1;
    }

    // ---- /fixcar ----
    if(strcmp(cmd, "/fixcar", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        new vehid = GetPlayerVehicleID(playerid);
        if(vehid == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in a vehicle."), 1;

        RepairVehicle(vehid);

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Vehicle repaired.");
        return 1;
    }

    // ---- /changecar [engine/lights/alarm/doors/hood/boot] (comuta o componenta a vehiculului curent) ----
    // ---- /setworldtime [0-23] (admin 3+: seteaza ora din lumea jocului pentru toti, util ca sa testezi faruri noaptea) ----
    if(strcmp(cmd, "/setworldtime", true) == 0 || strcmp(cmd, "/settod", true) == 0 || strcmp(cmd, "/settimeofday", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 3)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 3."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new wtStr[4];
        strmid(wtStr, cmdtext, idx, strlen(cmdtext), 4);
        if(!strlen(wtStr))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/setworldtime [0-23]"C_WHITE" (e.g. "C_INFO"0"C_WHITE" or "C_INFO"22"C_WHITE" for night)."), 1;

        new wtHour = strval(wtStr);
        if(wtHour < 0 || wtHour > 23)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Use an hour between 0 and 23."), 1;

        SetWorldTime(wtHour);

        new wtmsg[96];
        format(wtmsg, sizeof(wtmsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"World time set to "C_INFO"%d:00"C_WHITE"."), wtHour);
        SCM(playerid, COLOR_SUCCESS, wtmsg);
        return 1;
    }

    // ---- /roadworking [offset] [nr paydays] [nume zona] (admin 3+: creeaza/inchide un santier temporar pe drum) ----
    if(strcmp(cmd, "/roadworking", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 3)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 3."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new rwp1[16]; strmid(rwp1, cmdtext, idx, strlen(cmdtext), 16);
        while(cmdtext[idx] > ' ') idx++; while(cmdtext[idx] == ' ') idx++;
        new rwp2[8]; strmid(rwp2, cmdtext, idx, strlen(cmdtext), 8);
        while(cmdtext[idx] > ' ') idx++; while(cmdtext[idx] == ' ') idx++;
        new rwname[32]; strmid(rwname, cmdtext, idx, strlen(cmdtext), 32);

        if(!strlen(rwp1) || !strlen(rwp2))
            return SCM(playerid, COLOR_INFO, "Info: Use /roadworking [offset] [nr paydays] [zone name] (or /roadworking [offset] -1 to force-reopen)."), 1;

        new Float:rwOffset = floatstr(rwp1);
        new rwPaydays = strval(rwp2);

        // ---- -1 = deblocare fortata a zonei active ----
        if(rwPaydays == -1)
        {
            if(!g_RoadWorkActive)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"No road working zone is currently active."), 1;

            new rwoldname[32];
            format(rwoldname, sizeof(rwoldname), "%s", g_RoadWorkName);
            RoadWork_Clear(true);

            new rwamsg[144];
            format(rwamsg, sizeof(rwamsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Road working zone "C_INFO"\"%s\""C_WHITE" was force-reopened."), rwoldname);
            SCM(playerid, COLOR_SUCCESS, rwamsg);
            return 1;
        }

        if(g_RoadWorkActive)
        {
            new rwbmsg[144];
            format(rwbmsg, sizeof(rwbmsg), T(playerid, "Error: A road working zone (\"%s\") is already active. Clear it first with /roadworking [offset] -1."), g_RoadWorkName);
            return SCM(playerid, COLOR_ERROR, rwbmsg), 1;
        }
        if(rwOffset <= 0.0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Offset must be greater than 0."), 1;
        if(rwPaydays < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Number of paydays must be at least 1 (or "C_INFO"-1"C_WHITE" to force-reopen)."), 1;
        if(!strlen(rwname))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/roadworking [offset] [nr paydays] [zone name]"C_WHITE"."), 1;

        new Float:rwx, Float:rwy, Float:rwz, Float:rwa;
        GetPlayerPos(playerid, rwx, rwy, rwz);
        GetPlayerFacingAngle(playerid, rwa);

        new Float:rwdx = rwOffset * floatsin(-rwa, degrees);
        new Float:rwdy = rwOffset * floatcos(rwa, degrees);

        new rwVW = GetPlayerVirtualWorld(playerid);
        new rwInt = GetPlayerInterior(playerid);

        new Float:rwz2 = rwz + ROADWORK_Z_OFFSET;

        g_RoadWorkObj1 = CreateDynamicObject(ROADWORK_OBJECT_MODEL, rwx + rwdx, rwy + rwdy, rwz2, 0.0, 0.0, rwa, rwVW, rwInt);
        g_RoadWorkObj2 = CreateDynamicObject(ROADWORK_OBJECT_MODEL, rwx - rwdx, rwy - rwdy, rwz2, 0.0, 0.0, rwa + 180.0, rwVW, rwInt);

        g_RoadWorkX = rwx;
        g_RoadWorkY = rwy;
        g_RoadWorkZ = rwz;
        for(new rwi = 0; rwi < MAX_PLAYERS; rwi++) g_RoadWorkInside[rwi] = false;
        g_RoadWorkInside[playerid] = true; // adminul e chiar in centrul zonei - nu se prinde singur la creare

        format(g_RoadWorkName, sizeof(g_RoadWorkName), "%s", rwname);
        g_RoadWorkPaydaysLeft = rwPaydays;
        g_RoadWorkActive      = true;

        new rwmsg[160];
        format(rwmsg, sizeof(rwmsg), C_ERROR"[Road Working] "C_WHITE"There are road works in zone \"%s\". Please use alternate routes.", g_RoadWorkName);
        RoadWork_BroadcastAll(COLOR_ERROR, rwmsg);

        new rwsmsg[144];
        format(rwsmsg, sizeof(rwsmsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Road working zone "C_INFO"\"%s\""C_WHITE" created for "C_INFO"%d payday(s)"C_WHITE"."), g_RoadWorkName, rwPaydays);
        SCM(playerid, COLOR_SUCCESS, rwsmsg);
        return 1;
    }

    if(strcmp(cmd, "/changecar", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 3)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 3."), 1;

        new vehid = GetPlayerVehicleID(playerid);
        if(vehid == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in a vehicle."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new ccComp[12];
        strmid(ccComp, cmdtext, idx, strlen(cmdtext), 12);
        if(!strlen(ccComp))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/changecar [engine/lights/alarm/doors/hood/boot]"C_WHITE"."), 1;

        new ccEngine, ccLights, ccAlarm, ccDoors, ccBonnet, ccBoot, ccObjective;
        GetVehicleParamsEx(vehid, ccEngine, ccLights, ccAlarm, ccDoors, ccBonnet, ccBoot, ccObjective);

        new ccName[16], ccNew;
        if(strcmp(ccComp, "engine", true) == 0)
        {
            ccEngine = (ccEngine == 1) ? 0 : 1; ccNew = ccEngine; format(ccName, sizeof(ccName), "Engine");
        }
        else if(strcmp(ccComp, "lights", true) == 0)
        {
            ccLights = (ccLights == 1) ? 0 : 1; ccNew = ccLights; format(ccName, sizeof(ccName), "Lights");
        }
        else if(strcmp(ccComp, "alarm", true) == 0)
        {
            ccAlarm = (ccAlarm == 1) ? 0 : 1; ccNew = ccAlarm; format(ccName, sizeof(ccName), "Alarm");
        }
        else if(strcmp(ccComp, "doors", true) == 0 || strcmp(ccComp, "lock", true) == 0)
        {
            ccDoors = (ccDoors == 1) ? 0 : 1; ccNew = ccDoors; format(ccName, sizeof(ccName), "Doors");
        }
        else if(strcmp(ccComp, "hood", true) == 0 || strcmp(ccComp, "bonnet", true) == 0)
        {
            ccBonnet = (ccBonnet == 1) ? 0 : 1; ccNew = ccBonnet; format(ccName, sizeof(ccName), "Hood");
        }
        else if(strcmp(ccComp, "boot", true) == 0 || strcmp(ccComp, "trunk", true) == 0)
        {
            ccBoot = (ccBoot == 1) ? 0 : 1; ccNew = ccBoot; format(ccName, sizeof(ccName), "Boot");
        }
        else
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Unknown component. Use "C_INFO"engine/lights/alarm/doors/hood/boot"C_WHITE"."), 1;

        SetVehicleParamsEx(vehid, ccEngine, ccLights, ccAlarm, ccDoors, ccBonnet, ccBoot, ccObjective);

        new ccMsg[96];
        format(ccMsg, sizeof(ccMsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"%s "C_INFO"%s"C_WHITE"."), ccName, ccNew ? ("ON") : ("OFF"));
        SCM(playerid, COLOR_SUCCESS, ccMsg);
        return 1;
    }

    // ---- /jetpack (primesti un jetpack) ----
    if(strcmp(cmd, "/jetpack", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 5)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 5."), 1;

        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USEJETPACK);
        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"You received a jetpack.");
        return 1;
    }

    // ---- /removejetpack (elimina toate jetpack-urile de pe server) ----
    if(strcmp(cmd, "/removejetpack", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 5)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 5."), 1;

        new removed = 0;
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(!IsPlayerConnected(i)) continue;
            if(GetPlayerSpecialAction(i) == SPECIAL_ACTION_USEJETPACK)
            {
                SetPlayerSpecialAction(i, SPECIAL_ACTION_NONE);
                removed++;
            }
        }

        new rjmsg[256];
        format(rjmsg, sizeof(rjmsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Removed all jetpacks ("C_INFO"%d"C_WHITE" player(s))."), removed);
        SCM(playerid, COLOR_SUCCESS, rjmsg);
        return 1;
    }

    // ---- /flipcar ----
    if(strcmp(cmd, "/flipcar", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        new vehid = GetPlayerVehicleID(playerid);
        if(vehid == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in a vehicle."), 1;

        new Float:fx, Float:fy, Float:fz, Float:fangle;
        GetVehiclePos(vehid, fx, fy, fz);
        GetVehicleZAngle(vehid, fangle);

        SetVehiclePos(vehid, fx, fy, fz + 0.5);
        SetVehicleZAngle(vehid, fangle);

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Vehicle flipped upright.");
        return 1;
    }

    // ---- /createfire ----
    if(strcmp(cmd, "/createfire", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 2)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

        new Float:fx, Float:fy, Float:fz;
        GetPlayerPos(playerid, fx, fy, fz);

        if(Fires_Create(fx, fy, fz) == -1)
            return SCM(playerid, COLOR_ERROR,
                C_ERROR"Error: "C_WHITE"Limit of "C_INFO#MAX_FIRES C_WHITE" simultaneous fires reached."), 1;

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Fire created.");
        return 1;
    }

    // ---- /opengolftournament ----
    if(strcmp(cmd, "/opengolftournament", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < GOLF_ADMIN_LEVEL)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

        if(g_GolfStatus != GOLF_STATUS_CLOSED)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"A golf tournament is already open or in progress."), 1;

        g_GolfStatus = GOLF_STATUS_OPEN;
        g_GolfRound = 0;
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            g_GolfJoined[i] = false;
            g_GolfActive[i] = false;
            g_GolfStrokes[i] = 0;
            g_GolfFinishedHole[i] = false;
        }

        SCMToAll(COLOR_INFO, C_INFO"[Golf Tournament] "C_WHITE"Registration is now "C_INFO"OPEN"C_WHITE"! Type "C_INFO"/joingolf"C_WHITE" to participate.");
        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Golf tournament registration opened.");
        return 1;
    }

    // ---- /startgolf ----
    if(strcmp(cmd, "/startgolf", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < GOLF_ADMIN_LEVEL)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

        if(g_GolfStatus != GOLF_STATUS_OPEN)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The tournament must be opened first with "C_INFO"/opengolftournament"C_WHITE"."), 1;

        new joined = 0;
        for(new i = 0; i < MAX_PLAYERS; i++)
            if(g_GolfJoined[i]) joined++;

        if(joined < 1) // TODO: de schimbat limita de playeri la golf
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"At least 1 player must join before starting."), 1;

        g_GolfStatus = GOLF_STATUS_PROGRESS;
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            g_GolfActive[i] = g_GolfJoined[i];
            if(!g_GolfActive[i]) continue;

            SetPlayerHealth(i, 100.0);
            AC_GiveWeapon(i, GOLF_CLUB_WEAPON_ID, 1);
        }

        Golf_ShuffleHoleOrder();

        SCMToAll(COLOR_SUCCESS, C_SUCCESS"[Golf Tournament] "C_WHITE"Registrations closed. The tournament has started!");
        Golf_StartRound(1);

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Golf tournament started.");
        return 1;
    }

    // ---- /createdisease ----
    if(strcmp(cmd, "/createdisease", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 3)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 3."), 1;

        new Float:ax, Float:ay, Float:az;
        GetPlayerPos(playerid, ax, ay, az);

        // "/createdisease all" -> imbolnaveste TOT serverul, indiferent de distanta
        while(cmdtext[idx] == ' ') idx++;
        new bool:wholeServer = (strcmp(cmdtext[idx], "all", true) == 0);

        new infected = 0;
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
            if(PlayerData[i][pDiseased]) continue;
            if(!wholeServer && !IsPlayerInRangeOfPoint(i, DISEASE_RADIUS, ax, ay, az)) continue;

            Disease_Infect(i);
            infected++;
        }

        new dmsg[256];
        if(wholeServer)
            format(dmsg, sizeof(dmsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Infected "C_INFO"%d"C_WHITE" player(s) on the whole server."), infected);
        else
            format(dmsg, sizeof(dmsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Infected "C_INFO"%d"C_WHITE" player(s) within "C_INFO"%d m"C_WHITE". Use "C_INFO"/createdisease all"C_WHITE" for the whole server."),
                infected, floatround(DISEASE_RADIUS));
        SCM(playerid, COLOR_SUCCESS, dmsg);
        return 1;
    }

    // ---- /curedisease ----
    if(strcmp(cmd, "/curedisease", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(!PlayerData[playerid][pDiseased])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not sick."), 1;

        if(!Player_NearHospital(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the SMURD hospital."), 1;

        if(PlayerData[playerid][pMoney] < DISEASE_CURE_PRICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money."), 1;

        PlayerData[playerid][pMoney] -= DISEASE_CURE_PRICE;
        GivePlayerMoney(playerid, -DISEASE_CURE_PRICE);
        UpdatePlayer(playerid, pMoney);

        Faction_AddBank(FACTION_SMURD, DISEASE_CURE_PRICE);

        TogglePlayerControllable(playerid, 0);
        SetTimerEx("Disease_FinishCure", DISEASE_FREEZE_TIME, false, "i", playerid);

        SCM(playerid, COLOR_INFO,
            C_INFO"Info: "C_WHITE"Treatment in progress, please wait "C_INFO"10 seconds"C_WHITE"...");
        return 1;
    }

    // ---- /f [mesaj] (chat factiune) ----
    if(strcmp(cmd, "/f", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new fid = PlayerData[playerid][pFaction];
        if(fid < 1 || fid > MAX_FACTIONS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of a faction."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new text[128];
        strmid(text, cmdtext, idx, strlen(cmdtext), 128);

        if(!strlen(text))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/f [message]"C_WHITE"."), 1;

        new colorcode[9];
        GetFactionColorCode(fid, colorcode, sizeof(colorcode));

        new fmsg[256];
        format(fmsg, sizeof(fmsg), C_INFO"[fChat] "C_WHITE"%s%s "C_INFO"(rank %d)"C_WHITE": %s",
            colorcode, PlayerData[playerid][pName], PlayerData[playerid][pFactionRank], text);

        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pFaction] == fid)
                {
                    format(fmsg, sizeof(fmsg), T(i, C_INFO"[fChat] "C_WHITE"%s%s "C_INFO"(rank %d)"C_WHITE": %s"), colorcode, PlayerData[playerid][pName], PlayerData[playerid][pFactionRank], text);
                    SCM(i, COLOR_WHITE, fmsg);
                }
        }
        return 1;
    }

    // ---- /vipc [text] (VIP chat, difuzat tuturor membrilor VIP, indiferent de distanta) ----
    if(strcmp(cmd, "/vipc", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(!PlayerData[playerid][pVIP])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This command is for VIP members only."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new text[128];
        strmid(text, cmdtext, idx, strlen(cmdtext), 128);

        if(!strlen(text))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/vipc [message]"C_WHITE"."), 1;

        new vcmsg[192];
        format(vcmsg, sizeof(vcmsg), "{FFD700}[VIPChat] "C_WHITE"%s"C_INFO": %s", PlayerData[playerid][pName], text);

        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pVIP])
                {
                    format(vcmsg, sizeof(vcmsg), T(i, "{FFD700}[VIPChat] "C_WHITE"%s"C_INFO": %s"), PlayerData[playerid][pName], text);
                    SCM(i, COLOR_WHITE, vcmsg);
                }
        }
        return 1;
    }

    // ---- /ad [text] (reclama locala: trebuie sa fii la un punct de /ad; se difuzeaza doar in zona respectiva) ----
    if(strcmp(cmd, "/ad", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new adZone = AdZone_FindPlayerAtPoint(playerid);
        if(adZone == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at an /ad point (West/South/East LosSantos)."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new adText[144];
        strmid(adText, cmdtext, idx, strlen(cmdtext), 144);

        if(!strlen(adText))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/ad [text]"C_WHITE" ("C_INFO#AD_PRICE_PER_CHAR C_WHITE"$/character)."), 1;

        new adElapsed = GetTickCount() - g_AdZoneCooldown[adZone];
        if(g_AdZoneCooldown[adZone] != 0 && adElapsed < AD_COOLDOWN_MS)
        {
            new adWaitMsg[128];
            format(adWaitMsg, sizeof(adWaitMsg), T(playerid, C_ERROR"Error: "C_WHITE"This ad point is on cooldown. Wait "C_INFO"%d"C_WHITE" more second(s)."),
                (AD_COOLDOWN_MS - adElapsed + 999) / 1000);
            return SCM(playerid, COLOR_ERROR, adWaitMsg), 1;
        }

        new adCost = AD_PRICE_PER_CHAR * strlen(adText);
        if(PlayerData[playerid][pMoney] < adCost)
        {
            new adErr[128];
            format(adErr, sizeof(adErr), T(playerid, C_ERROR"Error: "C_WHITE"You need "C_INFO"$%s"C_WHITE" for this ad."), MoneyStr(adCost));
            return SCM(playerid, COLOR_ERROR, adErr), 1;
        }

        PlayerData[playerid][pMoney] -= adCost;
        GivePlayerMoney(playerid, -adCost);
        UpdatePlayer(playerid, pMoney);

        Faction_AddBank(AD_BANK_FACTION_ID, adCost * AD_FACTION_CUT_PCT / 100);

        g_AdZoneCooldown[adZone] = GetTickCount();

        new adPhone[24];
        if(Phone_HasPhone(playerid) && PlayerData[playerid][pPhoneNumber] > 0)
            format(adPhone, sizeof(adPhone), "%d", PlayerData[playerid][pPhoneNumber]);
        else
            format(adPhone, sizeof(adPhone), "no phone");

        new adMsg[256];
        format(adMsg, sizeof(adMsg), C_SUCCESS"[AD][%s] %s(%s): %s",
            AdZoneData[adZone][adZoneTag], PlayerData[playerid][pName], adPhone, adText);

        new Float:ax, Float:ay, Float:az;
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
            GetPlayerPos(i, ax, ay, az);
            if(ax >= AdZoneData[adZone][adMinX] && ax <= AdZoneData[adZone][adMaxX] &&
               ay >= AdZoneData[adZone][adMinY] && ay <= AdZoneData[adZone][adMaxY])
                SCM(i, COLOR_WHITE, adMsg);
        }

        new adConfirm[128];
        format(adConfirm, sizeof(adConfirm), T(playerid, C_SUCCESS"Success: "C_WHITE"Ad sent to "C_INFO"%s"C_WHITE" for "C_INFO"$%s"C_WHITE"."),
            AdZoneData[adZone][adZoneName], MoneyStr(adCost));
        SCM(playerid, COLOR_SUCCESS, adConfirm);
        return 1;
    }

    // ---- /rentbb sau /rentbillboard (chirie 24/48/72h, doar daca billboard-ul e liber si curat) ----
    if(strcmp(cmd, "/rentbb", true) == 0 || strcmp(cmd, "/rentbillboard", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new rbbIdx = Billboard_FindNearby(playerid);
        if(rbbIdx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at a billboard to do this."), 1;

        if(BillboardData[rbbIdx][bbRented])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This billboard is already rented."), 1;

        if(BillboardData[rbbIdx][bbClean] != 2)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This billboard isn't clean yet."), 1;

        g_RentBBIndex[playerid] = rbbIdx;

        new rbbDlg[256];
        format(rbbDlg, sizeof(rbbDlg), T(playerid, ""C_INFO"Option\t"C_INFO"Price\n"C_WHITE"Rent for 24 hours\t"C_SUCCESS"$%s\n"C_WHITE"Rent for 48 hours\t"C_SUCCESS"$%s\n"C_WHITE"Rent for 72 hours\t"C_SUCCESS"$%s"),
            MoneyStr(BillboardData[rbbIdx][bbRentPrice24H]), MoneyStr(BillboardData[rbbIdx][bbRentPrice24H] * 2), MoneyStr(BillboardData[rbbIdx][bbRentPrice24H] * 3));
        SPD(playerid, DIALOG_BILLBOARD_RENT, DIALOG_STYLE_TABLIST_HEADERS, "Rent Billboard", rbbDlg, "Rent", "Close");
        return 1;
    }

    // ---- /bbtext [text] (seteaza textul unui billboard, doar daca e rented) ----
    if(strcmp(cmd, "/bbtext", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new btIdx = Billboard_FindNearby(playerid);
        if(btIdx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at a billboard to do this."), 1;

        if(!BillboardData[btIdx][bbRented])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This billboard is not rented."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new btText[BILLBOARD_TEXT_LEN];
        strmid(btText, cmdtext, idx, strlen(cmdtext), BILLBOARD_TEXT_LEN);

        if(!strlen(btText))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bbtext [text]"C_WHITE"."), 1;

        if(!Billboard_TextValid(btText))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Text must be at most "C_INFO#BILLBOARD_MAX_CHARS C_WHITE" characters and contain at most "C_INFO#BILLBOARD_MAX_NEWLINES C_WHITE" line break(s) (\\n)."), 1;

        format(BillboardData[btIdx][bbText], BILLBOARD_TEXT_LEN, "%s", btText);
        Billboard_ConvertNewlines(BillboardData[btIdx][bbText]); // \n tastat -> linie noua reala
        Billboard_UpdateText(btIdx);
        Billboard_Save(btIdx);

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"Billboard text updated.");
        return 1;
    }

    // ---- /cleanbb (doar membri News: marcheaza un billboard dirty ca fiind in curs de curatare, si primeste recompensa) ----
    if(strcmp(cmd, "/cleanbb", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pFaction] != BILLBOARD_NEWS_FID)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be a News Reporter to do this."), 1;

        new cbIdx = Billboard_FindNearby(playerid);
        if(cbIdx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at a billboard to do this."), 1;

        if(BillboardData[cbIdx][bbClean] != 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This billboard doesn't need cleaning."), 1;

        new cbBbId = BillboardData[cbIdx][bbID];

        BillboardData[cbIdx][bbClean] = 1;
        Billboard_Save(cbIdx);
        Billboard_UpdateLabel(cbIdx);

        PlayerData[playerid][pMoney] += 500;
        GivePlayerMoney(playerid, 500);
        UpdatePlayer(playerid, pMoney);

        Faction_AddBank(BILLBOARD_NEWS_FID, 250);

        new cbmsg[144];
        format(cbmsg, sizeof(cbmsg), C_INFO"[N.R.] "C_WHITE"Reporter %s successfully cleaned billboard #%d.", PlayerData[playerid][pName], cbBbId);
        for(new p = 0; p < MAX_PLAYERS; p++)
            if(IsPlayerConnected(p) && PlayerData[p][pLogged] && PlayerData[p][pFaction] == BILLBOARD_NEWS_FID)
                {
                    format(cbmsg, sizeof(cbmsg), T(p, C_INFO"[N.R.] "C_WHITE"Reporter %s successfully cleaned billboard #%d."), PlayerData[playerid][pName], cbBbId);
                    SCM(p, COLOR_INFO, cbmsg);
                }

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"You cleaned up the billboard and earned "C_INFO"$500"C_WHITE".");
        return 1;
    }

    // ---- /buybillboard sau /buybb (cumpara billboard-ul de la tine, daca e la vanzare) ----
    if(strcmp(cmd, "/buybillboard", true) == 0 || strcmp(cmd, "/buybb", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pBBKey] != 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already own a billboard. Sell it first with "C_INFO"/bb sell"C_WHITE"."), 1;

        new bbbIdx = Billboard_FindNearby(playerid);
        if(bbbIdx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at a billboard to do this."), 1;

        if(!BillboardData[bbbIdx][bbIsForSale])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This billboard is not for sale."), 1;

        if(PlayerData[playerid][pMoney] < BillboardData[bbbIdx][bbPrice])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money."), 1;

        new bbbSellerId = BillboardData[bbbIdx][bbOwnerId]; // 0 = de la server

        PlayerData[playerid][pMoney] -= BillboardData[bbbIdx][bbPrice];
        GivePlayerMoney(playerid, -BillboardData[bbbIdx][bbPrice]);
        UpdatePlayer(playerid, pMoney);

        if(bbbSellerId != 0)
            Prop_SettleSeller(bbbSellerId, BillboardData[bbbIdx][bbPrice], "bb_key", pBBKey, "billboard");

        BillboardData[bbbIdx][bbOwnerId]   = PlayerData[playerid][pID];
        GetPlayerName(playerid, BillboardData[bbbIdx][bbOwner], 24);
        BillboardData[bbbIdx][bbIsForSale] = false;

        PlayerData[playerid][pBBKey] = BillboardData[bbbIdx][bbID];
        UpdatePlayer(playerid, pBBKey);

        Billboard_Save(bbbIdx);
        Billboard_UpdateLabel(bbbIdx);

        new bbbmsg[144];
        format(bbbmsg, sizeof(bbbmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You bought billboard "C_INFO"#%d"C_WHITE" for "C_INFO"$%s"C_WHITE"."),
            BillboardData[bbbIdx][bbID], MoneyStr(BillboardData[bbbIdx][bbPrice]));
        SCM(playerid, COLOR_SUCCESS, bbbmsg);
        return 1;
    }

    // ---- /bb [sell/sellto/selltostate] (gestionarea vanzarii billboard-ului detinut) ----
    if(strcmp(cmd, "/bb", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new bbsub[16], bbsubp = 0;
        while(cmdtext[idx] > ' ' && bbsubp < 15) { bbsub[bbsubp++] = cmdtext[idx]; idx++; }
        bbsub[bbsubp] = EOS;
        if(!strlen(bbsub))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bb sell [price]"C_WHITE", "C_INFO"/bb sellto [playerid] [amount]"C_WHITE" or "C_INFO"/bb selltostate"C_WHITE"."), 1;

        // ---- /bb sell [price] (pune billboard-ul la vanzare, sau 0 ca sa anulezi) ----
        if(strcmp(bbsub, "sell", true) == 0)
        {
            if(PlayerData[playerid][pBBKey] == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't own a billboard."), 1;

            new bbsIdx = -1;
            for(new i = 0; i < g_BillboardCount; i++)
                if(BillboardData[i][bbID] == PlayerData[playerid][pBBKey]) { bbsIdx = i; break; }
            if(bbsIdx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Billboard not found."), 1;

            while(cmdtext[idx] == ' ') idx++;
            new bbsPriceStr[16];
            strmid(bbsPriceStr, cmdtext, idx, strlen(cmdtext), 16);
            if(!strlen(bbsPriceStr))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bb sell [price]"C_WHITE" to list it for sale, or "C_INFO"/bb sell 0"C_WHITE" to cancel."), 1;

            new bbsPrice = strval(bbsPriceStr);
            if(bbsPrice <= 0)
            {
                BillboardData[bbsIdx][bbIsForSale] = false;
                Billboard_Save(bbsIdx);
                Billboard_UpdateLabel(bbsIdx);
                return SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"Your billboard is no longer for sale."), 1;
            }

            BillboardData[bbsIdx][bbIsForSale] = true;
            BillboardData[bbsIdx][bbPrice]     = bbsPrice;
            Billboard_Save(bbsIdx);
            Billboard_UpdateLabel(bbsIdx);

            new bbslmsg[160];
            format(bbslmsg, sizeof(bbslmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"Your billboard is now for sale for "C_INFO"$%s"C_WHITE". Another player can buy it with "C_INFO"/buybillboard"C_WHITE"."),
                MoneyStr(bbsPrice));
            SCM(playerid, COLOR_SUCCESS, bbslmsg);
            return 1;
        }

        // ---- /bb selltostate (vinde billboard-ul la stat, 60%) ----
        if(strcmp(bbsub, "selltostate", true) == 0)
        {
            if(PlayerData[playerid][pBBKey] == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't own a billboard."), 1;

            new bbstIdx = -1;
            for(new i = 0; i < g_BillboardCount; i++)
                if(BillboardData[i][bbID] == PlayerData[playerid][pBBKey]) { bbstIdx = i; break; }
            if(bbstIdx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Billboard not found."), 1;

            new bbstPrice = BillboardData[bbstIdx][bbPrice] * 60 / 100; // vanzare la stat: 60% din valoare
            PlayerData[playerid][pMoney] += bbstPrice;
            GivePlayerMoney(playerid, bbstPrice);
            UpdatePlayer(playerid, pMoney);
            PlayerData[playerid][pBBKey] = 0;
            UpdatePlayer(playerid, pBBKey);

            BillboardData[bbstIdx][bbOwnerId]   = 0;
            BillboardData[bbstIdx][bbOwner][0]  = EOS;
            BillboardData[bbstIdx][bbIsForSale] = true; // inapoi la stat = cumparabila din nou

            Billboard_Save(bbstIdx);
            Billboard_UpdateLabel(bbstIdx);

            new bbstmsg[144];
            format(bbstmsg, sizeof(bbstmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You sold billboard "C_INFO"#%d"C_WHITE" to the state for "C_INFO"$%s"C_WHITE" (60%%)."),
                BillboardData[bbstIdx][bbID], MoneyStr(bbstPrice));
            SCM(playerid, COLOR_SUCCESS, bbstmsg);
            return 1;
        }

        // ---- /bb sellto [playerid] [amount] (oferta directa catre un player, confirmata cu /accept billboard) ----
        if(strcmp(bbsub, "sellto", true) == 0)
        {
            if(PlayerData[playerid][pBBKey] == 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't own a billboard."), 1;

            new bbstoIdx = -1;
            for(new i = 0; i < g_BillboardCount; i++)
                if(BillboardData[i][bbID] == PlayerData[playerid][pBBKey]) { bbstoIdx = i; break; }
            if(bbstoIdx == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Billboard not found."), 1;

            while(cmdtext[idx] == ' ') idx++;
            new bbstoPStr[8], bbstoPPos = 0;
            while(cmdtext[idx] > ' ' && bbstoPPos < 7) { bbstoPStr[bbstoPPos++] = cmdtext[idx]; idx++; }
            bbstoPStr[bbstoPPos] = EOS;
            while(cmdtext[idx] == ' ') idx++;
            new bbstoAStr[12];
            strmid(bbstoAStr, cmdtext, idx, strlen(cmdtext), 12);
            if(!strlen(bbstoPStr) || !strlen(bbstoAStr))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bb sellto [playerid] [amount]"C_WHITE"."), 1;

            new bbstoTarget = strval(bbstoPStr), bbstoAmount = strval(bbstoAStr);
            if(!IsPlayerConnected(bbstoTarget) || !PlayerData[bbstoTarget][pLogged])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid player."), 1;
            if(bbstoTarget == playerid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't sell to yourself."), 1;
            if(bbstoAmount <= 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid amount."), 1;

            g_BBOfferSeller[bbstoTarget] = playerid;
            g_BBOfferBbId[bbstoTarget]   = BillboardData[bbstoIdx][bbID];
            g_BBOfferAmount[bbstoTarget] = bbstoAmount;

            new bbstomsg[160];
            format(bbstomsg, sizeof(bbstomsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You offered your billboard (ID: "C_INFO"%d"C_WHITE") to "C_INFO"%s"C_WHITE" for "C_INFO"$%s"C_WHITE"."),
                BillboardData[bbstoIdx][bbID], PlayerData[bbstoTarget][pName], MoneyStr(bbstoAmount));
            SCM(playerid, COLOR_SUCCESS, bbstomsg);
            format(bbstomsg, sizeof(bbstomsg), T(bbstoTarget, "[Billboard] %s wants to sell you their billboard (ID: %d) for $%s. Use /accept billboard %d to buy it."),
                PlayerData[playerid][pName], BillboardData[bbstoIdx][bbID], MoneyStr(bbstoAmount), playerid);
            SCM(bbstoTarget, COLOR_INFO, bbstomsg);
            return 1;
        }

        SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bb sell [price]"C_WHITE", "C_INFO"/bb sellto [playerid] [amount]"C_WHITE" or "C_INFO"/bb selltostate"C_WHITE".");
        return 1;
    }

    // ---- /setrentprice [new_value] (doar daca detii un billboard: seteaza direct bbRentPrice24H) ----
    if(strcmp(cmd, "/setrentprice", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pBBKey] == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't own a billboard."), 1;

        new srpIdx = -1;
        for(new i = 0; i < g_BillboardCount; i++)
            if(BillboardData[i][bbID] == PlayerData[playerid][pBBKey]) { srpIdx = i; break; }
        if(srpIdx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Billboard not found."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new srpStr[16];
        strmid(srpStr, cmdtext, idx, strlen(cmdtext), 16);
        if(!strlen(srpStr))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/setrentprice [new_value]"C_WHITE"."), 1;

        new srpVal = strval(srpStr);
        if(srpVal <= 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid price."), 1;

        BillboardData[srpIdx][bbRentPrice24H] = srpVal;
        Billboard_Save(srpIdx);
        Billboard_UpdateLabel(srpIdx);

        new srpmsg[144];
        format(srpmsg, sizeof(srpmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"Your billboard's 24h rent price is now "C_INFO"$%s"C_WHITE"."), MoneyStr(srpVal));
        SCM(playerid, COLOR_SUCCESS, srpmsg);
        return 1;
    }

    // ---- /billboardcreate (admin 6+: creeaza un billboard nou la pozitia curenta) ----
    if(strcmp(cmd, "/billboardcreate", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 6)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 6."), 1;

        if(g_BillboardCount >= MAX_BILLBOARDS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Billboard limit reached."), 1;

        new Float:bcx, Float:bcy, Float:bcz;
        GetPlayerPos(playerid, bcx, bcy, bcz);

        new bcq[320];
        mysql_format(g_SQL, bcq, sizeof(bcq),
            "INSERT INTO `billboards` (`bbLocX`,`bbLocY`,`bbLocZ`,`bbObjectPosX`,`bbObjectPosY`,`bbObjectPosZ`) VALUES (%.4f,%.4f,%.4f,%.4f,%.4f,%.4f)",
            bcx, bcy, bcz, bcx, bcy, bcz);
        mysql_tquery(g_SQL, bcq, "", "", 0);
        Billboards_Load(); // reincarca (SELECT ruleaza dupa INSERT pe aceeasi conexiune)

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Billboard created at your position.");
        return 1;
    }

    // ---- /bbc [id] [loc/objloc] (admin 6+: repozitioneaza punctul de interactiune sau obiectul fizic) ----
    if(strcmp(cmd, "/bbc", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 6)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 6."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new bccIdStr[8], bccIdPos = 0;
        while(cmdtext[idx] > ' ' && bccIdPos < 7) { bccIdStr[bccIdPos++] = cmdtext[idx]; idx++; }
        bccIdStr[bccIdPos] = EOS;

        while(cmdtext[idx] == ' ') idx++;
        new bccOpt[16], bccOptPos = 0;
        while(cmdtext[idx] > ' ' && bccOptPos < 15) { bccOpt[bccOptPos++] = cmdtext[idx]; idx++; }
        bccOpt[bccOptPos] = EOS;

        if(!strlen(bccIdStr) || !strlen(bccOpt))
            return SCM(playerid, COLOR_INFO, "Info: Use /bbc [id] [loc/objloc/objid/objx/objy/objz/objrx/objry/objrz/text/rented/textcolor/bkgcolor/fontsize/rentleft/rentprice/clean]."), 1;

        new bccId = strval(bccIdStr);
        new bccIdx = -1;
        for(new i = 0; i < g_BillboardCount; i++)
            if(BillboardData[i][bbID] == bccId) { bccIdx = i; break; }

        if(bccIdx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Unknown billboard ID."), 1;

        // ---- /bbc [id] text [text] ----
        if(strcmp(bccOpt, "text", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new bccText[BILLBOARD_TEXT_LEN];
            strmid(bccText, cmdtext, idx, strlen(cmdtext), BILLBOARD_TEXT_LEN);

            if(!strlen(bccText))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bbc [id] text [text]"C_WHITE"."), 1;

            if(!Billboard_TextValid(bccText))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Text must be at most "C_INFO#BILLBOARD_MAX_CHARS C_WHITE" characters and contain at most "C_INFO#BILLBOARD_MAX_NEWLINES C_WHITE" line break(s) (\\n)."), 1;

            format(BillboardData[bccIdx][bbText], BILLBOARD_TEXT_LEN, "%s", bccText);
            Billboard_ConvertNewlines(BillboardData[bccIdx][bbText]); // \n tastat -> linie noua reala
            Billboard_UpdateText(bccIdx);
            Billboard_Save(bccIdx);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Billboard text updated.");
            return 1;
        }

        // ---- /bbc [id] rented [0/1] ----
        if(strcmp(bccOpt, "rented", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new bccVal[8];
            strmid(bccVal, cmdtext, idx, strlen(cmdtext), 8);
            if(!strlen(bccVal))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bbc [id] rented [0/1]"C_WHITE"."), 1;

            BillboardData[bccIdx][bbRented] = bool:strval(bccVal);
            Billboard_Save(bccIdx);
            Billboard_UpdateLabel(bccIdx);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Billboard rented flag updated.");
            return 1;
        }

        // ---- /bbc [id] textcolor [#RRGGBB / decimal] ----
        if(strcmp(bccOpt, "textcolor", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new bccVal[16];
            strmid(bccVal, cmdtext, idx, strlen(cmdtext), 16);
            if(!strlen(bccVal))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bbc [id] textcolor [#RRGGBB or decimal]"C_WHITE"."), 1;

            BillboardData[bccIdx][bbTextColor] = Billboard_ParseColor(bccVal);
            Billboard_UpdateText(bccIdx);
            Billboard_Save(bccIdx);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Billboard text color updated.");
            return 1;
        }

        // ---- /bbc [id] bkgcolor [#RRGGBB / decimal] ----
        if(strcmp(bccOpt, "bkgcolor", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new bccVal[16];
            strmid(bccVal, cmdtext, idx, strlen(cmdtext), 16);
            if(!strlen(bccVal))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bbc [id] bkgcolor [#RRGGBB or decimal]"C_WHITE"."), 1;

            BillboardData[bccIdx][bbTextBackground] = Billboard_ParseColor(bccVal);
            Billboard_UpdateText(bccIdx);
            Billboard_Save(bccIdx);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Billboard text background updated.");
            return 1;
        }

        // ---- /bbc [id] fontsize [value] ----
        if(strcmp(bccOpt, "fontsize", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new bccVal[8];
            strmid(bccVal, cmdtext, idx, strlen(cmdtext), 8);
            if(!strlen(bccVal))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bbc [id] fontsize [value]"C_WHITE"."), 1;

            BillboardData[bccIdx][bbFontSize] = max(1, strval(bccVal));
            Billboard_UpdateText(bccIdx);
            Billboard_Save(bccIdx);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Billboard font size updated.");
            return 1;
        }

        // ---- /bbc [id] rentleft [payday-uri] ----
        if(strcmp(bccOpt, "rentleft", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new bccVal[8];
            strmid(bccVal, cmdtext, idx, strlen(cmdtext), 8);
            if(!strlen(bccVal))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bbc [id] rentleft [paydays]"C_WHITE"."), 1;

            BillboardData[bccIdx][bbRentLeft] = max(0, strval(bccVal));
            Billboard_Save(bccIdx);
            Billboard_UpdateLabel(bccIdx);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Billboard rent-left updated.");
            return 1;
        }

        // ---- /bbc [id] rentprice [price per 24h] ----
        if(strcmp(bccOpt, "rentprice", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new bccVal[16];
            strmid(bccVal, cmdtext, idx, strlen(cmdtext), 16);
            if(!strlen(bccVal))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bbc [id] rentprice [price]"C_WHITE"."), 1;

            BillboardData[bccIdx][bbRentPrice24H] = max(0, strval(bccVal));
            Billboard_Save(bccIdx);
            Billboard_UpdateLabel(bccIdx);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Billboard rent price updated.");
            return 1;
        }

        // ---- /bbc [id] clean [-1/0/1/2] ----
        if(strcmp(bccOpt, "clean", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new bccVal[8];
            strmid(bccVal, cmdtext, idx, strlen(cmdtext), 8);
            if(!strlen(bccVal))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bbc [id] clean [-1/0/1/2]"C_WHITE"."), 1;

            BillboardData[bccIdx][bbClean] = strval(bccVal);
            Billboard_Save(bccIdx);
            Billboard_UpdateLabel(bccIdx);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Billboard clean status updated.");
            return 1;
        }

        new Float:bccx, Float:bccy, Float:bccz;
        GetPlayerPos(playerid, bccx, bccy, bccz);

        if(strcmp(bccOpt, "loc", true) == 0)
        {
            BillboardData[bccIdx][bbLocX] = bccx;
            BillboardData[bccIdx][bbLocY] = bccy;
            BillboardData[bccIdx][bbLocZ] = bccz;

            new bcq2[192];
            mysql_format(g_SQL, bcq2, sizeof(bcq2),
                "UPDATE `billboards` SET `bbLocX`=%.4f, `bbLocY`=%.4f, `bbLocZ`=%.4f WHERE `bbID`=%d",
                bccx, bccy, bccz, bccId);
            mysql_tquery(g_SQL, bcq2, "", "", 0);
            Billboard_CreatePickup(bccIdx);
            Billboard_UpdateLabel(bccIdx);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Billboard interaction point moved to your location.");
            return 1;
        }

        if(strcmp(bccOpt, "objloc", true) == 0)
        {
            BillboardData[bccIdx][bbObjectPosX] = bccx;
            BillboardData[bccIdx][bbObjectPosY] = bccy;
            BillboardData[bccIdx][bbObjectPosZ] = bccz;
            Billboard_Create(bccIdx);

            new bcq3[192];
            mysql_format(g_SQL, bcq3, sizeof(bcq3),
                "UPDATE `billboards` SET `bbObjectPosX`=%.4f, `bbObjectPosY`=%.4f, `bbObjectPosZ`=%.4f WHERE `bbID`=%d",
                bccx, bccy, bccz, bccId);
            mysql_tquery(g_SQL, bcq3, "", "", 0);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Billboard object moved to your location.");
            return 1;
        }

        // ---- /bbc [id] objid [model_id] (schimba modelul obiectului fizic) ----
        if(strcmp(bccOpt, "objid", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new bccObjIdStr[8];
            strmid(bccObjIdStr, cmdtext, idx, strlen(cmdtext), 8);

            if(!strlen(bccObjIdStr))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bbc [id] objid [model_id]"C_WHITE"."), 1;

            BillboardData[bccIdx][bbObjectId] = strval(bccObjIdStr);
            Billboard_Create(bccIdx); // modelul s-a schimbat -> obiectul trebuie recreat
            Billboard_Save(bccIdx);

            new bccOidMsg[128];
            format(bccOidMsg, sizeof(bccOidMsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Billboard #%d object model set to "C_INFO"%d"C_WHITE"."), bccId, BillboardData[bccIdx][bbObjectId]);
            SCM(playerid, COLOR_SUCCESS, bccOidMsg);
            return 1;
        }

        // ---- /bbc [id] [objx/objy/objz/objrx/objry/objrz] [value] (ajustare cumulativa: veche valoare + value) ----
        if(strcmp(bccOpt, "objx", true) == 0 || strcmp(bccOpt, "objy", true) == 0 || strcmp(bccOpt, "objz", true) == 0 ||
           strcmp(bccOpt, "objrx", true) == 0 || strcmp(bccOpt, "objry", true) == 0 || strcmp(bccOpt, "objrz", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new bccValStr[16];
            strmid(bccValStr, cmdtext, idx, strlen(cmdtext), 16);

            if(!strlen(bccValStr))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/bbc [id] [objx/objy/objz/objrx/objry/objrz] [value]"C_WHITE"."), 1;

            new Float:bccAdjVal = floatstr(bccValStr);
            new Float:bccOld, Float:bccNew;
            new bccAxisName[8];

            if(strcmp(bccOpt, "objx", true) == 0)         { bccOld = BillboardData[bccIdx][bbObjectPosX];  BillboardData[bccIdx][bbObjectPosX]  += bccAdjVal; bccNew = BillboardData[bccIdx][bbObjectPosX];  format(bccAxisName, sizeof(bccAxisName), "X"); }
            else if(strcmp(bccOpt, "objy", true) == 0)    { bccOld = BillboardData[bccIdx][bbObjectPosY];  BillboardData[bccIdx][bbObjectPosY]  += bccAdjVal; bccNew = BillboardData[bccIdx][bbObjectPosY];  format(bccAxisName, sizeof(bccAxisName), "Y"); }
            else if(strcmp(bccOpt, "objz", true) == 0)    { bccOld = BillboardData[bccIdx][bbObjectPosZ];  BillboardData[bccIdx][bbObjectPosZ]  += bccAdjVal; bccNew = BillboardData[bccIdx][bbObjectPosZ];  format(bccAxisName, sizeof(bccAxisName), "Z"); }
            else if(strcmp(bccOpt, "objrx", true) == 0)   { bccOld = BillboardData[bccIdx][bbObjectPosRX]; BillboardData[bccIdx][bbObjectPosRX] += bccAdjVal; bccNew = BillboardData[bccIdx][bbObjectPosRX]; format(bccAxisName, sizeof(bccAxisName), "RX"); }
            else if(strcmp(bccOpt, "objry", true) == 0)   { bccOld = BillboardData[bccIdx][bbObjectPosRY]; BillboardData[bccIdx][bbObjectPosRY] += bccAdjVal; bccNew = BillboardData[bccIdx][bbObjectPosRY]; format(bccAxisName, sizeof(bccAxisName), "RY"); }
            else                                           { bccOld = BillboardData[bccIdx][bbObjectPosRZ]; BillboardData[bccIdx][bbObjectPosRZ] += bccAdjVal; bccNew = BillboardData[bccIdx][bbObjectPosRZ]; format(bccAxisName, sizeof(bccAxisName), "RZ"); }

            Billboard_Create(bccIdx);
            Billboard_Save(bccIdx);

            new bccAdjMsg[160];
            format(bccAdjMsg, sizeof(bccAdjMsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Billboard #%d %s: "C_INFO"%.4f "C_WHITE"-> "C_INFO"%.4f"C_WHITE"."),
                bccId, bccAxisName, bccOld, bccNew);
            SCM(playerid, COLOR_SUCCESS, bccAdjMsg);
            return 1;
        }

        SCM(playerid, COLOR_INFO, "Info: Use /bbc [id] [loc/objloc/objid/objx/objy/objz/objrx/objry/objrz/text/rented/textcolor/bkgcolor/fontsize/rentleft/rentprice/clean].");
        return 1;
    }

    // ---- /viphat [black/red/green/farmer/witch/off] (doar VIP: ataseaza o palarie pe cap) ----
    if(strcmp(cmd, "/viphat", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(!PlayerData[playerid][pVIP])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This command is for VIP members only."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new hname[16];
        strmid(hname, cmdtext, idx, strlen(cmdtext), 16);

        if(!strlen(hname))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/viphat [black/red/green/farmer/witch/off]"C_WHITE"."), 1;

        if(strcmp(hname, "off", true) == 0)
        {
            if(!g_VipHatOn[playerid])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You're not wearing a VIP hat."), 1;

            RemovePlayerAttachedObject(playerid, VIPHAT_ATTACH_INDEX);
            g_VipHatOn[playerid]    = false;
            g_VipHatModel[playerid] = 0;
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"Hat removed.");
            return 1;
        }

        if(!VipHat_LocationAllowed(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can only do this at a house, hotel, faction HQ, or a clothing store."), 1;

        new hatModel = 0;
        if(strcmp(hname, "black", true) == 0)       hatModel = VIPHAT_BLACK;
        else if(strcmp(hname, "red", true) == 0)    hatModel = VIPHAT_RED;
        else if(strcmp(hname, "green", true) == 0)  hatModel = VIPHAT_GREEN;
        else if(strcmp(hname, "farmer", true) == 0) hatModel = VIPHAT_FARMER;
        else if(strcmp(hname, "witch", true) == 0)  hatModel = VIPHAT_WITCH;

        if(hatModel == 0)
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/viphat [black/red/green/farmer/witch/off]"C_WHITE"."), 1;

        SetPlayerAttachedObject(playerid, VIPHAT_ATTACH_INDEX, hatModel, VIPHAT_ATTACH_BONE,
            g_VipHatOffX, g_VipHatOffY, g_VipHatOffZ, 0.0, 0.0, 0.0, 1.0, 1.0, 1.0);
        g_VipHatOn[playerid]    = true;
        g_VipHatModel[playerid] = hatModel;

        new hmsg[96];
        format(hmsg, sizeof(hmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You're now wearing the "C_INFO"%s"C_WHITE" VIP hat."), hname);
        SCM(playerid, COLOR_SUCCESS, hmsg);
        return 1;
    }


    // ---- /news [text] (News Reporters rank 1+, difuzat tuturor) ----
    if(strcmp(cmd, "/news", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pFaction] != NEWS_FACTION_ID)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only News Reporters can use this."), 1;
        if(PlayerData[playerid][pFactionRank] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires faction rank 1+."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new ntext[144];
        strmid(ntext, cmdtext, idx, strlen(cmdtext), 144);
        if(!strlen(ntext))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/news [text]"C_WHITE"."), 1;

        new nmsg[256];
        format(nmsg, sizeof(nmsg), C_WHITE"[{FFFF00}NEWS"C_WHITE"] %s: {FFFF00}%s", PlayerData[playerid][pName], ntext);
        for(new i = 0; i < MAX_PLAYERS; i++)
            if(IsPlayerConnected(i) && PlayerData[i][pLogged])
                {
                    format(nmsg, sizeof(nmsg), T(i, C_WHITE"[{FFFF00}NEWS"C_WHITE"] %s: {FFFF00}%s"), PlayerData[playerid][pName], ntext);
                    SCM(i, COLOR_WHITE, nmsg);
                }
        return 1;
    }

    // ---- /newspaper [create/edit/sell/open] ----
    if(strcmp(cmd, "/newspaper", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new nsub[12], nsp = 0;
        while(cmdtext[idx] > ' ' && nsp < 11) { nsub[nsp++] = cmdtext[idx]; idx++; }
        nsub[nsp] = EOS;
        if(!strlen(nsub))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/newspaper [create/edit/sell/open]"C_WHITE"."), 1;

        new bool:isReporter = (PlayerData[playerid][pFaction] == NEWS_FACTION_ID);

        // ---- /newspaper open (cumparatori sau reporterul care si-a facut ziarul) ----
        if(strcmp(nsub, "open", true) == 0)
        {
            new bool:showOwn = false;
            if(g_HasNewspaper[playerid]) showOwn = false;
            else if(isReporter && g_NewspaperCreated[playerid]) showOwn = true;
            else return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a newspaper."), 1;

            new authorName[24];
            if(showOwn) format(authorName, sizeof(authorName), "%s", PlayerData[playerid][pName]);
            else        format(authorName, sizeof(authorName), "%s", g_OwnedNewsAuthor[playerid]);

            new dlg[1024], nline[NEWS_ITEM_LEN + 32], any = 0;
            format(dlg, sizeof(dlg), T(playerid, C_INFO"News Reporters"C_WHITE" - published by "C_INFO"%s"C_WHITE"\n\n\n\n"), authorName);
            for(new n = 0; n < NEWS_MAX_ITEMS; n++)
            {
                new bool:empty;
                if(showOwn) empty = (g_NewspaperItem[playerid][n][0] == EOS);
                else        empty = (g_OwnedNewsItem[playerid][n][0] == EOS);
                if(empty) continue;

                if(showOwn) format(nline, sizeof(nline), "%d) %s\n\n\n\n", n + 1, g_NewspaperItem[playerid][n]);
                else        format(nline, sizeof(nline), "%d) %s\n\n\n\n", n + 1, g_OwnedNewsItem[playerid][n]);
                strcat(dlg, nline);
                any++;
            }
            if(!any) strcat(dlg, T(playerid, C_WHITE"(This newspaper has no news yet.)"));

            SPD(playerid, DIALOG_NEWSPAPER, DIALOG_STYLE_MSGBOX, "Newspaper", dlg, "Close", "");
            return 1;
        }

        // ---- restul necesita reporter rank 2+ ----
        if(!isReporter)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only News Reporters can use this."), 1;
        if(PlayerData[playerid][pFactionRank] < 2)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires faction rank 2+."), 1;

        // ---- /newspaper create ----
        if(strcmp(nsub, "create", true) == 0)
        {
            g_NewspaperCreated[playerid] = true;
            for(new n = 0; n < NEWS_MAX_ITEMS; n++) g_NewspaperItem[playerid][n][0] = EOS;
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"New newspaper created. Add news with "C_INFO"/newspaper edit [1-5] [text]"C_WHITE".");
            return 1;
        }

        // ---- /newspaper edit [1-5] [text] ----
        if(strcmp(nsub, "edit", true) == 0)
        {
            if(!g_NewspaperCreated[playerid])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Create a newspaper first ("C_INFO"/newspaper create"C_WHITE")."), 1;

            while(cmdtext[idx] == ' ') idx++;
            new slotStr[4], ssp = 0;
            while(cmdtext[idx] > ' ' && ssp < 3) { slotStr[ssp++] = cmdtext[idx]; idx++; }
            slotStr[ssp] = EOS;
            new slot = strval(slotStr);
            if(slot < 1 || slot > NEWS_MAX_ITEMS)
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/newspaper edit [1-5] [text]"C_WHITE"."), 1;

            while(cmdtext[idx] == ' ') idx++;
            new etext[NEWS_ITEM_LEN];
            strmid(etext, cmdtext, idx, strlen(cmdtext), NEWS_ITEM_LEN);
            if(!strlen(etext))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/newspaper edit [1-5] [text]"C_WHITE"."), 1;

            format(g_NewspaperItem[playerid][slot - 1], NEWS_ITEM_LEN, "%s", etext);

            new emsg[96];
            format(emsg, sizeof(emsg), T(playerid, C_SUCCESS"Success: "C_WHITE"News "C_INFO"#%d"C_WHITE" updated."), slot);
            SCM(playerid, COLOR_SUCCESS, emsg);
            return 1;
        }

        // ---- /newspaper sell [playerid] [amount] ----
        if(strcmp(nsub, "sell", true) == 0)
        {
            if(!g_NewspaperCreated[playerid])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Create a newspaper first ("C_INFO"/newspaper create"C_WHITE")."), 1;

            while(cmdtext[idx] == ' ') idx++;
            new tStr[8], tsp = 0;
            while(cmdtext[idx] > ' ' && tsp < 7) { tStr[tsp++] = cmdtext[idx]; idx++; }
            tStr[tsp] = EOS;
            while(cmdtext[idx] == ' ') idx++;
            new aStr[12];
            strmid(aStr, cmdtext, idx, strlen(cmdtext), 12);
            if(!strlen(tStr) || !strlen(aStr))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/newspaper sell [playerid] [amount]"C_WHITE"."), 1;

            new targetid = strval(tStr), amount = strval(aStr);
            if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid player."), 1;
            if(targetid == playerid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't sell to yourself."), 1;
            if(amount <= 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid amount."), 1;

            g_NewsOfferSeller[targetid] = playerid;
            g_NewsOfferAmount[targetid] = amount;

            new smsg[256];
            format(smsg, sizeof(smsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You offered your newspaper to "C_INFO"%s"C_WHITE" for "C_INFO"$%s"C_WHITE"."),
                PlayerData[targetid][pName], MoneyStr(amount));
            SCM(playerid, COLOR_SUCCESS, smsg);
            format(smsg, sizeof(smsg), T(targetid, C_INFO"[NEWS] "C_WHITE"%s"C_WHITE" offers you a newspaper for "C_INFO"$%s"C_WHITE". Type "C_INFO"/accept newspaper %d"C_WHITE" to buy."),
                PlayerData[playerid][pName], MoneyStr(amount), playerid);
            SCM(targetid, COLOR_WHITE, smsg);
            return 1;
        }

        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/newspaper [create/edit/sell/open]"C_WHITE"."), 1;
    }

    // ---- /qa [playerid] | [list/ask/del/end] (reporter rank 3, live Q&A) ----
    if(strcmp(cmd, "/qa", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pFaction] != NEWS_FACTION_ID)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only News Reporters can use this."), 1;
        if(PlayerData[playerid][pFactionRank] < 3)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires faction rank 3+."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new qsub[10], qsp = 0;
        while(cmdtext[idx] > ' ' && qsp < 9) { qsub[qsp++] = cmdtext[idx]; idx++; }
        qsub[qsp] = EOS;
        if(!strlen(qsub))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/qa [playerid]"C_WHITE" to start, or "C_INFO"/qa [list/ask/del/end]"C_WHITE"."), 1;

        // ---- /qa list ----
        if(strcmp(qsub, "list", true) == 0)
        {
            if(!g_QAActive || g_QAReporter != playerid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not hosting a Q&A."), 1;

            static qdlg[6144];
            qdlg[0] = EOS;
            if(g_QACount == 0)
            {
                strcat(qdlg, T(playerid, C_WHITE"(No questions submitted yet.)"));
            }
            else
            {
                new qline[QA_Q_LEN + 48];
                for(new i = 0; i < g_QACount; i++)
                {
                    format(qline, sizeof(qline), ""C_INFO"%d."C_WHITE" [%s] %s\n", i + 1, g_QAAskerName[i], g_QAQuestion[i]);
                    strcat(qdlg, qline);
                }
            }
            SPD(playerid, DIALOG_QA_LIST, DIALOG_STYLE_MSGBOX, "Q&A - Questions", qdlg, "Close", "");
            return 1;
        }

        // ---- /qa ask [nr] ----
        if(strcmp(qsub, "ask", true) == 0)
        {
            if(!g_QAActive || g_QAReporter != playerid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not hosting a Q&A."), 1;

            while(cmdtext[idx] == ' ') idx++;
            new nStr[6];
            strmid(nStr, cmdtext, idx, strlen(cmdtext), 6);
            new nr = strval(nStr);
            if(nr < 1 || nr > g_QACount)
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/qa ask [nr]"C_WHITE" (see "C_INFO"/qa list"C_WHITE")."), 1;

            new qi = nr - 1;
            new qmsg[256];
            format(qmsg, sizeof(qmsg), "{85648C}[Q&A] "C_WHITE"Question from "C_INFO"%s"C_WHITE": %s", g_QAAskerName[qi], g_QAQuestion[qi]);
            QA_Broadcast(qmsg);

            if(g_QAGuest != INVALID_PLAYER_ID && IsPlayerConnected(g_QAGuest))
                SCM(g_QAGuest, COLOR_INFO, C_INFO"[Q&A] "C_WHITE"Answer with "C_INFO"/answer [text]"C_WHITE".");

            QA_RemoveQuestion(qi);
            return 1;
        }

        // ---- /qa del [nr] ----
        if(strcmp(qsub, "del", true) == 0)
        {
            if(!g_QAActive || g_QAReporter != playerid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not hosting a Q&A."), 1;

            while(cmdtext[idx] == ' ') idx++;
            new nStr[6];
            strmid(nStr, cmdtext, idx, strlen(cmdtext), 6);
            new nr = strval(nStr);
            if(nr < 1 || nr > g_QACount)
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/qa del [nr]"C_WHITE" (see "C_INFO"/qa list"C_WHITE")."), 1;

            QA_RemoveQuestion(nr - 1);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"Question removed.");
            return 1;
        }

        // ---- /qa end ----
        if(strcmp(qsub, "end", true) == 0)
        {
            if(!g_QAActive || g_QAReporter != playerid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not hosting a Q&A."), 1;

            new emsg[128];
            format(emsg, sizeof(emsg), "{85648C}[Q&A] "C_WHITE"The live Q&A hosted by "C_INFO"%s"C_WHITE" has ended.", PlayerData[playerid][pName]);
            QA_Broadcast(emsg);
            QA_Reset();
            return 1;
        }

        // ---- altfel: qsub e un playerid -> porneste o sesiune (trimite invitatie) ----
        if(g_QAActive || g_QAPendingReporter != INVALID_PLAYER_ID)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"A Q&A session is already active or pending."), 1;

        new guest = strval(qsub);
        if(!IsPlayerConnected(guest) || !PlayerData[guest][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid player."), 1;
        if(guest == playerid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't interview yourself."), 1;

        g_QAPendingReporter = playerid;
        g_QAPendingGuest    = guest;

        new imsg[176];
        format(imsg, sizeof(imsg), T(playerid, C_SUCCESS"Success: "C_WHITE"Q&A invite sent to "C_INFO"%s"C_WHITE". Waiting for them to accept."), PlayerData[guest][pName]);
        SCM(playerid, COLOR_SUCCESS, imsg);
        format(imsg, sizeof(imsg), T(guest, "{85648C}[Q&A] "C_WHITE"%s"C_WHITE" invites you to a live Q&A. Type "C_INFO"/accept qa %d"C_WHITE" to accept."), PlayerData[playerid][pName], playerid);
        SCM(guest, COLOR_WHITE, imsg);
        return 1;
    }

    // ---- /question [text] (orice jucator, in timpul unui Q&A activ) ----
    if(strcmp(cmd, "/question", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(!g_QAActive)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"There is no active Q&A right now."), 1;
        if(playerid == g_QAReporter || playerid == g_QAGuest)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't submit questions in your own Q&A."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new qtext[QA_Q_LEN];
        strmid(qtext, cmdtext, idx, strlen(cmdtext), QA_Q_LEN);
        if(!strlen(qtext))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/question [text]"C_WHITE"."), 1;

        if(g_QACount >= QA_MAX_QUESTIONS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The question queue is full. Try again later."), 1;

        format(g_QAQuestion[g_QACount], QA_Q_LEN, "%s", qtext);
        format(g_QAAskerName[g_QACount], 24, "%s", PlayerData[playerid][pName]);
        g_QACount++;

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"Your question was submitted to the reporter.");
        return 1;
    }

    // ---- /answer [text] (doar invitatul, in timpul unui Q&A activ) ----
    if(strcmp(cmd, "/answer", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(!g_QAActive || playerid != g_QAGuest)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not the guest of an active Q&A."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new atext[176];
        strmid(atext, cmdtext, idx, strlen(cmdtext), 176);
        if(!strlen(atext))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/answer [text]"C_WHITE"."), 1;

        new amsg[256];
        format(amsg, sizeof(amsg), "{85648C}[Q&A] "C_WHITE"%s "C_INFO"(guest)"C_WHITE": %s", PlayerData[playerid][pName], atext);
        QA_Broadcast(amsg);
        return 1;
    }

    // ---- /equip (mafii, doar la punctul de echipare din interiorul HQ-ului propriu) ----
    if(strcmp(cmd, "/equip", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(!IsMafiaFaction(PlayerData[playerid][pFaction]))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only mafia factions can use this."), 1;

        if(!IsPlayerInRangeOfPoint(playerid, EQUIP_RANGE, EQUIP_X, EQUIP_Y, EQUIP_Z))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the armory point inside your faction HQ."), 1;

        if(!Player_HasValidLicense(playerid, LIC_W))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You did not receive any weapons - you don't have a valid Weapon W license. Get one with "C_INFO"/examW"C_WHITE"."), 1;

        SetPlayerHealth(playerid, 100.0);
        AC_GiveWeapon(playerid, WEAPON_GRENADE, 1);
        AC_GiveWeapon(playerid, WEAPON_TEARGAS, 1);
        AC_GiveWeapon(playerid, WEAPON_DEAGLE, 350);
        AC_GiveWeapon(playerid, WEAPON_AK47,  300);
        if(PlayerData[playerid][pFactionRank] >= 4)
            AC_GiveWeapon(playerid, WEAPON_SNIPER, 20);

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"You have been equipped.");
        return 1;
    }

    // ---- /seif (rank 4+ mafie: vezi continutul seifului) ----
    if(strcmp(cmd, "/seif", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new fid = PlayerData[playerid][pFaction];
        if(!IsMafiaFaction(fid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only mafia factions have a vault."), 1;

        if(PlayerData[playerid][pFactionRank] < 4)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need rank 4 or higher to check the vault."), 1;

        new smsg[144];
        format(smsg, sizeof(smsg), T(playerid, C_INFO"[Seif] "C_WHITE"Iarba: "C_INFO"%d/%d"C_WHITE"grame. Drugs: "C_INFO"%d/%d"C_WHITE"gr."),
            FactionData[fid][fSeifHerbs], SEIF_MAX_HERBS, FactionData[fid][fSeifDrugs], SEIF_MAX_DRUGS);
        SCM(playerid, COLOR_INFO, smsg);
        return 1;
    }

    // ---- /drugs <transport/craft/get/use> ----
    if(strcmp(cmd, "/drugs", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new dfid = PlayerData[playerid][pFaction];
        if(!IsMafiaFaction(dfid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only mafia factions can use this."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new sub[16];
        strmid(sub, cmdtext, idx, strlen(cmdtext), 16);

        if(strcmp(sub, "transport", true) == 0)
        {
            new trank = PlayerData[playerid][pFactionRank];
            if(trank != 1 && trank != 2 && trank != 5)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only rank 1, 2 and 5 can transport."), 1;

            // [TEMP-DRUGHOUR] limitarea orara (19:00-23:59) pentru transportul de droguri e dezactivata temporar pentru testare (de readus)
            // new dhour, dminute, dsecond;
            // gettime(dhour, dminute, dsecond);
            // if(dhour < DRUG_TRANSPORT_HOUR_MIN || dhour > DRUG_TRANSPORT_HOUR_MAX)
            //     return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Transports are only available between "C_INFO"19:00"C_WHITE" and "C_INFO"23:59"C_WHITE"."), 1;

            new dveh = GetPlayerVehicleID(playerid);
            if(dveh == 0 || GetPlayerState(playerid) != PLAYER_STATE_DRIVER ||
               g_VehicleFactionOwner[dveh] != dfid || GetVehicleModel(dveh) != DRUG_HUNTLEY_MODEL)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be driving your faction's Huntley."), 1;

            if(g_DrugStage[playerid] != DRUG_STAGE_NONE)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already have a transport in progress."), 1;

            // al doilea membru al factiunii in vehicul
            new partner = INVALID_PLAYER_ID;
            for(new i = 0; i < MAX_PLAYERS; i++)
            {
                if(i == playerid || !IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
                if(GetPlayerVehicleID(i) != dveh) continue;
                if(PlayerData[i][pFaction] != dfid) continue;
                partner = i;
                break;
            }
            // TEMPORAR: transportul se poate face si cu o singura persoana in masina.
            // De readus la minim 2 membri (vezi roadmap).
            // if(partner == INVALID_PLAYER_ID)
            //     return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need a second faction member in the vehicle."), 1;

            if(g_DrugPickup[dfid][0] == 0.0 && g_DrugPickup[dfid][1] == 0.0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Your faction has no pickup location set yet."), 1;

            g_DrugStage[playerid]   = DRUG_STAGE_TOPICKUP;
            g_DrugPartner[playerid] = partner;
            Track_SetPlayerCheckpoint(playerid, g_DrugPickup[dfid][0], g_DrugPickup[dfid][1], g_DrugPickup[dfid][2], DRUG_CP_SIZE);
            SCM(playerid, COLOR_INFO, C_INFO"[Drugs] "C_WHITE"Your brother from the countryside prepared a proper shipment. Hurry and bring the goods to HQ.");
            return 1;
        }
        else if(strcmp(sub, "craft", true) == 0)
        {
            new drank = PlayerData[playerid][pFactionRank];
            if(drank < 3 || drank > 5)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only rank 3, 4 and 5 can craft."), 1;

            if(!IsPlayerInRangeOfPoint(playerid, DRUG_CRAFT_RANGE, DRUG_CRAFT_X, DRUG_CRAFT_Y, DRUG_CRAFT_Z))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the crafting machine."), 1;

            new need = 200 + random(100);
            if(FactionData[dfid][fSeifHerbs] < need)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Not enough weed in the vault."), 1;

            FactionData[dfid][fSeifHerbs] -= need;
            Faction_SaveSeif(dfid);

            TogglePlayerControllable(playerid, 0);
            GTP(playerid, "~w~Crafting...", DRUG_CRAFT_FREEZE * 1000, 3);
            SetTimerEx("DrugCraft_Finish", DRUG_CRAFT_FREEZE * 1000, false, "i", playerid);
            return 1;
        }
        else if(strcmp(sub, "get", true) == 0)
        {
            if(!IsPlayerInRangeOfPoint(playerid, DRUG_CRAFT_RANGE, DRUG_SEIF_X, DRUG_SEIF_Y, DRUG_SEIF_Z))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the vault."), 1;

            if(!War_FactionHasActiveWar(dfid))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can only take drugs during a war involving your faction."), 1;

            if(FactionData[dfid][fSeifDrugs] < DRUG_GET_AMOUNT)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Not enough drugs in the vault."), 1;

            FactionData[dfid][fSeifDrugs] -= DRUG_GET_AMOUNT;
            Faction_SaveSeif(dfid);
            g_PlayerDrugs[playerid] += DRUG_GET_AMOUNT;

            new gmsg[128];
            format(gmsg, sizeof(gmsg), T(playerid, C_SUCCESS"[Drugs] "C_WHITE"You took "C_INFO"%dg"C_WHITE" of drugs. You now carry "C_INFO"%dg"C_WHITE"."),
                DRUG_GET_AMOUNT, g_PlayerDrugs[playerid]);
            SCM(playerid, COLOR_SUCCESS, gmsg);
            return 1;
        }
        else if(strcmp(sub, "use", true) == 0)
        {
            new Float:ux, Float:uy, Float:uz;
            GetPlayerPos(playerid, ux, uy, uz);
            if(War_FindActiveWarForFactionAt(dfid, ux, uy) == -1)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can only use drugs inside the turf of an active war."), 1;

            if(g_PlayerDrugs[playerid] < DRUG_GET_AMOUNT)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't carry enough drugs."), 1;

            g_PlayerDrugs[playerid] -= DRUG_GET_AMOUNT;

            new Float:uhp;
            GetPlayerHealth(playerid, uhp);
            uhp += DRUG_USE_HEAL;
            if(uhp > 100.0) uhp = 100.0;
            SetPlayerHealth(playerid, uhp);

            ApplyAnimation(playerid, "CRACK", "crckidle2", 4.0, 0, 0, 0, 0, 0, 1);
            TogglePlayerControllable(playerid, 0);
            SetTimerEx("Drug_Unfreeze", DRUG_USE_FREEZE * 1000, false, "i", playerid);
            Pray_FlagSin(playerid, 10); // Bautura si viciul

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Drugs] "C_WHITE"You injected drugs. "C_SUCCESS"+30 HP"C_WHITE".");
            return 1;
        }

        SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/drugs [transport/craft/get/use]"C_WHITE".");
        return 1;
    }

    // ---- /war (declara razboi pe turful in care te afli) ----
    if(strcmp(cmd, "/war", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new warAtkFid = PlayerData[playerid][pFaction];
        if(!IsMafiaFaction(warAtkFid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only mafia factions can declare turf wars."), 1;

        new warTidx = War_FindTurfPlayerStandsIn(playerid);
        if(warTidx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be standing inside a territory to declare war on it."), 1;

        new warDefFid = TurfData[warTidx][tFactionID];
        if(warDefFid == warAtkFid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't declare war on your own territory."), 1;

        if(!IsMafiaFaction(warDefFid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This territory doesn't belong to a mafia faction."), 1;

        if(!TurfData[warTidx][tAttackable])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This territory cannot be attacked."), 1;

        if(TurfData[warTidx][tWarState] != WAR_STATE_NONE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This territory is already at war."), 1;

        if(War_FactionHasActiveWar(warAtkFid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Your faction is already involved in another war."), 1;

        if(War_FactionHasActiveWar(warDefFid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That faction is already involved in another war."), 1;

        if(War_CountOnline(warAtkFid) < WAR_MIN_FACTION_ONLINE || War_CountOnline(warDefFid) < WAR_MIN_FACTION_ONLINE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Both factions need at least 2 members online to start a war."), 1;

        War_Declare(warTidx, warAtkFid, warDefFid);
        return 1;
    }

    // ---- /forcewar [turf_id] [attacker_faction_id] [defender_faction_id] (admin lvl 4+) ----
    if(strcmp(cmd, "/forcewar", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 4)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 4."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new fwP1[8], fwP2[8], fwP3[8];
        strmid(fwP1, cmdtext, idx, strlen(cmdtext), 8);
        while(cmdtext[idx] > ' ') idx++;
        while(cmdtext[idx] == ' ') idx++;
        strmid(fwP2, cmdtext, idx, strlen(cmdtext), 8);
        while(cmdtext[idx] > ' ') idx++;
        while(cmdtext[idx] == ' ') idx++;
        strmid(fwP3, cmdtext, idx, strlen(cmdtext), 8);

        if(!strlen(fwP1) || !strlen(fwP2) || !strlen(fwP3))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/forcewar [turf_id] [attacker_faction_id] [defender_faction_id]"C_WHITE"."), 1;

        new fwTid = strval(fwP1);
        new fwAtkFid = strval(fwP2);
        new fwDefFid = strval(fwP3);

        new fwTidx = Turfs_FindByID(fwTid);
        if(fwTidx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid territory ID."), 1;

        if(!IsMafiaFaction(fwAtkFid) || !IsMafiaFaction(fwDefFid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Both factions must be mafia factions (4-7)."), 1;

        if(fwAtkFid == fwDefFid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Attacker and defender must be different factions."), 1;

        if(TurfData[fwTidx][tWarState] != WAR_STATE_NONE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This territory is already at war."), 1;

        War_Declare(fwTidx, fwAtkFid, fwDefFid);

        new fwmsg[160];
        format(fwmsg, sizeof(fwmsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Forced a war on territory "C_INFO"#%d"C_WHITE": "C_INFO"%s"C_WHITE" vs "C_INFO"%s"C_WHITE"."),
            fwTid, FactionData[fwAtkFid][fName], FactionData[fwDefFid][fName]);
        SCM(playerid, COLOR_SUCCESS, fwmsg);
        return 1;
    }

    // ---- /warsurrender ----
    if(strcmp(cmd, "/warsurrender", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new wsFid = PlayerData[playerid][pFaction];
        if(!IsMafiaFaction(wsFid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only mafia factions take part in turf wars."), 1;

        if(PlayerData[playerid][pFactionRank] < 4)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need rank 4 or 5 in the faction to surrender a war."), 1;

        new wsTidx = -1;
        for(new i = 0; i < g_TurfCount; i++)
        {
            if((TurfData[i][tWarState] == WAR_STATE_ACTIVE || TurfData[i][tWarState] == WAR_STATE_OVERTIME) &&
               (TurfData[i][tWarAttackerFaction] == wsFid || TurfData[i][tWarDefenderFaction] == wsFid))
            {
                wsTidx = i;
                break;
            }
        }

        if(wsTidx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Your faction is not currently in an active war."), 1;

        if(gettime() - TurfData[wsTidx][tWarActiveStartTime] < WAR_SURRENDER_MIN_TIME)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can only surrender after the first 5 minutes of the war."), 1;

        new wsWinnerFid = (TurfData[wsTidx][tWarAttackerFaction] == wsFid) ? TurfData[wsTidx][tWarDefenderFaction] : TurfData[wsTidx][tWarAttackerFaction];
        War_EndWar(wsTidx, wsWinnerFid, true);
        return 1;
    }

    // ---- /warscore ----
    if(strcmp(cmd, "/warscore", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new wcFid = PlayerData[playerid][pFaction];
        if(!IsMafiaFaction(wcFid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only mafia factions take part in turf wars."), 1;

        new wcFound = 0;
        for(new i = 0; i < g_TurfCount; i++)
        {
            if(TurfData[i][tWarState] == WAR_STATE_NONE) continue;
            if(TurfData[i][tWarAttackerFaction] != wcFid && TurfData[i][tWarDefenderFaction] != wcFid) continue;

            wcFound++;
            new wcAtkFid = TurfData[i][tWarAttackerFaction];
            new wcDefFid = TurfData[i][tWarDefenderFaction];
            new wcLeft;
            new wcMsg[350];

            if(TurfData[i][tWarState] == WAR_STATE_PENDING)
            {
                wcLeft = TurfData[i][tWarPhaseEndTime] - gettime();
                if(wcLeft < 0) wcLeft = 0;
                format(wcMsg, sizeof(wcMsg), T(playerid, C_INFO"[War] "C_WHITE"Territory "C_INFO"#%d"C_WHITE" (%s): "C_WHITE"%s"C_WHITE" vs "C_WHITE"%s"C_WHITE" - starts in "C_INFO"%d:%02d"C_WHITE"."),
                    TurfData[i][tID], TurfData[i][tName], FactionData[wcAtkFid][fName], FactionData[wcDefFid][fName], wcLeft / 60, wcLeft % 60);
            }
            else if(TurfData[i][tWarState] == WAR_STATE_ACTIVE)
            {
                wcLeft = TurfData[i][tWarPhaseEndTime] - gettime();
                if(wcLeft < 0) wcLeft = 0;
                format(wcMsg, sizeof(wcMsg), T(playerid, C_INFO"[War] "C_WHITE"Territory "C_INFO"#%d"C_WHITE" (%s): "C_INFO"%s %d"C_WHITE" - "C_INFO"%d %s"C_WHITE" | Time left: "C_INFO"%d:%02d"C_WHITE"."),
                    TurfData[i][tID], TurfData[i][tName], FactionData[wcAtkFid][fName], TurfData[i][tWarAttackerScore],
                    TurfData[i][tWarDefenderScore], FactionData[wcDefFid][fName], wcLeft / 60, wcLeft % 60);
            }
            else
            {
                format(wcMsg, sizeof(wcMsg), T(playerid, "[War] ""Territory ""#%d"" (%s): ""SUDDEN DEATH"" - ""%s ""%d"" kills, ""%s ""%d"" kills (first to ""%d"" wins)."),
                    TurfData[i][tID], TurfData[i][tName], FactionData[wcAtkFid][fName], TurfData[i][tWarOvertimeAttackerKills],
                    FactionData[wcDefFid][fName], TurfData[i][tWarOvertimeDefenderKills], WAR_OVERTIME_KILLS_TO_WIN);
            }

            SCM(playerid, COLOR_INFO, wcMsg);
        }

        if(!wcFound)
            SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Your faction is not currently involved in any turf war.");
        return 1;
    }

    // ---- /vote [player name] (alegeri presedinte, Duminica 08:00-19:30) ----
    if(strcmp(cmd, "/vote", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(!President_IsVoteWindowOpen())
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Voting is only open on Sunday between 08:00 and 19:30."), 1;

        if(PlayerData[playerid][pVoted])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You have already voted this week."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new voteName[24];
        strmid(voteName, cmdtext, idx, strlen(cmdtext), 24);
        if(!strlen(voteName))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/vote [player name]"C_WHITE"."), 1;

        new targetid = Player_FindByName(voteName);
        if(targetid == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That player is not online."), 1;

        new vq[256];
        mysql_format(g_SQL, vq, sizeof(vq),
            "INSERT INTO `president_votes` (`vVotant`,`vVotantId`,`vVotatPe`,`vVotatPeId`) VALUES ('%e',%d,'%e',%d)",
            PlayerData[playerid][pName], PlayerData[playerid][pID],
            PlayerData[targetid][pName], PlayerData[targetid][pID]);
        mysql_tquery(g_SQL, vq, "", "", 0);

        PlayerData[playerid][pVoted] = true;
        UpdatePlayer(playerid, pVoted);

        new vmsg[128];
        format(vmsg, sizeof(vmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You voted for "C_INFO"%s"C_WHITE" as President. Results are announced Sunday at 20:00."),
            PlayerData[targetid][pName]);
        SCM(playerid, COLOR_SUCCESS, vmsg);
        return 1;
    }

    // ---- /settax [0-100] (doar presedinte) ----
    if(strcmp(cmd, "/settax", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(!PlayerData[playerid][pIsPresident])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only the President can change the tax rate."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new taxStr[8];
        strmid(taxStr, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(taxStr))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/settax [0-100]"C_WHITE"."), 1;

        new newTax = strval(taxStr);
        if(newTax < 0 || newTax > 100)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Tax must be between 0 and 100."), 1;

        g_PDTax = newTax;
        new tq[96];
        mysql_format(g_SQL, tq, sizeof(tq), "UPDATE `server_setup` SET `ssValue`='%d' WHERE `ssSetare`='tax'", newTax);
        mysql_tquery(g_SQL, tq, "", "", 0);

        new tmsg[128];
        format(tmsg, sizeof(tmsg),
            C_INFO"[President] "C_WHITE"The President set the income tax to "C_INFO"%d%%"C_WHITE".", newTax);
        President_BroadcastAll(COLOR_INFO, tmsg);
        return 1;
    }

    // ---- /setcass [0-100] (doar presedinte) ----
    if(strcmp(cmd, "/setcass", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(!PlayerData[playerid][pIsPresident])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only the President can change the CASS rate."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new cassStr[8];
        strmid(cassStr, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(cassStr))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/setcass [0-100]"C_WHITE"."), 1;

        new newCass = strval(cassStr);
        if(newCass < 0 || newCass > 100)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"CASS must be between 0 and 100."), 1;

        g_PDCASS = newCass;
        new cq[96];
        mysql_format(g_SQL, cq, sizeof(cq), "UPDATE `server_setup` SET `ssValue`='%d' WHERE `ssSetare`='cass'", newCass);
        mysql_tquery(g_SQL, cq, "", "", 0);

        new cmsg[128];
        format(cmsg, sizeof(cmsg),
            C_INFO"[President] "C_WHITE"The President set the CASS to "C_INFO"%d%%"C_WHITE".", newCass);
        President_BroadcastAll(COLOR_INFO, cmsg);
        return 1;
    }

    // ---- /treasury (soldul trezoreriei) / /treasury give [playerid] [amount] (doar presedinte) ----
    if(strcmp(cmd, "/treasury", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new trSub[256];
        trSub = strtok(cmdtext, idx);
        if(!strlen(trSub))
        {
            new trmsg[96];
            format(trmsg, sizeof(trmsg),T(playerid, C_INFO"[Treasury] "C_WHITE"State treasury balance: "C_INFO"$%s"C_WHITE"."), MoneyStr(g_StateTreasury));
            SCM(playerid, COLOR_INFO, trmsg);
            return 1;
        }

        if(strcmp(trSub, "give", true) == 0)
        {
            if(!PlayerData[playerid][pIsPresident])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only the President can spend the treasury."), 1;

            new trP1[256], trP2[256];
            trP1 = strtok(cmdtext, idx);
            trP2 = strtok(cmdtext, idx);
            if(!strlen(trP1) || !strlen(trP2))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/treasury give [playerid] [amount]"C_WHITE"."), 1;

            new trTarget = strval(trP1);
            if(!IsPlayerConnected(trTarget) || !PlayerData[trTarget][pLogged])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

            new trAmount = strval(trP2);
            if(trAmount <= 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid amount."), 1;
            if(trAmount > g_StateTreasury)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The treasury doesn't have that much money."), 1;

            g_StateTreasury -= trAmount;
            Treasury_Save();

            PlayerData[trTarget][pMoney] += trAmount;
            GivePlayerMoney(trTarget, trAmount);
            UpdatePlayer(trTarget, pMoney);

            new trbmsg[160];
            format(trbmsg, sizeof(trbmsg), C_INFO"[Treasury] "C_WHITE"The President granted "C_INFO"$%s"C_WHITE" to "C_INFO"%s"C_WHITE" from the state treasury.",
                MoneyStr(trAmount), PlayerData[trTarget][pName]);
            President_BroadcastAll(COLOR_INFO, trbmsg);
            return 1;
        }

        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/treasury"C_WHITE" or "C_INFO"/treasury give [playerid] [amount]"C_WHITE"."), 1;
    }

    // ---- /charity (cauza + fond) / /charity set [text] (presedinte) / /charity donate [amount] ----
    if(strcmp(cmd, "/charity", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new chSub[256];
        chSub = strtok(cmdtext, idx);
        if(!strlen(chSub))
        {
            new chmsg[176];
            format(chmsg, sizeof(chmsg),T(playerid, C_INFO"[Charity] "C_WHITE"Current cause: "C_INFO"%s"C_WHITE" | Fund: "C_INFO"$%s"C_WHITE"."), g_CharityCause, MoneyStr(g_CharityFund));
            SCM(playerid, COLOR_INFO, chmsg);
            return 1;
        }

        if(strcmp(chSub, "set", true) == 0)
        {
            if(!PlayerData[playerid][pIsPresident])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only the President can set the charity cause."), 1;

            while(cmdtext[idx] == ' ') idx++;
            new chText[64];
            strmid(chText, cmdtext, idx, strlen(cmdtext), 64);
            if(!strlen(chText))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/charity set [text]"C_WHITE"."), 1;

            format(g_CharityCause, sizeof(g_CharityCause), "%s", chText);
            Charity_SaveCause();

            new chsmsg[256];
            format(chsmsg, sizeof(chsmsg), C_INFO"[Charity] "C_WHITE"The President is now supporting: "C_INFO"%s"C_WHITE". Donate with "C_INFO"/charity donate [amount]"C_WHITE".", g_CharityCause);
            President_BroadcastAll(COLOR_INFO, chsmsg);
            return 1;
        }

        if(strcmp(chSub, "donate", true) == 0)
        {
            new chAmStr[256];
            chAmStr = strtok(cmdtext, idx);
            if(!strlen(chAmStr))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/charity donate [amount]"C_WHITE"."), 1;

            new chAmount = strval(chAmStr);
            if(chAmount <= 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid amount."), 1;
            if(PlayerData[playerid][pMoney] < chAmount)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have that much cash."), 1;

            PlayerData[playerid][pMoney] -= chAmount;
            GivePlayerMoney(playerid, -chAmount);
            UpdatePlayer(playerid, pMoney);

            g_CharityFund += chAmount;
            Charity_SaveFund();

            new chdmsg[160];
            format(chdmsg, sizeof(chdmsg),T(playerid, C_SUCCESS"[Charity] "C_WHITE"You donated "C_INFO"$%s"C_WHITE" to "C_INFO"%s"C_WHITE". Thank you!"), MoneyStr(chAmount), g_CharityCause);
            SCM(playerid, COLOR_SUCCESS, chdmsg);
            return 1;
        }

        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/charity"C_WHITE", "C_INFO"/charity set [text]"C_WHITE" or "C_INFO"/charity donate [amount]"C_WHITE"."), 1;
    }

    // ---- /appoint pm|vpm [playerid] | /appoint dismiss pm|vpm (doar presedintele) ----
    if(strcmp(cmd, "/appoint", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(!PlayerData[playerid][pIsPresident])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only the President can appoint the government."), 1;

        new apSub[256];
        apSub = strtok(cmdtext, idx);
        if(!strlen(apSub))
        {
            // doua mesaje separate: intr-unul singur cele 8 coduri de culoare ar depasi limita de 144 caractere
            SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/appoint pm [playerid]"C_WHITE" or "C_INFO"/appoint vpm [playerid]"C_WHITE".");
            SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/appoint dismiss [pm/vpm]"C_WHITE" to remove someone from office.");
            return 1;
        }

        // ---- demitere ----
        if(strcmp(apSub, "dismiss", true) == 0)
        {
            new apWho[256];
            apWho = strtok(cmdtext, idx);
            new apRole = Gov_ParseRole(apWho);
            if(apRole == GOV_NONE)
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/appoint dismiss [pm/vpm]"C_WHITE"."), 1;

            // verificam intai ca functia e chiar ocupata (detinatorul poate fi offline) - vezi OnGovDismiss
            new apdq[128];
            mysql_format(g_SQL, apdq, sizeof(apdq), "SELECT `id` FROM `players` WHERE `gov_role`=%d LIMIT 1", apRole);
            mysql_tquery(g_SQL, apdq, "OnGovDismiss", "ii", playerid, apRole);
            return 1;
        }

        // ---- numire ----
        new apRole = Gov_ParseRole(apSub);
        if(apRole == GOV_NONE)
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/appoint pm [playerid]"C_WHITE" or "C_INFO"/appoint vpm [playerid]"C_WHITE"."), 1;

        new apP1[256];
        apP1 = strtok(cmdtext, idx);
        if(!strlen(apP1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/appoint pm [playerid]"C_WHITE" or "C_INFO"/appoint vpm [playerid]"C_WHITE"."), 1;

        new apTarget = strval(apP1);
        if(!IsPlayerConnected(apTarget) || !PlayerData[apTarget][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        if(apTarget == playerid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't appoint yourself - you are already the President."), 1;

        if(PlayerData[apTarget][pGovRole] == apRole)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That player already holds this office."), 1;

        Gov_ClearRole(apRole);                                          // elibereaza scaunul (fostul detinator poate fi offline)
        if(PlayerData[apTarget][pGovRole] != GOV_NONE)
            Gov_ClearRole(PlayerData[apTarget][pGovRole]);              // si cealalta functie, daca o detinea el

        PlayerData[apTarget][pGovRole] = apRole;
        UpdatePlayer(apTarget, pGovRole);

        new apmsg[176];
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
            format(apmsg, sizeof(apmsg), T(i, C_SUCCESS"[Government] "C_WHITE"The President appointed "C_INFO"%s"C_WHITE" as "C_INFO"%s"C_WHITE"."),
                PlayerData[apTarget][pName], T(i, g_GovRoleName[apRole]));
            SCM(i, COLOR_SUCCESS, apmsg);
        }

        format(apmsg, sizeof(apmsg), T(apTarget, C_SUCCESS"[Government] "C_WHITE"You have been appointed "C_INFO"%s"C_WHITE" by the President. See "C_INFO"/gov"C_WHITE"."),
            T(apTarget, g_GovRoleName[apRole]));
        SCM(apTarget, COLOR_SUCCESS, apmsg);
        return 1;
    }

    // ---- /gov (info: presedintele + Prim-ministrul si Vice-premierul numiti de el) ----
    if(strcmp(cmd, "/gov", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        mysql_tquery(g_SQL,
            "SELECT `username`,`is_president`,`gov_role` FROM `players` WHERE `is_president`=1 OR `gov_role`<>0 LIMIT 3",
            "OnGovInfo", "i", playerid);
        return 1;
    }

    // ---- /president (info: presedintele curent + impozit/CASS) ----
    if(strcmp(cmd, "/president", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        mysql_tquery(g_SQL,
            "SELECT `username` FROM `players` WHERE `is_president`=1 LIMIT 1",
            "OnPresidentInfo", "i", playerid);
        return 1;
    }

    // ---- /setpresident [playerid] (admin: forteaza un jucator sa devina presedinte, fara vot) ----
    // ---- /setpresident dismiss (admin: revoca presedintele curent, functia ramane vacanta) ----
    if(strcmp(cmd, "/setpresident", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 4)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 4."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new spP1[8];
        strmid(spP1, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(spP1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/setpresident [playerid]"C_WHITE" or "C_INFO"/setpresident dismiss"C_WHITE"."), 1;

        // ---- revocare fara inlocuitor: functia ramane vacanta, la fel ca la un vot fara castigator ----
        // ("/setpresident -1" e echivalent cu "/setpresident dismiss")
        if(strcmp(spP1, "dismiss", true) == 0 || strval(spP1) == -1)
        {
            mysql_tquery(g_SQL, "SELECT `id` FROM `players` WHERE `is_president`=1 LIMIT 1", "OnSetPresidentDismiss", "i", playerid);
            return 1;
        }

        new spTarget = strval(spP1);
        if(!IsPlayerConnected(spTarget) || !PlayerData[spTarget][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        if(PlayerData[spTarget][pIsPresident])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That player is already the President."), 1;

        // acelasi tipar ca la calculul castigatorului saptamanal (President_ComputeWinner/OnPresidentWinnerComputed), fara vot
        mysql_tquery(g_SQL, "UPDATE `players` SET `was_president` = `is_president`", "", "", 0);
        mysql_tquery(g_SQL, "UPDATE `players` SET `is_president`=0", "", "", 0);

        new spq[128];
        mysql_format(g_SQL, spq, sizeof(spq), "UPDATE `players` SET `is_president`=1, `was_president`=0 WHERE `id`=%d", PlayerData[spTarget][pID]);
        mysql_tquery(g_SQL, spq, "", "", 0);

        Gov_ClearAll(); // presedinte nou -> guvernul vechi (Prim-ministru/Vice-premier) se dizolva

        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
            PlayerData[i][pWasPresident] = PlayerData[i][pIsPresident];
            PlayerData[i][pIsPresident]  = (i == spTarget);
            if(i == spTarget) PlayerData[i][pWasPresident] = false;
        }

        new spmsg[144];
        format(spmsg, sizeof(spmsg), C_SUCCESS"[President] "C_WHITE"An admin appointed "C_INFO"%s"C_WHITE" as President.", PlayerData[spTarget][pName]);
        President_BroadcastAll(COLOR_SUCCESS, spmsg);
        President_BroadcastAll(COLOR_INFO,
            C_INFO"[Government] "C_WHITE"The old cabinet has been dissolved. The new President can appoint theirs with "C_INFO"/appoint"C_WHITE".");

        format(spmsg, sizeof(spmsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"You appointed "C_INFO"%s"C_WHITE" as President."), PlayerData[spTarget][pName]);
        SCM(playerid, COLOR_SUCCESS, spmsg);
        return 1;
    }

    // ---- /finvite [targetid] ----
    if(strcmp(cmd, "/finvite", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new fid = PlayerData[playerid][pFaction];
        if(fid < 1 || fid > MAX_FACTIONS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of a faction."), 1;

        if(PlayerData[playerid][pFactionRank] < 4)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires rank 4 or 5 in the faction."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new p1[8];
        strmid(p1, cmdtext, idx, strlen(cmdtext), 8);

        if(!strlen(p1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/finvite [playerid]"C_WHITE"."), 1;

        new targetid = strval(p1);
        if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        if(targetid == playerid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't invite yourself."), 1;

        if(PlayerData[targetid][pFaction] != 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is already part of a faction."), 1;

        new Float:px, Float:py, Float:pz;
        GetPlayerPos(playerid, px, py, pz);
        if(!IsPlayerInRangeOfPoint(targetid, FINVITE_RANGE, px, py, pz))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player must be within 15m."), 1;

        g_InviteFaction[targetid] = fid;
        g_InviteInviter[targetid] = playerid;

        new fmsg2[256];
        format(fmsg2, sizeof(fmsg2), T(playerid, C_SUCCESS"Success: "C_WHITE"You invited "C_INFO"%s"C_WHITE" to the faction "C_INFO"%s"C_WHITE"."),
            PlayerData[targetid][pName], FactionData[fid][fName]);
        SCM(playerid, COLOR_SUCCESS, fmsg2);

        new fcolor[9];
        GetFactionColorCode(fid, fcolor, sizeof(fcolor));

        format(fmsg2, sizeof(fmsg2), T(targetid, C_WHITE"Player "C_INFO"%s"C_WHITE" invited you to %s%s"C_WHITE". Type "C_INFO"/accept finvite %d"C_WHITE" to accept the invitation."),
            PlayerData[playerid][pName], fcolor, FactionData[fid][fName], playerid);
        SCM(targetid, COLOR_WHITE, fmsg2);
        return 1;
    }

    // ---- /accept finvite [playerid] / /accept fine [playerid] ----
    if(strcmp(cmd, "/accept", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new subStart = idx;
        while(cmdtext[idx] > ' ') idx++;
        new sub[16];
        strmid(sub, cmdtext, subStart, idx, 16);
        while(cmdtext[idx] == ' ') idx++;
        new p1[8];
        strmid(p1, cmdtext, idx, strlen(cmdtext), 8);

        // ---- /accept uber (un sofer uber preia cel mai apropiat pasager care a cerut cursa) ----
        if(strcmp(sub, "uber", true) == 0)
        {
            if(!g_UberOnDuty[playerid])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not on duty as an Uber driver."), 1;

            if(g_UberPassenger[playerid] != INVALID_PLAYER_ID)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already have a passenger."), 1;

            new best = INVALID_PLAYER_ID;
            new Float:bestDist = 99999.0;
            for(new i = 0; i < MAX_PLAYERS; i++)
            {
                if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
                if(!g_UberWantsRide[i] || g_UberDriver[i] != INVALID_PLAYER_ID) continue;
                new Float:px, Float:py, Float:pz;
                GetPlayerPos(i, px, py, pz);
                new Float:d = GetPlayerDistanceFromPoint(playerid, px, py, pz);
                if(d < bestDist) { bestDist = d; best = i; }
            }

            if(best == INVALID_PLAYER_ID)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Nobody is waiting for an Uber right now."), 1;

            g_UberPassenger[playerid] = best;
            g_UberDriver[best]        = playerid;
            g_UberWantsRide[best]     = false;

            new Float:tx, Float:ty, Float:tz;
            GetPlayerPos(best, tx, ty, tz);
            Track_SetPlayerCheckpoint(playerid, tx, ty, tz, UBER_CP_SIZE);

            new umsg[144];
            format(umsg, sizeof(umsg), T(playerid, C_SUCCESS"[Uber] "C_WHITE"You accepted "C_INFO"%s"C_WHITE"'s ride. Drive to the checkpoint."), PlayerData[best][pName]);
            SCM(playerid, COLOR_SUCCESS, umsg);
            format(umsg, sizeof(umsg), T(best, C_SUCCESS"[Uber] "C_WHITE"%s"C_WHITE" is coming to pick you up. Get in when they arrive."), PlayerData[playerid][pName]);
            SCM(best, COLOR_SUCCESS, umsg);
            return 1;
        }

        // ---- /accept newspaper [sellerid] (cumpara ziarul oferit) ----
        if(strcmp(sub, "newspaper", true) == 0)
        {
            if(!strlen(p1))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/accept newspaper [playerid]"C_WHITE"."), 1;

            new sellerid = strval(p1);
            if(g_NewsOfferSeller[playerid] == INVALID_PLAYER_ID || g_NewsOfferSeller[playerid] != sellerid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a pending newspaper offer from this player."), 1;

            if(!IsPlayerConnected(sellerid) || !PlayerData[sellerid][pLogged])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The seller is no longer connected."), 1;

            new amount = g_NewsOfferAmount[playerid];
            if(PlayerData[playerid][pMoney] < amount)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money."), 1;

            PlayerData[playerid][pMoney] -= amount;
            GivePlayerMoney(playerid, -amount);
            PlayerData[sellerid][pMoney] += amount;
            GivePlayerMoney(sellerid, amount);

            for(new n = 0; n < NEWS_MAX_ITEMS; n++)
                format(g_OwnedNewsItem[playerid][n], NEWS_ITEM_LEN, "%s", g_NewspaperItem[sellerid][n]);
            format(g_OwnedNewsAuthor[playerid], 24, "%s", PlayerData[sellerid][pName]);
            g_HasNewspaper[playerid] = true;

            g_NewsOfferSeller[playerid] = INVALID_PLAYER_ID;
            g_NewsOfferAmount[playerid] = 0;

            new npmsg[256];
            format(npmsg, sizeof(npmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You bought a newspaper from "C_INFO"%s"C_WHITE" for "C_INFO"$%s"C_WHITE". Read it with "C_INFO"/newspaper open"C_WHITE"."),
                PlayerData[sellerid][pName], MoneyStr(amount));
            SCM(playerid, COLOR_SUCCESS, npmsg);
            format(npmsg, sizeof(npmsg), T(sellerid, C_SUCCESS"Success: "C_WHITE"%s"C_WHITE" bought your newspaper for "C_INFO"$%s"C_WHITE"."),
                PlayerData[playerid][pName], MoneyStr(amount));
            SCM(sellerid, COLOR_SUCCESS, npmsg);
            return 1;
        }

        // ---- /accept biz [sellerid] (cumpara business-ul oferit direct de un player, cu /biz sellto) ----
        if(strcmp(sub, "biz", true) == 0)
        {
            if(!strlen(p1))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/accept biz [playerid]"C_WHITE"."), 1;

            new bzsellerid = strval(p1);
            if(g_BizOfferSeller[playerid] == INVALID_PLAYER_ID || g_BizOfferSeller[playerid] != bzsellerid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a pending business offer from this player."), 1;

            if(!IsPlayerConnected(bzsellerid) || !PlayerData[bzsellerid][pLogged])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The seller is no longer connected."), 1;

            new bzbidx = Businesses_FindByID(g_BizOfferBizId[playerid]);
            if(bzbidx == -1 || BusinessData[bzbidx][bOwnerId] != PlayerData[bzsellerid][pID])
            {
                g_BizOfferSeller[playerid] = INVALID_PLAYER_ID;
                g_BizOfferBizId[playerid]  = 0;
                g_BizOfferAmount[playerid] = 0;
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This offer is no longer valid (the business changed hands)."), 1;
            }

            new bzamount = g_BizOfferAmount[playerid];
            if(PlayerData[playerid][pMoney] < bzamount)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough cash."), 1;

            PlayerData[playerid][pMoney] -= bzamount;
            GivePlayerMoney(playerid, -bzamount);
            UpdatePlayer(playerid, pMoney);

            PlayerData[bzsellerid][pBank] += bzamount;
            UpdatePlayer(bzsellerid, pBank);
            if(PlayerData[bzsellerid][pBusiness] == BusinessData[bzbidx][bID])
            {
                PlayerData[bzsellerid][pBusiness] = 0;
                UpdatePlayer(bzsellerid, pBusiness);
            }

            BusinessData[bzbidx][bOwned]    = 1;
            BusinessData[bzbidx][bForSale]  = 0;
            BusinessData[bzbidx][bOwnerId]  = PlayerData[playerid][pID];
            GetPlayerName(playerid, BusinessData[bzbidx][bOwnerName], 24);

            PlayerData[playerid][pBusiness] = BusinessData[bzbidx][bID];
            UpdatePlayer(playerid, pBusiness);

            Businesses_RecreatePickup(bzbidx);

            new bzq[256];
            mysql_format(g_SQL, bzq, sizeof(bzq),
                "UPDATE `businesses` SET `owner`='%e', `owner_id`=%d, `owned`=1, `is_for_sale`=0 WHERE `id`=%d",
                BusinessData[bzbidx][bOwnerName], BusinessData[bzbidx][bOwnerId], BusinessData[bzbidx][bID]);
            mysql_tquery(g_SQL, bzq, "", "", 0);

            g_BizOfferSeller[playerid] = INVALID_PLAYER_ID;
            g_BizOfferBizId[playerid]  = 0;
            g_BizOfferAmount[playerid] = 0;

            new bzmsg[256];
            format(bzmsg, sizeof(bzmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You bought the business (ID: "C_INFO"%d"C_WHITE") from "C_INFO"%s"C_WHITE" for "C_INFO"$%s"C_WHITE"."),
                BusinessData[bzbidx][bID], PlayerData[bzsellerid][pName], MoneyStr(bzamount));
            SCM(playerid, COLOR_SUCCESS, bzmsg);
            format(bzmsg, sizeof(bzmsg), T(bzsellerid, C_SUCCESS"Success: "C_WHITE"%s"C_WHITE" bought your business (ID: "C_INFO"%d"C_WHITE") for "C_INFO"$%s"C_WHITE" (deposited to your bank)."),
                PlayerData[playerid][pName], BusinessData[bzbidx][bID], MoneyStr(bzamount));
            SCM(bzsellerid, COLOR_SUCCESS, bzmsg);
            return 1;
        }

        // ---- /accept house [sellerid] (cumpara casa oferita direct de un player, cu /house sellto) ----
        if(strcmp(sub, "house", true) == 0)
        {
            if(!strlen(p1))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/accept house [playerid]"C_WHITE"."), 1;

            new hssellerid = strval(p1);
            if(g_HouseOfferSeller[playerid] == INVALID_PLAYER_ID || g_HouseOfferSeller[playerid] != hssellerid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a pending house offer from this player."), 1;

            if(!IsPlayerConnected(hssellerid) || !PlayerData[hssellerid][pLogged])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The seller is no longer connected."), 1;

            if(PlayerData[playerid][pHouse] != 0)
            {
                g_HouseOfferSeller[playerid] = INVALID_PLAYER_ID;
                g_HouseOfferHid[playerid]    = 0;
                g_HouseOfferAmount[playerid] = 0;
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already own a house. Sell it first."), 1;
            }

            new hshidx = Houses_FindByID(g_HouseOfferHid[playerid]);
            if(hshidx == -1 || HouseData[hshidx][hOwnerId] != PlayerData[hssellerid][pID])
            {
                g_HouseOfferSeller[playerid] = INVALID_PLAYER_ID;
                g_HouseOfferHid[playerid]    = 0;
                g_HouseOfferAmount[playerid] = 0;
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This offer is no longer valid (the house changed hands)."), 1;
            }

            new hsamount = g_HouseOfferAmount[playerid];
            if(PlayerData[playerid][pMoney] < hsamount)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough cash."), 1;

            PlayerData[playerid][pMoney] -= hsamount;
            GivePlayerMoney(playerid, -hsamount);
            UpdatePlayer(playerid, pMoney);

            PlayerData[hssellerid][pBank] += hsamount;
            UpdatePlayer(hssellerid, pBank);
            PlayerData[hssellerid][pHouse] = 0;
            UpdatePlayer(hssellerid, pHouse);

            HouseData[hshidx][hOwned]    = 1;
            HouseData[hshidx][hForSale]  = 0;
            HouseData[hshidx][hOwnerId]  = PlayerData[playerid][pID];
            GetPlayerName(playerid, HouseData[hshidx][hOwnerName], 24);

            PlayerData[playerid][pHouse] = HouseData[hshidx][hID];
            UpdatePlayer(playerid, pHouse);

            Houses_RecreatePickup(hshidx);

            new hsq[256];
            mysql_format(g_SQL, hsq, sizeof(hsq),
                "UPDATE `houses` SET `owner`='%e', `owner_id`=%d, `owned`=1, `is_for_sale`=0 WHERE `id`=%d",
                HouseData[hshidx][hOwnerName], HouseData[hshidx][hOwnerId], HouseData[hshidx][hID]);
            mysql_tquery(g_SQL, hsq, "", "", 0);

            g_HouseOfferSeller[playerid] = INVALID_PLAYER_ID;
            g_HouseOfferHid[playerid]    = 0;
            g_HouseOfferAmount[playerid] = 0;

            new hsmsg[160];
            format(hsmsg, sizeof(hsmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You bought the house (ID: "C_INFO"%d"C_WHITE") from "C_INFO"%s"C_WHITE" for "C_INFO"$%s"C_WHITE"."),
                HouseData[hshidx][hID], PlayerData[hssellerid][pName], MoneyStr(hsamount));
            SCM(playerid, COLOR_SUCCESS, hsmsg);
            format(hsmsg, sizeof(hsmsg), T(hssellerid, C_SUCCESS"Success: "C_WHITE"%s"C_WHITE" bought your house (ID: "C_INFO"%d"C_WHITE") for "C_INFO"$%s"C_WHITE" (deposited to your bank)."),
                PlayerData[playerid][pName], HouseData[hshidx][hID], MoneyStr(hsamount));
            SCM(hssellerid, COLOR_SUCCESS, hsmsg);
            return 1;
        }

        // ---- /accept billboard [sellerid] (cumpara billboard-ul oferit direct de un player, cu /bb sellto) ----
        if(strcmp(sub, "billboard", true) == 0)
        {
            if(!strlen(p1))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/accept billboard [playerid]"C_WHITE"."), 1;

            new bbasellerid = strval(p1);
            if(g_BBOfferSeller[playerid] == INVALID_PLAYER_ID || g_BBOfferSeller[playerid] != bbasellerid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a pending billboard offer from this player."), 1;

            if(!IsPlayerConnected(bbasellerid) || !PlayerData[bbasellerid][pLogged])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The seller is no longer connected."), 1;

            if(PlayerData[playerid][pBBKey] != 0)
            {
                g_BBOfferSeller[playerid] = INVALID_PLAYER_ID;
                g_BBOfferBbId[playerid]   = 0;
                g_BBOfferAmount[playerid] = 0;
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already own a billboard. Sell it first."), 1;
            }

            new bbaidx = -1;
            for(new i = 0; i < g_BillboardCount; i++)
                if(BillboardData[i][bbID] == g_BBOfferBbId[playerid]) { bbaidx = i; break; }

            if(bbaidx == -1 || BillboardData[bbaidx][bbOwnerId] != PlayerData[bbasellerid][pID])
            {
                g_BBOfferSeller[playerid] = INVALID_PLAYER_ID;
                g_BBOfferBbId[playerid]   = 0;
                g_BBOfferAmount[playerid] = 0;
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This offer is no longer valid (the billboard changed hands)."), 1;
            }

            new bbaamount = g_BBOfferAmount[playerid];
            if(PlayerData[playerid][pMoney] < bbaamount)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough cash."), 1;

            PlayerData[playerid][pMoney] -= bbaamount;
            GivePlayerMoney(playerid, -bbaamount);
            UpdatePlayer(playerid, pMoney);

            PlayerData[bbasellerid][pBank] += bbaamount;
            UpdatePlayer(bbasellerid, pBank);
            PlayerData[bbasellerid][pBBKey] = 0;
            UpdatePlayer(bbasellerid, pBBKey);

            BillboardData[bbaidx][bbOwnerId]   = PlayerData[playerid][pID];
            GetPlayerName(playerid, BillboardData[bbaidx][bbOwner], 24);
            BillboardData[bbaidx][bbIsForSale] = false;

            PlayerData[playerid][pBBKey] = BillboardData[bbaidx][bbID];
            UpdatePlayer(playerid, pBBKey);

            Billboard_Save(bbaidx);
            Billboard_UpdateLabel(bbaidx);

            g_BBOfferSeller[playerid] = INVALID_PLAYER_ID;
            g_BBOfferBbId[playerid]   = 0;
            g_BBOfferAmount[playerid] = 0;

            new bbamsg[256];
            format(bbamsg, sizeof(bbamsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You bought the billboard (ID: "C_INFO"%d"C_WHITE") from "C_INFO"%s"C_WHITE" for "C_INFO"$%s"C_WHITE"."),
                BillboardData[bbaidx][bbID], PlayerData[bbasellerid][pName], MoneyStr(bbaamount));
            SCM(playerid, COLOR_SUCCESS, bbamsg);
            format(bbamsg, sizeof(bbamsg), T(bbasellerid, C_SUCCESS"Success: "C_WHITE"%s"C_WHITE" bought your billboard (ID: "C_INFO"%d"C_WHITE") for "C_INFO"$%s"C_WHITE" (deposited to your bank)."),
                PlayerData[playerid][pName], BillboardData[bbaidx][bbID], MoneyStr(bbaamount));
            SCM(bbasellerid, COLOR_SUCCESS, bbamsg);
            return 1;
        }

        // ---- /accept forest [sellerid] (cumparatorul confirma oferta de la /sellforestto) ----
        if(strcmp(sub, "forest", true) == 0)
        {
            if(!strlen(p1))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/accept forest [playerid]"C_WHITE"."), 1;

            new fosellerid = strval(p1);
            if(g_ForestOfferSeller[playerid] == INVALID_PLAYER_ID || g_ForestOfferSeller[playerid] != fosellerid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a pending forest offer from this player."), 1;

            if(!IsPlayerConnected(fosellerid) || !PlayerData[fosellerid][pLogged])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The seller is no longer connected."), 1;

            if(PlayerData[playerid][pForestKey] != 0)
            {
                g_ForestOfferSeller[playerid] = INVALID_PLAYER_ID;
                g_ForestOfferFid[playerid]    = 0;
                g_ForestOfferAmount[playerid] = 0;
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already own a forest. Sell it first."), 1;
            }

            new fofidx = Forest_IndexByID(g_ForestOfferFid[playerid]);
            if(fofidx == -1 || ForestData[fofidx][fstOwnerId] != PlayerData[fosellerid][pID])
            {
                g_ForestOfferSeller[playerid] = INVALID_PLAYER_ID;
                g_ForestOfferFid[playerid]    = 0;
                g_ForestOfferAmount[playerid] = 0;
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This offer is no longer valid (the forest changed hands)."), 1;
            }

            new foamount = g_ForestOfferAmount[playerid];
            if(PlayerData[playerid][pMoney] < foamount)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough cash."), 1;

            PlayerData[playerid][pMoney] -= foamount;
            GivePlayerMoney(playerid, -foamount);
            UpdatePlayer(playerid, pMoney);

            PlayerData[fosellerid][pBank] += foamount;
            UpdatePlayer(fosellerid, pBank);
            PlayerData[fosellerid][pForestKey] = 0;
            UpdatePlayer(fosellerid, pForestKey);

            ForestData[fofidx][fstForSale] = 0;
            ForestData[fofidx][fstOwnerId] = PlayerData[playerid][pID];
            GetPlayerName(playerid, ForestData[fofidx][fstOwnerName], 24);

            PlayerData[playerid][pForestKey] = ForestData[fofidx][fstID];
            UpdatePlayer(playerid, pForestKey);

            Forest_RecreatePickup(fofidx);

            new foq2[256];
            mysql_format(g_SQL, foq2, sizeof(foq2),
                "UPDATE `forests` SET `owner`='%e', `ownerId`=%d, `isForSale`=0 WHERE `id`=%d",
                ForestData[fofidx][fstOwnerName], ForestData[fofidx][fstOwnerId], ForestData[fofidx][fstID]);
            mysql_tquery(g_SQL, foq2, "", "", 0);

            g_ForestOfferSeller[playerid] = INVALID_PLAYER_ID;
            g_ForestOfferFid[playerid]    = 0;
            g_ForestOfferAmount[playerid] = 0;

            new fomsg[160];
            format(fomsg, sizeof(fomsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You bought the forest (ID: "C_INFO"%d"C_WHITE") from "C_INFO"%s"C_WHITE" for "C_INFO"$%s"C_WHITE"."),
                ForestData[fofidx][fstID], PlayerData[fosellerid][pName], MoneyStr(foamount));
            SCM(playerid, COLOR_SUCCESS, fomsg);
            format(fomsg, sizeof(fomsg), T(fosellerid, C_SUCCESS"Success: "C_WHITE"%s"C_WHITE" bought your forest (ID: "C_INFO"%d"C_WHITE") for "C_INFO"$%s"C_WHITE" (deposited to your bank)."),
                PlayerData[playerid][pName], ForestData[fofidx][fstID], MoneyStr(foamount));
            SCM(fosellerid, COLOR_SUCCESS, fomsg);
            return 1;
        }

        // ---- /accept qa [reporterid] (invitatul accepta live-ul Q&A) ----
        if(strcmp(sub, "qa", true) == 0)
        {
            if(!strlen(p1))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/accept qa [reporterid]"C_WHITE"."), 1;

            new rid = strval(p1);
            if(g_QAPendingReporter == INVALID_PLAYER_ID || g_QAPendingGuest != playerid || g_QAPendingReporter != rid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a pending Q&A invite from this player."), 1;
            if(!IsPlayerConnected(rid) || !PlayerData[rid][pLogged])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The reporter is no longer connected."), 1;

            g_QAActive          = true;
            g_QAReporter        = rid;
            g_QAGuest           = playerid;
            g_QAPendingReporter = INVALID_PLAYER_ID;
            g_QAPendingGuest    = INVALID_PLAYER_ID;
            g_QACount           = 0;

            new qamsg[220];
            format(qamsg, sizeof(qamsg), "[Q&A] ""Live started! Reporter ""%s"" is interviewing ""%s"". Submit questions with ""/question [text]"".",
                PlayerData[rid][pName], PlayerData[playerid][pName]);
            QA_Broadcast(qamsg);
            return 1;
        }

        // ---- /accept barbut [challengerid] (accepta un duel de zaruri) ----
        if(strcmp(sub, "barbut", true) == 0)
        {
            if(!strlen(p1))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/accept barbut [playerid]"C_WHITE"."), 1;

            new challengerid = strval(p1);
            if(g_BarbutChallenger[playerid] == INVALID_PLAYER_ID || g_BarbutChallenger[playerid] != challengerid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a pending Barbut challenge from this player."), 1;
            if(!IsPlayerConnected(challengerid) || !PlayerData[challengerid][pLogged])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That player is no longer connected."), 1;

            new bAmt = g_BarbutChallengeAmt[playerid];
            if(PlayerData[challengerid][pMoney] < bAmt)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The challenger no longer has enough money."), 1;
            if(PlayerData[playerid][pMoney] < bAmt)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money."), 1;

            g_BarbutChallenger[playerid] = INVALID_PLAYER_ID;

            PlayerData[challengerid][pMoney] -= bAmt;
            GivePlayerMoney(challengerid, -bAmt);
            PlayerData[playerid][pMoney]     -= bAmt;
            GivePlayerMoney(playerid, -bAmt);

            new roll1, roll2;
            do
            {
                roll1 = (1 + random(6)) + (1 + random(6));
                roll2 = (1 + random(6)) + (1 + random(6));
            }
            while(roll1 == roll2);

            new winnerid = (roll1 > roll2) ? challengerid : playerid;
            new pot = bAmt * 2;
            PlayerData[winnerid][pMoney] += pot;
            GivePlayerMoney(winnerid, pot);
            UpdatePlayer(challengerid, pMoney);
            UpdatePlayer(playerid, pMoney);

            new bdmsg[200];
            format(bdmsg, sizeof(bdmsg), C_SUCCESS"[Barbut] "C_WHITE"%s"C_WHITE" vs "C_INFO"%s"C_WHITE": "C_INFO"%d"C_WHITE"-"C_INFO"%d"C_WHITE". Winner: "C_SUCCESS"%s",
                PlayerData[challengerid][pName], PlayerData[playerid][pName], roll1, roll2, PlayerData[winnerid][pName]);
            for(new bi = 0; bi < MAX_PLAYERS; bi++)
                if(IsPlayerConnected(bi) && PlayerData[bi][pLogged])
                    {
                        format(bdmsg, sizeof(bdmsg), T(bi, C_SUCCESS"[Barbut] "C_WHITE"%s"C_WHITE" vs "C_INFO"%s"C_WHITE": "C_INFO"%d"C_WHITE"-"C_INFO"%d"C_WHITE". Winner: "C_SUCCESS"%s"), PlayerData[challengerid][pName], PlayerData[playerid][pName], roll1, roll2, PlayerData[winnerid][pName]);
                        SCM(bi, COLOR_WHITE, bdmsg);
                    }
            return 1;
        }

        // ---- /accept fixphone / fixwatch (confirma o cerere de reparatie a Electricianului) ----
        if(strcmp(sub, "fixphone", true) == 0 || strcmp(sub, "fixwatch", true) == 0)
        {
            new bool:acIsPhone = (strcmp(sub, "fixphone", true) == 0);

            new wantType = acIsPhone ? 1 : 2;
            if(g_FixReqType[playerid] != wantType)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a pending offer of that type."), 1;
            if(gettime() > g_FixReqExpireAt[playerid])
            {
                g_FixReqType[playerid] = 0;
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That offer has expired."), 1;
            }

            new acFrom = g_FixReqFrom[playerid];
            new acAmount = g_FixReqAmount[playerid];

            if(!IsPlayerConnected(acFrom) || !PlayerData[acFrom][pLogged])
            {
                g_FixReqType[playerid] = 0;
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The electrician is no longer connected."), 1;
            }
            new Float:acfX, Float:acfY, Float:acfZ;
            GetPlayerPos(acFrom, acfX, acfY, acfZ);
            if(!IsPlayerInRangeOfPoint(playerid, ELECTRICIAN_RANGE, acfX, acfY, acfZ))
            {
                g_FixReqType[playerid] = 0;
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The electrician is no longer near you."), 1;
            }
            if(PlayerData[playerid][pMoney] < acAmount)
            {
                new acErr[96];
                format(acErr, sizeof(acErr), T(playerid, C_ERROR"Error: "C_WHITE"You don't have enough money ("C_INFO"$%s"C_WHITE")."), MoneyStr(acAmount));
                return SCM(playerid, COLOR_ERROR, acErr), 1;
            }

            PlayerData[playerid][pMoney] -= acAmount;
            GivePlayerMoney(playerid, -acAmount);
            UpdatePlayer(playerid, pMoney);

            PlayerData[acFrom][pMoney] += acAmount;
            GivePlayerMoney(acFrom, acAmount);
            UpdatePlayer(acFrom, pMoney);

            new acMsg[144];
            if(acIsPhone)
            {
                PlayerData[playerid][pPhoneExpire] += ELECTRICIAN_DEVICE_EXTEND_DAYS * 86400;
                UpdatePlayer(playerid, pPhoneExpire);
                format(acMsg, sizeof(acMsg), T(playerid, C_SUCCESS"Success: "C_WHITE"Your phone was fixed (+"C_INFO"%d days"C_WHITE") for "C_INFO"$%s"C_WHITE"."), ELECTRICIAN_DEVICE_EXTEND_DAYS, MoneyStr(acAmount));
            }
            else
            {
                PlayerData[playerid][pWatchExpire] += ELECTRICIAN_DEVICE_EXTEND_DAYS * 86400;
                UpdatePlayer(playerid, pWatchExpire);
                format(acMsg, sizeof(acMsg), T(playerid, C_SUCCESS"Success: "C_WHITE"Your watch was fixed (+"C_INFO"%d days"C_WHITE") for "C_INFO"$%s"C_WHITE"."), ELECTRICIAN_DEVICE_EXTEND_DAYS, MoneyStr(acAmount));
            }
            SCM(playerid, COLOR_SUCCESS, acMsg);

            format(acMsg, sizeof(acMsg), T(acFrom, C_SUCCESS"Success: "C_WHITE"%s"C_WHITE" accepted your fix and paid you "C_SUCCESS"$%s"C_WHITE"."),
                PlayerData[playerid][pName], MoneyStr(acAmount));
            SCM(acFrom, COLOR_SUCCESS, acMsg);

            g_FixReqType[playerid] = 0;
            return 1;
        }

        if(!strlen(p1) || (strcmp(sub, "finvite", true) != 0 && strcmp(sub, "fine", true) != 0))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/accept finvite [playerid]"C_WHITE" or "C_INFO"/accept fine [playerid]"C_WHITE"."), 1;

        if(strcmp(sub, "fine", true) == 0)
        {
            new officerid = strval(p1);

            if(g_PendingFineAmount[playerid] == 0 || g_PendingFineOfficer[playerid] != officerid)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a pending fine from this player."), 1;

            if(!IsPlayerConnected(officerid) || !PlayerData[officerid][pLogged])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The officer is no longer connected."), 1;

            new Float:ox, Float:oy, Float:oz;
            GetPlayerPos(officerid, ox, oy, oz);
            if(!IsPlayerInRangeOfPoint(playerid, FINE_RANGE, ox, oy, oz))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be within 15m of the officer who fined you."), 1;

            new amount = g_PendingFineAmount[playerid];
            new reason[128];
            format(reason, 128, "%s", g_PendingFineReason[playerid]);

            if(PlayerData[playerid][pMoney] < amount)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money to pay this fine."), 1;

            PlayerData[playerid][pMoney] -= amount;
            GivePlayerMoney(playerid, -amount);
            UpdatePlayer(playerid, pMoney);

            PlayerData[officerid][pMoney] += amount;
            GivePlayerMoney(officerid, amount);
            UpdatePlayer(officerid, pMoney);

            g_PendingFineAmount[playerid]  = 0;
            g_PendingFineOfficer[playerid] = 0;
            g_PendingFineReason[playerid][0] = EOS;

            new amsg2[160];
            format(amsg2, sizeof(amsg2), T(playerid, C_SUCCESS"Success: "C_WHITE"You paid the "C_INFO"$%s"C_WHITE" fine for: "C_INFO"%s"C_WHITE"."), MoneyStr(amount), reason);
            SCM(playerid, COLOR_SUCCESS, amsg2);

            format(amsg2, sizeof(amsg2), T(officerid, C_SUCCESS"Success: "C_WHITE"%s"C_WHITE" paid the "C_INFO"$%s"C_WHITE" fine you issued."), PlayerData[playerid][pName], MoneyStr(amount));
            SCM(officerid, COLOR_SUCCESS, amsg2);
            return 1;
        }

        new inviterid = strval(p1);

        if(g_InviteFaction[playerid] == 0 || g_InviteInviter[playerid] != inviterid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have a valid invitation from this player."), 1;

        if(!IsPlayerConnected(inviterid) || !PlayerData[inviterid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player who invited you is no longer connected."), 1;

        new Float:ix, Float:iy, Float:iz;
        GetPlayerPos(inviterid, ix, iy, iz);
        if(!IsPlayerInRangeOfPoint(playerid, FINVITE_RANGE, ix, iy, iz))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be within 15m of the player who invited you."), 1;

        new fid = g_InviteFaction[playerid];

        if(PlayerData[playerid][pFaction] != 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are already part of a faction."), 1;

        PlayerData[playerid][pFaction]     = fid;
        PlayerData[playerid][pFactionRank] = 1;
        PlayerData[playerid][pFactionJoin] = gettime();
        SetPlayerColor(playerid, FactionColors[fid]);
        Factions_SetPlayerIcons(playerid);

        FactionData[fid][fMembers]++;

        g_InviteFaction[playerid] = 0;
        g_InviteInviter[playerid] = 0;

        new facJoin[14];
        BuildDateSqlValueFromUnix(PlayerData[playerid][pFactionJoin], facJoin, sizeof(facJoin));

        new q[256];
        mysql_format(g_SQL, q, sizeof(q),
            "UPDATE `players` SET `faction`=%d, `faction_rank`=1, `faction_join`=%s WHERE `id`=%d",
            fid, facJoin, PlayerData[playerid][pID]);
        mysql_tquery(g_SQL, q, "", "", 0);

        mysql_format(g_SQL, q, sizeof(q), "UPDATE `factions` SET `members`=%d WHERE `id`=%d",
            FactionData[fid][fMembers], fid);
        mysql_tquery(g_SQL, q, "", "", 0);

        new amsg[160];
        format(amsg, sizeof(amsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You joined the faction "C_INFO"%s"C_WHITE"!"), FactionData[fid][fName]);
        SCM(playerid, COLOR_SUCCESS, amsg);

        format(amsg, sizeof(amsg), T(inviterid, C_INFO"Info: "C_WHITE"%s"C_WHITE" accepted your invitation and joined the faction."), PlayerData[playerid][pName]);
        SCM(inviterid, COLOR_INFO, amsg);
        return 1;
    }

    // ---- /factionstats [members/vehicles] (rank 5) ----
    if(strcmp(cmd, "/factionstats", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new fsFid = PlayerData[playerid][pFaction];
        if(fsFid < 1 || fsFid > MAX_FACTIONS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of a faction."), 1;

        if(PlayerData[playerid][pFactionRank] < 5)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires rank 5."), 1;

        new fsSub[256];
        fsSub = strtok(cmdtext, idx);

        // ---- /factionstats vehicles ----
        if(strlen(fsSub) && strcmp(fsSub, "vehicles", true) == 0)
        {
            new body[4500];
            format(body, sizeof(body), "%s\n\nVehicles:\n", FactionData[fsFid][fName]);

            for(new i = 0; i < g_VFactionCount; i++)
            {
                if(VFactionData[i][vfFactionID] != fsFid) continue;

                new vehid = g_VFactionVehicle[i];
                new bool:occupied = false;
                for(new p = 0; p < MAX_PLAYERS; p++)
                {
                    if(!IsPlayerConnected(p)) continue;
                    if(GetPlayerVehicleID(p) == vehid) { occupied = true; break; }
                }

                new vname[24];
                GetVehicleModelName(GetVehicleModel(vehid), vname, sizeof(vname));

                new vStatus[32]; // "{RRGGBB}" (8) + "occupied"/"unoccupied" (max 10) + "{RRGGBB}" (8) + EOS = max 27
                if(occupied) format(vStatus, sizeof(vStatus), C_ERROR"occupied"C_WHITE);
                else         format(vStatus, sizeof(vStatus), C_SUCCESS"unoccupied"C_WHITE);

                new wheelInfo[48];
                if(VFactionData[i][vfWheels] != 0)
                {
                    new wheelName[20];
                    Tuning_WheelName(VFactionData[i][vfWheels], wheelName, sizeof(wheelName));
                    new wheelExpStr[11];
                    UnixToDateStr(VFactionData[i][vfWheelsExp], wheelExpStr, sizeof(wheelExpStr));
                    format(wheelInfo, sizeof(wheelInfo), " (Wheel: %s, Exp: %s)", wheelName, wheelExpStr);
                }
                else
                    format(wheelInfo, sizeof(wheelInfo), " (Wheel: None)");

                new line[192];
                format(line, sizeof(line), "#%d - %s - Fuel: %d/100 - Odometer: %.1f km - %s%s\n",
                    VFactionData[i][vfID], vname, floatround(g_VehicleFuel[vehid]), VFactionData[i][vfKm], vStatus, wheelInfo);
                strcat(body, line);
            }

            SPD(playerid, DIALOG_FACTIONSTATS, DIALOG_STYLE_MSGBOX, FactionData[fsFid][fName], body, "Close", "");
            return 1;
        }

        // ---- /factionstats members ----
        if(strlen(fsSub) && strcmp(fsSub, "members", true) == 0)
        {
            new q[128];
            mysql_format(g_SQL, q, sizeof(q), "SELECT `username`,`faction_rank` FROM `players` WHERE `faction`=%d ORDER BY `faction_rank` DESC, `username` ASC", fsFid);
            mysql_tquery(g_SQL, q, "OnFactionStatsMembersLoaded", "ii", playerid, fsFid);
            return 1;
        }

        // ---- /factionstats (fara subcomanda): statistici generale ----
        new fsCount; new Float:fsTotalFuel;
        Faction_NeedsFuel(fsFid, fsCount, fsTotalFuel);

        new body[400];
        format(body, sizeof(body), T(playerid, "%s\n\nMembers: %d/%d\nVehicles: %d\nFuel vehicles: %d/%d\nBank: %d$"),
            FactionData[fsFid][fName], FactionData[fsFid][fMembers], FactionData[fsFid][fMaxMembers],
            fsCount, floatround(fsTotalFuel), 100 * fsCount, FactionData[fsFid][fBank]);

        SPD(playerid, DIALOG_FACTIONSTATS, DIALOG_STYLE_MSGBOX, FactionData[fsFid][fName], body, "Close", "");
        return 1;
    }

    // ---- /afactionstats [faction_id] [members/vehicles/bank] (admin 4+) ----
    if(strcmp(cmd, "/afactionstats", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 4)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 4."), 1;

        new afsIdStr[256];
        afsIdStr = strtok(cmdtext, idx);
        if(!strlen(afsIdStr))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/afactionstats [faction_id] [members/vehicles/bank]"C_WHITE"."), 1;

        new afsFid = strval(afsIdStr);
        if(afsFid < 1 || afsFid > MAX_FACTIONS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid faction ID."), 1;

        new afsSub[256];
        afsSub = strtok(cmdtext, idx);

        // ---- /afactionstats [id] vehicles ----
        if(strlen(afsSub) && strcmp(afsSub, "vehicles", true) == 0)
        {
            new body[4500];
            format(body, sizeof(body), "%s\n\nVehicles:\n", FactionData[afsFid][fName]);

            for(new i = 0; i < g_VFactionCount; i++)
            {
                if(VFactionData[i][vfFactionID] != afsFid) continue;

                new vehid = g_VFactionVehicle[i];
                new bool:occupied = false;
                for(new p = 0; p < MAX_PLAYERS; p++)
                {
                    if(!IsPlayerConnected(p)) continue;
                    if(GetPlayerVehicleID(p) == vehid) { occupied = true; break; }
                }

                new vname[24];
                GetVehicleModelName(GetVehicleModel(vehid), vname, sizeof(vname));

                new vStatus[32]; // "{RRGGBB}" (8) + "occupied"/"unoccupied" (max 10) + "{RRGGBB}" (8) + EOS = max 27
                if(occupied) format(vStatus, sizeof(vStatus), C_ERROR"occupied"C_WHITE);
                else         format(vStatus, sizeof(vStatus), C_SUCCESS"unoccupied"C_WHITE);

                new wheelInfo[48];
                if(VFactionData[i][vfWheels] != 0)
                {
                    new wheelName[20];
                    Tuning_WheelName(VFactionData[i][vfWheels], wheelName, sizeof(wheelName));
                    new wheelExpStr[11];
                    UnixToDateStr(VFactionData[i][vfWheelsExp], wheelExpStr, sizeof(wheelExpStr));
                    format(wheelInfo, sizeof(wheelInfo), " (Wheel: %s, Exp: %s)", wheelName, wheelExpStr);
                }
                else
                    format(wheelInfo, sizeof(wheelInfo), " (Wheel: None)");

                new line[192];
                format(line, sizeof(line), "#%d - %s - Fuel: %d/100 - Odometer: %.1f km - %s%s\n",
                    VFactionData[i][vfID], vname, floatround(g_VehicleFuel[vehid]), VFactionData[i][vfKm], vStatus, wheelInfo);
                strcat(body, line);
            }

            SPD(playerid, DIALOG_FACTIONSTATS, DIALOG_STYLE_MSGBOX, FactionData[afsFid][fName], body, "Close", "");
            return 1;
        }

        // ---- /afactionstats [id] members ----
        if(strlen(afsSub) && strcmp(afsSub, "members", true) == 0)
        {
            new q[128];
            mysql_format(g_SQL, q, sizeof(q), "SELECT `username`,`faction_rank` FROM `players` WHERE `faction`=%d ORDER BY `faction_rank` DESC, `username` ASC", afsFid);
            mysql_tquery(g_SQL, q, "OnFactionStatsMembersLoaded", "ii", playerid, afsFid);
            return 1;
        }

        // ---- /afactionstats [id] bank ----
        if(strlen(afsSub) && strcmp(afsSub, "bank", true) == 0)
        {
            new body[128];
            format(body, sizeof(body), T(playerid, "%s\n\nBank: %d$"), FactionData[afsFid][fName], FactionData[afsFid][fBank]);
            SPD(playerid, DIALOG_FACTIONSTATS, DIALOG_STYLE_MSGBOX, FactionData[afsFid][fName], body, "Close", "");
            return 1;
        }

        // ---- /afactionstats [id] (fara subcomanda): statistici generale ----
        new afsCount; new Float:afsTotalFuel;
        Faction_NeedsFuel(afsFid, afsCount, afsTotalFuel);

        new body[400];
        format(body, sizeof(body), T(playerid, "%s\n\nMembers: %d/%d\nVehicles: %d\nFuel vehicles: %d/%d\nBank: %d$"),
            FactionData[afsFid][fName], FactionData[afsFid][fMembers], FactionData[afsFid][fMaxMembers],
            afsCount, floatround(afsTotalFuel), 100 * afsCount, FactionData[afsFid][fBank]);

        SPD(playerid, DIALOG_FACTIONSTATS, DIALOG_STYLE_MSGBOX, FactionData[afsFid][fName], body, "Close", "");
        return 1;
    }

    // ---- /fbank ----
    if(strcmp(cmd, "/fbank", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new fid = PlayerData[playerid][pFaction];
        if(fid < 1 || fid > MAX_FACTIONS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of a faction."), 1;

        if(PlayerData[playerid][pFactionRank] < 4)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires rank 4 or higher."), 1;

        new bmsg[128];
        format(bmsg, sizeof(bmsg), T(playerid, C_INFO"Info: "C_WHITE"The faction "C_INFO"%s"C_WHITE" account has "C_INFO"$%s"C_WHITE"."),
            FactionData[fid][fName], MoneyStr(FactionData[fid][fBank]));
        SCM(playerid, COLOR_INFO, bmsg);
        return 1;
    }

    // ---- /fbankwithdraw [suma] ----
    if(strcmp(cmd, "/fbankwithdraw", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new fid = PlayerData[playerid][pFaction];
        if(fid < 1 || fid > MAX_FACTIONS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of a faction."), 1;

        if(PlayerData[playerid][pFactionRank] < 5)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires rank 5 (Lead)."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new p1[16];
        strmid(p1, cmdtext, idx, strlen(cmdtext), 16);

        if(!strlen(p1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/fbankwithdraw [amount]"C_WHITE"."), 1;

        new amount = strval(p1);
        if(amount <= 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid amount."), 1;

        if(amount > FactionData[fid][fBank])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The faction doesn't have enough money."), 1;

        FactionData[fid][fBank] -= amount;
        PlayerData[playerid][pMoney] += amount;
        GivePlayerMoney(playerid, amount);
        UpdatePlayer(playerid, pMoney);

        new q[128];
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `factions` SET `bank`=%d WHERE `id`=%d", FactionData[fid][fBank], fid);
        mysql_tquery(g_SQL, q, "", "", 0);

        new wmsg[128];
        format(wmsg, sizeof(wmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You withdrew "C_INFO"$%s"C_WHITE" from the faction account."), MoneyStr(amount));
        SCM(playerid, COLOR_SUCCESS, wmsg);
        return 1;
    }

    // ---- /fsetrank [playerid] [rank 1-5] ----
    if(strcmp(cmd, "/fsetrank", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new fid = PlayerData[playerid][pFaction];
        if(fid < 1 || fid > MAX_FACTIONS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of a faction."), 1;

        if(PlayerData[playerid][pFactionRank] < 5)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires rank 5 (Lead)."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new p1[8], p2[8];
        strmid(p1, cmdtext, idx, strlen(cmdtext), 8);
        new targetid = strval(p1);
        while(cmdtext[idx] > ' ') idx++;
        while(cmdtext[idx] == ' ') idx++;
        strmid(p2, cmdtext, idx, strlen(cmdtext), 8);

        if(!strlen(p1) || !strlen(p2))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/fsetrank [playerid] [rank 1-5]"C_WHITE"."), 1;

        new newRank = strval(p2);
        if(newRank < 1 || newRank > 5)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid rank (1-5)."), 1;

        if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        if(PlayerData[targetid][pFaction] != fid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not part of your faction."), 1;

        PlayerData[targetid][pFactionRank] = newRank;
        UpdatePlayer(targetid, pFactionRank);

        new rmsg[128];
        format(rmsg, sizeof(rmsg), T(playerid, C_SUCCESS"Success: "C_INFO"%s"C_WHITE"'s rank was changed to "C_INFO"%d"C_WHITE"."),
            PlayerData[targetid][pName], newRank);
        SCM(playerid, COLOR_SUCCESS, rmsg);

        format(rmsg, sizeof(rmsg), T(targetid, C_INFO"Info: "C_WHITE"Your rank in the faction was changed to "C_INFO"%d"C_WHITE" by the leader."), newRank);
        SCM(targetid, COLOR_INFO, rmsg);
        return 1;
    }

    // ---- /fkick, /funinvite [playerid] (rank 5 Lead: scoate un membru din propria factiune) ----
    if(strcmp(cmd, "/fkick", true) == 0 || strcmp(cmd, "/funinvite", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new fid = PlayerData[playerid][pFaction];
        if(fid < 1 || fid > MAX_FACTIONS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of a faction."), 1;

        if(PlayerData[playerid][pFactionRank] < 5)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires rank 5 (Lead)."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new fkp1[8];
        strmid(fkp1, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(fkp1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/fkick [playerid]"C_WHITE"."), 1;

        new targetid = strval(fkp1);
        if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        if(targetid == playerid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't kick yourself."), 1;

        if(PlayerData[targetid][pFaction] != fid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not part of your faction."), 1;

        if(PlayerData[targetid][pFactionRank] >= 5)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't kick another Lead."), 1;

        // Reseteaza playerul scos
        PlayerData[targetid][pFaction]     = 0;
        PlayerData[targetid][pFactionRank] = 0;
        PlayerData[targetid][pFactionJoin] = 0;
        SetPlayerColor(targetid, FactionColors[FACTION_NONE]);
        Factions_SetPlayerIcons(targetid);
        Player_RecalcSpawn(targetid);

        new q[160];
        mysql_format(g_SQL, q, sizeof(q),
            "UPDATE `players` SET `faction`=0, `faction_rank`=0, `faction_join`=NULL WHERE `id`=%d",
            PlayerData[targetid][pID]);
        mysql_tquery(g_SQL, q, "", "", 0);

        // Scade fMembers la factiune
        FactionData[fid][fMembers]--;
        if(FactionData[fid][fMembers] < 0) FactionData[fid][fMembers] = 0;
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `factions` SET `members`=%d WHERE `id`=%d",
            FactionData[fid][fMembers], fid);
        mysql_tquery(g_SQL, q, "", "", 0);

        new fkmsg[144];
        format(fkmsg, sizeof(fkmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You removed "C_INFO"%s"C_WHITE" from the faction."), PlayerData[targetid][pName]);
        SCM(playerid, COLOR_SUCCESS, fkmsg);
        SCM(targetid, COLOR_ERROR, C_ERROR"Info: "C_WHITE"You were kicked from your faction by the leader.");

        SetPlayerHealth(targetid, 0.0); // moare la scoaterea din factiune
        return 1;
    }

    // ---- /fhelp ----
    // ---- /fhelp (lista completa de comenzi, in functie de factiunea si rankul playerului) ----
    if(strcmp(cmd, "/fhelp", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new fhFid = PlayerData[playerid][pFaction];
        if(fhFid < 1 || fhFid > MAX_FACTIONS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of a faction."), 1;

        new fhRank = PlayerData[playerid][pFactionRank];

        SCM(playerid, COLOR_INFO, C_INFO"===== Your Faction Commands =================");
        SCM(playerid, COLOR_WHITE, C_INFO"[Any rank] "C_WHITE"/f /fhelp");

        if(fhFid >= 1 && fhFid <= 3)
            SCM(playerid, COLOR_WHITE, C_INFO"[Any rank] "C_WHITE"/duty");

        if(fhRank >= 4)
            SCM(playerid, COLOR_WHITE, C_INFO"[Rank 4+] "C_WHITE"/finvite /fbank");

        if(fhRank >= 5)
        {
            SCM(playerid, COLOR_WHITE, C_INFO"[Rank 5 (Lead)] "C_WHITE"/fbankwithdraw /fsetrank /fkick");
            SCM(playerid, COLOR_WHITE, C_INFO"[Rank 5+] "C_WHITE"/refillfactionveh /respawnfactionveh /factionstats");
        }

        if(fhFid == FACTION_POLICE || fhFid == FACTION_RAR)
        {
            SCM(playerid, COLOR_WHITE, C_INFO"[Police/DMV, On-Duty] "C_WHITE"/fine [playerid] [amount] [reason] /m [playerid] /inspectcar [playerid]");
        }

        if(fhFid == FACTION_POLICE)
        {
            SCM(playerid, COLOR_WHITE, C_INFO"[Police] "C_WHITE"/wanted /wantedlist /arrest /cuff /garage /entrace");
            SCM(playerid, COLOR_WHITE, C_INFO"[Police, On-Duty] "C_WHITE"/checklicenses /suspendlic /confiscate licence/insurance");
            if(fhRank >= 2)
                SCM(playerid, COLOR_WHITE, C_INFO"[Police, Rank 2+] "C_WHITE"/inspectplayer /radar install/remove");
            if(fhRank >= 4)
                SCM(playerid, COLOR_WHITE, C_INFO"[Police, Rank 4+] "C_WHITE"/showradars /removeradar");
        }

        if(fhFid == FACTION_RAR)
        {
            if(fhRank >= 3)
            {
                SCM(playerid, COLOR_WHITE, C_INFO"[DMV, Rank 3+] "C_WHITE"/tow /towpark");
                SCM(playerid, COLOR_WHITE, C_INFO"[DMV, Rank 3+, On-Duty] "C_WHITE"/confiscate extinctor/medkit/itp");
            }
        }

        if(fhFid == FACTION_SMURD)
            SCM(playerid, COLOR_WHITE, C_INFO"[SMURD, On-Duty] "C_WHITE"/heal [playerid]");

        if(fhFid >= MAFIA_FID_MIN && fhFid <= MAFIA_FID_MAX)
        {
            SCM(playerid, COLOR_WHITE, C_INFO"[Mafia] "C_WHITE"/equip /smuggle /war /warscore");
            SCM(playerid, COLOR_WHITE, C_INFO"[Mafia] "C_WHITE"/drugs transport/craft/get/use");
            if(fhRank >= 4)
            {
                SCM(playerid, COLOR_WHITE, C_INFO"[Mafia, Rank 4+] "C_WHITE"/seif /warsurrender");
                SCM(playerid, COLOR_WHITE, C_INFO"[Mafia, Rank 4+] "C_WHITE"Weapon-W license also unlocks a Sniper Rifle with /equip");
            }
        }

        if(fhFid == BILLBOARD_NEWS_FID)
        {
            SCM(playerid, COLOR_WHITE, C_INFO"[News] "C_WHITE"/cleanbb /newspaper open");
            if(fhRank >= 1)
                SCM(playerid, COLOR_WHITE, C_INFO"[News, Rank 1+] "C_WHITE"/news [text]");
            if(fhRank >= 2)
                SCM(playerid, COLOR_WHITE, C_INFO"[News, Rank 2+] "C_WHITE"/newspaper create/edit/sell");
            if(fhRank >= 3)
                SCM(playerid, COLOR_WHITE, C_INFO"[News, Rank 3+] "C_WHITE"/qa [playerid]/list/ask/del/end");
        }

        SCM(playerid, COLOR_INFO, C_INFO"____________________________________________");
        return 1;
    }

    // ---- /duty ----
    if(strcmp(cmd, "/duty", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new fid = PlayerData[playerid][pFaction];
        if(fid < 1 || fid > 3)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only factions 1-3 have a duty system."), 1;

        // Police Department: /duty se face la punctul dedicat (locations_admin "PR/duty"); restul factiunilor: interiorul HQ
        if(fid == FACTION_POLICE && (DUTY_LOC_X != 0.0 || DUTY_LOC_Y != 0.0))
        {
            if(GetPlayerInterior(playerid) != DUTY_LOC_INT || GetPlayerVirtualWorld(playerid) != DUTY_LOC_VW ||
               !IsPlayerInRangeOfPoint(playerid, DUTY_LOC_RANGE, DUTY_LOC_X, DUTY_LOC_Y, DUTY_LOC_Z))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the police duty point inside the LSPD."), 1;
        }
        else if(!Factions_IsInOwnInterior(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be inside your faction HQ interior to change your duty status."), 1;

        PlayerData[playerid][pOnDuty] = !PlayerData[playerid][pOnDuty];

        if(PlayerData[playerid][pOnDuty])
        {
            SCM(playerid, COLOR_SUCCESS, C_INFO"Info: "C_WHITE"You are now "C_SUCCESS"ON-DUTY"C_WHITE".");

            // Politia si RAR primesc arme de dotare pe tura - necesita permis W valabil
            if(fid == FACTION_POLICE || fid == FACTION_RAR)
            {
                if(!Player_HasValidLicense(playerid, LIC_W))
                    SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You did not receive any weapons - you don't have a valid Weapon W license. Get one with "C_INFO"/examW"C_WHITE".");
                else
                {
                    if(fid == FACTION_POLICE)
                    {
                        new prank = PlayerData[playerid][pFactionRank];
                        AC_GiveWeapon(playerid, WEAPON_DEAGLE, 150);
                        if(prank >= 3)
                        {
                            AC_GiveWeapon(playerid, WEAPON_MP5, 300);
                            AC_GiveWeapon(playerid, WEAPON_M4,  300);
                            AC_GiveWeapon(playerid, WEAPON_SPRAYCAN, 300);
                        }
                        else if(prank == 2)
                        {
                            AC_GiveWeapon(playerid, WEAPON_MP5, 300);
                            AC_GiveWeapon(playerid, WEAPON_SPRAYCAN, 200);
                        }
                        else
                            AC_GiveWeapon(playerid, WEAPON_SPRAYCAN, 100);
                    }
                    else // FACTION_RAR
                        AC_GiveWeapon(playerid, WEAPON_DEAGLE, 100);

                    g_DutyArmed[playerid] = true;
                    SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"You have been issued your duty weapons.");
                }
            }
        }
        else
        {
            SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"You are now "C_ERROR"OFF-DUTY"C_WHITE".");

            // Scoate armele de dotare primite pe tura (pastreaza restul armelor legitime)
            if(g_DutyArmed[playerid])
            {
                g_ACWeaponAllowed[playerid][WEAPON_DEAGLE]    = false; g_ACWeaponAmmo[playerid][WEAPON_DEAGLE]    = 0;
                g_ACWeaponAllowed[playerid][WEAPON_MP5]       = false; g_ACWeaponAmmo[playerid][WEAPON_MP5]       = 0;
                g_ACWeaponAllowed[playerid][WEAPON_M4]        = false; g_ACWeaponAmmo[playerid][WEAPON_M4]        = 0;
                g_ACWeaponAllowed[playerid][WEAPON_SPRAYCAN]  = false; g_ACWeaponAmmo[playerid][WEAPON_SPRAYCAN]  = 0;
                AC_RestoreWeapons(playerid);
                g_DutyArmed[playerid] = false;
            }
        }
        return 1;
    }

    // ---- /tune (Loco Outlaw Customs - modifica vehiculul in care esti soferul) ----
    if(strcmp(cmd, "/tune", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pFaction] != FACTION_TUNING)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of Loco Outlaw Customs."), 1;

        new tVehid = GetPlayerVehicleID(playerid);
        if(tVehid == 0 || GetPlayerVehicleSeat(playerid) != 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be the driver of the vehicle you want to tune."), 1;

        if(!Tuning_IsPlayerAtPoint(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not at a Loco Outlaw Customs tuning point."), 1;

        new tEngine, tLights, tAlarm, tDoors, tBonnet, tBoot, tObjective;
        GetVehicleParamsEx(tVehid, tEngine, tLights, tAlarm, tDoors, tBonnet, tBoot, tObjective);

        if(tEngine != 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Turn off the engine first ("C_INFO"/changecar engine"C_WHITE")."), 1;

        if(tBonnet != 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Open the hood first ("C_INFO"/changecar hood"C_WHITE")."), 1;

        g_TuningVehicle[playerid] = tVehid;
        SPD(playerid, DIALOG_TUNING_CATEGORY, DIALOG_STYLE_LIST,
            "Loco Outlaw Customs - Tuning",
            "Spoiler\nHood\nRoof\nSide Skirt\nFront Bumper\nRear Bumper\nExhaust\nWheels\nNitro\nHydraulics\nPaintjob\nRemove All Mods",
            "Select", "Cancel");
        return 1;
    }

    // ---- /pray (o data pe zi; duminica deschide si panoul de confesiune al pacatelor saptamanii) ----
    if(strcmp(cmd, "/pray", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(!Church_AtPrayPoint(playerid))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the prayer point inside a church ("C_INFO"[ Use /pray ]"C_WHITE")."), 1;

        new prToday = gettime() - (gettime() % 86400);
        if(PlayerData[playerid][pLastPray] == prToday)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already prayed today."), 1;

        PlayerData[playerid][pLastPray] = prToday;
        UpdatePlayer(playerid, pLastPray);

        new prWeek = Pray_GetWeekNumber();
        new prQ[220];
        mysql_format(g_SQL, prQ, sizeof(prQ),
            "INSERT INTO `pacate` (`pID`,`weekNo`,`prayedTimes`) VALUES (%d,%d,1) ON DUPLICATE KEY UPDATE `prayedTimes` = `prayedTimes` + 1",
            PlayerData[playerid][pID], prWeek);
        mysql_tquery(g_SQL, prQ, "", "", 0);

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"You prayed for forgiveness.");

        new prYear, prMonth, prDay;
        getdate(prYear, prMonth, prDay);
        if(DayOfWeek(prYear, prMonth, prDay) == 0) // Duminica -> panoul de confesiune
        {
            SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"It's Sunday - confess this week's sins.");
            Pacate_Show(playerid);
        }

        return 1;
    }

    // ---- /sinlist (informativ - cele 12 pacate ale saptamanii, /pray) ----
    if(strcmp(cmd, "/sinlist", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new lpBody[2000];
        format(lpBody, sizeof(lpBody), T(playerid, ""C_INFO"1. Defying the Law\n"C_WHITE"You refused to surrender/pull over at the Police's command, even though you were cornered or outnumbered.\n\n\
"C_INFO"2. Greed for Money\n"C_WHITE"You stole, robbed ("C_INFO"/rob"C_WHITE") or scammed another player for profit.\n\n\
"C_INFO"3. The Vice of Gambling\n"C_WHITE"You gambled recklessly at the casino, risking money you couldn't afford to lose.\n\n\
"C_INFO"4. Anti-Nature\n"C_WHITE"You didn't plant a single tree this week and didn't water the vegetation (at least one Water Hauler shift).\n\n\
"C_INFO"5. Trafficking Without Restraint\n"C_WHITE"You smuggled or hoarded more goods/weapons than you needed, out of pure greed.\n\n\
"C_INFO"6. Bloody Revenge\n"C_WHITE"You killed or attacked someone out of anger or a desire for revenge, not necessity.\n\n\
"C_INFO"7. Witness to Illegal Vehicle Modifications\n"C_WHITE"You were a passenger in a vehicle that had "C_INFO"/tune"C_WHITE" used on it by Loco Outlaw Customs members.\n\n\
"C_INFO"8. Reckless Speeding\n"C_WHITE"You drove at excessive speed or defied a radar, endangering others on the road.\n\n\
"C_INFO"9. Time Served Behind Bars\n"C_WHITE"You spent time in jail this week, paying for your actions.\n\n\
"C_INFO"10. Drink and Vice\n"C_WHITE"You got drunk or used illegal substances without restraint.\n\n\
"C_INFO"11. Breaking the Fast\n"C_WHITE"You ate meat on Wednesday or Friday, days of fasting.\n\n\
"C_INFO"12. Disregard for Road Law\n"C_WHITE"You tried to drive or fly without a valid license."));

        SPD(playerid, DIALOG_PACATE_LIST, DIALOG_STYLE_MSGBOX, "The 12 Sins of the Week", lpBody, "Close", "");
        return 1;
    }

    // ---- /quest (= /quests): quest-urile saptamanale ale religiei + quest-urile evenimentului
    //      sezonier daca ruleaza unul; plateste recompensele nou-indeplinite ----
    if(strcmp(cmd, "/quest", true) == 0 || strcmp(cmd, "/quests", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        Quest_ShowStatus(playerid);
        return 1;
    }

    // ---- /holiday [start/pause/stop/hide/name/reset/quest/obj] - administrarea evenimentului (admin 4) ----
    //      NOTA: numele comenzii nu e "/event" pentru ca acela e deja folosit de mini-evenimentele
    //      PvP (race/cs/htm/custom). Exista UN SINGUR eveniment, cu nume configurabil: de Halloween
    //      il numesti "Halloween", in decembrie "Christmas". Jucatorii NU folosesc /holiday - ei isi
    //      vad quest-urile in /quest, si doar cat timp evenimentul e pornit.
    if(strcmp(cmd, "/holiday", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pAdminLevel] < 4)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 4. Use "C_INFO"/quest"C_WHITE" to see event quests."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new evSub[16], evSa = 0;
        while(cmdtext[idx] > ' ' && evSa < 15) { evSub[evSa++] = cmdtext[idx]; idx++; }
        evSub[evSa] = EOS;

        // fara argument: dialogul cu toate subcomenzile si parametrii lor
        if(!strlen(evSub))
        {
            Event_ShowHelp(playerid);
            return 1;
        }

        // ---- /holiday start | pause | stop | hide - cele 4 trepte de stare ----
        if(strcmp(evSub, "start", true) == 0 || strcmp(evSub, "pause", true) == 0 ||
           strcmp(evSub, "stop",  true) == 0 || strcmp(evSub, "hide",  true) == 0)
        {
            new evNewState;
            if(strcmp(evSub, "start", true) == 0)      evNewState = EVENT_STATE_START;
            else if(strcmp(evSub, "pause", true) == 0) evNewState = EVENT_STATE_PAUSE;
            else if(strcmp(evSub, "stop",  true) == 0) evNewState = EVENT_STATE_STOP;
            else                                       evNewState = EVENT_STATE_HIDE;

            if(g_EventState == evNewState)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The holiday is already in that state."), 1;

            new evWasVisible = Event_VisibleOn();
            new evOldName[48];
            format(evOldName, sizeof(evOldName), "%s", g_EventName);

            Event_SetState(evNewState, PlayerData[playerid][pName]);

            new evStName[16];
            Event_StateName(evNewState, evStName, sizeof(evStName));

            new evMsg[192];
            format(evMsg, sizeof(evMsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Holiday "C_INFO"%s"C_WHITE" is now "C_INFO"%s"C_WHITE"."), evOldName, evStName);
            SCM(playerid, COLOR_SUCCESS, evMsg);

            // Anunta jucatorii doar cand se schimba VIZIBILITATEA: a devenit public, sau a disparut.
            // Trecerile start<->pause<->stop nu merita un anunt global (quest-urile raman la vedere).
            new evNowVisible = (evNewState >= EVENT_STATE_STOP) ? 1 : 0;
            if(evNowVisible != evWasVisible)
            {
                new evBcast[176];
                for(new i = 0; i < MAX_PLAYERS; i++)
                {
                    if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;

                    if(evNowVisible)
                        format(evBcast, sizeof(evBcast), T(i, C_SUCCESS"[Event] "C_WHITE"The "C_INFO"%s"C_WHITE" event has started! Type "C_INFO"/quest"C_WHITE" to see the quests."), evOldName);
                    else
                        format(evBcast, sizeof(evBcast), T(i, C_INFO"[Event] "C_WHITE"The "C_INFO"%s"C_WHITE" event has ended."), evOldName);

                    SCM(i, evNowVisible ? COLOR_SUCCESS : COLOR_INFO, evBcast);
                }
            }
            return 1;
        }

        // ---- /holiday name [nume nou] - redenumeste sarbatoarea ----
        if(strcmp(evSub, "name", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new evNewName[48];
            strmid(evNewName, cmdtext, idx, strlen(cmdtext), 48);

            if(!strlen(evNewName))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/holiday name [new name]"C_WHITE" (e.g. Halloween, Christmas)."), 1;

            new evOldName[48];
            format(evOldName, sizeof(evOldName), "%s", g_EventName);
            Event_Rename(evNewName, PlayerData[playerid][pName]);

            new evRnMsg[192];
            format(evRnMsg, sizeof(evRnMsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Holiday renamed from "C_INFO"%s"C_WHITE" to "C_INFO"%s"C_WHITE"."), evOldName, evNewName);
            SCM(playerid, COLOR_SUCCESS, evRnMsg);
            return 1;
        }

        // ---- /holiday reset - sterge progresul tuturor jucatorilor ----
        // De folosit cand treci la alta sarbatoare, ca sa nu se mosteneasca progresul pe un
        // `quest_key` refolosit (ex. "collect_items" atat la Halloween cat si la Craciun).
        if(strcmp(evSub, "reset", true) == 0)
        {
            Event_ResetProgress();
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"All player progress for the holiday quests has been wiped.");
            return 1;
        }

        // ---- /holiday quest [name [key] [nume nou]] - quest-urile evenimentului ----
        if(strcmp(evSub, "quest", true) == 0 || strcmp(evSub, "quests", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new qSub[12], qsA = 0;
            while(cmdtext[idx] > ' ' && qsA < 11) { qSub[qsA++] = cmdtext[idx]; idx++; }
            qSub[qsA] = EOS;

            // fara argument: lista quest-urilor (de aici se iau quest_key-urile)
            if(!strlen(qSub))
            {
                Event_QuestList(playerid);
                return 1;
            }

            // toate subcomenzile de mai jos incep cu quest_key
            while(cmdtext[idx] == ' ') idx++;
            new evqKey[EVENT_KEY_LEN], evqkA = 0;
            while(cmdtext[idx] > ' ' && evqkA < EVENT_KEY_LEN - 1) { evqKey[evqkA++] = cmdtext[idx]; idx++; }
            evqKey[evqkA] = EOS;

            // /holiday quest add [key] [type] [target] [reward] [nume] - creeaza sau actualizeaza
            if(strcmp(qSub, "add", true) == 0)
            {
                while(cmdtext[idx] == ' ') idx++;
                new evqTypeStr[16], evqtA = 0;
                while(cmdtext[idx] > ' ' && evqtA < 15) { evqTypeStr[evqtA++] = cmdtext[idx]; idx++; }
                evqTypeStr[evqtA] = EOS;

                while(cmdtext[idx] == ' ') idx++;
                new evqTargetStr[12], evqgA = 0;
                while(cmdtext[idx] > ' ' && evqgA < 11) { evqTargetStr[evqgA++] = cmdtext[idx]; idx++; }
                evqTargetStr[evqgA] = EOS;

                while(cmdtext[idx] == ' ') idx++;
                new evqRewardStr[12], evqrA = 0;
                while(cmdtext[idx] > ' ' && evqrA < 11) { evqRewardStr[evqrA++] = cmdtext[idx]; idx++; }
                evqRewardStr[evqrA] = EOS;

                while(cmdtext[idx] == ' ') idx++;
                new evqNameStr[48];
                strmid(evqNameStr, cmdtext, idx, strlen(cmdtext), 48);

                if(!strlen(evqKey) || !strlen(evqTypeStr) || !strlen(evqTargetStr) || !strlen(evqRewardStr) || !strlen(evqNameStr))
                {
                    SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/holiday quest add [key] [type] [target] [reward] [name]"C_WHITE".");
                    SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Types: "C_INFO"collect"C_WHITE" (only one playable now), checkpoint, costume, survival, visit.");
                    return 1;
                }

                new evqType = Event_TypeFromArg(evqTypeStr);
                if(evqType == -1)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid type. Use "C_INFO"collect/checkpoint/costume/survival/visit"C_WHITE" or 1-5."), 1;

                new evqTargetVal = strval(evqTargetStr), evqRewardVal = strval(evqRewardStr);
                if(evqTargetVal < 1)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Target must be at least 1."), 1;
                if(evqRewardVal < 0)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Reward cannot be negative."), 1;

                Event_QuestAdd(playerid, evqKey, evqType, evqTargetVal, evqRewardVal, evqNameStr);
                return 1;
            }

            // /holiday quest name [key] [nume nou]
            if(strcmp(qSub, "name", true) == 0)
            {
                while(cmdtext[idx] == ' ') idx++;
                new evqNewName[48];
                strmid(evqNewName, cmdtext, idx, strlen(cmdtext), 48);

                if(!strlen(evqKey) || !strlen(evqNewName))
                    return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/holiday quest name [quest_key] [new name]"C_WHITE"."), 1;

                format(g_EventQPendText[playerid], 128, "%s", evqNewName);
                Event_QuestCheck(playerid, evqKey, "OnEventQuestRenameChecked");
                return 1;
            }

            // /holiday quest desc [key] [descriere]
            if(strcmp(qSub, "desc", true) == 0)
            {
                while(cmdtext[idx] == ' ') idx++;
                new evqDescStr[128];
                strmid(evqDescStr, cmdtext, idx, strlen(cmdtext), 128);

                if(!strlen(evqKey) || !strlen(evqDescStr))
                    return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/holiday quest desc [quest_key] [description]"C_WHITE"."), 1;

                format(g_EventQPendText[playerid], 128, "%s", evqDescStr);
                Event_QuestCheck(playerid, evqKey, "OnEventQuestDescChecked");
                return 1;
            }

            // /holiday quest del [key]
            if(strcmp(qSub, "del", true) == 0)
            {
                if(!strlen(evqKey))
                    return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/holiday quest del [quest_key]"C_WHITE"."), 1;

                Event_QuestCheck(playerid, evqKey, "OnEventQuestDelChecked");
                return 1;
            }

            // /holiday quest start|pause|stop|hide [key] - starea UNUI quest, aceleasi patru
            // trepte ca la sarbatoare. Acceptat si ca "/holiday quest state [key] [stare]".
            new evqState = Event_StateFromArg(qSub);
            if(evqState == -1 && strcmp(qSub, "state", true) == 0)
            {
                while(cmdtext[idx] == ' ') idx++;
                new evqStStr[16], evqsA = 0;
                while(cmdtext[idx] > ' ' && evqsA < 15) { evqStStr[evqsA++] = cmdtext[idx]; idx++; }
                evqStStr[evqsA] = EOS;

                evqState = Event_StateFromArg(evqStStr);
                if(evqState == -1)
                    return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/holiday quest state [quest_key] [start/pause/stop/hide]"C_WHITE"."), 1;
            }

            if(evqState != -1)
            {
                if(!strlen(evqKey))
                {
                    SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/holiday quest start|pause|stop|hide [quest_key]"C_WHITE" - see "C_INFO"/holiday quest"C_WHITE".");
                    SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"start: everything on | pause: no objects, progress kept | stop: frozen but listed | hide: gone from "C_INFO"/quest"C_WHITE".");
                    return 1;
                }

                g_EventQPendState[playerid] = evqState;
                Event_QuestCheck(playerid, evqKey, "OnEventQuestStateChecked");
                return 1;
            }

            Event_ShowHelp(playerid);
            return 1;
        }

        // ---- /holiday npc [add/list/del] - personajele statice (zombi etc.) ----
        if(strcmp(evSub, "npc", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new npcSub[12], npcA = 0;
            while(cmdtext[idx] > ' ' && npcA < 11) { npcSub[npcA++] = cmdtext[idx]; idx++; }
            npcSub[npcA] = EOS;

            if(!strlen(npcSub))
            {
                Event_ShowHelp(playerid);
                return 1;
            }

            // /holiday npc list
            if(strcmp(npcSub, "list", true) == 0)
            {
                Event_NpcList(playerid);
                return 1;
            }

            // /holiday npc add [quest_key] [skin] [behaviour]
            if(strcmp(npcSub, "add", true) == 0)
            {
                while(cmdtext[idx] == ' ') idx++;
                new nQuest[EVENT_KEY_LEN], nqA = 0;
                while(cmdtext[idx] > ' ' && nqA < EVENT_KEY_LEN - 1) { nQuest[nqA++] = cmdtext[idx]; idx++; }
                nQuest[nqA] = EOS;

                while(cmdtext[idx] == ' ') idx++;
                new nSkinStr[12], nsA = 0;
                while(cmdtext[idx] > ' ' && nsA < 11) { nSkinStr[nsA++] = cmdtext[idx]; idx++; }
                nSkinStr[nsA] = EOS;

                while(cmdtext[idx] == ' ') idx++;
                new nBehStr[16];
                strmid(nBehStr, cmdtext, idx, strlen(cmdtext), 16);

                if(!strlen(nQuest) || !strlen(nSkinStr))
                {
                    SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/holiday npc add [quest_key] [skin] [behaviour]"C_WHITE" - behaviour is optional.");
                    SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Leave it out for "C_INFO"mixed"C_WHITE": each player gets a different type for the same character.");
                    SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Or force one: "C_INFO"idle"C_WHITE" (0), "C_INFO"peaceful"C_WHITE" (1), "C_INFO"aggressive"C_WHITE" (2), "C_INFO"random"C_WHITE" (3).");
                    return 1;
                }

                new nSkin = strval(nSkinStr);
                if(nSkin <= 0 || nSkin > 311)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid skin id (1-311)."), 1;

                // fara al treilea argument -> mixed (tip per jucator)
                new nBeh = EVENT_NPC_MIXED;
                if(strlen(nBehStr))
                {
                    nBeh = Event_BehaviourFromArg(nBehStr);
                    if(nBeh == -2)
                        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid behaviour. Use "C_INFO"mixed/idle/peaceful/aggressive/random"C_WHITE" or 0-3."), 1;
                }

                Event_NpcAdd(playerid, nQuest, nSkin, nBeh);
                return 1;
            }

            // /holiday npc del [id]
            if(strcmp(npcSub, "del", true) == 0)
            {
                while(cmdtext[idx] == ' ') idx++;
                new nIdStr[12];
                strmid(nIdStr, cmdtext, idx, strlen(cmdtext), 12);

                if(!strlen(nIdStr))
                    return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/holiday npc del [id]"C_WHITE" - see "C_INFO"/holiday npc list"C_WHITE"."), 1;

                new nId = strval(nIdStr);
                if(nId <= 0)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid character id."), 1;

                Event_NpcCheck(playerid, nId, "OnEventNpcDelChecked");
                return 1;
            }

            // /holiday npc goto [id] - teleport la personaj, pentru verificare
            if(strcmp(npcSub, "goto", true) == 0)
            {
                while(cmdtext[idx] == ' ') idx++;
                new nGotoStr[12];
                strmid(nGotoStr, cmdtext, idx, strlen(cmdtext), 12);

                if(!strlen(nGotoStr))
                    return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/holiday npc goto [id]"C_WHITE" - see "C_INFO"/holiday npc list"C_WHITE"."), 1;

                new nGotoId = strval(nGotoStr);
                if(nGotoId <= 0)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid character id."), 1;

                new ngq[200];
                mysql_format(g_SQL, ngq, sizeof(ngq),
                    "SELECT `x`,`y`,`z`,`angle`,`interior`,`world` FROM `event_npcs` WHERE `id`=%d LIMIT 1", nGotoId);
                mysql_tquery(g_SQL, ngq, "OnEventNpcGotoLoaded", "i", playerid);
                return 1;
            }

            Event_ShowHelp(playerid);
            return 1;
        }

        // ---- /holiday obj [add/list/model/del/goto] - obiectele evenimentului ----
        if(strcmp(evSub, "obj", true) == 0)
        {
            while(cmdtext[idx] == ' ') idx++;
            new objSub[12], objA = 0;
            while(cmdtext[idx] > ' ' && objA < 11) { objSub[objA++] = cmdtext[idx]; idx++; }
            objSub[objA] = EOS;

            if(!strlen(objSub))
            {
                Event_ShowHelp(playerid);
                return 1;
            }

            // /holiday obj add [quest_key] [model] - salveaza pozitia curenta
            if(strcmp(objSub, "add", true) == 0)
            {
                while(cmdtext[idx] == ' ') idx++;
                new oQuest[EVENT_KEY_LEN], oqA = 0;
                while(cmdtext[idx] > ' ' && oqA < EVENT_KEY_LEN - 1) { oQuest[oqA++] = cmdtext[idx]; idx++; }
                oQuest[oqA] = EOS;

                while(cmdtext[idx] == ' ') idx++;
                new oModelStr[12];
                strmid(oModelStr, cmdtext, idx, strlen(cmdtext), 12);

                if(!strlen(oQuest) || !strlen(oModelStr))
                    return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/holiday obj add [quest_key] [model]"C_WHITE" - see "C_INFO"/holiday quest"C_WHITE"."), 1;

                new oModel = strval(oModelStr);
                if(oModel <= 0)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid object model."), 1;

                Event_ObjAdd(playerid, oQuest, oModel);
                return 1;
            }

            // /holiday obj list [quest_key] - quest_key optional
            if(strcmp(objSub, "list", true) == 0)
            {
                while(cmdtext[idx] == ' ') idx++;
                new lQuest[EVENT_KEY_LEN];
                strmid(lQuest, cmdtext, idx, strlen(cmdtext), EVENT_KEY_LEN);

                Event_ObjList(playerid, lQuest);
                return 1;
            }

            // celelalte au nevoie de un id
            while(cmdtext[idx] == ' ') idx++;
            new oIdStr[12], oiA = 0;
            while(cmdtext[idx] > ' ' && oiA < 11) { oIdStr[oiA++] = cmdtext[idx]; idx++; }
            oIdStr[oiA] = EOS;

            if(!strlen(oIdStr))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/holiday obj [model/del/goto] [id]"C_WHITE" - see "C_INFO"/holiday obj list"C_WHITE"."), 1;

            new oId = strval(oIdStr);
            if(oId <= 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid object id."), 1;

            // /holiday obj model [id] [model] - schimba modelul obiectului salvat
            if(strcmp(objSub, "model", true) == 0)
            {
                while(cmdtext[idx] == ' ') idx++;
                new nmStr[12];
                strmid(nmStr, cmdtext, idx, strlen(cmdtext), 12);

                if(!strlen(nmStr))
                    return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/holiday obj model [id] [new model]"C_WHITE"."), 1;

                new nModel = strval(nmStr);
                if(nModel <= 0)
                    return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid object model."), 1;

                Event_ObjCheck(playerid, oId, nModel, "OnEventObjModelChecked");
                return 1;
            }

            // /holiday obj del [id]
            if(strcmp(objSub, "del", true) == 0)
            {
                Event_ObjCheck(playerid, oId, 0, "OnEventObjDeleteChecked");
                return 1;
            }

            // /holiday obj goto [id] - teleport la obiect, pentru verificare
            if(strcmp(objSub, "goto", true) == 0)
            {
                new gq[180];
                mysql_format(g_SQL, gq, sizeof(gq),
                    "SELECT `x`,`y`,`z`,`interior`,`world` FROM `event_objects` WHERE `id`=%d LIMIT 1", oId);
                mysql_tquery(g_SQL, gq, "OnEventObjGotoLoaded", "i", playerid);
                return 1;
            }

            Event_ShowHelp(playerid);
            return 1;
        }

        // subcomanda necunoscuta: acelasi dialog de ajutor
        Event_ShowHelp(playerid);
        return 1;
    }

    // ---- /en (seteaza limba la engleza) ----
    if(strcmp(cmd, "/en", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        format(PlayerData[playerid][pLanguage], 3, "en");
        Lang_SetPlayer(playerid, "en");
        UpdatePlayer(playerid, pLanguage);

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"Language set to "C_INFO"English"C_WHITE".");
        return 1;
    }

    // ---- /ro (seteaza limba la romana) ----
    if(strcmp(cmd, "/ro", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        format(PlayerData[playerid][pLanguage], 3, "ro");
        Lang_SetPlayer(playerid, "ro");
        UpdatePlayer(playerid, pLanguage);

        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"Limba a fost setata la "C_INFO"Romana"C_WHITE".");
        return 1;
    }

    // ---- /setreligion (alege religia din 4 optiuni) ----
    if(strcmp(cmd, "/setreligion", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        SPD(playerid, DIALOG_SET_RELIGION, DIALOG_STYLE_LIST, "Choose your religion",
            "Ateu\nThe Ascendants\nThe Holy Order\nThe Divine Blessing", "Select", "Cancel");
        return 1;
    }

    // ---- /whatreligion (informativ - detaliile celor 4 religii) ----
    if(strcmp(cmd, "/whatreligion", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new wrBody[2200];
        format(wrBody, sizeof(wrBody), T(playerid, ""C_INFO"1. ATHEISTS "C_WHITE"(The Rationalists / No Faith)\n\
We reject the supernatural and believe that the world operates through natural laws, science, and reason. There is no divine force guiding us - we are responsible for our own destiny and morality. Spirituality is not needed to be ethical or fulfilled; compassion and critical thinking are enough. The universe doesn't care about us, which is why we must create our own meaning and protect each other through logic and evidence. Faith is comforting but it blinds people from truth.\n\n\
"C_INFO"2. THE ASCENDANTS "C_WHITE"(Modern church)\n\
We believe that humanity is constantly evolving toward a higher form of existence, beyond material and traditional limits. Spirituality is not found in the past or in religion, but in progress and personal transcendence. The future belongs to those who understand that human consciousness can be elevated through knowledge, technology, and enlightenment. The world is a universe in constant upgrade.\n\n\
"C_INFO"3. THE HOLY ORDER "C_WHITE"(Medieval church)\n\
Our faith is rooted in tradition, sacrifice, and devotion to eternal values. The world is full of evil and temptation, but through asceticism and pure faith you can achieve spiritual salvation. Honor, loyalty, and respect for divine law are the moral pillars of existence. The future is built on the strong foundations of the past.\n\n\
"C_INFO"4. THE DIVINE BLESSING "C_WHITE"(Santa Luz - Hispanic/Colonial church)\n\
We are connected with nature, with community, and with the supreme good that watches over us. Spirituality lives in honest work, in love for our fellow man, and in respect for the sacred that surrounds us. Our beliefs are simple but powerful - goodness, compassion, and harmony with the earth are the path to peace. The world is a blessing, not a battle."));

        SPD(playerid, DIALOG_WHAT_RELIGION, DIALOG_STYLE_MSGBOX, "Religions", wrBody, "Close", "");
        return 1;
    }

    // ---- /heal [playerid] ----
    if(strcmp(cmd, "/heal", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pFaction] != FACTION_SMURD)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of SMURD."), 1;

        if(!PlayerData[playerid][pOnDuty])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be on-duty to use this command."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new p1[8];
        strmid(p1, cmdtext, idx, strlen(cmdtext), 8);

        if(!strlen(p1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/heal [playerid]"C_WHITE"."), 1;

        new targetid = strval(p1);
        if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        if(GetPlayerState(targetid) != PLAYER_STATE_PASSENGER || GetVehicleModel(GetPlayerVehicleID(targetid)) != AMBULANCE_MODEL)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player must be a passenger in an ambulance."), 1;

        if(PlayerData[targetid][pMoney] < HEAL_PRICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player doesn't have enough money."), 1;

        SetPlayerHealth(targetid, 100.0);

        PlayerData[targetid][pMoney] -= HEAL_PRICE;
        GivePlayerMoney(targetid, -HEAL_PRICE);
        UpdatePlayer(targetid, pMoney);

        Faction_AddBank(FACTION_SMURD, HEAL_PRICE);

        new healMsg[32];
        format(healMsg, sizeof(healMsg), T(targetid, "Healed. -$%s"), MoneyStr(HEAL_PRICE));
        GTP(targetid, healMsg, 3000, 1);

        new hmsg[128];
        format(hmsg, sizeof(hmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You healed "C_INFO"%s"C_WHITE" for "C_INFO"$%s"C_WHITE"."),
            PlayerData[targetid][pName], MoneyStr(HEAL_PRICE));
        SCM(playerid, COLOR_SUCCESS, hmsg);
        return 1;
    }

    // ---- /wanted [playerid] [wanted_level 0-6] [reason] (Politia rank 1+) ----
    if(strcmp(cmd, "/wanted", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pFaction] != FACTION_POLICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only Police Department can use this."), 1;
        if(PlayerData[playerid][pFactionRank] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires faction rank 1+."), 1;
        if(!PlayerData[playerid][pOnDuty])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be on-duty to use this command."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new wp1[8]; strmid(wp1, cmdtext, idx, strlen(cmdtext), 8);
        while(cmdtext[idx] > ' ') idx++; while(cmdtext[idx] == ' ') idx++;
        new wp2[8]; strmid(wp2, cmdtext, idx, strlen(cmdtext), 8);
        while(cmdtext[idx] > ' ') idx++; while(cmdtext[idx] == ' ') idx++;
        new wreason[128]; strmid(wreason, cmdtext, idx, strlen(cmdtext), 128);

        if(!strlen(wp1) || !strlen(wp2))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/wanted [playerid] [wanted_level 0-6] [reason]"C_WHITE"."), 1;

        new wtarget = strval(wp1);
        new wlevel  = strval(wp2);
        if(!IsPlayerConnected(wtarget) || !PlayerData[wtarget][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;
        if(wlevel < 0 || wlevel > 6)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Wanted level must be between 0 and 6."), 1;
        if(!strlen(wreason)) format(wreason, sizeof(wreason), "No reason");

        PlayerData[wtarget][pWanted] = wlevel;
        SetPlayerWantedLevel(wtarget, wlevel);
        UpdatePlayer(wtarget, pWanted);

        if(wlevel > 0) Pray_FlagSin(wtarget, 1); // Sfidarea legii

        new wmsg[220];
        format(wmsg, sizeof(wmsg), C_INFO"[P.R.] "C_WHITE"Officer "C_INFO"%s"C_WHITE" (rank %d) set "C_INFO"%s"C_WHITE"'s wanted level to "C_INFO"%d star(s)"C_WHITE".",
            PlayerData[playerid][pName], PlayerData[playerid][pFactionRank], PlayerData[wtarget][pName], PlayerData[wtarget][pWanted]);
        for(new i = 0; i < MAX_PLAYERS; i++)
            if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pFaction] == FACTION_POLICE)
                {
                    format(wmsg, sizeof(wmsg), T(i, C_INFO"[P.R.] "C_WHITE"Officer "C_INFO"%s"C_WHITE" (rank %d) set "C_INFO"%s"C_WHITE"'s wanted level to "C_INFO"%d star(s)"C_WHITE"."), PlayerData[playerid][pName], PlayerData[playerid][pFactionRank], PlayerData[wtarget][pName], PlayerData[wtarget][pWanted]);
                    SCM(i, COLOR_WHITE, wmsg);
                }

        new wtmsg[200];
        format(wtmsg, sizeof(wtmsg), T(wtarget, C_ERROR"[WANTED] "C_WHITE"Officer "C_INFO"%s"C_WHITE" set your wanted level to "C_INFO"%d star(s)"C_WHITE". Reason: "C_INFO"%s"),
            PlayerData[playerid][pName], PlayerData[wtarget][pWanted], wreason);
        SCM(wtarget, COLOR_WHITE, wtmsg);
        return 1;
    }

    // ---- /wantedlist (Politia: lista jucatorilor cu wanted) ----
    if(strcmp(cmd, "/wantedlist", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pFaction] != FACTION_POLICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only Police Department can use this."), 1;

        SCM(playerid, COLOR_INFO, C_INFO"===== Wanted List =====");
        new wlAny = 0;
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
            if(PlayerData[i][pWanted] <= 0) continue;
            new wl[96];
            format(wl, sizeof(wl), T(playerid, C_WHITE"%s "C_ERROR"- Wanted %d"), PlayerData[i][pName], PlayerData[i][pWanted]);
            SCM(playerid, COLOR_WHITE, wl);
            wlAny++;
        }
        if(!wlAny) SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"No wanted players online.");
        return 1;
    }

    // ---- /adminwanted [playerid] [wantedlevel] (admin: seteaza direct nivelul de wanted) ----
    // /awanted = acelasi lucru, dar doar pentru admin 2+ (/adminwanted ramane pentru admin 1+)
    if(strcmp(cmd, "/adminwanted", true) == 0 || strcmp(cmd, "/awanted", true) == 0)
    {
        new bool:awIsA = (strcmp(cmd, "/awanted", true) == 0);
        if(awIsA && PlayerData[playerid][pAdminLevel] < 2)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new awp1[8], awa = 0;
        while(cmdtext[idx] > ' ' && awa < 7) { awp1[awa++] = cmdtext[idx]; idx++; }
        awp1[awa] = EOS;
        while(cmdtext[idx] == ' ') idx++;
        new awp2[8]; strmid(awp2, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(awp1) || !strlen(awp2))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/adminwanted [playerid] [wantedlevel]"C_WHITE" (0-6)."), 1;

        new awtarget = strval(awp1), awlevel = strval(awp2);
        if(!IsPlayerConnected(awtarget) || !PlayerData[awtarget][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;
        if(awlevel < 0 || awlevel > 6)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Wanted level must be between 0 and 6."), 1;

        PlayerData[awtarget][pWanted] = awlevel;
        SetPlayerWantedLevel(awtarget, awlevel);
        UpdatePlayer(awtarget, pWanted);

        new awmsg[144];
        format(awmsg, sizeof(awmsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Set "C_INFO"%s"C_WHITE"'s wanted level to "C_INFO"%d"C_WHITE"."),
            PlayerData[awtarget][pName], awlevel);
        SCM(playerid, COLOR_SUCCESS, awmsg);
        return 1;
    }

    // ---- /resettrain [playerid] (admin 2+: reseteaza limita "o calatorie cu trenul per payday" a unui jucator) ----
    if(strcmp(cmd, "/resettrain", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 2)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new rtp1[8];
        strmid(rtp1, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(rtp1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/resettrain [playerid]"C_WHITE"."), 1;

        new rtTarget = strval(rtp1);
        if(!IsPlayerConnected(rtTarget) || !PlayerData[rtTarget][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        g_TrainUsedThisPayday[rtTarget] = false;

        new rtMsg[144];
        format(rtMsg, sizeof(rtMsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Reset "C_INFO"%s"C_WHITE"'s train ride limit. They can travel by train again."), PlayerData[rtTarget][pName]);
        SCM(playerid, COLOR_SUCCESS, rtMsg);
        if(rtTarget != playerid)
        {
            format(rtMsg, sizeof(rtMsg), T(rtTarget, C_INFO"Info: "C_WHITE"An admin reset your train ride limit. You can travel by train again."));
            SCM(rtTarget, COLOR_INFO, rtMsg);
        }
        return 1;
    }

    // ---- /managers (lista managerilor institutiilor: aeroport / trenuri / SGR) ----
    if(strcmp(cmd, "/managers", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new mlq[256];
        mysql_format(g_SQL, mlq, sizeof(mlq), "SELECT `username`,`phone_number` FROM `players` WHERE `username` IN ('%e','%e','%e')",
            g_ManagerName[MANAGER_AIRPORT], g_ManagerName[MANAGER_TRAIN], g_ManagerName[MANAGER_SGR]);
        mysql_tquery(g_SQL, mlq, "OnManagersListed", "i", playerid);
        return 1;
    }

    // ---- /manage airport (doar managerul de aeroport: misiune Flatbed cu piese pentru avioanele Crop Duster) ----
    if(strcmp(cmd, "/manage", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new mnA[10], mnN = 0;
        while(cmdtext[idx] > ' ' && mnN < 9) { mnA[mnN++] = cmdtext[idx]; idx++; }
        mnA[mnN] = EOS;
        while(cmdtext[idx] == ' ') idx++;
        new mnB[8];
        mnN = 0;
        while(cmdtext[idx] > ' ' && mnN < 7) { mnB[mnN++] = cmdtext[idx]; idx++; }
        mnB[mnN] = EOS;
        new mnType = -1;
        if(!strcmp(mnA, "airport", true)) mnType = MANAGER_AIRPORT;
        else if(!strcmp(mnA, "train", true)) mnType = MANAGER_TRAIN;
        else if(!strcmp(mnA, "sgr", true)) mnType = MANAGER_SGR;
        if(mnType == -1)
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/manage airport"C_WHITE", "C_INFO"/manage train"C_WHITE" or "C_INFO"/manage sgr"C_WHITE"."), 1;

        if(!g_ManagerName[mnType][0] || strcmp(PlayerData[playerid][pName], g_ManagerName[mnType]) != 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not the manager for this position."), 1;

        // /manage [airport/train/sgr] status - starea institutiei
        if(!strcmp(mnB, "status", true))
        {
            new stCur, stMax, stMin, stWhat[40];
            switch(mnType)
            {
                case MANAGER_AIRPORT: { stCur = g_StatCropCrashes;  stMax = CROPDUST_MAX_CRASHES; stMin = MGR_MIN_CRASHES;  format(stWhat, sizeof(stWhat), T(playerid, "Destroyed planes")); }
                case MANAGER_TRAIN:   { stCur = g_StatTrainRides;   stMax = TRAIN_MAX_RIDES;      stMin = MGR_MIN_CRASHES;  format(stWhat, sizeof(stWhat), T(playerid, "Train rides since service")); }
                default:              { stCur = g_StatSGRDelivered; stMax = SGR_DEPOT_MAX;        stMin = MGR_SGR_REMOVE;   format(stWhat, sizeof(stWhat), T(playerid, "SGR in depot")); }
            }
            new stMsg[256];
            if(stCur >= stMax)
                format(stMsg, sizeof(stMsg), T(playerid, C_INFO"[%s] "C_WHITE"Status: "C_ERROR"OUT OF SERVICE"C_WHITE" | %s: "C_INFO"%d/%d"C_WHITE" | Start a repair with "C_INFO"/manage %s"C_WHITE"."), g_ManagerTitle[mnType], stWhat, stCur, stMax, g_ManagerKey[mnType]);
            else if(stCur >= stMin)
                format(stMsg, sizeof(stMsg), T(playerid, C_INFO"[%s] "C_WHITE"Status: "C_INFO"WORKING, SERVICE AVAILABLE"C_WHITE" | %s: "C_INFO"%d/%d"C_WHITE" | Use "C_INFO"/manage %s"C_WHITE"."), g_ManagerTitle[mnType], stWhat, stCur, stMax, g_ManagerKey[mnType]);
            else
                format(stMsg, sizeof(stMsg), T(playerid, C_INFO"[%s] "C_WHITE"Status: "C_SUCCESS"WORKING"C_WHITE" | %s: "C_INFO"%d/%d"C_WHITE" | No service needed yet."), g_ManagerTitle[mnType], stWhat, stCur, stMax);
            SCM(playerid, COLOR_WHITE, stMsg);
            return 1;
        }

        if(g_MgrState[playerid] != MGR_STATE_NONE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already have a mission in progress. Use "C_INFO"/stopwork"C_WHITE" to cancel it."), 1;
        if(mnType == MANAGER_AIRPORT && g_StatCropCrashes < MGR_MIN_CRASHES)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The Crop Duster planes don't need repairs yet (at least "C_INFO"10"C_WHITE" destroyed planes required)."), 1;
        if(mnType == MANAGER_TRAIN && g_StatTrainRides < MGR_MIN_CRASHES)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The trains don't need service yet (at least "C_INFO"10"C_WHITE" train rides required)."), 1;
        if(mnType == MANAGER_SGR && g_StatSGRDelivered < MGR_SGR_REMOVE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The SGR depot doesn't need emptying yet (at least "C_INFO"50"C_WHITE" SGR containers required)."), 1;
        new mnVeh = GetPlayerVehicleID(playerid);
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || mnVeh == 0 || GetVehicleModel(mnVeh) != MGR_FLATBED_MODEL)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be driving a "C_INFO"Flatbed"C_WHITE"."), 1;

        g_MgrType[playerid]  = mnType;
        g_MgrVeh[playerid]   = mnVeh;
        if(mnType == MANAGER_SGR)
        {
            // checkpoint 1: locatia managerului SGR; checkpoint 2: Trash Unload
            if(g_TrashUnloadX == 0.0 && g_TrashUnloadY == 0.0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The Trash Unload point is not set."), 1;
            g_MgrState[playerid] = MGR_STATE_TO_HQ;
            Track_SetPlayerCheckpoint(playerid, g_ManagerPos[MANAGER_SGR][0], g_ManagerPos[MANAGER_SGR][1], g_ManagerPos[MANAGER_SGR][2], MGR_CP_SIZE);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Manager] "C_WHITE"Mission started! Go to the "C_INFO"SGR Manager"C_WHITE" checkpoint to load the containers. Use "C_INFO"/stopwork"C_WHITE" to cancel.");
            return 1;
        }
        if(mnType == MANAGER_TRAIN)
        {
            // piesele se incarca la depoul jobului Electrician
            g_MgrState[playerid] = MGR_STATE_TO_HQ;
            Track_SetPlayerCheckpoint(playerid, g_JobTeleport[MGR_JOB_LOAD_JOB - 1][0], g_JobTeleport[MGR_JOB_LOAD_JOB - 1][1], g_JobTeleport[MGR_JOB_LOAD_JOB - 1][2], MGR_CP_SIZE);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Manager] "C_WHITE"Mission started! Pick up the parts at the "C_INFO"Electrician"C_WHITE" depot. Use "C_INFO"/stopwork"C_WHITE" to cancel.");
            return 1;
        }
        if(FactionData[MGR_HQ_FACTION][fHQX] == 0.0 && FactionData[MGR_HQ_FACTION][fHQY] == 0.0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The Loco Outlaw Customs HQ is not set."), 1;

        g_MgrState[playerid] = MGR_STATE_TO_HQ;
        Track_SetPlayerCheckpoint(playerid, FactionData[MGR_HQ_FACTION][fHQX], FactionData[MGR_HQ_FACTION][fHQY], FactionData[MGR_HQ_FACTION][fHQZ], MGR_CP_SIZE);
        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Manager] "C_WHITE"Mission started! Pick up the parts at the "C_INFO"Loco Outlaw Customs"C_WHITE" HQ. Use "C_INFO"/stopwork"C_WHITE" to cancel.");
        return 1;
    }

    // ---- /manager set [airport/train/sgr] [playerid] | remove [airport/train/sgr] | stats (admin 5+) ----
    if(strcmp(cmd, "/manager", true) == 0)
    {
        new mgA1[8], mgA2[10], mgA3[8], mgN;
        while(cmdtext[idx] == ' ') idx++;
        mgN = 0;
        while(cmdtext[idx] > ' ' && mgN < 7) { mgA1[mgN++] = cmdtext[idx]; idx++; }
        mgA1[mgN] = EOS;
        while(cmdtext[idx] == ' ') idx++;
        mgN = 0;
        while(cmdtext[idx] > ' ' && mgN < 9) { mgA2[mgN++] = cmdtext[idx]; idx++; }
        mgA2[mgN] = EOS;
        while(cmdtext[idx] == ' ') idx++;
        mgN = 0;
        while(cmdtext[idx] > ' ' && mgN < 7) { mgA3[mgN++] = cmdtext[idx]; idx++; }
        mgA3[mgN] = EOS;

        // /manager stats: orice admin (toate contoarele) sau managerul unei institutii (doar contorul ei)
        if(!strcmp(mgA1, "stats", true))
        {
            new mgs[144];
            if(PlayerData[playerid][pAdminLevel] >= 1)
            {
                format(mgs, sizeof(mgs), T(playerid, C_INFO"[Stats] "C_WHITE"Train rides: "C_INFO"%d"C_WHITE" | Crop Duster planes destroyed: "C_INFO"%d"C_WHITE" | SGR delivered: "C_INFO"%d"),
                    g_StatTrainRides, g_StatCropCrashes, g_StatSGRDelivered);
                SCM(playerid, COLOR_WHITE, mgs);
                return 1;
            }
            new mgShown = 0;
            for(new mgI = 0; mgI < MANAGER_COUNT; mgI++)
            {
                if(!g_ManagerName[mgI][0] || strcmp(PlayerData[playerid][pName], g_ManagerName[mgI]) != 0) continue;
                mgShown++;
                switch(mgI)
                {
                    case MANAGER_AIRPORT: format(mgs, sizeof(mgs), T(playerid, C_INFO"[Stats] "C_WHITE"Crop Duster planes destroyed: "C_INFO"%d"), g_StatCropCrashes);
                    case MANAGER_TRAIN:   format(mgs, sizeof(mgs), T(playerid, C_INFO"[Stats] "C_WHITE"Train rides: "C_INFO"%d"), g_StatTrainRides);
                    default:              format(mgs, sizeof(mgs), T(playerid, C_INFO"[Stats] "C_WHITE"SGR delivered: "C_INFO"%d"), g_StatSGRDelivered);
                }
                SCM(playerid, COLOR_WHITE, mgs);
            }
            if(!mgShown)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only admins and institution managers can use this."), 1;
            return 1;
        }

        if(PlayerData[playerid][pAdminLevel] < 3)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 3."), 1;

        // /manager setstat [airport/train/sgr] [value]  |  /manager reset [airport/train/sgr]  (seteaza / reseteaza contorul)
        if(!strcmp(mgA1, "setstat", true) || !strcmp(mgA1, "reset", true))
        {
            new bool:ssReset = !strcmp(mgA1, "reset", true);
            new ssType = -1;
            for(new mgI = 0; mgI < MANAGER_COUNT; mgI++)
                if(!strcmp(mgA2, g_ManagerKey[mgI], true)) ssType = mgI;
            if(ssType == -1 || (!ssReset && !strlen(mgA3)))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/manager setstat [airport/train/sgr] [value]"C_WHITE" or "C_INFO"/manager reset [airport/train/sgr]"C_WHITE"."), 1;

            new ssVal = ssReset ? 0 : strval(mgA3);
            if(ssVal < 0 || ssVal > 100000)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Value must be between 0 and 100000."), 1;

            new ssLabel[40];
            switch(ssType)
            {
                case MANAGER_AIRPORT: { g_StatCropCrashes  = ssVal; Stat_Set("stat_crop_crashes", ssVal);  format(ssLabel, sizeof(ssLabel), "destroyed planes"); }
                case MANAGER_TRAIN:   { g_StatTrainRides   = ssVal; Stat_Set("stat_train_rides", ssVal);   format(ssLabel, sizeof(ssLabel), "train rides"); }
                default:              { g_StatSGRDelivered = ssVal; Stat_Set("stat_sgr_delivered", ssVal); format(ssLabel, sizeof(ssLabel), "SGR in depot"); }
            }
            new ssMsg[144];
            format(ssMsg, sizeof(ssMsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Set the %s counter (%s) to "C_INFO"%d"C_WHITE"."), g_ManagerTitle[ssType], ssLabel, ssVal);
            SCM(playerid, COLOR_SUCCESS, ssMsg);
            return 1;
        }

        // set / remove (numirea managerilor) raman pentru admin 5+
        if(PlayerData[playerid][pAdminLevel] < 5)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 5 (or level 3 for "C_INFO"setstat"C_WHITE"/"C_INFO"reset"C_WHITE")."), 1;

        new bool:mgSet = !strcmp(mgA1, "set", true);
        new bool:mgRem = !strcmp(mgA1, "remove", true);
        if(!mgSet && !mgRem)
        {
            SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/manager set [airport/train/sgr] [playerid]"C_WHITE", "C_INFO"/manager remove [airport/train/sgr]"C_WHITE" or "C_INFO"/manager stats"C_WHITE".");
            SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Counters: "C_INFO"/manager setstat [airport/train/sgr] [value]"C_WHITE", "C_INFO"/manager reset [airport/train/sgr]"C_WHITE".");
            return 1;
        }

        new mgType = -1;
        for(new mgI = 0; mgI < MANAGER_COUNT; mgI++)
            if(!strcmp(mgA2, g_ManagerKey[mgI], true)) mgType = mgI;
        if(mgType == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Type must be "C_INFO"airport"C_WHITE", "C_INFO"train"C_WHITE" or "C_INFO"sgr"C_WHITE"."), 1;

        new mgMsg[144];
        if(mgRem)
        {
            if(!g_ManagerName[mgType][0])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"There is no manager set for this position."), 1;
            format(mgMsg, sizeof(mgMsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Removed "C_INFO"%s"C_WHITE" as %s Manager."), g_ManagerName[mgType], g_ManagerTitle[mgType]);
            Manager_Set(mgType, "");
            SCM(playerid, COLOR_SUCCESS, mgMsg);
            return 1;
        }

        if(!strlen(mgA3))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/manager set [airport/train/sgr] [playerid]"C_WHITE"."), 1;
        new mgTarget = strval(mgA3);
        if(!IsPlayerConnected(mgTarget) || !PlayerData[mgTarget][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        Manager_Set(mgType, PlayerData[mgTarget][pName]);
        format(mgMsg, sizeof(mgMsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Set "C_INFO"%s"C_WHITE" as %s Manager."), PlayerData[mgTarget][pName], g_ManagerTitle[mgType]);
        SCM(playerid, COLOR_SUCCESS, mgMsg);
        format(mgMsg, sizeof(mgMsg), T(mgTarget, C_SUCCESS"[Manager] "C_WHITE"You have been appointed %s Manager by admin "C_INFO"%s"C_WHITE"."), g_ManagerTitle[mgType], PlayerData[playerid][pName]);
        SCM(mgTarget, COLOR_SUCCESS, mgMsg);
        return 1;
    }

    // ---- /cuff [playerid] (Politia, rank 1+: incatuseaza / descatuseaza un suspect din masina de politie) ----
    if(strcmp(cmd, "/cuff", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pFaction] != FACTION_POLICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only Police Department can use this."), 1;
        if(PlayerData[playerid][pFactionRank] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires faction rank 1+."), 1;

        // trebuie sa fii intr-o masina de politie
        new cfVeh = GetPlayerVehicleID(playerid);
        if(cfVeh == 0 || g_VehicleFactionOwner[cfVeh] != FACTION_POLICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in a police vehicle."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new cfp1[8];
        strmid(cfp1, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(cfp1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/cuff [playerid]"C_WHITE" (use it again to remove the handcuffs)."), 1;

        new cfTarget = strval(cfp1);
        if(!IsPlayerConnected(cfTarget) || !PlayerData[cfTarget][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;
        if(cfTarget == playerid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't cuff yourself."), 1;
        // politistul si suspectul trebuie sa fie in ACEEASI masina (suspectul ca pasager)
        if(GetPlayerVehicleID(cfTarget) != cfVeh)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The suspect must be in the same police vehicle as you."), 1;
        if(GetPlayerState(cfTarget) != PLAYER_STATE_PASSENGER)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The suspect must be a passenger in your police vehicle."), 1;

        new cfmsg[160];
        if(g_Cuffed[cfTarget])
        {
            Cuff_Clear(cfTarget);
            format(cfmsg, sizeof(cfmsg), T(playerid, C_SUCCESS"[P.R.] "C_WHITE"You removed the handcuffs from "C_INFO"%s"C_WHITE"."), PlayerData[cfTarget][pName]);
            SCM(playerid, COLOR_SUCCESS, cfmsg);
            SCM(cfTarget, COLOR_INFO, C_INFO"[P.R.] "C_WHITE"The handcuffs were removed. You can leave the vehicle now.");
            return 1;
        }

        g_Cuffed[cfTarget] = true;
        g_CuffedBy[cfTarget] = playerid;
        SetPlayerSpecialAction(cfTarget, SPECIAL_ACTION_CUFFED);
        TogglePlayerControllable(cfTarget, 0); // blocat in masina: nu poate cobora pana primeste uncuff
        format(cfmsg, sizeof(cfmsg), T(playerid, C_SUCCESS"[P.R.] "C_WHITE"You handcuffed "C_INFO"%s"C_WHITE"."), PlayerData[cfTarget][pName]);
        SCM(playerid, COLOR_SUCCESS, cfmsg);
        format(cfmsg, sizeof(cfmsg), T(cfTarget, C_ERROR"[P.R.] "C_WHITE"You were handcuffed by officer "C_INFO"%s"C_WHITE". You can't leave the vehicle until you are uncuffed."), PlayerData[playerid][pName]);
        SCM(cfTarget, COLOR_ERROR, cfmsg);
        return 1;
    }

    // ---- /arrest [playerid] (Politia: rank 2 -> wanted 1-4; rank 3+ -> wanted 1-6) ----
    if(strcmp(cmd, "/arrest", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pFaction] != FACTION_POLICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only Police Department can use this."), 1;
        if(PlayerData[playerid][pFactionRank] < 2)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires faction rank 2+."), 1;

        // In una dintre zonele de arest (interior LSPD sau exterior/garaj), daca sunt configurate
        new bool:zone1Set = (ARREST_ZONE_X != 0.0 || ARREST_ZONE_Y != 0.0);
        new bool:zone2Set = (ARREST_ZONE2_X != 0.0 || ARREST_ZONE2_Y != 0.0);
        if(zone1Set || zone2Set)
        {
            new bool:inZone = false;
            if(zone1Set && IsPlayerInRangeOfPoint(playerid, ARREST_ZONE_INT_RANGE, ARREST_ZONE_X, ARREST_ZONE_Y, ARREST_ZONE_Z))  inZone = true;
            if(zone2Set && IsPlayerInRangeOfPoint(playerid, ARREST_ZONE_RANGE, ARREST_ZONE2_X, ARREST_ZONE2_Y, ARREST_ZONE2_Z)) inZone = true;
            if(!inZone)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in an arrest zone (LSPD interior or garage)."), 1;
        }

        while(cmdtext[idx] == ' ') idx++;
        new arp1[8];
        strmid(arp1, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(arp1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/arrest [playerid]"C_WHITE"."), 1;

        new artarget = strval(arp1);
        if(!IsPlayerConnected(artarget) || !PlayerData[artarget][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;
        // [TEMP-SELF] permite auto-arestul pentru testare (de scos)
        // if(artarget == playerid)
        //     return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't arrest yourself."), 1;

        new arwl = PlayerData[artarget][pWanted];
        if(arwl < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That player is not wanted."), 1;

        new maxWanted = (PlayerData[playerid][pFactionRank] >= 3) ? 6 : 4;
        if(arwl > maxWanted)
        {
            new mwmsg[128];
            format(mwmsg, sizeof(mwmsg), T(playerid, C_ERROR"Error: "C_WHITE"Your rank can only arrest suspects up to wanted level "C_INFO"%d"C_WHITE"."), maxWanted);
            return SCM(playerid, COLOR_ERROR, mwmsg), 1;
        }

        // Inculpatul trebuie sa fie langa politist
        new Float:arx, Float:ary, Float:arz;
        GetPlayerPos(playerid, arx, ary, arz);
        if(!IsPlayerInRangeOfPoint(artarget, ARREST_SUSPECT_RANGE, arx, ary, arz))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The suspect must be next to you (5m)."), 1;

        new minutes = g_JailMinutes[arwl];
        new fine    = g_JailFine[arwl];

        // Ia banii (cat poate plati)
        new paid = fine;
        if(PlayerData[artarget][pMoney] < paid) paid = PlayerData[artarget][pMoney];
        if(paid < 0) paid = 0;

        new vaultCut = paid * 10 / 100;   // 10% in seiful factiunii 1
        new copGets  = paid - vaultCut;

        if(paid > 0)
        {
            PlayerData[artarget][pMoney] -= paid;
            GivePlayerMoney(artarget, -paid);
            UpdatePlayer(artarget, pMoney);
        }
        if(copGets > 0)
        {
            PlayerData[playerid][pMoney] += copGets;
            GivePlayerMoney(playerid, copGets);
            UpdatePlayer(playerid, pMoney);
        }
        if(vaultCut > 0) Faction_AddBank(FACTION_POLICE, vaultCut);

        // Reseteaza wanted-ul
        PlayerData[artarget][pWanted] = 0;
        SetPlayerWantedLevel(artarget, 0);
        UpdatePlayer(artarget, pWanted);

        // Contrabanda: arestat in timpul unei curse -> prima Politiei + scos din cursa
        if(g_SmuggleActive[artarget] || g_SmuggleLeaderOf[artarget] != INVALID_PLAYER_ID)
            Smuggle_OnCaught(artarget, playerid);

        // Baga in inchisoare
        PlayerData[artarget][pJailSeconds] = minutes * 60;
        UpdatePlayer(artarget, pJailSeconds);
        Jail_Send(artarget);
        Pray_FlagSin(artarget, 9); // Timp ispasit dupa gratii

        // Anunt catre toti politistii
        new armsg[220];
        format(armsg, sizeof(armsg), C_INFO"[P.R.] "C_WHITE"Officer "C_INFO"%s"C_WHITE" (rank %d) arrested suspect "C_INFO"%s"C_WHITE" (wanted level "C_INFO"%d"C_WHITE").",
            PlayerData[playerid][pName], PlayerData[playerid][pFactionRank], PlayerData[artarget][pName], arwl);
        for(new i = 0; i < MAX_PLAYERS; i++)
            if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pFaction] == FACTION_POLICE)
                {
                    format(armsg, sizeof(armsg), T(i, C_INFO"[P.R.] "C_WHITE"Officer "C_INFO"%s"C_WHITE" (rank %d) arrested suspect "C_INFO"%s"C_WHITE" (wanted level "C_INFO"%d"C_WHITE")."), PlayerData[playerid][pName], PlayerData[playerid][pFactionRank], PlayerData[artarget][pName], arwl);
                    SCM(i, COLOR_WHITE, armsg);
                }

        // Anunt catre inculpat
        new artmsg[200];
        format(artmsg, sizeof(artmsg), T(artarget, "[P.R.] You were arrested by officer %s. You will serve %d minute(s) in jail. You paid $%s."),
            PlayerData[playerid][pName], minutes, MoneyStr(paid));
        SCM(artarget, COLOR_WHITE, artmsg);
        return 1;
    }

    // ---- /arrestme (auto-arest: te predai cand nu e niciun politist on-duty pe server) ----
    if(strcmp(cmd, "/arrestme", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new amwl = PlayerData[playerid][pWanted];
        if(amwl <= 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You need a wanted level of at least 2 to use this."), 1;

        if(!IsPlayerInRangeOfPoint(playerid, ARRESTME_RANGE, ARRESTME_X, ARRESTME_Y, ARRESTME_Z))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be at the "C_INFO"[ Jail ]"C_WHITE" point to turn yourself in."), 1;

        // Trebuie sa NU existe niciun politist on-duty pe server
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
            if(PlayerData[i][pFaction] == FACTION_POLICE && PlayerData[i][pOnDuty])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"There are Police officers on duty - turn yourself in to one of them with "C_INFO"/arrest"C_WHITE" instead."), 1;
        }

        // Aceleasi taxa/timp ca la /arrest, dar +20%
        new amMinutes = g_JailMinutes[amwl] * 12 / 10;
        new amFine    = g_JailFine[amwl] * 12 / 10;

        new amPaid = amFine;
        if(PlayerData[playerid][pMoney] < amPaid) amPaid = PlayerData[playerid][pMoney];
        if(amPaid < 0) amPaid = 0;

        if(amPaid > 0)
        {
            PlayerData[playerid][pMoney] -= amPaid;
            GivePlayerMoney(playerid, -amPaid);
            UpdatePlayer(playerid, pMoney);
        }
        if(amPaid > 0) Faction_AddBank(FACTION_POLICE, amPaid); // fara politist implicat -> toata suma merge in seiful factiunii 1

        // Reseteaza wanted-ul
        PlayerData[playerid][pWanted] = 0;
        SetPlayerWantedLevel(playerid, 0);
        UpdatePlayer(playerid, pWanted);

        // Contrabanda: auto-arestat in timpul unei curse -> prima Politiei (fara ofiter) + scos din cursa
        if(g_SmuggleActive[playerid] || g_SmuggleLeaderOf[playerid] != INVALID_PLAYER_ID)
            Smuggle_OnCaught(playerid, INVALID_PLAYER_ID);

        // Baga in inchisoare
        PlayerData[playerid][pJailSeconds] = amMinutes * 60;
        UpdatePlayer(playerid, pJailSeconds);
        Jail_Send(playerid);
        Pray_FlagSin(playerid, 9); // Timp ispasit dupa gratii

        // Anunt catre toti politistii (chiar daca niciunul nu e on-duty acum)
        new amcopmsg[220];
        format(amcopmsg, sizeof(amcopmsg), C_INFO"[P.R.] "C_WHITE"Suspect "C_INFO"%s"C_WHITE" turned themselves in via "C_INFO"/arrestme"C_WHITE" (wanted level "C_INFO"%d"C_WHITE").",
            PlayerData[playerid][pName], amwl);
        for(new i = 0; i < MAX_PLAYERS; i++)
            if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pFaction] == FACTION_POLICE)
                {
                    format(amcopmsg, sizeof(amcopmsg), T(i, C_INFO"[P.R.] "C_WHITE"Suspect "C_INFO"%s"C_WHITE" turned themselves in via "C_INFO"/arrestme"C_WHITE" (wanted level "C_INFO"%d"C_WHITE")."), PlayerData[playerid][pName], amwl);
                    SCM(i, COLOR_WHITE, amcopmsg);
                }

        new ammsg[180];
        format(ammsg, sizeof(ammsg), T(playerid, C_INFO"[P.R.] "C_WHITE"You turned yourself in. You will serve "C_INFO"%d minute(s)"C_WHITE" in jail. You paid "C_INFO"$%s"C_WHITE"."),
            amMinutes, MoneyStr(amPaid));
        SCM(playerid, COLOR_WHITE, ammsg);
        return 1;
    }

    // ---- /refillfactionveh (rank 5+: alimenteaza TOATE vehiculele factiunii la maxim) ----
    if(strcmp(cmd, "/refillfactionveh", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pFaction] < 1 || PlayerData[playerid][pFaction] > MAX_FACTIONS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of a faction."), 1;
        if(PlayerData[playerid][pFactionRank] < 5)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires faction rank 5+."), 1;

        new rfFid = PlayerData[playerid][pFaction], rfCount = 0;
        for(new v = 0; v < MAX_VEHICLES; v++)
        {
            if(g_VehicleFactionOwner[v] != rfFid) continue;
            g_VehicleFuel[v] = FUEL_MAX;
            Vehicle_SaveFuel(v);
            rfCount++;
        }

        new rfmsg[128];
        format(rfmsg, sizeof(rfmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"Refueled all faction vehicles ("C_INFO"%d"C_WHITE") to "C_INFO"100%%"C_WHITE"."), rfCount);
        SCM(playerid, COLOR_SUCCESS, rfmsg);
        return 1;
    }

    // ---- /respawnfactionveh (rank 5+: respawn la TOATE vehiculele factiunii) ----
    if(strcmp(cmd, "/respawnfactionveh", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;
        if(PlayerData[playerid][pFaction] < 1 || PlayerData[playerid][pFaction] > MAX_FACTIONS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of a faction."), 1;
        if(PlayerData[playerid][pFactionRank] < 5)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires faction rank 5+."), 1;

        new rsFid = PlayerData[playerid][pFaction], rsCount = 0;
        for(new v = 0; v < MAX_VEHICLES; v++)
        {
            if(g_VehicleFactionOwner[v] != rsFid) continue;
            SetVehicleToRespawn(v);
            rsCount++;
        }

        new rsmsg[128];
        format(rsmsg, sizeof(rsmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"Respawned all faction vehicles ("C_INFO"%d"C_WHITE")."), rsCount);
        SCM(playerid, COLOR_SUCCESS, rsmsg);
        return 1;
    }

    // ---- /inspectcar [playerid] ----
    if(strcmp(cmd, "/inspectcar", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pFaction] != FACTION_RAR && PlayerData[playerid][pFaction] != FACTION_POLICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of the DMV or Police Department."), 1;

        if(!PlayerData[playerid][pOnDuty])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be on-duty to use this command."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new p1[8];
        strmid(p1, cmdtext, idx, strlen(cmdtext), 8);

        if(!strlen(p1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/inspectcar [playerid]"C_WHITE"."), 1;

        new targetid = strval(p1);
        if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        new Float:px, Float:py, Float:pz;
        GetPlayerPos(playerid, px, py, pz);
        if(!IsPlayerInRangeOfPoint(targetid, FINE_RANGE, px, py, pz))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player must be within 15m."), 1;

        new vehid = GetPlayerVehicleID(targetid);
        if(vehid == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not in a vehicle."), 1;

        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);
        if(engine)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The vehicle's engine must be off to inspect it."), 1;

        new pvidx = g_VehicleToPVIndex[vehid];
        if(pvidx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This vehicle is not a registered personal vehicle."), 1;

        new vname[24];
        GetVehicleModelName(PVehicleData[pvidx][pvModelID], vname, sizeof(vname));

        new medStatus[16], extStatus[16];
        VehicleDoc_Status(PVehicleData[pvidx][pvMedkitExp], medStatus, sizeof(medStatus));
        VehicleDoc_Status(PVehicleData[pvidx][pvExtinguisherExp], extStatus, sizeof(extStatus));

        new plateColor[9];
        if(PlayerData[targetid][pVIP]) format(plateColor, sizeof(plateColor), "{FF0000}");
        else format(plateColor, sizeof(plateColor), C_INFO);

        new line[160];
        SCM(playerid, COLOR_INFO, C_INFO"_____ Vehicle Inspection ____________________________");
        format(line, sizeof(line), T(playerid, C_WHITE"Driver: "C_INFO"%s"C_WHITE" | Vehicle: "C_INFO"%s"C_WHITE" | Plate: %s%s"),
            PlayerData[targetid][pName], vname, plateColor, PVehicleData[pvidx][pvPlate]);
        SCM(playerid, COLOR_WHITE, line);

        if(PlayerData[playerid][pFaction] == FACTION_POLICE)
        {
            new insStatus[16];
            VehicleDoc_Status(PVehicleData[pvidx][pvInsuranceExp], insStatus, sizeof(insStatus));
            format(line, sizeof(line), T(playerid, C_WHITE"Insurance: "C_INFO"%s"C_WHITE" | Medical Kit: "C_INFO"%s"C_WHITE" | Extinguisher: "C_INFO"%s"),
                insStatus, medStatus, extStatus);
            SCM(playerid, COLOR_WHITE, line);
        }
        else // FACTION_RAR
        {
            new itpStatus[16];
            VehicleDoc_Status(PVehicleData[pvidx][pvITPExp], itpStatus, sizeof(itpStatus));
            format(line, sizeof(line), T(playerid, C_WHITE"Medical Kit: "C_INFO"%s"C_WHITE" | Extinguisher: "C_INFO"%s"C_WHITE" | ITP: "C_INFO"%s"),
                medStatus, extStatus, itpStatus);
            SCM(playerid, COLOR_WHITE, line);

            new Float:health;
            GetVehicleHealth(vehid, health);
            format(line, sizeof(line), T(playerid, C_WHITE"Vehicle Health: "C_INFO"%d"), floatround(health));
            SCM(playerid, COLOR_WHITE, line);
        }

        SCM(playerid, COLOR_INFO, C_INFO"_______________________________________________________");
        return 1;
    }

    // ---- /confiscate [extinctor/medkit/itp] [playerid] (RAR) | [insurance] [playerid] / [licence] [A/B/C/D/all] [playerid] (Police) ----
    if(strcmp(cmd, "/confiscate", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pFaction] != FACTION_RAR && PlayerData[playerid][pFaction] != FACTION_POLICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of the DMV or Police Department."), 1;

        new bool:isPolice = (PlayerData[playerid][pFaction] == FACTION_POLICE);

        if(isPolice && PlayerData[playerid][pFactionRank] < 2)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires rank 2 or higher."), 1;
        if(!isPolice && PlayerData[playerid][pFactionRank] < 3)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires rank 3 or higher."), 1;

        if(!PlayerData[playerid][pOnDuty])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be on-duty to use this command."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new subStart = idx;
        while(cmdtext[idx] > ' ') idx++;
        new sub[10];
        strmid(sub, cmdtext, subStart, idx, 10);
        while(cmdtext[idx] == ' ') idx++;

        // ---- Police: /confiscate licence [A/B/C/D/all] [playerid] ----
        if(isPolice && strcmp(sub, "licence", true) == 0)
        {
            new lp1[8], lp2[8];
            strmid(lp1, cmdtext, idx, strlen(cmdtext), 8);
            while(cmdtext[idx] > ' ') idx++;
            while(cmdtext[idx] == ' ') idx++;
            strmid(lp2, cmdtext, idx, strlen(cmdtext), 8);

            if(!strlen(lp1) || !strlen(lp2))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/confiscate licence [A/B/C/D/P/H/W/all] [playerid]"C_WHITE"."), 1;

            new targetid = strval(lp2);
            if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

            new Float:lx, Float:ly, Float:lz;
            GetPlayerPos(playerid, lx, ly, lz);
            if(!IsPlayerInRangeOfPoint(targetid, FINE_RANGE, lx, ly, lz))
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player must be within 15m."), 1;

            new lq[256], catLabel[8];

            if(strcmp(lp1, "all", true) == 0)
            {
                PlayerData[targetid][pDrivingLicA_exp][0] = EOS;
                PlayerData[targetid][pDrivingLicB_exp][0] = EOS;
                PlayerData[targetid][pDrivingLicC_exp][0] = EOS;
                PlayerData[targetid][pDrivingLicD_exp][0] = EOS;
                PlayerData[targetid][pAirLicA_exp][0] = EOS; // P = avion
                PlayerData[targetid][pAirLicH_exp][0] = EOS; // H = elicopter
                PlayerData[targetid][pWeaponLicW_exp][0] = EOS; // W = arme

                mysql_format(g_SQL, lq, sizeof(lq),
                    "UPDATE `players` SET `driving_lic_a_exp`=NULL, `driving_lic_b_exp`=NULL, `driving_lic_c_exp`=NULL, `driving_lic_d_exp`=NULL, `airplane_lic_a_exp`=NULL, `airplane_lic_h_exp`=NULL, `weapon_lic_w_exp`=NULL WHERE `id`=%d",
                    PlayerData[targetid][pID]);
                format(catLabel, sizeof(catLabel), "ALL");
            }
            else if(strcmp(lp1, "A", true) == 0)
            {
                PlayerData[targetid][pDrivingLicA_exp][0] = EOS;
                mysql_format(g_SQL, lq, sizeof(lq), "UPDATE `players` SET `driving_lic_a_exp`=NULL WHERE `id`=%d", PlayerData[targetid][pID]);
                format(catLabel, sizeof(catLabel), "A");
            }
            else if(strcmp(lp1, "B", true) == 0)
            {
                PlayerData[targetid][pDrivingLicB_exp][0] = EOS;
                mysql_format(g_SQL, lq, sizeof(lq), "UPDATE `players` SET `driving_lic_b_exp`=NULL WHERE `id`=%d", PlayerData[targetid][pID]);
                format(catLabel, sizeof(catLabel), "B");
            }
            else if(strcmp(lp1, "C", true) == 0)
            {
                PlayerData[targetid][pDrivingLicC_exp][0] = EOS;
                mysql_format(g_SQL, lq, sizeof(lq), "UPDATE `players` SET `driving_lic_c_exp`=NULL WHERE `id`=%d", PlayerData[targetid][pID]);
                format(catLabel, sizeof(catLabel), "C");
            }
            else if(strcmp(lp1, "D", true) == 0)
            {
                PlayerData[targetid][pDrivingLicD_exp][0] = EOS;
                mysql_format(g_SQL, lq, sizeof(lq), "UPDATE `players` SET `driving_lic_d_exp`=NULL WHERE `id`=%d", PlayerData[targetid][pID]);
                format(catLabel, sizeof(catLabel), "D");
            }
            else if(strcmp(lp1, "P", true) == 0) // P = permis avion
            {
                PlayerData[targetid][pAirLicA_exp][0] = EOS;
                mysql_format(g_SQL, lq, sizeof(lq), "UPDATE `players` SET `airplane_lic_a_exp`=NULL WHERE `id`=%d", PlayerData[targetid][pID]);
                format(catLabel, sizeof(catLabel), "P");
            }
            else if(strcmp(lp1, "H", true) == 0) // H = permis elicopter
            {
                PlayerData[targetid][pAirLicH_exp][0] = EOS;
                mysql_format(g_SQL, lq, sizeof(lq), "UPDATE `players` SET `airplane_lic_h_exp`=NULL WHERE `id`=%d", PlayerData[targetid][pID]);
                format(catLabel, sizeof(catLabel), "H");
            }
            else if(strcmp(lp1, "W", true) == 0) // W = permis arme
            {
                PlayerData[targetid][pWeaponLicW_exp][0] = EOS;
                mysql_format(g_SQL, lq, sizeof(lq), "UPDATE `players` SET `weapon_lic_w_exp`=NULL WHERE `id`=%d", PlayerData[targetid][pID]);
                format(catLabel, sizeof(catLabel), "W");
            }
            else
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid category. Use A, B, C, D, P, H, W or all."), 1;

            mysql_tquery(g_SQL, lq, "", "", 0);

            new lcmsg[160];
            format(lcmsg, sizeof(lcmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You confiscated "C_INFO"%s"C_WHITE"'s category "C_INFO"%s"C_WHITE" driving license."),
                PlayerData[targetid][pName], catLabel);
            SCM(playerid, COLOR_SUCCESS, lcmsg);

            format(lcmsg, sizeof(lcmsg), T(targetid, C_ERROR"Error: "C_WHITE"Your category "C_INFO"%s"C_WHITE" driving license was confiscated by "C_INFO"%s"C_WHITE"."),
                catLabel, PlayerData[playerid][pName]);
            SCM(targetid, COLOR_ERROR, lcmsg);
            return 1;
        }

        new p1[8];
        strmid(p1, cmdtext, idx, strlen(cmdtext), 8);

        new bool:validSub = isPolice
            ? (strcmp(sub, "insurance", true) == 0)
            : (strcmp(sub, "extinctor", true) == 0 || strcmp(sub, "medkit", true) == 0 || strcmp(sub, "itp", true) == 0);

        if(!validSub || !strlen(p1))
        {
            new umsg[96];
            format(umsg, sizeof(umsg), T(playerid, C_INFO"Info: "C_WHITE"Use "C_INFO"%s"C_WHITE"."),
                isPolice ? "/confiscate [insurance [playerid] / licence [A/B/C/D/P/H/W/all] [playerid]]" : "/confiscate [extinctor/medkit/itp] [playerid]");
            return SCM(playerid, COLOR_INFO, umsg), 1;
        }

        new targetid = strval(p1);
        if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        new Float:px, Float:py, Float:pz;
        GetPlayerPos(playerid, px, py, pz);
        if(!IsPlayerInRangeOfPoint(targetid, FINE_RANGE, px, py, pz))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player must be within 15m."), 1;

        new vehid = GetPlayerVehicleID(targetid);
        if(vehid == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not in a vehicle."), 1;

        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);
        if(engine)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The vehicle's engine must be off to do this."), 1;

        new pvidx = g_VehicleToPVIndex[vehid];
        if(pvidx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This vehicle is not a registered personal vehicle."), 1;

        new docName[24], docColumn[24], expTs;
        if(strcmp(sub, "extinctor", true) == 0)
        {
            PVehicleData[pvidx][pvExtinguisherExp] = gettime();
            expTs = PVehicleData[pvidx][pvExtinguisherExp];
            format(docName, sizeof(docName), "fire extinguisher");
            format(docColumn, sizeof(docColumn), "extinguisher_exp");
        }
        else if(strcmp(sub, "medkit", true) == 0)
        {
            PVehicleData[pvidx][pvMedkitExp] = gettime();
            expTs = PVehicleData[pvidx][pvMedkitExp];
            format(docName, sizeof(docName), "medical kit");
            format(docColumn, sizeof(docColumn), "medkit_exp");
        }
        else if(strcmp(sub, "insurance", true) == 0)
        {
            PVehicleData[pvidx][pvInsuranceExp] = gettime();
            expTs = PVehicleData[pvidx][pvInsuranceExp];
            format(docName, sizeof(docName), "insurance");
            format(docColumn, sizeof(docColumn), "insurance_exp");
        }
        else
        {
            PVehicleData[pvidx][pvITPExp] = gettime();
            expTs = PVehicleData[pvidx][pvITPExp];
            format(docName, sizeof(docName), "ITP");
            format(docColumn, sizeof(docColumn), "itp_exp");
        }

        new dateStr[11];
        UnixToDateStr(expTs, dateStr, sizeof(dateStr));

        new q[128];
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `%s`='%s' WHERE `id`=%d",
            docColumn, dateStr, PVehicleData[pvidx][pvID]);
        mysql_tquery(g_SQL, q, "", "", 0);

        new cmsg[160];
        format(cmsg, sizeof(cmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You confiscated "C_INFO"%s"C_WHITE"'s %s document."),
            PlayerData[targetid][pName], docName);
        SCM(playerid, COLOR_SUCCESS, cmsg);

        format(cmsg, sizeof(cmsg), T(targetid, C_ERROR"Error: "C_WHITE"Your %s document was confiscated by "C_INFO"%s"C_WHITE"."),
            docName, PlayerData[playerid][pName]);
        SCM(targetid, COLOR_ERROR, cmsg);
        return 1;
    }

    // ---- /fine [playerid] [amount] [reason] ----
    if(strcmp(cmd, "/fine", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pFaction] != FACTION_RAR && PlayerData[playerid][pFaction] != FACTION_POLICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of the DMV or Police Department."), 1;

        if(!PlayerData[playerid][pOnDuty])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be on-duty to use this command."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new p1[8], p2[8];
        strmid(p1, cmdtext, idx, strlen(cmdtext), 8);
        while(cmdtext[idx] > ' ') idx++;
        while(cmdtext[idx] == ' ') idx++;
        strmid(p2, cmdtext, idx, strlen(cmdtext), 8);
        while(cmdtext[idx] > ' ') idx++;
        while(cmdtext[idx] == ' ') idx++;
        new reason[128];
        strmid(reason, cmdtext, idx, strlen(cmdtext), 128);

        if(!strlen(p1) || !strlen(p2) || !strlen(reason))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/fine [playerid] [amount] [reason]"C_WHITE"."), 1;

        new targetid = strval(p1);
        new amount = strval(p2);

        if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        if(targetid == playerid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't fine yourself."), 1;

        if(amount <= 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid amount."), 1;

        new Float:px, Float:py, Float:pz;
        GetPlayerPos(playerid, px, py, pz);
        if(!IsPlayerInRangeOfPoint(targetid, FINE_RANGE, px, py, pz))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player must be within 15m."), 1;

        g_PendingFineAmount[targetid]  = amount;
        g_PendingFineOfficer[targetid] = playerid;
        format(g_PendingFineReason[targetid], 128, "%s", reason);

        new fmsg[300];
        format(fmsg, sizeof(fmsg), T(playerid, C_SUCCESS"Success: "C_WHITE"You issued a "C_INFO"$%s"C_WHITE" fine to "C_INFO"%s"C_WHITE" for: "C_INFO"%s"C_WHITE". Waiting for them to accept."),
            MoneyStr(amount), PlayerData[targetid][pName], reason);
        SCM(playerid, COLOR_SUCCESS, fmsg);

        new fTag[16];
        if(PlayerData[playerid][pFaction] == FACTION_RAR)
            format(fTag, sizeof(fTag), "[DMV] ");
        else
            format(fTag, sizeof(fTag), "[Police] ");

        format(fmsg, sizeof(fmsg), T(targetid, "%sOfficer %s fined you $%s for: %s. Type /accept fine %d to accept it."),
            fTag, PlayerData[playerid][pName], MoneyStr(amount), reason, playerid);
        printf("[DEBUG /fine] targetid=%d connected=%d logged=%d len=%d msg=%s",
            targetid, IsPlayerConnected(targetid), PlayerData[targetid][pLogged], strlen(fmsg), fmsg);
        SCM(targetid, COLOR_ERROR, fmsg);
        return 1;
    }

    // ---- /m [playerid] ----
    if(strcmp(cmd, "/m", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pFaction] != FACTION_RAR && PlayerData[playerid][pFaction] != FACTION_POLICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of the DMV or Police Department."), 1;

        if(!PlayerData[playerid][pOnDuty])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be on-duty to use this command."), 1;

        new myVehid = GetPlayerVehicleID(playerid);
        if(myVehid == 0 || g_VehicleFactionOwner[myVehid] != PlayerData[playerid][pFaction])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be in a faction vehicle to use this command."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new p1[8];
        strmid(p1, cmdtext, idx, strlen(cmdtext), 8);

        if(!strlen(p1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/m [playerid]"C_WHITE"."), 1;

        new targetid = strval(p1);
        if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        if(GetPlayerVehicleID(targetid) == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not in a vehicle."), 1;

        new Float:px, Float:py, Float:pz;
        GetPlayerPos(playerid, px, py, pz);
        if(!IsPlayerInRangeOfPoint(targetid, M_RANGE, px, py, pz))
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player must be within 50m."), 1;

        new fTag[16];
        if(PlayerData[playerid][pFaction] == FACTION_RAR)
            format(fTag, sizeof(fTag), "[DMV] ");
        else
            format(fTag, sizeof(fTag), "[Police] ");

        new mmsg[160];
        format(mmsg, sizeof(mmsg), T(targetid, C_ERROR"%s"C_WHITE"Officer "C_INFO"%s"C_WHITE" orders you to pull over: stop the car and remain inside the vehicle."),
            fTag, PlayerData[playerid][pName]);
        SCM(targetid, COLOR_ERROR, mmsg);

        format(mmsg, sizeof(mmsg), T(playerid, C_SUCCESS"Success: "C_INFO"%s"C_WHITE" has received your order to pull over."), PlayerData[targetid][pName]);
        SCM(playerid, COLOR_SUCCESS, mmsg);
        return 1;
    }

    // ---- /radar [install/remove] [speedLimit - doar pentru install] ----
    if(strcmp(cmd, "/radar", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        if(PlayerData[playerid][pFaction] != FACTION_POLICE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You are not part of the Police Department."), 1;

        if(PlayerData[playerid][pFactionRank] < 2)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Requires rank 2 or higher."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new subStart = idx;
        while(cmdtext[idx] > ' ') idx++;
        new sub[8];
        strmid(sub, cmdtext, subStart, idx, 8);
        while(cmdtext[idx] == ' ') idx++;
        new p1[8];
        strmid(p1, cmdtext, idx, strlen(cmdtext), 8);

        if(strcmp(sub, "install", true) == 0)
        {
            if(g_RadarActive[playerid])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You already have a radar installed. Use "C_INFO"/radar remove"C_WHITE" first."), 1;

            if(!strlen(p1))
                return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/radar install [speedLimit]"C_WHITE"."), 1;

            new speedLimit = strval(p1);
            if(speedLimit <= 0)
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid speed limit."), 1;

            GetPlayerPos(playerid, g_RadarX[playerid], g_RadarY[playerid], g_RadarZ[playerid]);
            g_RadarSpeedLimit[playerid] = speedLimit;
            g_RadarActive[playerid]     = true;

            new Float:radarAngle;
            GetPlayerFacingAngle(playerid, radarAngle);

            Radar_DestroyProps(playerid);
            g_RadarObject[playerid] = CreateObject(RADAR_OBJECT_MODEL,
                g_RadarX[playerid] + 1.0, g_RadarY[playerid], g_RadarZ[playerid] - 0.5, 0.0, 0.0, radarAngle);

            new label[64];
            format(label, sizeof(label), "[ Radar %s ]\n[ Speed max: %d km/h ]", PlayerData[playerid][pName], speedLimit);
            g_RadarLabel[playerid] = Create3DTextLabel(label, COLOR_WHITE,
                g_RadarX[playerid], g_RadarY[playerid], g_RadarZ[playerid] - 0.5, 10.0, 0, 0);

            new imsg[128];
            format(imsg, sizeof(imsg), T(playerid, C_SUCCESS"Success: "C_WHITE"Radar camera installed with a "C_INFO"%d km/h"C_WHITE" speed limit."), speedLimit);
            SCM(playerid, COLOR_SUCCESS, imsg);

            new fmsg[160];
            format(fmsg, sizeof(fmsg), C_INFO"[Police] "C_WHITE"Officer "C_INFO"%s"C_WHITE" has activated the radar. Speed limit set: "C_INFO"%d km/h"C_WHITE".",
                PlayerData[playerid][pName], speedLimit);
            for(new i = 0; i < MAX_PLAYERS; i++)
            {
                if(IsPlayerConnected(i) && PlayerData[i][pLogged] && PlayerData[i][pFaction] == FACTION_POLICE)
                    {
                        format(fmsg, sizeof(fmsg), T(i, C_INFO"[Police] "C_WHITE"Officer "C_INFO"%s"C_WHITE" has activated the radar. Speed limit set: "C_INFO"%d km/h"C_WHITE"."), PlayerData[playerid][pName], speedLimit);
                        SCM(i, COLOR_WHITE, fmsg);
                    }
            }
            return 1;
        }

        if(strcmp(sub, "remove", true) == 0)
        {
            if(!g_RadarActive[playerid])
                return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have an installed radar."), 1;

            g_RadarActive[playerid] = false;
            Radar_DestroyProps(playerid);

            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"Radar camera removed.");
            return 1;
        }

        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/radar [install/remove] [speedLimit]"C_WHITE"."), 1;
    }

    // ---- /showradars ----
    if(strcmp(cmd, "/showradars", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new bool:isPoliceRank4 = (PlayerData[playerid][pFaction] == FACTION_POLICE && PlayerData[playerid][pFactionRank] >= 4);
        if(PlayerData[playerid][pAdminLevel] < 1 && !isPoliceRank4)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires Police rank 4+ or admin level 1."), 1;

        new list[1024], any = 0;
        strcat(list, T(playerid, "RadarID\tOfficer\tSpeed Limit\tDistance\n"));
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(!g_RadarActive[i]) continue;

            new line[112];
            format(line, sizeof(line), "%d\t%s\t%d km/h\t%dm\n",
                i, PlayerData[i][pName], g_RadarSpeedLimit[i],
                floatround(GetPlayerDistanceFromPoint(playerid, g_RadarX[i], g_RadarY[i], g_RadarZ[i])));
            strcat(list, line);
            any++;
        }

        if(!any)
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"There are no active radars right now."), 1;

        SPD(playerid, DIALOG_RADAR_LIST, DIALOG_STYLE_TABLIST_HEADERS, "Active Radars", list, "Close", "");
        return 1;
    }

    // ---- /removeradar [radarid] ----
    if(strcmp(cmd, "/removeradar", true) == 0)
    {
        if(!PlayerData[playerid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be logged in."), 1;

        new bool:isPoliceRank4 = (PlayerData[playerid][pFaction] == FACTION_POLICE && PlayerData[playerid][pFactionRank] >= 4);
        if(PlayerData[playerid][pAdminLevel] < 1 && !isPoliceRank4)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires Police rank 4+ or admin level 1."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new p1[8];
        strmid(p1, cmdtext, idx, strlen(cmdtext), 8);

        if(!strlen(p1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/removeradar [radarid]"C_WHITE". See "C_INFO"/showradars"C_WHITE" for IDs."), 1;

        new radarid = strval(p1);
        if(radarid < 0 || radarid >= MAX_PLAYERS || !g_RadarActive[radarid])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"There is no active radar with that ID."), 1;

        new ownerName[24];
        format(ownerName, sizeof(ownerName), "%s", PlayerData[radarid][pName]);

        g_RadarActive[radarid]     = false;
        g_RadarSpeedLimit[radarid] = 0;
        g_RadarX[radarid]          = 0.0;
        g_RadarY[radarid]          = 0.0;
        g_RadarZ[radarid]          = 0.0;
        Radar_DestroyProps(radarid);

        new rmsg[128];
        format(rmsg, sizeof(rmsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Removed "C_INFO"%s"C_WHITE"'s radar (ID "C_INFO"%d"C_WHITE")."), ownerName, radarid);
        SCM(playerid, COLOR_SUCCESS, rmsg);

        if(IsPlayerConnected(radarid) && radarid != playerid)
        {
            new omsg[128];
            format(omsg, sizeof(omsg), T(radarid, C_ERROR"Error: "C_WHITE"Your radar was removed by "C_INFO"%s"C_WHITE"."), PlayerData[playerid][pName]);
            SCM(radarid, COLOR_ERROR, omsg);
        }
        return 1;
    }

    // ---- /factions ----
    if(strcmp(cmd, "/factions", true) == 0)
    {
        SCM(playerid, COLOR_INFO, C_INFO"_____ Factions ____________________");
        new line[128], colorcode[9], lead[24];
        for(new i = 1; i <= MAX_FACTIONS; i++)
        {
            GetFactionColorCode(i, colorcode, sizeof(colorcode));
            lead[0] = EOS;
            if(strlen(FactionData[i][fLead])) format(lead, sizeof(lead), "%s", FactionData[i][fLead]);
            else lead = "nobody";
            format(line, sizeof(line), T(playerid, "%s%d. %s | Lead: %s | Members: %d"),
                colorcode, i, FactionData[i][fName], lead, FactionData[i][fMembers]);
            SCM(playerid, FactionColors[i], line);
        }
        SCM(playerid, COLOR_INFO, C_INFO"________________________________________");
        return 1;
    }

    // ---- /respawn [target_player] ----
    if(strcmp(cmd, "/respawn", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new p1[8];
        strmid(p1, cmdtext, idx, strlen(cmdtext), 8);

        if(!strlen(p1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/respawn [target_player]"C_WHITE"."), 1;

        new targetid = strval(p1);

        if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        SetPlayerHealth(targetid, 0.0);

        new adminName[24];
        GetPlayerName(playerid, adminName, 24);

        new msg[128];
        format(msg, sizeof(msg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"You set "C_INFO"%s"C_WHITE"'s HP to 0."),
            PlayerData[targetid][pName]);
        SCM(playerid, COLOR_SUCCESS, msg);
        return 1;
    }

    // ---- /mute [playerid] [minute] [motiv] ----
    if(strcmp(cmd, "/mute", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 2)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new p1[8]; strmid(p1, cmdtext, idx, strlen(cmdtext), 8);
        while(cmdtext[idx] > ' ') idx++; while(cmdtext[idx] == ' ') idx++;
        new p2[8]; strmid(p2, cmdtext, idx, strlen(cmdtext), 8);
        while(cmdtext[idx] > ' ') idx++; while(cmdtext[idx] == ' ') idx++;
        new reason[128]; strmid(reason, cmdtext, idx, strlen(cmdtext), 128);

        if(!strlen(p1) || !strlen(p2))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/mute [playerid] [minutes] [reason]"C_WHITE"."), 1;

        new targetid = strval(p1);
        new minutes  = strval(p2);
        if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;
        if(targetid == playerid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't mute yourself."), 1;
        if(PlayerData[targetid][pAdminLevel] >= PlayerData[playerid][pAdminLevel])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't moderate an admin of equal or higher level."), 1;
        if(minutes <= 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Minutes must be greater than 0."), 1;
        if(!strlen(reason)) format(reason, sizeof(reason), "No reason");

        PlayerData[targetid][pMuteExpire] = gettime() + minutes * 60;
        UpdatePlayer(targetid, pMuteExpire);

        new bmsg[160];
        format(bmsg, sizeof(bmsg), C_ERROR"[ADM] "C_INFO"%s"C_WHITE" was muted by "C_INFO"%s"C_WHITE" for "C_INFO"%d"C_WHITE" min. Reason: "C_INFO"%s",
            PlayerData[targetid][pName], PlayerData[playerid][pName], minutes, reason);
        SCMToAll(COLOR_INFO, bmsg);
        return 1;
    }

    // ---- /unmute [playerid] ----
    if(strcmp(cmd, "/unmute", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 2)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new p1[8]; strmid(p1, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(p1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/unmute [playerid]"C_WHITE"."), 1;

        new targetid = strval(p1);
        if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;
        if(PlayerData[targetid][pMuteExpire] == 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"That player is not muted."), 1;

        PlayerData[targetid][pMuteExpire] = 0;
        UpdatePlayer(targetid, pMuteExpire);

        new bmsg[144];
        format(bmsg, sizeof(bmsg), C_SUCCESS"[ADM] "C_INFO"%s"C_WHITE" was unmuted by "C_INFO"%s"C_WHITE".",
            PlayerData[targetid][pName], PlayerData[playerid][pName]);
        SCMToAll(COLOR_INFO, bmsg);
        return 1;
    }

    // ---- /kick [playerid] [motiv] ----
    if(strcmp(cmd, "/kick", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 2)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new p1[8]; strmid(p1, cmdtext, idx, strlen(cmdtext), 8);
        while(cmdtext[idx] > ' ') idx++; while(cmdtext[idx] == ' ') idx++;
        new reason[128]; strmid(reason, cmdtext, idx, strlen(cmdtext), 128);

        if(!strlen(p1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/kick [playerid] [reason]"C_WHITE"."), 1;

        new targetid = strval(p1);
        if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;
        if(targetid == playerid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't kick yourself."), 1;
        if(PlayerData[targetid][pAdminLevel] >= PlayerData[playerid][pAdminLevel])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't moderate an admin of equal or higher level."), 1;
        if(!strlen(reason)) format(reason, sizeof(reason), "No reason");

        new bmsg[160];
        format(bmsg, sizeof(bmsg), C_ERROR"[ADM] "C_INFO"%s"C_WHITE" was kicked by "C_INFO"%s"C_WHITE". Reason: "C_INFO"%s",
            PlayerData[targetid][pName], PlayerData[playerid][pName], reason);
        SCMToAll(COLOR_INFO, bmsg);

        new tmsg[160];
        format(tmsg, sizeof(tmsg), T(targetid, C_ERROR"You were kicked."C_WHITE" Reason: "C_INFO"%s"), reason);
        SCM(targetid, COLOR_ERROR, tmsg);

        Admin_KickDelayed(targetid);
        return 1;
    }

    // ---- /ban [playerid] [motiv] ----
    if(strcmp(cmd, "/ban", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 4)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 4."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new p1[8]; strmid(p1, cmdtext, idx, strlen(cmdtext), 8);
        while(cmdtext[idx] > ' ') idx++; while(cmdtext[idx] == ' ') idx++;
        new reason[128]; strmid(reason, cmdtext, idx, strlen(cmdtext), 128);

        if(!strlen(p1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/ban [playerid] [reason]"C_WHITE"."), 1;

        new targetid = strval(p1);
        if(!IsPlayerConnected(targetid) || !PlayerData[targetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;
        if(targetid == playerid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't ban yourself."), 1;
        if(PlayerData[targetid][pAdminLevel] >= PlayerData[playerid][pAdminLevel])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't moderate an admin of equal or higher level."), 1;
        if(!strlen(reason)) format(reason, sizeof(reason), "No reason");

        new ip[46];
        GetPlayerIp(targetid, ip, sizeof(ip));

        new q[256];
        mysql_format(g_SQL, q, sizeof(q),
            "INSERT INTO `bans` (`username`,`ip`,`reason`,`banned_by`,`ban_date`) VALUES ('%e','%e','%e','%e',%d)",
            PlayerData[targetid][pName], ip, reason, PlayerData[playerid][pName], gettime());
        mysql_tquery(g_SQL, q, "", "", 0);

        new bmsg[176];
        format(bmsg, sizeof(bmsg), T(playerid, C_ERROR"[ADM] "C_INFO"%s"C_WHITE" was banned by "C_INFO"%s"C_WHITE". Reason: "C_INFO"%s"),
            PlayerData[targetid][pName], PlayerData[playerid][pName], reason);
        SCMToAll(COLOR_INFO, bmsg);

        new tmsg[160];
        format(tmsg, sizeof(tmsg), T(targetid, C_ERROR"You have been banned."C_WHITE" Reason: "C_INFO"%s"), reason);
        SCM(targetid, COLOR_ERROR, tmsg);

        Admin_KickDelayed(targetid);
        return 1;
    }

    // ---- /unban [nume] ----
    if(strcmp(cmd, "/unban", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 4)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 4."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new uname[24]; strmid(uname, cmdtext, idx, strlen(cmdtext), 24);
        if(!strlen(uname))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/unban [username]"C_WHITE"."), 1;

        new q[128];
        mysql_format(g_SQL, q, sizeof(q), "DELETE FROM `bans` WHERE `username`='%e'", uname);
        mysql_tquery(g_SQL, q, "", "", 0);

        new bmsg[144];
        format(bmsg, sizeof(bmsg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Removed any ban for username "C_INFO"%s"C_WHITE"."), uname);
        SCM(playerid, COLOR_SUCCESS, bmsg);
        return 1;
    }

    // ---- /warn [playerid] [motiv] ----
    if(strcmp(cmd, "/warn", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new wp1[8]; strmid(wp1, cmdtext, idx, strlen(cmdtext), 8);
        while(cmdtext[idx] > ' ') idx++; while(cmdtext[idx] == ' ') idx++;
        new wreason[128]; strmid(wreason, cmdtext, idx, strlen(cmdtext), 128);

        if(!strlen(wp1) || !strlen(wreason))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/warn [playerid] [reason]"C_WHITE"."), 1;

        new wtargetid = strval(wp1);
        if(!IsPlayerConnected(wtargetid) || !PlayerData[wtargetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;
        if(wtargetid == playerid)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't warn yourself."), 1;
        if(PlayerData[wtargetid][pAdminLevel] >= PlayerData[playerid][pAdminLevel])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You can't moderate an admin of equal or higher level."), 1;

        PlayerData[wtargetid][pWarns]++;
        UpdatePlayer(wtargetid, pWarns);

        new wq[256];
        mysql_format(g_SQL, wq, sizeof(wq),
            "INSERT INTO `warns` (`username`,`reason`,`warned_by`,`warn_date`) VALUES ('%e','%e','%e',%d)",
            PlayerData[wtargetid][pName], wreason, PlayerData[playerid][pName], gettime());
        mysql_tquery(g_SQL, wq, "", "", 0);

        new wmsg[176];
        format(wmsg, sizeof(wmsg), C_ERROR"[ADM] "C_INFO"%s"C_WHITE" gave a warn ["C_INFO"%d/%d"C_WHITE"] to "C_INFO"%s"C_WHITE". Reason: "C_INFO"%s",
            PlayerData[playerid][pName], PlayerData[wtargetid][pWarns], MAX_WARNS, PlayerData[wtargetid][pName], wreason);
        SCMToAll(COLOR_INFO, wmsg);

        if(PlayerData[wtargetid][pWarns] >= MAX_WARNS)
        {
            PlayerData[wtargetid][pWarns] = 0;
            UpdatePlayer(wtargetid, pWarns);

            new wip[46];
            GetPlayerIp(wtargetid, wip, sizeof(wip));

            new wbanReason[160];
            format(wbanReason, sizeof(wbanReason), "Reached %d warns (last: %s)", MAX_WARNS, wreason);

            new wbq[320];
            mysql_format(g_SQL, wbq, sizeof(wbq),
                "INSERT INTO `bans` (`username`,`ip`,`reason`,`banned_by`,`ban_date`,`expire`) VALUES ('%e','%e','%e','%e',%d,%d)",
                PlayerData[wtargetid][pName], wip, wbanReason, "System (warns)", gettime(), gettime() + WARN_BAN_SECONDS);
            mysql_tquery(g_SQL, wbq, "", "", 0);

            new wbmsg[176];
            format(wbmsg, sizeof(wbmsg), C_ERROR"[ADM] "C_INFO"%s"C_WHITE" reached "C_INFO"%d warns"C_WHITE" and was banned for "C_INFO"2 days"C_WHITE".",
                PlayerData[wtargetid][pName], MAX_WARNS);
            SCMToAll(COLOR_INFO, wbmsg);

            SCM(wtargetid, COLOR_ERROR, C_ERROR"You have been banned for 2 days."C_WHITE" Reason: "C_INFO"Reached maximum warns.");
            Admin_KickDelayed(wtargetid);
        }
        return 1;
    }

    // ---- /unwarn [playerid] [motiv] ----
    if(strcmp(cmd, "/unwarn", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new uwp1[8]; strmid(uwp1, cmdtext, idx, strlen(cmdtext), 8);
        while(cmdtext[idx] > ' ') idx++; while(cmdtext[idx] == ' ') idx++;
        new uwreason[128]; strmid(uwreason, cmdtext, idx, strlen(cmdtext), 128);

        if(!strlen(uwp1) || !strlen(uwreason))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/unwarn [playerid] [reason]"C_WHITE"."), 1;

        new uwtargetid = strval(uwp1);
        if(!IsPlayerConnected(uwtargetid) || !PlayerData[uwtargetid][pLogged])
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The player is not connected."), 1;

        if(PlayerData[uwtargetid][pWarns] <= 0)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This player has no warns."), 1;

        PlayerData[uwtargetid][pWarns]--;
        UpdatePlayer(uwtargetid, pWarns);

        new uwmsg[176];
        format(uwmsg, sizeof(uwmsg), C_SUCCESS"[ADM] "C_INFO"%s"C_WHITE" removed a warn ["C_INFO"%d/%d"C_WHITE"] from "C_INFO"%s"C_WHITE". Reason: "C_INFO"%s",
            PlayerData[playerid][pName], PlayerData[uwtargetid][pWarns], MAX_WARNS, PlayerData[uwtargetid][pName], uwreason);
        SCMToAll(COLOR_INFO, uwmsg);
        return 1;
    }

    // ---- /businesslist ----
    if(strcmp(cmd, "/businesslist", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        static list[4096];
        list[0] = EOS;
        strcat(list, T(playerid, "ID\tName\tOwner\tPrice\n"));
        for(new i = 0; i < g_BusinessCount; i++)
        {
            new owner[24];
            if(BusinessData[i][bOwned]) format(owner, sizeof(owner), "%s", BusinessData[i][bOwnerName]);
            else format(owner, sizeof(owner), "-");

            new line[200];
            format(line, sizeof(line), "%d\t%s\t%s\t$%s\n",
                BusinessData[i][bID], BusinessData[i][bName], owner,
                MoneyStr(BusinessData[i][bPrice]));
            strcat(list, line);
        }

        SPD(playerid, DIALOG_BUSINESS_LIST, DIALOG_STYLE_TABLIST_HEADERS, "Business List", list, "Close", "");
        return 1;
    }

    // ---- /cscreate [csType] [name] (admin 2+: creeaza o locatie CS la pozitia ta) ----
    if(strcmp(cmd, "/cscreate", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < CS_ADMIN_LEVEL)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

        if(g_CSLocCount >= MAX_CS_LOCATIONS)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Limit of "C_INFO#MAX_CS_LOCATIONS C_WHITE" CS locations reached."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new typeStr[8], tp = 0;
        while(cmdtext[idx] > ' ' && tp < 7) { typeStr[tp++] = cmdtext[idx]; idx++; }
        typeStr[tp] = EOS;

        if(!strlen(typeStr))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/cscreate [csType] [name]"C_WHITE" - 1 = SpawnT, 2 = SpawnCT, 3 = BombSite."), 1;

        new csnType = strval(typeStr);
        if(csnType < CS_TYPE_SPAWN_T || csnType > CS_TYPE_BOMBSITE)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid type. Use "C_INFO"1"C_WHITE" = SpawnT, "C_INFO"2"C_WHITE" = SpawnCT, "C_INFO"3"C_WHITE" = BombSite."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new csnName[32];
        strmid(csnName, cmdtext, idx, strlen(cmdtext), 32);

        new tname[16];
        CS_TypeName(csnType, tname, sizeof(tname));
        if(!strlen(csnName)) // nume implicit: "SpawnT 3" (al catelea de tipul asta)
            format(csnName, sizeof(csnName), "%s %d", tname, CSLoc_CountType(csnType) + 1);

        new Float:csx, Float:csy, Float:csz;
        GetPlayerPos(playerid, csx, csy, csz);

        new newIdx = g_CSLocCount;
        CSLocData[newIdx][csID]   = 0; // real dupa INSERT (cache_insert_id)
        CSLocData[newIdx][csType] = csnType;
        format(CSLocData[newIdx][csName], 32, "%s", csnName);
        CSLocData[newIdx][csLocX] = csx;
        CSLocData[newIdx][csLocY] = csy;
        CSLocData[newIdx][csLocZ] = csz;
        g_CSLocCount++;

        new csq[256];
        mysql_format(g_SQL, csq, sizeof(csq),
            "INSERT INTO `cs_locations` (`csType`,`csName`,`csLocX`,`csLocY`,`csLocZ`) VALUES (%d,'%e',%.4f,%.4f,%.4f)",
            csnType, csnName, csx, csy, csz);
        mysql_tquery(g_SQL, csq, "OnCSLocationCreated", "ii", playerid, newIdx);
        return 1;
    }

    // ---- /csdelete [csID] (admin 2+) ----
    if(strcmp(cmd, "/csdelete", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < CS_ADMIN_LEVEL)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

        while(cmdtext[idx] == ' ') idx++;
        new p1[8];
        strmid(p1, cmdtext, idx, strlen(cmdtext), 8);
        if(!strlen(p1))
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"Use "C_INFO"/csdelete [csID]"C_WHITE"."), 1;

        new csdID = strval(p1);
        new csdIdx = CSLoc_FindByID(csdID);
        if(csdIdx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"There is no CS location with that ID."), 1;

        new tname[16], dname[32];
        CS_TypeName(CSLocData[csdIdx][csType], tname, sizeof(tname));
        format(dname, sizeof(dname), "%s", CSLocData[csdIdx][csName]);

        if(IsValidDynamic3DTextLabel(g_CSLocLabel[csdIdx]))
            DestroyDynamic3DTextLabel(g_CSLocLabel[csdIdx]);

        // compacteaza array-ul (mutand ultimul element in golul ramas) si reface eticheta mutata
        g_CSLocCount--;
        if(csdIdx != g_CSLocCount)
        {
            if(IsValidDynamic3DTextLabel(g_CSLocLabel[g_CSLocCount]))
                DestroyDynamic3DTextLabel(g_CSLocLabel[g_CSLocCount]);
            CSLocData[csdIdx] = CSLocData[g_CSLocCount];
            CSLoc_RecreateLabel(csdIdx);
        }

        new csdq[96];
        mysql_format(g_SQL, csdq, sizeof(csdq), "DELETE FROM `cs_locations` WHERE `csID`=%d", csdID);
        mysql_tquery(g_SQL, csdq, "", "", 0);

        new csdm[144];
        format(csdm, sizeof(csdm), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"CS location "C_INFO"#%d"C_WHITE" (%s - %s) deleted."), csdID, tname, dname);
        SCM(playerid, COLOR_SUCCESS, csdm);
        return 1;
    }

    // ---- /cslist (lista locatiilor CS cu teleport, admin 2+) ----
    if(strcmp(cmd, "/cslist", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < CS_ADMIN_LEVEL)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

        if(g_CSLocCount == 0)
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"There are no CS locations yet. Use "C_INFO"/cscreate [csType] [name]"C_WHITE"."), 1;

        static list[6000];
        list[0] = EOS;
        strcat(list, T(playerid, ""C_INFO"ID\t"C_INFO"Type\t"C_INFO"Name\n"));
        for(new i = 0; i < g_CSLocCount; i++)
        {
            new tname[16], line[128];
            CS_TypeName(CSLocData[i][csType], tname, sizeof(tname));
            format(line, sizeof(line), ""C_WHITE"#%d\t%s%s\t"C_WHITE"%s\n",
                CSLocData[i][csID],
                (CSLocData[i][csType] == CS_TYPE_BOMBSITE) ? C_ERROR : C_SUCCESS, tname,
                CSLocData[i][csName]);
            strcat(list, line);
        }

        SPD(playerid, DIALOG_CSLIST, DIALOG_STYLE_TABLIST_HEADERS, "CS Locations", list, "Teleport", "Close");
        return 1;
    }

    // ---- /gpslist (ca /bizzlist, dar pentru toate categoriile GPS: alege categoria, apoi locatia -> teleport, admin 1+) ----
    if(strcmp(cmd, "/gpslist", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        g_GPSListAdminMode[playerid] = true;
        GPS_ShowCategoryDialog(playerid);
        return 1;
    }

    // ---- /bizzlist (lista business-uri cu teleport, admin 2+) ----
    if(strcmp(cmd, "/bizzlist", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        if(g_BusinessCount == 0)
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"There are no businesses on the server."), 1;

        static list[10000];
        list[0] = EOS;
        strcat(list, T(playerid, ""C_INFO"ID\t"C_INFO"Name\t"C_INFO"Owner / Status\t"C_INFO"Price\n"));
        for(new i = 0; i < g_BusinessCount; i++)
        {
            new bizState[64];
            if(BusinessData[i][bOwned] && BusinessData[i][bForSale]) format(bizState, sizeof(bizState), ""C_WHITE"%s "C_SUCCESS"(For Sale)", BusinessData[i][bOwnerName]);
            else if(BusinessData[i][bOwned]) format(bizState, sizeof(bizState), ""C_WHITE"%s", BusinessData[i][bOwnerName]);
            else format(bizState, sizeof(bizState), ""C_ERROR"For Sale");

            new line[220];
            format(line, sizeof(line), ""C_WHITE"#%d\t"C_WHITE"%s\t%s\t"C_SUCCESS"$%s\n",
                BusinessData[i][bID], BusinessData[i][bName], bizState, MoneyStr(BusinessData[i][bPrice]));
            strcat(list, line);
        }

        SPD(playerid, DIALOG_BIZZLIST, DIALOG_STYLE_TABLIST_HEADERS, "Business List", list, "Teleport", "Close");
        return 1;
    }

    // ---- /bblist (lista billboard-urilor cu teleport, admin 1+) ----
    if(strcmp(cmd, "/bblist", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        if(g_BillboardCount == 0)
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"There are no billboards on the server."), 1;

        static list[4096];
