    // ---- EVENIMENT SEZONIER (event_*) ----
    // UN SINGUR eveniment ("holiday"), cu nume configurabil (/holiday name) si mai multe quest-uri.
    // Cand se schimba sarbatoarea: redenumesti evenimentul si inlocuiesti quest-urile/obiectele.
    // Totul e DATE, nu cod - nimic nu cere recompilare.

    // Starea evenimentului: numele afisat + `state` (0=hide, 1=stop, 2=pause, 3=start). Un rand (id=1).
    mysql_tquery(g_SQL,
        "CREATE TABLE IF NOT EXISTS `event_config` (\
        `id`         TINYINT PRIMARY KEY,\
        `name`       VARCHAR(48) NOT NULL DEFAULT 'Holiday',\
        `state`      TINYINT NOT NULL DEFAULT 0,\
        `updated_by` VARCHAR(24) NOT NULL DEFAULT '',\
        `updated_at` DATETIME DEFAULT NULL\
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;",
        "", "", 0);
    // Migrare de la varianta veche cu `active`/`visible` pe doua coloane
    mysql_tquery(g_SQL, "ALTER TABLE `event_config` ADD COLUMN IF NOT EXISTS `state` TINYINT NOT NULL DEFAULT 0 AFTER `name`", "", "", 0);
    mysql_tquery(g_SQL, "ALTER TABLE `event_config` DROP COLUMN IF EXISTS `active`", "", "", 0);
    mysql_tquery(g_SQL, "ALTER TABLE `event_config` DROP COLUMN IF EXISTS `visible`", "", "", 0);
    mysql_tquery(g_SQL, "INSERT IGNORE INTO `event_config` (`id`,`name`,`state`) VALUES (1,'Holiday',0)", "", "", 0);

    // Definitia quest-urilor. `type` = EVENT_TYPE_* (1=collect, 2=checkpoint, 3=costume, 4=survival, 5=visit)
    // `state` = EVENT_STATE_* per quest (3=start, 2=pause, 1=stop, 0=hide), limitat de starea sarbatorii.
    // `enabled` e ramasita din varianta veche cu on/off - nu mai e citit, `state` l-a inlocuit.
    mysql_tquery(g_SQL,
        "CREATE TABLE IF NOT EXISTS `event_quests` (\
        `id`           INT AUTO_INCREMENT PRIMARY KEY,\
        `quest_key`    VARCHAR(32) NOT NULL,\
        `type`         TINYINT NOT NULL DEFAULT 1,\
        `name`         VARCHAR(48)  NOT NULL DEFAULT '',\
        `description`  VARCHAR(128) NOT NULL DEFAULT '',\
        `target`       INT NOT NULL DEFAULT 1,\
        `reward_money` INT NOT NULL DEFAULT 0,\
        `enabled`      TINYINT(1) DEFAULT 1,\
        `state`        TINYINT NOT NULL DEFAULT 3,\
        `sort_order`   INT DEFAULT 0,\
        UNIQUE KEY `uq_event_quest` (`quest_key`)\
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;",
        "", "", 0);

    // Obiecte spawnate pe harta (dovleci, cadouri, oua de Paste...). Se sterg la oprirea evenimentului.
    mysql_tquery(g_SQL,
        "CREATE TABLE IF NOT EXISTS `event_objects` (\
        `id`        INT AUTO_INCREMENT PRIMARY KEY,\
        `quest_key` VARCHAR(32) NOT NULL DEFAULT '',\
        `model`     INT NOT NULL DEFAULT 0,\
        `x`         FLOAT DEFAULT 0.0,\
        `y`         FLOAT DEFAULT 0.0,\
        `z`         FLOAT DEFAULT 0.0,\
        `rx`        FLOAT DEFAULT 0.0,\
        `ry`        FLOAT DEFAULT 0.0,\
        `rz`        FLOAT DEFAULT 0.0,\
        `interior`  INT DEFAULT 0,\
        `world`     INT DEFAULT 0,\
        KEY `idx_event_objects` (`quest_key`)\
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;",
        "", "", 0);

    // Checkpoint-uri ordonate (traseu casa bantuita etc). `cp_index` da ordinea, incepand de la 0.
    mysql_tquery(g_SQL,
        "CREATE TABLE IF NOT EXISTS `event_checkpoints` (\
        `id`        INT AUTO_INCREMENT PRIMARY KEY,\
        `quest_key` VARCHAR(32) NOT NULL DEFAULT '',\
        `cp_index`  INT NOT NULL DEFAULT 0,\
        `x`         FLOAT DEFAULT 0.0,\
        `y`         FLOAT DEFAULT 0.0,\
        `z`         FLOAT DEFAULT 0.0,\
        `size`      FLOAT DEFAULT 3.0,\
        `interior`  INT DEFAULT 0,\
        `world`     INT DEFAULT 0,\
        UNIQUE KEY `uq_event_cp` (`quest_key`,`cp_index`)\
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;",
        "", "", 0);

    // Zone circulare (arena de survival, arie tematica in care se aplica un bonus...)
    mysql_tquery(g_SQL,
        "CREATE TABLE IF NOT EXISTS `event_zones` (\
        `id`        INT AUTO_INCREMENT PRIMARY KEY,\
        `quest_key` VARCHAR(32) NOT NULL DEFAULT '',\
        `x`         FLOAT DEFAULT 0.0,\
        `y`         FLOAT DEFAULT 0.0,\
        `z`         FLOAT DEFAULT 0.0,\
        `radius`    FLOAT DEFAULT 50.0,\
        `interior`  INT DEFAULT 0,\
        `world`     INT DEFAULT 0,\
        KEY `idx_event_zones` (`quest_key`)\
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;",
        "", "", 0);

    // Personaje statice (actori). `behaviour` decide ce se intampla cand jucatorul apasa ENTER
    // langa ei: -1 = mixed (implicit; tipul se alege per jucator, deci acelasi personaj e agresiv
    // pentru unul si pasnic pentru altul), 0 = inactiv, 1 = pasnic (da progres la quest),
    // 2 = agresiv (te ataca), 3 = random (unul din efectele negative).
    // Actorii nu ocupa slot de jucator, spre deosebire de NPC bots.
    mysql_tquery(g_SQL,
        "CREATE TABLE IF NOT EXISTS `event_npcs` (\
        `id`        INT AUTO_INCREMENT PRIMARY KEY,\
        `quest_key` VARCHAR(32) NOT NULL DEFAULT '',\
        `behaviour` TINYINT NOT NULL DEFAULT -1,\
        `skin`      INT NOT NULL DEFAULT 0,\
        `health`    FLOAT DEFAULT 100.0,\
        `x`         FLOAT DEFAULT 0.0,\
        `y`         FLOAT DEFAULT 0.0,\
        `z`         FLOAT DEFAULT 0.0,\
        `angle`     FLOAT DEFAULT 0.0,\
        `interior`  INT DEFAULT 0,\
        `world`     INT DEFAULT 0,\
        KEY `idx_event_npcs` (`quest_key`)\
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;",
        "", "", 0);

    // Obiecte atasate de jucator (SetPlayerAttachedObject): CE se ataseaza (`model`) si UNDE
    // (`bone` = osul, plus offset/rotatie/scalare). Ex: dovleac in mana, caciula de Craciun pe cap.
    // `bone`: 1=spine 2=head 3=left upper arm 4=right upper arm 5=left hand 6=right hand
    //         7=left thigh 8=right thigh 9=left foot 10=right foot 11=right calf 12=left calf
    //         13=left forearm 14=right forearm 15=left clavicle 16=right clavicle 17=neck 18=jaw
    // `slot`: indexul de atasare pe jucator. ATENTIE: sloturile 0-5 sunt deja ocupate in gamemode
    //         (0=BBALL, 1=PARTY, 2=VIPHAT, 3=FISH_ROD, 4=BARDRINK, 5=PARROT), deci evenimentele
    //         au voie doar 6-9 (vezi EVENT_ATTACH_SLOT_MIN); valorile din afara sunt corectate la incarcare.
    mysql_tquery(g_SQL,
        "CREATE TABLE IF NOT EXISTS `event_attachments` (\
        `id`        INT AUTO_INCREMENT PRIMARY KEY,\
        `quest_key` VARCHAR(32) NOT NULL DEFAULT '',\
        `model`     INT NOT NULL DEFAULT 0,\
        `slot`      INT NOT NULL DEFAULT 6,\
        `bone`      INT NOT NULL DEFAULT 6,\
        `x`         FLOAT DEFAULT 0.0,\
        `y`         FLOAT DEFAULT 0.0,\
        `z`         FLOAT DEFAULT 0.0,\
        `rx`        FLOAT DEFAULT 0.0,\
        `ry`        FLOAT DEFAULT 0.0,\
        `rz`        FLOAT DEFAULT 0.0,\
        `sx`        FLOAT DEFAULT 1.0,\
        `sy`        FLOAT DEFAULT 1.0,\
        `sz`        FLOAT DEFAULT 1.0,\
        UNIQUE KEY `uq_event_attach` (`quest_key`,`slot`)\
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;",
        "", "", 0);

    // Costume disponibile pe durata evenimentului (skin ID din GTA:SA)
    mysql_tquery(g_SQL,
        "CREATE TABLE IF NOT EXISTS `event_skins` (\
        `id`        INT AUTO_INCREMENT PRIMARY KEY,\
        `skin`      INT NOT NULL DEFAULT 0,\
        `label`     VARCHAR(32) NOT NULL DEFAULT '',\
        UNIQUE KEY `uq_event_skin` (`skin`)\
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;",
        "", "", 0);

    // Curiozitati despre sarbatori romanesti si europene, spuse de personajele inactive.
    // Textul e tinut in ambele limbi aici, nu in scriptfiles/lang: lang_tool extrage doar literali
    // din bare.pwn, deci un text venit din DB nu are cum sa ajunga in ro.txt.
    // Se populeaza din `scriptfiles/sql/event_facts.sql`.
    mysql_tquery(g_SQL,
        "CREATE TABLE IF NOT EXISTS `event_facts` (\
        `id`      INT AUTO_INCREMENT PRIMARY KEY,\
        `holiday` VARCHAR(48)  NOT NULL DEFAULT '',\
        `country` VARCHAR(32)  NOT NULL DEFAULT '',\
        `fact_en` VARCHAR(160) NOT NULL DEFAULT '',\
        `fact_ro` VARCHAR(160) NOT NULL DEFAULT '',\
        `enabled` TINYINT(1)   NOT NULL DEFAULT 1,\
        UNIQUE KEY `uq_event_fact` (`holiday`)\
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;",
        "", "", 0);

    // Starea per quest a inlocuit vechiul `enabled`. Migrarea e intr-un singur UPDATE, care isi
    // sterge singur conditia (`enabled`=1), ca sa nu se reaplice la fiecare pornire si sa suprascrie
    // o stare pusa intre timp de un admin.
    mysql_tquery(g_SQL, "ALTER TABLE `event_quests` ADD COLUMN IF NOT EXISTS `state` TINYINT NOT NULL DEFAULT 3 AFTER `enabled`", "", "", 0);
    mysql_tquery(g_SQL, "UPDATE `event_quests` SET `state`=0, `enabled`=1 WHERE `enabled`=0", "", "", 0);

    mysql_tquery(g_SQL, "ALTER TABLE `event_npcs` ADD COLUMN IF NOT EXISTS `behaviour` TINYINT NOT NULL DEFAULT -1 AFTER `quest_key`", "", "", 0);
    mysql_tquery(g_SQL, "ALTER TABLE `event_npcs` MODIFY COLUMN `behaviour` TINYINT NOT NULL DEFAULT -1", "", "", 0);

    // Cu ce personaj pasnic a vorbit deja fiecare jucator (o singura data per personaj, ca la obiecte)
    mysql_tquery(g_SQL,
        "CREATE TABLE IF NOT EXISTS `event_npc_talks` (\
        `pID`      INT NOT NULL,\
        `npc_id`   INT NOT NULL,\
        `taken_at` DATETIME NOT NULL,\
        PRIMARY KEY (`pID`,`npc_id`)\
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;",
        "", "", 0);

    // Ce obiect a ridicat fiecare jucator si cand. Fara asta, o deconectare + reconectare ar reseta
    // timerele de respawn tinute in memorie si obiectele ar reaparea instant (farm prin relog).
    mysql_tquery(g_SQL,
        "CREATE TABLE IF NOT EXISTS `event_pickups` (\
        `pID`       INT NOT NULL,\
        `object_id` INT NOT NULL,\
        `taken_at`  DATETIME NOT NULL,\
        PRIMARY KEY (`pID`,`object_id`)\
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;",
        "", "", 0);

    // Progresul jucatorilor. Ramane si dupa terminarea evenimentului (istoric + anti-dubla-revendicare
    // daca acelasi eveniment e repornit in acelasi an).
    mysql_tquery(g_SQL,
        "CREATE TABLE IF NOT EXISTS `event_progress` (\
        `id`         INT AUTO_INCREMENT PRIMARY KEY,\
        `pID`        INT NOT NULL,\
        `quest_key`  VARCHAR(32) NOT NULL,\
        `progress`   INT DEFAULT 0,\
        `claimed`    TINYINT(1) DEFAULT 0,\
        `updated_at` DATETIME DEFAULT NULL,\
        UNIQUE KEY `uq_event_progress` (`pID`,`quest_key`)\
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;",
        "", "", 0);

    print("[DB] Tabele verificate/create.");
}

// ============================================================
//  INCARCARE FACTIUNI
// ============================================================
stock Factions_Load()
{
    // Reconciliaza contorul `members` cu numarul real de jucatori din tabelul players (repara drift-ul in timp).
    // Ruleaza inaintea SELECT-ului pe aceeasi conexiune (FIFO), deci valorile incarcate sunt deja corecte.
    mysql_tquery(g_SQL,
        "UPDATE `factions` f SET f.`members` = (SELECT COUNT(*) FROM `players` p WHERE p.`faction` = f.`id`)",
        "", "", 0);
    mysql_tquery(g_SQL,
        "SELECT `id`,`name`,`members`,`max_members`,`lead`,`bank`,`pickup_id`,`mapicon_id`,`hq_x`,`hq_y`,`hq_z`,\
         `interior_x`,`interior_y`,`interior_z`,`interior_a`,`interior`,`vw`,`seif_herbs`,`seif_drugs`,`skin1`,`skin2`,`skin3`,`smuggle_cooldown_day` \
         FROM `factions` ORDER BY `id` ASC",
        "OnFactionsLoaded");
}

public OnFactionsLoaded()
{
    new rows = cache_num_rows();
    for(new i = 0; i < rows; i++)
    {
        new fid;
        cache_get_value_name_int(i, "id", fid);
        if(fid < 1 || fid > MAX_FACTIONS) continue;

        cache_get_value_name    (i, "name",       FactionData[fid][fName],  32);
        cache_get_value_name_int(i, "members",    FactionData[fid][fMembers]);
        cache_get_value_name_int(i, "max_members", FactionData[fid][fMaxMembers]);
        cache_get_value_name    (i, "lead",       FactionData[fid][fLead],  24);
        cache_get_value_name_int(i, "bank",       FactionData[fid][fBank]);
        cache_get_value_name_int(i, "pickup_id",  FactionData[fid][fPickupID]);
        cache_get_value_name_int(i, "mapicon_id", FactionData[fid][fMapIconID]);
        cache_get_value_name_float(i, "hq_x",    FactionData[fid][fHQX]);
        cache_get_value_name_float(i, "hq_y",    FactionData[fid][fHQY]);
        cache_get_value_name_float(i, "hq_z",    FactionData[fid][fHQZ]);
        cache_get_value_name_float(i, "interior_x", FactionData[fid][fInteriorX]);
        cache_get_value_name_float(i, "interior_y", FactionData[fid][fInteriorY]);
        cache_get_value_name_float(i, "interior_z", FactionData[fid][fInteriorZ]);
        cache_get_value_name_float(i, "interior_a", FactionData[fid][fInteriorA]);
        cache_get_value_name_int  (i, "interior",   FactionData[fid][fInterior]);
        cache_get_value_name_int  (i, "vw",         FactionData[fid][fvw]);
        cache_get_value_name_int  (i, "seif_herbs", FactionData[fid][fSeifHerbs]);
        cache_get_value_name_int  (i, "seif_drugs", FactionData[fid][fSeifDrugs]);
        cache_get_value_name_int  (i, "skin1",      FactionData[fid][fSkin1]);
        cache_get_value_name_int  (i, "skin2",      FactionData[fid][fSkin2]);
        cache_get_value_name_int  (i, "skin3",      FactionData[fid][fSkin3]);
        cache_get_value_name_int  (i, "smuggle_cooldown_day", FactionData[fid][fSmuggleCooldownDay]);

        Factions_RecreatePickup(fid);
        Factions_RecreateLabel(fid);
        Factions_RecreateInteriorPickup(fid);
    }
    printf("[Load] Factiuni: %d", rows);

    // Markerele de seif pentru mafii (in interiorul/vw-ul fiecareia)
    for(new mfid = MAFIA_FID_MIN; mfid <= MAFIA_FID_MAX; mfid++)
    {
        Drugs_RecreateSeifMarker(mfid);
        Factions_RecreateEquipLabel(mfid);
    }
    return 1;
}

// Rezultatul /factionstats members: toti membrii (online+offline) ai factiunii fid, sortati descrescator dupa rank
public OnFactionStatsMembersLoaded(playerid, fid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    new rows = cache_num_rows();
    new body[2500];
    format(body, sizeof(body), T(playerid, "%s\n\nMembers:\n"), FactionData[fid][fName]);

    for(new i = 0; i < rows; i++)
    {
        new fsmName[24], fsmRank;
        cache_get_value_name    (i, "username",     fsmName, sizeof(fsmName));
        cache_get_value_name_int(i, "faction_rank",  fsmRank);

        new bool:fsmOnline = false;
        for(new p = 0; p < MAX_PLAYERS; p++)
        {
            if(!IsPlayerConnected(p) || !PlayerData[p][pLogged]) continue;
            if(strcmp(PlayerData[p][pName], fsmName, true) == 0) { fsmOnline = true; break; }
        }

        new fsmStatus[24]; // "{RRGGBB}" (8) + "online"/"offline" (max 7) + "{RRGGBB}" (8) + EOS = max 24
        if(fsmOnline) format(fsmStatus, sizeof(fsmStatus), C_SUCCESS"online"C_WHITE);
        else          format(fsmStatus, sizeof(fsmStatus), C_ERROR"offline"C_WHITE);

        new line[80];
        format(line, sizeof(line), "Rank %d: %s (%s)\n", fsmRank, fsmName, fsmStatus);
        strcat(body, line);
    }

    SPD(playerid, DIALOG_FACTIONSTATS, DIALOG_STYLE_MSGBOX, FactionData[fid][fName], body, "Close", "");
    return 1;
}

public OnPlayerSkinsLoaded(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    for(new s = 0; s < SKIN_COUNT; s++) g_SkinQty[playerid][s] = 0;

    new rows = cache_num_rows();
    for(new i = 0; i < rows; i++)
    {
        new sid, qty;
        cache_get_value_name_int(i, "skin_id", sid);
        cache_get_value_name_int(i, "qty", qty);
        if(sid >= 0 && sid <= 311) g_SkinQty[playerid][sid] = qty;
    }

    // garanteaza ca detine skin-ul purtat curent (il insereaza in DB daca lipsea)
    new cur = PlayerData[playerid][pSkin];
    if(cur >= 0 && cur <= 311 && !Skin_Owns(playerid, cur))
    {
        g_SkinQty[playerid][cur] = 1;
        new q[128];
        mysql_format(g_SQL, q, sizeof(q),
            "INSERT INTO `player_skins` (`player_id`,`skin_id`,`qty`) VALUES (%d,%d,1) ON DUPLICATE KEY UPDATE `qty`=`qty`+1",
            PlayerData[playerid][pID], cur);
        mysql_tquery(g_SQL, q, "", "", 0);
    }
    return 1;
}

// ============================================================
//  INCARCARE CASE
// ============================================================
stock Houses_Load()
{
    mysql_tquery(g_SQL,
        "SELECT `id`,`name`,`owner`,`owner_id`,`owned`,`is_for_sale`,`price`,`default_price`,`type`,`max_pets`,`pets`,`loc_x`,`loc_y`,`loc_z`,`interior`,`int_x`,`int_y`,`int_z`,\
         `has_fridge`,`fridge_milk`,`fridge_banana`,`fridge_water`,`fridge_juice`,`fridge_beer`,`fridge_expire`,`has_bed`,`bed_Exp`,`bank`,`sgr`,`trash`,`tree_id`,`issue`,\
         `is_rentable`,`rent_price`,`renter_id` FROM `houses` ORDER BY `id` ASC",
        "OnHousesLoaded");
}

public OnHousesLoaded()
{
    // Teardown complet inainte de reincarcare (necesar pt. /reload - fara asta, pickup-urile/etichetele vechi ar ramane orfane)
    for(new i = 0; i < MAX_HOUSES; i++)
    {
        if(g_HousePickup[i] != -1) { DestroyPickup(g_HousePickup[i]); g_HousePickup[i] = -1; }
        if(g_HouseLabel[i] != Text3D:INVALID_3DTEXT_ID) { Delete3DTextLabel(g_HouseLabel[i]); g_HouseLabel[i] = Text3D:INVALID_3DTEXT_ID; }
    }

    new rows = cache_num_rows();
    g_HouseCount = 0;
    for(new i = 0; i < rows && g_HouseCount < MAX_HOUSES; i++)
    {
        new idx = g_HouseCount;
        cache_get_value_name_int  (i, "id",       HouseData[idx][hID]);
        cache_get_value_name      (i, "name",     HouseData[idx][hName],  32);
        cache_get_value_name      (i, "owner",    HouseData[idx][hOwnerName], 24);
        cache_get_value_name_int  (i, "owner_id", HouseData[idx][hOwnerId]);
        cache_get_value_name_int  (i, "owned",    HouseData[idx][hOwned]);
        cache_get_value_name_int  (i, "is_for_sale", HouseData[idx][hForSale]);
        cache_get_value_name_int  (i, "price",    HouseData[idx][hPrice]);
        cache_get_value_name_int  (i, "default_price", HouseData[idx][hDefaultPrice]);
        cache_get_value_name_int  (i, "type",     HouseData[idx][hType]);
        cache_get_value_name_int  (i, "max_pets", HouseData[idx][hMaxPets]);
        cache_get_value_name_int  (i, "pets",     HouseData[idx][hPets]);
        cache_get_value_name_float(i, "loc_x", HouseData[idx][hLocX]);
        cache_get_value_name_float(i, "loc_y", HouseData[idx][hLocY]);
        cache_get_value_name_float(i, "loc_z", HouseData[idx][hLocZ]);
        cache_get_value_name_int  (i, "interior", HouseData[idx][hInterior]);
        cache_get_value_name_float(i, "int_x", HouseData[idx][hIntLocX]);
        cache_get_value_name_float(i, "int_y", HouseData[idx][hIntLocY]);
        cache_get_value_name_float(i, "int_z", HouseData[idx][hIntLocZ]);
        cache_get_value_name_int  (i, "has_fridge",    HouseData[idx][hHasFridge]);
        cache_get_value_name_int  (i, "fridge_milk",   HouseData[idx][hFridge][0]);
        cache_get_value_name_int  (i, "fridge_banana", HouseData[idx][hFridge][1]);
        cache_get_value_name_int  (i, "fridge_water",  HouseData[idx][hFridge][2]);
        cache_get_value_name_int  (i, "fridge_juice",  HouseData[idx][hFridge][3]);
        cache_get_value_name_int  (i, "fridge_beer",   HouseData[idx][hFridge][4]);
        cache_get_value_name_int  (i, "fridge_expire", HouseData[idx][hFridgeExpire]);
        cache_get_value_name_int  (i, "has_bed",       HouseData[idx][hHasBed]);
        new bedExpStr2[11];
        cache_get_value_name     (i, "bed_Exp", bedExpStr2, sizeof(bedExpStr2));
        HouseData[idx][hBedExpire] = DateStrToUnix(bedExpStr2);
        cache_get_value_name_int  (i, "bank",          HouseData[idx][hBank]);
        cache_get_value_name_int  (i, "sgr",           HouseData[idx][hSGR]);
        cache_get_value_name_int  (i, "trash",         HouseData[idx][hTrash]);
        cache_get_value_name_int  (i, "tree_id",       HouseData[idx][hTreeId]);
        cache_get_value_name_int  (i, "issue",         HouseData[idx][hIssue]);
        cache_get_value_name_int  (i, "is_rentable",   HouseData[idx][hIsRentable]);
        cache_get_value_name_int  (i, "rent_price",    HouseData[idx][hRentPrice]);
        cache_get_value_name_int  (i, "renter_id",     HouseData[idx][hRenterId]);
        g_HousePickup[idx] = -1;
        g_HouseLabel[idx]  = Text3D:INVALID_3DTEXT_ID;
        Houses_RecreatePickup(idx);
        g_HouseCount++;
    }
    printf("[Load] Case: %d", g_HouseCount);
    // Nota: Animals_Load() e apelat din OnGameModeInit imediat dupa Houses_Load(),
    // deci OnAnimalsLoaded ruleaza dupa acest callback (case deja incarcate).
    return 1;
}

