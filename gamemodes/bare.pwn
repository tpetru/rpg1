#define JOB_TRUCKDRIVER          14
#define JOB_CURRENCY             15

// Quest-uri saptamanale per religie (/quest) - definite aici (nu langa restul sistemului de religie,
// mai jos in fisier) pentru ca actionType-urile sunt folosite ca hook-uri in cod care apare mai devreme
// in fisier decat sectiunea de religie, iar #define-urile trebuie sa fie vizibile inaintea folosirii lor.
#define QUEST_MODE_COUNT      0  // se numara de X ori o actiune (Quest_AddProgress)
#define QUEST_MODE_AVOID_SIN  1  // indeplinit daca pacatul qSinNumber nu a fost comis saptamana asta (citire din `pacate`, fara hook)

#define QUEST_ACTION_DONATE   1  // /pay catre alt jucator
#define QUEST_ACTION_TUNE     2  // piesa de tuning instalata (Loco Outlaw Customs)
#define QUEST_ACTION_CROPDUST 3  // livrare Crop Duster Pilot
#define QUEST_ACTION_FUEL     4  // livrare Fuel Carrier
#define QUEST_ACTION_PLANT    5  // puiet plantat (forest)
#define QUEST_ACTION_WATER    6  // tura Water Hauler completa

// ------------------------------------------------------------
//  EVENIMENTE SEZONIERE (Halloween / Craciun / Paste / ...)
//  Sistem generic: mecanicile sunt aceleasi pentru toate evenimentele,
//  doar datele difera (obiecte, coordonate, skin-uri, recompense) si vin din
//  tabelele `event_*`. Un singur eveniment e activ la un moment dat.
//  Defineste aici (nu langa implementare, mai jos in fisier) ca hook-urile
//  Event_AddProgress din codul de deasupra sa vada constantele.
// ------------------------------------------------------------
#define EVENT_KEY_LEN            32   // lungime maxima pentru event_key / quest_key
#define EVENT_MAX_QUESTS         16   // quest-uri per eveniment activ
// Obiectele de colectat sunt PER JUCATOR (fiecare isi vede propriul set - ce ridica unul nu
// dispare pentru ceilalti), deci se tin doua tablouri [MAX_PLAYERS][EVENT_MAX_OBJECTS].
// De aia limita e mai mica decat la restul: fiecare punct costa memorie inmultita cu MAX_PLAYERS.
#define EVENT_MAX_OBJECTS       150   // puncte de spawn per quest-uri, per jucator
#define EVENT_MAX_CHECKPOINTS    64   // checkpoint-uri (toate traseele evenimentului la un loc)
#define EVENT_MAX_ZONES           8   // zone (survival / arii tematice)
#define EVENT_MAX_NPCS           64   // puncte de spawn NPC (zombie etc.)
#define EVENT_MAX_SKINS          16   // costume disponibile in eveniment
#define EVENT_MAX_ATTACH         16   // obiecte atasabile de jucator (dovleac in mana etc.)

// Sloturile SetPlayerAttachedObject 0-5 sunt deja folosite in gamemode (BBALL/PARTY/VIPHAT/
// FISH_ROD/BARDRINK/PARROT), deci evenimentele pot folosi doar 6-9.
#define EVENT_ATTACH_SLOT_MIN     6

// Tipurile de mecanica. Un quest din `event_quests` are exact un tip; datele lui
// (coordonate/modele) sunt in tabela corespunzatoare, filtrate pe `quest_key`.
#define EVENT_TYPE_COLLECT        1  // aduna N obiecte raspandite pe harta   -> event_objects
#define EVENT_TYPE_CHECKPOINT     2  // parcurge N checkpoint-uri in ordine    -> event_checkpoints
#define EVENT_TYPE_COSTUME        3  // poarta un skin tematic                 -> event_skins
#define EVENT_TYPE_SURVIVAL       4  // supravietuieste intr-o zona            -> event_zones + event_npcs
#define EVENT_TYPE_VISIT          5  // viziteaza N locatii (ex. case)         -> event_objects (ca marker)

// Starea evenimentului - o scara: fiecare treapta in jos stinge inca un lucru.
//   START  obiecte pe harta + progres + vizibil in /quest   (eveniment normal)
//   PAUSE  fara obiecte, dar progresul si afisarea raman     (suspendare temporara)
//   STOP   fara obiecte, fara progres nou, dar inca vizibil  (s-a terminat, dar se vede)
//   HIDE   nimic: nici obiecte, nici progres, nici afisare   (ascuns complet)
#define EVENT_STATE_HIDE          0
#define EVENT_STATE_STOP          1
#define EVENT_STATE_PAUSE         2
#define EVENT_STATE_START         3

#define EVENT_COLLECT_RANGE     2.0  // cat de aproape trebuie sa fii de obiect ca sa-l ridici

// Personaje statice (actori) - ce fac cand apesi ENTER langa ele
#define EVENT_NPC_IDLE          0    // inactiv: nu se intampla nimic
#define EVENT_NPC_PEACEFUL      1    // pasnic: iti da o treaba scurta = progres la quest-ul lui
#define EVENT_NPC_AGGRESSIVE    2    // agresiv: te ataca (shotgun sau deagle)
#define EVENT_NPC_RANDOM        3    // random: unul din efectele negative (viata 10 / bolnav / obosit+beat)
#define EVENT_NPC_MIXED        -1    // implicit: tip ales per jucator (acelasi personaj e altfel pentru fiecare)

#define EVENT_NPC_RANGE         2.5  // raza de interactiune cu un personaj
#define EVENT_NPC_COOLDOWN_MS 60000  // cat astepti pana poti reinteractiona cu acelasi personaj (1 min)
#define EVENT_NPC_TIRED_MAX     100  // oboseala maxima (vezi pTired)
#define EVENT_NPC_DRUNK_LEVEL  4000  // cat de beat te lasa personajul "random"

// Curiozitati despre sarbatori (romanesti si europene) - le spun personajele inactive.
// Textul e in DB (`event_facts`), in ambele limbi, fiindca lang_tool nu poate extrage din baza de date.
#define EVENT_MAX_FACTS          40
#define EVENT_FACT_LEN          160
#define EVENT_FACT_LINE         118  // cat scoatem pe o linie de chat; peste asta textul se rupe in doua

#define LUMBER_TRUCK_MODEL       433
#define LUMBER_CARRY_TIME_MS     45000  // 45 secunde sa urci in camion dupa ce ai taiat
#define LUMBER_DELIVER_BIZ_ID    13
#define LUMBER_DELIVER_CP_SIZE   6.0
#define LUMBER_PAY_BASE          7500
#define LUMBER_PAY_PER_TREE      100
#define LUMBER_CUT_MIN           5
#define LUMBER_CUT_RAND          6      // nrCopaci = 5 + random(6) => 5-10

#define LUMBER_STATE_NONE        0
#define LUMBER_STATE_CARRYING    1  // a taiat, are 45s sa urce in camion
#define LUMBER_STATE_DELIVERING  2  // e in camion, checkpoint spre biz 13

new g_LumberState[MAX_PLAYERS];
