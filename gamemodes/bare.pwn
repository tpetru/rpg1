{
    gtaIntID, gtaIntInterior, gtaIntName[64], gtaIntFor[24],
    Float:gtaIntLocX, Float:gtaIntLocY, Float:gtaIntLocZ
}
new GTAInteriorData[MAX_GTA_INTERIORS][E_GTA_INTERIOR_DATA];
