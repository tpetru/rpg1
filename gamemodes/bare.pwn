new Float:UPDOWN_TICKET_LOC_Z = 0.0;

// Perechi de capete /up - /down. Fiecare pereche e independenta: /up la statia i te duce la g_UpDownDown[i], si invers.
new const Float:g_UpDownUp[UPDOWN_PAIR_COUNT][3] = {
    {1468.5474, -1067.7454,  23.8281}, // 0 - Bank
    {1550.4541, -1790.4708,  15.0293}, // 1 - Primarie
    {1585.2581, -2286.7246,  13.5396}  // 2 - Airport
};
new const Float:g_UpDownDown[UPDOWN_PAIR_COUNT][3] = {
    {1468.0204, -1069.2866, 213.3828}, // 0 - Bank
    {1494.6074, -1789.9895, 113.8872}, // 1 - Primarie
    {1627.1584, -2286.9531,  94.1328}  // 2 - Airport
};

// Cauta perechea /up - /down in raza careia se afla playerul.
// side: 0 = cauta printre capetele "up", 1 = printre cele "down". Returneaza indexul din perechi, sau -1.
stock UpDown_FindPair(playerid, side)
{
    for(new i = 0; i < UPDOWN_PAIR_COUNT; i++)
    {
        if(side == 0 && IsPlayerInRangeOfPoint(playerid, UPDOWN_RANGE, g_UpDownUp[i][0], g_UpDownUp[i][1], g_UpDownUp[i][2]))
            return i;
        if(side == 1 && IsPlayerInRangeOfPoint(playerid, UPDOWN_RANGE, g_UpDownDown[i][0], g_UpDownDown[i][1], g_UpDownDown[i][2]))
            return i;
    }
    return -1;
}

// Creeaza pickup-urile + etichetele 3D la toate capetele tuturor gondolelor
stock UpDown_Create()
{
    for(new i = 0; i < UPDOWN_PAIR_COUNT; i++)
    {
        CreatePickup(UPDOWN_PICKUP_MODEL, 1, g_UpDownUp[i][0], g_UpDownUp[i][1], g_UpDownUp[i][2], -1);
        Create3DTextLabel("[ Gondola ]\n[ Use /up ]\n[ Price 10$ ]", COLOR_WHITE,
            g_UpDownUp[i][0], g_UpDownUp[i][1], g_UpDownUp[i][2] - 0.5, 20.0, 0, 0);

        CreatePickup(UPDOWN_PICKUP_MODEL, 1, g_UpDownDown[i][0], g_UpDownDown[i][1], g_UpDownDown[i][2], -1);
        Create3DTextLabel("[ Gondola ]\n[ Use /down ]\n[ Price 10$ ]", COLOR_WHITE,
            g_UpDownDown[i][0], g_UpDownDown[i][1], g_UpDownDown[i][2] - 0.5, 20.0, 0, 0);
