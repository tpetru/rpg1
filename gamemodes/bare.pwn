#define FUNERAL_STATE_NONE     0
#define FUNERAL_STATE_TOHOUSE  1  // in drum spre casa, sa incarce animalul
#define FUNERAL_STATE_TOCHURCH 2  // in drum spre capela, sa descarce

new Float:FUNERAL_CHURCH_X = 940.1021;
new Float:FUNERAL_CHURCH_Y = -1086.7830;
new Float:FUNERAL_CHURCH_Z = 24.1184;

#define MAX_FUNERAL_DIALOG_ROWS 20

new g_FuneralVehicleId[MAX_FUNERAL_VEHICLES];
new g_FuneralState[MAX_PLAYERS];
new g_FuneralVehicle[MAX_PLAYERS] = {-1, ...}; // vehiculul (Romero) cu care a inceput cursa
new g_FuneralReturnTimer[MAX_PLAYERS] = {-1, ...};
new g_FuneralAnimalId[MAX_PLAYERS] = {-1, ...}; // aID-ul animalului ales pentru inmormantare
new g_FuneralDialogAnimal[MAX_PLAYERS][MAX_FUNERAL_DIALOG_ROWS]; // rand din dialog -> index in AnimalData
new g_FuneralDialogCount[MAX_PLAYERS];

// Creeaza cele 2 dricuri (Romero) folosite pentru /funeral
stock Funeral_CreateVehicles()
{
    g_FuneralVehicleId[0] = CreateVehicle(FUNERAL_MODEL, 937.8110, -1124.6215, 23.7932,  30.8982, 0, 0, 600); // romero1
    g_FuneralVehicleId[1] = CreateVehicle(FUNERAL_MODEL, 923.2508, -1124.6659, 23.7901, 328.5740, 0, 0, 600); // romero2

    new frPlate[16];
    for(new i = 0; i < MAX_FUNERAL_VEHICLES; i++)
    {
        if(g_FuneralVehicleId[i] == -1) continue;
        format(frPlate, sizeof(frPlate), "ROMERO %d", i + 1);
        SetVehicleNumberPlate(g_FuneralVehicleId[i], frPlate);
        SetVehicleToRespawn(g_FuneralVehicleId[i]);
    }
}

stock bool:Funeral_IsVehicle(vehicleid)
{
    if(vehicleid <= 0) return false;
    for(new i = 0; i < MAX_FUNERAL_VEHICLES; i++)
        if(g_FuneralVehicleId[i] == vehicleid) return true;
    return false;
}

// ============================================================
//  TRAIN STATIONS - /train (teleport intre statii, $150 biletul)
// ============================================================
#define TRAIN_STATION_COUNT  3
#define TRAIN_PRICE          150
#define TRAIN_RANGE          5.0
#define TRAIN_TEXTDRAW_MS    3000 // cat sta ecranul de loading dupa teleport
#define TRAIN_FREEZE_MS      4000 // cat sta playerul inghetat (mai mult decat textdraw-ul, ca sigurant

new Float:g_TrainStationX[TRAIN_STATION_COUNT] = { 824.5266, 1738.9800, 2261.1694 };   // suprascrise din locations_admin (id 60/61/62)
new Float:g_TrainStationY[TRAIN_STATION_COUNT] = { -1361.0516, -1950.0106, -1507.2927 };
new Float:g_TrainStationZ[TRAIN_STATION_COUNT] = { -0.5078, 14.1172, 21.5038 };
new const Float:g_TrainStationA[TRAIN_STATION_COUNT] = { 135.3791, 179.8073, 245.6390 };
new const g_TrainStationName[TRAIN_STATION_COUNT][32] = { "W LosSantion Station", "S LosSantion Station", "E LosSantion Station" };

new g_TrainTarget[MAX_PLAYERS]     = {-1, ...}; // statia aleasa, in asteptare cat dureaza freeze-ul
new g_TrainTDTimer[MAX_PLAYERS]    = {-1, ...}; // timer-ul care ascunde textdraw-ul (3s)
new g_TrainFreezeTimer[MAX_PLAYERS] = {-1, ...}; // timer-ul care dezgheata playerul (4s)
new bool:g_TrainUsedThisPayday[MAX_PLAYERS]; // o singura calatorie cu trenul per payday; resetat in PayDay_Apply

new g_TrainPickup[TRAIN_STATION_COUNT];
new Text3D:g_TrainLabel[TRAIN_STATION_COUNT] = {Text3D:INVALID_3DTEXT_ID, ...};

// Creeaza pickup-ul + eticheta 3D pentru fiecare statie de tren
stock Train_CreateStations()
{
    for(new i = 0; i < TRAIN_STATION_COUNT; i++)
    {
        g_TrainPickup[i] = CreatePickup(19131, 1, g_TrainStationX[i], g_TrainStationY[i], g_TrainStationZ[i], -1);

        new label[128];
        format(label, sizeof(label), "[ %s ]\n[ Use /train to travel ]\n[ Price: %d$ ]", g_TrainStationName[i], TRAIN_PRICE);
        g_TrainLabel[i] = Create3DTextLabel(label, COLOR_WHITE, g_TrainStationX[i], g_TrainStationY[i], g_TrainStationZ[i] - 0.5, 20.0, 0, 0);
    }
}

// Returneaza indexul statiei in raza TRAIN_RANGE fata de player, sau -1
stock Train_FindNearbyIndex(playerid)
{
    for(new i = 0; i < TRAIN_STATION_COUNT; i++)
        if(IsPlayerInRangeOfPoint(playerid, TRAIN_RANGE, g_TrainStationX[i], g_TrainStationY[i], g_TrainStationZ[i]))
            return i;
    return -1;
}

// La 3s dupa teleport: ascunde ecranul de loading si anunta bun venit
forward Train_TextdrawDone(playerid);
public Train_TextdrawDone(playerid)
{
    g_TrainTDTimer[playerid] = -1;
    if(!IsPlayerConnected(playerid)) return 0;

    LoginBG_Destroy(playerid);

    new st = g_TrainTarget[playerid];
    if(st != -1)
    {
        new wmsg[192];
        format(wmsg, sizeof(wmsg), T(playerid, C_SUCCESS"[Train] "C_WHITE"Welcome to "C_INFO"%s"C_WHITE". We hope you had an excellent trip, and we look forward to seeing you again."),
            g_TrainStationName[st]);
        SCM(playerid, COLOR_SUCCESS, wmsg);
    }
    return 1;
}

// La 4s dupa teleport: dezgheata playerul
forward Train_Unfreeze(playerid);
public Train_Unfreeze(playerid)
{
    g_TrainFreezeTimer[playerid] = -1;
    if(!IsPlayerConnected(playerid)) return 0;

    TogglePlayerControllable(playerid, 1);
    g_TrainTarget[playerid] = -1;
    return 1;
}

// ============================================================
//  TAXI SERVICE - /taxi (teleport la orice locatie din GPS, $200, o data per payday)
// ============================================================
#define TAXI_RANGE        5.0
#define TAXI_PRICE        200
#define TAXI_TEXTDRAW_MS  3000 // cat sta ecranul de loading dupa teleport
#define TAXI_FREEZE_MS    4000 // cat sta playerul inghetat (mai mult decat textdraw-ul, ca siguranta)

// Punctele de /taxi - din locations_admin (locID 148 = taxi-civil, 149 = taxi-jail, 150 = Taxi Market), NU coordonate fixe in gamemode
#define TAXI_LOC_COUNT 3
new const g_TaxiLocID[TAXI_LOC_COUNT] = {148, 149, 150};
new Float:g_TaxiLocX[TAXI_LOC_COUNT], Float:g_TaxiLocY[TAXI_LOC_COUNT], Float:g_TaxiLocZ[TAXI_LOC_COUNT];

new bool:g_TaxiUsedThisPayday[MAX_PLAYERS]; // o singura calatorie cu taxiul per payday; resetat in PayDay_Apply
new g_TaxiTDTimer[MAX_PLAYERS]    = {-1, ...};
new g_TaxiFreezeTimer[MAX_PLAYERS] = {-1, ...};
new g_TaxiTargetName[MAX_PLAYERS][48];

// Creeaza pickup-ul + eticheta 3D la fiecare punct de taxi, folosind g_TaxiLocX/Y/Z
// (deja rezolvate din locations_admin de Locations_ApplyToCommands) - apelat din Cmd_CreateMarkers
stock Taxi_CreateStation()
{
    new label[96];
    format(label, sizeof(label), "[ Service Taxi ]\n[ Use /taxi ]\n[ Price: %d$ ]", TAXI_PRICE);

    for(new i = 0; i < TAXI_LOC_COUNT; i++)
    {
        if(g_TaxiLocX[i] == 0.0 && g_TaxiLocY[i] == 0.0) continue; // locatia nu a fost gasita in DB

        CreatePickup(19308, 1, g_TaxiLocX[i], g_TaxiLocY[i], g_TaxiLocZ[i], -1);
        Create3DTextLabel(label, COLOR_WHITE, g_TaxiLocX[i], g_TaxiLocY[i], g_TaxiLocZ[i] - 0.5, 20.0, 0, 0);
    }
}

// True daca playerul e in raza TAXI_RANGE fata de oricare punct de taxi
stock bool:Taxi_IsPlayerAtStation(playerid)
{
    for(new i = 0; i < TAXI_LOC_COUNT; i++)
        if(IsPlayerInRangeOfPoint(playerid, TAXI_RANGE, g_TaxiLocX[i], g_TaxiLocY[i], g_TaxiLocZ[i]))
            return true;
    return false;
}

// La 3s dupa teleport: ascunde ecranul de loading si anunta bun venit
forward Taxi_TextdrawDone(playerid);
public Taxi_TextdrawDone(playerid)
{
    g_TaxiTDTimer[playerid] = -1;
    if(!IsPlayerConnected(playerid)) return 0;

    LoginBG_Destroy(playerid);

    new wmsg[192];
    format(wmsg, sizeof(wmsg), T(playerid, C_SUCCESS"[Taxi] "C_WHITE"You have arrived at "C_INFO"%s"C_WHITE". Thank you for using our taxi service."),
        g_TaxiTargetName[playerid]);
    SCM(playerid, COLOR_SUCCESS, wmsg);
    return 1;
}

// La 4s dupa teleport: dezgheata playerul
forward Taxi_Unfreeze(playerid);
public Taxi_Unfreeze(playerid)
{
    g_TaxiFreezeTimer[playerid] = -1;
    if(!IsPlayerConnected(playerid)) return 0;

    TogglePlayerControllable(playerid, 1);
    return 1;
}

// ============================================================
//  ANIMATII - /anim, /anim2, /animlibs, /animlist, /animstop
// ============================================================
// Lista curatata de librarii GTA SA cunoscute (extensibila - adauga in AnimLib_GetAnims + aici)
new g_AnimAllLibs[] = "SWORD,KNIFE,GRENADE,BOMBER,BSKTBALL,DANCING,KISSING,SMOKING,SUNBATHE,FOOD,RIOT,MISC,MISC2,SHOP,CRACK,INT_HOUSE,INT_OFFICE,INT_SHOP,POLICE_AR,CRIB,BAR,ABSEIL,PARACHUTE,SKATE,PED,ON_LOOKER";

// Returneaza (prin dest) lista de animatii (separate prin virgula) ale unei librarii; false daca libraria nu e cunoscuta
stock bool:AnimLib_GetAnims(const lib[], dest[], destsize)
{
    if(strcmp(lib, "SWORD", true) == 0)
    {
        format(dest, destsize, "%s", "sword_block,sword_ready,sword_run,sword_strafe,sword_walk,sword_WO_block,sword_WO_ready,sword_WO_run,sword_WO_strafe,sword_WO_walk,WeaponExpert");
        return true;
    }
    if(strcmp(lib, "KNIFE", true) == 0)
    {
        format(dest, destsize, "%s", "KILL_Knife_Ped_Damage,KILL_Knife_Ped_Die,KNIFE_ATTACK_A,KNIFE_ATTACK_B,KNIFE_ATTACK_C,KNIFE_ATTACK_D,KNIFE_IDLE,KNIFE_PARRY_A,KNIFE_PARRY_B,KNIFE_PARRY_C");
        return true;
    }
    if(strcmp(lib, "GRENADE", true) == 0)
    {
        format(dest, destsize, "%s", "WEAPON_throwu,WEAPON_throw");
        return true;
    }
    if(strcmp(lib, "BOMBER", true) == 0)
    {
        format(dest, destsize, "%s", "BOM_Plant,CHAT_A,CHAT_B");
        return true;
    }
    if(strcmp(lib, "BSKTBALL", true) == 0)
    {
        format(dest, destsize, "%s", "BBALL_Block,BBALL_Def_loop,BBALL_Def_S2S,BBALL_Idle_01,BBALL_Idle_02,BBALL_Jog_Ball,BBALL_Pass,BBALL_Run_Ball,BBALL_Shot_Hoop,BBALL_Shoot,BBALL_Sprint_Ball");
        return true;
    }
    if(strcmp(lib, "DANCING", true) == 0)
    {
        format(dest, destsize, "%s", "DAN_Loop_A,DAN_Loop_B,DAN_Loop_C,DAN_Loop_D,DAN_Loop_E,DAN_Loop_F,DAN_Loop_G,DNCE_M_a,DNCE_M_b,DNCE_M_c,DNCE_M_d,DNCE_M_e,club_dnce_M_a,club_dnce_M_b,club_dnce_M_c,club_dnce_M_d,club_dnce_M_e");
        return true;
    }
    if(strcmp(lib, "KISSING", true) == 0)
    {
        format(dest, destsize, "%s", "Playa_Kiss_60_loop_A,Playa_Kiss_60_loop_B,GF_Kiss_loop_a,GF_Kiss_loop_b,GF_Kiss_loop_c,GF_Kiss_loop_d,GF_Kiss_loop_e");
        return true;
    }
    if(strcmp(lib, "SMOKING", true) == 0)
    {
        format(dest, destsize, "%s", "F_smklean_loop,M_smk_in,M_smk_loop,M_smklean_loop,M_smkstand_loop,smk_drug_loop");
        return true;
    }
    if(strcmp(lib, "SUNBATHE", true) == 0)
    {
        format(dest, destsize, "%s", "BATHE_Loop,BATHE_in,BATHE_out");
        return true;
    }
    if(strcmp(lib, "FOOD", true) == 0)
    {
        format(dest, destsize, "%s", "EAT_Burger,EAT_Chicken,EAT_Cookie,EAT_Cook_loop_01,EAT_Cook_loop_02");
        return true;
    }
    if(strcmp(lib, "RIOT", true) == 0)
    {
        format(dest, destsize, "%s", "RIOT_ANGRY,RIOT_CHANT,RIOT_FIST_L,RIOT_FIST_R,RIOT_PUNCHOUT_L,RIOT_PUNCHOUT_R,RIOT_SHOUT_01,RIOT_SHOUT_02");
        return true;
    }
    if(strcmp(lib, "MISC", true) == 0)
    {
        format(dest, destsize, "%s", "BLOWJOBBING,CANDLEIN,CANDLEOUT,DRUG_TWITCH,FLASH,FLASH_out,PISSIN_LOOP,TERM_INJURED_A,USETRUNK_IN,USETRUNK_LOOP,USETRUNK_OUT");
        return true;
    }
    if(strcmp(lib, "MISC2", true) == 0)
    {
        format(dest, destsize, "%s", "CHOKE_both,CHOKE_death,CHOKE_handsup,DAM_Hit_v2ARM,DAM_Hit_v2FACE,DAM_Hit_v2HEAD,DAM_Hit_v2SPINE,FALL_Cower,FALL_Direction,KO_skid_back,KO_skid_front,PUNCH_BIG");
        return true;
    }
    if(strcmp(lib, "SHOP", true) == 0)
    {
        format(dest, destsize, "%s", "SHP_Bag,SHP_Buy");
        return true;
    }
    if(strcmp(lib, "CRACK", true) == 0)
    {
        format(dest, destsize, "%s", "crckdeth1,crckidle1,cs_hndsup");
        return true;
    }
