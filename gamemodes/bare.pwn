// Returneaza indexul (in GTAInteriorData) al interiorului cu gtaIntID == id, sau -1
stock GTAInteriors_FindByID(id)
{
    for(new i = 0; i < g_GTAInteriorCount; i++)
        if(GTAInteriorData[i][gtaIntID] == id) return i;
    return -1;
