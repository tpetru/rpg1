        "INSERT INTO `event_objects` (`quest_key`,`model`,`x`,`y`,`z`,`rz`,`interior`,`world`) \
         VALUES ('%e',%d,%.4f,%.4f,%.4f,%.4f,%d,%d)",
        questKey, model, x, y, z, a,
        GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid));
    mysql_tquery(g_SQL, q, "OnEventObjAdded", "i", playerid);
}

