// ---- Bariera LSPD (facțiunea 1 o deschide cu tasta H / horn) ----
new STREAMER_TAG_OBJECT:g_LSPDBarrier;
new bool:g_LSPDBarrierOpen = false;
new g_LSPDBarrierTimer = -1;
// LSPD_BARRIER_X/Y/Z declarate mai sus (langa coordonatele Politiei), ca sa fie vizibile in Locations_ApplyToCommands
#define LSPD_BARRIER_RANGE   10.0
#define LSPD_BARRIER_SPEED   0.5
forward LSPDBarrier_Close();

public LSPDBarrier_Close()
{
    MoveDynamicObject(g_LSPDBarrier, LSPD_BARRIER_X, LSPD_BARRIER_Y, LSPD_BARRIER_Z, LSPD_BARRIER_SPEED, 0.0, 90.0, 90.0);
    g_LSPDBarrierOpen = false;
    g_LSPDBarrierTimer = -1;
    return 1;
}

forward Veh_SpawnAll();
forward Veh_ForceAllEnginesOff();

// Forteaza motorul oprit pe toate vehiculele existente (statice/job/personale/factiune).
// Apelat o singura data, la cateva secunde dupa pornire, dupa ce toate vehiculele (inclusiv
// cele personale/factiune incarcate async din DB) au fost create.
public Veh_ForceAllEnginesOff()
{
    for(new v = 1; v < MAX_VEHICLES; v++)
    {
        if(GetVehicleModel(v) == 0) continue;

        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(v, engine, lights, alarm, doors, bonnet, boot, objective);
        if(engine) SetVehicleParamsEx(v, 0, lights, alarm, doors, bonnet, boot, objective);
    }
    return 1;
}

// Spawneaza toate vehiculele statice/de job/de examen. Apelat de un timer la 1 secunda dupa OnGameModeInit,
// nu direct, ca serverul sa fie deja pornit complet cand apar vehiculele.
public Veh_SpawnAll()
{
    // Biciclete de inchiriat
    g_RentBikeVehicle[0] = CreateVehicle(510,850.5624,-2054.5640,12.4752,66.0922,46,46,600); // mtb
    g_RentBikeVehicle[1] = CreateVehicle(510,851.7432,-2050.4297,12.4752,67.0849,46,46,600); // mtb2
    g_RentBikeVehicle[2] = CreateVehicle(510,851.1944,-2046.5259,12.4747,42.9260,46,46,600); // mtb3
    g_RentBikeVehicle[3] = CreateVehicle(510,851.6276,-2040.2594,12.4760,57.2991,46,46,600); // mtb4
    g_RentBikeVehicle[4] = CreateVehicle(510,821.3160,-2039.9390,12.4725,287.5561,46,46,600); // mtb5
    g_RentBikeVehicle[5] = CreateVehicle(510,821.5632,-2044.7482,12.4743,314.1075,46,46,600); // mtb6
    g_RentBikeVehicle[6] = CreateVehicle(510,821.2587,-2047.7460,12.4740,310.0911,46,46,600); // mtb7
    g_RentBikeVehicle[7] = CreateVehicle(510,821.1445,-2052.4043,12.4736,309.7540,46,46,600); // mtb8
    g_RentBikeVehicle[8]  = CreateVehicle(462,840.2075,-2038.7783,12.4671, 21.2853,0,0,600); // fag 1
    g_RentBikeVehicle[9]  = CreateVehicle(462,836.9611,-2037.8810,12.4671,  2.6849,0,0,600); // fag 2
    g_RentBikeVehicle[10] = CreateVehicle(462,833.9294,-2037.9415,12.4666,  1.9801,0,0,600); // fag 3
    g_RentBikeVehicle[11] = CreateVehicle(462,830.6008,-2039.3945,12.4668,326.9115,0,0,600); // fag 4
    g_RentBikeVehicle[12] = CreateVehicle(462,823.9019,-2066.2729,12.4669,357.0751,0,0,600); // fag 5
    g_RentBikeVehicle[13] = CreateVehicle(462,827.2887,-2066.3062,12.4677,  1.0999,0,0,600); // fag 6

    new rbPlate[18];
    for(new i = 0; i < MAX_RENT_BIKES; i++)
    {
        if(g_RentBikeVehicle[i] == -1) continue;
        format(rbPlate, sizeof(rbPlate), "Rent B %d", i + 1);
        SetVehicleNumberPlate(g_RentBikeVehicle[i], rbPlate);
        SetVehicleToRespawn(g_RentBikeVehicle[i]);
    }

    // Masini de inchiriat LS
    g_RentCarVehicle[0]  = CreateVehicle(562,1099.6075,-1757.9934,13.0087,89.0613,6,6,600);  // 562
    g_RentCarVehicle[1]  = CreateVehicle(561,1098.9120,-1766.6272,13.1621,90.3318,6,6,600);  // 561
    g_RentCarVehicle[2]  = CreateVehicle(565,1099.6223,-1775.7684,12.9673,89.9628,6,6,600);  // 565
    g_RentCarVehicle[3]  = CreateVehicle(603,1083.7201,-1772.6057,13.1893,269.6560,6,6,600); // 603
    g_RentCarVehicle[4]  = CreateVehicle(579,1077.6416,-1766.8062,13.2942,90.3040,6,6,600);  // 579
    g_RentCarVehicle[5]  = CreateVehicle(489,1077.3267,-1760.8992,13.5229,90.9905,6,6,600);  // 489
    g_RentCarVehicle[6]  = CreateVehicle(567,1083.9471,-1754.8574,13.2592,270.2663,6,6,600); // 567
    g_RentCarVehicle[7]  = CreateVehicle(477,1061.5952,-1769.9111,13.1252,269.2493,6,6,600); // zr
