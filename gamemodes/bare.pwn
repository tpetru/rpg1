// Vehiculele guvernamentale sunt randuri normale in `vehicles_faction` cu `faction_id`=0.
// La prima rulare (tabela fara niciun rand cu faction_id=0) le inseram; apoi pornim incarcarea obisnuita.
stock GovVehicles_Seed()
{
    mysql_tquery(g_SQL, "SELECT COUNT(*) AS c FROM `vehicles_faction` WHERE `faction_id`=0", "OnGovVehiclesChecked");
}

forward OnGovVehiclesChecked();
public OnGovVehiclesChecked()
{
    new govCount = 0;
    if(cache_num_rows() > 0) cache_get_value_name_int(0, "c", govCount);

    if(govCount == 0)
    {
        mysql_tquery(g_SQL,
            "INSERT INTO `vehicles_faction` (`faction_id`,`model_id`,`loc_x`,`loc_y`,`loc_z`,`rotation`,`color1`,`color2`) VALUES              (0,409,1247.2897,-2042.7728,59.5889,269.6268,1,1),             (0,490,1246.3528,-2030.5232,59.9451,268.6790,0,0),             (0,490,1245.9860,-2024.4250,59.9542,270.3502,0,0),             (0,457,1167.0834,-2042.4241,68.6346,216.3638,63,1),             (0,457,1166.3553,-2032.3750,68.6346,324.5515,63,1),             (0,487,1153.1517,-2019.5197,69.1824,270.0602,3,29),             (0,477,1245.7184,-2018.6307,59.5881,270.7952,75,1),             (0,477,1245.7601,-2012.6831,59.5868,269.9525,75,1)",
            "", "", 0);
        print("[Load] Vehicule guvernamentale: inserate cele 8 randuri initiale (faction_id=0).");
