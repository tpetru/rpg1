// Numele citibil al unui tip de quest (EVENT_TYPE_*)
stock Event_TypeName(type, dest[], len)
{
    switch(type)
    {
        case EVENT_TYPE_COLLECT:    format(dest, len, "collect");
        case EVENT_TYPE_CHECKPOINT: format(dest, len, "checkpoint");
        case EVENT_TYPE_COSTUME:    format(dest, len, "costume");
        case EVENT_TYPE_SURVIVAL:   format(dest, len, "survival");
        case EVENT_TYPE_VISIT:      format(dest, len, "visit");
        default:                    format(dest, len, "type%d", type);
    }
}

// Dialogul de ajutor pentru /holiday: toate subcomenzile, cu parametrii lor.
// Tinut intr-un dialog (nu in chat) ca sa incapa toate fara sa fie taiate de limita de 144 caractere.
stock Event_ShowHelp(playerid)
{
    static body[4096]; // ~2500 caractere acum; marja ca strcat sa nu taie daca se mai adauga linii
    new line[200], stName[16];

    Event_StateName(g_EventState, stName, sizeof(stName));

    format(body, sizeof(body), "{FFFFFF}Holiday: {FFD700}%s{FFFFFF}   State: {FFD700}%s\n\n", g_EventName, stName);

    strcat(body, "{FFD700}STATE (whole holiday)\n");
    strcat(body, "{FFFFFF}/holiday start{969696} - objects + progress + visible in /quest\n");
    strcat(body, "{FFFFFF}/holiday pause{969696} - no objects, but progress and /quest stay\n");
    strcat(body, "{FFFFFF}/holiday stop{969696} - no objects, no new progress, still in /quest\n");
    strcat(body, "{FFFFFF}/holiday hide{969696} - everything off, nothing shown\n");
    strcat(body,T(playerid, "{969696}   each quest has the same 4 states of its own (see QUESTS);\n"));
    strcat(body,T(playerid, "{969696}   the holiday is the ceiling - the lower of the two wins\n\n"));

    strcat(body, "{FFD700}HOLIDAY\n");
    strcat(body, "{FFFFFF}/holiday{969696} - this help + current state\n");
    strcat(body,T(playerid, "{FFFFFF}/holiday name [new name]{969696} - rename the holiday\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday reset{969696} - wipe ALL players' quest progress\n\n"));

    strcat(body,T(playerid, "{FFD700}QUESTS\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday quest{969696} - list quests (keys, type, target, reward, state)\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday quest add [key] [type] [target] [reward] [name]\n"));
    strcat(body,T(playerid, "{969696}   type: collect / checkpoint / costume / survival / visit\n"));
    strcat(body,T(playerid, "{969696}   same key again = updates that quest\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday quest name [key] [new name]{969696} - display name\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday quest desc [key] [description]\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday quest del [key]{969696} - deletes the definition only\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday quest start|pause|stop|hide [key]{969696} - turn ONE quest\n"));
    strcat(body,T(playerid, "{969696}   on or off without touching the rest of the holiday\n"));
    strcat(body,T(playerid, "{969696}   start: objects + progress | pause: no objects, progress kept\n"));
    strcat(body,T(playerid, "{969696}   stop: frozen but still listed | hide: gone from /quest\n\n"));

    strcat(body,T(playerid, "{FFD700}OBJECTS (collect points)\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday obj add [quest_key] [model]{969696} - saves your position\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday obj list [quest_key]{969696} - quest_key optional\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday obj model [id] [new model]\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday obj del [id]\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday obj goto [id]{969696} - teleport to check placement\n\n"));

    strcat(body,T(playerid, "{FFD700}CHARACTERS (static actors, ENTER to interact)\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday npc add [quest_key] [skin] [behaviour]\n"));
    strcat(body,T(playerid, "{969696}   behaviour is optional: mixed / idle / peaceful / aggressive / random (0-3)\n"));
    strcat(body,T(playerid, "{969696}   mixed (default): the type is picked per player, so the same character\n"));
    strcat(body,T(playerid, "{969696}   is aggressive for one player and peaceful for another\n"));
    strcat(body,T(playerid, "{969696}   idle: tells a fact about a real Romanian or European holiday\n"));
    strcat(body,T(playerid, "{969696}   (from the event_facts table) | aggressive: shoots you\n"));
    strcat(body,T(playerid, "{969696}   random: 10 HP / sick / tired+drunk\n"));
    strcat(body,T(playerid, "{969696}   peaceful: asks for a condition first (shovel, flowers, prayed today,\n"));
    strcat(body,T(playerid, "{969696}   job range, spawn at home, working watch+phone, minute 50-59)\n"));
    strcat(body,T(playerid, "{969696}   the condition differs per player and stays the same for that pair\n"));
    strcat(body,T(playerid, "{969696}   item conditions (shovel, flowers) CONSUME the item on success\n"));
    strcat(body,T(playerid, "{969696}   +1 progress once per character; peaceful only if the condition is met\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday npc list{969696} - saved characters with their ids\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday npc del [id]\n"));
    strcat(body,T(playerid, "{FFFFFF}/holiday npc goto [id]{969696} - teleport to check placement\n"));

    format(line, sizeof(line), "\n{969696}Players see the quests in {FFFFFF}/quest{969696}, only while visible.");
    strcat(body, line);

    SPD(playerid, DIALOG_HOLIDAY_HELP, DIALOG_STYLE_MSGBOX, "Holiday - admin commands", body, "Close", "");
}

// Lista quest-urilor definite - de aici se iau `quest_key`-urile folosite la /holiday obj add.
// Citeste direct din DB, deci le arata si cand evenimentul e oprit (in memorie stau doar cele
// incarcate la pornire, si doar cele cu enabled=1).
stock Event_QuestList(playerid)
{
    // `points` = obiecte + personaje, adica de cate ori se poate lua progres la quest-ul asta.
    // Fiecare se ia o singura data per jucator, deci daca target > points nimeni nu poate termina.
    mysql_tquery(g_SQL,
        "SELECT q.`quest_key`, q.`type`, q.`name`, q.`target`, q.`reward_money`, q.`state`, \
         (SELECT COUNT(*) FROM `event_objects` o WHERE o.`quest_key` = q.`quest_key`) + \
         (SELECT COUNT(*) FROM `event_npcs`    n WHERE n.`quest_key` = q.`quest_key`) AS `points` \
         FROM `event_quests` q ORDER BY q.`sort_order` ASC, q.`id` ASC LIMIT 20",
        "OnEventQuestListLoaded", "i", playerid);
}

// Starea dintr-un argument ("start"/"pause"/"stop"/"hide"), sau -1 daca nu se potriveste.
// Aceleasi cuvinte ca la /holiday start|pause|stop|hide, ca sa nu fie doua vocabulare de tinut minte.
stock Event_StateFromArg(const arg[])
{
    if(strcmp(arg, "start", true) == 0) return EVENT_STATE_START;
    if(strcmp(arg, "pause", true) == 0) return EVENT_STATE_PAUSE;
    if(strcmp(arg, "stop",  true) == 0) return EVENT_STATE_STOP;
    if(strcmp(arg, "hide",  true) == 0) return EVENT_STATE_HIDE;
    return -1;
}

// Tipul de quest dintr-un argument: accepta si numarul (1-5) si numele ("collect", "visit"...).
// Returneaza -1 daca nu se potriveste nimic.
stock Event_TypeFromArg(const arg[])
{
    if(strcmp(arg, "collect",    true) == 0) return EVENT_TYPE_COLLECT;
    if(strcmp(arg, "checkpoint", true) == 0) return EVENT_TYPE_CHECKPOINT;
    if(strcmp(arg, "costume",    true) == 0) return EVENT_TYPE_COSTUME;
    if(strcmp(arg, "survival",   true) == 0) return EVENT_TYPE_SURVIVAL;
    if(strcmp(arg, "visit",      true) == 0) return EVENT_TYPE_VISIT;

    new n = strval(arg);
    if(n >= EVENT_TYPE_COLLECT && n <= EVENT_TYPE_VISIT) return n;
    return -1;
}

// Creeaza sau actualizeaza un quest. Upsert pe `quest_key` (cheia are UNIQUE), deci acelasi
// apel merge si la creare si la corectarea unui quest existent - fara query de verificare.
// Descrierea se pune separat (/holiday quest desc), ca sa incapa toate pe o linie de comanda.
stock Event_QuestAdd(playerid, const questKey[], type, target, reward, const name[])
{
    new q[420];
    mysql_format(g_SQL, q, sizeof(q),
        "INSERT INTO `event_quests` (`quest_key`,`type`,`name`,`target`,`reward_money`,`enabled`,`sort_order`) \
         VALUES ('%e',%d,'%e',%d,%d,1,0) \
         ON DUPLICATE KEY UPDATE `type`=%d, `name`='%e', `target`=%d, `reward_money`=%d",
        questKey, type, name, target, reward,
        type, name, target, reward);
    mysql_tquery(g_SQL, q, "", "", 0);

    new tname[12];
    Event_TypeName(type, tname, sizeof(tname));

    new msg[192];
    format(msg, sizeof(msg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Quest "C_INFO"%s"C_WHITE" saved: %s, target "C_INFO"%d"C_WHITE", reward "C_INFO"$%d"C_WHITE"."),
        questKey, tname, target, reward);
    SCM(playerid, COLOR_SUCCESS, msg);

    Event_ReloadIfActive();
}

// Cheia + textul in curs de aplicat, intre SELECT-ul de validare si UPDATE/DELETE.
// Se tin pe jucator (nu ca parametri de callback) ca sa nu depindem de parametri string in tquery.
new g_EventQPendKey[MAX_PLAYERS][EVENT_KEY_LEN];
new g_EventQPendText[MAX_PLAYERS][128];
new g_EventQPendState[MAX_PLAYERS];

// Verifica ca quest_key exista, apoi ruleaza callback-ul dat
stock Event_QuestCheck(playerid, const questKey[], const callback[])
{
    format(g_EventQPendKey[playerid], EVENT_KEY_LEN, "%s", questKey);

    new q[200];
    mysql_format(g_SQL, q, sizeof(q),
        "SELECT `id` FROM `event_quests` WHERE `quest_key`='%e' LIMIT 1", questKey);
    mysql_tquery(g_SQL, q, callback, "i", playerid);
}

// Redenumeste un quest (numele afisat in /quest). `quest_key` ramane neschimbat, ca sa nu se
// rupa legatura cu obiectele/progresul deja salvate pe cheia aia.
forward OnEventQuestRenameChecked(playerid);
public OnEventQuestRenameChecked(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    if(cache_num_rows() == 0)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"No quest with that key. See "C_INFO"/holiday quest"C_WHITE"."), 1;

    new q[240];
    mysql_format(g_SQL, q, sizeof(q),
        "UPDATE `event_quests` SET `name`='%e' WHERE `quest_key`='%e'", g_EventQPendText[playerid], g_EventQPendKey[playerid]);
    mysql_tquery(g_SQL, q, "", "", 0);

    new msg[192];
    format(msg, sizeof(msg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Quest "C_INFO"%s"C_WHITE" renamed to "C_INFO"%s"C_WHITE"."),
        g_EventQPendKey[playerid], g_EventQPendText[playerid]);
    SCM(playerid, COLOR_SUCCESS, msg);

    Event_ReloadIfActive();
    return 1;
}

// Descrierea afisata sub numele quest-ului
forward OnEventQuestDescChecked(playerid);
public OnEventQuestDescChecked(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    if(cache_num_rows() == 0)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"No quest with that key. See "C_INFO"/holiday quest"C_WHITE"."), 1;

    new q[320];
    mysql_format(g_SQL, q, sizeof(q),
        "UPDATE `event_quests` SET `description`='%e' WHERE `quest_key`='%e'", g_EventQPendText[playerid], g_EventQPendKey[playerid]);
    mysql_tquery(g_SQL, q, "", "", 0);

    new msg[176];
    format(msg, sizeof(msg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Description updated for quest "C_INFO"%s"C_WHITE"."), g_EventQPendKey[playerid]);
    SCM(playerid, COLOR_SUCCESS, msg);

    Event_ReloadIfActive();
    return 1;
}

// Starea unui singur quest (/holiday quest start|pause|stop|hide [cheie]). Aceeasi scala ca la
// sarbatoare, dar aplicata doar quest-ului asta; sarbatoarea ramane plafonul (vezi Event_QuestState).
forward OnEventQuestStateChecked(playerid);
public OnEventQuestStateChecked(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    if(cache_num_rows() == 0)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"No quest with that key. See "C_INFO"/holiday quest"C_WHITE"."), 1;

    new q[200];
    mysql_format(g_SQL, q, sizeof(q),
        "UPDATE `event_quests` SET `state`=%d WHERE `quest_key`='%e'", g_EventQPendState[playerid], g_EventQPendKey[playerid]);
    mysql_tquery(g_SQL, q, "", "", 0);

    new stName[16];
    Event_StateName(g_EventQPendState[playerid], stName, sizeof(stName));

    new msg[192];
    format(msg, sizeof(msg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Quest "C_INFO"%s"C_WHITE" is now "C_INFO"%s"C_WHITE"."),
        g_EventQPendKey[playerid], stName);
    SCM(playerid, COLOR_SUCCESS, msg);

    // Daca sarbatoarea e mai jos pe scala, ea decide - spune-i adminului, sa nu creada ca n-a mers.
    if(g_EventState < g_EventQPendState[playerid])
    {
        new evHolName[16];
        Event_StateName(g_EventState, evHolName, sizeof(evHolName));

        new warn[208];
        format(warn, sizeof(warn), T(playerid, C_INFO"Info: "C_WHITE"The holiday itself is "C_INFO"%s"C_WHITE", so the quest stays "C_INFO"%s"C_WHITE" until you "C_INFO"/holiday start"C_WHITE"."),
            evHolName, evHolName);
        SCM(playerid, COLOR_INFO, warn);
    }

    Event_ReloadIfActive();
    return 1;
}

// Sterge definitia quest-ului. Obiectele si progresul salvate pe cheia lui RAMAN in DB -
// se sterg separat (/holiday obj del, /holiday reset), ca sa nu pierzi date dintr-o greseala de tastare.
forward OnEventQuestDelChecked(playerid);
public OnEventQuestDelChecked(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    if(cache_num_rows() == 0)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"No quest with that key. See "C_INFO"/holiday quest"C_WHITE"."), 1;

    new q[160];
    mysql_format(g_SQL, q, sizeof(q), "DELETE FROM `event_quests` WHERE `quest_key`='%e'", g_EventQPendKey[playerid]);
    mysql_tquery(g_SQL, q, "", "", 0);

    new msg[208];
    format(msg, sizeof(msg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Quest "C_INFO"%s"C_WHITE" deleted. Its objects and progress are still in the DB."), g_EventQPendKey[playerid]);
    SCM(playerid, COLOR_SUCCESS, msg);

    Event_ReloadIfActive();
    return 1;
}

forward OnEventQuestListLoaded(playerid);
public OnEventQuestListLoaded(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    new rows = cache_num_rows();
    if(!rows)
        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"No quests defined for this event yet."), 1;

    SCM(playerid, COLOR_INFO, C_INFO"===== Event quests (key - name - type - target/points - reward - state) =====");
    for(new r = 0; r < rows; r++)
    {
        new qkey[EVENT_KEY_LEN], qname[48], qtype, qtarget, qreward, qstate, qpoints;
        cache_get_value_name(r, "quest_key", qkey, EVENT_KEY_LEN);
        cache_get_value_name(r, "name", qname, 48);
        cache_get_value_name_int(r, "type", qtype);
        cache_get_value_name_int(r, "target", qtarget);
        cache_get_value_name_int(r, "reward_money", qreward);
        cache_get_value_name_int(r, "state", qstate);
        cache_get_value_name_int(r, "points", qpoints);

        new tname[12];
        Event_TypeName(qtype, tname, sizeof(tname));

        new sname[16];
        Event_StateName(qstate, sname, sizeof(sname));

        // punctele nu mai reapar, deci target > puncte = quest imposibil de terminat
        new qflags[8];
        qflags[0] = EOS;
        if(qtype == EVENT_TYPE_COLLECT && qpoints < qtarget) strcat(qflags, " [!]");

        // linie compacta: SendClientMessage taie la 144 de caractere
        new qline[144];
        format(qline, sizeof(qline),T(playerid, "%.18s - %.20s - %s - %d/%d pts - $%d - %s%s"),
            qkey, qname, tname, qtarget, qpoints, qreward, sname, qflags);
        SCM(playerid, COLOR_WHITE, qline);

        if(qtype == EVENT_TYPE_COLLECT && qpoints < qtarget)
        {
            new qwarn[176];
            format(qwarn, sizeof(qwarn), T(playerid, C_ERROR"   [!] "C_WHITE"Only %d points for a target of %d - nobody can finish it. Add more with "C_INFO"/holiday obj add %.18s [model]"C_WHITE"."),
                qpoints, qtarget, qkey);
            SCM(playerid, COLOR_ERROR, qwarn);
        }
    }
    return 1;
}

// Lista obiectelor evenimentului editat (id-urile de aici se folosesc la model/del/goto)
stock Event_ObjList(playerid, const questKey[])
{
    new q[320];
    if(strlen(questKey))
        mysql_format(g_SQL, q, sizeof(q),
            "SELECT `id`,`quest_key`,`model`,`x`,`y`,`z` FROM `event_objects` WHERE `quest_key`='%e' ORDER BY `id` ASC LIMIT 40",
            questKey);
    else
        mysql_format(g_SQL, q, sizeof(q),
            "SELECT `id`,`quest_key`,`model`,`x`,`y`,`z` FROM `event_objects` ORDER BY `id` ASC LIMIT 40");
    mysql_tquery(g_SQL, q, "OnEventObjListLoaded", "i", playerid);
}

forward OnEventObjListLoaded(playerid);
public OnEventObjListLoaded(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    new rows = cache_num_rows();
    if(!rows)
        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"No event objects saved yet."), 1;

    SCM(playerid, COLOR_INFO, C_INFO"===== Event objects (max 40) =====");
    for(new r = 0; r < rows; r++)
    {
        new oid, omodel, qkey[EVENT_KEY_LEN];
        new Float:ox, Float:oy, Float:oz;
        cache_get_value_name_int(r, "id", oid);
        cache_get_value_name(r, "quest_key", qkey, EVENT_KEY_LEN);
        cache_get_value_name_int(r, "model", omodel);
        cache_get_value_name_float(r, "x", ox);
        cache_get_value_name_float(r, "y", oy);
        cache_get_value_name_float(r, "z", oz);

        new oline[144];
        format(oline, sizeof(oline),T(playerid, "#%d - %s - model %d - %.1f, %.1f, %.1f"), oid, qkey, omodel, ox, oy, oz);
        SCM(playerid, COLOR_WHITE, oline);
    }
    return 1;
}

// Teleport la un obiect salvat, ca sa se poata verifica/corecta plasarea
forward OnEventObjGotoLoaded(playerid);
public OnEventObjGotoLoaded(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    if(cache_num_rows() == 0)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"No event object with that id in this event."), 1;

    new Float:ox, Float:oy, Float:oz, oint, ovw;
    cache_get_value_name_float(0, "x", ox);
    cache_get_value_name_float(0, "y", oy);
    cache_get_value_name_float(0, "z", oz);
    cache_get_value_name_int(0, "interior", oint);
    cache_get_value_name_int(0, "world", ovw);

    // AC_SetPos, nu SetPlayerPos: anticheat-ul verifica saltul de pozitie (AC_TP_THRESHOLD_2D) si,
    // fara g_ACExpectTP, ar marca teleportul ca "teleport" si te-ar trage inapoi.
    // Daca esti in vehicul se muta vehiculul (acelasi tipar ca la teleportul spre paduri/ferme).
    if(GetPlayerVehicleID(playerid) != 0)
        SetVehiclePos(GetPlayerVehicleID(playerid), ox, oy, oz + 1.0);
    else
        AC_SetPos(playerid, ox, oy, oz + 1.0);

    SetPlayerInterior(playerid, oint);
    SetPlayerVirtualWorld(playerid, ovw);
    SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Teleported to the event object.");
    return 1;
}

// Progres pe un quest al evenimentului activ. Fire-and-forget, ca Quest_AddProgress.
stock Event_AddProgress(playerid, const questKey[], amount)
{
    if(!IsPlayerConnected(playerid) || !PlayerData[playerid][pLogged]) return;

    new qi = Event_FindQuest(questKey);
    if(qi == -1) return;
    if(!Event_QuestProgressOn(qi)) return; // la stop/hide (al sarbatorii SAU al quest-ului) progresul e inghetat

    new q[300];
    mysql_format(g_SQL, q, sizeof(q),
        "INSERT INTO `event_progress` (`pID`,`quest_key`,`progress`,`updated_at`) VALUES (%d,'%e',%d,NOW()) \
         ON DUPLICATE KEY UPDATE `progress` = LEAST(`progress` + %d, %d), `updated_at` = NOW()",
        PlayerData[playerid][pID], questKey, amount, amount, EventQuest[qi][eqTarget]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// La fiecare secunda, pentru fiecare jucator in parte: spawnul punctelor pe care nu le-a ridicat
// inca (asa apar si la cei care tocmai s-au logat) si colectarea celor din raza.
forward Event_Tick();
public Event_Tick()
{
    if(!Event_ObjectsOn()) return 1; // fara obiecte pe harta n-avem ce colecta

    for(new p = 0; p < MAX_PLAYERS; p++)
    {
        if(!IsPlayerConnected(p) || !PlayerData[p][pLogged]) continue;

        // prima data dupa logare: aducem din DB cu ce personaje a vorbit deja...
        if(g_EventNpcCount > 0 && g_EventTalkState[p] == EVENT_PICKUPS_NONE) Event_LoadNpcTalks(p);

        // ...si ce puncte a ridicat deja, ca sa nu reapara instant
        if(g_EventPickupState[p] == EVENT_PICKUPS_NONE) { Event_LoadPickups(p); continue; }
        if(g_EventPickupState[p] != EVENT_PICKUPS_READY) continue; // query in curs

        Event_SpawnObjectsFor(p); // creeaza doar ce nu a ridicat inca

        for(new i = 0; i < g_EventObjectCount; i++)
        {
            if(!IsValidDynamicObject(g_EventPObj[p][i])) continue;
            if(EventObject[i][eoQuest][0] == EOS) continue;
            if(GetPlayerInterior(p) != EventObject[i][eoInterior]) continue;
            if(!IsPlayerInRangeOfPoint(p, EVENT_COLLECT_RANGE, EventObject[i][eoX], EventObject[i][eoY], EventObject[i][eoZ])) continue;

            new qi = Event_FindQuest(EventObject[i][eoQuest]);
            if(qi == -1) continue;
            if(!Event_QuestObjectsOn(qi)) continue; // quest-ul lui a fost oprit intre timp
            if(EventQuest[qi][eqType] != EVENT_TYPE_COLLECT && EventQuest[qi][eqType] != EVENT_TYPE_VISIT) continue;

            DestroyDynamicObject(g_EventPObj[p][i]);
            g_EventPObj[p][i]  = STREAMER_TAG_OBJECT:-1;
            g_EventPTaken[p][i] = 1; // definitiv: nu mai reapare pentru el

            // se retine si in DB, ca sa ramana luat si dupa reconectare/restart
            new pq[220];
            mysql_format(g_SQL, pq, sizeof(pq),
                "INSERT INTO `event_pickups` (`pID`,`object_id`,`taken_at`) VALUES (%d,%d,NOW()) \
                 ON DUPLICATE KEY UPDATE `taken_at`=NOW()",
                PlayerData[p][pID], EventObject[i][eoID]);
            mysql_tquery(g_SQL, pq, "", "", 0);

            Event_AddProgress(p, EventObject[i][eoQuest], 1);

            // daca evenimentul nu e vizibil, progresul se aduna in tacere (fara mesaj care sa-l tradeze)
            if(Event_VisibleOn())
            {
                new cmsg[160];
                format(cmsg, sizeof(cmsg), T(p, C_SUCCESS"[Event] "C_WHITE"You picked up "C_INFO"%s"C_WHITE". Check "C_INFO"/quest"C_WHITE" for your progress."),
                    EventQuest[qi][eqName]);
                SCM(p, COLOR_SUCCESS, cmsg);
            }
            break; // un singur obiect per tick per jucator
        }
    }
    return 1;
}

// ------------------------------------------------------------
//  INTERACTIUNEA CU PERSONAJELE STATICE (ENTER langa ele)
// ------------------------------------------------------------
//  Interactiunea in sine e quest-ul (ex: "Interactioneaza cu 10 zombi"): ORICE personaj al
//  quest-ului da +1 progres, dar o singura data per personaj - retinut in `event_npc_talks`,
//  ca sa fie nevoie sa gasesti personaje diferite, nu sa vorbesti de 10 ori cu acelasi.
//  `behaviour` decide ce se mai intampla pe langa progres, si se aplica de fiecare data.
// ------------------------------------------------------------
// ---- Conditiile personajelor pasnice ----
// Fiecare personaj pasnic cere ceva de la jucator, si cere altceva de la fiecare jucator in parte.
// Conditia se DERIVA din (pID, id-ul personajului), nu se salveaza: asa e mereu aceeasi pentru
// aceeasi pereche jucator-personaj, dar difera de la un jucator la altul.
#define EVENT_COND_COUNT        9
#define EVENT_COND_SHOVEL       0
#define EVENT_COND_FLOWERS      1
#define EVENT_COND_PRAYED       2
#define EVENT_COND_JOB_1_4      3
#define EVENT_COND_JOB_5_8      4
#define EVENT_COND_JOB_9_12     5
#define EVENT_COND_SPAWN_HOME   6
#define EVENT_COND_WATCH_PHONE  7
#define EVENT_COND_MINUTE_50    8

stock Event_NpcConditionFor(playerid, npcIdx)
{
    // numere prime ca sa se imprastie bine intre jucatori si personaje
    new h = PlayerData[playerid][pID] * 31 + EventNpc[npcIdx][enID] * 17;
    if(h < 0) h = -h;
    return h % EVENT_COND_COUNT;
}

// ---- Curiozitatile personajelor inactive ----
// Se incarca o singura data la pornirea gamemode-ului: sunt date de referinta, nu tin de starea
// evenimentului, deci nu se golesc in Event_DestroyWorld si nu se recitesc la fiecare /holiday start.
stock Event_LoadFacts()
{
    new q[160];
    format(q, sizeof(q),
        "SELECT `holiday`,`country`,`fact_en`,`fact_ro` FROM `event_facts` WHERE `enabled`=1 ORDER BY `id` ASC LIMIT %d",
        EVENT_MAX_FACTS);
    mysql_tquery(g_SQL, q, "OnEventFactsLoaded");
}

forward OnEventFactsLoaded();
public OnEventFactsLoaded()
{
    new rows = cache_num_rows();
    g_EventFactCount = 0;
    for(new i = 0; i < rows && g_EventFactCount < EVENT_MAX_FACTS; i++)
    {
        new idx = g_EventFactCount;
        cache_get_value_name(i, "holiday", EventFact[idx][efHoliday], 48);
        cache_get_value_name(i, "country", EventFact[idx][efCountry], 32);
        cache_get_value_name(i, "fact_en", EventFact[idx][efEn], EVENT_FACT_LEN);
        cache_get_value_name(i, "fact_ro", EventFact[idx][efRo], EVENT_FACT_LEN);
        if(EventFact[idx][efEn][0] == EOS) continue; // rand gol in DB, nu are ce spune
        g_EventFactCount++;
    }
    printf("[EVENT] %d curiozitati despre sarbatori incarcate.", g_EventFactCount);
    return 1;
}

// Ce sarbatoare ii povesteste personajul asta jucatorului asta. Stabil per pereche, ca si conditia
// si tipul: fiecare personaj inactiv are "sarbatoarea lui" pentru tine, deci ca sa le auzi pe toate
// trebuie sa umbli dupa personaje diferite, nu sa vorbesti de 30 de ori cu acelasi.
stock Event_NpcFactFor(playerid, npcIdx)
{
    if(g_EventFactCount <= 0) return -1;

    new h = PlayerData[playerid][pID] * 23 + EventNpc[npcIdx][enID] * 11;
    if(h < 0) h = -h;
    return h % g_EventFactCount;
}

// Personajul inactiv nu face nimic - doar iti spune ceva despre o sarbatoare reala.
stock Event_NpcTellFact(playerid, npcIdx)
{
    new fi = Event_NpcFactFor(playerid, npcIdx);
    if(fi == -1)
    {
        // fara nimic in `event_facts` ramane comportamentul vechi
        SCM(playerid, COLOR_INFO, C_INFO"[Event] "C_WHITE"It just stands there, staring through you.");
        return;
    }

    new hmsg[176];
    format(hmsg, sizeof(hmsg), T(playerid, C_INFO"[Event] "C_WHITE"It mutters something about "C_INFO"%s"C_WHITE" (%s)..."),
        EventFact[fi][efHoliday], EventFact[fi][efCountry]);
    SCM(playerid, COLOR_INFO, hmsg);

    // Textul e deja tradus in DB, pe coloane - nu trece prin T(), care lucreaza doar cu literali.
    new fact[EVENT_FACT_LEN];
    if(strcmp(PlayerData[playerid][pLanguage], "ro", true) == 0 && EventFact[fi][efRo][0] != EOS)
        format(fact, sizeof(fact), "%s", EventFact[fi][efRo]);
    else
        format(fact, sizeof(fact), "%s", EventFact[fi][efEn]);

    new out[EVENT_FACT_LEN + 24], len = strlen(fact);
    if(len <= EVENT_FACT_LINE)
    {
        format(out, sizeof(out), "{FFFFFF}\"%s\"", fact);
        SCM(playerid, COLOR_WHITE, out);
        return;
    }

    // Prea lung pentru o linie de chat (SendClientMessage taie la 144 de caractere, iar codul de
    // culoare intra si el la socoteala): il rupem in doua la ultimul spatiu dinaintea limitei,
    // ca sa nu fie nevoie ca fiecare rand din `event_facts` sa fie numarat de mana.
    new cut = EVENT_FACT_LINE;
    while(cut > 0 && fact[cut] != ' ') cut--;
    if(cut <= 0) cut = EVENT_FACT_LINE; // un singur cuvant urias: taiem unde apucam

    new head[EVENT_FACT_LEN], tail[EVENT_FACT_LEN];
    strmid(head, fact, 0, cut, EVENT_FACT_LEN);
    strmid(tail, fact, cut + 1, len, EVENT_FACT_LEN);

    format(out, sizeof(out), "{FFFFFF}\"%s", head);
    SCM(playerid, COLOR_WHITE, out);
    format(out, sizeof(out), "{FFFFFF}%s\"", tail);
    SCM(playerid, COLOR_WHITE, out);
}

// Tipul personajului, PER JUCATOR: acelasi zombi e agresiv pentru unul si pasnic pentru altul.
// Se deriva la fel ca si conditia (deci e stabil intre sesiuni, fara sa fie salvat nicaieri),
// dar cu alte numere prime, ca tipul si conditia sa nu fie corelate.
// `behaviour` din DB ramane ca optiune de fortare: 0-3 = fix pentru toata lumea, -1 = random per jucator.
stock Event_NpcBehaviourFor(playerid, npcIdx)
{
    if(EventNpc[npcIdx][enBehaviour] >= EVENT_NPC_IDLE && EventNpc[npcIdx][enBehaviour] <= EVENT_NPC_RANDOM)
        return EventNpc[npcIdx][enBehaviour];

    new h = PlayerData[playerid][pID] * 13 + EventNpc[npcIdx][enID] * 7;
    if(h < 0) h = -h;
    return h % 4; // EVENT_NPC_IDLE .. EVENT_NPC_RANDOM
}

// Are arma in oricare din sloturi (nu doar in mana)
stock Event_PlayerHasWeapon(playerid, weaponid)
{
    for(new s = 0; s < 13; s++)
    {
        new w, a;
        GetPlayerWeaponData(playerid, s, w, a);
        if(w == weaponid && a > 0) return 1;
    }
    return 0;
}

// Ceasul/telefonul exista si nu sunt stricate (aceeasi logica cu Watch_/Phone_IsBroken, scrisa aici
// ca sa nu apelam functii cu tag inainte de definitia lor)
stock Event_WatchOk(playerid)
{
    if(PlayerData[playerid][pWatchModel] < 0) return 0;
    if(PlayerData[playerid][pWatchExpire] > 0 && gettime() >= PlayerData[playerid][pWatchExpire]) return 0;
    return 1;
}
stock Event_PhoneOk(playerid)
{
    if(PlayerData[playerid][pPhoneModel] < 0) return 0;
    if(PlayerData[playerid][pPhoneExpire] > 0 && gettime() >= PlayerData[playerid][pPhoneExpire]) return 0;
    return 1;
}

stock Event_NpcCondMet(playerid, cond)
{
    switch(cond)
    {
        case EVENT_COND_SHOVEL:  return Event_PlayerHasWeapon(playerid, WEAPON_SHOVEL);
        case EVENT_COND_FLOWERS: return Event_PlayerHasWeapon(playerid, WEAPON_FLOWER);
        case EVENT_COND_PRAYED:  return (PlayerData[playerid][pLastPray] == gettime() - (gettime() % 86400)) ? 1 : 0;
        case EVENT_COND_JOB_1_4:  return (PlayerData[playerid][pJob] >= 1  && PlayerData[playerid][pJob] <= 4)  ? 1 : 0;
        case EVENT_COND_JOB_5_8:  return (PlayerData[playerid][pJob] >= 5  && PlayerData[playerid][pJob] <= 8)  ? 1 : 0;
        case EVENT_COND_JOB_9_12: return (PlayerData[playerid][pJob] >= 9  && PlayerData[playerid][pJob] <= 12) ? 1 : 0;
        // 3 = casa personala, RENT_SPAWN_TYPE = proprietate inchiriata (apartament / camera de hotel)
        case EVENT_COND_SPAWN_HOME: return (PlayerData[playerid][pSpawn] == 3 || PlayerData[playerid][pSpawn] == RENT_SPAWN_TYPE) ? 1 : 0;
        case EVENT_COND_WATCH_PHONE: return (Event_WatchOk(playerid) && Event_PhoneOk(playerid)) ? 1 : 0;
        case EVENT_COND_MINUTE_50:
        {
            new h, m, s;
            gettime(h, m, s);
            return (m >= 50 && m <= 59) ? 1 : 0;
        }
    }
    return 0;
}

// Personajul chiar IA obiectul cerut, daca conditia lui era despre un obiect. Se apeleaza o singura
// data, dupa ce conditia a trecut si progresul a fost acordat - deci pentru urmatorul personaj care
// cere acelasi lucru trebuie sa cumperi altul.
// Conditiile care nu sunt obiecte (rugaciune, job, spawn, ceas+telefon, minutul) nu au ce consuma.
// Returneaza weaponid-ul luat, sau 0 daca nu s-a luat nimic.
stock Event_NpcCondConsume(playerid, cond)
{
    switch(cond)
    {
        case EVENT_COND_SHOVEL:  if(AC_TakeWeapon(playerid, WEAPON_SHOVEL)) return WEAPON_SHOVEL;
        case EVENT_COND_FLOWERS: if(AC_TakeWeapon(playerid, WEAPON_FLOWER)) return WEAPON_FLOWER;
    }
    return 0;
}

// Ce trebuie sa aiba/faca jucatorul, ca text
stock Event_NpcCondText(cond, dest[], len)
{
    switch(cond)
    {
        case EVENT_COND_SHOVEL:      format(dest, len, "be carrying a shovel");
        case EVENT_COND_FLOWERS:     format(dest, len, "be carrying flowers");
        case EVENT_COND_PRAYED:      format(dest, len, "have prayed today (/pray at a church)");
        case EVENT_COND_JOB_1_4:     format(dest, len, "have a job between 1 and 4 (see /jobs)");
        case EVENT_COND_JOB_5_8:     format(dest, len, "have a job between 5 and 8 (see /jobs)");
        case EVENT_COND_JOB_9_12:    format(dest, len, "have a job between 9 and 12 (see /jobs)");
        case EVENT_COND_SPAWN_HOME:  format(dest, len, "have your spawn set at your house or rented place (/changespawn)");
        case EVENT_COND_WATCH_PHONE: format(dest, len, "carry a working watch AND a working phone");
        case EVENT_COND_MINUTE_50:   format(dest, len, "come back in the last 10 minutes of an hour (minute 50-59)");
        default:                     format(dest, len, "do something unclear");
    }
}

stock Event_NpcTalkRemember(playerid, npcID)
{
    new q[200];
    mysql_format(g_SQL, q, sizeof(q),
        "INSERT INTO `event_npc_talks` (`pID`,`npc_id`,`taken_at`) VALUES (%d,%d,NOW()) \
         ON DUPLICATE KEY UPDATE `taken_at`=NOW()",
        PlayerData[playerid][pID], npcID);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Agresiv: actorii nu pot trage, asa ca "atacul" e scriptat - se intoarce spre tine, se aude
// impuscatura si ti se scade viata cu cat ar fi facut arma respectiva. Nu te omoara.
stock Event_NpcAggressive(playerid, npcIdx)
{
    new bool:shotgun = (random(2) == 0);
    new Float:dmg = shotgun ? (25.0 + float(random(16))) : (40.0 + float(random(21))); // shotgun 25-40, deagle 40-60

    new Float:hp;
    GetPlayerHealth(playerid, hp);
    new Float:left = hp - dmg;
    if(left < 1.0) left = 1.0;
    SetPlayerHealth(playerid, left);

    new Float:px, Float:py, Float:pz;
    GetPlayerPos(playerid, px, py, pz);
    if(IsValidDynamicActor(EventNpc[npcIdx][enActor]))
        SetDynamicActorFacingAngle(EventNpc[npcIdx][enActor],
            atan2(py - EventNpc[npcIdx][enY], px - EventNpc[npcIdx][enX]) - 90.0);

    PlayerPlaySound(playerid, shotgun ? 1130 : 1132, px, py, pz);

    new amsg[176];
    format(amsg, sizeof(amsg), T(playerid, C_ERROR"[Event] "C_WHITE"It pulled a "C_INFO"%s"C_WHITE" on you and fired! You lost "C_INFO"%.0f HP"C_WHITE"."),
        shotgun ? ("shotgun") : ("Desert Eagle"), dmg);
    SCM(playerid, COLOR_ERROR, amsg);
}

// Random: unul din trei efecte neplacute
stock Event_NpcRandom(playerid)
{
    switch(random(3))
    {
        case 0:
        {
            SetPlayerHealth(playerid, 10.0);
            SCM(playerid, COLOR_ERROR, C_ERROR"[Event] "C_WHITE"It jumped you and left you barely standing.");
        }
        case 1:
        {
            if(PlayerData[playerid][pDiseased])
                SCM(playerid, COLOR_ERROR, C_ERROR"[Event] "C_WHITE"It coughed all over you. You are already sick anyway.");
            else
                Disease_Infect(playerid); // isi trimite singur mesajul si salveaza in DB
        }
        case 2:
        {
            PlayerData[playerid][pTired] = EVENT_NPC_TIRED_MAX;
            UpdatePlayer(playerid, pTired);
            SetPlayerDrunkLevel(playerid, EVENT_NPC_DRUNK_LEVEL);
            SCM(playerid, COLOR_ERROR, C_ERROR"[Event] "C_WHITE"It made you swallow something foul. You are exhausted and seeing double.");
        }
    }
}

// Efectul comportamentului, aplicat la fiecare interactiune (progresul e separat, o singura data)
stock Event_NpcBehaviour(playerid, npcIdx)
{
    switch(Event_NpcBehaviourFor(playerid, npcIdx))
    {
        case EVENT_NPC_PEACEFUL:
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Event] "C_WHITE"This one is harmless - it just groans at you and shuffles away.");

        case EVENT_NPC_AGGRESSIVE: Event_NpcAggressive(playerid, npcIdx);
        case EVENT_NPC_RANDOM:     Event_NpcRandom(playerid);
        default:                   Event_NpcTellFact(playerid, npcIdx); // inactiv: iti spune o curiozitate
    }
}

// Interactiunea propriu-zisa. Cine a fost deja vizitat se stie din `g_EventNpcTalked`, incarcat
// din DB la logare, deci nu mai e nevoie de un query la fiecare apasare de ENTER.
stock Event_NpcTalk(playerid, npcIdx)
{
    if(npcIdx < 0 || npcIdx >= g_EventNpcCount) return;

    if(g_EventNpcTalked[playerid][npcIdx])
    {
        // deja luat progres de la el; efectul comportamentului se aplica oricum
        SCM(playerid, COLOR_INFO, C_INFO"[Event] "C_WHITE"You already met this one - find another to make progress.");
        Event_NpcBehaviour(playerid, npcIdx);
        return;
    }

    // Pasnicii cer ceva: fara conditia indeplinita nu dau progres si NU se marcheaza ca vizitati,
    // ca jucatorul sa se poata intoarce dupa ce rezolva ce i s-a cerut.
    new evTaken = 0; // ce obiect i-a luat personajul (weaponid), 0 = niciunul
    if(Event_NpcBehaviourFor(playerid, npcIdx) == EVENT_NPC_PEACEFUL)
    {
        new cond = Event_NpcConditionFor(playerid, npcIdx);
        if(!Event_NpcCondMet(playerid, cond))
        {
            new ctext[96], cmsg[208];
            Event_NpcCondText(cond, ctext, sizeof(ctext));
            format(cmsg, sizeof(cmsg), T(playerid, C_INFO"[Event] "C_WHITE"It wants something first: you must "C_INFO"%s"C_WHITE". Come back after that."), T(playerid, ctext));
            SCM(playerid, COLOR_INFO, cmsg);
            return;
        }

        // Conditia e indeplinita: daca era despre un obiect, personajul il ia. Se face DUPA verificare
        // si inainte de a marca vizita, ca sa nu ramana platit fara sa fi primit progresul.
        evTaken = Event_NpcCondConsume(playerid, cond);
    }

    g_EventNpcTalked[playerid][npcIdx] = 1;
    Event_NpcTalkRemember(playerid, EventNpc[npcIdx][enID]); // salveaza imediat, nu la deconectare
    Event_AddProgress(playerid, EventNpc[npcIdx][enQuest], 1);

    // Mesaje intregi, nu un nume de obiect infipt intr-un sablon: lang_tool sare peste literalii
    // scurti ("shovel", "flowers"), deci un nume separat ar ramane in engleza intr-o fraza romaneasca.
    switch(evTaken)
    {
        case WEAPON_SHOVEL:
            SCM(playerid, COLOR_INFO, C_INFO"[Event] "C_WHITE"It took your "C_INFO"shovel"C_WHITE" - you will need another one for the next character that asks.");
        case WEAPON_FLOWER:
            SCM(playerid, COLOR_INFO, C_INFO"[Event] "C_WHITE"It took your "C_INFO"flowers"C_WHITE" - you will need another bunch for the next character that asks.");
    }

    new qi = Event_FindQuest(EventNpc[npcIdx][enQuest]);
    if(qi != -1)
    {
        new nmsg[176];
        format(nmsg, sizeof(nmsg), T(playerid, C_SUCCESS"[Event] "C_WHITE"Progress added to "C_INFO"%s"C_WHITE" - check "C_INFO"/quest"C_WHITE"."), EventQuest[qi][eqName]);
        SCM(playerid, COLOR_SUCCESS, nmsg);
    }

    Event_NpcBehaviour(playerid, npcIdx); // efectul se aplica de fiecare data
}

// Apelata la ENTER: cauta un personaj in raza si porneste interactiunea
stock Event_NpcInteract(playerid)
{
    if(!Event_ObjectsOn()) return;
    if(!PlayerData[playerid][pLogged]) return;

    // inca nu stim cu cine a vorbit deja (relog / eveniment tocmai pornit) - cerem din DB si il punem sa reincerce
    if(g_EventTalkState[playerid] != EVENT_PICKUPS_READY)
    {
        if(g_EventTalkState[playerid] == EVENT_PICKUPS_NONE) Event_LoadNpcTalks(playerid);
        SCM(playerid, COLOR_INFO, C_INFO"[Event] "C_WHITE"One second, loading your progress... try again.");
        return;
    }

    new tick = GetTickCount();
    for(new i = 0; i < g_EventNpcCount; i++)
    {
        if(!IsValidDynamicActor(EventNpc[i][enActor])) continue;
        if(GetPlayerInterior(playerid) != EventNpc[i][enInterior]) continue;
        if(!IsPlayerInRangeOfPoint(playerid, EVENT_NPC_RANGE, EventNpc[i][enX], EventNpc[i][enY], EventNpc[i][enZ])) continue;

        if(tick < g_EventNpcCooldown[playerid][i])
        {
            SCM(playerid, COLOR_INFO, C_INFO"[Event] "C_WHITE"Give it a moment before you touch it again.");
            return;
        }

        g_EventNpcCooldown[playerid][i] = tick + EVENT_NPC_COOLDOWN_MS;
        Event_NpcTalk(playerid, i);
        return; // un singur personaj per apasare
    }
}


// Quest-urile evenimentului activ, afisate la finalul lui /quest (si de /holiday pentru admini).
// Daca nu ruleaza niciun eveniment nu afiseaza nimic - quest-urile de sarbatoare exista
// pentru jucatori doar cat timp evenimentul e pornit.
stock Event_ShowStatus(playerid)
{
    if(!Event_HasQuests()) return; // oprit sau ascuns -> nu se afiseaza nimic in /quest

    new q[220];
    mysql_format(g_SQL, q, sizeof(q),
        "SELECT `quest_key`,`progress`,`claimed` FROM `event_progress` WHERE `pID`=%d",
        PlayerData[playerid][pID]);
    mysql_tquery(g_SQL, q, "OnEventProgressLoaded", "i", playerid);
}

forward OnEventProgressLoaded(playerid);
public OnEventProgressLoaded(playerid)
{
    if(!IsPlayerConnected(playerid) || !PlayerData[playerid][pLogged]) return 1;

    for(new i = 0; i < EVENT_MAX_QUESTS; i++)
    {
        g_EventTmpProgress[playerid][i] = 0;
        g_EventTmpClaimed[playerid][i]  = 0;
    }

    new rows = cache_num_rows();
    for(new r = 0; r < rows; r++)
    {
        new key[EVENT_KEY_LEN], prog, clm;
        cache_get_value_name(r, "quest_key", key, EVENT_KEY_LEN);
        cache_get_value_name_int(r, "progress", prog);
        cache_get_value_name_int(r, "claimed", clm);

        new qi = Event_FindQuest(key);
        if(qi == -1) continue;
        g_EventTmpProgress[playerid][qi] = prog;
        g_EventTmpClaimed[playerid][qi]  = clm;
    }

    // Datele sunt gata - dialogul le randeaza pe toate (saptamanale + eveniment) intr-un loc
    Quest_ShowDialog(playerid);
    return 1;
}

// Randeaza dialogul /quest din datele deja incarcate: nume quest + progres curent, in doua
// sectiuni (saptamanale + eveniment). Tot aici se platesc recompensele nou-indeplinite.
// Rulare sincrona de la cap la coada -> buferul static e sigur (nu se intercaleaza doi jucatori).
stock Quest_ShowDialog(playerid)
{
    static body[3072]; // 2 quest-uri saptamanale + pana la 16 de eveniment, cu etichete de stare
    new line[220];

    format(body, sizeof(body), T(playerid, "Quest\tProgress\n"));

    // ---- sectiunea 1: quest-urile saptamanale ale religiei ----
    new rel = PlayerData[playerid][pReligion];
    if(rel >= 0 && rel <= 3)
    {
        format(line, sizeof(line), T(playerid, "{FFD700}Weekly - %s\t\n"), g_ReligionName[rel]);
        strcat(body, line);

        for(new slot = 0; slot < 2; slot++)
        {
            new mode   = g_ReligionQuest[rel][slot][qMode];
            new target = g_ReligionQuest[rel][slot][qTarget];
            new bool:done;
            new progText[16];

            if(mode == QUEST_MODE_AVOID_SIN)
            {
                new sinIdx = g_ReligionQuest[rel][slot][qSinNumber] - 1;
                done = (g_QuestTmpSins[playerid][sinIdx] == 0);
                format(progText, sizeof(progText), done ? ("clean") : ("failed"));
            }
            else
            {
                new prog = g_QuestTmpProgress[playerid][slot];
                done = (prog >= target);
                format(progText, sizeof(progText), "%d/%d", prog, target);
            }

            format(line, sizeof(line), "%s%s\t%s%s\n",
                done ? ("{3ECF8E}") : ("{FFFFFF}"), g_ReligionQuest[rel][slot][qName],
                done ? ("{3ECF8E}") : ("{C8C8C8}"), progText);
            strcat(body, line);

            if(done && !g_QuestTmpClaimed[playerid][slot])
            {
                new reward = g_ReligionQuest[rel][slot][qReward];
                PlayerData[playerid][pMoney] += reward;
                GivePlayerMoney(playerid, reward);
                UpdatePlayer(playerid, pMoney);

                new rq[220];
                mysql_format(g_SQL, rq, sizeof(rq),
                    "INSERT INTO `quests` (`pID`,`weekNo`,`slot`,`progress`,`claimed`) VALUES (%d,%d,%d,%d,1) ON DUPLICATE KEY UPDATE `claimed`=1",
                    PlayerData[playerid][pID], Pray_GetWeekNumber(), slot, target);
                mysql_tquery(g_SQL, rq, "", "", 0);
                g_QuestTmpClaimed[playerid][slot] = 1;

                new rmsg[160];
                format(rmsg, sizeof(rmsg), T(playerid, C_SUCCESS"[Quest] "C_WHITE"'%s' complete! You received "C_INFO"$%s"C_WHITE"."),
                    g_ReligionQuest[rel][slot][qName], MoneyStr(reward));
                SCM(playerid, COLOR_SUCCESS, rmsg);
            }
        }
    }

    // ---- sectiunea 2: quest-urile evenimentului sezonier, doar cat timp ruleaza ----
    if(Event_HasQuests())
    {
        format(line, sizeof(line), T(playerid, "{FFD700}Event - %s\t\n"), g_EventName);
        strcat(body, line);

        for(new i = 0; i < g_EventQuestCount; i++)
        {
            // Starea e per quest acum (limitata de cea a sarbatorii), deci si eticheta.
            // La START nu se pune nimic; la PAUSE/STOP jucatorul trebuie sa vada de ce nu-i
            // mai creste progresul. La HIDE quest-ul nu apare deloc in lista.
            new evState = Event_QuestState(i);
            if(evState <= EVENT_STATE_HIDE) continue;

            new evTag[28];
            if(evState == EVENT_STATE_PAUSE)     format(evTag, sizeof(evTag), "{FFD700}[PAUSE] ");
            else if(evState == EVENT_STATE_STOP) format(evTag, sizeof(evTag), "{FF5D5D}[DISABLED] ");
            else                                 evTag[0] = EOS;

            new prog   = g_EventTmpProgress[playerid][i];
            new target = EventQuest[i][eqTarget];
            new bool:done = (prog >= target);

            format(line, sizeof(line), "%s%s%s\t%s%d/%d\n",
                evTag, done ? ("{3ECF8E}") : ("{FFFFFF}"), EventQuest[i][eqName],
                done ? ("{3ECF8E}") : ("{C8C8C8}"), prog, target);
            strcat(body, line);

            // recompensa se plateste o singura data, la prima verificare dupa indeplinire
            if(done && !g_EventTmpClaimed[playerid][i])
            {
                new reward = EventQuest[i][eqReward];
                if(reward > 0)
                {
                    PlayerData[playerid][pMoney] += reward;
                    GivePlayerMoney(playerid, reward);
                    UpdatePlayer(playerid, pMoney);
                }

                new rq[300];
                mysql_format(g_SQL, rq, sizeof(rq),
                    "INSERT INTO `event_progress` (`pID`,`quest_key`,`progress`,`claimed`,`updated_at`) VALUES (%d,'%e',%d,1,NOW()) \
                     ON DUPLICATE KEY UPDATE `claimed`=1, `updated_at`=NOW()",
                    PlayerData[playerid][pID], EventQuest[i][eqKey], target);
                mysql_tquery(g_SQL, rq, "", "", 0);
                g_EventTmpClaimed[playerid][i] = 1;

                new rmsg[176];
                format(rmsg, sizeof(rmsg), T(playerid, C_SUCCESS"[Event] "C_WHITE"'%s' complete! You received "C_INFO"$%s"C_WHITE"."),
                    EventQuest[i][eqName], MoneyStr(reward));
                SCM(playerid, COLOR_SUCCESS, rmsg);
            }
        }
    }

    SPD(playerid, DIALOG_QUEST_LIST, DIALOG_STYLE_TABLIST_HEADERS, "Quests", body, "Close", "");
}

// Cele 3 biserici (locations_admin locID 65/66/67) - eticheta 3D cu numele preluat direct din DB
#define CHURCH_COUNT        3     // cate biserici / interioare exista (1:1)
#define CHURCH_PICKUP_MODEL 11712
new const g_ChurchLocID[CHURCH_COUNT] = {65, 66, 67};
stock Church_LoadLabels()
{
    for(new c = 0; c < CHURCH_COUNT; c++)
    {
        new idx = Locations_FindByID(g_ChurchLocID[c]);
        if(idx == -1) continue;

        new label[64];
        format(label, sizeof(label), "[ Church ]\n[ %s ]", LocationData[idx][locName]);
        Create3DTextLabel(label, COLOR_WHITE,
            LocationData[idx][locX], LocationData[idx][locY], LocationData[idx][locZ] - 0.5, 20.0, LocationData[idx][locVW], 0);

        // pickup-ul de intrare (se apasa ENTER langa el)
        CreateDynamicPickup(CHURCH_PICKUP_MODEL, 1,
            LocationData[idx][locX], LocationData[idx][locY], LocationData[idx][locZ], LocationData[idx][locVW], 0);
    }
}

// ============================================================
//  INTERIOARE DE BISERICA (harti custom)
// ------------------------------------------------------------
//  Obiecte convertite din CreateObject in CreateDynamicObject (streamer).
//  Fiecare interior are propriul virtual world, ca sa nu se vada unul din
//  celalalt si sa nu apara nimanui altcuiva. Un jucator vede harta doar cat
//  timp e in VW-ul ei (setat la intrare, vezi Church_Toggle).
// ============================================================
#define CHURCH_INT1_VW      10001
#define CHURCH_INT2_VW      10002
#define CHURCH_INT3_VW      10003
#define CHURCH_RANGE        3.0   // raza de intrare (afara) / de iesire (inauntru)
#define CHURCH_PRAY_RANGE   5.0   // raza punctului de rugaciune din interior

new const g_ChurchIntVW[CHURCH_COUNT] = {CHURCH_INT1_VW, CHURCH_INT2_VW, CHURCH_INT3_VW};

// unde apare jucatorul cand intra in fiecare harta
// harta 3 nu e construita inca - coordonatele 0,0,0 o marcheaza ca indisponibila (vezi Church_MapReady)
new const Float:g_ChurchIntPos[CHURCH_COUNT][3] = {
    {-2022.1718, 1019.6956, 1418.5000},
    {  387.0617, 2324.2410, 1889.6000},
    { 2241.6500, -1341.0000,  999.0000}
};

// punctul din fiecare harta unde se poate folosi /pray
new const Float:g_ChurchPrayPos[CHURCH_COUNT][3] = {
    {-2022.0280, 1009.2620, 1418.4869},
    {  374.5225, 2324.4819, 1889.5669},
    { 2241.7000, -1330.5000,  999.0000}
};

// ---- Maparea religie <-> biserica ----
// Fiecare religie (in afara de Ateu) are biserica ei, iar fiecare biserica are propria harta.
//   religie 0 Ateu                -> nicio biserica
//   religie 1 The Ascendants      -> locID 65, Ascendant Spire     -> harta 1
//   religie 2 The Holy Order      -> locID 66, Holy Order Chapel   -> harta 2
//   religie 3 The Divine Blessing -> locID 67, Santa Luz Chapel    -> harta 3
new const g_ReligionChurch[4] = {-1, 0, 1, 2}; // index de religie -> index in g_ChurchLocID (-1 = niciuna)
new const g_ChurchReligion[CHURCH_COUNT] = {1, 2, 3}; // invers: index de biserica -> index de religie
new const g_ChurchMap[CHURCH_COUNT] = {0, 1, 2};      // index de biserica -> index de harta

new g_PlayerChurch[MAX_PLAYERS] = {-1, ...}; // in ce biserica e jucatorul (index in g_ChurchLocID; -1 = afara)

// maparea listitem -> index de biserica pentru dialogul /churchlist
new g_ChurchListIdx[MAX_PLAYERS][CHURCH_COUNT];
new g_ChurchListCount[MAX_PLAYERS];

