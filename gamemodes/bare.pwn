public OnGameModeInit()
{
    Lang_Load();          // incarca scriptfiles/lang/*.txt inainte de orice mesaj

    SetGameModeText("N-RP");
    ShowPlayerMarkers(0);
    ShowNameTags(1);
    AllowAdminTeleport(1);
    DisableInteriorEnterExits();

    for(new p = 0; p < MAX_PLAYERS; p++)
        for(new t = 0; t < EXAMW_TARGET_COUNT; t++)
            g_ExamWTargetObj[p][t] = STREAMER_TAG_OBJECT:-1;

    // obiectele de eveniment sunt per jucator: 0 ar fi un id valid de obiect, deci se initializeaza cu -1
    for(new p = 0; p < MAX_PLAYERS; p++)
        for(new eo = 0; eo < EVENT_MAX_OBJECTS; eo++)
            g_EventPObj[p][eo] = STREAMER_TAG_OBJECT:-1;

    // la fel si actorii personajelor (globali, dar 0 ar fi tot un id valid)
    for(new en = 0; en < EVENT_MAX_NPCS; en++)
        EventNpc[en][enActor] = STREAMER_TAG_ACTOR:-1;

    AddPlayerClass(7,868.2825,-2071.2629,17.3279,32.4158,0,0,0,0,0,0); // spawn civil 1
    AddPlayerClass(7,855.5033,-2073.2300,17.3279,16.4357,0,0,0,0,0,0); // spawn civil 2
    AddPlayerClass(7,842.9693,-2071.7813,17.3279,5.1556,0,0,0,0,0,0);  // spawn civil 3
