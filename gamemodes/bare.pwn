// ============================================================
//  INCARCARE HOTELURI
// ============================================================
stock Bars_Load()
{
    mysql_tquery(g_SQL,
        "SELECT `id`,`name`,`type`,`gta_interior_id`,`vw_id`,`loc_x`,`loc_y`,`loc_z`,`stock_max`,`stock_curr`,`terrace` FROM `bars` ORDER BY `id` ASC",
        "OnBarsLoaded");
}

public OnBarsLoaded()
{
    // Teardown complet inainte de reincarcare (necesar pt. /reload); g_BarIntLabel nu are nevoie, Bar_Create isi verifica singur eticheta de interior
    for(new i = 0; i < MAX_BARS; i++)
    {
        if(g_BarPickup[i] != -1) { DestroyPickup(g_BarPickup[i]); g_BarPickup[i] = -1; }
        if(g_BarLabel[i] != Text3D:INVALID_3DTEXT_ID) { Delete3DTextLabel(g_BarLabel[i]); g_BarLabel[i] = Text3D:INVALID_3DTEXT_ID; }
    }

    new rows = cache_num_rows();
    g_BarCount = 0;
    for(new i = 0; i < rows && g_BarCount < MAX_BARS; i++)
    {
        new idx = g_BarCount;
        cache_get_value_name_int  (i, "id",              BarData[idx][barID]);
        cache_get_value_name      (i, "name",            BarData[idx][barName], 32);
        cache_get_value_name_int  (i, "type",             BarData[idx][barType]);
        cache_get_value_name_int  (i, "gta_interior_id",  BarData[idx][barGTAIntID]);
        cache_get_value_name_int  (i, "vw_id",            BarData[idx][barVW]);
        cache_get_value_name_float(i, "loc_x", BarData[idx][barLocX]);
        cache_get_value_name_float(i, "loc_y", BarData[idx][barLocY]);
        cache_get_value_name_float(i, "loc_z", BarData[idx][barLocZ]);
        cache_get_value_name_int  (i, "stock_max",  BarData[idx][barStockMax]);
        cache_get_value_name_int  (i, "stock_curr", BarData[idx][barStockCurr]);
        new barTerraceInt;
        cache_get_value_name_int  (i, "terrace", barTerraceInt);
        BarData[idx][barTerrace] = bool:barTerraceInt;

        g_BarPickup[idx] = -1;
        g_BarLabel[idx]  = Text3D:INVALID_3DTEXT_ID;
        Bar_Create(idx);
        g_BarCount++;
    }
    printf("[Load] Baruri: %d", g_BarCount);
    return 1;
}

// Dupa /barcreate: seteaza vw_id = id-ul barului nou-creat, apoi reincarca lista de baruri
public OnBarCreated(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    new newBarId = cache_insert_id();

    new q[96];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `bars` SET `vw_id`=%d WHERE `id`=%d", newBarId, newBarId);
    mysql_tquery(g_SQL, q, "", "", 0);
    Bars_Load(); // reincarca (ruleaza dupa UPDATE pe aceeasi conexiune)

    SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Bar created at your position. Configure it with "C_INFO"/barc"C_WHITE".");
    return 1;
}

stock Hotels_Load()
{
    mysql_tquery(g_SQL,
        "SELECT `id`,`name`,`owner`,`owner_id`,`owned`,`is_for_sale`,`price`,`loc_x`,`loc_y`,`loc_z`,`bank`,`is_rentable`,`rent_price`,`capacity`,`items` FROM `hotels` ORDER BY `id` ASC",
        "OnHotelsLoaded");
}

public OnHotelsLoaded()
{
    // Teardown complet inainte de reincarcare (necesar pt. /reload)
    for(new i = 0; i < MAX_HOTELS; i++)
    {
        if(g_HotelPickup[i] != -1) { DestroyPickup(g_HotelPickup[i]); g_HotelPickup[i] = -1; }
        if(g_HotelLabel[i] != Text3D:INVALID_3DTEXT_ID) { Delete3DTextLabel(g_HotelLabel[i]); g_HotelLabel[i] = Text3D:INVALID_3DTEXT_ID; }
    }

    new rows = cache_num_rows();
    g_HotelCount = 0;
    for(new i = 0; i < rows && g_HotelCount < MAX_HOTELS; i++)
    {
        new idx = g_HotelCount;
        cache_get_value_name_int  (i, "id",          HotelData[idx][htlID]);
        cache_get_value_name      (i, "name",        HotelData[idx][htlName],  32);
        cache_get_value_name      (i, "owner",       HotelData[idx][htlOwnerName], 24);
        cache_get_value_name_int  (i, "owner_id",    HotelData[idx][htlOwnerId]);
        cache_get_value_name_int  (i, "owned",       HotelData[idx][htlOwned]);
        cache_get_value_name_int  (i, "is_for_sale", HotelData[idx][htlForSale]);
        cache_get_value_name_int  (i, "price",       HotelData[idx][htlPrice]);
        cache_get_value_name_float(i, "loc_x", HotelData[idx][htlLocX]);
        cache_get_value_name_float(i, "loc_y", HotelData[idx][htlLocY]);
        cache_get_value_name_float(i, "loc_z", HotelData[idx][htlLocZ]);
        cache_get_value_name_int  (i, "bank",         HotelData[idx][htlBank]);
        cache_get_value_name_int  (i, "is_rentable",  HotelData[idx][htlIsRentable]);
        cache_get_value_name_int  (i, "rent_price",   HotelData[idx][htlRentPrice]);
        cache_get_value_name_int  (i, "capacity",     HotelData[idx][htlCapacity]);
        if(HotelData[idx][htlCapacity] <= 0) HotelData[idx][htlCapacity] = HOTEL_DEFAULT_CAPACITY;
        cache_get_value_name_int  (i, "items",        HotelData[idx][htlItems]);
        HotelData[idx][htlItems] = clamp(HotelData[idx][htlItems], 0, HOTEL_ITEMS_MAX);
        HotelData[idx][htlRenterCount] = 0;
        g_HotelPickup[idx] = -1;
        g_HotelLabel[idx]  = Text3D:INVALID_3DTEXT_ID;
        Hotels_RecreatePickup(idx);
        g_HotelCount++;
    }
    printf("[Load] Hoteluri: %d", g_HotelCount);

    // Recalculeaza ocuparea curenta din `players`.`rent_hotel` (chiria e persistenta, nu doar cat timp e chiriasul online)
    mysql_tquery(g_SQL, "SELECT `rent_hotel`, COUNT(*) AS `cnt` FROM `players` WHERE `rent_hotel` != 0 GROUP BY `rent_hotel`", "OnHotelRenterCountsLoaded");
    return 1;
}

public OnHotelRenterCountsLoaded()
{
    new rows = cache_num_rows();
    for(new i = 0; i < rows; i++)
    {
        new hid, cnt;
        cache_get_value_name_int(i, "rent_hotel", hid);
        cache_get_value_name_int(i, "cnt",         cnt);

        new htlidx = Hotels_FindByID(hid);
        if(htlidx != -1) HotelData[htlidx][htlRenterCount] = cnt;
    }
    return 1;
}

// ============================================================
//  INCARCARE ANIMALE
// ============================================================
stock Animals_Load()
{
    mysql_tquery(g_SQL,
        "SELECT `aID`,`aType`,`aPlayerID`,`aHouseID`,`aName`,`aDefaultName`,`aAge`,`aDeceased`,`isOnPlayer` FROM `houses_animals` ORDER BY `aID` ASC",
        "OnAnimalsLoaded");
}

public OnAnimalsLoaded()
{
    Animals_DestroyAll(); // curata actorii existenti (relevant la respawn-ul de payday)

    new rows = cache_num_rows();
    for(new i = 0; i < rows && g_AnimalCount < MAX_ANIMALS; i++)
    {
        new idx = g_AnimalCount;
        cache_get_value_name_int(i, "aID",       AnimalData[idx][aID]);
        cache_get_value_name_int(i, "aType",     AnimalData[idx][aType]);
        cache_get_value_name_int(i, "aPlayerID", AnimalData[idx][aPlayerID]);
        cache_get_value_name_int(i, "aHouseID",  AnimalData[idx][aHouseID]);
        cache_get_value_name    (i, "aName",     AnimalData[idx][aName], 32);
        cache_get_value_name    (i, "aDefaultName", AnimalData[idx][aDefaultName], 32);
        cache_get_value_name_int(i, "aAge",      AnimalData[idx][aAge]);
        new deceasedInt;
        cache_get_value_name_int(i, "aDeceased", deceasedInt);
        AnimalData[idx][aDeceased] = bool:deceasedInt;
        new onPlayerInt;
        cache_get_value_name_int(i, "isOnPlayer", onPlayerInt);
        AnimalData[idx][aOnPlayer] = bool:onPlayerInt;

        g_AnimalObject[idx] = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
        if(AnimalData[idx][aOnPlayer] && !AnimalData[idx][aDeceased])
        {
            // Nu se spawneaza la casa cat timp e purtat - daca proprietarul e online, se reataseaza automat (relog/reload)
            new prOwner = Houses_FindPlayerByPID(AnimalData[idx][aPlayerID]);
            if(prOwner != INVALID_PLAYER_ID) Parrot_Attach(prOwner, idx);
        }
        else if(AnimalData[idx][aType] != ANIMAL_PARROT_MODEL)
        {
            // Papagalul nu se spawneaza niciodata langa casa - e vizibil doar pe umarul proprietarului (/parrot get)
            Animals_Spawn(idx);
        }
        g_AnimalCount++;
    }
    printf("[Load] Animale: %d", g_AnimalCount);
    return 1;
}

