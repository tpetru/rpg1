// Rezultatul interogarii pornite de /showunusedveh (vehicule personale cu unused_veh=1, cu numele proprietarului din `players`)
public OnUnusedVehListLoaded(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    new rows = cache_num_rows();
    if(rows == 0)
        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"No unused vehicles (30+ days without starting the engine)."), 1;

    static list[4000];
    list[0] = EOS;
    strcat(list, T(playerid, ""C_INFO"VehId\t"C_INFO"ModelId\t"C_INFO"LastStartEngine\t"C_INFO"Owner\t"C_INFO"RetroVeh\n"));
    for(new i = 0; i < rows; i++)
    {
        new uvVehid, uvModelId, uvLastStart, uvRetro, uvOwner[24], uvLastStartBuf[11];
        cache_get_value_name_int(i, "vehid", uvVehid);
        cache_get_value_name_int(i, "model_id", uvModelId);
        cache_get_value_name(i, "last_start_engine", uvLastStartBuf, sizeof(uvLastStartBuf));
        uvLastStart = DateStrToUnix(uvLastStartBuf);
        cache_get_value_name_int(i, "retro_veh", uvRetro);
        cache_get_value_name(i, "owner", uvOwner, sizeof(uvOwner));

        new uvDateStr[20];
        if(uvLastStart > 0) UnixToDateStr(uvLastStart, uvDateStr, sizeof(uvDateStr));
        else format(uvDateStr, sizeof(uvDateStr), "Never");

        new line[160];
        format(line, sizeof(line), ""C_WHITE"#%d\t"C_WHITE"%d\t"C_WHITE"%s\t"C_WHITE"%s\t"C_WHITE"%s\n",
            uvVehid, uvModelId, uvDateStr, uvOwner, uvRetro ? "Yes" : "No");
        strcat(list, line);
    }

    SPD(playerid, DIALOG_UNUSEDVEH_LIST, DIALOG_STYLE_TABLIST_HEADERS, "Unused Vehicles (30+ days)", list, "Close", "");
    return 1;
}

public OnVehiclePlateChecked(playerid, pvidx, plate[])
{
    if(!IsPlayerConnected(playerid)) return 0;

    if(cache_num_rows() > 0)
    {
        SCM(playerid, COLOR_ERROR,
            C_ERROR"Error: "C_WHITE"This license plate is already registered. Choose a different combination.");
        return 1;
    }

    if(PlayerData[playerid][pMoney] < g_PlatePrice)
    {
        SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have enough money.");
        return 1;
    }

    PlayerData[playerid][pMoney] -= g_PlatePrice;
    GivePlayerMoney(playerid, -g_PlatePrice);
    UpdatePlayer(playerid, pMoney);
    Faction_AddBank(FACTION_RAR, g_PlatePrice);

    format(PVehicleData[pvidx][pvPlate], 24, "%s", plate);

    new vehid = g_PVehicleVehicle[pvidx];
    if(vehid != -1) SetVehicleNumberPlate(vehid, PVehicleData[pvidx][pvPlate]);

    new q[128];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `plate`='%e' WHERE `id`=%d",
        PVehicleData[pvidx][pvPlate], PVehicleData[pvidx][pvID]);
    mysql_tquery(g_SQL, q, "", "", 0);

    SCM(playerid, COLOR_SUCCESS, C_SUCCESS"Success: "C_WHITE"The license plate has been changed.");
    return 1;
}

public OnVehicleITPCheck(playerid, pvidx, vehid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    TogglePlayerControllable(playerid, 1);

    // Daca playerul a iesit din masina sau a coborat de pe scaunul de sofer in cele 10 secunde, anuleaza
    if(GetPlayerVehicleID(playerid) != vehid || GetPlayerVehicleSeat(playerid) != 0)
    {
        SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"The vehicle inspection has been cancelled.");
        return 1;
    }

    new Float:health;
    GetVehicleHealth(vehid, health);

    new bool:passed = (health > ITP_MIN_HEALTH)
        && VehicleDoc_IsValid(PVehicleData[pvidx][pvInsuranceExp])
        && VehicleDoc_IsValid(PVehicleData[pvidx][pvMedkitExp])
        && VehicleDoc_IsValid(PVehicleData[pvidx][pvExtinguisherExp]);

    if(passed)
    {
        PVehicleData[pvidx][pvITPExp] = gettime() + VEHICLE_ITP_DURATION;

        new dateStr[11];
        UnixToDateStr(PVehicleData[pvidx][pvITPExp], dateStr, sizeof(dateStr));

        new q[128];
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `itp_exp`='%s' WHERE `id`=%d",
            dateStr, PVehicleData[pvidx][pvID]);
        mysql_tquery(g_SQL, q, "", "", 0);

        SCM(playerid, COLOR_SUCCESS,
            C_SUCCESS"Success: "C_WHITE"The vehicle passed inspection! Valid for "C_INFO"15 days"C_WHITE".");
    }
    else
    {
        SCM(playerid, COLOR_ERROR,
            C_ERROR"Error: "C_WHITE"The vehicle did NOT pass inspection. Check the vehicle's condition, insurance, medical kit and extinguisher.");
    }
    return 1;
}

// ============================================================
//  PAYDAY
// ============================================================
// Incrementeaza un contor statistic din server_setup (cheie stat_*)
stock Stat_Inc(const key[], amount = 1)
{
    new q[192];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `server_setup` SET `ssValue`=GREATEST(CAST(`ssValue` AS SIGNED)+(%d),0) WHERE `ssSetare`='%e'", amount, key);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Seteaza un contor statistic din server_setup la o valoare absoluta (cheie stat_*)
stock Stat_Set(const key[], value)
{
    new q[160];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `server_setup` SET `ssValue`='%d' WHERE `ssSetare`='%e'", value, key);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Actualizeaza textul 3D de deasupra pickup-ului unui manager
stock Manager_UpdateLabel(m)
{
    if(m < 0 || m >= MANAGER_COUNT || g_ManagerLabel[m] == Text3D:INVALID_3DTEXT_ID) return;
    new t[96];
    format(t, sizeof(t), "[ %s Manager ]\n[ Current manager: %s ]", g_ManagerTitle[m], g_ManagerName[m][0] ? g_ManagerName[m] : "None");
    Update3DTextLabelText(g_ManagerLabel[m], COLOR_WHITE, t);
}

// Creeaza pickup-ul + eticheta 3D (apelat o singura data la pornire; numele vine apoi din OnPayDayLoaded)
stock Manager_CreateWorld(m)
{
    new t[96];
    format(t, sizeof(t), "[ %s Manager ]\n[ Current manager: %s ]", g_ManagerTitle[m], g_ManagerName[m][0] ? g_ManagerName[m] : "None");
    CreatePickup(MANAGER_PICKUP_MODEL, 1, g_ManagerPos[m][0], g_ManagerPos[m][1], g_ManagerPos[m][2], -1);
    g_ManagerLabel[m] = Create3DTextLabel(t, COLOR_WHITE, g_ManagerPos[m][0], g_ManagerPos[m][1], g_ManagerPos[m][2] - 0.5, 20.0, 0, 0);
}

// Seteaza (name != "") sau sterge (name == "") managerul si salveaza in DB
stock Manager_Set(m, const name[])
{
    format(g_ManagerName[m], sizeof(g_ManagerName[]), "%s", name);
    Manager_UpdateLabel(m);
    new q[200];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `server_setup` SET `ssText`='%e' WHERE `ssSetare`='manager_%s'", name, g_ManagerKey[m]);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// ---- Misiune manager aeroport: /manage airport ----
stock Manage_Stop(playerid)
{
    if(g_MgrGraceTimer[playerid] != -1)
    {
        KillTimer(g_MgrGraceTimer[playerid]);
        g_MgrGraceTimer[playerid] = -1;
    }
    if(g_MgrState[playerid] == MGR_STATE_NONE) return;
    g_MgrState[playerid] = MGR_STATE_NONE;
    g_MgrVeh[playerid]   = 0;
    DisablePlayerCheckpoint(playerid);
}

forward Manage_GraceExpire(playerid);
public Manage_GraceExpire(playerid)
{
    g_MgrGraceTimer[playerid] = -1;
    if(!IsPlayerConnected(playerid) || g_MgrState[playerid] == MGR_STATE_NONE) return 1;
    Manage_Stop(playerid);
    SCM(playerid, COLOR_ERROR, C_ERROR"[Manager] "C_WHITE"You didn't get back into the Flatbed in time, so the mission failed.");
    return 1;
}

// Apelat din OnPlayerStateChange: a coborat din Flatbed -> 30s sa revina; s-a urcat inapoi -> continua
stock Manage_OnStateChange(playerid, newstate, oldstate)
{
    if(g_MgrState[playerid] == MGR_STATE_NONE) return;
    if(oldstate == PLAYER_STATE_DRIVER && newstate != PLAYER_STATE_DRIVER && g_MgrGraceTimer[playerid] == -1)
    {
        g_MgrGraceTimer[playerid] = SetTimerEx("Manage_GraceExpire", MGR_GRACE_MS, false, "i", playerid);
        SCM(playerid, COLOR_ERROR, C_ERROR"[Manager] "C_WHITE"You left the Flatbed! Get back in within "C_INFO"30 seconds"C_WHITE" or the mission fails.");
    }
    else if(newstate == PLAYER_STATE_DRIVER && g_MgrGraceTimer[playerid] != -1 && GetPlayerVehicleID(playerid) == g_MgrVeh[playerid])
    {
        KillTimer(g_MgrGraceTimer[playerid]);
        g_MgrGraceTimer[playerid] = -1;
        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Manager] "C_WHITE"You are back in the Flatbed. Continue the mission.");
    }
}

// Apelat din OnPlayerEnterCheckpoint; returneaza 1 daca checkpoint-ul apartine misiunii
stock Manage_HandleCheckpoint(playerid)
{
    if(g_MgrState[playerid] == MGR_STATE_NONE) return 0;
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerVehicleID(playerid) != g_MgrVeh[playerid])
    {
        SCM(playerid, COLOR_ERROR, C_ERROR"[Manager] "C_WHITE"You must be driving your Flatbed to continue the mission.");
        return 1;
    }
    if(g_MgrState[playerid] == MGR_STATE_TO_HQ)
    {
        g_MgrState[playerid] = MGR_STATE_TO_AIRPORT;
        if(g_MgrType[playerid] == MANAGER_SGR)
        {
            Track_SetPlayerCheckpoint(playerid, g_TrashUnloadX, g_TrashUnloadY, g_TrashUnloadZ, MGR_CP_SIZE);
            SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Manager] "C_WHITE"Containers loaded! Take them to the "C_INFO"Trash Unload"C_WHITE" point.");
            return 1;
        }
        if(g_MgrType[playerid] == MANAGER_TRAIN)
        {
            // livrare la una din cele 3 statii de tren, aleasa random
            new st = random(TRAIN_STATION_COUNT);
            g_MgrStation[playerid] = st;
            Track_SetPlayerCheckpoint(playerid, g_TrainStationX[st], g_TrainStationY[st], g_TrainStationZ[st], MGR_CP_SIZE);
            new tm[144];
            format(tm, sizeof(tm), T(playerid, C_SUCCESS"[Manager] "C_WHITE"Parts loaded! Deliver them to the "C_INFO"%s"C_WHITE" train station."), g_TrainStationName[st]);
            SCM(playerid, COLOR_SUCCESS, tm);
            return 1;
        }
        Track_SetPlayerCheckpoint(playerid, g_ManagerPos[MANAGER_AIRPORT][0], g_ManagerPos[MANAGER_AIRPORT][1], g_ManagerPos[MANAGER_AIRPORT][2], MGR_CP_SIZE);
        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Manager] "C_WHITE"Parts loaded! Take them to the "C_INFO"Airport Manager"C_WHITE" checkpoint.");
        return 1;
    }
    // livrat la destinatie: misiunea SGR goleste containerele, cea de tren scade calatoriile cu trenul
    if(g_MgrType[playerid] == MANAGER_SGR)
    {
        new srem = (g_StatSGRDelivered < MGR_SGR_REMOVE) ? g_StatSGRDelivered : MGR_SGR_REMOVE;
        g_StatSGRDelivered -= srem;
        Stat_Inc("stat_sgr_delivered", -srem);
        Manage_Stop(playerid);
        new smm[144];
        format(smm, sizeof(smm), T(playerid, C_SUCCESS"[Manager] "C_WHITE"Containers unloaded! "C_INFO"%d"C_WHITE" SGR removed from the depot. Free space for "C_INFO"%d"C_WHITE" more."), srem, SGR_DEPOT_MAX - g_StatSGRDelivered);
        SCM(playerid, COLOR_SUCCESS, smm);
        return 1;
    }
    if(g_MgrType[playerid] == MANAGER_TRAIN)
    {
        new trepaired = (g_StatTrainRides < MGR_REPAIR_AMOUNT) ? g_StatTrainRides : MGR_REPAIR_AMOUNT;
        g_StatTrainRides -= trepaired;
        Stat_Inc("stat_train_rides", -trepaired);
        Manage_Stop(playerid);
        new tmm[144];
        format(tmm, sizeof(tmm), T(playerid, C_SUCCESS"[Manager] "C_WHITE"Parts delivered! The trains were serviced: "C_INFO"%d"C_WHITE" rides removed from the wear counter. Rides until the next service: "C_INFO"%d"C_WHITE"."), trepaired, TRAIN_MAX_RIDES - g_StatTrainRides);
        SCM(playerid, COLOR_SUCCESS, tmm);
        return 1;
    }
    // livrat la airport manager: se scad avioanele "reparate"
    new repaired = (g_StatCropCrashes < MGR_REPAIR_AMOUNT) ? g_StatCropCrashes : MGR_REPAIR_AMOUNT;
    g_StatCropCrashes -= repaired;
    Stat_Inc("stat_crop_crashes", -repaired);
    Manage_Stop(playerid);
    new mm[144];
    format(mm, sizeof(mm), T(playerid, C_SUCCESS"[Manager] "C_WHITE"Parts delivered! "C_INFO"%d"C_WHITE" Crop Duster planes were repaired. Destroyed planes left: "C_INFO"%d"C_WHITE"."), repaired, g_StatCropCrashes);
    SCM(playerid, COLOR_SUCCESS, mm);
    return 1;
}

// /managers: afiseaza managerii fiecarei institutii (numele telefonului pt. cei offline vine din DB)
forward OnManagersListed(playerid);
public OnManagersListed(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    new rows = cache_num_rows();
    SCM(playerid, COLOR_INFO, C_INFO"===== Institution Managers =====");
    for(new m = 0; m < MANAGER_COUNT; m++)
    {
        new line[144];
        if(!g_ManagerName[m][0])
        {
            format(line, sizeof(line), T(playerid, C_INFO"%s: "C_WHITE"no manager appointed"), g_ManagerTitle[m]);
            SCM(playerid, COLOR_WHITE, line);
            continue;
        }

        new pid = INVALID_PLAYER_ID, phone = 0;
        for(new p = 0; p < MAX_PLAYERS; p++)
            if(IsPlayerConnected(p) && PlayerData[p][pLogged] && !strcmp(PlayerData[p][pName], g_ManagerName[m]))
                { pid = p; break; }

        if(pid != INVALID_PLAYER_ID)
            phone = PlayerData[pid][pPhoneNumber];
        else
        {
            for(new r = 0; r < rows; r++)
            {
                new nm[MAX_PLAYER_NAME + 1];
                cache_get_value_name(r, "username", nm, sizeof(nm));
                if(!strcmp(nm, g_ManagerName[m])) { cache_get_value_name_int(r, "phone_number", phone); break; }
            }
        }

        new ph[12];
        if(phone > 0) format(ph, sizeof(ph), "%d", phone); else format(ph, sizeof(ph), "-");

        if(pid != INVALID_PLAYER_ID)
            format(line, sizeof(line), T(playerid, C_INFO"%s: "C_WHITE"%s [%d] [Phone: %s] - "C_SUCCESS"Online"), g_ManagerTitle[m], g_ManagerName[m], pid, ph);
        else
            format(line, sizeof(line), T(playerid, C_INFO"%s: "C_WHITE"%s [Phone: %s] - "C_ERROR"Offline"), g_ManagerTitle[m], g_ManagerName[m], ph);
        SCM(playerid, COLOR_WHITE, line);
    }
    return 1;
}

// Seeds `server_setup` with every known setting (INSERT IGNORE - only fills in rows missing on a fresh install,
// never overwrites a value an admin already changed via /settax /setcass or the UCP Prices page).
stock Server_Setup_Seed()
{
    new const defaults[][2][32] = {
        {"min_salary", "5000"}, {"tax", "10"}, {"cass", "10"}, {"bank_interest", "0.10"}, {"treasury", "0"}, {"charity_fund", "0"}, {"temperature", "22"},
        {"insurance_price", "500"}, {"medkit_price", "500"}, {"extinguisher_price", "500"}, {"gascan_price", "500"},
        {"itp_price", "750"}, {"plate_price", "250"}, {"rent_bike_price", "15"},
        {"exam_a_price", "200"}, {"exam_b_price", "300"}, {"exam_c_price", "500"}, {"exam_d_price", "400"},
        {"exam_p_price", "1000"}, {"exam_h_price", "1000"},
        {"pizza_price", "50"}, {"burger_price", "55"}, {"meal_price", "60"}, {"desert_price", "30"},
        {"farm_tractor_price", "10000"}, {"farm_dozer_price", "15000"}, {"farm_combine_price", "20000"},
        {"farm_truck_price", "12500"}, {"farm_trailer_price", "10000"},
        {"shovel_price", "2500"}, {"phone_sim_price", "250"},
        {"phone_price_1", "1000"}, {"phone_price_2", "2000"}, {"phone_price_3", "1600"}, {"phone_price_4", "2200"}, {"phone_price_5", "500"},
        {"watch_price_1", "300"}, {"watch_price_2", "700"}, {"watch_price_3", "1000"}, {"watch_price_4", "10000"},
        {"weapon_colt45_price", "5000"}, {"weapon_deagle_price", "7500"}, {"weapon_shotgun_price", "50000"},
        {"weapon_mp5_price", "10000"}, {"weapon_ak47_price", "25000"}, {"weapon_m4_price", "20000"}, {"weapon_uzi_price", "9000"},
        {"phonebook_price", "2000"}, {"gps_price", "200"}, {"sapling_price", "10"},
        {"fishingrod_price", "300"}, {"chainsaw_price", "1500"},
        {"bag_price_small", "10"}, {"bag_price_medium", "30"}, {"bag_price_large", "70"},
        {"stat_train_rides", "0"}, {"stat_crop_crashes", "0"}, {"stat_sgr_delivered", "0"}
    };
    for(new i = 0; i < sizeof(defaults); i++)
    {
        new q[128];
        mysql_format(g_SQL, q, sizeof(q), "INSERT IGNORE INTO `server_setup` (`ssSetare`,`ssValue`) VALUES ('%e','%e')", defaults[i][0], defaults[i][1]);
        mysql_tquery(g_SQL, q, "", "", 0);
    }

    // charity_cause foloseste ssText (text mai lung decat cele 24 caractere ale ssValue)
    mysql_tquery(g_SQL, "INSERT IGNORE INTO `server_setup` (`ssSetare`,`ssText`) VALUES ('charity_cause','No cause set')", "", "", 0);

    // manageri: numele (ssText) gol = nu exista manager
    for(new m = 0; m < MANAGER_COUNT; m++)
    {
        new mq[128];
        mysql_format(g_SQL, mq, sizeof(mq), "INSERT IGNORE INTO `server_setup` (`ssSetare`,`ssValue`,`ssText`) VALUES ('manager_%s','','')", g_ManagerKey[m]);
        mysql_tquery(g_SQL, mq, "", "", 0);
    }
}

stock PayDay_Load()
{
    mysql_tquery(g_SQL, "SELECT `ssSetare`,`ssValue`,`ssText` FROM `server_setup`", "OnPayDayLoaded");
}

public OnPayDayLoaded()
{
    new rows = cache_num_rows();
    for(new i = 0; i < rows; i++)
    {
        new key[40], val[24];
        cache_get_value_name(i, "ssSetare", key, sizeof(key));
        cache_get_value_name(i, "ssValue", val, sizeof(val));

        if(!strcmp(key, "min_salary"))               g_PDMinSalary = strval(val);
        else if(!strcmp(key, "tax"))                g_PDTax = strval(val);
        else if(!strcmp(key, "cass"))                g_PDCASS = strval(val);
        else if(!strcmp(key, "bank_interest"))       g_PDInterest = floatstr(val);
        else if(!strcmp(key, "treasury"))            g_StateTreasury = strval(val);
        else if(!strcmp(key, "charity_fund"))        g_CharityFund = strval(val);
        else if(!strcmp(key, "temperature"))         g_CityTemperature = strval(val);
        else if(!strcmp(key, "charity_cause"))       cache_get_value_name(i, "ssText", g_CharityCause, sizeof(g_CharityCause));
        else if(!strcmp(key, "insurance_price"))     g_InsurancePrice = strval(val);
        else if(!strcmp(key, "medkit_price"))        g_MedkitPrice = strval(val);
        else if(!strcmp(key, "extinguisher_price"))  g_ExtinguisherPrice = strval(val);
        else if(!strcmp(key, "gascan_price"))        g_GasCanPrice = strval(val);
        else if(!strcmp(key, "itp_price"))           g_ITPPrice = strval(val);
        else if(!strcmp(key, "plate_price"))         g_PlatePrice = strval(val);
        else if(!strcmp(key, "rent_bike_price"))     g_RentBikePrice = strval(val);
        else if(!strcmp(key, "exam_a_price"))        g_ExamAPrice = strval(val);
        else if(!strcmp(key, "exam_b_price"))        g_ExamBPrice = strval(val);
        else if(!strcmp(key, "exam_c_price"))        g_ExamCPrice = strval(val);
        else if(!strcmp(key, "exam_d_price"))        g_ExamDPrice = strval(val);
        else if(!strcmp(key, "exam_p_price"))        g_ExamPPrice = strval(val);
        else if(!strcmp(key, "exam_h_price"))        g_ExamHPrice = strval(val);
        else if(!strcmp(key, "pizza_price"))         g_PizzaPrice = strval(val);
        else if(!strcmp(key, "burger_price"))        g_BurgerPrice = strval(val);
        else if(!strcmp(key, "meal_price"))          g_MealPrice = strval(val);
        else if(!strcmp(key, "desert_price"))        g_DesertPrice = strval(val);
        else if(!strcmp(key, "farm_tractor_price"))  g_FarmTractorPrice = strval(val);
        else if(!strcmp(key, "farm_dozer_price"))    g_FarmDozerPrice = strval(val);
        else if(!strcmp(key, "farm_combine_price"))  g_FarmCombinePrice = strval(val);
        else if(!strcmp(key, "farm_truck_price"))    g_FarmTruckPrice = strval(val);
        else if(!strcmp(key, "farm_trailer_price"))  g_FarmTrailerPrice = strval(val);
        else if(!strcmp(key, "shovel_price"))        g_ShovelPrice = strval(val);
        else if(!strcmp(key, "phone_sim_price"))     g_PhoneSimPrice = strval(val);
        else if(!strcmp(key, "phone_price_1"))       g_PhonePrices[0] = strval(val);
        else if(!strcmp(key, "phone_price_2"))       g_PhonePrices[1] = strval(val);
        else if(!strcmp(key, "phone_price_3"))       g_PhonePrices[2] = strval(val);
        else if(!strcmp(key, "phone_price_4"))       g_PhonePrices[3] = strval(val);
        else if(!strcmp(key, "phone_price_5"))       g_PhonePrices[4] = strval(val);
        else if(!strcmp(key, "watch_price_1"))       g_WatchPrices[0] = strval(val);
        else if(!strcmp(key, "watch_price_2"))       g_WatchPrices[1] = strval(val);
        else if(!strcmp(key, "watch_price_3"))       g_WatchPrices[2] = strval(val);
        else if(!strcmp(key, "watch_price_4"))       g_WatchPrices[3] = strval(val);
        else if(!strcmp(key, "weapon_colt45_price"))  g_WeaponColt45Price = strval(val);
        else if(!strcmp(key, "weapon_deagle_price"))  g_WeaponDeaglePrice = strval(val);
        else if(!strcmp(key, "weapon_shotgun_price")) g_WeaponShotgunPrice = strval(val);
        else if(!strcmp(key, "weapon_mp5_price"))     g_WeaponMP5Price = strval(val);
        else if(!strcmp(key, "weapon_ak47_price"))    g_WeaponAK47Price = strval(val);
        else if(!strcmp(key, "weapon_m4_price"))      g_WeaponM4Price = strval(val);
        else if(!strcmp(key, "weapon_uzi_price"))     g_WeaponUziPrice = strval(val);
        else if(!strcmp(key, "phonebook_price"))     g_PhoneBookPrice = strval(val);
        else if(!strcmp(key, "flowers_price"))       g_FlowersPrice = strval(val);
        else if(!strcmp(key, "gps_price"))           g_GPSPrice = strval(val);
        else if(!strcmp(key, "sapling_price"))       g_SaplingPrice = strval(val);
        else if(!strcmp(key, "fishingrod_price"))    g_FishingRodPrice = strval(val);
        else if(!strcmp(key, "chainsaw_price"))      g_ChainsawPrice = strval(val);
        else if(!strcmp(key, "bag_price_small"))     g_BagPrice[1] = strval(val);
        else if(!strcmp(key, "bag_price_medium"))    g_BagPrice[2] = strval(val);
        else if(!strcmp(key, "bag_price_large"))     g_BagPrice[3] = strval(val);
        else if(!strcmp(key, "stat_train_rides"))    g_StatTrainRides = strval(val);
        else if(!strcmp(key, "stat_crop_crashes"))   g_StatCropCrashes = strval(val);
        else if(!strcmp(key, "stat_sgr_delivered"))  g_StatSGRDelivered = strval(val);
        else if(!strcmp(key, "manager_", false, 8))
        {
            for(new m = 0; m < MANAGER_COUNT; m++)
            {
                if(strcmp(key[8], g_ManagerKey[m]) != 0) continue;
                g_ManagerName[m][0] = EOS;
                cache_get_value_name(i, "ssText", g_ManagerName[m], sizeof(g_ManagerName[]));
                Manager_UpdateLabel(m);
            }
        }
    }
    printf("[Setari] PayDay: Salar minim $%d | Impozit %d%% | CASS %d%% | Dobanda %.2f%%",
        g_PDMinSalary, g_PDTax, g_PDCASS, g_PDInterest);
    printf("[Setari] Preturi: Asigurare $%d | Kit medical $%d | Extinctor $%d | ITP $%d | Nr. inmatriculare $%d | Bicicleta $%d | Examene A/B/C/D/P/H $%d/$%d/$%d/$%d/$%d/$%d | Pizza $%d | Burger $%d | Cluckin $%d | Desert $%d",
        g_InsurancePrice, g_MedkitPrice, g_ExtinguisherPrice, g_ITPPrice, g_PlatePrice, g_RentBikePrice, g_ExamAPrice, g_ExamBPrice, g_ExamCPrice, g_ExamDPrice, g_ExamPPrice, g_ExamHPrice, g_PizzaPrice, g_BurgerPrice, g_MealPrice, g_DesertPrice);
    printf("[Setari] Trezoreria statului: $%d", g_StateTreasury);
    printf("[Setari] Charity: \"%s\" - fond $%d", g_CharityCause, g_CharityFund);
    printf("[Setari] Temperatura orasului: %d C", g_CityTemperature);
    return 1;
}

// Resincronizeaza doar temperatura din server_setup (actualizata separat, din butonul UCP "Update Temperature")
stock City_LoadTemperature()
{
    mysql_tquery(g_SQL, "SELECT `ssValue` FROM `server_setup` WHERE `ssSetare`='temperature' LIMIT 1", "OnCityTemperatureLoaded");
}

forward OnCityTemperatureLoaded();
public OnCityTemperatureLoaded()
{
    if(cache_num_rows() == 0) return 1;
    new val[24];
    cache_get_value_name(0, "ssValue", val, sizeof(val));
    g_CityTemperature = strval(val);
    return 1;
}

