        default: return;
    }
    mysql_tquery(g_SQL, query, "", "", 0);
}

// ============================================================
//  TELEFONIE - LOGICA
// ============================================================
// Scrie marca telefonului playerului in out[] ("Telefon" daca nu are unul valid)
stock Phone_GetBrand(playerid, out[], len)
{
    new model = PlayerData[playerid][pPhoneModel];
    if(model < 0 || model >= PHONE_MODEL_COUNT) format(out, len, "Phone");
    else format(out, len, "%s", g_PhoneModels[model]);
}

stock bool:Phone_HasPhone(playerid)
    return (PlayerData[playerid][pPhoneModel] >= 0 && PlayerData[playerid][pPhoneModel] < PHONE_MODEL_COUNT);

// True daca telefonul detinut s-a stricat (expirat). Fara telefon = nu e stricat (Phone_HasPhone e cea care conteaza).
stock bool:Phone_IsBroken(playerid)
    return (PlayerData[playerid][pPhoneExpire] > 0 && gettime() >= PlayerData[playerid][pPhoneExpire]);

stock bool:Phone_HasSim(playerid)
    return (PlayerData[playerid][pPhoneNumber] > 0);

// Genereaza un numar aleatoriu de 7 cifre
stock Phone_RandomNumber()
    return PHONE_NUMBER_MIN + random(PHONE_NUMBER_MAX - PHONE_NUMBER_MIN + 1);

// Cota care merge in business-ul operatorului (50% din SMS/apel)
stock Phone_CarrierCut(amount)
    return floatround(amount * PHONE_CARRIER_CUT_PCT / 100.0);

// Gaseste playerul online (logat) care detine acest numar de telefon
stock Phone_FindByNumber(number)
{
    if(number <= 0) return INVALID_PLAYER_ID;
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
        if(PlayerData[i][pPhoneNumber] == number) return i;
    }
    return INVALID_PLAYER_ID;
}

// Deschide dialogul de cumparare telefon: SIM ca prima optiune, apoi cele 5 marci
stock Phone_ShowBuyDialog(playerid)
{
    new dlg[320], line[64];
    format(line, sizeof(line), "SIM (phone number)\t$%s\n", MoneyStr(g_PhoneSimPrice));
    strcat(dlg, line);
    for(new i = 0; i < PHONE_MODEL_COUNT; i++)
    {
        format(line, sizeof(line), "%s\t$%s\n", g_PhoneModels[i], MoneyStr(g_PhonePrices[i]));
        strcat(dlg, line);
    }
    SPD(playerid, DIALOG_PHONE_BUY, DIALOG_STYLE_TABLIST, "Phone Shop", dlg, "Select", "Back");
}

// ============================================================
//  CEAS (Watch) - LOGICA
// ============================================================
// Scrie marca ceasului playerului in out[] ("Watch" daca nu are unul valid)
stock Watch_GetBrand(playerid, out[], len)
{
    new model = PlayerData[playerid][pWatchModel];
    if(model < 0 || model >= WATCH_MODEL_COUNT) format(out, len, "Watch");
    else format(out, len, "%s", g_WatchModels[model]);
}

stock bool:Watch_HasWatch(playerid)
    return (PlayerData[playerid][pWatchModel] >= 0 && PlayerData[playerid][pWatchModel] < WATCH_MODEL_COUNT);

// True daca ceasul detinut s-a stricat (expirat). Fara ceas = nu e stricat (Watch_HasWatch e cea care conteaza).
stock bool:Watch_IsBroken(playerid)
    return (PlayerData[playerid][pWatchExpire] > 0 && gettime() >= PlayerData[playerid][pWatchExpire]);

// Anunta jucatorii din jur ca playerul s-a uitat la ceas - apelata de fiecare /watch [sub] si de /time.
// Apelantul trebuie sa fi verificat deja Watch_HasWatch/Watch_IsBroken.
stock Watch_AnnounceLook(playerid)
{
    new waWatchBrand[24];
    Watch_GetBrand(playerid, waWatchBrand, sizeof(waWatchBrand));
    new Float:wapx, Float:wapy, Float:wapz;
    GetPlayerPos(playerid, wapx, wapy, wapz);

    new waNearMsg[144];
    for(new wai = 0; wai < MAX_PLAYERS; wai++)
    {
        if(wai == playerid || !IsPlayerConnected(wai) || !PlayerData[wai][pLogged]) continue;
        if(IsPlayerInRangeOfPoint(wai, WATCH_RANGE, wapx, wapy, wapz))
        {
            format(waNearMsg, sizeof(waNearMsg), T(wai, C_INFO"[Watch] "C_WHITE"%s"C_WHITE" looked at their "C_INFO"%s"C_WHITE"."), PlayerData[playerid][pName], waWatchBrand);
            SCM(wai, COLOR_INFO, waNearMsg);
        }
    }
}

// /watch time [country] (si /time [country]): ora + data curenta, sau ora intr-o alta tara dupa GMT
stock Watch_ShowTime(playerid, const countryArg[])
{
    new tGmtOffset = g_WatchCountryGMT[0]; // implicit Romania (server-ul e in Romania, nu UK/GMT+0)
    new tCountryName[24];
    if(strlen(countryArg))
    {
        new tCidx = Watch_FindCountry(countryArg);
        if(tCidx == -1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Unknown country. Try Romania, UK, USA, Japan, etc."), 0;
        tGmtOffset = g_WatchCountryGMT[tCidx];
        format(tCountryName, sizeof(tCountryName), "%s", g_WatchCountry[tCidx]);
    }

    new tYear, tMonth, tDay, tHour, tMinute, tSecond;
    getdate(tYear, tMonth, tDay);
    gettime(tHour, tMinute, tSecond);

    // aplica offsetul de GMT (poate impinge ora peste miezul noptii, in ziua urmatoare/anterioara)
    new tTotalMinutes = tHour * 60 + tMinute + tGmtOffset * 60;
    new tDayShift = 0;
    while(tTotalMinutes < 0)        { tTotalMinutes += 1440; tDayShift--; }
    while(tTotalMinutes >= 1440)    { tTotalMinutes -= 1440; tDayShift++; }
    tHour = tTotalMinutes / 60;
    tMinute = tTotalMinutes % 60;

    if(tDayShift != 0)
    {
        // ajusteaza data cu +-1 zi (suficient pentru un offset de GMT normal, max +-1 zi)
        new const tDaysInMonth[12] = {31,28,31,30,31,30,31,31,30,31,30,31};
        new tDim = tDaysInMonth[tMonth - 1];
        if(tMonth == 2 && ((tYear % 4 == 0 && tYear % 100 != 0) || tYear % 400 == 0)) tDim = 29;

        tDay += tDayShift;
        if(tDay < 1)
        {
            tMonth--;
            if(tMonth < 1) { tMonth = 12; tYear--; }
            tDay = tDim;
        }
        else if(tDay > tDim)
        {
            tDay = 1;
            tMonth++;
            if(tMonth > 12) { tMonth = 1; tYear++; }
        }
    }

    new tMsg[144];
    if(strlen(tCountryName))
        format(tMsg, sizeof(tMsg), T(playerid, C_INFO"[Time - %s] "C_WHITE"Ora: "C_INFO"%02d:%02d"), tCountryName, tHour, tMinute);
    else
        format(tMsg, sizeof(tMsg), T(playerid, C_INFO"[Time] "C_WHITE"Ora: "C_INFO"%02d:%02d"), tHour, tMinute);
    SCM(playerid, COLOR_INFO, tMsg);

    format(tMsg, sizeof(tMsg), T(playerid, C_INFO"[Time] "C_WHITE"Data: "C_INFO"%02d.%02d.%d"), tDay, tMonth, tYear);
    SCM(playerid, COLOR_INFO, tMsg);

    if(PlayerData[playerid][pJailSeconds] > 0)
    {
        format(tMsg, sizeof(tMsg), T(playerid, C_INFO"[Time] "C_WHITE"Time left in jail: "C_INFO"%02d:%02d"),
            PlayerData[playerid][pJailSeconds] / 60, PlayerData[playerid][pJailSeconds] % 60);
        SCM(playerid, COLOR_INFO, tMsg);
    }

    Watch_AnnounceLook(playerid);
    return 1;
}

// /watch health: HP, oboseala, boala
stock Watch_ShowHealth(playerid)
{
    new Float:wHealth;
    GetPlayerHealth(playerid, wHealth);

    new wMsg[128];
    format(wMsg, sizeof(wMsg), T(playerid, C_INFO"[Watch] "C_WHITE"HP: "C_INFO"%d"C_WHITE", Tired: "C_INFO"%d/%d"C_WHITE", Sick: "C_INFO"%s"),
        floatround(wHealth), PlayerData[playerid][pTired], TIRED_MAX, PlayerData[playerid][pDiseased] ? "Yes" : "No");
    SCM(playerid, COLOR_INFO, wMsg);

    Watch_AnnounceLook(playerid);
}

// /watch temp: temperatura curenta a orasului (g_CityTemperature, actualizata din UCP / la fiecare payday)
stock Watch_ShowTemp(playerid)
{
    new wtMsg[96];
    format(wtMsg, sizeof(wtMsg), T(playerid, C_INFO"[Watch] "C_WHITE"City temperature: "C_INFO"%dC"), g_CityTemperature);
    SCM(playerid, COLOR_INFO, wtMsg);

    Watch_AnnounceLook(playerid);
}

// /watch status: marca, functional sau stricat, cate zile mai are pana expira
stock Watch_ShowStatus(playerid)
{
    new wsBrand[24];
    Watch_GetBrand(playerid, wsBrand, sizeof(wsBrand));

    new wsMsg[144];
    if(Watch_IsBroken(playerid))
        format(wsMsg, sizeof(wsMsg), T(playerid, C_ERROR"[Watch] "C_WHITE"Your "C_INFO"%s"C_WHITE" is "C_ERROR"broken"C_WHITE"."), wsBrand);
    else
    {
        new wsDaysLeft = (PlayerData[playerid][pWatchExpire] - gettime()) / 86400;
        if(wsDaysLeft < 0) wsDaysLeft = 0;
        format(wsMsg, sizeof(wsMsg), T(playerid, C_SUCCESS"[Watch] "C_WHITE"Your "C_INFO"%s"C_WHITE" is "C_SUCCESS"working"C_WHITE" ("C_INFO"%d"C_WHITE" days left)."), wsBrand, wsDaysLeft);
    }
    SCM(playerid, COLOR_INFO, wsMsg);

    Watch_AnnounceLook(playerid);
}

// Deschide dialogul de cumparare ceas: cele 4 marci
stock Watch_ShowBuyDialog(playerid)
