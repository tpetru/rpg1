// ============================================================
//  BOLI (Diseases)
// ============================================================
forward Disease_FinishCure(playerid);

// Imbolnaveste un player: marcheaza starea, o salveaza in DB, aplica efectul vizual (drunk level) si il anunta
stock Disease_Infect(playerid)
{
    PlayerData[playerid][pDiseased]       = true;
    PlayerData[playerid][pDiseasePaydays] = 0;
    UpdatePlayer(playerid, pDiseased);
    UpdatePlayer(playerid, pDiseasePaydays);

    SetPlayerDrunkLevel(playerid, DISEASE_DRUNK_LEVEL);

    SCM(playerid, COLOR_ERROR,
        C_ERROR"Error: "C_WHITE"You got sick! You need to go to the SMURD hospital and use "C_INFO"/curedisease"C_WHITE" to recover.");
}

// Vindeca un player: reseteaza starea, o salveaza in DB si scoate efectul vizual
stock Disease_Cure(playerid)
{
    PlayerData[playerid][pDiseased]       = false;
    PlayerData[playerid][pDiseasePaydays] = 0;
    UpdatePlayer(playerid, pDiseased);
    UpdatePlayer(playerid, pDiseasePaydays);

    SetPlayerDrunkLevel(playerid, 0);
}

// Apelata de timer-ul pornit de /curedisease, dupa cele 10 secunde de freeze
public Disease_FinishCure(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    TogglePlayerControllable(playerid, 1);
    Disease_Cure(playerid);

    SCM(playerid, COLOR_SUCCESS,
        C_SUCCESS"Success: "C_WHITE"You have been treated and are now healthy again.");
    return 1;
}

stock PayDay_Apply()
{
    new hour, minute, second;
    gettime(hour, minute, second);
    printf("[PayDay] Distribuit la %02d:00.", hour);

    SetWorldTime(hour); // sincronizeaza time-of-day-ul din joc cu ora reala curenta
    City_LoadTemperature(); // resincronizeaza temperatura orasului din server_setup (actualizata separat din UCP)

    Caravan_CheckCampingExpiry();
    Caravans_RebuildAll();

    Business_ANAFProcessDocs();          // deblocheaza business-urile ale caror acte au fost duse la ANAF
    if(hour == 12) Business_ANAFPick();  // o data pe zi, la ora 12:00, blocheaza un business random
    if(hour == HOUSE_ISSUE_HOUR) House_PickIssue(); // o data pe zi, la ora 22:00, da o problema unui apartament random

    // La fiecare payday: imbatraneste/omoara animalele (doar cele cu proprietarul online), apoi
    // sterge toti actorii-animale si recreeaza-i din DB (re-randomizeaza pozitiile)
    Animals_PayDayAge();
    Animals_Load();

    // Tomberoane: adauga random (0-20) SGR-uri in fiecare tomberon nefull
    Bins_PayDayRefill();

    new treasuryGain = 0; // acumuleaza tax+cass+taxele pe proprietati ale tuturor playerilor din acest tick

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;

        // Biletul de gondola expira dupa UPDOWN_TICKET_PAYDAYS payday-uri
        if(g_HasGondolaTicket[i])
        {
            g_GondolaTicketPaydaysLeft[i]--;
            if(g_GondolaTicketPaydaysLeft[i] <= 0) TeleGondola_ClearTicket(i);
        }

        new level    = PlayerData[i][pLevel];
        new salary   = g_PDMinSalary + 1000 * level + random(1500);
        new vipSalaryBonus = 0;
        if(PlayerData[i][pVIP]) { vipSalaryBonus = salary / 10; salary += vipSalaryBonus; } // VIP: +10% salariu

        new Float:interestRate = g_PDInterest;
        if(PlayerData[i][pVIP]) interestRate += 0.01; // VIP: +0.01% dobanda

        new tax      = salary * g_PDTax  / 100;
        new cass     = salary * g_PDCASS / 100;
        new interest = floatround(float(PlayerData[i][pBank]) * interestRate / 100.0);
        if(interest > BANK_INTEREST_CAP) interest = BANK_INTEREST_CAP; // plafon dobanda

        // --- Taxe pe proprietati ---
        new Float:carTaxF = 0.0;
        for(new v = 0; v < g_PVehicleCount; v++)
            if(PVehicleData[v][pvOwnerId] == PlayerData[i][pID])
                carTaxF += PVehicleData[v][pvPrice] * 0.00001; // 10$ la 1.000.000

        new Float:houseTaxF = 0.0;
        if(PlayerData[i][pHouse] != 0)
        {
            new hidx = Houses_FindByID(PlayerData[i][pHouse]);
            if(hidx != -1) houseTaxF = HouseData[hidx][hDefaultPrice] * 0.0001; // 100$ la 1.000.000 din pretul initial (hDefaultPrice), nu din hPrice curent
        }

        new Float:bizTaxF = 0.0;
        for(new b = 0; b < g_BusinessCount; b++)
            if(BusinessData[b][bOwnerId] == PlayerData[i][pID])
                bizTaxF += BusinessData[b][bDefaultPrice] * 0.00025; // 250$ la 1.000.000 din pretul initial (bDefaultPrice), nu din bPrice curent

        new Float:farmTaxF = 0.0;
        for(new f = 0; f < g_FarmCount; f++)
            if(FarmData[f][fmOwnerId] == PlayerData[i][pID])
            {
                farmTaxF += FarmData[f][fmDefaultPrice] * 0.00035; // 350$ la 1.000.000 din pretul initial (fmDefaultPrice), nu din fmPrice curent
                farmTaxF += FarmData[f][fmTractors] * 90.0   // taxa utilaje: 90$/tractor
                          + FarmData[f][fmDozers]   * 100.0  // 100$/buldozer
                          + FarmData[f][fmCombines] * 125.0  // 125$/combina
                          + FarmData[f][fmTrucks]   * 50.0   // 50$/camion
                          + FarmData[f][fmTrailers] * 20.0;  // 20$/remorca
            }

        new Float:htlTaxF = 0.0;
        for(new ht = 0; ht < g_HotelCount; ht++)
            if(HotelData[ht][htlOwnerId] == PlayerData[i][pID])
                htlTaxF += HotelData[ht][htlPrice] * 0.0001; // 100$ la 1.000.000 din pretul curent (htlPrice; nu exista default_price la hoteluri)

        new Float:forestTaxF = 0.0;
        if(PlayerData[i][pForestKey] != 0)
        {
            new forestTaxIdx = Forest_IndexByID(PlayerData[i][pForestKey]);
            if(forestTaxIdx != -1) forestTaxF = ForestData[forestTaxIdx][fstDefaultPrice] * 0.00015; // 150$ la 1.000.000 din fstDefaultPrice
        }

        new Float:bbTaxF = 0.0;
        if(PlayerData[i][pBBKey] != 0)
        {
            new bbTaxIdx = -1;
            for(new bb = 0; bb < g_BillboardCount; bb++)
                if(BillboardData[bb][bbID] == PlayerData[i][pBBKey]) { bbTaxIdx = bb; break; }
            if(bbTaxIdx != -1) bbTaxF = BillboardData[bbTaxIdx][bbDefaultPrice] * (100.0 / 15000000.0); // 100$ la 15.000.000 din bbDefaultPrice
        }

        new carTax    = floatround(carTaxF);
        new houseTax  = floatround(houseTaxF);
        new bizTax    = floatround(bizTaxF);
        new farmTax   = floatround(farmTaxF);
        new htlTax    = floatround(htlTaxF);
        new forestTax = floatround(forestTaxF);
        new bbTax     = floatround(bbTaxF);
        new propTax   = carTax + houseTax + bizTax + farmTax + htlTax + forestTax + bbTax;

        treasuryGain += tax + cass + propTax; // trezoreria statului incaseaza tot ce plateste playerul in impozite

        new net      = salary - tax - cass - propTax;

        PlayerData[i][pMoney] += net;
        PlayerData[i][pBank]  += interest;

        // VIP: 2RP in loc de 1 la ora para (00, 02, 04...), sau 2 rob points in loc de 1 la ora impara
        new rpGain = 1, robGain = 1;
        if(PlayerData[i][pVIP])
        {
            if(hour % 2 == 0) rpGain = 2;
            else robGain = 2;
        }
        PlayerData[i][pRP] += rpGain;
        if(PlayerData[i][pRobPoints] < ROB_POINTS_MAX)
        {
            PlayerData[i][pRobPoints] += robGain;
            if(PlayerData[i][pRobPoints] > ROB_POINTS_MAX) PlayerData[i][pRobPoints] = ROB_POINTS_MAX;
        }

        GivePlayerMoney(i, net);
        GTP(i, "~g~Payday", 3000, 1);

        new total = net + interest; // diferenta totala in avere (cash + banca)

        new msg[320];
        SCM(i, COLOR_INFO, C_INFO"========== PayDay ==========");

        // Un singur cod de culoare per linie (in loc de unul per valoare) - mult mai putine caractere
        // consumate de codurile {RRGGBB}, ca sa incapa toate datele in limita de afisare a SendClientMessage.
        if(vipSalaryBonus > 0)
            format(msg, sizeof(msg), T(i, C_WHITE"Income: "C_SUCCESS"Salary: $%s (+$%s VIP), Interest: $%s"),
                MoneyStr(salary), MoneyStr(vipSalaryBonus), MoneyStr(interest));
        else
            format(msg, sizeof(msg), T(i, C_WHITE"Income: "C_SUCCESS"Salary: $%s, Interest: $%s"),
                MoneyStr(salary), MoneyStr(interest));
        SCM(i, COLOR_WHITE, msg);

        format(msg, sizeof(msg), T(i, C_WHITE"Outcome: "C_ERROR"CASS: $%s, Tax: $%s, Veh: $%s, House: $%s, Biz: $%s, Farm: $%s, Hotel: $%s, Forest: $%s, Billboard: $%s"),
            MoneyStr(cass), MoneyStr(tax), MoneyStr(carTax), MoneyStr(houseTax), MoneyStr(bizTax), MoneyStr(farmTax), MoneyStr(htlTax), MoneyStr(forestTax), MoneyStr(bbTax));
        SCM(i, COLOR_WHITE, msg);

        if(total >= 0)
            format(msg, sizeof(msg), T(i, C_WHITE"Total: "C_SUCCESS"+$%s"), MoneyStr(total));
        else
            format(msg, sizeof(msg), T(i, C_WHITE"Total: "C_ERROR"-$%s"), MoneyStr(-total));
        SCM(i, COLOR_WHITE, msg);

        if(PlayerData[i][pDiseased])
        {
            PlayerData[i][pDiseasePaydays]++;
            if(PlayerData[i][pDiseasePaydays] >= DISEASE_CURE_PAYDAYS)
            {
                Disease_Cure(i);
                SCM(i, COLOR_SUCCESS,
                    C_SUCCESS"Success: "C_WHITE"Your illness has run its course. You have recovered.");
            }
            else
            {
                UpdatePlayer(i, pDiseasePaydays);
            }
        }

        // Chirie hotel: chiriasul plateste direct in banca hotelului (fiecare hotel poate avea mai multi chiriasi simultan, cf. htlCapacity)
        if(PlayerData[i][pRentHotel] != 0)
        {
            new rentHtlIdx = Hotels_FindByID(PlayerData[i][pRentHotel]);
            if(rentHtlIdx != -1 && HotelData[rentHtlIdx][htlRentPrice] > 0)
            {
                new rentHtlAmt = HotelData[rentHtlIdx][htlRentPrice];
                if(PlayerData[i][pMoney] >= rentHtlAmt)
                {
                    PlayerData[i][pMoney] -= rentHtlAmt;
                    GivePlayerMoney(i, -rentHtlAmt);
                }
                else
                {
                    PlayerData[i][pBank] -= rentHtlAmt;
                }
                UpdatePlayer(i, pMoney);
                UpdatePlayer(i, pBank);
                if(HotelData[rentHtlIdx][htlItems] > 0) HotelData[rentHtlIdx][htlBank] += rentHtlAmt; // fara iteme de igiena, seiful nu mai primeste bani

                new renthtlmsg[144];
                format(renthtlmsg, sizeof(renthtlmsg), T(i, C_ERROR"Outcome: "C_WHITE"Rent paid: "C_ERROR"-$%s"C_WHITE" (hotel "C_INFO"%s"C_WHITE")"),
                    MoneyStr(rentHtlAmt), HotelData[rentHtlIdx][htlName]);
                SCM(i, COLOR_WHITE, renthtlmsg);

                new rhtbq[128];
                mysql_format(g_SQL, rhtbq, sizeof(rhtbq), "UPDATE `hotels` SET `bank`=%d WHERE `id`=%d", HotelData[rentHtlIdx][htlBank], HotelData[rentHtlIdx][htlID]);
                mysql_tquery(g_SQL, rhtbq, "", "", 0);
            }
        }

        // Vaca la casa: sansa la payday sa produca lapte, adaugat in frigider (daca exista si e functional)
        if(PlayerData[i][pHouse] != 0 && random(100) < ANIMAL_COW_MILK_CHANCE_PCT)
        {
            new mhidx = Houses_FindByID(PlayerData[i][pHouse]);
            if(mhidx != -1 && HouseData[mhidx][hHasFridge] && !Houses_FridgeBroken(mhidx) && House_HasCow(HouseData[mhidx][hID]))
            {
                new milkAmt = ANIMAL_COW_MILK_MIN + random(ANIMAL_COW_MILK_MAX - ANIMAL_COW_MILK_MIN + 1);
                new space = g_FridgeMax[0] - HouseData[mhidx][hFridge][0];
                if(space < 0) space = 0;
                if(milkAmt > space) milkAmt = space;

                if(milkAmt > 0)
                {
                    HouseData[mhidx][hFridge][0] += milkAmt;
                    Houses_SaveFridge(mhidx);

                    new cowmsg[144];
                    format(cowmsg, sizeof(cowmsg), T(i, C_SUCCESS"[Farm] "C_WHITE"Your cow produced "C_INFO"%dL"C_WHITE" of milk! It's now in your fridge ("C_INFO"%d/%d"C_WHITE")."),
                        milkAmt, HouseData[mhidx][hFridge][0], g_FridgeMax[0]);
                    SCM(i, COLOR_SUCCESS, cowmsg);
                }
            }
        }

        // Reseteaza plafonul de pariat la cazino pentru noul ciclu de payday
        PlayerData[i][pGambleWagered] = 0;

        // Reseteaza calatoria cu trenul (o singura data per payday)
        g_TrainUsedThisPayday[i] = false;

        // Reseteaza cursa cu taxiul (o singura data per payday)
        g_TaxiUsedThisPayday[i] = false;

        // Reseteaza taiatul de lemne (o singura data per payday)
        g_ChopUsedThisPayday[i] = false;

        FullUpdatePlayer(i);
    }

    // Trezoreria statului: incaseaza tot ce s-a colectat din impozite in acest tick
    if(treasuryGain > 0)
    {
        g_StateTreasury += treasuryGain;
        Treasury_Save();
    }

    // Chirii: fiecare casa/apartament inchiriat ia chiria de la chirias (daca e online) + un bonus fix, in banca proprietatii
    for(new h = 0; h < g_HouseCount; h++)
    {
        if(HouseData[h][hRenterId] == 0) continue;
        if(House_HasDeceasedAnimal(HouseData[h][hID])) continue; // animal mort la casa -> nu se incaseaza chirie deloc

        new rentTenant = Houses_FindPlayerByPID(HouseData[h][hRenterId]);
        if(rentTenant != INVALID_PLAYER_ID && HouseData[h][hRentPrice] > 0)
        {
            new rentAmt = HouseData[h][hRentPrice];
            if(PlayerData[rentTenant][pMoney] >= rentAmt)
            {
                PlayerData[rentTenant][pMoney] -= rentAmt;
                GivePlayerMoney(rentTenant, -rentAmt);
            }
            else
            {
                PlayerData[rentTenant][pBank] -= rentAmt;
            }
            UpdatePlayer(rentTenant, pMoney);
            UpdatePlayer(rentTenant, pBank);
            HouseData[h][hBank] += rentAmt;

            new rentmsg[144];
            format(rentmsg, sizeof(rentmsg), T(rentTenant, C_ERROR"Outcome: "C_WHITE"Rent paid: "C_ERROR"-$%s"C_WHITE" (house "C_INFO"%s"C_WHITE")"),
                MoneyStr(rentAmt), HouseData[h][hName]);
            SCM(rentTenant, COLOR_WHITE, rentmsg);
        }

        HouseData[h][hBank] += HOUSE_RENT_BONUS;
        new rhbq[128];
        mysql_format(g_SQL, rhbq, sizeof(rhbq), "UPDATE `houses` SET `bank`=%d WHERE `id`=%d", HouseData[h][hBank], HouseData[h][hID]);
        mysql_tquery(g_SQL, rhbq, "", "", 0);
    }

    // Bonus fix in banca fiecarui hotel inchiriat (chiria per-chirias e platita mai sus, in bucla de playeri)
    for(new ht = 0; ht < g_HotelCount; ht++)
    {
        if(HotelData[ht][htlRenterCount] == 0) continue;
        if(HotelData[ht][htlItems] <= 0) continue; // fara iteme de igiena, seiful nu mai primeste bani

        HotelData[ht][htlBank] += HOTEL_RENT_BONUS;
        new rhtbq[128];
        mysql_format(g_SQL, rhtbq, sizeof(rhtbq), "UPDATE `hotels` SET `bank`=%d WHERE `id`=%d", HotelData[ht][htlBank], HotelData[ht][htlID]);
        mysql_tquery(g_SQL, rhtbq, "", "", 0);
    }

    Trees_PayDayGrow(); // copaci plantati: treeFruitStatus += 1 (plafonat la TREE_GROWTH_MAX), indiferent daca proprietarul e online

    RoadWork_PayDayTick(); // santier /roadworking: scade payday-urile ramase, inchide zona cand ajunge la 0
    Forests_PayDayGrow();  // paduri: currentTree += 10, plafonat la maxTree
    Billboard_PayDayTick(); // billboard-uri: scade chiria ramasa, expira la 0, termina curatarea in curs

    // Venit din teritorii pentru mafii (factiunile 4-7): 100$ per teritoriu detinut, in banca factiunii
    for(new fid = MAFIA_FID_MIN; fid <= MAFIA_FID_MAX; fid++)
    {
        new turfCount = 0;
        for(new t = 0; t < g_TurfCount; t++)
            if(TurfData[t][tFactionID] == fid) turfCount++;

        if(turfCount > 0)
        {
            new turfIncome = 100 * turfCount;
            Faction_AddBank(fid, turfIncome);

            new tmsg[144];
            format(tmsg, sizeof(tmsg), C_SUCCESS"[Faction] "C_WHITE"Territory income: "C_SUCCESS"+$%s"C_WHITE" (%d territories) added to the faction bank.",
                MoneyStr(turfIncome), turfCount);
            // doar membrii cu rank 4+ primesc anuntul
            for(new p = 0; p < MAX_PLAYERS; p++)
                if(IsPlayerConnected(p) && PlayerData[p][pLogged] && PlayerData[p][pFaction] == fid && PlayerData[p][pFactionRank] >= 4)
                    {
                        format(tmsg, sizeof(tmsg), T(p, C_SUCCESS"[Faction] "C_WHITE"Territory income: "C_SUCCESS"+$%s"C_WHITE" (%d territories) added to the faction bank."), MoneyStr(turfIncome), turfCount);
                        SCM(p, COLOR_SUCCESS, tmsg);
                    }
        }
    }
}

public PayDay_Check()
{
    new hour, minute, second;
    gettime(hour, minute, second);
    if(minute == 0 && hour != g_LastPayDayHour)
    {
        g_LastPayDayHour = hour;
        PayDay_Apply();
        if(hour == 0) Newspaper_ResetAll(); // reset ziare la miezul noptii
        if(hour == 0) Vehicle_CheckUnusedDaily(); // recalculeaza vUnusedVeh la miezul noptii
        if(hour == 0) Pray_WeeklyReset(); // luni la 00:00: goleste tabelul `pacate`
        if(hour == 0) Quest_WeeklyReset(); // luni la 00:00: goleste tabelul `quests`
        if(hour == 5) Player_ResetDailyCoffee(); // reseteaza pCoffee la 0 pentru toti playerii online
        if(hour == 5) VFaction_DailyRefresh(); // reseteaza jantele expirate si respawneaza vehiculele de factiune, fara tuning
    }
}

// La 5:00 (payday): reseteaza coffee la 0 pentru TOTI playerii din DB (online si offline deopotriva)
stock Player_ResetDailyCoffee()
{
    mysql_tquery(g_SQL, "UPDATE `players` SET `coffee`=0", "", "", 0);

    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i) && PlayerData[i][pLogged])
            PlayerData[i][pCoffee] = 0; // sincronizeaza si copia din memorie a celor online, ca sa nu ramana desincronizata pana la urmatorul login
}

// ============================================================
//  PRESEDINTE (alegeri saptamanale prin vot)
// ============================================================
// getdate() nu returneaza ziua saptamanii, deci o calculam din y/m/d (congruenta lui Zeller).
// Returneaza 0 = Duminica, 1 = Luni, ... 6 = Sambata.
stock DayOfWeek(year, month, day)
{
    if(month < 3) { month += 12; year -= 1; }
    new k = year % 100;
    new j = year / 100;
    // h: 0 = Sambata, 1 = Duminica, ...  (-2*j mod 7 == +5*j mod 7, evitam negativele)
    new h = (day + (13 * (month + 1)) / 5 + k + k / 4 + j / 4 + 5 * j) % 7;
    return (h + 6) % 7; // remapeaza la 0 = Duminica
}

// ============================================================
//  PACATE (/pray) - sistem religios saptamanal
// ============================================================
// Numarul saptamanii din anul curent (simplu, nu ISO-8601 - nu conteaza, tabelul se goleste in fiecare Luni)
stock Pray_GetWeekNumber()
{
    new year, month, day;
    getdate(year, month, day);
    new dayOfYear = DaysFromCivil(year, month, day) - DaysFromCivil(year, 1, 1) + 1;
    return ((dayOfYear - 1) / 7) + 1;
}

// Luni la 00:00 (PayDay_Check): goleste complet tabelul `pacate` (saptamana noua, pacate noi)
stock Pray_WeeklyReset()
{
    new year, month, day;
    getdate(year, month, day);
    if(DayOfWeek(year, month, day) != 1) return; // doar Luni

    mysql_tquery(g_SQL, "TRUNCATE TABLE `pacate`", "", "", 0);
}

// Marcheaza (idempotent) un pacat (1-11) pt saptamana curenta a jucatorului - independent de /pray.
// Creeaza randul in `pacate` daca nu exista inca (cu prayedTimes=0), sau doar seteaza pacatN=1 daca exista deja.
stock Pray_SetSin(playerid, sinNumber, value)
{
    if(!PlayerData[playerid][pLogged]) return;
    if(sinNumber < 1 || sinNumber > 12) return;

    new week = Pray_GetWeekNumber();
    new q[256];
    mysql_format(g_SQL, q, sizeof(q),
        "INSERT INTO `pacate` (`pID`,`weekNo`,`prayedTimes`,`pacat%d`) VALUES (%d,%d,0,%d) ON DUPLICATE KEY UPDATE `pacat%d`=%d",
        sinNumber, PlayerData[playerid][pID], week, value, sinNumber, value);
    mysql_tquery(g_SQL, q, "", "", 0);
}

// Marcheaza (idempotent) un pacat (1-12) pt saptamana curenta a jucatorului - independent de /pray.
stock Pray_FlagSin(playerid, sinNumber)
{
    Pray_SetSin(playerid, sinNumber, 1);
}

// Anuleaza un pacat "in absenta" (ex: pacat4 - Anti-natura, default vinovat pana la dovada faptei bune)
stock Pray_ClearSin(playerid, sinNumber)
{
    Pray_SetSin(playerid, sinNumber, 0);
}

// Marcheaza un pacat pt toti PASAGERII (nu soferul) unui vehicul - folosit la pacat7 (/tune Loco Outlaw Customs)
stock Pray_FlagPassengers(vehicleid, sinNumber)
{
    for(new p = 0; p < MAX_PLAYERS; p++)
    {
        if(!IsPlayerConnected(p) || !PlayerData[p][pLogged]) continue;
        if(GetPlayerVehicleID(p) != vehicleid) continue;
        if(GetPlayerVehicleSeat(p) == 0) continue; // soferul nu e "martor", el a facut tuning-ul

        Pray_FlagSin(p, sinNumber);
    }
}

// True Miercuri sau Vineri (zile de post) - folosit pt pacat11 (mancat de carne)
stock bool:Pray_IsFastingDay()
{
    new year, month, day;
    getdate(year, month, day);
    new dow = DayOfWeek(year, month, day);
    return (dow == 3 || dow == 5);
}

// ============================================================
//  PACATE - panoul de selectie (textdraw-uri per-player, duminica la /pray)
// ------------------------------------------------------------
//  [0]     = fundalul panoului (nu e selectabil)
//  [1..12] = cele 12 pacate, in ordinea pacat1..pacat12 din tabela `pacate`
//  [13]    = butonul de confirmare
// ============================================================
#define PACATE_COLOR_IDLE      -1           // alb - pacat neselectat
#define PACATE_COLOR_SELECTED  1804477439   // verde - pacat selectat pentru iertare
#define PRAY_WAIT_BASE         5            // secunde de asteptare, la care se adauga cate una per pacat marturisit
#define PRAY_REWARD_CLOSE      25000        // bani primiti daca a gresit exact 1 pacat
#define PRAY_REWARD_EXACT      50000        // bani primiti daca le-a nimerit pe toate
#define PRAY_MIN_TIMES         4            // de cate ori trebuie sa se fi rugat saptamana asta ca sa primeasca ceva
#define PRAY_BONUS_PER_PRAY    5000         // bonus per rugaciune (+ random(1000))

new PlayerText:PacateTextdraw[MAX_PLAYERS][14];
new bool:g_PacateShown[MAX_PLAYERS];
new bool:g_PacateSelected[MAX_PLAYERS][12]; // ce pacate a bifat jucatorul in panou
new g_PrayWaitTimer[MAX_PLAYERS] = {-1, ...}; // timerul de asteptare dupa "cere iertare"

// Numele celor 12 pacate (ordinea = pacat1..pacat12). Vezi si /sinlist pentru descrierile lungi.
new const g_SinName[12][44] = {
    "Defying the Law",
    "Greed for Money",
    "The Vice of Gambling",
    "Anti-Nature",
    "Trafficking Without Restraint",
    "Bloody Revenge",
    "Witness to Illegal Vehicle Modifications",
    "Reckless Speeding",
    "Time Served Behind Bars",
    "Drink and Vice",
    "Breaking the Fast",
    "Disregard for Road Law"
};

stock Pacate_CreateTextdraws(playerid)
{
    // fundalul panoului
    PacateTextdraw[playerid][0] = CreatePlayerTextDraw(playerid, 319.000, 81.000, "+");
    PlayerTextDrawLetterSize(playerid, PacateTextdraw[playerid][0], 1.728, 22.799);
    PlayerTextDrawTextSize(playerid, PacateTextdraw[playerid][0], 200.000, 450.000);
    PlayerTextDrawAlignment(playerid, PacateTextdraw[playerid][0], 2);
    PlayerTextDrawColor(playerid, PacateTextdraw[playerid][0], -1);
    PlayerTextDrawUseBox(playerid, PacateTextdraw[playerid][0], 1);
    PlayerTextDrawBoxColor(playerid, PacateTextdraw[playerid][0], 150);
    PlayerTextDrawSetShadow(playerid, PacateTextdraw[playerid][0], 0);
    PlayerTextDrawSetOutline(playerid, PacateTextdraw[playerid][0], 0);
    PlayerTextDrawBackgroundColor(playerid, PacateTextdraw[playerid][0], -10270721);
    PlayerTextDrawFont(playerid, PacateTextdraw[playerid][0], 3);
    PlayerTextDrawSetProportional(playerid, PacateTextdraw[playerid][0], 1);

    // cele 12 randuri de pacate - identice, doar Y difera (103, 116, 129, ... din 13 in 13)
    for(new i = 1; i <= 12; i++)
    {
        PacateTextdraw[playerid][i] = CreatePlayerTextDraw(playerid, 319.000, 103.000 + 13.000 * float(i - 1), "nume pacat nume pacat nume pacat");
        PlayerTextDrawLetterSize(playerid, PacateTextdraw[playerid][i], 0.180, 1.000);
        PlayerTextDrawTextSize(playerid, PacateTextdraw[playerid][i], 10.000, 399.000);
        PlayerTextDrawAlignment(playerid, PacateTextdraw[playerid][i], 2);
        PlayerTextDrawColor(playerid, PacateTextdraw[playerid][i], -1);
        PlayerTextDrawUseBox(playerid, PacateTextdraw[playerid][i], 1);
        PlayerTextDrawBoxColor(playerid, PacateTextdraw[playerid][i], 150);
        PlayerTextDrawSetShadow(playerid, PacateTextdraw[playerid][i], 0);
        PlayerTextDrawSetOutline(playerid, PacateTextdraw[playerid][i], 0);
        PlayerTextDrawBackgroundColor(playerid, PacateTextdraw[playerid][i], 150);
        PlayerTextDrawFont(playerid, PacateTextdraw[playerid][i], 1);
        PlayerTextDrawSetProportional(playerid, PacateTextdraw[playerid][i], 1);
        PlayerTextDrawSetSelectable(playerid, PacateTextdraw[playerid][i], 1);
    }

    // butonul de confirmare
    PacateTextdraw[playerid][13] = CreatePlayerTextDraw(playerid, 319.000, 260.000, "CERE IERTARE");
    PlayerTextDrawLetterSize(playerid, PacateTextdraw[playerid][13], 0.409, 2.498);
    PlayerTextDrawTextSize(playerid, PacateTextdraw[playerid][13], 20.000, 150.000);
    PlayerTextDrawAlignment(playerid, PacateTextdraw[playerid][13], 2);
    PlayerTextDrawColor(playerid, PacateTextdraw[playerid][13], -1);
    PlayerTextDrawUseBox(playerid, PacateTextdraw[playerid][13], 1);
    PlayerTextDrawBoxColor(playerid, PacateTextdraw[playerid][13], 150);
    PlayerTextDrawSetShadow(playerid, PacateTextdraw[playerid][13], 0);
    PlayerTextDrawSetOutline(playerid, PacateTextdraw[playerid][13], 0);
    PlayerTextDrawBackgroundColor(playerid, PacateTextdraw[playerid][13], 150);
    PlayerTextDrawFont(playerid, PacateTextdraw[playerid][13], 1);
    PlayerTextDrawSetProportional(playerid, PacateTextdraw[playerid][13], 1);
    PlayerTextDrawSetSelectable(playerid, PacateTextdraw[playerid][13], 1);

    g_PacateShown[playerid] = false;
}

stock Pacate_DestroyTextdraws(playerid)
{
    for(new i = 0; i < 14; i++)
    {
        if(PacateTextdraw[playerid][i] != PlayerText:INVALID_TEXT_DRAW)
        {
            PlayerTextDrawDestroy(playerid, PacateTextdraw[playerid][i]);
            PacateTextdraw[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
        }
    }
    g_PacateShown[playerid] = false;
}

// Completeaza numele pacatelor, afiseaza panoul si intra in modul de selectie
stock Pacate_Show(playerid)
{
    // au fost distruse la ultima confesiune -> le refacem
    if(PacateTextdraw[playerid][0] == PlayerText:INVALID_TEXT_DRAW)
        Pacate_CreateTextdraws(playerid);

    new sinLine[64];
    for(new i = 1; i <= 12; i++)
    {
        g_PacateSelected[playerid][i - 1] = false;

        format(sinLine, sizeof(sinLine), "%d. %s", i, T(playerid, g_SinName[i - 1]));
        PlayerTextDrawSetString(playerid, PacateTextdraw[playerid][i], sinLine);
        PlayerTextDrawColor(playerid, PacateTextdraw[playerid][i], PACATE_COLOR_IDLE);
    }

    PlayerTextDrawSetString(playerid, PacateTextdraw[playerid][13], T(playerid, "ASK FORGIVENESS"));

    for(new i = 0; i < 14; i++)
        PlayerTextDrawShow(playerid, PacateTextdraw[playerid][i]);

    g_PacateShown[playerid] = true;
    SelectTextDraw(playerid, 0xA06A9AFF); // culoarea la hover
    return 1;
}

stock Pacate_Hide(playerid)
{
    if(!g_PacateShown[playerid]) return 0;

    for(new i = 0; i < 14; i++)
    {
        if(PacateTextdraw[playerid][i] != PlayerText:INVALID_TEXT_DRAW)
            PlayerTextDrawHide(playerid, PacateTextdraw[playerid][i]);
    }

    g_PacateShown[playerid] = false;
    CancelSelectTextDraw(playerid);
    return 1;
}

// Trimite lista pacatelor bifate, inchide panoul si tine jucatorul blocat cat se "roaga parintele"
stock Pacate_Confess(playerid)
{
    new count = 0;
    for(new i = 0; i < 12; i++) if(g_PacateSelected[playerid][i]) count++;

    if(count == 0)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Select at least one sin to confess."), 0;

    SCM(playerid, COLOR_INFO, "[Pray] You asked for forgiveness for the following sins. The priest is praying and you will receive your answer in the next few seconds...");

    new line[96];
    for(new i = 1; i <= 12; i++)
    {
        if(!g_PacateSelected[playerid][i - 1]) continue;

        format(line, sizeof(line), C_INFO"[%d] "C_WHITE"%s.", i, T(playerid, g_SinName[i - 1])); // nolang (doar numarul + numele tradus)
        SCM(playerid, COLOR_WHITE, line);
    }

    // panoul si-a facut treaba - il inchidem si il distrugem
    if(g_PacateShown[playerid]) CancelSelectTextDraw(playerid);
    g_PacateShown[playerid] = false;
    Pacate_DestroyTextdraws(playerid);

    // rugaciunea dureaza PRAY_WAIT_BASE secunde + cate o secunda per pacat marturisit
    new waitMs = (PRAY_WAIT_BASE + count) * 1000;

    if(g_PrayWaitTimer[playerid] != -1) KillTimer(g_PrayWaitTimer[playerid]);

    TogglePlayerControllable(playerid, 0);
    GTP(playerid, "~w~The priest is praying...", waitMs, 3);
    g_PrayWaitTimer[playerid] = SetTimerEx("Pray_WaitFinish", waitMs, false, "i", playerid);
    return 1;
}

// Curata (dirty = 0) toate vehiculele personale ale jucatorului
stock Pray_CleanVehicles(playerid)
{
    new q[96];
    for(new v = 0; v < g_PVehicleCount; v++)
    {
        if(PVehicleData[v][pvOwnerId] != PlayerData[playerid][pID]) continue;

        PVehicleData[v][pvDirty] = 0;
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `dirty`=0 WHERE `id`=%d", PVehicleData[v][pvID]);
        mysql_tquery(g_SQL, q, "", "", 0);
    }
}

// Umple rezervorul (fuel = 100) la toate vehiculele personale ale jucatorului
stock Pray_RefuelVehicles(playerid)
{
    new q[96];
    for(new v = 0; v < g_PVehicleCount; v++)
    {
        if(PVehicleData[v][pvOwnerId] != PlayerData[playerid][pID]) continue;

        PVehicleData[v][pvFuel] = FUEL_MAX;

        new vehid = g_PVehicleVehicle[v];
        if(vehid > 0 && vehid < MAX_VEHICLES) g_VehicleFuel[vehid] = FUEL_MAX;

        mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `fuel`=%.2f WHERE `id`=%d", FUEL_MAX, PVehicleData[v][pvID]);
        mysql_tquery(g_SQL, q, "", "", 0);
    }
}

// Reinnoieste un permis (data "YYYY-MM-DD"):
//   - inca valabil -> +1 zi
//   - deja expirat -> expirarea devine ziua de azi (mai are valabilitate azi)
// Returneaza 0 daca permisul nu exista deloc.
stock Pray_RenewLicense(lic[], len)
{
    if(!strlen(lic)) return 0;

    new ts = DateStrToUnix(lic);
    if(ts <= 0) return 0;

    // acelasi criteriu ca VehicleDoc_IsValid: valabil pe toata ziua din data expirarii
    new todayStart = gettime() - (gettime() % 86400);
    new expDayStart = ts - (ts % 86400);

    UnixToDateStr((expDayStart < todayStart) ? todayStart : (ts + 86400), lic, len);
    return 1;
}

// Reinnoieste toate permisele detinute (A/B/C/D auto, A/H avion, W arme)
stock Pray_ExtendLicenses(playerid)
{
    if(Pray_RenewLicense(PlayerData[playerid][pDrivingLicA_exp], 11)) UpdatePlayer(playerid, pDrivingLicA_exp);
    if(Pray_RenewLicense(PlayerData[playerid][pDrivingLicB_exp], 11)) UpdatePlayer(playerid, pDrivingLicB_exp);
    if(Pray_RenewLicense(PlayerData[playerid][pDrivingLicC_exp], 11)) UpdatePlayer(playerid, pDrivingLicC_exp);
    if(Pray_RenewLicense(PlayerData[playerid][pDrivingLicD_exp], 11)) UpdatePlayer(playerid, pDrivingLicD_exp);
    if(Pray_RenewLicense(PlayerData[playerid][pAirLicA_exp],     11)) UpdatePlayer(playerid, pAirLicA_exp);
    if(Pray_RenewLicense(PlayerData[playerid][pAirLicH_exp],     11)) UpdatePlayer(playerid, pAirLicH_exp);
    if(Pray_RenewLicense(PlayerData[playerid][pWeaponLicW_exp],  11)) UpdatePlayer(playerid, pWeaponLicW_exp);
}

// Sfarsitul asteptarii - deblocheaza jucatorul si cere din DB pacatele reale ale saptamanii
public Pray_WaitFinish(playerid)
{
    g_PrayWaitTimer[playerid] = -1;
    if(!IsPlayerConnected(playerid)) return 1;

    TogglePlayerControllable(playerid, 1);
    if(!PlayerData[playerid][pLogged]) return 1;

    new q[280];
    mysql_format(g_SQL, q, sizeof(q),
        "SELECT `prayedTimes`,`pacat1`,`pacat2`,`pacat3`,`pacat4`,`pacat5`,`pacat6`,`pacat7`,`pacat8`,`pacat9`,`pacat10`,`pacat11`,`pacat12` \
         FROM `pacate` WHERE `pID`=%d AND `weekNo`=%d LIMIT 1",
        PlayerData[playerid][pID], Pray_GetWeekNumber());
    mysql_tquery(g_SQL, q, "OnPrayConfessChecked", "i", playerid);
    return 1;
}

// Da bani jucatorului (cash + DB)
stock Pray_GiveMoney(playerid, amount)
{
    PlayerData[playerid][pMoney] += amount;
    GivePlayerMoney(playerid, amount);
    UpdatePlayer(playerid, pMoney);
}

// Compara pacatele reale (DB) cu cele marturisite si acorda recompensele
public OnPrayConfessChecked(playerid)
{
    if(!IsPlayerConnected(playerid) || !PlayerData[playerid][pLogged]) return 1;

    new actual[12], prayed = 0;
    if(cache_num_rows() > 0)
    {
        cache_get_value_name_int(0, "prayedTimes", prayed);

        new col[10];
        for(new i = 0; i < 12; i++)
        {
            format(col, sizeof(col), "pacat%d", i + 1);
            cache_get_value_name_int(0, col, actual[i]);
        }
    }
    else actual[3] = 1; // fara rand in DB: doar pacat4 (Anti-natura) e vinovat by default

    // diferenta = pacate comise dar nemarturisite + marturisite dar necomise
    new diff = 0;
    for(new i = 0; i < 12; i++)
        if(g_PacateSelected[playerid][i] != (actual[i] != 0)) diff++;

    for(new i = 0; i < 12; i++) g_PacateSelected[playerid][i] = false;

    // ---- bonusul de rugaciune se acorda indiferent de cate ori s-a rugat ----
    new bonus = PRAY_BONUS_PER_PRAY * prayed + random(1000);
    Pray_GiveMoney(playerid, bonus);

    new bonusMsg[176];
    format(bonusMsg, sizeof(bonusMsg), T(playerid, C_INFO"[Pray] "C_WHITE"Prayer bonus for praying "C_INFO"%d"C_WHITE" times this week: "C_SUCCESS"$%s"C_WHITE"."), prayed, MoneyStr(bonus));

    // ---- prea putine rugaciuni saptamana asta -> doar bonusul, fara restul recompenselor ----
    if(prayed < PRAY_MIN_TIMES)
    {
        new few[176];
        format(few, sizeof(few), T(playerid, C_ERROR"[Pray] "C_WHITE"You only prayed "C_INFO"%d/%d"C_WHITE" times this week, so you don't get the confession rewards."), prayed, PRAY_MIN_TIMES);
        SCM(playerid, COLOR_ERROR, few);
        SCM(playerid, COLOR_SUCCESS, bonusMsg);
        return 1;
    }

    // ---- verdictul ----
    if(diff >= 2)
        SCM(playerid, COLOR_ERROR, C_ERROR"[Pray] "C_WHITE"You didn't remember this week's sins correctly. Your sins have been forgiven anyway.");
    else if(diff == 1)
        SCM(playerid, COLOR_INFO, C_INFO"[Pray] "C_WHITE"You remembered this week's sins roughly right. Your sins have been forgiven.");
    else
        SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[Pray] "C_WHITE"You remembered all of this week's sins correctly. Your sins have been forgiven.");

    // ---- recompense primite indiferent de rezultat ----
    SetPlayerHealth(playerid, 100.0);
    PlayerData[playerid][pTired] = 0;
    UpdatePlayer(playerid, pTired);
    if(PlayerData[playerid][pDiseased]) Disease_Cure(playerid);

    SCM(playerid, COLOR_SUCCESS, C_INFO"[Pray] "C_WHITE"You receive: health 100, tiredness 0, sickness cured.");

    SCM(playerid, COLOR_SUCCESS, bonusMsg);

    new extra[176];
    if(diff >= 2) return 1;

    // ---- 1 pacat gresit: masinile spalate + bani ----
    Pray_CleanVehicles(playerid);

    new reward = (diff == 1) ? PRAY_REWARD_CLOSE : PRAY_REWARD_EXACT;
    Pray_GiveMoney(playerid, reward);

    if(diff == 1)
    {
        format(extra, sizeof(extra), T(playerid, C_INFO"[Pray] "C_WHITE"Also: personal vehicles cleaned and "C_SUCCESS"$%s"C_WHITE"."), MoneyStr(reward));
        SCM(playerid, COLOR_SUCCESS, extra);
        return 1;
    }

    // ---- 0 pacate gresite: in plus plin la rezervor + o zi la permise ----
    Pray_RefuelVehicles(playerid);
    Pray_ExtendLicenses(playerid);

    format(extra, sizeof(extra), T(playerid, C_INFO"[Pray] "C_WHITE"Also: vehicles cleaned + refueled, +1 day on all licenses and "C_SUCCESS"$%s"C_WHITE"."), MoneyStr(reward));
    SCM(playerid, COLOR_SUCCESS, extra);
    return 1;
}

// Click pe un textdraw din panoul de pacate
public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
    if(!g_PacateShown[playerid]) return 0;

    // click pe un pacat -> comuta selectia (alb <-> verde)
    for(new i = 1; i <= 12; i++)
    {
        if(playertextid != PacateTextdraw[playerid][i]) continue;

        g_PacateSelected[playerid][i - 1] = !g_PacateSelected[playerid][i - 1];

        PlayerTextDrawColor(playerid, PacateTextdraw[playerid][i],
            g_PacateSelected[playerid][i - 1] ? PACATE_COLOR_SELECTED : PACATE_COLOR_IDLE);
        PlayerTextDrawShow(playerid, PacateTextdraw[playerid][i]); // re-afisare ca sa se aplice culoarea
        return 1;
    }

    if(playertextid == PacateTextdraw[playerid][13])
    {
        Pacate_Confess(playerid);
        return 1;
    }
    return 0;
}

// ESC in modul de selectie -> inchide panoul
public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
    if(clickedid == Text:INVALID_TEXT_DRAW && g_PacateShown[playerid])
    {
        Pacate_Hide(playerid);
        return 1;
    }
    return 0;
}

// ---- Religie (/setreligion, /whatreligion) ----
new const g_ReligionName[4][24] = {"Ateu", "The Ascendants", "The Holy Order", "The Divine Blessing"};

// ============================================================
//  QUEST-URI SAPTAMANALE PER RELIGIE (/quest)
//  2 quest-uri fixe per religie (slot 0 si 1), tinute in tabela `quests`
//  (structura oglindeste sistemul de pacate: reset saptamanal luni 00:00 - vezi Quest_WeeklyReset -
//   apelat din PayDay_Check langa Pray_WeeklyReset)
//  QUEST_MODE_* / QUEST_ACTION_* sunt definite mai devreme in fisier (langa JOB_TRUCKDRIVER),
//  ca sa fie vizibile la hook-urile care apar inaintea acestei sectiuni.
// ============================================================
enum E_QUEST_DATA
{
    qMode, qSinNumber, qActionType, qTarget, qReward, qName[32], qDesc[96]
}

// index 1 = religie (0=Ateu .. 3=The Divine Blessing, ca g_ReligionName), index 2 = slot (0/1)
new const g_ReligionQuest[4][2][E_QUEST_DATA] = {
    // 0 - Ateu (ratiune, auto-suficienta, fara recompensa divina)
    {
        {QUEST_MODE_COUNT,     0, QUEST_ACTION_DONATE,   1, 10000, "Financial Independence", "Help another player out with $/pay - once is enough, no faith required."},
        {QUEST_MODE_AVOID_SIN, 1, 0,                      0, 10000, "Clean by Choice",        "Go the whole week without defying the law - discipline, not divine punishment."}
    },
    // 1 - The Ascendants (progres, tehnologie, auto-depasire)
    {
        {QUEST_MODE_COUNT, 0, QUEST_ACTION_TUNE,     3, 10000, "Elevate Your Ride",  "Install 3 tuning parts at Loco Outlaw Customs."},
        {QUEST_MODE_COUNT, 0, QUEST_ACTION_CROPDUST, 3, 10000, "Air Superiority",    "Complete 3 Crop Duster Pilot runs."}
    },
    // 2 - The Holy Order (traditie, disciplina, sacrificiu)
    {
        {QUEST_MODE_COUNT,     0,  QUEST_ACTION_FUEL, 3, 10000, "Trial by Fire",       "Complete 3 Fuel Carrier runs - hard, honest labor."},
        {QUEST_MODE_AVOID_SIN, 12, 0,                  0, 10000, "Respect for Order",  "Go the whole week without driving on an expired license."}
    },
    // 3 - The Divine Blessing (natura, comunitate, munca cinstita)
    {
        {QUEST_MODE_COUNT, 0, QUEST_ACTION_PLANT, 3, 10000, "Seeds of Blessing", "Plant 3 tree saplings in your forest."},
        {QUEST_MODE_COUNT, 0, QUEST_ACTION_WATER, 2, 10000, "Waters of Life",    "Water the plants 2 times as a Water Hauler."}
    }
};

// Luni la 00:00 (PayDay_Check): goleste complet tabelul `quests` (saptamana noua, quest-uri noi)
stock Quest_WeeklyReset()
{
    new year, month, day;
    getdate(year, month, day);
    if(DayOfWeek(year, month, day) != 1) return; // doar Luni

    mysql_tquery(g_SQL, "TRUNCATE TABLE `quests`", "", "", 0);
}

// Marcheaza progres pe unul din cele 2 sloturi ale religiei jucatorului, daca actionType se potriveste.
// Idempotent/fire-and-forget, la fel ca Pray_SetSin - fara round-trip la punctul de apel.
stock Quest_AddProgress(playerid, actionType, amount)
{
    if(!PlayerData[playerid][pLogged]) return;

    new rel = PlayerData[playerid][pReligion];
    if(rel < 0 || rel > 3) return;

    new week = Pray_GetWeekNumber();
    new q[220];
    for(new slot = 0; slot < 2; slot++)
    {
        if(g_ReligionQuest[rel][slot][qMode] != QUEST_MODE_COUNT) continue;
        if(g_ReligionQuest[rel][slot][qActionType] != actionType) continue;

        mysql_format(g_SQL, q, sizeof(q),
            "INSERT INTO `quests` (`pID`,`weekNo`,`slot`,`progress`) VALUES (%d,%d,%d,%d) ON DUPLICATE KEY UPDATE `progress` = LEAST(`progress` + %d, %d)",
            PlayerData[playerid][pID], week, slot, amount, amount, g_ReligionQuest[rel][slot][qTarget]);
        mysql_tquery(g_SQL, q, "", "", 0);
    }
}

// Stare temporara intre query-urile inlantuite ale /quest (quests -> pacate -> event_progress).
// Totul e afisat abia la final, intr-un singur dialog (Quest_ShowDialog), deci datele fiecarui
// pas trebuie sa "supravietuiasca" pana ajunge si ultimul callback.
new g_QuestTmpProgress[MAX_PLAYERS][2];
new g_QuestTmpClaimed[MAX_PLAYERS][2];
new g_QuestTmpSins[MAX_PLAYERS][12];

// Comanda /quest: citeste `quests` (progres + claimed pe cele 2 sloturi), apoi `pacate`
// (pentru sloturile AVOID_SIN), calculeaza starea si plateste recompensele nou-indeplinite.
// La final, daca ruleaza un eveniment sezonier, se adauga si quest-urile lui (vezi Event_ShowStatus).
stock Quest_ShowStatus(playerid)
{
    new rel = PlayerData[playerid][pReligion];
    if(rel < 0 || rel > 3)
    {
        SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Invalid religion.");
        // quest-urile de eveniment nu depind de religie, deci se arata oricum (daca ruleaza unul)
        if(Event_HasQuests()) Event_ShowStatus(playerid);
        return;
    }

    new q[160];
    mysql_format(g_SQL, q, sizeof(q),
        "SELECT `slot`,`progress`,`claimed` FROM `quests` WHERE `pID`=%d AND `weekNo`=%d",
        PlayerData[playerid][pID], Pray_GetWeekNumber());
    mysql_tquery(g_SQL, q, "OnQuestStatusLoaded", "i", playerid);
}

forward OnQuestStatusLoaded(playerid);
public OnQuestStatusLoaded(playerid)
{
    if(!IsPlayerConnected(playerid) || !PlayerData[playerid][pLogged]) return 1;

    g_QuestTmpProgress[playerid][0] = 0; g_QuestTmpProgress[playerid][1] = 0;
    g_QuestTmpClaimed[playerid][0]  = 0; g_QuestTmpClaimed[playerid][1]  = 0;

    new rows = cache_num_rows();
    for(new r = 0; r < rows; r++)
    {
        new slot, prog, clm;
        cache_get_value_name_int(r, "slot", slot);
        cache_get_value_name_int(r, "progress", prog);
        cache_get_value_name_int(r, "claimed", clm);
        if(slot == 0 || slot == 1) { g_QuestTmpProgress[playerid][slot] = prog; g_QuestTmpClaimed[playerid][slot] = clm; }
    }

    new q[280];
    mysql_format(g_SQL, q, sizeof(q),
        "SELECT `pacat1`,`pacat2`,`pacat3`,`pacat4`,`pacat5`,`pacat6`,`pacat7`,`pacat8`,`pacat9`,`pacat10`,`pacat11`,`pacat12` \
         FROM `pacate` WHERE `pID`=%d AND `weekNo`=%d LIMIT 1",
        PlayerData[playerid][pID], Pray_GetWeekNumber());
    mysql_tquery(g_SQL, q, "OnQuestPacateLoaded", "i", playerid);
    return 1;
}

forward OnQuestPacateLoaded(playerid);
public OnQuestPacateLoaded(playerid)
{
    if(!IsPlayerConnected(playerid) || !PlayerData[playerid][pLogged]) return 1;

    // Pacatele saptamanii, pastrate pentru sloturile AVOID_SIN cand se randeaza dialogul
    for(new i = 0; i < 12; i++) g_QuestTmpSins[playerid][i] = 0;

    if(cache_num_rows() > 0)
    {
        new col[10];
        for(new i = 0; i < 12; i++)
        {
            format(col, sizeof(col), "pacat%d", i + 1);
            cache_get_value_name_int(0, col, g_QuestTmpSins[playerid][i]);
        }
    }
    else g_QuestTmpSins[playerid][3] = 1; // fara rand in DB: doar pacat4 (Anti-natura) e vinovat by default

    // Ultimul pas al lantului: quest-urile evenimentului (daca ruleaza unul), apoi se afiseaza
    // totul intr-un singur dialog. Fara eveniment activ, afisam direct.
    if(Event_HasQuests()) Event_ShowStatus(playerid);
    else                  Quest_ShowDialog(playerid);
    return 1;
}

// ============================================================
//  EVENIMENTE SEZONIERE - SISTEM GENERIC (jucatori: /quest | admin: /holiday)
// ------------------------------------------------------------
//  Un singur eveniment activ la un moment dat (`event_config`.`active_event`).
//  Mecanicile sunt generice (EVENT_TYPE_*); ce difera de la Halloween la Craciun
//  sunt DOAR datele din tabelele `event_*` - deci un eveniment nou nu cere cod nou.
//
//  Progresul se tine exclusiv in `event_progress` (upsert fire-and-forget, ca la
//  Quest_AddProgress); recompensele se platesc cand jucatorul deschide /quest,
//  la fel ca la quest-urile de religie - de care se afiseaza lipit, dedesubt.
// ============================================================
enum E_EVENT_QUEST
{
    eqKey[EVENT_KEY_LEN], eqType, eqName[48], eqDesc[128], eqTarget, eqReward,
    eqState   // EVENT_STATE_*, pe aceeasi scala ca sarbatoarea (vezi Event_QuestState)
}
new EventQuest[EVENT_MAX_QUESTS][E_EVENT_QUEST];
new g_EventQuestCount = 0;

// Definitia unui punct de spawn (aceeasi pentru toti); instantele concrete sunt per jucator.
// eoID = id-ul din `event_objects`, necesar ca sa stim ce a ridicat fiecare jucator (event_pickups).
enum E_EVENT_OBJECT
{
    eoID, eoQuest[EVENT_KEY_LEN], eoModel,
    Float:eoX, Float:eoY, Float:eoZ, Float:eoRX, Float:eoRY, Float:eoRZ,
    eoInterior, eoWorld
}
new EventObject[EVENT_MAX_OBJECTS][E_EVENT_OBJECT];
new g_EventObjectCount = 0;

// Instantele per jucator: fiecare jucator are propriul obiect in fiecare punct de spawn.
// Cand il ridica, dispare DOAR pentru el si NU mai reapare: fiecare punct se ia o singura data
// per jucator, pana la /holiday reset.
new STREAMER_TAG_OBJECT:g_EventPObj[MAX_PLAYERS][EVENT_MAX_OBJECTS];
new g_EventPTaken[MAX_PLAYERS][EVENT_MAX_OBJECTS];   // 0 = e pe harta; 1 = deja ridicat de el

// Starea incarcarii ridicarilor din DB (`event_pickups`), per jucator:
// 0 = neincarcat, 1 = query in curs, 2 = incarcat. Pana la 2 nu spawnam nimic pentru el, altfel
// obiectele ar aparea o secunda si apoi ar disparea la venirea raspunsului.
#define EVENT_PICKUPS_NONE     0
#define EVENT_PICKUPS_PENDING  1
#define EVENT_PICKUPS_READY    2
new g_EventPickupState[MAX_PLAYERS];

enum E_EVENT_CP
{
    ecQuest[EVENT_KEY_LEN], ecIndex,
    Float:ecX, Float:ecY, Float:ecZ, Float:ecSize, ecInterior, ecWorld
}
new EventCP[EVENT_MAX_CHECKPOINTS][E_EVENT_CP];
new g_EventCPCount = 0;

enum E_EVENT_ZONE
{
    ezQuest[EVENT_KEY_LEN],
    Float:ezX, Float:ezY, Float:ezZ, Float:ezRadius, ezInterior, ezWorld
}
new EventZone[EVENT_MAX_ZONES][E_EVENT_ZONE];
new g_EventZoneCount = 0;

// Personaje statice. Actorii sunt globali (nu per jucator ca obiectele): nu ocupa slot de jucator
// si oricum nu se "consuma" - ce se retine per jucator e doar cu cine a vorbit deja.
enum E_EVENT_NPC
{
    enID, enQuest[EVENT_KEY_LEN], enBehaviour, enSkin, Float:enHealth,
    Float:enX, Float:enY, Float:enZ, Float:enAngle, enInterior, enWorld,
    STREAMER_TAG_ACTOR:enActor,
    STREAMER_TAG_3D_TEXT_LABEL:enLabel   // "[ Press ENTER to interact ]" deasupra lui
}
new EventNpc[EVENT_MAX_NPCS][E_EVENT_NPC];
new g_EventNpcCount = 0;

// Cand poate jucatorul sa interactioneze din nou cu personajul i (anti-spam pe agresiv/random)
new g_EventNpcCooldown[MAX_PLAYERS][EVENT_MAX_NPCS];

// Cu ce personaje a vorbit deja jucatorul (1 = a luat progresul de la el). Se citeste din
// `event_npc_talks` la logare, exact ca punctele ridicate, si se rescrie in DB la fiecare progres nou
// - deci progresul de la zombi supravietuieste deconectarii si restartului.
new g_EventNpcTalked[MAX_PLAYERS][EVENT_MAX_NPCS];
new g_EventTalkState[MAX_PLAYERS]; // aceleasi stari ca la pickups: NONE / PENDING / READY

// Curiozitatile spuse de personajele inactive. Sunt independente de sarbatoarea configurata pe
// server (`g_EventName`) - vorbesc despre sarbatori reale, romanesti si europene.
enum E_EVENT_FACT
{
    efHoliday[48], efCountry[32], efEn[EVENT_FACT_LEN], efRo[EVENT_FACT_LEN]
}
new EventFact[EVENT_MAX_FACTS][E_EVENT_FACT];
new g_EventFactCount = 0;

new EventSkinID[EVENT_MAX_SKINS];
new EventSkinLabel[EVENT_MAX_SKINS][32];
new g_EventSkinCount = 0;

// Obiecte atasate de jucator: ce model, pe ce os, cu ce offset/rotatie/scalare
enum E_EVENT_ATTACH
{
    eaQuest[EVENT_KEY_LEN], eaModel, eaSlot, eaBone,
    Float:eaX,  Float:eaY,  Float:eaZ,
    Float:eaRX, Float:eaRY, Float:eaRZ,
    Float:eaSX, Float:eaSY, Float:eaSZ
}
new EventAttach[EVENT_MAX_ATTACH][E_EVENT_ATTACH];
new g_EventAttachCount = 0;

// Exista UN SINGUR eveniment ("holiday"), cu nume configurabil: la Halloween il numesti
// "Halloween", in decembrie "Christmas" etc. Quest-urile lui se inlocuiesc odata cu sarbatoarea.
new g_EventName[48] = "Holiday";
new g_EventState    = EVENT_STATE_HIDE;   // vezi EVENT_STATE_* - o scara, nu flag-uri separate

// Stare temporara intre query-ul /event si afisare (acelasi tipar ca g_QuestTmpProgress)
new g_EventTmpProgress[MAX_PLAYERS][EVENT_MAX_QUESTS];
new g_EventTmpClaimed[MAX_PLAYERS][EVENT_MAX_QUESTS];

// Cele trei intrebari pe care le pune restul codului. Fiecare e adevarata de la o treapta in sus.
stock Event_ObjectsOn()   { return (g_EventState >= EVENT_STATE_START) ? 1 : 0; } // se spawneaza obiectele?
stock Event_ProgressOn()  { return (g_EventState >= EVENT_STATE_PAUSE) ? 1 : 0; } // se mai aduna progres?
stock Event_VisibleOn()   { return (g_EventState >= EVENT_STATE_STOP)  ? 1 : 0; } // apare in /quest?

// Numele starii, pentru mesaje si log.
// (parametrul nu se poate numi `state` - e cuvant rezervat in Pawn)
stock Event_StateName(st, dest[], len)
{
    switch(st)
    {
        case EVENT_STATE_START: format(dest, len, "running");
        case EVENT_STATE_PAUSE: format(dest, len, "paused");
        case EVENT_STATE_STOP:  format(dest, len, "stopped");
        default:                format(dest, len, "hidden");
    }
}

// Starea EFECTIVA a unui quest. Fiecare quest are propria stare, pe aceeasi scala ca sarbatoarea,
// dar nu poate depasi starea sarbatorii: cu sarbatoarea in pauza, un quest pe "start" e tot in pauza.
// Deci minimul dintre cele doua - sarbatoarea ramane comutatorul principal, iar starea quest-ului
// il opreste separat pe el fara sa atinga restul.
stock Event_QuestState(qi)
{
    if(qi < 0 || qi >= g_EventQuestCount) return EVENT_STATE_HIDE;
    new st = EventQuest[qi][eqState];
    return (g_EventState < st) ? g_EventState : st;
}

stock Event_QuestObjectsOn(qi)  { return (Event_QuestState(qi) >= EVENT_STATE_START) ? 1 : 0; }
stock Event_QuestProgressOn(qi) { return (Event_QuestState(qi) >= EVENT_STATE_PAUSE) ? 1 : 0; }
stock Event_QuestVisibleOn(qi)  { return (Event_QuestState(qi) >= EVENT_STATE_STOP)  ? 1 : 0; }

// 1 daca ruleaza un eveniment care chiar are quest-uri de aratat.
// Exista ca functie (nu verificare directa pe g_EventQuestCount) fiindca e apelata si din
// sectiunea de quest-uri saptamanale, care apare mai devreme in fisier decat variabilele astea -
// Pawn accepta apeluri de functii inainte de definitie, dar NU si variabile.
// Netagata (nu bool:) inadins: o functie cu tag folosita inainte de definitie da warning 208.
stock Event_HasQuests()
{
    if(!Event_VisibleOn()) return 0;
    for(new i = 0; i < g_EventQuestCount; i++)
        if(Event_QuestVisibleOn(i)) return 1; // macar unul nu e ascuns
    return 0;
}

// Indexul quest-ului dupa cheie, sau -1. Cheile sunt unice per eveniment.
stock Event_FindQuest(const questKey[])
{
    for(new i = 0; i < g_EventQuestCount; i++)
        if(strcmp(EventQuest[i][eqKey], questKey, true) == 0) return i;
    return -1;
}

// Sterge obiectele evenimentului pentru UN jucator (la deconectare, la oprirea evenimentului...)
stock Event_DestroyObjectsFor(playerid)
{
    for(new i = 0; i < EVENT_MAX_OBJECTS; i++)
    {
        if(IsValidDynamicObject(g_EventPObj[playerid][i]))
            DestroyDynamicObject(g_EventPObj[playerid][i]);
        g_EventPObj[playerid][i]     = STREAMER_TAG_OBJECT:-1;
        g_EventPTaken[playerid][i] = 0;
    }
    g_EventPickupState[playerid] = EVENT_PICKUPS_NONE; // se reciteste din DB la urmatoarea intrare
}

// Indexul unui punct de spawn dupa id-ul lui din `event_objects`, sau -1
stock Event_FindObjectByID(id)
{
    for(new i = 0; i < g_EventObjectCount; i++)
        if(EventObject[i][eoID] == id) return i;
    return -1;
}

// Indexul unui personaj dupa id-ul lui din `event_npcs`, sau -1
stock Event_FindNpcByID(id)
{
    for(new i = 0; i < g_EventNpcCount; i++)
        if(EventNpc[i][enID] == id) return i;
    return -1;
}

// Uita starea personajelor pentru un jucator (deconectare, reincarcarea evenimentului)
stock Event_ResetNpcStateFor(playerid)
{
    for(new i = 0; i < EVENT_MAX_NPCS; i++)
    {
        g_EventNpcTalked[playerid][i]   = 0;
        g_EventNpcCooldown[playerid][i] = 0;
    }
    g_EventTalkState[playerid] = EVENT_PICKUPS_NONE; // se reciteste din DB la urmatoarea intrare
}

// Citeste din DB personajele cu care jucatorul a vorbit deja, ca sa nu ia progres de doua ori
// de la acelasi zombi dupa relog.
stock Event_LoadNpcTalks(playerid)
{
    g_EventTalkState[playerid] = EVENT_PICKUPS_PENDING;

    new q[160];
    mysql_format(g_SQL, q, sizeof(q),
        "SELECT `npc_id` FROM `event_npc_talks` WHERE `pID`=%d", PlayerData[playerid][pID]);
    mysql_tquery(g_SQL, q, "OnEventNpcTalksLoaded", "i", playerid);
}

forward OnEventNpcTalksLoaded(playerid);
public OnEventNpcTalksLoaded(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    new rows = cache_num_rows();
    for(new r = 0; r < rows; r++)
    {
        new nid;
        cache_get_value_name_int(r, "npc_id", nid);

        new i = Event_FindNpcByID(nid);
        if(i == -1) continue; // personajul a fost sters intre timp

        g_EventNpcTalked[playerid][i] = 1;
    }

    g_EventTalkState[playerid] = EVENT_PICKUPS_READY;
    return 1;
}

// Citeste din DB punctele pe care jucatorul le-a ridicat deja. Sunt definitive: un punct luat
// ramane luat pentru el, si dupa reconectare sau restart, pana la /holiday reset.
stock Event_LoadPickups(playerid)
{
    g_EventPickupState[playerid] = EVENT_PICKUPS_PENDING;

    new q[160];
    mysql_format(g_SQL, q, sizeof(q),
        "SELECT `object_id` FROM `event_pickups` WHERE `pID`=%d", PlayerData[playerid][pID]);
    mysql_tquery(g_SQL, q, "OnEventPickupsLoaded", "i", playerid);
}

forward OnEventPickupsLoaded(playerid);
public OnEventPickupsLoaded(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    new rows = cache_num_rows();
    for(new r = 0; r < rows; r++)
    {
        new oid;
        cache_get_value_name_int(r, "object_id", oid);

        new i = Event_FindObjectByID(oid);
        if(i == -1) continue; // punctul a fost sters intre timp

        g_EventPTaken[playerid][i] = 1;
    }

    g_EventPickupState[playerid] = EVENT_PICKUPS_READY;
    Event_SpawnObjectsFor(playerid);
    return 1;
}

// ---- Teardown: scoate din lume tot ce a spawnat evenimentul ----
stock Event_DestroyWorld()
{
    // intai obiectele atasate de jucatori (are nevoie de definitiile inca incarcate), apoi restul
    Event_AttachRemoveAll();
    Event_DestroyActors();

    for(new p = 0; p < MAX_PLAYERS; p++)
    {
        if(!IsPlayerConnected(p)) continue;
        Event_DestroyObjectsFor(p);
        Event_ResetNpcStateFor(p); // indexii personajelor se schimba la reincarcare
    }
    g_EventObjectCount = 0;
    g_EventQuestCount  = 0;
    g_EventCPCount     = 0;
    g_EventZoneCount   = 0;
    g_EventNpcCount    = 0;
    g_EventSkinCount   = 0;
    g_EventAttachCount = 0;
}

// ---- Incarcare ----
// Pasul 1: numele evenimentului + daca ruleaza. Restul tabelelor sunt independente intre ele,
// deci se incarca in paralel imediat dupa.
stock Event_LoadConfig()
{
    mysql_tquery(g_SQL, "SELECT `name`,`state` FROM `event_config` WHERE `id`=1 LIMIT 1", "OnEventConfigLoaded");
}

forward OnEventConfigLoaded();
public OnEventConfigLoaded()
{
    Event_DestroyWorld();
    g_EventState = EVENT_STATE_HIDE;

    if(cache_num_rows() > 0)
    {
        cache_get_value_name(0, "name", g_EventName, sizeof(g_EventName));
        cache_get_value_name_int(0, "state", g_EventState);
    }
    if(g_EventName[0] == EOS) format(g_EventName, sizeof(g_EventName), "Holiday");
    if(g_EventState < EVENT_STATE_HIDE || g_EventState > EVENT_STATE_START) g_EventState = EVENT_STATE_HIDE;

    new stName[16];
    Event_StateName(g_EventState, stName, sizeof(stName));

    // Ascuns complet: nu are rost sa incarcam nimic - nici nu se vede, nici nu se aduna progres.
    if(g_EventState == EVENT_STATE_HIDE)
    {
        printf("[EVENT] '%s': %s.", g_EventName, stName);
        return 1;
    }

    printf("[EVENT] '%s': %s - se incarca datele...", g_EventName, stName);

    new q[200];
    format(q, sizeof(q),
        // toate quest-urile, inclusiv cele ascunse: starea lor filtreaza la afisare/progres,
        // dar definitia trebuie sa existe ca sa stim de ce quest tin obiectele si personajele
        "SELECT * FROM `event_quests` ORDER BY `sort_order` ASC, `id` ASC LIMIT %d", EVENT_MAX_QUESTS);
    mysql_tquery(g_SQL, q, "OnEventQuestsLoaded");

    format(q, sizeof(q), "SELECT * FROM `event_objects` ORDER BY `id` ASC LIMIT %d", EVENT_MAX_OBJECTS);
    mysql_tquery(g_SQL, q, "OnEventObjectsLoaded");

    format(q, sizeof(q), "SELECT * FROM `event_checkpoints` ORDER BY `quest_key` ASC, `cp_index` ASC LIMIT %d", EVENT_MAX_CHECKPOINTS);
    mysql_tquery(g_SQL, q, "OnEventCheckpointsLoaded");

    format(q, sizeof(q), "SELECT * FROM `event_zones` ORDER BY `id` ASC LIMIT %d", EVENT_MAX_ZONES);
    mysql_tquery(g_SQL, q, "OnEventZonesLoaded");

    format(q, sizeof(q), "SELECT * FROM `event_npcs` ORDER BY `id` ASC LIMIT %d", EVENT_MAX_NPCS);
    mysql_tquery(g_SQL, q, "OnEventNpcsLoaded");

    format(q, sizeof(q), "SELECT * FROM `event_skins` ORDER BY `id` ASC LIMIT %d", EVENT_MAX_SKINS);
    mysql_tquery(g_SQL, q, "OnEventSkinsLoaded");

    format(q, sizeof(q), "SELECT * FROM `event_attachments` ORDER BY `id` ASC LIMIT %d", EVENT_MAX_ATTACH);
    mysql_tquery(g_SQL, q, "OnEventAttachmentsLoaded");
    return 1;
}

forward OnEventQuestsLoaded();
public OnEventQuestsLoaded()
{
    new rows = cache_num_rows();
    g_EventQuestCount = 0;
    for(new i = 0; i < rows && g_EventQuestCount < EVENT_MAX_QUESTS; i++)
    {
        new idx = g_EventQuestCount;
        cache_get_value_name(i, "quest_key", EventQuest[idx][eqKey], EVENT_KEY_LEN);
        cache_get_value_name_int(i, "type", EventQuest[idx][eqType]);
        cache_get_value_name(i, "name", EventQuest[idx][eqName], 48);
        cache_get_value_name(i, "description", EventQuest[idx][eqDesc], 128);
        cache_get_value_name_int(i, "target", EventQuest[idx][eqTarget]);
        cache_get_value_name_int(i, "reward_money", EventQuest[idx][eqReward]);
        cache_get_value_name_int(i, "state", EventQuest[idx][eqState]);
        if(EventQuest[idx][eqTarget] < 1) EventQuest[idx][eqTarget] = 1;
        if(EventQuest[idx][eqState] < EVENT_STATE_HIDE || EventQuest[idx][eqState] > EVENT_STATE_START)
            EventQuest[idx][eqState] = EVENT_STATE_START;
        g_EventQuestCount++;
    }
    printf("[EVENT] %d quest-uri incarcate.", g_EventQuestCount);

    // Tabelele se incarca in paralel, deci personajele pot ajunge inaintea quest-urilor. Cum spawnul
    // lor depinde acum de starea quest-ului, mai incercam o data si de aici; apelul e idempotent
    // (sare peste actorii deja creati), asa ca nu conteaza care callback ajunge primul.
    Event_SpawnActors();
    return 1;
}

forward OnEventObjectsLoaded();
public OnEventObjectsLoaded()
{
    new rows = cache_num_rows();
    g_EventObjectCount = 0;
    for(new i = 0; i < rows && g_EventObjectCount < EVENT_MAX_OBJECTS; i++)
    {
        new idx = g_EventObjectCount;
        cache_get_value_name_int(i, "id", EventObject[idx][eoID]);
        cache_get_value_name(i, "quest_key", EventObject[idx][eoQuest], EVENT_KEY_LEN);
        cache_get_value_name_int(i, "model", EventObject[idx][eoModel]);
        cache_get_value_name_float(i, "x",  EventObject[idx][eoX]);
        cache_get_value_name_float(i, "y",  EventObject[idx][eoY]);
        cache_get_value_name_float(i, "z",  EventObject[idx][eoZ]);
        cache_get_value_name_float(i, "rx", EventObject[idx][eoRX]);
        cache_get_value_name_float(i, "ry", EventObject[idx][eoRY]);
        cache_get_value_name_float(i, "rz", EventObject[idx][eoRZ]);
        cache_get_value_name_int(i, "interior", EventObject[idx][eoInterior]);
        cache_get_value_name_int(i, "world",    EventObject[idx][eoWorld]);
        g_EventObjectCount++;
    }

    // definitiile s-au schimbat -> instantele vechi ale jucatorilor nu mai corespund
    for(new p = 0; p < MAX_PLAYERS; p++)
    {
        if(!IsPlayerConnected(p)) continue;
        Event_DestroyObjectsFor(p);
        Event_SpawnObjectsFor(p); // nu face nimic sub starea START
    }

    printf("[EVENT] %d obiecte incarcate%s.", g_EventObjectCount,
        Event_ObjectsOn() ? (" si spawnate per jucator") : (" (nu se spawneaza in starea curenta)"));
    return 1;
}

// (Re)creeaza obiectele pentru UN jucator: cele care nu sunt in asteptare de respawn si nu exista deja.
// Fiecare jucator primeste propriile instante (parametrul `playerid` din CreateDynamicObject),
// deci ce ridica unul ramane pe harta pentru ceilalti.
// Sub starea START (pause/stop/hide) nu se spawneaza nimic.
stock Event_SpawnObjectsFor(playerid)
{
    if(!Event_ObjectsOn()) return;
    if(!IsPlayerConnected(playerid) || !PlayerData[playerid][pLogged]) return;
    if(g_EventPickupState[playerid] != EVENT_PICKUPS_READY) return; // inca nu stim ce a ridicat

    for(new i = 0; i < g_EventObjectCount; i++)
    {
        if(g_EventPTaken[playerid][i]) continue;
        if(IsValidDynamicObject(g_EventPObj[playerid][i])) continue;
        if(EventObject[i][eoModel] <= 0) continue;

        // obiectele unui quest oprit nu apar pe harta, chiar daca sarbatoarea ruleaza
        new oqi = Event_FindQuest(EventObject[i][eoQuest]);
        if(oqi == -1 || !Event_QuestObjectsOn(oqi)) continue;

        g_EventPObj[playerid][i] = CreateDynamicObject(EventObject[i][eoModel],
            EventObject[i][eoX], EventObject[i][eoY], EventObject[i][eoZ],
            EventObject[i][eoRX], EventObject[i][eoRY], EventObject[i][eoRZ],
            EventObject[i][eoWorld], EventObject[i][eoInterior], playerid);
    }
}

forward OnEventCheckpointsLoaded();
public OnEventCheckpointsLoaded()
{
    new rows = cache_num_rows();
    g_EventCPCount = 0;
    for(new i = 0; i < rows && g_EventCPCount < EVENT_MAX_CHECKPOINTS; i++)
    {
        new idx = g_EventCPCount;
        cache_get_value_name(i, "quest_key", EventCP[idx][ecQuest], EVENT_KEY_LEN);
        cache_get_value_name_int(i, "cp_index", EventCP[idx][ecIndex]);
        cache_get_value_name_float(i, "x", EventCP[idx][ecX]);
        cache_get_value_name_float(i, "y", EventCP[idx][ecY]);
        cache_get_value_name_float(i, "z", EventCP[idx][ecZ]);
        cache_get_value_name_float(i, "size", EventCP[idx][ecSize]);
        cache_get_value_name_int(i, "interior", EventCP[idx][ecInterior]);
        cache_get_value_name_int(i, "world",    EventCP[idx][ecWorld]);
        if(EventCP[idx][ecSize] <= 0.0) EventCP[idx][ecSize] = 3.0;
        g_EventCPCount++;
    }
    printf("[EVENT] %d checkpoint-uri incarcate.", g_EventCPCount);
    return 1;
}

forward OnEventZonesLoaded();
public OnEventZonesLoaded()
{
    new rows = cache_num_rows();
    g_EventZoneCount = 0;
    for(new i = 0; i < rows && g_EventZoneCount < EVENT_MAX_ZONES; i++)
    {
        new idx = g_EventZoneCount;
        cache_get_value_name(i, "quest_key", EventZone[idx][ezQuest], EVENT_KEY_LEN);
        cache_get_value_name_float(i, "x", EventZone[idx][ezX]);
        cache_get_value_name_float(i, "y", EventZone[idx][ezY]);
        cache_get_value_name_float(i, "z", EventZone[idx][ezZ]);
        cache_get_value_name_float(i, "radius", EventZone[idx][ezRadius]);
        cache_get_value_name_int(i, "interior", EventZone[idx][ezInterior]);
        cache_get_value_name_int(i, "world",    EventZone[idx][ezWorld]);
        if(EventZone[idx][ezRadius] <= 0.0) EventZone[idx][ezRadius] = 50.0;
        g_EventZoneCount++;
    }
    printf("[EVENT] %d zone incarcate.", g_EventZoneCount);
    return 1;
}

forward OnEventNpcsLoaded();
public OnEventNpcsLoaded()
{
    new rows = cache_num_rows();
    g_EventNpcCount = 0;
    for(new i = 0; i < rows && g_EventNpcCount < EVENT_MAX_NPCS; i++)
    {
        new idx = g_EventNpcCount;
        cache_get_value_name_int(i, "id", EventNpc[idx][enID]);
        cache_get_value_name(i, "quest_key", EventNpc[idx][enQuest], EVENT_KEY_LEN);
        cache_get_value_name_int(i, "behaviour", EventNpc[idx][enBehaviour]);
        cache_get_value_name_int(i, "skin", EventNpc[idx][enSkin]);
        cache_get_value_name_float(i, "health", EventNpc[idx][enHealth]);
        cache_get_value_name_float(i, "x", EventNpc[idx][enX]);
        cache_get_value_name_float(i, "y", EventNpc[idx][enY]);
        cache_get_value_name_float(i, "z", EventNpc[idx][enZ]);
        cache_get_value_name_float(i, "angle", EventNpc[idx][enAngle]);
        cache_get_value_name_int(i, "interior", EventNpc[idx][enInterior]);
        cache_get_value_name_int(i, "world",    EventNpc[idx][enWorld]);
        EventNpc[idx][enActor] = STREAMER_TAG_ACTOR:-1;
        EventNpc[idx][enLabel] = STREAMER_TAG_3D_TEXT_LABEL:-1;

        if(EventNpc[idx][enBehaviour] < EVENT_NPC_IDLE || EventNpc[idx][enBehaviour] > EVENT_NPC_RANDOM)
            EventNpc[idx][enBehaviour] = EVENT_NPC_MIXED; // orice altceva = tip per jucator
        if(EventNpc[idx][enHealth] <= 0.0) EventNpc[idx][enHealth] = 100.0;
        g_EventNpcCount++;
    }

    Event_SpawnActors();
    printf("[EVENT] %d personaje incarcate%s.", g_EventNpcCount,
        Event_ObjectsOn() ? (" si spawnate") : (" (nu se spawneaza in starea curenta)"));
    return 1;
}

// Creeaza actorii pentru personajele incarcate. Sunt globali (toata lumea vede aceiasi actori)
// si invulnerabili - "atacul" celor agresivi e scriptat, actorii nu pot trage cu adevarat.
stock Event_SpawnActors()
{
    if(!Event_ObjectsOn()) return;

    for(new i = 0; i < g_EventNpcCount; i++)
    {
        if(IsValidDynamicActor(EventNpc[i][enActor])) continue;
        if(EventNpc[i][enSkin] <= 0) continue;

        // la fel ca obiectele: personajele unui quest oprit nu se creeaza deloc
        new nqi = Event_FindQuest(EventNpc[i][enQuest]);
        if(nqi == -1 || !Event_QuestObjectsOn(nqi)) continue;

        EventNpc[i][enActor] = CreateDynamicActor(EventNpc[i][enSkin],
            EventNpc[i][enX], EventNpc[i][enY], EventNpc[i][enZ], EventNpc[i][enAngle],
            true, EventNpc[i][enHealth],
            EventNpc[i][enWorld], EventNpc[i][enInterior]);

        // Eticheta de deasupra capului, ca jucatorul sa stie ca poate interactiona.
        // Raza e putin peste EVENT_NPC_RANGE, ca sa o vada inainte sa fie destul de aproape.
        if(IsValidDynamic3DTextLabel(EventNpc[i][enLabel]))
            DestroyDynamic3DTextLabel(EventNpc[i][enLabel]);

        EventNpc[i][enLabel] = CreateDynamic3DTextLabel(C_WHITE"[ Press ENTER to interact ]", COLOR_WHITE,
            EventNpc[i][enX], EventNpc[i][enY], EventNpc[i][enZ] + 0.9, 10.0,
            INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,
            EventNpc[i][enWorld], EventNpc[i][enInterior]);
    }
}

stock Event_DestroyActors()
{
    for(new i = 0; i < EVENT_MAX_NPCS; i++)
    {
        if(IsValidDynamicActor(EventNpc[i][enActor]))
            DestroyDynamicActor(EventNpc[i][enActor]);
        EventNpc[i][enActor] = STREAMER_TAG_ACTOR:-1;

        if(IsValidDynamic3DTextLabel(EventNpc[i][enLabel]))
            DestroyDynamic3DTextLabel(EventNpc[i][enLabel]);
        EventNpc[i][enLabel] = STREAMER_TAG_3D_TEXT_LABEL:-1;
    }
}

forward OnEventSkinsLoaded();
public OnEventSkinsLoaded()
{
    new rows = cache_num_rows();
    g_EventSkinCount = 0;
    for(new i = 0; i < rows && g_EventSkinCount < EVENT_MAX_SKINS; i++)
    {
        cache_get_value_name_int(i, "skin", EventSkinID[g_EventSkinCount]);
        cache_get_value_name(i, "label", EventSkinLabel[g_EventSkinCount], 32);
        g_EventSkinCount++;
    }
    printf("[EVENT] %d costume incarcate.", g_EventSkinCount);
    return 1;
}

forward OnEventAttachmentsLoaded();
public OnEventAttachmentsLoaded()
{
    new rows = cache_num_rows();
    g_EventAttachCount = 0;
    for(new i = 0; i < rows && g_EventAttachCount < EVENT_MAX_ATTACH; i++)
    {
        new idx = g_EventAttachCount;
        cache_get_value_name(i, "quest_key", EventAttach[idx][eaQuest], EVENT_KEY_LEN);
        cache_get_value_name_int(i, "model", EventAttach[idx][eaModel]);
        cache_get_value_name_int(i, "slot",  EventAttach[idx][eaSlot]);
        cache_get_value_name_int(i, "bone",  EventAttach[idx][eaBone]);
        cache_get_value_name_float(i, "x",  EventAttach[idx][eaX]);
        cache_get_value_name_float(i, "y",  EventAttach[idx][eaY]);
        cache_get_value_name_float(i, "z",  EventAttach[idx][eaZ]);
        cache_get_value_name_float(i, "rx", EventAttach[idx][eaRX]);
        cache_get_value_name_float(i, "ry", EventAttach[idx][eaRY]);
        cache_get_value_name_float(i, "rz", EventAttach[idx][eaRZ]);
        cache_get_value_name_float(i, "sx", EventAttach[idx][eaSX]);
        cache_get_value_name_float(i, "sy", EventAttach[idx][eaSY]);
        cache_get_value_name_float(i, "sz", EventAttach[idx][eaSZ]);

        // slot valid 6-9 (0-5 sunt rezervate altor sisteme); bone valid 1-18; scalare 0 = invizibil
        if(EventAttach[idx][eaSlot] < EVENT_ATTACH_SLOT_MIN || EventAttach[idx][eaSlot] >= MAX_PLAYER_ATTACHED_OBJECTS)
        {
            printf("[EVENT] AVERTISMENT: attachment '%s' avea slot %d (rezervat/invalid) - corectat la %d.",
                EventAttach[idx][eaQuest], EventAttach[idx][eaSlot], EVENT_ATTACH_SLOT_MIN);
            EventAttach[idx][eaSlot] = EVENT_ATTACH_SLOT_MIN;
        }
        if(EventAttach[idx][eaBone] < 1 || EventAttach[idx][eaBone] > 18) EventAttach[idx][eaBone] = 6; // right hand
        if(EventAttach[idx][eaSX] <= 0.0) EventAttach[idx][eaSX] = 1.0;
        if(EventAttach[idx][eaSY] <= 0.0) EventAttach[idx][eaSY] = 1.0;
        if(EventAttach[idx][eaSZ] <= 0.0) EventAttach[idx][eaSZ] = 1.0;
        g_EventAttachCount++;
    }
    printf("[EVENT] %d obiecte atasabile incarcate.", g_EventAttachCount);
    return 1;
}

// Indexul definitiei de atasare pentru un quest, sau -1
stock Event_FindAttach(const questKey[])
{
    for(new i = 0; i < g_EventAttachCount; i++)
        if(strcmp(EventAttach[i][eaQuest], questKey, true) == 0) return i;
    return -1;
}

// Ataseaza jucatorului obiectul definit pentru quest-ul dat (ex: dovleacul in mana).
// Returneaza true daca s-a atasat.
stock bool:Event_AttachGive(playerid, const questKey[])
{
    new ai = Event_FindAttach(questKey);
    if(ai == -1) return false;
    if(EventAttach[ai][eaModel] <= 0) return false;
    if(!IsPlayerConnected(playerid)) return false;

    new slot = EventAttach[ai][eaSlot];
    if(IsPlayerAttachedObjectSlotUsed(playerid, slot))
        RemovePlayerAttachedObject(playerid, slot);

    SetPlayerAttachedObject(playerid, slot, EventAttach[ai][eaModel], EventAttach[ai][eaBone],
        EventAttach[ai][eaX],  EventAttach[ai][eaY],  EventAttach[ai][eaZ],
        EventAttach[ai][eaRX], EventAttach[ai][eaRY], EventAttach[ai][eaRZ],
        EventAttach[ai][eaSX], EventAttach[ai][eaSY], EventAttach[ai][eaSZ]);
    return true;
}

// Scoate obiectul atasat pentru quest-ul dat
stock Event_AttachRemove(playerid, const questKey[])
{
    new ai = Event_FindAttach(questKey);
    if(ai == -1) return;
    if(!IsPlayerConnected(playerid)) return;

    new slot = EventAttach[ai][eaSlot];
    if(IsPlayerAttachedObjectSlotUsed(playerid, slot))
        RemovePlayerAttachedObject(playerid, slot);
}

// Scoate de pe TOTI jucatorii online obiectele atasate de eveniment (la oprire/reload)
stock Event_AttachRemoveAll()
{
    for(new a = 0; a < g_EventAttachCount; a++)
    {
        new slot = EventAttach[a][eaSlot];
        for(new p = 0; p < MAX_PLAYERS; p++)
        {
            if(!IsPlayerConnected(p)) continue;
            if(IsPlayerAttachedObjectSlotUsed(p, slot))
                RemovePlayerAttachedObject(p, slot);
        }
    }
}

// Schimba starea evenimentului (start/pause/stop/hide). Aplica instant, fara restart:
// Event_LoadConfig re-citeste starea si re-construieste lumea potrivit ei.
stock Event_SetState(st, const byName[])
{
    new q[176];
    mysql_format(g_SQL, q, sizeof(q),
        "UPDATE `event_config` SET `state`=%d, `updated_by`='%e', `updated_at`=NOW() WHERE `id`=1", st, byName);
    mysql_tquery(g_SQL, q, "", "", 0);

    Event_LoadConfig();
}

// Schimba numele sarbatorii (Halloween -> Christmas -> ...)
stock Event_Rename(const newName[], const byName[])
{
    new q[192];
    mysql_format(g_SQL, q, sizeof(q),
        "UPDATE `event_config` SET `name`='%e', `updated_by`='%e', `updated_at`=NOW() WHERE `id`=1", newName, byName);
    mysql_tquery(g_SQL, q, "", "", 0);

    format(g_EventName, sizeof(g_EventName), "%s", newName);
}

// Sterge progresul tuturor jucatorilor - de folosit cand se trece la alta sarbatoare, ca sa nu
// se mosteneasca progresul pe un `quest_key` refolosit.
stock Event_ResetProgress()
{
    mysql_tquery(g_SQL, "TRUNCATE TABLE `event_progress`", "", "", 0);
    // si ridicarile: altfel obiectele deja luate ar ramane pe cooldown desi progresul e la zero
    mysql_tquery(g_SQL, "TRUNCATE TABLE `event_pickups`", "", "", 0);
    // la fel si personajele deja vizitate, altfel n-ar mai da progres a doua oara
    mysql_tquery(g_SQL, "TRUNCATE TABLE `event_npc_talks`", "", "", 0);

    for(new p = 0; p < MAX_PLAYERS; p++)
    {
        if(!IsPlayerConnected(p)) continue;
        for(new i = 0; i < EVENT_MAX_OBJECTS; i++) g_EventPTaken[p][i] = 0;
        for(new i = 0; i < EVENT_MAX_NPCS; i++)    g_EventNpcTalked[p][i] = 0;
        Event_SpawnObjectsFor(p); // reapar imediat, fara sa astepte tick-ul
    }
}

// ------------------------------------------------------------
//  UNELTE ADMIN: populeaza `event_objects` direct din joc (/holiday obj ...)
//  Coordonatele vin din pozitia curenta a adminului, ca sa nu fie nevoie de SQL scris de mana.
// ------------------------------------------------------------
// Reincarca lumea doar daca evenimentul chiar ruleaza (altfel n-are ce reflecta in joc)
stock Event_ReloadIfActive()
{
    if(g_EventState > EVENT_STATE_HIDE) Event_LoadConfig();
}

// Salveaza pozitia curenta a adminului ca personaj (actor) al evenimentului
stock Event_NpcAdd(playerid, const questKey[], skin, behaviour)
{
    new Float:x, Float:y, Float:z, Float:a;
    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);

    new q[360];
    mysql_format(g_SQL, q, sizeof(q),
        "INSERT INTO `event_npcs` (`quest_key`,`behaviour`,`skin`,`health`,`x`,`y`,`z`,`angle`,`interior`,`world`) \
         VALUES ('%e',%d,%d,100.0,%.4f,%.4f,%.4f,%.4f,%d,%d)",
        questKey, behaviour, skin, x, y, z, a,
        GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid));
    mysql_tquery(g_SQL, q, "OnEventNpcAdded", "i", playerid);
}

forward OnEventNpcAdded(playerid);
public OnEventNpcAdded(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    new msg[144];
    format(msg, sizeof(msg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Event character saved, id "C_INFO"#%d"C_WHITE"."), cache_insert_id());
    SCM(playerid, COLOR_SUCCESS, msg);

    Event_ReloadIfActive();
    return 1;
}

// Numele citibil al unui comportament
stock Event_BehaviourName(b, dest[], len)
{
    switch(b)
    {
        case EVENT_NPC_IDLE:       format(dest, len, "idle");
        case EVENT_NPC_PEACEFUL:   format(dest, len, "peaceful");
        case EVENT_NPC_AGGRESSIVE: format(dest, len, "aggressive");
        case EVENT_NPC_RANDOM:     format(dest, len, "random");
        default:                   format(dest, len, "mixed"); // EVENT_NPC_MIXED
    }
}

// Intoarce EVENT_NPC_MIXED (-1) pentru "mixed", si -2 daca argumentul nu e valid.
stock Event_BehaviourFromArg(const arg[])
{
    if(strcmp(arg, "idle",       true) == 0) return EVENT_NPC_IDLE;
    if(strcmp(arg, "peaceful",   true) == 0) return EVENT_NPC_PEACEFUL;
    if(strcmp(arg, "aggressive", true) == 0) return EVENT_NPC_AGGRESSIVE;
    if(strcmp(arg, "random",     true) == 0) return EVENT_NPC_RANDOM;
    if(strcmp(arg, "mixed",      true) == 0) return EVENT_NPC_MIXED;
    if(strcmp(arg, "-1",         true) == 0) return EVENT_NPC_MIXED;

    if(strlen(arg) == 1 && arg[0] >= '0' && arg[0] <= '3') return arg[0] - '0';
    return -2;
}

// Lista personajelor salvate (id-urile de aici se folosesc la del/goto)
stock Event_NpcList(playerid)
{
    mysql_tquery(g_SQL,
        "SELECT `id`,`quest_key`,`behaviour`,`skin`,`x`,`y`,`z` FROM `event_npcs` ORDER BY `id` ASC LIMIT 40",
        "OnEventNpcListLoaded", "i", playerid);
}

forward OnEventNpcListLoaded(playerid);
public OnEventNpcListLoaded(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    new rows = cache_num_rows();
    if(!rows)
        return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"No event characters saved yet."), 1;

    SCM(playerid, COLOR_INFO, C_INFO"===== Event characters (id - quest - behaviour - skin) =====");
    for(new r = 0; r < rows; r++)
    {
        new nid, nb, nskin, nqkey[EVENT_KEY_LEN];
        new Float:nx, Float:ny, Float:nz;
        cache_get_value_name_int(r, "id", nid);
        cache_get_value_name(r, "quest_key", nqkey, EVENT_KEY_LEN);
        cache_get_value_name_int(r, "behaviour", nb);
        cache_get_value_name_int(r, "skin", nskin);
        cache_get_value_name_float(r, "x", nx);
        cache_get_value_name_float(r, "y", ny);
        cache_get_value_name_float(r, "z", nz);

        new bname[12];
        Event_BehaviourName(nb, bname, sizeof(bname));

        new nline[144];
        format(nline, sizeof(nline),T(playerid, "#%d - %.18s - %s - skin %d - %.1f, %.1f, %.1f"), nid, nqkey, bname, nskin, nx, ny, nz);
        SCM(playerid, COLOR_WHITE, nline);
    }
    return 1;
}

// Verifica existenta unui personaj inainte de stergere
stock Event_NpcCheck(playerid, id, const callback[])
{
    new q[160];
    mysql_format(g_SQL, q, sizeof(q), "SELECT `id` FROM `event_npcs` WHERE `id`=%d LIMIT 1", id);
    mysql_tquery(g_SQL, q, callback, "ii", playerid, id);
}

forward OnEventNpcDelChecked(playerid, id);
public OnEventNpcDelChecked(playerid, id)
{
    if(!IsPlayerConnected(playerid)) return 1;

    if(cache_num_rows() == 0)
    {
        new emsg[144];
        format(emsg, sizeof(emsg), T(playerid, C_ERROR"Error: "C_WHITE"No event character with id "C_INFO"#%d"C_WHITE"."), id);
        SCM(playerid, COLOR_ERROR, emsg);
        return 1;
    }

    new q[160];
    mysql_format(g_SQL, q, sizeof(q), "DELETE FROM `event_npcs` WHERE `id`=%d", id);
    mysql_tquery(g_SQL, q, "", "", 0);

    new msg[144];
    format(msg, sizeof(msg), T(playerid, C_SUCCESS"[ADM] Success: "C_WHITE"Event character "C_INFO"#%d"C_WHITE" deleted."), id);
    SCM(playerid, COLOR_SUCCESS, msg);

    Event_ReloadIfActive();
    return 1;
}

// /holiday npc goto [id] - teleport la personaj, ca sa verifici cum a iesit plasarea lui
forward OnEventNpcGotoLoaded(playerid);
public OnEventNpcGotoLoaded(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    if(cache_num_rows() == 0)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"No event character with that id."), 1;

    new Float:nx, Float:ny, Float:nz, Float:na, nint, nvw;
    cache_get_value_name_float(0, "x", nx);
    cache_get_value_name_float(0, "y", ny);
    cache_get_value_name_float(0, "z", nz);
    cache_get_value_name_float(0, "angle", na);
    cache_get_value_name_int(0, "interior", nint);
    cache_get_value_name_int(0, "world", nvw);

    // AC_SetPos, nu SetPlayerPos: anticheat-ul verifica saltul de pozitie (AC_TP_THRESHOLD_2D) si,
    // fara g_ACExpectTP, ar marca teleportul ca "teleport" si te-ar trage inapoi.
    // Daca esti in vehicul se muta vehiculul (acelasi tipar ca la /holiday obj goto).
    if(GetPlayerVehicleID(playerid) != 0)
        SetVehiclePos(GetPlayerVehicleID(playerid), nx, ny, nz + 1.0);
    else
    {
        AC_SetPos(playerid, nx, ny, nz + 1.0);
        SetPlayerFacingAngle(playerid, na + 180.0); // cu fata la el, nu in aceeasi directie
    }

    SetPlayerInterior(playerid, nint);
    SetPlayerVirtualWorld(playerid, nvw);
    SCM(playerid, COLOR_SUCCESS, C_SUCCESS"[ADM] Success: "C_WHITE"Teleported to the event character.");
    return 1;
}

// Salveaza pozitia curenta a adminului ca obiect al evenimentului
stock Event_ObjAdd(playerid, const questKey[], model)
