#define TELEGONDOLA_SEQ_COUNT   6

new const Float:g_TeleGondolaStation[4][3] = {
    {1537.95276, -675.65002,   95.90000}, // statia 0
    {1478.84998, -1069.40002, 213.83000}, // statia 1
    {1504.44995, -1790.00000, 114.28000}, // statia 2
    {1639.75000, -2286.44995,  93.32000}  // statia 3
};
// Ciclu de 6 (nu 7!): daca s-ar repeta si capatul 0 la final, ultimul salt ar fi statia 0 -> statia 0
// (distanta 0, viteza 0) si miscarea nu s-ar mai termina niciodata, oprind lantul de timere.
// Cu 6 elemente, reluarea de la capat (...1 -> 0) e deja un salt real, deci dus-intors-ul continua la nesfarsit.
new const g_TeleGondolaSeq[TELEGONDOLA_SEQ_COUNT] = {0, 1, 2, 3, 2, 1};

new g_TeleGondolaSeqIdx = 0; // indexul din g_TeleGondolaSeq unde se afla acum cabina (g_TeleGondolaObj e declarat mai sus, langa OnDynamicObjectMoved)
new bool:g_TeleGondolaArrived = true; // true = sta la statie (dwell), false = in tranzit spre urmatoarea

stock Float:TeleGondola_Dist3D(Float:x1, Float:y1, Float:z1, Float:x2, Float:y2, Float:z2)
{
    return floatsqroot(floatpower(x2 - x1, 2.0) + floatpower(y2 - y1, 2.0) + floatpower(z2 - z1, 2.0));
}

// Creeaza cabina la prima statie din secventa si porneste ciclul etern (apelata o singura data, la pornirea serverului)
stock TeleGondola_Create()
{
    new startStation = g_TeleGondolaSeq[0];
    g_TeleGondolaObj = CreateDynamicObject(TELEGONDOLA_MODEL,
        g_TeleGondolaStation[startStation][0], g_TeleGondolaStation[startStation][1], g_TeleGondolaStation[startStation][2],
        0.0, 0.0, 0.0);
    g_TeleGondolaSeqIdx = 0;
    g_TeleGondolaArrived = true;
    SetTimer("TeleGondola_Depart", TELEGONDOLA_DWELL_MS, false);
}

// Timer: s-a terminat stationarea de 10s - porneste deplasarea catre urmatoarea statie din secventa
forward TeleGondola_Depart();
public TeleGondola_Depart()
{
    new nextIdx     = (g_TeleGondolaSeqIdx + 1) % TELEGONDOLA_SEQ_COUNT;
    new curStation  = g_TeleGondolaSeq[g_TeleGondolaSeqIdx];
    new nextStation = g_TeleGondolaSeq[nextIdx];

    new Float:dist = TeleGondola_Dist3D(
        g_TeleGondolaStation[curStation][0],  g_TeleGondolaStation[curStation][1],  g_TeleGondolaStation[curStation][2],
        g_TeleGondolaStation[nextStation][0], g_TeleGondolaStation[nextStation][1], g_TeleGondolaStation[nextStation][2]);
    new Float:speed = dist / TELEGONDOLA_TRAVEL_SEC; // unitati/secunda, ca deplasarea sa dureze mereu exact 15s

    g_TeleGondolaArrived = false;
    MoveDynamicObject(g_TeleGondolaObj,
        g_TeleGondolaStation[nextStation][0], g_TeleGondolaStation[nextStation][1], g_TeleGondolaStation[nextStation][2], speed);

    g_TeleGondolaSeqIdx = nextIdx;

    // Plasa de siguranta: streamer-ul nu garanteaza mereu OnDynamicObjectMoved daca obiectul nu era
    // streamed pentru niciun player in momentul sosirii - fara asta, cabina ar putea ramane blocata
    // "in aer" la nesfarsit. Daca nu a sosit "normal" pana atunci, fortam sosirea manual.
    SetTimer("TeleGondola_WatchdogCheck", floatround((TELEGONDOLA_TRAVEL_SEC + 5.0) * 1000.0), false);
    return 1;
}

// Apelat din OnDynamicObjectMoved cand cabina ajunge la statia curenta - asteapta 10s, apoi pleaca mai departe
stock TeleGondola_OnArrive()
{
    if(g_TeleGondolaArrived) return; // deja procesata (de plasa de siguranta) - ignoram declansarea intarziata
    g_TeleGondolaArrived = true;
    SetTimer("TeleGondola_Depart", TELEGONDOLA_DWELL_MS, false);
}

// Timer de siguranta: daca la (timp de calatorie + 5s) cabina tot nu a "sosit" normal prin
// OnDynamicObjectMoved, o fortam la pozitia exacta a statiei curente si continuam ciclul manual.
forward TeleGondola_WatchdogCheck();
public TeleGondola_WatchdogCheck()
{
    if(g_TeleGondolaArrived) return 1; // a sosit normal - nimic de facut

    new curStation = g_TeleGondolaSeq[g_TeleGondolaSeqIdx];
    StopDynamicObject(g_TeleGondolaObj);
    SetDynamicObjectPos(g_TeleGondolaObj,
        g_TeleGondolaStation[curStation][0], g_TeleGondolaStation[curStation][1], g_TeleGondolaStation[curStation][2]);
    TeleGondola_OnArrive();
    return 1;
}

// ---- Bilet de gondola: cumparat cu /buyticket la ghiseul dedicat (in memorie, nu se salveaza in DB) ----
// UPDOWN_TICKET_PRICE si UPDOWN_TICKET_LOC_* sunt declarate mai sus, langa celelalte constante ale gondolei
#define UPDOWN_TICKET_PAYDAYS   2 // biletul expira dupa acest numar de payday-uri

new bool:g_HasGondolaTicket[MAX_PLAYERS];
new g_GondolaTicketPaydaysLeft[MAX_PLAYERS];

stock bool:TeleGondola_HasValidTicket(playerid)
{
    return g_HasGondolaTicket[playerid];
}

// Sterge biletul (moarte, respawn, conectare/deconectare) - fara mesaj, apelantul decide daca anunta
stock TeleGondola_ClearTicket(playerid)
{
    g_HasGondolaTicket[playerid] = false;
    g_GondolaTicketPaydaysLeft[playerid] = 0;
}

#define TELEGONDOLA_RIDE_RANGE  5.0 // cat de aproape de cabina trebuie sa fii ca sa fii considerat "la bord"
new bool:g_TeleGondolaOnBoard[MAX_PLAYERS]; // true cat timp playerul e detectat langa cabina IN TIMPUL deplasarii (o calatorie)

// Verificarea de bilet, rulata o singura data cand playerul e detectat ca tocmai a urcat (inceputul calatoriei)
stock TeleGondola_CheckTicket(playerid)
{
    if(TeleGondola_HasValidTicket(playerid)) return;

    new roll = random(100); // 0-49 (50%) = wanted 1, 50-74 (25%) = wanted 2, 75-99 (25%) = nimic
    new newWanted = 0;
    if(roll < 50) newWanted = 1;
    else if(roll < 75) newWanted = 2;

    if(newWanted == 0) return; // a scapat nevazut

    if(PlayerData[playerid][pWanted] < newWanted)
    {
        PlayerData[playerid][pWanted] = newWanted;
        SetPlayerWantedLevel(playerid, newWanted);
        UpdatePlayer(playerid, pWanted);
        Pray_FlagSin(playerid, 1); // Sfidarea legii
    }

    new tmsg[144];
    format(tmsg, sizeof(tmsg), T(playerid, C_ERROR"[Gondola] "C_WHITE"You rode without a valid ticket and got caught! Wanted level: "C_INFO"%d"C_WHITE"."), newWanted);
    SCM(playerid, COLOR_ERROR, tmsg);
}

// Timer periodic: detecteaza cine e "la bord" pe cabina in miscare si declanseaza verificarea de bilet o singura data per calatorie
forward TeleGondola_CheckRiders();
public TeleGondola_CheckRiders()
{
    if(g_TeleGondolaObj == STREAMER_TAG_OBJECT:INVALID_STREAMER_ID) return 1;

    new Float:cx, Float:cy, Float:cz;
    if(!g_TeleGondolaArrived) GetDynamicObjectPos(g_TeleGondolaObj, cx, cy, cz);

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;

        new bool:nearCabin = (!g_TeleGondolaArrived && IsPlayerInRangeOfPoint(i, TELEGONDOLA_RIDE_RANGE, cx, cy, cz));

        if(nearCabin && !g_TeleGondolaOnBoard[i])
        {
            g_TeleGondolaOnBoard[i] = true;
            TeleGondola_CheckTicket(i);
        }
        else if(!nearCabin && g_TeleGondolaOnBoard[i])
        {
            g_TeleGondolaOnBoard[i] = false;
        }
    }
    return 1;
}

#define PLATE_RANGE     3.0
new Float:PLATE_LOC_X = 0.0;   // suprascris din locations_admin (id 15, "Vehicle Plate")
new Float:PLATE_LOC_Y = 0.0;
new Float:PLATE_LOC_Z = 0.0;

// E_PVEHICLE_DATA + PVehicleData/g_PVehicle* sunt declarate mai sus (inainte de Speedometer),
// ca sa fie accesibile in Speedometer_Tick pentru afisarea/consumul de motorina.

stock PVehicles_Create(idx)
{
    if(g_PVehicleVehicle[idx] != -1)
    {
        DestroyVehicle(g_PVehicleVehicle[idx]);
        g_PVehicleVehicle[idx] = -1;
    }

    new vehid = CreateVehicle(PVehicleData[idx][pvModelID],
        PVehicleData[idx][pvLocX], PVehicleData[idx][pvLocY], PVehicleData[idx][pvLocZ],
        PVehicleData[idx][pvRotation], PVehicleData[idx][pvColor1], PVehicleData[idx][pvColor2], -1, false);

    SetVehicleNumberPlate(vehid, PVehicleData[idx][pvPlate]);

    if(PVehicleData[idx][pvWheels] != 0)
        AddVehicleComponent(vehid, PVehicleData[idx][pvWheels]);

    if(PVehicleData[idx][pvLocked])
    {
        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);
        SetVehicleParamsEx(vehid, engine, lights, alarm, 1, bonnet, boot, objective);
    }

    g_PVehicleVehicle[idx] = vehid;
    if(vehid >= 0 && vehid < MAX_VEHICLES)
    {
        g_VehicleToPVIndex[vehid] = idx;
        g_VehicleFuel[vehid] = PVehicleData[idx][pvFuel];
    }

    PVehicles_RecreateLabel(idx);
}

// Afiseaza eticheta 3D doar daca vehiculul e de vanzare (fara owner)
stock PVehicles_RecreateLabel(idx)
{
    if(g_PVehicleLabel[idx] != Text3D:INVALID_3DTEXT_ID)
    {
        Delete3DTextLabel(g_PVehicleLabel[idx]);
        g_PVehicleLabel[idx] = Text3D:INVALID_3DTEXT_ID;
    }

    // eticheta apare la masinile libere (showroom) SAU la cele puse la vanzare de proprietar
    if(PVehicleData[idx][pvOwnerId] != 0 && !PVehicleData[idx][pvForSale]) return;

    new vname[24];
    GetVehicleModelName(PVehicleData[idx][pvModelID], vname, sizeof(vname));

    new label[96];
    if(PVehicleData[idx][pvForSale])
        format(label, sizeof(label), "[ %s ]\n{5DA271}FOR SALE: $%s{E3E3E3}\n[ /vbuy ]", vname, MoneyStr(PVehicleData[idx][pvPrice]));
    else
        format(label, sizeof(label), "[ %s ]\n[ $%s ]\n[ /vbuy ]", vname, MoneyStr(PVehicleData[idx][pvPrice]));

    g_PVehicleLabel[idx] = Create3DTextLabel(label, COLOR_WHITE,
        PVehicleData[idx][pvLocX], PVehicleData[idx][pvLocY], PVehicleData[idx][pvLocZ] - 0.5, 10.0, 0, 0);

    if(g_PVehicleVehicle[idx] != -1)
        Attach3DTextLabelToVehicle(g_PVehicleLabel[idx], g_PVehicleVehicle[idx], 0.0, 0.0, 0.2);
}

// Daca vehiculul cu acest pvidx sta parcat pe un loc din market (dupa vehicles_personal.id), elibereaza locul respectiv.
// Apelat cand vehiculul e retras de la vanzare, cumparat sau vandut altui player.
stock Market_FreeSlotForVehicle(pvidx)
{
    for(new i = 0; i < g_MarketCount; i++)
    {
        if(MarketData[i][mktStatus] == 0) continue;
        if(MarketData[i][mktVID] != PVehicleData[pvidx][pvID]) continue;

        MarketData[i][mktStatus] = 0;
        MarketData[i][mktPID]    = 0;
        MarketData[i][mktVID]    = 0;
        MarketData[i][mktDate]   = 0;
        Market_Create(i);

        new q[128];
        mysql_format(g_SQL, q, sizeof(q), "UPDATE `market` SET `status`=0, `pID`=0, `vID`=0, `date`=NULL WHERE `id`=%d", MarketData[i][mktID]);
        mysql_tquery(g_SQL, q, "", "", 0);
        return 1;
    }
    return 0;
}

// Muta vehiculul (vehid/pvidx) intr-un loc liber din market si marcheaza slotul ca ocupat.
// playerid = cel care il pune la vanzare (scos din masina inainte de teleport, apoi anuntat cum se poate deplasa mai departe).
// Returneaza false daca nu mai e niciun loc liber (nu modifica nimic in acest caz).
stock bool:Market_ParkVehicle(playerid, pvidx, vehid)
{
    new slot = Market_FindFreeSlot();
    if(slot == -1) return false;

    RemovePlayerFromVehicle(playerid);

    SetVehiclePos(vehid, MarketData[slot][mktX], MarketData[slot][mktY], MarketData[slot][mktZ]);
    SetVehicleZAngle(vehid, MarketData[slot][mktRotation]);

    PVehicleData[pvidx][pvLocX]     = MarketData[slot][mktX];
    PVehicleData[pvidx][pvLocY]     = MarketData[slot][mktY];
    PVehicleData[pvidx][pvLocZ]     = MarketData[slot][mktZ];
    PVehicleData[pvidx][pvRotation] = MarketData[slot][mktRotation];

    MarketData[slot][mktStatus] = 1;
    MarketData[slot][mktPID]    = PVehicleData[pvidx][pvOwnerId];
    MarketData[slot][mktVID]    = PVehicleData[pvidx][pvID];
    MarketData[slot][mktDate]   = gettime();
    Market_Create(slot); // ocupat -> Market_Create nu mai afiseaza nicio eticheta (masina isi are propria eticheta FOR SALE)

    new mktDateStr[11];
    UnixToDateStr(MarketData[slot][mktDate], mktDateStr, sizeof(mktDateStr));

    new q[160];
    mysql_format(g_SQL, q, sizeof(q), "UPDATE `market` SET `status`=1, `pID`=%d, `vID`=%d, `date`='%s' WHERE `id`=%d",
        MarketData[slot][mktPID], MarketData[slot][mktVID], mktDateStr, MarketData[slot][mktID]);
    mysql_tquery(g_SQL, q, "", "", 0);

    mysql_format(g_SQL, q, sizeof(q), "UPDATE `vehicles_personal` SET `loc_x`=%.4f, `loc_y`=%.4f, `loc_z`=%.4f, `rotation`=%.4f WHERE `id`=%d",
        PVehicleData[pvidx][pvLocX], PVehicleData[pvidx][pvLocY], PVehicleData[pvidx][pvLocZ], PVehicleData[pvidx][pvRotation], PVehicleData[pvidx][pvID]);
    mysql_tquery(g_SQL, q, "", "", 0);

    SCM(playerid, COLOR_INFO,
        T(playerid, C_INFO"Info: "C_WHITE"To reach another destination, you can use public transport. There's a taxi stop right here at the entrance."));
    return true;
}


// Returneaza indexul (in PVehicleData) al vehiculului cu pvID == vid, sau -1
stock PVehicles_FindByVID(vid)
{
    for(new i = 0; i < g_PVehicleCount; i++)
        if(PVehicleData[i][pvID] == vid) return i;
    return -1;
}

// Un document de vehicul (asigurare/kit medical/extinctor/ITP) e valabil pe toata
// durata zilei calendaristice in care expira - doar ziua urmatoare devine "Expired"
stock bool:VehicleDoc_IsValid(exp)
{
    new todayStart = gettime() - (gettime() % 86400);
    new expDayStart = exp - (exp % 86400);
    return (expDayStart >= todayStart);
}

// Formats an expiry timestamp (unix) as "Expired" or "X days"
stock VehicleDoc_Status(exp, out[], len)
{
    if(!VehicleDoc_IsValid(exp)) { format(out, len, "Expired"); return; }
    new diff = exp - gettime();
    if(diff < 0) diff = 0;
    format(out, len, "%d days", (diff / 86400) + 1);
}

// Porneste/opreste motorul vehiculului in care se afla playerid (trebuie sa fie soferul)
stock Vehicle_ToggleEngine(playerid)
{
    new vehid = GetPlayerVehicleID(playerid);
    if(vehid == 0 || GetPlayerVehicleSeat(playerid) != 0)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You must be driving a vehicle to use this."), 0;

    new pvidx = g_VehicleToPVIndex[vehid];
    if(pvidx != -1 && PVehicleData[pvidx][pvOwnerId] == 0)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This vehicle has not been bought yet. Use "C_INFO"/vbuy"C_WHITE" to be able to start it."), 0;

    if(pvidx != -1 && PVehicleData[pvidx][pvForSale])
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This vehicle is up for sale at the Market. Buy it with "C_INFO"/vbuy"C_WHITE" to be able to start it."), 0;

    if(pvidx != -1 && PVehicleData[pvidx][pvIsConfiscated])
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This vehicle has been impounded by DMV. Pay the release fee ("C_INFO"/redeemcar"C_WHITE") to start it."), 0;

    if(pvidx != -1 && PVehicleData[pvidx][pvDirty] > VEHICLE_DIRTY_LOCK)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"This vehicle is too dirty to start. Wash it first ("C_INFO"/v wash"C_WHITE")."), 0;

    // Vehiculele de job pot fi pornite doar de cei care au jobul corespunzator
    new reqJob = Job_VehicleRequiredJob(vehid);
    if(reqJob != 0 && PlayerData[playerid][pJob] != reqJob)
        return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"Only workers of this job can start this vehicle."), 0;

    new engine, lights, alarm, doors, bonnet, boot, objective;
    GetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);
    new bool:turningOn = (engine == 0);

    // Avioanele Crop Duster stricate (>= 20 explodate) nu pornesc pana nu sunt reparate de managerul de aeroport
    if(turningOn && Job_IsCropDustVehicle(vehid) && CropDust_PlanesBroken())
    {
        CropDust_ShowBroken(playerid);
        return 0;
    }

    // Fara motorina nu poti porni motorul
    if(turningOn && g_VehicleFuel[vehid] <= 0.0)
        return SCM(playerid, COLOR_ERROR, C_ERROR"[Fuel] "C_WHITE"The tank is empty. Refuel at a gas station ("C_INFO"/refuel"C_WHITE")."), 0;

    engine = engine ? 0 : 1;
    SetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);

    GTP(playerid, turningOn ? ("ENGINE ~g~ON") : ("ENGINE ~r~OFF"), 3000, 1);

    // La oprirea motorului, salvam nivelul curent de motorina (daca e vehicul din DB)
    if(!turningOn)
        Vehicle_SaveFuel(vehid);

    // La pornirea motorului, retinem momentul (folosit de /showUnusedVeh) si resetam vUnusedVeh
    if(turningOn && pvidx != -1)
    {
        PVehicleData[pvidx][pvLastStartEngine] = gettime();
        PVehicleData[pvidx][pvUnusedVeh] = false;
        Vehicle_SaveLastStartEngine(vehid);
    }

    return 1;
}

// Aprinde/stinge farurile vehiculului in care se afla playerid (trebuie sa fie soferul)
stock Vehicle_ToggleLights(playerid)
{
    new vehid = GetPlayerVehicleID(playerid);
    if(vehid == 0 || GetPlayerVehicleSeat(playerid) != 0)
        return 0;

    new engine, lights, alarm, doors, bonnet, boot, objective;
    GetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);
    lights = (lights == 1) ? 0 : 1; // -1 (nesetat) sau 0 -> aprinde
    SetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);

    return 1;
}

stock Vehicle_ToggleBonnet(playerid)
{
    new vehid = GetPlayerVehicleID(playerid);
    if(vehid == 0 || GetPlayerVehicleSeat(playerid) != 0)
        return 0;

    new engine, lights, alarm, doors, bonnet, boot, objective;
    GetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);
    bonnet = (bonnet == 1) ? 0 : 1; // -1 (nesetat) sau 0 -> deschide capota
    SetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);

    return 1;
}

stock Vehicle_ToggleBoot(playerid)
{
    new vehid = GetPlayerVehicleID(playerid);
    if(vehid == 0 || GetPlayerVehicleSeat(playerid) != 0)
        return 0;

    new engine, lights, alarm, doors, bonnet, boot, objective;
    GetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);
    boot = (boot == 1) ? 0 : 1; // -1 (nesetat) sau 0 -> deschide portbagajul
    SetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);

    return 1;
}

// Incuie/descuie usile vehiculului (folosit de masinile de examen la inceputul/sfarsitul examenului)
stock Vehicle_SetLocked(vehid, bool:locked)
{
    if(vehid == -1) return;
    new engine, lights, alarm, doors, bonnet, boot, objective;
    GetVehicleParamsEx(vehid, engine, lights, alarm, doors, bonnet, boot, objective);
    SetVehicleParamsEx(vehid, engine, lights, alarm, locked ? 1 : 0, bonnet, boot, objective);
}

// Returneaza primul camp pKey liber (pKey1/pKey2/pKey3) al playerului, sau E_PLAYER_DATA:-1 daca e plin
stock E_PLAYER_DATA:PVehicles_FindFreeKeySlot(playerid)
{
    if(PlayerData[playerid][pKey1] == 0) return pKey1;
    if(PlayerData[playerid][pKey2] == 0) return pKey2;
    if(PlayerData[playerid][pKey3] == 0) return pKey3;
    return E_PLAYER_DATA:-1;
}

// Goleste campul pKey care contine vid (daca exista), la playerul dat
stock PVehicles_ClearKeySlot(playerid, vid)
{
    if(PlayerData[playerid][pKey1] == vid) { PlayerData[playerid][pKey1] = 0; UpdatePlayer(playerid, pKey1); }
    else if(PlayerData[playerid][pKey2] == vid) { PlayerData[playerid][pKey2] = 0; UpdatePlayer(playerid, pKey2); }
    else if(PlayerData[playerid][pKey3] == vid) { PlayerData[playerid][pKey3] = 0; UpdatePlayer(playerid, pKey3); }
}

// Locatiile intre care se alege random spawn-ul civil (pSpawn==1)
#define CIVIL_SPAWN_COUNT 6
new Float:CivilSpawnLocations[CIVIL_SPAWN_COUNT][4] = {
    {868.2825, -2071.2629, 17.3279, 32.4158}, // spawn civil 1
    {855.5033, -2073.2300, 17.3279, 16.4357}, // spawn civil 2
    {842.9693, -2071.7813, 17.3279, 5.1556},  // spawn civil 3
    {834.1105, -2069.5881, 17.3279, 4.5289},  // spawn civil 4
    {841.6141, -2080.4556, 17.3279, 15.8090}, // spawn civil 5
    {857.5778, -2073.7075, 17.3279, 15.4957}  // spawn civil 6
};

// Recalculeaza si cacheaza pSpawnX/Y/Z in functie de pSpawn, ca sa nu se mai interogheze
// FactionData/HouseData la fiecare spawn. Cade pe civil daca tipul selectat nu e disponibil.
stock Player_RecalcSpawn(playerid)
{
    new type = PlayerData[playerid][pSpawn];
    PlayerData[playerid][pSpawnA] = 0.0; // implicit; suprascris mai jos doar acolo unde avem un unghi real salvat

    if(type == CARAVAN_CAMP_SPAWN_TYPE)
    {
        new cidx = Caravan_FindByOwner(PlayerData[playerid][pID]);
        if(cidx != -1 && (CaravanData[cidx][rCampLocX] != 0.0 || CaravanData[cidx][rCampLocY] != 0.0 || CaravanData[cidx][rCampLocZ] != 0.0))
        {
            PlayerData[playerid][pSpawnX] = CaravanData[cidx][rCampLocX];
            PlayerData[playerid][pSpawnY] = CaravanData[cidx][rCampLocY];
            PlayerData[playerid][pSpawnZ] = CaravanData[cidx][rCampLocZ] + 4.0;
            return;
        }
        type = 1;
    }

    if(type == GOV_SPAWN_TYPE)
    {
        if(PlayerData[playerid][pIsPresident] || PlayerData[playerid][pGovRole] != GOV_NONE)
        {
            PlayerData[playerid][pSpawnX] = GovSpawnLocation[0];
            PlayerData[playerid][pSpawnY] = GovSpawnLocation[1];
            PlayerData[playerid][pSpawnZ] = GovSpawnLocation[2];
            PlayerData[playerid][pSpawnA] = GovSpawnLocation[3];
            return;
        }
        type = 1;
    }

    if(type == RENT_SPAWN_TYPE)
    {
        new rhidx = (PlayerData[playerid][pRentHouse] != 0) ? Houses_FindByID(PlayerData[playerid][pRentHouse]) : -1;
        if(rhidx != -1 && HouseData[rhidx][hIssue] == 0)
        {
            // Prefera interiorul casei/apartamentului inchiriat (daca e setat), altfel exteriorul
            if(HouseData[rhidx][hInterior] != 0 || HouseData[rhidx][hIntLocX] != 0.0 || HouseData[rhidx][hIntLocY] != 0.0)
            {
                PlayerData[playerid][pSpawnX] = HouseData[rhidx][hIntLocX];
                PlayerData[playerid][pSpawnY] = HouseData[rhidx][hIntLocY];
                PlayerData[playerid][pSpawnZ] = HouseData[rhidx][hIntLocZ];
                return;
            }
            PlayerData[playerid][pSpawnX] = HouseData[rhidx][hLocX];
            PlayerData[playerid][pSpawnY] = HouseData[rhidx][hLocY];
            PlayerData[playerid][pSpawnZ] = HouseData[rhidx][hLocZ];
            return;
        }

        new rhtidx = (PlayerData[playerid][pRentHotel] != 0) ? Hotels_FindByID(PlayerData[playerid][pRentHotel]) : -1;
        if(rhtidx != -1)
        {
            PlayerData[playerid][pSpawnX] = HotelData[rhtidx][htlLocX];
            PlayerData[playerid][pSpawnY] = HotelData[rhtidx][htlLocY];
            PlayerData[playerid][pSpawnZ] = HotelData[rhtidx][htlLocZ];
            return;
        }
        type = 1;
    }

    if(type == 2)
    {
        new fid = PlayerData[playerid][pFaction];
        if(fid >= 1 && fid <= MAX_FACTIONS)
        {
            // Prefera locatia interiorului (daca e setata), altfel cade pe HQ-ul exterior
            if(FactionData[fid][fInteriorX] != 0.0 || FactionData[fid][fInteriorY] != 0.0)
            {
                PlayerData[playerid][pSpawnX] = FactionData[fid][fInteriorX];
                PlayerData[playerid][pSpawnY] = FactionData[fid][fInteriorY];
                PlayerData[playerid][pSpawnZ] = FactionData[fid][fInteriorZ];
                PlayerData[playerid][pSpawnA] = FactionData[fid][fInteriorA];
                return;
            }
            if(FactionData[fid][fHQX] != 0.0 || FactionData[fid][fHQY] != 0.0)
            {
                PlayerData[playerid][pSpawnX] = FactionData[fid][fHQX];
                PlayerData[playerid][pSpawnY] = FactionData[fid][fHQY];
                PlayerData[playerid][pSpawnZ] = FactionData[fid][fHQZ];
                return;
            }
        }
        type = 3;
    }

    if(type == 3)
    {
        new hidx = (PlayerData[playerid][pHouse] != 0) ? Houses_FindByID(PlayerData[playerid][pHouse]) : -1;
        if(hidx != -1 && HouseData[hidx][hIssue] == 0)
        {
            // Prefera interiorul casei (daca e setat), altfel cade pe exteriorul casei
            if(HouseData[hidx][hInterior] != 0 || HouseData[hidx][hIntLocX] != 0.0 || HouseData[hidx][hIntLocY] != 0.0)
            {
                PlayerData[playerid][pSpawnX] = HouseData[hidx][hIntLocX];
                PlayerData[playerid][pSpawnY] = HouseData[hidx][hIntLocY];
                PlayerData[playerid][pSpawnZ] = HouseData[hidx][hIntLocZ];
                return;
            }
            PlayerData[playerid][pSpawnX] = HouseData[hidx][hLocX];
            PlayerData[playerid][pSpawnY] = HouseData[hidx][hLocY];
            PlayerData[playerid][pSpawnZ] = HouseData[hidx][hLocZ];
            return;
        }
        type = 1;
    }

    // Civil (implicit) - random intre cele 8 locatii
    new civIdx = random(CIVIL_SPAWN_COUNT);
    PlayerData[playerid][pSpawnX] = CivilSpawnLocations[civIdx][0];
    PlayerData[playerid][pSpawnY] = CivilSpawnLocations[civIdx][1];
    PlayerData[playerid][pSpawnZ] = CivilSpawnLocations[civIdx][2];
    PlayerData[playerid][pSpawnA] = CivilSpawnLocations[civIdx][3];
}

// ============================================================
//  BAZA DE DATE
// ============================================================
new g_DBConnFailedWarnings = 0;
new g_DBConnFailedTimer = -1;

// Repeta avertismentul de esec la conectare de 3 ori (la fiecare 3 secunde), apoi opreste serverul
forward DB_ConnectionFailedWarning();
public DB_ConnectionFailedWarning()
{
    g_DBConnFailedWarnings++;
    print("\n\n DB CONNECTION FAILED !!!");

    if(g_DBConnFailedWarnings >= 3)
    {
        KillTimer(g_DBConnFailedTimer);
        SendRconCommand("exit");
    }
    return 1;
}

stock DB_Init()
{
    new MySQLOpt:opt = mysql_init_options();
    mysql_set_option(opt, AUTO_RECONNECT, true);
    mysql_set_option(opt, POOL_SIZE, 1); // 1 thread = query-urile ruleaza strict in ordinea trimisa (evita race intre CREATE TABLE si SELECT-urile de load care ruleaza imediat dupa)
    g_SQL = mysql_connect(MYSQL_HOST, MYSQL_USER, MYSQL_PASS, MYSQL_DB, opt);

    if(g_SQL == MYSQL_INVALID_HANDLE || mysql_errno(g_SQL) != 0)
    {
        print("[DB] EROARE: Nu s-a putut conecta la MySQL!");
        g_DBConnFailedTimer = SetTimer("DB_ConnectionFailedWarning", 3000, true);
        return 0;
    }
    mysql_log(ERROR | WARNING);
    print("[DB] Conectat la MySQL cu succes!");
    DB_CreateTables(); // ruleaza la fiecare pornire, foloseste CREATE TABLE IF NOT EXISTS asa ca e sigur

    return 1;
}

