    {
        format(line, sizeof(line), "%s\t$%s\n", g_WatchModels[i], MoneyStr(g_WatchPrices[i]));
        strcat(dlg, line);
    }
    SPD(playerid, DIALOG_WATCH_BUY, DIALOG_STYLE_TABLIST, "Watch Shop", dlg, "Select", "Back");
