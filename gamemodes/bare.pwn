    // ---- /showUnusedVeh (lista vehiculelor personale nepornite de peste 30 zile, admin 2+) ----
    if(strcmp(cmd, "/showunusedveh", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 2)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 2."), 1;

        new q[160];
        mysql_format(g_SQL, q, sizeof(q),
            "SELECT vp.`id` AS `vehid`, vp.`model_id`, vp.`last_start_engine`, vp.`retro_veh`, COALESCE(p.`username`,'N/A') AS `owner` \
             FROM `vehicles_personal` vp LEFT JOIN `players` p ON p.`id` = vp.`owner_id` \
             WHERE vp.`unused_veh` = 1 ORDER BY vp.`id` ASC");
        mysql_tquery(g_SQL, q, "OnUnusedVehListLoaded", "i", playerid);
        return 1;
    }

    // ---- /shoplist (lista magazinelor de item-uri cu teleport, admin 2+) ----
    if(strcmp(cmd, "/shoplist", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        if(g_ShopCount == 0)
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"There are no shops on the server."), 1;

        static list[4096];
        list[0] = EOS;
        strcat(list, T(playerid, ""C_INFO"ID\t"C_INFO"Type\t"C_INFO"Name\t"C_INFO"Distance\n"));
        for(new i = 0; i < g_ShopCount; i++)
        {
            new slType = ShopData[i][shopType];
            if(slType < 1 || slType > 4) slType = 1;

            new Float:slDist = GetPlayerDistanceFromPoint(playerid, ShopData[i][shopX], ShopData[i][shopY], ShopData[i][shopZ]);

            new line[112];
            format(line, sizeof(line), ""C_WHITE"#%d\t%s\t%s\t%dm\n",
                ShopData[i][shopID], g_ShopTypeName[slType], ShopData[i][shopName], floatround(slDist));
            strcat(list, line);
        }

        SPD(playerid, DIALOG_SHOPLIST, DIALOG_STYLE_TABLIST_HEADERS, "Shop List", list, "Teleport", "Close");
        return 1;
    }

