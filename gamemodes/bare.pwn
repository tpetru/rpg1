    if(strcmp(cmd, "/binlist", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        if(g_BinCount == 0)
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"There are no bins on the server."), 1;

        static list[4096];
        list[0] = EOS;
        strcat(list, T(playerid, ""C_INFO"ID\t"C_INFO"Type\t"C_INFO"Status\n"));
        for(new i = 0; i < g_BinCount; i++)
        {
            new line[100];
            format(line, sizeof(line), ""C_WHITE"#%d\t%d\t%d/%d\n", BinData[i][binID], BinData[i][binType], BinData[i][binStatusCurrent], BinData[i][binStatusMax]);
            strcat(list, line);
        }

        SPD(playerid, DIALOG_BINLIST, DIALOG_STYLE_TABLIST_HEADERS, "Bin List", list, "Teleport", "Close");
        return 1;
    }

    // ---- /churchlist (lista bisericilor cu teleport la exterior, admin 1+) ----
    if(strcmp(cmd, "/churchlist", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        new Float:chX, Float:chY, Float:chZ;
        GetPlayerPos(playerid, chX, chY, chZ);

        static list[512];
        list[0] = EOS;
        strcat(list, T(playerid, ""C_INFO"ID\t"C_INFO"Name\t"C_INFO"Distance\n"));

        new found = 0;
        for(new c = 0; c < CHURCH_COUNT; c++)
        {
            new chLoc = Locations_FindByID(g_ChurchLocID[c]);
            if(chLoc == -1) continue;

            new Float:dist = GetPlayerDistanceFromPoint(playerid, LocationData[chLoc][locX], LocationData[chLoc][locY], LocationData[chLoc][locZ]);
            new line[128];
            format(line, sizeof(line), ""C_WHITE"#%d\t%s\t%.0fm\n", LocationData[chLoc][locID], LocationData[chLoc][locName], dist);
            strcat(list, line);

            g_ChurchListIdx[playerid][found] = c; // listitem -> indexul bisericii (o locatie lipsa din DB ar decala altfel lista)
            found++;
        }
        g_ChurchListCount[playerid] = found;

        if(found == 0)
            return SCM(playerid, COLOR_INFO, C_INFO"Info: "C_WHITE"There are no churches on the server."), 1;

        SPD(playerid, DIALOG_CHURCHLIST, DIALOG_STYLE_TABLIST_HEADERS, "Church List", list, "Teleport", "Close");
        return 1;
    }

    // ---- /cnnlist (lista punctelor de /ad cu teleport, admin 1+) ----
    if(strcmp(cmd, "/cnnlist", true) == 0)
    {
        if(PlayerData[playerid][pAdminLevel] < 1)
            return SCM(playerid, COLOR_ERROR, C_ERROR"Error: "C_WHITE"You don't have access. Requires admin level 1."), 1;

        static list[1024];
        list[0] = EOS;
        strcat(list, T(playerid, ""C_INFO"ID\t"C_INFO"Zone\t"C_INFO"Cooldown\n"));
        for(new z = 0; z < AD_ZONE_COUNT; z++)
        {
            new cnnCd[16];
            new cnnElapsed = GetTickCount() - g_AdZoneCooldown[z];
            if(g_AdZoneCooldown[z] != 0 && cnnElapsed < AD_COOLDOWN_MS)
                format(cnnCd, sizeof(cnnCd), ""C_ERROR"%ds", (AD_COOLDOWN_MS - cnnElapsed + 999) / 1000);
            else
                format(cnnCd, sizeof(cnnCd), ""C_SUCCESS"ready");

            new line[80];
            format(line, sizeof(line), ""C_WHITE"#%d\t%s\t%s\n", z, AdZoneData[z][adZoneName], cnnCd);
            strcat(list, line);
        }

        SPD(playerid, DIALOG_CNNLIST, DIALOG_STYLE_TABLIST_HEADERS, "AD Zone List", list, "Teleport", "Close");
        return 1;
    }

