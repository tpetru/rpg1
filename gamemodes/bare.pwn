// Alege un tip sau o gluma aleatoriu si il trimite tuturor playerilor logati (apelat periodic din OnGameModeInit)
forward ServerTip_Tick();
public ServerTip_Tick()
{
    new msg[224];
    new bool:isTip = (random(2) == 0);
    new pick = isTip ? random(SERVERTIP_COUNT) : random(SERVERJOKE_COUNT);

    // mesajul se compune per player, in limba lui
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || !PlayerData[i][pLogged]) continue;
        if(isTip) format(msg, sizeof(msg), T(i, C_INFO"[Tip] "C_WHITE"%s"),  T(i, g_ServerTips[pick]));
        else      format(msg, sizeof(msg), T(i, C_INFO"[Joke] "C_WHITE"%s"), T(i, g_ServerJokes[pick]));
        SCM(i, COLOR_INFO, msg);
    }
    return 1;
}

